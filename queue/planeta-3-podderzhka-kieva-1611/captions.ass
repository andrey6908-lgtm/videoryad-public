Dialogue: 0,0:00:00.12,0:00:03.32,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ РЕШИМОСТЬ ДОБРАЛАСЬ ДО КАССЫ И ВНЕЗАПНО
Dialogue: 0,0:00:03.32,0:00:05.88,Caption,,0,0,0,,ПОПРОСИЛА ПОСМОТРЕТЬ ЧЕК. ПОКА ТРЕБОВАЛОСЬ
Dialogue: 0,0:00:05.88,0:00:09.96,Caption,,0,0,0,,ВЫСТУПАТЬ, УБЕЖДАТЬ СОСЕДЕЙ И ОБЕЩАТЬ КИЕВУ ПОДДЕРЖКУ СТОЛЬКО,
Dialogue: 0,0:00:10.20,0:00:14.44,Caption,,0,0,0,,СКОЛЬКО ПОНАДОБИТСЯ, ЖЕЛАЮЩИХ КОМАНДОВАТЬ ПАРАДОМ ХВАТАЛО. НО ТЕПЕРЬ
Dialogue: 0,0:00:14.52,0:00:17.00,Caption,,0,0,0,,ПОЛЬША ОТКАЗАЛАСЬ ВНОСИТЬ ДОПОЛНИТЕЛЬНЫЕ ДЕНЬГИ В
Dialogue: 0,0:00:17.08,0:00:19.72,Caption,,0,0,0,,ПРОГРАММУ ЗАКУПКИ АМЕРИКАНСКОГО ОРУЖИЯ ДЛЯ УКРАИНЫ.
Dialogue: 0,0:00:20.01,0:00:22.28,Caption,,0,0,0,,И ПОЧТИ СРАЗУ ЭММАНУЭЛЬ МАКРОН ЗАГОВОРИЛ О
Dialogue: 0,0:00:22.28,0:00:25.32,Caption,,0,0,0,,ПОРАЖЕНЧЕСТВЕ И УГРОЗЕ НОВОЙ ВОЙНЫ. СТОИЛО ОТКРЫТЬ
Dialogue: 0,0:00:25.32,0:00:29.72,Caption,,0,0,0,,БЮДЖЕТНУЮ ВЕДОМОСТЬ, И КОНТИНЕНТАЛЬНАЯ ТВЁРДОСТЬ СРАЗУ ПРИОБРЕЛА ТОЧНУЮ
Dialogue: 0,0:00:29.80,0:00:32.92,Caption,,0,0,0,,ЦЕНУ. НИКАКОЙ НЕОЖИДАННОЙ СИМПАТИИ К МОСКВЕ ЗДЕСЬ
Dialogue: 0,0:00:33.00,0:00:35.56,Caption,,0,0,0,,НЕТ. ЕВРОПЕЙСКИМ СТОЛИЦАМ ПРИХОДИТСЯ ОТВЕЧАТЬ НА
Dialogue: 0,0:00:35.64,0:00:39.08,Caption,,0,0,0,,ВОПРОС, КОТОРЫЙ РАНЬШЕ УДАВАЛОСЬ ОТОДВИГАТЬ РЕЧАМИ. КТО
Dialogue: 0,0:00:39.08,0:00:42.28,Caption,,0,0,0,,ОПЛАТИТ СЛЕДУЮЩИЙ ЭТАП ПОДДЕРЖКИ И ОТКУДА ОН ВОЗЬМЁТ
Dialogue: 0,0:00:42.28,0:00:44.68,Caption,,0,0,0,,СРЕДСТВА? ЕСЛИ ВАМ ИНТЕРЕСНЫ НОВОСТИ,
Dialogue: 0,0:00:44.76,0:00:47.16,Caption,,0,0,0,,В КОТОРЫХ ТОРЖЕСТВЕННЫЕ ЗАЯВЛЕНИЯ ПРОВЕРЯЮТСЯ
Dialogue: 0,0:00:47.16,0:00:51.64,Caption,,0,0,0,,РЕАЛЬНЫМИ РЕШЕНИЯМИ, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ОСОБЕННО ПОЛЕЗНО СЛЕДИТЬ НЕ ЗА
Dialogue: 0,0:00:51.64,0:00:53.72,Caption,,0,0,0,,ГРОМКОСТЬЮ ВЫСТУПЛЕНИЙ, А ЗА ТЕМ,
Dialogue: 0,0:00:53.96,0:00:56.92,Caption,,0,0,0,,КТО В НУЖНЫЙ МОМЕНТ ДЕЙСТВИТЕЛЬНО ПЕРЕВОДИТ ДЕНЬГИ.
Dialogue: 0,0:00:57.51,0:01:00.76,Caption,,0,0,0,,ГЛАВНЫМ ГЕРОЕМ ЭТОЙ ИСТОРИИ СТАЛА ИМЕННО ПОЛЬША. С
Dialogue: 0,0:01:00.76,0:01:05.72,Caption,,0,0,0,,БОЛГАРИЕЙ, ВЕНГРИЕЙ, СЛОВАКИЕЙ И ЧЕХИЕЙ ВСЁ ПРОЩЕ. ОНИ УЖЕ НЕ
Dialogue: 0,0:01:05.80,0:01:08.12,Caption,,0,0,0,,РАЗ СОМНЕВАЛИСЬ В НОВЫХ РАСХОДАХ НА УКРАИНУ,
Dialogue: 0,0:01:08.36,0:01:10.84,Caption,,0,0,0,,СПОРИЛИ ОБ УСЛОВИЯХ ПОМОЩИ И СПРАШИВАЛИ,
Dialogue: 0,0:01:11.00,0:01:13.88,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ПРОДЛИТСЯ СИСТЕМА ПОСТОЯННЫХ ВЗНОСОВ.
Dialogue: 0,0:01:16.16,0:01:18.56,Caption,,0,0,0,,ОТ ВАРШАВЫ ТАКОГО ОТВЕТА ЖДАЛИ ГОРАЗДО МЕНЬШЕ.
Dialogue: 0,0:01:18.93,0:01:21.28,Caption,,0,0,0,,ПОЛЬСКОЕ РУКОВОДСТВО НЕСКОЛЬКО ЛЕТ ТРЕБОВАЛО ОТ
Dialogue: 0,0:01:21.28,0:01:24.40,Caption,,0,0,0,,ЕВРОПЫ БОЛЕЕ ЖЁСТКОГО ОТНОШЕНИЯ К РОССИИ. ОНО
Dialogue: 0,0:01:24.40,0:01:26.48,Caption,,0,0,0,,НАСТАИВАЛО НА БЫСТРОМ ВООРУЖЕНИИ,
Dialogue: 0,0:01:26.72,0:01:29.76,Caption,,0,0,0,,РАСШИРЕНИИ ПОМОЩИ КИЕВУ И УСИЛЕНИИ ДАВЛЕНИЯ НА
Dialogue: 0,0:01:29.76,0:01:32.40,Caption,,0,0,0,,МОСКВУ. ОСТАЛЬНЫМ РЕГУЛЯРНО НАПОМИНАЛИ,
Dialogue: 0,0:01:32.66,0:01:35.76,Caption,,0,0,0,,ЧТО УКРАИНА ЯКОБЫ ПРИКРЫВАЕТ ВЕСЬ КОНТИНЕНТ И ПОТОМУ
Dialogue: 0,0:01:35.76,0:01:38.72,Caption,,0,0,0,,ЭКОНОМИТЬ НА НЕЙ НЕЛЬЗЯ. ТЕПЕРЬ ДОНАЛЬД ТУСК СООБЩИЛ
Dialogue: 0,0:01:38.72,0:01:40.96,Caption,,0,0,0,,ГЕНЕРАЛЬНОМУ СЕКРЕТАРЮ НАТО МАРКУ РЮТТЕ,
Dialogue: 0,0:01:41.28,0:01:44.24,Caption,,0,0,0,,ЧТО ДОПОЛНИТЕЛЬНЫХ ПОЛЬСКИХ ДЕНЕГ ДЛЯ ПРОГРАММЫ ПУРЛ
Dialogue: 0,0:01:44.32,0:01:47.28,Caption,,0,0,0,,ПОКА НЕ БУДЕТ. ПО ЭТОЙ СХЕМЕ ЕВРОПЕЙСКИЕ ГОСУДАРСТВА
Dialogue: 0,0:01:47.28,0:01:49.04,Caption,,0,0,0,,ОПЛАЧИВАЮТ АМЕРИКАНСКОЕ ОРУЖИЕ,
Dialogue: 0,0:01:49.28,0:01:50.96,Caption,,0,0,0,,КОТОРОЕ ЗАТЕМ ПОЛУЧАЕТ УКРАИНА.
Dialogue: 0,0:01:51.76,0:01:53.84,Caption,,0,0,0,,ОБЪЯСНЕНИЕ У ВАРШАВЫ НЕ ГЕРОИЧЕСКОЕ,
Dialogue: 0,0:01:54.00,0:01:56.64,Caption,,0,0,0,,ЗАТО УБЕДИТЕЛЬНОЕ. В СТРАНЕ БОЛЬШОЙ БЮДЖЕТНЫЙ
Dialogue: 0,0:01:56.64,0:02:00.24,Caption,,0,0,0,,ДЕФИЦИТ, А СОБСТВЕННАЯ ОБОРОНА УЖЕ ТРЕБУЕТ ОГРОМНЫХ РАСХОДОВ.
Dialogue: 0,0:02:00.53,0:02:02.80,Caption,,0,0,0,,ПОЛЬСКАЯ БЕЗОПАСНОСТЬ, КАК ВЫЯСНИЛОСЬ,
Dialogue: 0,0:02:03.00,0:02:06.08,Caption,,0,0,0,,НЕ УМЕЕТ СУЩЕСТВОВАТЬ НА ОДНИХ ПРИЗЫВАХ. ИЗМЕНИЛОСЬ
Dialogue: 0,0:02:06.08,0:02:08.96,Caption,,0,0,0,,ОДНО. КОГДА ПОТРЕБОВАЛСЯ ЕЩЁ ОДИН ПЛАТЁЖ,
Dialogue: 0,0:02:09.36,0:02:10.96,Caption,,0,0,0,,ПОЛЬША ОТОДВИНУЛА РУКУ ОТ КАССЫ.
Dialogue: 0,0:02:11.55,0:02:14.64,Caption,,0,0,0,,ЭТО НЕ ОЗНАЧАЕТ ПОЛНОГО ОТКАЗА ОТ ПОМОЩИ. ГРАНИЦУ
Dialogue: 0,0:02:14.64,0:02:18.24,Caption,,0,0,0,,НИКТО НЕ ЗАКРЫВАЕТ, ОТНОШЕНИЯ С МОСКВОЙ СРОЧНО ВОССТАНАВЛИВАТЬ НЕ
Dialogue: 0,0:02:18.24,0:02:20.56,Caption,,0,0,0,,СОБИРАЕТСЯ, А ТУСК ПОДЧЁРКИВАЕТ,
Dialogue: 0,0:02:20.72,0:02:23.36,Caption,,0,0,0,,ЧТО ВАРШАВА УЖЕ МНОГО СДЕЛАЛА ДЛЯ КИЕВА И
Dialogue: 0,0:02:23.36,0:02:26.32,Caption,,0,0,0,,ПРОДОЛЖИТ ПОДДЕРЖКУ. ОДНАКО ДОПОЛНИТЕЛЬНЫЙ ВЗНОС
Dialogue: 0,0:02:26.32,0:02:32.12,Caption,,0,0,0,,ОКАЗАЛСЯ ДРУГОЙ ИСТОРИЕЙ. ПОЛЬСКОЕ ПРАВИТЕЛЬСТВО ПОСМОТРЕЛО НА СОБСТВЕННЫЕ
Dialogue: 0,0:02:32.12,0:02:36.28,Caption,,0,0,0,,РАСХОДЫ И РЕШИЛО, ЧТО ОЧЕРЕДЬ УКРАИНЫ НАЧИНАЕТСЯ НЕ ПЕРЕД ПОЛЬСКОЙ
Dialogue: 0,0:02:36.36,0:02:39.64,Caption,,0,0,0,,АРМИЕЙ, А ПОСЛЕ НЕЁ. ОСОБЕННО ПРИМЕЧАТЕЛЬНО,
Dialogue: 0,0:02:39.98,0:02:42.68,Caption,,0,0,0,,ЧТО НЕДАВНО ПОХОЖУЮ ПОЗИЦИЮ ВЫСКАЗЫВАЛА ПРАВАЯ
Dialogue: 0,0:02:42.68,0:02:45.16,Caption,,0,0,0,,ОППОЗИЦИЯ. ТЕПЕРЬ К ТОМУ ЖЕ ВЫВОДУ ПРИШЁЛ
Dialogue: 0,0:02:45.16,0:02:48.60,Caption,,0,0,0,,ЛИБЕРАЛЬНЫЙ КАБИНЕТ ТУСКА. ВОТ И ВСЯ МАГИЯ ПАРТИЙНЫХ
Dialogue: 0,0:02:48.68,0:02:51.32,Caption,,0,0,0,,РАЗЛИЧИЙ. ОДНИ ЛЮБЯТ БРЮССЕЛЬ СИЛЬНЕЕ,
Dialogue: 0,0:02:51.54,0:02:54.84,Caption,,0,0,0,,ДРУГИЕ СЛАБЕЕ. ОДНИ ЛУЧШЕ ЛАДЯТ С ДОНАЛЬДОМ ТРАМПОМ,
Dialogue: 0,0:02:55.10,0:02:57.80,Caption,,0,0,0,,ДРУГИЕ ПРЕДПОЧИТАЮТ СПОРИТЬ С НИМ ПУБЛИЧНО. НО
Dialogue: 0,0:02:57.88,0:03:00.52,Caption,,0,0,0,,БЮДЖЕТНАЯ ДЫРА НЕ ИНТЕРЕСУЕТСЯ ПАРТИЙНЫМ БИЛЕТОМ.
Dialogue: 0,0:03:00.88,0:03:03.96,Caption,,0,0,0,,ОНА ЛЕЖИТ ПОСРЕДИ СТОЛА И ПОРТИТ ВСЕМ НАСТРОЕНИЕ.
Dialogue: 0,0:03:04.59,0:03:07.40,Caption,,0,0,0,,ДЛЯ САМОГО ТУСКА ЭТО ОСОБЕННО ПОКАЗАТЕЛЬНО. ЕГО
Dialogue: 0,0:03:07.40,0:03:10.44,Caption,,0,0,0,,ТРУДНО ЗАПИСАТЬ В ПРОТИВНИКИ ЕВРОПЕЙСКОГО КУРСА. ОН
Dialogue: 0,0:03:10.44,0:03:12.92,Caption,,0,0,0,,ПРИНАДЛЕЖИТ К ПРОЕВРОПЕЙСКОМУ ЛАГЕРЮ И МНОГО ЛЕТ
Dialogue: 0,0:03:12.92,0:03:16.44,Caption,,0,0,0,,ЗАНИМАЛ ВАЖНЫЕ ПОСТЫ ВНУТРИ ЕВРОСОЮЗА. ПОЭТОМУ ОТКАЗ
Dialogue: 0,0:03:16.52,0:03:19.16,Caption,,0,0,0,,ЕГО ПРАВИТЕЛЬСТВА НЕЛЬЗЯ ПРИВЫЧНО ОБЪЯСНИТЬ
Dialogue: 0,0:03:19.16,0:03:21.96,Caption,,0,0,0,,ОЧЕРЕДНОЙ ВЫХОДКОЙ ВИКТОРА ОРБАНА. УДОБНОГО
Dialogue: 0,0:03:21.96,0:03:24.60,Caption,,0,0,0,,ВИНОВНИКА ЗДЕСЬ НЕ ПОЛУЧАЕТСЯ. РЕШЕНИЕ ПРИНЯЛ
Dialogue: 0,0:03:24.60,0:03:28.52,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРОГО ЕВРОПЕЙСКИЕ ИНСТИТУТЫ СЧИТАЮТ СВОИМ. И ДАЖЕ
Dialogue: 0,0:03:28.60,0:03:32.44,Caption,,0,0,0,,ОН ГОВОРИТ, ЧТО НОВЫХ ДЕНЕГ СЕЙЧАС НЕ ДАСТ. ИМЕННО ПОЭТОМУ
Dialogue: 0,0:03:32.52,0:03:35.64,Caption,,0,0,0,,ПОЛЬСКИЙ СЛУЧАЙ ЗВУЧИТ ГРОМЧЕ БОЛГАРСКОГО. БОЛГАРИЯ
Dialogue: 0,0:03:35.64,0:03:38.60,Caption,,0,0,0,,ТОЖЕ ОТКАЗЫВАЕТСЯ ВЫДЕЛЯТЬ НОВУЮ ФИНАНСОВУЮ ПОМОЩЬ.
Dialogue: 0,0:03:40.88,0:03:43.68,Caption,,0,0,0,,РУМЕН РАДЕВ ССЫЛАЕТСЯ НА ДЕФИЦИТ БЮДЖЕТА И ДОБАВЛЯЕТ
Dialogue: 0,0:03:43.68,0:03:46.88,Caption,,0,0,0,,ДЕТАЛЬ, ОТ КОТОРОЙ ЕВРОПЕЙСКАЯ ЛОГИКА НАЧИНАЕТ ДЫМИТЬСЯ.
Dialogue: 0,0:03:47.39,0:03:50.80,Caption,,0,0,0,,ЕВРОКОМИССИЯ ТРЕБУЕТ ОТ СОФИИ СОКРАЩАТЬ ДЕФИЦИТ И
Dialogue: 0,0:03:50.80,0:03:53.44,Caption,,0,0,0,,СОБЛЮДАТЬ УСТАНОВЛЕННОЕ ОГРАНИЧЕНИЕ РАСХОДОВ.
Dialogue: 0,0:03:53.68,0:03:58.40,Caption,,0,0,0,,СНАЧАЛА БОЛГАРИИ ОБЪЯСНЯЮТ, ЧТО ГОСУДАРСТВЕННАЯ КАЗНА ЖИВЁТ СЛИШКОМ ШИРОКО И ЕЁ
Dialogue: 0,0:03:58.40,0:04:01.28,Caption,,0,0,0,,ПОРА УЖАТЬ. ПОТОМ ТЕМ ЖЕ ЛЮДЯМ ПРЕДЛАГАЮТ НАЙТИ
Dialogue: 0,0:04:01.28,0:04:04.32,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ СРЕДСТВА ДЛЯ УКРАИНЫ. СОФИЯ ЛИШЬ
Dialogue: 0,0:04:04.40,0:04:07.52,Caption,,0,0,0,,НАПОМИНАЕТ, ЧТО ПЕРВОЕ ТРЕБОВАНИЕ НИКТО НЕ ОТМЕНЯЛ.
Dialogue: 0,0:04:08.22,0:04:11.12,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ПРЕКРАСНАЯ СИСТЕМА. БРЮССЕЛЬ ОДНОЙ РУКОЙ
Dialogue: 0,0:04:11.20,0:04:13.36,Caption,,0,0,0,,ЗАБИРАЕТ У БОЛГАРИИ КОШЕЛЁК ЗА ФИНАНСОВУЮ
Dialogue: 0,0:04:13.36,0:04:16.72,Caption,,0,0,0,,НЕСДЕРЖАННОСТЬ, А ДРУГОЙ ПРОСИТ ДОСТАТЬ ИЗ НЕГО ЕЩЁ НЕМНОГО.
Dialogue: 0,0:04:17.04,0:04:19.76,Caption,,0,0,0,,ПРИ ЭТОМ БОЛГАРСКАЯ ПОДДЕРЖКА КИЕВА ПОЛНОСТЬЮ НЕ
Dialogue: 0,0:04:19.76,0:04:22.24,Caption,,0,0,0,,ПРЕКРАЩАЕТСЯ. СТРАНА ГОТОВА ПОСТАВЛЯТЬ
Dialogue: 0,0:04:22.24,0:04:25.84,Caption,,0,0,0,,ЭЛЕКТРОЭНЕРГИЮ, ПОМОГАТЬ С ВОССТАНОВЛЕНИЕМ ЭНЕРГЕТИКИ И ЖЕЛЕЗНЫХ
Dialogue: 0,0:04:25.84,0:04:29.36,Caption,,0,0,0,,ДОРОГ, УЧАСТВОВАТЬ В ДРУГИХ ПРОЕКТАХ. ЕВРОПА НЕ СОБИРАЕТСЯ
Dialogue: 0,0:04:29.44,0:04:31.84,Caption,,0,0,0,,ОДНИМ УТРОМ ВЫКЛЮЧИТЬ ПОМОЩЬ УКРАИНЕ. ПРОИСХОДИТ
Dialogue: 0,0:04:31.84,0:04:35.20,Caption,,0,0,0,,ДРУГОЕ. ПРАВИТЕЛЬСТВА ВСЁ ХУЖЕ СОГЛАШАЮТСЯ ПРИНИМАТЬ
Dialogue: 0,0:04:35.20,0:04:40.64,Caption,,0,0,0,,НА СЕБЯ НОВЫЕ ОБЯЗАТЕЛЬСТВА, СУММА КОТОРЫХ ПОСТОЯННО РАСТЁТ. ПРЕЖНИЕ ПАКЕТЫ УЖЕ
Dialogue: 0,0:04:40.64,0:04:42.88,Caption,,0,0,0,,РАСПРЕДЕЛЕНЫ. РЕШЕНИЯ СОГЛАСОВАНЫ,
Dialogue: 0,0:04:43.14,0:04:47.52,Caption,,0,0,0,,ДОГОВОРЫ ОФОРМЛЕНЫ, ЧАСТЬ ПОСТАВОК ОПЛАЧЕНА. НО КОНФЛИКТ ПРОДОЛЖАЕТСЯ,
Dialogue: 0,0:04:47.90,0:04:50.80,Caption,,0,0,0,,И ВЧЕРАШНИХ ДЕНЕГ НЕДОСТАТОЧНО. ТРЕБУЕТСЯ НОВЫЙ
Dialogue: 0,0:04:50.80,0:04:57.24,Caption,,0,0,0,,ТРАНШ, ЗА НИМ СЛЕДУЮЩИЙ. НА КАЖДОМ КРУГЕ ГОСУДАРСТВАМ ПРИХОДИТСЯ РЕШАТЬ,
Dialogue: 0,0:04:57.32,0:04:59.96,Caption,,0,0,0,,КАКУЮ СОБСТВЕННУЮ СТАТЬЮ РАСХОДОВ ОНИ ГОТОВЫ
Dialogue: 0,0:04:59.96,0:05:02.76,Caption,,0,0,0,,ПОДВИНУТЬ. ПОКУПКА НОВОГО ХОЛОДИЛЬНИКА ХОТЯ БЫ
Dialogue: 0,0:05:02.76,0:05:06.04,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ ДОСТАВКОЙ. ЗДЕСЬ ПОСЛЕ ОПЛАТЫ ЗВОНЯТ
Dialogue: 0,0:05:06.04,0:05:10.76,Caption,,0,0,0,,СНОВА И СООБЩАЮТ, ЧТО ЭТО БЫЛ ТОЛЬКО ПЕРВЫЙ ВЗНОС. ФРИДРИХ МЕРЦ
Dialogue: 0,0:05:10.76,0:05:13.71,Caption,,0,0,0,,ВИДИТ ЭТУ ПРОБЛЕМУ И ХОЧЕТ УБРАТЬ ЕЖЕГОДНЫЕ ТОРГИ.
Dialogue: 0,0:05:13.94,0:05:18.27,Caption,,0,0,0,,ЕГО ИДЕЯ СОСТОИТ В ТОМ, ЧТОБЫ ЗАРАНЕЕ ВКЛЮЧИТЬ ФИНАНСИРОВАНИЕ УКРАИНЫ В
Dialogue: 0,0:05:18.27,0:05:20.52,Caption,,0,0,0,,СЛЕДУЮЩИЙ СЕМИЛЕТНИЙ БЮДЖЕТ ЕВРОСОЮЗА.
Dialogue: 0,0:05:21.18,0:05:23.24,Caption,,0,0,0,,ЕСЛИ РАСХОДЫ ЗАКРЕПИТЬ НА НЕСКОЛЬКО ЛЕТ,
Dialogue: 0,0:05:23.55,0:05:25.71,Caption,,0,0,0,,ЕВРОПЕЙСКИМ ЛИДЕРАМ НЕ ПРИДЁТСЯ КАЖДЫЙ РАЗ
Dialogue: 0,0:05:25.71,0:05:28.28,Caption,,0,0,0,,ВОЗВРАЩАТЬСЯ В НАЦИОНАЛЬНЫЕ СТОЛИЦЫ И ЗАНОВО
Dialogue: 0,0:05:28.36,0:05:31.40,Caption,,0,0,0,,ДОБИВАТЬСЯ СОГЛАСИЯ. ДЕНЬГИ БУДУТ ВСТРОЕНЫ В ОБЩИЙ
Dialogue: 0,0:05:31.40,0:05:35.00,Caption,,0,0,0,,МЕХАНИЗМ, А ОЧЕРЕДНОЙ СПОР ФОРМАЛЬНО СТАНЕТ ИСПОЛНЕНИЕМ
Dialogue: 0,0:05:35.00,0:05:38.44,Caption,,0,0,0,,ПРИНЯТОГО РЕШЕНИЯ. ТОЛЬКО ОБЩИЙ БЮДЖЕТ ЕВРОСОЮЗА НЕ
Dialogue: 0,0:05:38.44,0:05:40.92,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ИЗ ВОЗДУХА. ЕГО НАПОЛНЯЮТ ТЕ ЖЕ
Dialogue: 0,0:05:40.92,0:05:44.60,Caption,,0,0,0,,ГОСУДАРСТВА, КОТОРЫЕ СЕЙЧАС ЖАЛУЮТСЯ НА ДЕФИЦИТ И РАСТУЩИЕ
Dialogue: 0,0:05:44.60,0:05:47.24,Caption,,0,0,0,,РАСХОДЫ. ЕСЛИ УКРАИНЕ ВЫДЕЛЯТ БОЛЬШЕ,
Dialogue: 0,0:05:47.48,0:05:49.80,Caption,,0,0,0,,ОСТАЛЬНЫМ ПРИДЁТСЯ ЛИБО УВЕЛИЧИТЬ ВЗНОСЫ,
Dialogue: 0,0:05:50.12,0:05:52.44,Caption,,0,0,0,,ЛИБО ОТКАЗАТЬСЯ ОТ ЧАСТИ СОБСТВЕННЫХ ПРОГРАММ.
Dialogue: 0,0:05:52.89,0:05:55.32,Caption,,0,0,0,,ТРЕТЬЕГО КАРМАНА В БРЮССЕЛЬСКОМ ПИДЖАКЕ ПОКА НЕ
Dialogue: 0,0:05:55.32,0:05:58.36,Caption,,0,0,0,,ОБНАРУЖИЛИ. ПОЭТОМУ ПРОТИВ ПРЕДЛОЖЕНИЯ ВЫСТУПАЮТ НЕ
Dialogue: 0,0:05:58.36,0:06:01.72,Caption,,0,0,0,,ТОЛЬКО БОЛГАРИЯ, ВЕНГРИЯ, ЧЕХИЯ И СЛОВАКИЯ,
Dialogue: 0,0:06:01.96,0:06:05.00,Caption,,0,0,0,,ОТ КОТОРЫХ ВОЗРАЖЕНИЙ ОЖИДАЛИ ЗАРАНЕЕ. НЕДОВОЛЬСТВО
Dialogue: 0,0:06:05.08,0:06:12.01,Caption,,0,0,0,,ВЫРАЖАЮТ СЛОВЕНИЯ И ИРЛАНДИЯ. ЭТИ СТРАНЫ ТРУДНО НАЗВАТЬ ПРОТИВНИКАМИ УКРАИНЫ,
Dialogue: 0,0:06:12.32,0:06:15.05,Caption,,0,0,0,,НО И ОНИ УМЕЮТ ЧИТАТЬ БЮДЖЕТНЫЕ ТАБЛИЦЫ БЕЗ
Dialogue: 0,0:06:15.05,0:06:17.93,Caption,,0,0,0,,ПЕРЕВОДЧИКА. СЕМИЛЕТНИЙ ФИНАНСОВЫЙ ПЛАН НЕ
Dialogue: 0,0:06:17.93,0:06:20.97,Caption,,0,0,0,,РАСТЯГИВАЕТСЯ САМ ПО СЕБЕ. ДОПОЛНИТЕЛЬНЫЕ РАСХОДЫ НА
Dialogue: 0,0:06:21.05,0:06:25.45,Caption,,0,0,0,,КИЕВ ОЗНАЧАЮТ, ЧТО ДРУГИЕ ПОЛУЧАТЕЛИ УВИДЯТ МЕНЬШИЕ СУММЫ. ПОД
Dialogue: 0,0:06:25.45,0:06:27.21,Caption,,0,0,0,,СОКРАЩЕНИЕ МОГУТ ПОПАСТЬ ФОНДЫ,
Dialogue: 0,0:06:27.37,0:06:30.49,Caption,,0,0,0,,ПРЕДНАЗНАЧЕННЫЕ ДЛЯ МЕНЕЕ БОГАТЫХ ЧЛЕНОВ ЕВРОСОЮЗА.
Dialogue: 0,0:06:30.85,0:06:33.37,Caption,,0,0,0,,А ЭТО УЖЕ ДОРОГИ, РАЗВИТИЕ РЕГИОНОВ,
Dialogue: 0,0:06:33.52,0:06:35.85,Caption,,0,0,0,,ХОЗЯЙСТВЕННЫЕ ПРОЕКТЫ И ДРУГИЕ ВЕЩИ,
Dialogue: 0,0:06:36.04,0:06:38.65,Caption,,0,0,0,,КОТОРЫМИ НАЦИОНАЛЬНЫЕ ПРАВИТЕЛЬСТВА ОТЧИТЫВАЮТСЯ
Dialogue: 0,0:06:38.65,0:06:41.77,Caption,,0,0,0,,ПЕРЕД СВОИМИ ГРАЖДАНАМИ. НА СОВМЕСТНОЙ ФОТОГРАФИИ
Dialogue: 0,0:06:41.77,0:06:45.05,Caption,,0,0,0,,ЕДИНСТВО ВЫГЛЯДИТ БЕЗУПРЕЧНО. ЗАЯВЛЕНИЕ О ЗАЩИТЕ
Dialogue: 0,0:06:45.13,0:06:47.93,Caption,,0,0,0,,УКРАИНЫ ТОЖЕ НИЧЕГО НЕ СТОИТ. НО КОГДА КАКОЙ
Dialogue: 0,0:06:47.93,0:06:52.57,Caption,,0,0,0,,НИБУДЬ СТРАНЕ СООБЩАЮТ, ЧТО НА ЕЁ СОБСТВЕННЫЕ РЕГИОНЫ ДЕНЕГ СТАНЕТ МЕНЬШЕ
Dialogue: 0,0:06:52.65,0:06:54.33,Caption,,0,0,0,,РАДИ НОВЫХ ПЕРЕЧИСЛЕНИЙ КИЕВУ,
Dialogue: 0,0:06:54.70,0:06:57.93,Caption,,0,0,0,,ТОРЖЕСТВЕННОЕ НАСТРОЕНИЕ УСТУПАЕТ МЕСТО УТОЧНЯЮЩИМ
Dialogue: 0,0:06:57.93,0:07:02.89,Caption,,0,0,0,,ВОПРОСАМ. МАКРОН УЖЕ ПОНЯЛ, ЧЕМ ГРОЗИТ ТАКАЯ ПЕРЕМЕНА. ОН ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:07:03.20,0:07:05.53,Caption,,0,0,0,,ЧТО СОКРАЩЕНИЕ РЕСУРСОВ УКРАИНЫ ПРИВЕДЁТ К
Dialogue: 0,0:07:05.53,0:07:11.21,Caption,,0,0,0,,НЕСПРАВЕДЛИВОМУ МИРУ, ОСЛАБИТ КИЕВ И СДЕЛАЕТ УЯЗВИМОЙ ВСЮ ЕВРОПУ. ПОДОБНОЕ
Dialogue: 0,0:07:11.21,0:07:13.53,Caption,,0,0,0,,ОТНОШЕНИЕ ФРАНЦУЗСКИЙ ПРЕЗИДЕНТ НАЗЫВАЕТ
Dialogue: 0,0:07:13.53,0:07:16.73,Caption,,0,0,0,,ПОРАЖЕНЧЕСКИМ И СЧИТАЕТ ПОДГОТОВКОЙ СЛЕДУЮЩЕЙ ВОЙНЫ.
Dialogue: 0,0:07:17.05,0:07:20.41,Caption,,0,0,0,,ЕГО РАССУЖДЕНИЕ ПОНЯТНО. ЧЕМ МЕНЬШЕ ОРУЖИЯ И ДЕНЕГ
Dialogue: 0,0:07:20.41,0:07:24.57,Caption,,0,0,0,,ПОЛУЧАЕТ УКРАИНА, ТЕМ СЛАБЕЕ ЕЁ ПОЗИЦИЯ НА ВОЗМОЖНЫХ ПЕРЕГОВОРАХ.
Dialogue: 0,0:07:24.80,0:07:27.69,Caption,,0,0,0,,СЛАБАЯ ПОЗИЦИЯ ОЗНАЧАЕТ ХУДШИЕ УСЛОВИЯ.
Dialogue: 0,0:07:29.98,0:07:32.06,Caption,,0,0,0,,ЕСЛИ РОССИЯ ДОБЬЁТСЯ РЕЗУЛЬТАТА СИЛОЙ,
Dialogue: 0,0:07:32.27,0:07:34.54,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ, ПО МНЕНИЮ МАКРОНА,
Dialogue: 0,0:07:34.78,0:07:38.14,Caption,,0,0,0,,ПОЗДНЕЕ СТОЛКНУТСЯ С НОВОЙ ОПАСНОСТЬЮ. ТОЛЬКО МАКРОН
Dialogue: 0,0:07:38.14,0:07:40.86,Caption,,0,0,0,,РАССУЖДАЕТ О БЕЗОПАСНОСТИ КОНТИНЕНТА ЦЕЛИКОМ,
Dialogue: 0,0:07:41.16,0:07:43.82,Caption,,0,0,0,,А НАЦИОНАЛЬНЫЕ ПРАВИТЕЛЬСТВА ОТВЕЧАЮТ ЗА КОНКРЕТНЫЕ
Dialogue: 0,0:07:43.90,0:07:47.58,Caption,,0,0,0,,СЧЕТА. ТУСКУ НУЖНО ФИНАНСИРОВАТЬ ПОЛЬШУ. РАДЕВУ
Dialogue: 0,0:07:47.66,0:07:50.30,Caption,,0,0,0,,НУЖНО СВОДИТЬ БОЛГАРСКИЙ БЮДЖЕТ. ДРУГИМ ЛИДЕРАМ
Dialogue: 0,0:07:50.30,0:07:51.98,Caption,,0,0,0,,ПРИХОДИТСЯ ОБЪЯСНЯТЬ ГРАЖДАНАМ,
Dialogue: 0,0:07:52.22,0:07:54.78,Caption,,0,0,0,,ПОЧЕМУ СРЕДСТВА НА ИХ РЕГИОНЫ ПРЕВРАЩАЮТСЯ В
Dialogue: 0,0:07:54.78,0:07:57.90,Caption,,0,0,0,,ОЧЕРЕДНОЙ ПАКЕТ ДЛЯ КИЕВА. СЛОВО "ПОРАЖЕНЧЕСТВО"
Dialogue: 0,0:07:57.90,0:08:01.74,Caption,,0,0,0,,ЗВУЧИТ ГРОЗНО, НО БУХГАЛТЕРИЯ ОТ НЕГО НЕ МЕНЯЕТСЯ. МОЖНО НАЗВАТЬ
Dialogue: 0,0:08:01.74,0:08:06.54,Caption,,0,0,0,,РАСХОДЫ ИСТОРИЧЕСКИМ ДОЛГОМ, ВЛОЖЕНИЕМ В БУДУЩЕЕ ИЛИ ЗАЩИТОЙ ЕВРОПЕЙСКОГО ДОМА.
Dialogue: 0,0:08:07.25,0:08:09.50,Caption,,0,0,0,,КАЗНАЧЕЙСТВО ВСЁ РАВНО ПОПРОСИТ УКАЗАТЬ ИСТОЧНИК
Dialogue: 0,0:08:09.50,0:08:11.82,Caption,,0,0,0,,ФИНАНСИРОВАНИЯ. И ЖЕЛАТЕЛЬНО НЕ ИСТОЧНИК
Dialogue: 0,0:08:11.82,0:08:14.70,Caption,,0,0,0,,ВДОХНОВЕНИЯ. МЕРЦ ПОЭТОМУ ПРЕДЛАГАЕТ ЗАКРЕПИТЬ
Dialogue: 0,0:08:14.78,0:08:18.54,Caption,,0,0,0,,ПОМОЩЬ В СИСТЕМЕ. МАКРОН ПОЭТОМУ ПОВЫШАЕТ ГОЛОС. ОБА
Dialogue: 0,0:08:18.54,0:08:21.74,Caption,,0,0,0,,ПОНИМАЮТ, ЧТО ЕЖЕГОДНОЕ ГОЛОСОВАНИЕ СРЕДИ ДВАДЦАТИ СЕМИ
Dialogue: 0,0:08:21.74,0:08:25.74,Caption,,0,0,0,,ГОСУДАРСТВ ОПАСНО ДЛЯ КИЕВА. КАЖДЫЙ НОВЫЙ РАУНД ДАЁТ
Dialogue: 0,0:08:25.74,0:08:28.14,Caption,,0,0,0,,ЕЩЁ ОДНОМУ ПРАВИТЕЛЬСТВУ ВОЗМОЖНОСТЬ СКАЗАТЬ,
Dialogue: 0,0:08:28.30,0:08:30.70,Caption,,0,0,0,,ЧТО В ЭТОТ РАЗ ОНО ПРОПУСКАЕТ ОПЛАТУ.
Dialogue: 0,0:08:31.53,0:08:34.05,Caption,,0,0,0,,ПОЛЬША СТАЛА ОСОБЕННО ЗАМЕТНЫМ ПРЕДУПРЕЖДЕНИЕМ.
Dialogue: 0,0:08:34.37,0:08:37.10,Caption,,0,0,0,,ОТКАЗ ВЕНГРИИ НИКОГО БЫ НЕ УДИВИЛ. ВОЗРАЖЕНИЯ
Dialogue: 0,0:08:37.10,0:08:40.78,Caption,,0,0,0,,СТРАНЫ, КОТОРАЯ ДАВНО ТРЕБУЕТ СОКРАТИТЬ УКРАИНСКИЕ РАСХОДЫ,
Dialogue: 0,0:08:40.93,0:08:43.26,Caption,,0,0,0,,ЛИШЬ ПОВТОРИЛИ БЫ ЗНАКОМУЮ ПОЗИЦИЮ.
Dialogue: 0,0:08:45.52,0:08:48.72,Caption,,0,0,0,,НО ВАРШАВА МНОГО ЛЕТ ТРЕБОВАЛА МАКСИМАЛЬНО ЖЁСТКОГО
Dialogue: 0,0:08:48.72,0:08:52.08,Caption,,0,0,0,,КУРСА ПРОТИВ МОСКВЫ. И ТЕПЕРЬ ИМЕННО ОНА ЗАЯВЛЯЕТ,
Dialogue: 0,0:08:52.32,0:08:58.08,Caption,,0,0,0,,ЧТО НОВОГО ВЗНОСА НЕ БУДЕТ. НЕДОСТАТОК ЛЮДЕЙ ДЛЯ УКРАИНЫ ДАВНО НЕ НОВОСТЬ. С
Dialogue: 0,0:08:58.08,0:09:00.64,Caption,,0,0,0,,ВООРУЖЕНИЕМ ЕВРОПА ЗАВИСИТ ОТ МОЩНОСТИ СВОИХ
Dialogue: 0,0:09:00.64,0:09:03.28,Caption,,0,0,0,,ПРЕДПРИЯТИЙ И ОТ ПОСТАВОК СОЕДИНЁННЫХ ШТАТОВ.
Dialogue: 0,0:09:03.95,0:09:06.40,Caption,,0,0,0,,ТЕПЕРЬ ВСЁ НАСТОЙЧИВЕЕ НАПОМИНАЕТ О СЕБЕ ТРЕТИЙ
Dialogue: 0,0:09:06.40,0:09:09.44,Caption,,0,0,0,,ПРЕДЕЛ ФИНАНСИРОВАНИЕ. И ПОЧТИ ОДНОВРЕМЕННО В ЭТУ
Dialogue: 0,0:09:09.52,0:09:12.48,Caption,,0,0,0,,ИСТОРИЮ ВОЗВРАЩАЕТСЯ АНГЕЛА МЕРКЕЛЬ. ОНА СНОВА
Dialogue: 0,0:09:12.48,0:09:15.20,Caption,,0,0,0,,ОПРАВДЫВАЕТ СВОЮ ПРЕЖНЮЮ ГОТОВНОСТЬ ВЕСТИ ПЕРЕГОВОРЫ
Dialogue: 0,0:09:15.20,0:09:18.24,Caption,,0,0,0,,С ВЛАДИМИРОМ ПУТИНЫМ. ПО СЛОВАМ БЫВШЕГО КАНЦЛЕРА,
Dialogue: 0,0:09:18.55,0:09:21.12,Caption,,0,0,0,,ОТКАЗ ЗАПАДА ОТ ДИАЛОГА В ДВЕ ТЫСЯЧИ ПЯТНАДЦАТОМ
Dialogue: 0,0:09:21.12,0:09:25.68,Caption,,0,0,0,,ГОДУ МОГ ПРИВЕСТИ К ТОМУ, ЧТО УКРАИНА НЕ СОХРАНИЛАСЬ БЫ В НЫНЕШНЕМ ВИДЕ.
Dialogue: 0,0:09:26.26,0:09:30.88,Caption,,0,0,0,,РАНЕЕ МЕРКЕЛЬ УЖЕ ГОВОРИЛА, ЧТО МИНСКИЕ СОГЛАШЕНИЯ ПОЗВОЛИЛИ УКРАИНЕ ПОЛУЧИТЬ
Dialogue: 0,0:09:30.96,0:09:33.76,Caption,,0,0,0,,ВРЕМЯ И УКРЕПИТЬСЯ. В МОСКВЕ ТАКОЕ ОБЪЯСНЕНИЕ
Dialogue: 0,0:09:33.84,0:09:36.56,Caption,,0,0,0,,ВСТРЕТИЛИ КРАЙНЕ БОЛЕЗНЕННО. ПУТИН ЗАЯВЛЯЛ О
Dialogue: 0,0:09:36.56,0:09:40.08,Caption,,0,0,0,,РАЗОЧАРОВАНИИ, А РОССИЙСКИЕ ПРЕДСТАВИТЕЛИ МНОГО РАЗ ПОВТОРЯЛИ,
Dialogue: 0,0:09:40.32,0:09:44.96,Caption,,0,0,0,,ЧТО ЗАПАД ЛИШЬ ТЯНУЛ ВРЕМЯ, ГОТОВИЛ УКРАИНУ И ВВОДИЛ РОССИЮ В ЗАБЛУЖДЕНИЕ.
Dialogue: 0,0:09:45.84,0:09:48.32,Caption,,0,0,0,,ЗДЕСЬ ВОЗНИКАЕТ НЕПРИЯТНЫЙ ВОПРОС УЖЕ К РОССИЙСКОЙ
Dialogue: 0,0:09:48.32,0:09:51.28,Caption,,0,0,0,,СТОРОНЕ. ЕСЛИ ГОСУДАРСТВО РЕГУЛЯРНО СООБЩАЕТ,
Dialogue: 0,0:09:51.44,0:09:53.44,Caption,,0,0,0,,ЧТО ЕГО СНОВА ПРОВЕЛИ НА ПЕРЕГОВОРАХ,
Dialogue: 0,0:09:53.84,0:09:56.48,Caption,,0,0,0,,ЭТО ПЛОХО ХАРАКТЕРИЗУЕТ НЕ ТОЛЬКО ПАРТНЁРОВ. ПОСЛЕ
Dialogue: 0,0:09:56.56,0:09:59.12,Caption,,0,0,0,,ПЕРВОГО СЛУЧАЯ МОЖНО ГОВОРИТЬ О ЧУЖОЙ ХИТРОСТИ.
Dialogue: 0,0:10:01.40,0:10:04.77,Caption,,0,0,0,,ПОСЛЕ ВТОРОГО СТОИТ ПРОВЕРИТЬ УСЛОВИЯ СДЕЛКИ. КОГДА
Dialogue: 0,0:10:04.85,0:10:07.33,Caption,,0,0,0,,ПОДОБНОЕ ПРЕВРАЩАЕТСЯ В МНОГОЛЕТНЮЮ ТРАДИЦИЮ,
Dialogue: 0,0:10:07.65,0:10:11.41,Caption,,0,0,0,,ПОРА ПРИСМОТРЕТЬСЯ К ТЕМ, КТО КАЖДЫЙ РАЗ ПРИХОДИТ ЗА ТОТ ЖЕ СТОЛ
Dialogue: 0,0:10:11.60,0:10:14.61,Caption,,0,0,0,,И ОПЯТЬ УДИВЛЯЕТСЯ РЕЗУЛЬТАТУ. НО ЧЕРЕЗ НЕСКОЛЬКО
Dialogue: 0,0:10:14.69,0:10:18.05,Caption,,0,0,0,,ЛЕТ ПУБЛИКА ВНОВЬ СЛЫШИТ ЗНАКОМОЕ ОБЪЯСНЕНИЕ. НАС
Dialogue: 0,0:10:18.21,0:10:21.65,Caption,,0,0,0,,ОБМАНУЛИ. ВПЕЧАТЛЯЮЩАЯ СТАБИЛЬНОСТЬ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:10:21.96,0:10:24.13,Caption,,0,0,0,,И К РОССИЙСКОЙ ДЕЛЕГАЦИИ ПЕРЕД ПОДПИСАНИЕМ
Dialogue: 0,0:10:24.13,0:10:26.29,Caption,,0,0,0,,ДОКУМЕНТОВ ПРИДЁТСЯ ПРИСТАВЛЯТЬ ЧЕЛОВЕКА,
Dialogue: 0,0:10:26.68,0:10:28.29,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ ТИХО НАПОМИНАТЬ,
Dialogue: 0,0:10:28.51,0:10:30.61,Caption,,0,0,0,,ЧЕМ ЗАКОНЧИЛАСЬ ПРЕДЫДУЩАЯ ВСТРЕЧА.
Dialogue: 0,0:10:31.39,0:10:34.37,Caption,,0,0,0,,ПОЭТОМУ СЛОВА МЕРКЕЛЬ ВАЖНЫ НЕ ТОЛЬКО КАК ЗАЩИТА
Dialogue: 0,0:10:34.45,0:10:37.33,Caption,,0,0,0,,СОБСТВЕННОЙ РЕПУТАЦИИ. ОНИ ПОДВОДЯТ К ВОПРОСУ,
Dialogue: 0,0:10:37.50,0:10:41.73,Caption,,0,0,0,,КОТОРЫЙ СТАНЕТ ГЛАВНЫМ, ЕСЛИ ПЕРЕГОВОРЫ ОПЯТЬ ПРЕВРАТЯТСЯ В ОСНОВНОЙ ПУТЬ
Dialogue: 0,0:10:41.81,0:10:45.65,Caption,,0,0,0,,ЗАВЕРШЕНИЯ КОНФЛИКТА. СДЕЛАЛ ЛИ КТО НИБУДЬ ВЫВОДЫ
Dialogue: 0,0:10:45.73,0:10:50.77,Caption,,0,0,0,,ПОСЛЕ МИНСКА? ПОНЯЛ ЛИ ЗАПАД, ГДЕ ПРОХОДИТ ПРЕДЕЛ ВРЕМЕННЫХ ДОГОВОРЁННОСТЕЙ?
Dialogue: 0,0:10:51.25,0:10:53.81,Caption,,0,0,0,,ИЗМЕНИЛА ЛИ РОССИЯ ПОДХОД К ГАРАНТИЯМ?
Dialogue: 0,0:10:54.35,0:10:57.65,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТ ЛИ УКРАИНА, ЧЕГО ЖДАТЬ ОТ НОВОЙ ПАУЗЫ?
Dialogue: 0,0:10:58.04,0:11:00.21,Caption,,0,0,0,,ИЛИ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ОДНА СТОРОНА СНОВА
Dialogue: 0,0:11:00.21,0:11:01.97,Caption,,0,0,0,,ПОХВАСТАЕТСЯ ВЫИГРАННЫМ ВРЕМЕНЕМ,
Dialogue: 0,0:11:02.26,0:11:04.53,Caption,,0,0,0,,А ДРУГАЯ С ПРИВЫЧНЫМ ИЗУМЛЕНИЕМ ОБЪЯВИТ,
Dialogue: 0,0:11:04.72,0:11:09.25,Caption,,0,0,0,,ЧТО ЕЁ ОПЯТЬ ПЕРЕХИТРИЛИ? ИМЕННО ЗДЕСЬ СПОР О ЕВРОПЕЙСКИХ ДЕНЬГАХ
Dialogue: 0,0:11:09.25,0:11:12.29,Caption,,0,0,0,,СОПРИКАСАЕТСЯ С ТЕМОЙ БУДУЩИХ ПЕРЕГОВОРОВ. ЧЕМ
Dialogue: 0,0:11:12.29,0:11:15.01,Caption,,0,0,0,,ТЯЖЕЛЕЕ СОБИРАТЬ СРЕДСТВА НА ПРОДОЛЖЕНИЕ ВОЙНЫ,
Dialogue: 0,0:11:15.31,0:11:17.97,Caption,,0,0,0,,ТЕМ ЧАЩЕ ЛИДЕРЫ БУДУТ ГОВОРИТЬ О ДОГОВОРЁННОСТИ.
Dialogue: 0,0:11:20.24,0:11:23.84,Caption,,0,0,0,,ПРИЧИНА НЕ ВО ВНЕЗАПНОМ ПРИМИРЕНИИ. МАКРОН НЕ СТАЛ
Dialogue: 0,0:11:23.84,0:11:27.84,Caption,,0,0,0,,СТОРОННИКОМ СКОРОГО МИРА, ПОЛЬША НЕ ПОТЯНУЛАСЬ К ДРУЖБЕ С РОССИЕЙ,
Dialogue: 0,0:11:28.08,0:11:30.72,Caption,,0,0,0,,А ОСТАЛЬНЫЕ СТРАНЫ НЕ ЗАБЫЛИ ПРЕЖНИЕ ЗАЯВЛЕНИЯ.
Dialogue: 0,0:11:31.03,0:11:33.84,Caption,,0,0,0,,ПРОСТО ВОЙНА РЕГУЛЯРНО ПРИСЫЛАЕТ НОВЫЙ СЧЁТ,
Dialogue: 0,0:11:33.99,0:11:36.88,Caption,,0,0,0,,И РАЗМЕР В НЁМ НЕ УМЕНЬШАЕТСЯ. ПОКА РАСХОДЫ
Dialogue: 0,0:11:36.88,0:11:38.72,Caption,,0,0,0,,ОПЛАЧИВАЮТСЯ БЕЗ СОПРОТИВЛЕНИЯ,
Dialogue: 0,0:11:38.96,0:11:41.20,Caption,,0,0,0,,МОЖНО ТРЕБОВАТЬ САМЫХ ЖЁСТКИХ УСЛОВИЙ,
Dialogue: 0,0:11:41.36,0:11:44.72,Caption,,0,0,0,,ЧЕРТИТЬ КРАСНЫЕ ЛИНИИ И ОТВЕРГАТЬ УСТУПКИ. КОГДА
Dialogue: 0,0:11:44.72,0:11:47.20,Caption,,0,0,0,,ОЧЕРЕДНОЙ ПЕРЕВОД НАЧИНАЕТ УГРОЖАТЬ ВНУТРЕННИМ
Dialogue: 0,0:11:47.20,0:11:51.04,Caption,,0,0,0,,ПРОГРАММАМ, РЯДОМ С ПРИНЦИПАМИ ПОЯВЛЯЕТСЯ ВЕДОМОСТЬ РАСХОДОВ.
Dialogue: 0,0:11:51.32,0:11:54.72,Caption,,0,0,0,,ОНА ГОВОРИТ ТИШЕ, ЗАТО МИНИСТРЫ СЛУШАЮТ ЕЁ ВНИМАТЕЛЬНЕЕ.
Dialogue: 0,0:11:55.46,0:11:57.84,Caption,,0,0,0,,ПОЛЬША ДЕМОНСТРИРУЕТ ИМЕННО ТАКУЮ ПЕРЕМЕНУ.
Dialogue: 0,0:11:58.40,0:12:00.64,Caption,,0,0,0,,ВАРШАВА СОХРАНЯЕТ ПРЕЖНЮЮ РИТОРИКУ,
Dialogue: 0,0:12:00.88,0:12:03.84,Caption,,0,0,0,,МНОГО ТРАТИТ НА ОБОРОНУ И СЧИТАЕТ РОССИЮ УГРОЗОЙ.
Dialogue: 0,0:12:04.32,0:12:06.16,Caption,,0,0,0,,НО ИЗ ЭТОГО ОНА ДЕЛАЕТ НЕ ВЫВОД О
Dialogue: 0,0:12:06.24,0:12:10.72,Caption,,0,0,0,,НОВОМ ПЛАТЕЖЕ УКРАИНЕ, А ПРОТИВОПОЛОЖНЫЙ ВЫВОД. СОБСТВЕННАЯ АРМИЯ ПОЛУЧАЕТ
Dialogue: 0,0:12:10.72,0:12:13.60,Caption,,0,0,0,,ПРИОРИТЕТ. ЭТО НЕ СМЕНА СТОРОНЫ И НЕ ПОЛНЫЙ
Dialogue: 0,0:12:13.60,0:12:16.80,Caption,,0,0,0,,РАЗВОРОТ КУРСА. ГОСУДАРСТВО ЛИШЬ МЕНЯЕТ ОЧЕРЕДНОСТЬ
Dialogue: 0,0:12:16.80,0:12:20.40,Caption,,0,0,0,,ТЕХ, КОМУ ДОСТАНУТСЯ ДЕНЬГИ. ОДНАКО ПОДОБНАЯ ПЕРЕСТАНОВКА
Dialogue: 0,0:12:20.40,0:12:22.48,Caption,,0,0,0,,СПОСОБНА ПОВЛИЯТЬ НА КИЕВ СИЛЬНЕЕ,
Dialogue: 0,0:12:22.72,0:12:27.44,Caption,,0,0,0,,ЧЕМ ДЕСЯТОК ГРОМКИХ РЕЧЕЙ. ЕСЛИ ДРУГИЕ СТРАНЫ ПОСЛЕДУЮТ ПОЛЬСКОМУ ПРИМЕРУ,
Dialogue: 0,0:12:27.68,0:12:30.16,Caption,,0,0,0,,УКРАИНСКОЕ ФИНАНСИРОВАНИЕ НАЧНЁТ СОКРАЩАТЬСЯ БЕЗ
Dialogue: 0,0:12:30.16,0:12:33.52,Caption,,0,0,0,,ЕДИНОГО ОБЩЕГО РЕШЕНИЯ О СОКРАЩЕНИИ. ФОРМАЛЬНО ВСЕ
Dialogue: 0,0:12:33.52,0:12:35.12,Caption,,0,0,0,,ОСТАНУТСЯ СТОРОННИКАМИ УКРАИНЫ.
Dialogue: 0,0:12:37.41,0:12:40.77,Caption,,0,0,0,,ОДИН КАБИНЕТ НЕ ВНЕСЁТ ДОПОЛНИТЕЛЬНУЮ СУММУ. ВТОРОЙ
Dialogue: 0,0:12:40.87,0:12:43.81,Caption,,0,0,0,,УРЕЖЕТ УЧАСТИЕ. ТРЕТИЙ ПОТРЕБУЕТ СОХРАНИТЬ СВОИ
Dialogue: 0,0:12:43.89,0:12:46.53,Caption,,0,0,0,,ФОНДЫ. ЧЕТВЁРТЫЙ СОГЛАСИТСЯ ТОЛЬКО В ОБМЕН НА
Dialogue: 0,0:12:46.53,0:12:50.21,Caption,,0,0,0,,КОМПЕНСАЦИЮ. ВОТ ПОЧЕМУ МАКРОН И МЕРЦ ТОРОПЯТСЯ. ОНИ
Dialogue: 0,0:12:50.21,0:12:52.61,Caption,,0,0,0,,ПЫТАЮТСЯ ЗАКРЕПИТЬ ОБЯЗАТЕЛЬСТВА ДО ТОГО,
Dialogue: 0,0:12:52.77,0:12:55.49,Caption,,0,0,0,,КАК ОТДЕЛЬНЫЕ ОТКАЗЫ СЛОЖАТСЯ В БОЛЬШУЮ НЕХВАТКУ
Dialogue: 0,0:12:55.49,0:12:59.09,Caption,,0,0,0,,СРЕДСТВ. НО СЕМИЛЕТНИЙ ПЛАН НЕ ОТМЕНЯЕТ ЕЖЕГОДНУЮ
Dialogue: 0,0:12:59.17,0:13:01.81,Caption,,0,0,0,,РЕАЛЬНОСТЬ. МОЖНО УТВЕРДИТЬ ПРОГРАММУ ДО КОНЦА
Dialogue: 0,0:13:01.81,0:13:05.25,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯ И ВПИСАТЬ В НЕЁ ВПЕЧАТЛЯЮЩИЕ СУММЫ. ЕСЛИ
Dialogue: 0,0:13:05.25,0:13:07.33,Caption,,0,0,0,,ЗАТЕМ В ОДНОЙ СТРАНЕ СМЕНИТСЯ ВЛАСТЬ,
Dialogue: 0,0:13:07.49,0:13:11.73,Caption,,0,0,0,,В ДРУГОЙ ВЫРАСТЕТ ДЕФИЦИТ, В ТРЕТЬЕЙ НАЧНУТ СОКРАЩАТЬ СОЦИАЛЬНЫЕ РАСХОДЫ,
Dialogue: 0,0:13:12.10,0:13:14.53,Caption,,0,0,0,,А В ЧЕТВЁРТОЙ ИЗБИРАТЕЛИ ПОТРЕБУЮТ ОСТАВИТЬ НАЛОГИ
Dialogue: 0,0:13:14.61,0:13:18.45,Caption,,0,0,0,,ДОМА, ДОКУМЕНТ НЕ ДОСТАНЕТ ДЕНЬГИ САМОСТОЯТЕЛЬНО. СМЫСЛ В
Dialogue: 0,0:13:18.53,0:13:21.17,Caption,,0,0,0,,ДРУГОМ. ЧЕМ ДОЛЬШЕ ПРОДОЛЖАЕТСЯ КОНФЛИКТ,
Dialogue: 0,0:13:21.45,0:13:24.37,Caption,,0,0,0,,ТЕМ МЕНЬШЕ ВОПРОС ПОМОЩИ ПОХОЖ НА ПРОВЕРКУ ВЕРНОСТИ
Dialogue: 0,0:13:24.45,0:13:27.25,Caption,,0,0,0,,И ТЕМ БОЛЬШЕ НАПОМИНАЕТ СПОР О КОНКРЕТНОЙ ЦЕНЕ.
Dialogue: 0,0:13:27.89,0:13:30.13,Caption,,0,0,0,,ЕСЛИ СОМНЕНИЯ ПОЯВЛЯЮТСЯ ДАЖЕ В ВАРШАВЕ,
Dialogue: 0,0:13:30.45,0:13:34.37,Caption,,0,0,0,,СПИСАТЬ ИХ НА ОРБАНА, БОЛГАРСКУЮ БЕДНОСТЬ ИЛИ ВЕЧНОЕ НЕДОВОЛЬСТВО
Dialogue: 0,0:13:34.37,0:13:36.61,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СКЕПТИКОВ УЖЕ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:13:37.17,0:13:40.13,Caption,,0,0,0,,ПОЛЬСКИЙ ОТКАЗ ЛИШАЕТ КИЕВ ДОПОЛНИТЕЛЬНОГО ПЛАТЕЖА
Dialogue: 0,0:13:40.13,0:13:43.25,Caption,,0,0,0,,СЕЙЧАС. ВОЗРАЖЕНИЯ ШЕСТИ ГОСУДАРСТВ ОСЛОЖНЯЮТ
Dialogue: 0,0:13:43.25,0:13:45.57,Caption,,0,0,0,,ВКЛЮЧЕНИЕ ПОМОЩИ В БЮДЖЕТ НА СЕМЬ ЛЕТ.
Dialogue: 0,0:13:47.84,0:13:51.04,Caption,,0,0,0,,А СПОР О СОКРАЩЕНИИ ЕВРОПЕЙСКИХ ФОНДОВ ПРЕВРАЩАЕТ
Dialogue: 0,0:13:51.04,0:13:53.28,Caption,,0,0,0,,ПОДДЕРЖКУ УКРАИНЫ ВО ВНУТРЕННЮЮ ЦЕНУ,
Dialogue: 0,0:13:53.60,0:13:55.60,Caption,,0,0,0,,КОТОРУЮ ПРАВИТЕЛЬСТВАМ ПРИДЁТСЯ ОБЪЯСНЯТЬ
Dialogue: 0,0:13:55.67,0:13:59.36,Caption,,0,0,0,,СОБСТВЕННЫМ ИЗБИРАТЕЛЯМ. ЕСЛИ ХОТИТЕ И ДАЛЬШЕ ВИДЕТЬ,
Dialogue: 0,0:13:59.52,0:14:02.64,Caption,,0,0,0,,КАКИЕ ПРАВИТЕЛЬСТВА ОБЕЩАЛИ КИЕВУ НОВЫЕ СРЕДСТВА И
Dialogue: 0,0:14:02.64,0:14:04.64,Caption,,0,0,0,,КТО ИЗ НИХ В ИТОГЕ ОТКАЗАЛСЯ ПЛАТИТЬ,
Dialogue: 0,0:14:04.89,0:14:07.60,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ИМЕННО ВОЗЛЕ КАССЫ
Dialogue: 0,0:14:07.60,0:14:10.80,Caption,,0,0,0,,ЗАЯВЛЕНИЯ ЕВРОПЕЙСКИХ ЛИДЕРОВ ПОЛУЧАЮТ ЧЕСТНЫЙ
Dialogue: 0,0:14:10.88,0:14:13.76,Caption,,0,0,0,,ПЕРЕВОД. САМЫЙ ОПАСНЫЙ ДЛЯ УКРАИНЫ ВАРИАНТ ВЫГЛЯДИТ
Dialogue: 0,0:14:13.84,0:14:16.00,Caption,,0,0,0,,НЕГРОМКО. НИКТО НЕ ХЛОПАЕТ ДВЕРЬЮ,
Dialogue: 0,0:14:16.08,0:14:19.36,Caption,,0,0,0,,НЕ ОТМЕНЯЕТ ПОДДЕРЖКУ И НЕ МЕНЯЕТ СОЮЗНИКОВ. ПРОСТО
Dialogue: 0,0:14:19.44,0:14:22.24,Caption,,0,0,0,,ЗА КАЖДЫМ НОВЫМ ВЗНОСОМ ПРИХОДИТСЯ ХОДИТЬ ДОЛЬШЕ,
Dialogue: 0,0:14:22.46,0:14:25.44,Caption,,0,0,0,,УГОВАРИВАТЬ ЖЁСТЧЕ И ВОЗВРАЩАТЬСЯ С МЕНЬШЕЙ СУММОЙ.
Dialogue: 0,0:14:26.07,0:14:29.04,Caption,,0,0,0,,ИМЕННО ТАК ПОМОЩЬ МОЖЕТ СОХРАНИТЬСЯ НА СЛОВАХ И
Dialogue: 0,0:14:29.04,0:14:31.20,Caption,,0,0,0,,ОДНОВРЕМЕННО НАЧАТЬ ИСЧЕЗАТЬ В ДЕНЬГАХ.
