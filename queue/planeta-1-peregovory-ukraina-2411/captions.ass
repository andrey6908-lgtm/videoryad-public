Dialogue: 0,0:00:00.04,0:00:05.24,Caption,,0,0,0,,У СЛОВА ОТКАЗ, ПОХОЖЕ, ПОЯВИЛСЯ СРОК ГОДНОСТИ. МОСКВА ГОДАМИ ОБЪЯСНЯЕТ,
Dialogue: 0,0:00:05.48,0:00:08.12,Caption,,0,0,0,,ЧТО УКРАИНА В НАТО ДЛЯ НЕЁ НЕПРИЕМЛЕМА. ТЕПЕРЬ
Dialogue: 0,0:00:08.20,0:00:11.24,Caption,,0,0,0,,ЕЙ ПРЕДЛАГАЮТ ОТДАТЬ ДОНБАСС И ВЗАМЕН СОГЛАСИТЬСЯ
Dialogue: 0,0:00:11.24,0:00:15.08,Caption,,0,0,0,,ИМЕННО НА ТО, ПРОТИВ ЧЕГО ВСЁ НАЧИНАЛОСЬ. А ПОДАЮТ ЭТО ТАК,
Dialogue: 0,0:00:15.39,0:00:18.12,Caption,,0,0,0,,БУДТО РОССИЯ УЖЕ ПОЧТИ КИВНУЛА. ВИДИМО,
Dialogue: 0,0:00:18.44,0:00:20.60,Caption,,0,0,0,,ЕСЛИ ДОСТАТОЧНО ДОЛГО НЕ ЗАМЕЧАТЬ ОТВЕТ,
Dialogue: 0,0:00:20.96,0:00:23.88,Caption,,0,0,0,,ОН ОДНАЖДЫ САМ ПРЕВРАЩАЕТСЯ В СОГЛАСИЕ. ЕСЛИ ВАМ
Dialogue: 0,0:00:23.88,0:00:27.32,Caption,,0,0,0,,НРАВЯТСЯ РАЗБОРЫ, В КОТОРЫХ УСЛОВИЯ СДЕЛКИ ЧИТАЮТ ЦЕЛИКОМ,
Dialogue: 0,0:00:27.56,0:00:29.64,Caption,,0,0,0,,А НЕ ТОЛЬКО КРАСИВУЮ НАДПИСЬ НА ОБЛОЖКЕ,
Dialogue: 0,0:00:29.88,0:00:32.84,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ТРАМП ПЕРЕСКАЗЫВАЕТ СВОЙ
Dialogue: 0,0:00:32.84,0:00:35.32,Caption,,0,0,0,,РАЗГОВОР С ПУТИНЫМ И ВЫНОСИТ ИЗ НЕГО ФРАЗУ,
Dialogue: 0,0:00:35.54,0:00:38.36,Caption,,0,0,0,,КОТОРАЯ ЕМУ ОСОБЕННО ПРИЯТНА. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:38.66,0:00:42.52,Caption,,0,0,0,,ПУТИН ЗАЯВИЛ, ЧТО ПРИ ТРАМПЕ ВТОРЖЕНИЯ НЕ ПРОИЗОШЛО БЫ.
Dialogue: 0,0:00:42.79,0:00:45.48,Caption,,0,0,0,,АМЕРИКАНСКИЙ ПРЕЗИДЕНТ СРАЗУ ВЕРНУЛСЯ К ВЫБОРАМ,
Dialogue: 0,0:00:45.64,0:00:47.48,Caption,,0,0,0,,КОТОРЫЕ СЧИТАЕТ СФАЛЬСИФИЦИРОВАННЫМИ,
Dialogue: 0,0:00:47.72,0:00:50.52,Caption,,0,0,0,,К ЧЕТЫРЁМ ПОТЕРЯННЫМ ГОДАМ И К ПРОВАЛАМ ПРЕЖНЕЙ
Dialogue: 0,0:00:50.52,0:00:52.76,Caption,,0,0,0,,АДМИНИСТРАЦИИ. ЗАОДНО ОН СООБЩИЛ,
Dialogue: 0,0:00:53.00,0:00:55.64,Caption,,0,0,0,,ЧТО МОСКВА ХОЧЕТ ЗАВЕРШИТЬ КОНФЛИКТ ПЕРЕГОВОРАМИ,
Dialogue: 0,0:00:55.88,0:00:58.60,Caption,,0,0,0,,А ЕГО ПРЕДСТАВИТЕЛИ ОТЛИЧНО ДЕЛАЮТ СВОЮ РАБОТУ.
Dialogue: 0,0:00:58.83,0:01:00.52,Caption,,0,0,0,,СКРОМНОСТЬ В КОМПЛЕКТ НЕ ВОШЛА,
Dialogue: 0,0:01:00.76,0:01:03.80,Caption,,0,0,0,,НО ЕЁ НИКТО И НЕ ЗАКАЗЫВАЛ. ЗЕЛЕНСКИЙ НАПОМИНАЕТ
Dialogue: 0,0:01:03.83,0:01:06.92,Caption,,0,0,0,,О ДРУГОМ ОБЕЩАНИИ ТРАМПА. ЕЩЁ ДО ВОЗВРАЩЕНИЯ В
Dialogue: 0,0:01:06.92,0:01:09.72,Caption,,0,0,0,,БЕЛЫЙ ДОМ ТОТ СОБИРАЛСЯ ЗАКОНЧИТЬ КОНФЛИКТ ЗА СУТКИ.
Dialogue: 0,0:01:12.01,0:01:15.85,Caption,,0,0,0,,КИЕВ ТОГДА ПРЕДУПРЕЖДАЛ, ЧТО СЕКУНДОМЕР ЗДЕСЬ БЕСПОЛЕЗЕН РОССИЯ МОЖЕТ
Dialogue: 0,0:01:15.85,0:01:18.17,Caption,,0,0,0,,ОБСУЖДАТЬ МИР И ОДНОВРЕМЕННО ДОБИВАТЬСЯ
Dialogue: 0,0:01:18.17,0:01:20.81,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫХ ЦЕЛЕЙ. ТЕПЕРЬ СПОР ИДЁТ УЖЕ НЕ О
Dialogue: 0,0:01:20.81,0:01:24.57,Caption,,0,0,0,,СКОРОСТИ. ВОПРОС В ТОМ, ЧТО ИМЕННО СОБИРАЮТСЯ ПОДПИСЫВАТЬ.
Dialogue: 0,0:01:25.29,0:01:27.77,Caption,,0,0,0,,МЕЛАНИЯ ТРАМП ДОПУСТИЛА НОВОЕ ПЕРЕМИРИЕ ДО
Dialogue: 0,0:01:27.77,0:01:30.41,Caption,,0,0,0,,РОЖДЕСТВА, ЕСЛИ ОБЕ СТОРОНЫ ОКАЖУТСЯ ГОТОВЫ.
Dialogue: 0,0:01:30.96,0:01:34.81,Caption,,0,0,0,,ЗВУЧИТ ПРИЯТНО, НО ПАУЗА В СТРЕЛЬБЕ ЕЩЁ НЕ ОБЪЯСНЯЕТ УСТРОЙСТВО
Dialogue: 0,0:01:34.81,0:01:37.77,Caption,,0,0,0,,БУДУЩЕГО МИРА. МОЖНО ВЫКЛЮЧИТЬ БУДИЛЬНИК НА НОЧЬ,
Dialogue: 0,0:01:37.93,0:01:40.65,Caption,,0,0,0,,ОДНАКО УТРОМ ВСЕ ПРЕЖНИЕ СЧЕТА СНОВА ЛЕЖАТ НА
Dialogue: 0,0:01:40.65,0:01:44.65,Caption,,0,0,0,,СТОЛЕ. БУДАНОВ ВЫРАЗИЛСЯ ЗАМЕТНО ТРЕЗВЕЕ. ЗАВЕРШЕНИЕ
Dialogue: 0,0:01:44.65,0:01:47.61,Caption,,0,0,0,,КОНФЛИКТА ДО КОНЦА ГОДА ОН НАЗВАЛ ПРАКТИЧЕСКИ ЧУДОМ.
Dialogue: 0,0:01:48.09,0:01:50.09,Caption,,0,0,0,,РАБОТАТЬ, ПО ЕГО СЛОВАМ, БУДУТ,
Dialogue: 0,0:01:50.33,0:01:52.81,Caption,,0,0,0,,НО ЧУДЕСА ОТ ЭТОГО НЕ ПЕРЕХОДЯТ В КАТЕГОРИЮ
Dialogue: 0,0:01:52.81,0:01:55.77,Caption,,0,0,0,,ПРОИЗВОДСТВЕННОГО ПЛАНА. СРОКИ УЖЕ НАЗНАЧИЛИ,
Dialogue: 0,0:01:55.99,0:01:58.33,Caption,,0,0,0,,ХОТЯ УСЛОВИЯ ПОКА НАПОМИНАЮТ ЗАКАЗ,
Dialogue: 0,0:01:58.57,0:02:01.13,Caption,,0,0,0,,КОТОРЫЙ ДЕСЯТЬ ЧЕЛОВЕК ОФОРМЛЯЛИ ОДНОВРЕМЕННО И
Dialogue: 0,0:02:01.21,0:02:04.49,Caption,,0,0,0,,КАЖДЫЙ ВЫБРАЛ СВОЮ КОМПЛЕКТАЦИЮ. ОДИН ИЗ ОБСУЖДАЕМЫХ
Dialogue: 0,0:02:04.49,0:02:07.61,Caption,,0,0,0,,ВАРИАНТОВ ОПИСАЛА УОЛЛ СТРИТ ДЖОРНАЛ. СМЫСЛ
Dialogue: 0,0:02:07.69,0:02:10.17,Caption,,0,0,0,,КОНСТРУКЦИИ ПРОСТ УКРАИНА СОХРАНЯЕТ ПЕРСПЕКТИВУ
Dialogue: 0,0:02:10.17,0:02:13.85,Caption,,0,0,0,,ВСТУПЛЕНИЯ В НАТО, А РОССИЯ ПОЛУЧАЕТ ТЕРРИТОРИАЛЬНЫЙ РЕЗУЛЬТАТ В
Dialogue: 0,0:02:13.85,0:02:17.05,Caption,,0,0,0,,ДОНБАССЕ. ИМЕННО ЗДЕСЬ ВСЯ УПАКОВКА НАЧИНАЕТ
Dialogue: 0,0:02:17.05,0:02:19.53,Caption,,0,0,0,,ТРЕЩАТЬ. МОСКВА НЕ ОДИН ГОД ПОВТОРЯЛА,
Dialogue: 0,0:02:19.77,0:02:22.73,Caption,,0,0,0,,ЧТО УКРАИНСКОЕ ЧЛЕНСТВО В АЛЬЯНСЕ ДЛЯ НЕЁ ЯВЛЯЕТСЯ
Dialogue: 0,0:02:22.73,0:02:28.28,Caption,,0,0,0,,КРАСНОЙ ЛИНИЕЙ. ТЕПЕРЬ ЭТУ ЖЕ ЛИНИЮ ПРЕДЛАГАЮТ ПЕРЕСЕЧЬ,
Dialogue: 0,0:02:28.41,0:02:31.16,Caption,,0,0,0,,ПОЛОЖИВ РЯДОМ ТЕРРИТОРИАЛЬНУЮ УСТУПКУ И ПРИКЛЕИВ
Dialogue: 0,0:02:31.16,0:02:34.28,Caption,,0,0,0,,СВЕРХУ СЛОВО КОМПРОМИСС. ОЧЕНЬ УДОБНЫЙ СПОСОБ ВЕСТИ
Dialogue: 0,0:02:34.28,0:02:39.16,Caption,,0,0,0,,ПЕРЕГОВОРЫ ВЫСЛУШАТЬ ОТКАЗ, ПОДОЖДАТЬ И ВЕРНУТЬ ПРЕЖНЕЕ ПРЕДЛОЖЕНИЕ С НОВЫМ
Dialogue: 0,0:02:39.16,0:02:42.76,Caption,,0,0,0,,БАНТИКОМ. ПРОТИВОРЕЧИЕ НЕ КОСМЕТИЧЕСКОЕ. НЕДОПУЩЕНИЕ
Dialogue: 0,0:02:42.76,0:02:45.00,Caption,,0,0,0,,УКРАИНЫ В НАТО НАЗЫВАЛОСЬ ОДНОЙ ИЗ ПРИЧИН,
Dialogue: 0,0:02:45.24,0:02:48.20,Caption,,0,0,0,,КОТОРЫМИ РОССИЯ ОБЪЯСНЯЛА НАЧАЛО КОНФЛИКТА. ЕСЛИ
Dialogue: 0,0:02:48.20,0:02:51.16,Caption,,0,0,0,,МОСКВА ПРИНИМАЕТ ЧЛЕНСТВО КИЕВА В ОБМЕН НА ДОНБАСС,
Dialogue: 0,0:02:51.48,0:02:56.20,Caption,,0,0,0,,ОНА ПОЛУЧАЕТ ЗЕМЛЮ, НО СОБСТВЕННОРУЧНО ЗАКРЕПЛЯЕТ СТРАТЕГИЧЕСКУЮ УГРОЗУ,
Dialogue: 0,0:02:56.44,0:02:59.32,Caption,,0,0,0,,РАДИ УСТРАНЕНИЯ КОТОРОЙ ВСЁ И ЗАТЕВАЛОСЬ. ПОБЕДА
Dialogue: 0,0:02:59.32,0:03:01.80,Caption,,0,0,0,,ВЫХОДИТ СВОЕОБРАЗНАЯ КЛЮЧ ОТ КОМНАТЫ ВЗЯЛИ,
Dialogue: 0,0:03:02.12,0:03:05.00,Caption,,0,0,0,,А ВЕСЬ ДОМ ЗАПИСАЛИ НА СОСЕДА. ПОЭТОМУ ВОПРОС
Dialogue: 0,0:03:05.00,0:03:08.52,Caption,,0,0,0,,О КАПИТУЛЯЦИИ ВОЗНИКАЕТ НЕ РАДИ ГРОМКОГО СЛОВА. ЕСЛИ
Dialogue: 0,0:03:08.52,0:03:11.08,Caption,,0,0,0,,РОССИЯ ДЕЙСТВИТЕЛЬНО СОГЛАСИТСЯ НА ТАКУЮ СХЕМУ,
Dialogue: 0,0:03:11.32,0:03:13.56,Caption,,0,0,0,,ОНА УСТУПИТ ПО ОДНОМУ ИЗ ГЛАВНЫХ ПУНКТОВ.
Dialogue: 0,0:03:14.00,0:03:16.92,Caption,,0,0,0,,КАПИТУЛИРУЕТ ЗДЕСЬ НЕ КИЕВ И НЕ НЕКИЙ ВООБРАЖАЕМЫЙ
Dialogue: 0,0:03:16.92,0:03:20.20,Caption,,0,0,0,,ЦЕНТР МЕЖДУ СТОРОНАМИ. МОСКВА ОТКАЗЫВАЕТСЯ ОТ СВОЕЙ
Dialogue: 0,0:03:20.20,0:03:23.32,Caption,,0,0,0,,ПОЗИЦИИ ПО НАТО. ЗЕЛЕНСКИЙ ТРЕБУЕТ ПИСЬМЕННЫХ
Dialogue: 0,0:03:23.40,0:03:25.64,Caption,,0,0,0,,ГАРАНТИЙ БЕЗОПАСНОСТИ НА ДЕСЯТИЛЕТИЯ,
Dialogue: 0,0:03:25.96,0:03:28.68,Caption,,0,0,0,,А НЕ ДО КОНЦА ПРЕЗИДЕНТСКОГО СРОКА ТРАМПА. КИЕВ
Dialogue: 0,0:03:28.68,0:03:31.32,Caption,,0,0,0,,ХОЧЕТ ЗАРАНЕЕ ЗНАТЬ, КАКИЕ ГОСУДАРСТВА,
Dialogue: 0,0:03:31.54,0:03:34.52,Caption,,0,0,0,,КАКИМИ СИЛАМИ И В КАКОМ ПОРЯДКЕ СТАНУТ ДЕЙСТВОВАТЬ
Dialogue: 0,0:03:34.60,0:03:40.89,Caption,,0,0,0,,ПРИ НОВОМ КОНФЛИКТЕ. ЧЛЕНСТВО В НАТО ОН СЧИТАЕТ БОЛЕЕ ДЕШЁВЫМ ВАРИАНТОМ,
Dialogue: 0,0:03:41.05,0:03:43.93,Caption,,0,0,0,,ЧЕМ СОДЕРЖАНИЕ МИЛЛИОННОЙ АРМИИ ВНЕ АЛЬЯНСА.
Dialogue: 0,0:03:44.62,0:03:49.53,Caption,,0,0,0,,ЕСЛИ РАСХОДЫ НЕСУТ СОЮЗНИКИ, УКРАИНЕ НЕ ПРИХОДИТСЯ ДЕСЯТИЛЕТИЯМИ ОПЛАЧИВАТЬ ВСЮ
Dialogue: 0,0:03:49.61,0:03:52.33,Caption,,0,0,0,,ЭТУ МАХИНУ В ОДИНОЧКУ. ОКОНЧАТЕЛЬНЫЙ ВЫБОР,
Dialogue: 0,0:03:52.49,0:03:54.81,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, БУДЕТ ЗАВИСЕТЬ ОТ ТОГО,
Dialogue: 0,0:03:55.00,0:03:58.01,Caption,,0,0,0,,КАК ЗАКОНЧИТСЯ НЫНЕШНИЙ КОНФЛИКТ. ТОГДА ПОЛЕЗНО
Dialogue: 0,0:03:58.01,0:04:01.53,Caption,,0,0,0,,УБРАТЬ ТОРЖЕСТВЕННЫЕ РЕЧИ И ПОСМОТРЕТЬ НА КАССУ. КТО
Dialogue: 0,0:04:01.53,0:04:04.33,Caption,,0,0,0,,ОПЛАЧИВАЕТ СИСТЕМУ, КТО ПОЛУЧАЕТ ЗАЩИТУ,
Dialogue: 0,0:04:04.49,0:04:09.77,Caption,,0,0,0,,А КТО ПРИНИМАЕТ НА СЕБЯ РИСК? ДЭВИД ИГНАТИУС ПИШЕТ В ВАШИНГТОН ПОСТ СО ССЫЛКОЙ
Dialogue: 0,0:04:09.85,0:04:11.93,Caption,,0,0,0,,НА ИСТОЧНИК, БЛИЗКИЙ К ПЕРЕГОВОРАМ,
Dialogue: 0,0:04:12.16,0:04:14.89,Caption,,0,0,0,,ЧТО ПУТИН ЯКОБЫ ЧАСТНЫМ ОБРАЗОМ СОГЛАСИЛСЯ
Dialogue: 0,0:04:14.89,0:04:17.77,Caption,,0,0,0,,ПРЕДОСТАВИТЬ УКРАИНЕ ГАРАНТИИ ПО МОДЕЛИ ПЯТОЙ СТАТЬИ
Dialogue: 0,0:04:17.77,0:04:21.45,Caption,,0,0,0,,НАТО. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ РАЗВИЛКА. ПУБЛИЧНО МОСКВА
Dialogue: 0,0:04:21.45,0:04:24.25,Caption,,0,0,0,,ОТВЕРГАЛА ЛЮБЫЕ ВАРИАНТЫ КВАЗИЧЛЕНСТВА УКРАИНЫ В
Dialogue: 0,0:04:24.25,0:04:27.45,Caption,,0,0,0,,АЛЬЯНСЕ. РЯБКОВ ПРЯМО НАЗЫВАЛ ПОДОБНЫЕ КОНСТРУКЦИИ
Dialogue: 0,0:04:27.45,0:04:30.33,Caption,,0,0,0,,НЕПРИЕМЛЕМЫМИ. ОДНОВРЕМЕННО ЧИТАТЕЛЮ ПРЕДЛАГАЮТ
Dialogue: 0,0:04:30.33,0:04:33.77,Caption,,0,0,0,,ПОВЕРИТЬ, ЧТО ПУТИН ГОТОВ ПРИНЯТЬ ПОЧТИ ТАКОЙ ЖЕ МЕХАНИЗМ
Dialogue: 0,0:04:33.85,0:04:36.25,Caption,,0,0,0,,ПРИ ОДНОМ УСЛОВИИ ПОСТОЯННЫХ ВОЙСК НАТО НА
Dialogue: 0,0:04:36.25,0:04:37.77,Caption,,0,0,0,,УКРАИНСКОЙ ТЕРРИТОРИИ НЕ БУДЕТ.
Dialogue: 0,0:04:38.32,0:04:41.61,Caption,,0,0,0,,ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ РОССИЙСКИЕ СИЛЫ ДОЛЖНЫ ОТОЙТИ
Dialogue: 0,0:04:41.69,0:04:44.65,Caption,,0,0,0,,ОТ УКРАИНСКОЙ ГРАНИЦЫ. НОВОЕ СОСРЕДОТОЧЕНИЕ ВОЙСК
Dialogue: 0,0:04:44.73,0:04:47.21,Caption,,0,0,0,,ДЛЯ НАСТУПЛЕНИЯ ПРИВЕДЁТ К ВОЗВРАЩЕНИЮ САНКЦИЙ,
Dialogue: 0,0:04:47.43,0:04:50.33,Caption,,0,0,0,,КОТОРЫЕ ПЕРЕД ЭТИМ, ВОЗМОЖНО, НЕМНОГО ОСЛАБЯТ.
Dialogue: 0,0:04:52.61,0:04:56.93,Caption,,0,0,0,,ЕСЛИ НАСТУПЛЕНИЕ НАЧНЁТСЯ, ПОДРАЗДЕЛЕНИЯ НАТО ОБЯЗУЮТСЯ БЫСТРО ПРИБЫТЬ НА
Dialogue: 0,0:04:57.01,0:05:00.53,Caption,,0,0,0,,УКРАИНУ. МОСКВА ОТВОДИТ ВОЙСКА. КИЕВ ПОЛУЧАЕТ
Dialogue: 0,0:05:00.53,0:05:03.17,Caption,,0,0,0,,ПРОДОЛЖИТЕЛЬНЫЕ ГАРАНТИИ. ЗАПАД СОХРАНЯЕТ
Dialogue: 0,0:05:03.17,0:05:06.05,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ОПЕРАТИВНО ВКЛЮЧИТЬСЯ ВОЕННЫМ СПОСОБОМ.
Dialogue: 0,0:05:06.29,0:05:09.25,Caption,,0,0,0,,САНКЦИИ НЕ ОТМЕНЯЮТ, А ЛИШЬ СТАВЯТ ВОЗЛЕ ДВЕРИ,
Dialogue: 0,0:05:09.33,0:05:12.53,Caption,,0,0,0,,ЧТОБЫ ПРИ НЕОБХОДИМОСТИ СРАЗУ ЗАНЕСТИ ОБРАТНО. ЭТО
Dialogue: 0,0:05:12.53,0:05:17.01,Caption,,0,0,0,,УЖЕ НЕ СНЯТИЕ УДАВКИ, А РАЗРЕШЕНИЕ НЕНАДОЛГО РАССТЕГНУТЬ ВЕРХНЮЮ ПУГОВИЦУ.
Dialogue: 0,0:05:17.40,0:05:21.41,Caption,,0,0,0,,ЧТО ПРЕДЛАГАЕТСЯ РОССИИ? НЕКОТОРОЕ СМЯГЧЕНИЕ САНКЦИЙ В НЕОПРЕДЕЛЁННОМ
Dialogue: 0,0:05:21.41,0:05:24.13,Caption,,0,0,0,,БУДУЩЕМ. МАСШТАБ И СРОКИ ОСТАЮТСЯ НЕЯСНЫ,
Dialogue: 0,0:05:24.37,0:05:26.85,Caption,,0,0,0,,А ВОТ УСЛОВИЯ ОБРАТНОГО ВКЛЮЧЕНИЯ ПРОПИСАНЫ КУДА
Dialogue: 0,0:05:26.85,0:05:29.17,Caption,,0,0,0,,УВЕРЕННЕЕ. И ЭТО НАЗЫВАЮТ УСТУПКОЙ?
Dialogue: 0,0:05:29.73,0:05:31.89,Caption,,0,0,0,,ЕСЛИ ОПУБЛИКОВАННАЯ СХЕМА ПЕРЕДАНА ВЕРНО,
Dialogue: 0,0:05:32.29,0:05:36.93,Caption,,0,0,0,,ПЕРЕД НАМИ НЕ РАВНЫЙ ОБМЕН, А ПЛАН КАПИТУЛЯЦИИ БЕЗ ПОСЛЕДНЕЙ КОМАНДЫ СЛОЖИТЬ
Dialogue: 0,0:05:36.93,0:05:40.21,Caption,,0,0,0,,ОРУЖИЕ. ПРОБЛЕМА НАТО ОСТАЁТСЯ. ВОЕННЫЙ РЫЧАГ
Dialogue: 0,0:05:40.21,0:05:43.49,Caption,,0,0,0,,НАХОДИТСЯ У ЗАПАДА. САНКЦИОННЫЙ РЫЧАГ НАХОДИТСЯ ТАМ
Dialogue: 0,0:05:43.57,0:05:48.61,Caption,,0,0,0,,ЖЕ. РОССИЙСКАЯ АРМИЯ ОТХОДИТ, А ВСТРЕЧНАЯ ВЫГОДА РАСТВОРЯЕТСЯ ГДЕ ТО МЕЖДУ СЛОВАМИ
Dialogue: 0,0:05:48.61,0:05:51.01,Caption,,0,0,0,,ВОЗМОЖНО И ПОЗДНЕЕ. НЕПЛОХО УСТРОИЛИСЬ.
Dialogue: 0,0:05:51.81,0:05:54.21,Caption,,0,0,0,,КУШНЕР В ЭТО ЖЕ ВРЕМЯ ОПИСЫВАЕТ БОЛЕЕ ШИРОКУЮ
Dialogue: 0,0:05:54.21,0:05:55.97,Caption,,0,0,0,,СИСТЕМУ БЕЗОПАСНОСТИ ДЛЯ ЕВРОПЫ.
Dialogue: 0,0:05:56.53,0:05:59.17,Caption,,0,0,0,,ГОТОВНОСТЬ РОССИИ ОБСУЖДАТЬ ГАРАНТИИ КИЕВУ,
Dialogue: 0,0:05:59.32,0:06:03.57,Caption,,0,0,0,,ПОХОЖИЕ НА ПЯТУЮ СТАТЬЮ, ОН СЧИТАЕТ КРУПНЫМ ШАГОМ И ДОКАЗАТЕЛЬСТВОМ
Dialogue: 0,0:06:03.57,0:06:06.05,Caption,,0,0,0,,СЕРЬЁЗНОГО ОТНОШЕНИЯ МОСКВЫ К УРЕГУЛИРОВАНИЮ.
Dialogue: 0,0:06:08.34,0:06:12.02,Caption,,0,0,0,,ПО ЕГО ЗАМЫСЛУ, УКРАИНСКИЕ ГАРАНТИИ ДОЛЖНЫ БЫТЬ ЧАСТЬЮ ОБЩЕГО
Dialogue: 0,0:06:12.02,0:06:15.06,Caption,,0,0,0,,УСТРОЙСТВА. УКРАИНА ПОЛУЧАЕТ ЗАЩИТУ. ЕВРОПА
Dialogue: 0,0:06:15.06,0:06:17.30,Caption,,0,0,0,,УСИЛИВАЕТСЯ. РОССИЯ УБЕЖДАЕТСЯ,
Dialogue: 0,0:06:17.46,0:06:20.74,Caption,,0,0,0,,ЧТО НАТО НЕ ГОТОВИТ ВОЙНУ ПРОТИВ НЕЁ. АЛЬЯНС,
Dialogue: 0,0:06:20.82,0:06:22.90,Caption,,0,0,0,,В СВОЮ ОЧЕРЕДЬ, ПОЛУЧАЕТ УВЕРЕННОСТЬ,
Dialogue: 0,0:06:23.06,0:06:25.94,Caption,,0,0,0,,ЧТО МОСКВА УВАЖАЕТ БЕЗОПАСНОСТЬ СОСЕДНИХ СТРАН.
Dialogue: 0,0:06:26.72,0:06:29.30,Caption,,0,0,0,,НА БУМАГЕ ВСЁ ВЫГЛЯДИТ ОПРЯТНО КОНСУЛЬТАЦИИ,
Dialogue: 0,0:06:29.38,0:06:33.46,Caption,,0,0,0,,ПРОЗРАЧНОСТЬ, ПРЕДОТВРАЩЕНИЕ СТОЛКНОВЕНИЙ И СНИЖЕНИЕ НАПРЯЖЕНИЯ.
Dialogue: 0,0:06:33.86,0:06:36.42,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ НАМЕРЕНЫ ОБСУЖДАТЬ ЭТУ МОДЕЛЬ С
Dialogue: 0,0:06:36.42,0:06:40.34,Caption,,0,0,0,,РОССИЕЙ, УКРАИНОЙ И ЕВРОПЕЙСКИМИ ГОСУДАРСТВАМИ В БЛИЖАЙШИЕ
Dialogue: 0,0:06:40.34,0:06:44.18,Caption,,0,0,0,,НЕДЕЛИ. БУМАГА ВООБЩЕ УДИВИТЕЛЬНО ДИСЦИПЛИНИРОВАННАЯ ВЕЩЬ.
Dialogue: 0,0:06:44.50,0:06:47.30,Caption,,0,0,0,,НА НЕЙ ДАЖЕ ВЗАИМОИСКЛЮЧАЮЩИЕ УСЛОВИЯ УМЕЮТ СИДЕТЬ
Dialogue: 0,0:06:47.30,0:06:52.02,Caption,,0,0,0,,РЯДОМ И НЕ СПОРИТЬ. ГЛАВНАЯ ПРОБЛЕМА НИКУДА НЕ ИСЧЕЗАЕТ. КИЕВ ХОЧЕТ
Dialogue: 0,0:06:52.02,0:06:55.22,Caption,,0,0,0,,ПРИСУТСТВИЯ ЗАПАДНЫХ ВОЙСК. МОСКВА ВЫСТУПАЕТ ПРОТИВ
Dialogue: 0,0:06:55.22,0:06:59.54,Caption,,0,0,0,,И ПРЕДУПРЕЖДАЕТ, ЧТО ИХ ВВОД СНОВА ЗАПУСТИТ КОНФЛИКТ. ВАШИНГТОН
Dialogue: 0,0:06:59.54,0:07:02.26,Caption,,0,0,0,,ПРЕДЛАГАЕТ ОБОЙТИСЬ БЕЗ ПОСТОЯННОГО РАЗМЕЩЕНИЯ,
Dialogue: 0,0:07:02.58,0:07:05.54,Caption,,0,0,0,,НО ПРИ НОВОМ НАСТУПЛЕНИИ СИЛЫ НАТО ДОЛЖНЫ ПОЯВИТЬСЯ
Dialogue: 0,0:07:05.62,0:07:10.50,Caption,,0,0,0,,НА УКРАИНЕ БЫСТРО. ЗНАЧИТ, СПОР О ПРИСУТСТВИИ ВОЙСК ПРОСТО ПЕРЕОФОРМИЛИ.
Dialogue: 0,0:07:11.14,0:07:15.30,Caption,,0,0,0,,РАНЬШЕ СТОРОНЫ ВЫЯСНЯЛИ, ПРИДУТ ЛИ ОНИ ВООБЩЕ. ТЕПЕРЬ ОБСУЖДАЕТСЯ,
Dialogue: 0,0:07:15.45,0:07:17.78,Caption,,0,0,0,,В КАКОЙ МОМЕНТ ОНИ ВОЙДУТ И УСПЕЮТ ЛИ
Dialogue: 0,0:07:17.86,0:07:19.94,Caption,,0,0,0,,СНЯТЬ ПАЛЬТО. ПОДПИШИТЕСЬ НА КАНАЛ,
Dialogue: 0,0:07:20.10,0:07:22.26,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ВМЕСТЕ РАЗБИРАТЬ ТАКИЕ ДЕТАЛИ.
Dialogue: 0,0:07:24.38,0:07:27.34,Caption,,0,0,0,,В БОЛЬШИХ СОГЛАШЕНИЯХ САМАЯ ДОРОГАЯ СТРОКА НЕРЕДКО
Dialogue: 0,0:07:27.34,0:07:30.14,Caption,,0,0,0,,СПРЯТАНА ТАМ, ГДЕ СОСТАВИТЕЛИ НАДЕЮТСЯ,
Dialogue: 0,0:07:30.22,0:07:33.18,Caption,,0,0,0,,ЧТО ДО НЕЁ НИКТО НЕ ДОЧИТАЕТ. РОССИЯ ЯКОБЫ
Dialogue: 0,0:07:33.18,0:07:35.82,Caption,,0,0,0,,ГОТОВА ПРИНЯТЬ ЗАЩИТУ УКРАИНЫ ПО ОБРАЗЦУ ПЯТОЙ
Dialogue: 0,0:07:35.82,0:07:39.18,Caption,,0,0,0,,СТАТЬИ И ОДНОВРЕМЕННО ОТВЕРГАЕТ КВАЗИЧЛЕНСТВО КИЕВА
Dialogue: 0,0:07:39.26,0:07:42.70,Caption,,0,0,0,,В НАТО. ЗАПАД ОБЕЩАЕТ УЧИТЫВАТЬ БЕЗОПАСНОСТЬ МОСКВЫ
Dialogue: 0,0:07:43.08,0:07:46.46,Caption,,0,0,0,,И ПАРАЛЛЕЛЬНО ГОТОВИТ БЫСТРЫЙ ВВОД СИЛ АЛЬЯНСА. ВСЕ
Dialogue: 0,0:07:46.46,0:07:50.62,Caption,,0,0,0,,ГОВОРЯТ О РАЗРЯДКЕ, ЗАРАНЕЕ ОСТАВЛЯЯ КНОПКУ ВОЗВРАТА САНКЦИЙ И ПРОЦЕДУРУ
Dialogue: 0,0:07:50.62,0:07:53.90,Caption,,0,0,0,,ВОЕННОГО ОТВЕТА. РАДИ ЧЕГО РОССИЯ ДОЛЖНА ПРИНЯТЬ
Dialogue: 0,0:07:53.90,0:07:58.22,Caption,,0,0,0,,ЭТОТ КОМПЛЕКТ? НА ЭТОМ ФОНЕ ИСТОРИЯ С ЯДЕРНОЙ ДЕКЛАРАЦИЕЙ РОССИИ,
Dialogue: 0,0:07:58.30,0:08:01.74,Caption,,0,0,0,,США И КИТАЯ ВЫГЛЯДИТ НЕ ПОСТОРОННИМ ЭПИЗОДОМ,
Dialogue: 0,0:08:02.04,0:08:05.26,Caption,,0,0,0,,А ПОЛЕЗНОЙ ПРОВЕРКОЙ ЦЕНЫ ЛЮБЫХ ОБЕЩАНИЙ. ВОПРОС НЕ
Dialogue: 0,0:08:05.34,0:08:07.82,Caption,,0,0,0,,В ТОРЖЕСТВЕННОСТИ ПОДПИСИ. ВОПРОС В ТОМ,
Dialogue: 0,0:08:07.91,0:08:11.82,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ, КОГДА КРАСИВЫЙ ДОКУМЕНТ СТАЛКИВАЕТСЯ С ИНТЕРЕСАМИ
Dialogue: 0,0:08:11.82,0:08:14.94,Caption,,0,0,0,,ГОСУДАРСТВА. ДЛЯ МНОГИХ РОССИЯН ЯДЕРНОЕ ОРУЖИЕ
Dialogue: 0,0:08:15.02,0:08:17.74,Caption,,0,0,0,,ОСТАЁТСЯ ПОСЛЕДНИМ СРЕДСТВОМ СДЕРЖИВАНИЯ. ПОЭТОМУ
Dialogue: 0,0:08:17.74,0:08:20.62,Caption,,0,0,0,,ВОЗНИКАЕТ ВПОЛНЕ ПРАКТИЧЕСКИЙ ВОПРОС. ЕСЛИ ТРИ
Dialogue: 0,0:08:20.62,0:08:23.58,Caption,,0,0,0,,ДЕРЖАВЫ ПОДПИСЫВАЮТ ДЕКЛАРАЦИЮ О СНИЖЕНИИ ЯДЕРНЫХ
Dialogue: 0,0:08:23.58,0:08:28.06,Caption,,0,0,0,,РИСКОВ, КАКИЕ РЕАЛЬНЫЕ ОГРАНИЧЕНИЯ ОНА СОЗДАЁТ И СВЯЗЫВАЕТ
Dialogue: 0,0:08:28.06,0:08:31.18,Caption,,0,0,0,,ЛИ, НАПРИМЕР, ВАШИНГТОНУ РУКИ В ОТНОШЕНИИ ИРАНА?
Dialogue: 0,0:08:31.47,0:08:34.06,Caption,,0,0,0,,ЭТО НАПРЯМУЮ ОТНОСИТСЯ К ГАРАНТИЯМ ДЛЯ УКРАИНЫ.
Dialogue: 0,0:08:34.54,0:08:37.58,Caption,,0,0,0,,МОЖНО ИСПИСАТЬ КОЛЛЕКТИВНОЙ ЗАЩИТОЙ ДЕСЯТЬ СТРАНИЦ,
Dialogue: 0,0:08:37.82,0:08:40.70,Caption,,0,0,0,,ПРИДУМАТЬ ВНУШИТЕЛЬНОЕ НАЗВАНИЕ И СОБРАТЬ ЛИДЕРОВ НА
Dialogue: 0,0:08:40.70,0:08:46.34,Caption,,0,0,0,,ЦЕРЕМОНИЮ. В МОМЕНТ КРИЗИСА РЕШАТЬ БУДЕТ НЕ ТОЛЩИНА ПАПКИ,
Dialogue: 0,0:08:46.50,0:08:49.86,Caption,,0,0,0,,А ВОЛЯ КОНКРЕТНЫХ ПРАВИТЕЛЬСТВ. БУМАГА НЕ ПОДНИМАЕТ
Dialogue: 0,0:08:49.86,0:08:52.82,Caption,,0,0,0,,САМОЛЁТЫ И НЕ ПРОВОДИТ РЕШЕНИЯ ЧЕРЕЗ ПАРЛАМЕНТ.
Dialogue: 0,0:08:52.97,0:08:56.10,Caption,,0,0,0,,ИСТОРИЯ УЖЕ ДАВАЛА ДОСТАТОЧНО ТАКИХ УРОКОВ. ЗДЕСЬ
Dialogue: 0,0:08:56.10,0:08:59.62,Caption,,0,0,0,,ВСПОМИНАЮТСЯ ОБЕЩАНИЯ, СОПРОВОЖДАВШИЕ РАСШИРЕНИЕ НАТО,
Dialogue: 0,0:08:59.89,0:09:02.50,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА БРИТАНИИ И ФРАНЦИИ ПЕРЕД ПОЛЬШЕЙ В
Dialogue: 0,0:09:02.50,0:09:04.26,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ТРИДЦАТЬ ДЕВЯТОМ ГОДУ,
Dialogue: 0,0:09:04.66,0:09:06.82,Caption,,0,0,0,,А ТАКЖЕ СОВРЕМЕННЫЕ СЛУЧАИ С РАКЕТАМИ И
Dialogue: 0,0:09:06.82,0:09:09.22,Caption,,0,0,0,,БЕСПИЛОТНИКАМИ НА ТЕРРИТОРИИ ПОЛЬШИ И РУМЫНИИ.
Dialogue: 0,0:09:09.58,0:09:14.10,Caption,,0,0,0,,ФОРМУЛА МОЖЕТ БЫТЬ СТРОГОЙ, НО ДЕЙСТВИЕ ГОСУДАРСТВА ИНОГДА ОКАЗЫВАЕТСЯ ГОРАЗДО
Dialogue: 0,0:09:14.18,0:09:17.62,Caption,,0,0,0,,МЯГЧЕ. ЕСТЬ И БОЛЕЕ СУРОВАЯ ОЦЕНКА. СОЕДИНЁННЫЕ
Dialogue: 0,0:09:17.62,0:09:20.10,Caption,,0,0,0,,ШТАТЫ СОБЛЮДАЮТ ОБЯЗАТЕЛЬСТВА ДО ТЕХ ПОР,
Dialogue: 0,0:09:20.34,0:09:23.54,Caption,,0,0,0,,ПОКА ЭТО ОТВЕЧАЕТ ИХ СОБСТВЕННОМУ ИНТЕРЕСУ. В ЭТОЙ
Dialogue: 0,0:09:23.54,0:09:26.82,Caption,,0,0,0,,СВЯЗИ ВСПОМИНАЮТ ИСТОРИЮ С МАДУРО И ДЕЙСТВИЯ ПРОТИВ
Dialogue: 0,0:09:26.90,0:09:29.46,Caption,,0,0,0,,РУКОВОДСТВА ИРАНА. ОДНОВРЕМЕННО УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:09:29.68,0:09:32.34,Caption,,0,0,0,,ЧТО КОНГРЕСС ОГРАНИЧИВАЕТ ПОЛНОМОЧИЯ ТРАМПА В
Dialogue: 0,0:09:32.34,0:09:35.30,Caption,,0,0,0,,ВОПРОСЕ ЯДЕРНОГО УДАРА ПО ИРАНУ. НА ТАКОМ ФОНЕ
Dialogue: 0,0:09:35.30,0:09:38.10,Caption,,0,0,0,,ОСОБЕННО ЗАНЯТНО СЛУШАТЬ РАССУЖДЕНИЯ О ЛИЧНОЙ
Dialogue: 0,0:09:38.10,0:09:40.74,Caption,,0,0,0,,БЕЗОПАСНОСТИ ГОСУДАРСТВЕННЫХ ЛИДЕРОВ КАК ОПОРЕ
Dialogue: 0,0:09:40.74,0:09:43.46,Caption,,0,0,0,,МЕЖДУНАРОДНОЙ СТАБИЛЬНОСТИ. ДЛЯ РОССИИ ЗДЕСЬ
Dialogue: 0,0:09:43.46,0:09:46.58,Caption,,0,0,0,,ВОЗНИКАЕТ ОТДЕЛЬНАЯ ЛОВУШКА. ЕСЛИ ПУТИН ОТНОСИТСЯ К
Dialogue: 0,0:09:46.58,0:09:48.42,Caption,,0,0,0,,СОБСТВЕННЫМ ПОДПИСЯМ СЕРЬЁЗНЕЕ,
Dialogue: 0,0:09:48.58,0:09:52.58,Caption,,0,0,0,,ЧЕМ АМЕРИКАНСКАЯ СТОРОНА, ОДНА И ТА ЖЕ СТРОКА ДОГОВОРА БУДЕТ ИМЕТЬ
Dialogue: 0,0:09:52.66,0:09:58.20,Caption,,0,0,0,,ДЛЯ УЧАСТНИКОВ РАЗНУЮ ЦЕНУ. ОДИН СЧИТАЕТ ЕЁ ОБЯЗАТЕЛЬСТВОМ,
Dialogue: 0,0:09:58.44,0:10:01.40,Caption,,0,0,0,,ДРУГОЙ ДЕРЖИТ РЯДОМ КАЛЬКУЛЯТОР ИНТЕРЕСОВ. ОТСЮДА
Dialogue: 0,0:10:01.40,0:10:04.28,Caption,,0,0,0,,ВОЗВРАЩАЕМСЯ К ЯДЕРНОЙ ПОСЛЕДОВАТЕЛЬНОСТИ. ПУТИН
Dialogue: 0,0:10:04.28,0:10:07.16,Caption,,0,0,0,,ГОВОРИЛ О КАЛИНИНГРАДЕ НА ВАЛДАЕ. ПОЗЖЕ РЯБКОВ
Dialogue: 0,0:10:07.16,0:10:09.24,Caption,,0,0,0,,УПОМЯНУЛ ВСЕ ДОКТРИНАЛЬНЫЕ СРЕДСТВА,
Dialogue: 0,0:10:09.48,0:10:12.44,Caption,,0,0,0,,НЕ ПРОИЗНЕСЯ СЛОВО ЯДЕРНЫЕ. ЗАТЕМ ПОЯВИЛАСЬ
Dialogue: 0,0:10:12.44,0:10:15.64,Caption,,0,0,0,,ДЕКЛАРАЦИЯ О СНИЖЕНИИ ЯДЕРНЫХ РИСКОВ. ПОСЛЕ НЕЁ
Dialogue: 0,0:10:15.64,0:10:20.68,Caption,,0,0,0,,ПРОИЗОШЛА АТАКА. СОВПАДЕНИЕ? САМО СОСЕДСТВО СОБЫТИЙ ЕЩЁ НЕ ДОКАЗЫВАЕТ ЕДИНОГО
Dialogue: 0,0:10:20.68,0:10:23.32,Caption,,0,0,0,,ЗАМЫСЛА. ОДНАКО ДЛЯ БУДУЩЕЙ СИСТЕМЫ ГАРАНТИЙ
Dialogue: 0,0:10:23.32,0:10:26.44,Caption,,0,0,0,,ОСТАЁТСЯ НЕУДОБНЫЙ ВОПРОС. ЕСЛИ КРУПНЕЙШИЕ ДЕРЖАВЫ
Dialogue: 0,0:10:26.52,0:10:29.32,Caption,,0,0,0,,НЕ МОГУТ ОДИНАКОВО ПОНЯТЬ ДАЖЕ ОГРАНИЧЕНИЯ В ЯДЕРНОЙ
Dialogue: 0,0:10:29.32,0:10:32.76,Caption,,0,0,0,,СФЕРЕ, ПОЧЕМУ ОБЯЗАТЕЛЬСТВА ПО УКРАИНЕ ДОЛЖНЫ СРАБОТАТЬ
Dialogue: 0,0:10:32.76,0:10:36.36,Caption,,0,0,0,,АВТОМАТИЧЕСКИ, СЛОВНО ДВЕРЬ В ГОСТИНИЦЕ ПО ЭЛЕКТРОННОЙ КАРТОЧКЕ?
Dialogue: 0,0:10:36.96,0:10:39.40,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ЗЕЛЕНСКОМУ НУЖНЫ ГАРАНТИИ НЕ НА
Dialogue: 0,0:10:39.40,0:10:43.72,Caption,,0,0,0,,ЧЕТЫРЕ ГОДА, А НА ДЕСЯТИЛЕТИЯ. ЕГО НЕ УСТРАИВАЕТ ЛИЧНОЕ ОБЕЩАНИЕ
Dialogue: 0,0:10:43.72,0:10:47.64,Caption,,0,0,0,,ТРАМПА, УДАЧНЫЙ СНИМОК ПОСЛЕ ВСТРЕЧИ ИЛИ ОЧЕРЕДНОЕ ЗАВЕРЕНИЕ
Dialogue: 0,0:10:47.72,0:10:50.12,Caption,,0,0,0,,В ПОДДЕРЖКЕ. КИЕВ ТРЕБУЕТ МЕХАНИЗМ,
Dialogue: 0,0:10:50.36,0:10:53.16,Caption,,0,0,0,,КОТОРЫЙ ПРОДОЛЖИТ РАБОТАТЬ ПОСЛЕ СМЕНЫ ХОЗЯИНА
Dialogue: 0,0:10:53.16,0:10:55.96,Caption,,0,0,0,,БЕЛОГО ДОМА. НО ЧЕМ НАДЁЖНЕЕ ЭТОТ МЕХАНИЗМ ДЛЯ
Dialogue: 0,0:10:55.96,0:10:59.56,Caption,,0,0,0,,УКРАИНЫ, ТЕМ ОСТРЕЕ ВОПРОС О ПЛАТЕ ДЛЯ РОССИИ. ЧТО
Dialogue: 0,0:10:59.56,0:11:01.96,Caption,,0,0,0,,МОСКВА ПОЛУЧАЕТ ЗА СОГЛАСИЕ НА СИСТЕМУ,
Dialogue: 0,0:11:02.12,0:11:05.48,Caption,,0,0,0,,СПОСОБНУЮ ПЕРЕЖИТЬ АМЕРИКАНСКИХ ПРЕЗИДЕНТОВ И БЫСТРО
Dialogue: 0,0:11:05.48,0:11:07.96,Caption,,0,0,0,,ПРИВЕСТИ СИЛЫ НАТО НА УКРАИНСКУЮ ТЕРРИТОРИЮ?
Dialogue: 0,0:11:10.24,0:11:12.64,Caption,,0,0,0,,ПО ПОРУЧЕНИЮ ТРАМПА КУШНЕР ЗАНИМАЕТСЯ ПРОЕКТОМ
Dialogue: 0,0:11:12.64,0:11:16.00,Caption,,0,0,0,,УСПЕШНОЙ И СИЛЬНОЙ УКРАИНЫ ПОСЛЕ КОНФЛИКТА. В РАБОТЕ
Dialogue: 0,0:11:16.00,0:11:18.48,Caption,,0,0,0,,УЧАСТВУЮТ ВСЕМИРНЫЙ БАНК, БЛЭКРОК,
Dialogue: 0,0:11:18.63,0:11:20.80,Caption,,0,0,0,,ЕВРОСОЮЗ И КОМАНДА ЗЕЛЕНСКОГО.
Dialogue: 0,0:11:21.36,0:11:23.28,Caption,,0,0,0,,КУШНЕР ГОВОРИТ О СЕРЬЁЗНОМ ПРОГРЕССЕ В
Dialogue: 0,0:11:23.28,0:11:25.52,Caption,,0,0,0,,СОТРУДНИЧЕСТВЕ С УКРАИНСКИМ ПРЕЗИДЕНТОМ И
Dialogue: 0,0:11:25.52,0:11:29.44,Caption,,0,0,0,,ПОДЧЁРКИВАЕТ, ЧТО КРУПНЫЕ ОБЯЗАТЕЛЬСТВА США ДОЛЖНЫ ПОЛУЧИТЬ
Dialogue: 0,0:11:29.47,0:11:32.88,Caption,,0,0,0,,ОДОБРЕНИЕ КОНГРЕССА. РОССИЯ, КАК УТВЕРЖДАЕТ КУШНЕР,
Dialogue: 0,0:11:33.12,0:11:35.92,Caption,,0,0,0,,СОГЛАСИЛАСЬ НА МНОГОСТОРОННИЙ ФОРМАТ С ЕВРОПЕЙЦАМИ.
Dialogue: 0,0:11:36.32,0:11:38.88,Caption,,0,0,0,,ИХ УЧАСТИЕ СЧИТАЮТ НЕОБХОДИМЫМ ДЛЯ ЗАВЕРШЕНИЯ
Dialogue: 0,0:11:38.88,0:11:43.44,Caption,,0,0,0,,КОНФЛИКТА. ТАКИМ ОБРАЗОМ, РЕЧЬ ИДЁТ УЖЕ НЕ ОБ ОДНОМ СОГЛАШЕНИИ. СОБИРАЮТ
Dialogue: 0,0:11:43.44,0:11:46.80,Caption,,0,0,0,,ЦЕЛУЮ ПОСЛЕВОЕННУЮ АРХИТЕКТУРУ. КИЕВУ ПРЕДНАЗНАЧЕНЫ
Dialogue: 0,0:11:46.80,0:11:50.16,Caption,,0,0,0,,ГАРАНТИИ. ЕВРОПА ПОЛУЧАЕТ МЕСТО СРЕДИ УЧАСТНИКОВ.
Dialogue: 0,0:11:50.32,0:11:52.72,Caption,,0,0,0,,МОСКВЕ ОБЕЩАЮТ ЭКОНОМИЧЕСКИЕ ПОСЛАБЛЕНИЯ.
Dialogue: 0,0:11:52.96,0:11:55.44,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ СТРУКТУРЫ ГОТОВЯТ ВОССТАНОВЛЕНИЕ.
Dialogue: 0,0:11:55.65,0:11:58.24,Caption,,0,0,0,,АМЕРИКАНСКИЕ ОБЯЗАТЕЛЬСТВА ПРОВОДЯТ ЧЕРЕЗ КОНГРЕСС,
Dialogue: 0,0:11:58.40,0:12:00.56,Caption,,0,0,0,,ЧТОБЫ ОНИ НЕ ИСЧЕЗЛИ ВМЕСТЕ С ОЧЕРЕДНОЙ
Dialogue: 0,0:12:00.56,0:12:02.48,Caption,,0,0,0,,АДМИНИСТРАЦИЕЙ. ТЕПЕРЬ ПОНЯТНО,
Dialogue: 0,0:12:02.65,0:12:05.44,Caption,,0,0,0,,ПОЧЕМУ ПЕРЕГОВОРЫ БУКСУЮТ. НУЖНО ОДНОВРЕМЕННО
Dialogue: 0,0:12:05.44,0:12:07.76,Caption,,0,0,0,,ДОГОВОРИТЬСЯ О ТЕРРИТОРИИ, НАТО,
Dialogue: 0,0:12:07.88,0:12:10.00,Caption,,0,0,0,,ИНОСТРАННЫХ ВОЙСКАХ, САНКЦИЯХ,
Dialogue: 0,0:12:10.24,0:12:13.28,Caption,,0,0,0,,РАЗМЕРЕ УКРАИНСКОЙ АРМИИ, БЕЗОПАСНОСТИ ЕВРОПЫ,
Dialogue: 0,0:12:13.52,0:12:16.40,Caption,,0,0,0,,АМЕРИКАНСКИХ ГАРАНТИЯХ И КОЛОССАЛЬНЫХ РАСХОДАХ НА
Dialogue: 0,0:12:16.40,0:12:19.12,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ. ЭТО НЕ ОДНА ГОЛОВОЛОМКА. ЭТО
Dialogue: 0,0:12:19.20,0:12:23.04,Caption,,0,0,0,,КОРОБКА, КУДА СВАЛИЛИ ДЕТАЛИ ОТ ВОСЬМИ РАЗНЫХ НАБОРОВ И
Dialogue: 0,0:12:23.04,0:12:30.43,Caption,,0,0,0,,ТРЕБУЮТ СОБРАТЬ ОДИН ЗАМОК. УКРАИНА ХОЧЕТ ЗАЩИТУ НА ДЕСЯТИЛЕТИЯ. НАТО СОХРАНЯЕТ
Dialogue: 0,0:12:30.43,0:12:33.63,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ВОЕННОГО ВКЛЮЧЕНИЯ. ЕВРОПА УЧАСТВУЕТ В
Dialogue: 0,0:12:33.63,0:12:37.07,Caption,,0,0,0,,СОЗДАНИИ НОВОЙ СИСТЕМЫ. БЛЭКРОК И ВСЕМИРНЫЙ БАНК УЖЕ
Dialogue: 0,0:12:37.07,0:12:39.87,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ В МОДЕЛИ ВОССТАНОВЛЕНИЯ. ВАШИНГТОН
Dialogue: 0,0:12:39.87,0:12:42.51,Caption,,0,0,0,,КОНТРОЛИРУЕТ САНКЦИОННЫЙ РЫЧАГ И ЧАСТЬ БУДУЩИХ
Dialogue: 0,0:12:42.51,0:12:44.91,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ. СО СТОРОНЫ РОССИИ В ПУБЛИЧНОМ
Dialogue: 0,0:12:44.91,0:12:48.19,Caption,,0,0,0,,ПРОСТРАНСТВЕ ВИДНЫ ПРЕИМУЩЕСТВЕННО ОБЕЩАНИЯ ОСЛАБИТЬ
Dialogue: 0,0:12:48.19,0:12:50.43,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ОГРАНИЧЕНИЯ И ЗАВЕРЕНИЯ,
Dialogue: 0,0:12:50.61,0:12:53.15,Caption,,0,0,0,,ЧТО ЕЁ ТРЕВОГИ ТОЖЕ КОГДА НИБУДЬ ВЫСЛУШАЮТ.
Dialogue: 0,0:12:53.58,0:12:57.07,Caption,,0,0,0,,ВОЗМОЖНО, МОСКВЕ ПРЕДЛАГАЮТ СЕРЬЁЗНУЮ ВСТРЕЧНУЮ ВЫГОДУ,
Dialogue: 0,0:12:57.15,0:13:00.03,Caption,,0,0,0,,КОТОРУЮ ПОКА НЕ РАСКРЫЛИ. НО ЕСЛИ ТАКОГО ПУНКТА
Dialogue: 0,0:13:00.11,0:13:04.03,Caption,,0,0,0,,НЕТ, ОПРЕДЕЛЕНИЕ КАПИТУЛЯЦИОННЫЙ НИКУДА НЕ ИСЧЕЗАЕТ. ОНО
Dialogue: 0,0:13:04.03,0:13:06.03,Caption,,0,0,0,,СТАНОВИТСЯ НЕ ЭМОЦИОНАЛЬНОЙ ОЦЕНКОЙ,
Dialogue: 0,0:13:06.27,0:13:09.71,Caption,,0,0,0,,А КРАТКИМ ОПИСАНИЕМ БАЛАНСА УСЛОВИЙ. ТРАМП УВЕРЯЕТ,
Dialogue: 0,0:13:09.79,0:13:12.11,Caption,,0,0,0,,ЧТО ПУТИН ХОЧЕТ ЗАВЕРШИТЬ КОНФЛИКТ ЗА СТОЛОМ
Dialogue: 0,0:13:12.11,0:13:14.83,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ДОПУСТИМ. ОДНАКО ГОТОВНОСТЬ
Dialogue: 0,0:13:14.83,0:13:17.63,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ НЕ РАВНА ГОТОВНОСТИ ПОДПИСЫВАТЬ ЛЮБОЙ
Dialogue: 0,0:13:17.63,0:13:20.51,Caption,,0,0,0,,ПРИНЕСЁННЫЙ ТЕКСТ. ЧЕЛОВЕК МОЖЕТ ХОТЕТЬ ЗАКОНЧИТЬ
Dialogue: 0,0:13:20.51,0:13:23.31,Caption,,0,0,0,,СПОР И ПРИ ЭТОМ НЕ СОГЛАШАТЬСЯ ОТДАТЬ КВАРТИРУ,
Dialogue: 0,0:13:23.47,0:13:26.43,Caption,,0,0,0,,МАШИНУ И ЕЩЁ ДОПЛАТИТЬ ЗА РУЧКУ. ПОЭТОМУ СЛОВА
Dialogue: 0,0:13:26.43,0:13:28.99,Caption,,0,0,0,,БУДАНОВА О ЧУДЕ ДО КОНЦА ГОДА ЗВУЧАТ ВПОЛНЕ
Dialogue: 0,0:13:29.07,0:13:32.43,Caption,,0,0,0,,РАЦИОНАЛЬНО. ДЛЯ РЕЗУЛЬТАТА НЕДОСТАТОЧНО СОГЛАСОВАТЬ
Dialogue: 0,0:13:32.43,0:13:35.71,Caption,,0,0,0,,ОДНУ ЭФФЕКТНУЮ ФРАЗУ. НУЖНО СОЕДИНИТЬ ПОЛОЖЕНИЯ,
Dialogue: 0,0:13:35.92,0:13:38.59,Caption,,0,0,0,,КОТОРЫЕ ПОКА ТЯНУТ СОГЛАШЕНИЕ В ПРОТИВОПОЛОЖНЫЕ
Dialogue: 0,0:13:38.67,0:13:43.81,Caption,,0,0,0,,СТОРОНЫ. ВСЁ ЭТО НАЗЫВАЮТ БУДУЩЕЙ СИСТЕМОЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:13:43.81,0:13:46.61,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТОЛЬКО БЕЗОПАСНОСТЬ НАЧИНАЕТСЯ НЕ С
Dialogue: 0,0:13:46.61,0:13:49.81,Caption,,0,0,0,,НАЗВАНИЯ И НЕ С ОБЩЕГО СНИМКА. КАЖДАЯ СТОРОНА
Dialogue: 0,0:13:49.81,0:13:53.97,Caption,,0,0,0,,ДОЛЖНА УВИДЕТЬ, ПОЧЕМУ ПОСЛЕ ПОДПИСАНИЯ ЕЁ ПОЛОЖЕНИЕ УЛУЧШИЛОСЬ.
Dialogue: 0,0:13:54.51,0:13:57.49,Caption,,0,0,0,,ОТВЕТ УКРАИНЫ ПОНЯТЕН. ОНА ПОЛУЧАЕТ ДОЛГОСРОЧНУЮ
Dialogue: 0,0:13:57.49,0:14:01.41,Caption,,0,0,0,,ЗАЩИТУ, ПОДДЕРЖКУ СОЮЗНИКОВ И ВОЗМОЖНОСТЬ НЕ СОДЕРЖАТЬ
Dialogue: 0,0:14:01.41,0:14:04.21,Caption,,0,0,0,,МИЛЛИОННУЮ АРМИЮ ИСКЛЮЧИТЕЛЬНО ЗА СОБСТВЕННЫЙ СЧЁТ.
Dialogue: 0,0:14:04.45,0:14:07.09,Caption,,0,0,0,,ЕВРОПА ПОЛУЧАЕТ ИНСТРУМЕНТ СДЕРЖИВАНИЯ НОВОГО
Dialogue: 0,0:14:07.09,0:14:09.49,Caption,,0,0,0,,КОНФЛИКТА И ПРАВО УЧАСТВОВАТЬ В УСТРОЙСТВЕ
Dialogue: 0,0:14:09.49,0:14:12.37,Caption,,0,0,0,,ПОСЛЕВОЕННОГО ПОРЯДКА. ВЫГОДА СОЕДИНЁННЫХ ШТАТОВ
Dialogue: 0,0:14:12.37,0:14:15.89,Caption,,0,0,0,,ТОЖЕ РАЗЛИЧИМА БЕЗ ЛУПЫ. ВАШИНГТОН СОХРАНЯЕТ ВЛИЯНИЕ
Dialogue: 0,0:14:15.89,0:14:18.77,Caption,,0,0,0,,НА ГАРАНТИИ, САНКЦИИ И ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:14:19.01,0:14:21.81,Caption,,0,0,0,,ПОДКЛЮЧАЕТ АМЕРИКАНСКИЙ КАПИТАЛ И ЗАКРЕПЛЯЕТ
Dialogue: 0,0:14:21.81,0:14:24.93,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ЧЕРЕЗ КОНГРЕСС. ЧТО ОСТАЁТСЯ РОССИИ?
Dialogue: 0,0:14:25.24,0:14:27.89,Caption,,0,0,0,,ЕСЛИ МОСКВЕ ПРЕДЛАГАЮТ НЕМНОГО ОСЛАБИТЬ САНКЦИИ В
Dialogue: 0,0:14:27.89,0:14:32.29,Caption,,0,0,0,,ОБМЕН НА ОТВОД ВОЙСК, ГАРАНТИИ УКРАИНЕ ПО ОБРАЗЦУ НАТО И ПРАВО АЛЬЯНСА
Dialogue: 0,0:14:32.29,0:14:34.13,Caption,,0,0,0,,БЫСТРО ВОЙТИ ПРИ НОВОМ КОНФЛИКТЕ,
Dialogue: 0,0:14:34.43,0:14:36.85,Caption,,0,0,0,,МЕНЯТЬ НАЗВАНИЕ СТАРОЙ ПАПКИ ДЕЙСТВИТЕЛЬНО НЕ
Dialogue: 0,0:14:36.85,0:14:39.41,Caption,,0,0,0,,ТРЕБОВАЛОСЬ. СОДЕРЖИМОЕ ОСТАЛОСЬ ПРЕЖНИМ,
Dialogue: 0,0:14:39.57,0:14:42.45,Caption,,0,0,0,,ТОЛЬКО ЦЕННИК СТАЛ ВЫШЕ. ТОГДА СПОР ИДЁТ УЖЕ
Dialogue: 0,0:14:42.53,0:14:45.01,Caption,,0,0,0,,НЕ О КАЧЕСТВЕ МИРА. ОН СВОДИТСЯ К ОДНОМУ
Dialogue: 0,0:14:45.01,0:14:47.89,Caption,,0,0,0,,ВОПРОСУ. РОССИЯ МНОГО ЛЕТ НАЗЫВАЛА УСЛОВИЯ,
Dialogue: 0,0:14:48.13,0:14:51.17,Caption,,0,0,0,,КОТОРЫЕ СЧИТАЕТ НЕДОПУСТИМЫМИ. ТЕПЕРЬ ПОЧТИ ТЕ ЖЕ
Dialogue: 0,0:14:51.25,0:14:53.81,Caption,,0,0,0,,УСЛОВИЯ ВОЗВРАЩАЮТ КАК ОСНОВУ УРЕГУЛИРОВАНИЯ.
Dialogue: 0,0:14:56.09,0:15:00.73,Caption,,0,0,0,,ЧТО ПРОИЗОШЛО ТАКОГО, ПОСЛЕ ЧЕГО МОСКВА ДОЛЖНА ПРИЗНАТЬ ПРИЕМЛЕМЫМ ТО,
Dialogue: 0,0:15:00.98,0:15:03.77,Caption,,0,0,0,,РАДИ НЕДОПУЩЕНИЯ ЧЕГО ОНА ВСТУПИЛА В КОНФЛИКТ?
Dialogue: 0,0:15:04.41,0:15:09.21,Caption,,0,0,0,,КОГДА ПОЯВИТСЯ ВНЯТНЫЙ ОТВЕТ, МОЖНО БУДЕТ ГОВОРИТЬ О НАСТОЯЩЕЙ СДЕЛКЕ. ПОКА ЖЕ
Dialogue: 0,0:15:09.21,0:15:11.37,Caption,,0,0,0,,РОССИЙСКИЙ ОТКАЗ ЛЕЖИТ ПОСРЕДИ СТОЛА,
Dialogue: 0,0:15:11.61,0:15:14.49,Caption,,0,0,0,,А ОСТАЛЬНЫЕ УЧАСТНИКИ СТАРАТЕЛЬНО РАСКЛАДЫВАЮТ
Dialogue: 0,0:15:14.57,0:15:17.13,Caption,,0,0,0,,ПОВЕРХ НЕГО БУМАГИ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:15:17.44,0:15:20.49,Caption,,0,0,0,,КАКУЮ РЕАЛЬНУЮ ВСТРЕЧНУЮ ВЫГОДУ МОГЛА БЫ ПОЛУЧИТЬ
Dialogue: 0,0:15:20.49,0:15:23.77,Caption,,0,0,0,,МОСКВА, ПОТОМУ ЧТО В ОПУБЛИКОВАННОЙ ВЕРСИИ ИСКАТЬ ЕЁ
Dialogue: 0,0:15:23.77,0:15:25.93,Caption,,0,0,0,,ПРИХОДИТСЯ ДОЛЬШЕ, ЧЕМ САМ МИР.
