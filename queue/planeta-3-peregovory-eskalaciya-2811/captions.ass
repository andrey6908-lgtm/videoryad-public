Dialogue: 0,0:00:00.12,0:00:01.64,Caption,,0,0,0,,У БЕРЛИНА ПОЯВИЛСЯ РЕДКИЙ ШАНС
Dialogue: 0,0:00:01.64,0:00:03.48,Caption,,0,0,0,,ДОБРАТЬСЯ ДО МОСКВЫ ПО РАСПИСАНИЮ,
Dialogue: 0,0:00:03.63,0:00:06.04,Caption,,0,0,0,,С БИЛЕТОМ И ОФИЦИАЛЬНЫМ ПРИГЛАШЕНИЕМ.
Dialogue: 0,0:00:06.04,0:00:07.96,Caption,,0,0,0,,БОРИС ПИСТОРИУС СОВЕТУЕТ ЕВРОПЕЙЦАМ ИМ
Dialogue: 0,0:00:07.96,0:00:11.29,Caption,,0,0,0,,ВОСПОЛЬЗОВАТЬСЯ. КОГДА ГЕРМАНИЯ ВЫБИРАЛА ДРУГОЙ ПОРЯДОК
Dialogue: 0,0:00:11.29,0:00:13.24,Caption,,0,0,0,,ПОЕЗДКИ, ДОРОГА ЗАКАНЧИВАЛАСЬ ТЕМ,
Dialogue: 0,0:00:13.40,0:00:15.25,Caption,,0,0,0,,ЧТО РУССКИЕ ОКАЗЫВАЛИСЬ В БЕРЛИНЕ.
Dialogue: 0,0:00:15.25,0:00:18.36,Caption,,0,0,0,,ТЕПЕРЬ ВСЁ КУЛЬТУРНО, НО ЕВРОПА МНЁТСЯ У ДВЕРИ,
Dialogue: 0,0:00:18.52,0:00:20.52,Caption,,0,0,0,,БУДТО ЕЁ ПОЗВАЛИ НЕ НА ПЕРЕГОВОРЫ,
Dialogue: 0,0:00:20.75,0:00:22.55,Caption,,0,0,0,,А ПОМОГАТЬ С ПЕРЕЕЗДОМ. МИНИСТР
Dialogue: 0,0:00:22.55,0:00:25.60,Caption,,0,0,0,,ОБОРОНЫ ГЕРМАНИИ ФОРМУЛИРУЕТ ПОЗИЦИЮ ПРЯМО. РОССИЯ
Dialogue: 0,0:00:25.60,0:00:30.08,Caption,,0,0,0,,ЗОВЁТ ЕВРОПЕЙЦЕВ К РАЗГОВОРУ, ПОЭТОМУ НАДО ЕХАТЬ. ОТКАЗ ПИСТОРИУС
Dialogue: 0,0:00:30.08,0:00:32.76,Caption,,0,0,0,,СЧИТАЕТ КРАЙНЕ НЕУДАЧНЫМ СИГНАЛОМ ОТ ЛЮДЕЙ,
Dialogue: 0,0:00:33.00,0:00:35.10,Caption,,0,0,0,,КОТОРЫЕ ТРЕБУЮТ УЧИТЫВАТЬ ИНТЕРЕСЫ
Dialogue: 0,0:00:35.10,0:00:38.36,Caption,,0,0,0,,ЕВРОПЫ. ЛОГИКА ПРОСТА. ХОТИТЕ ВЛИЯТЬ НА РЕШЕНИЕ,
Dialogue: 0,0:00:38.52,0:00:42.67,Caption,,0,0,0,,САДИТЕСЬ НАПРОТИВ ТЕХ, КТО ЕГО ОБСУЖДАЕТ. ОДНАКО ЕВРОКОМИССИЯ
Dialogue: 0,0:00:42.67,0:00:45.21,Caption,,0,0,0,,РЕШИЛА, ЧТО ПРЯМЫЕ КОНСУЛЬТАЦИИ ЕЙ НЕ
Dialogue: 0,0:00:45.21,0:00:47.55,Caption,,0,0,0,,ПОДХОДЯТ. РАЗГОВАРИВАТЬ МОЖНО ТОЛЬКО В
Dialogue: 0,0:00:47.55,0:00:50.76,Caption,,0,0,0,,МНОГОСТОРОННЕМ ФОРМАТЕ. ПОЛУЧАЕТСЯ ЗАНЯТНЫЙ ТУРИЗМ.
Dialogue: 0,0:00:51.32,0:00:53.08,Caption,,0,0,0,,В МОСКВЕ ПРИСУТСТВОВАТЬ ЖЕЛАТЕЛЬНО,
Dialogue: 0,0:00:53.30,0:00:55.64,Caption,,0,0,0,,НО ВСТРЕЧАТЬСЯ С МОСКВОЙ НЕЖЕЛАТЕЛЬНО.
Dialogue: 0,0:00:55.64,0:00:57.72,Caption,,0,0,0,,СВОИ ИНТЕРЕСЫ ЗАЩИЩАТЬ НЕОБХОДИМО,
Dialogue: 0,0:00:57.96,0:01:00.02,Caption,,0,0,0,,НО ПРОИЗНОСИТЬ ИХ ЗА ОДНИМ СТОЛОМ
Dialogue: 0,0:01:00.02,0:01:02.79,Caption,,0,0,0,,НЕЛОВКО. ЕСЛИ ВАМ ИНТЕРЕСНЕЕ ПОСТУПКИ
Dialogue: 0,0:01:02.79,0:01:05.48,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ, ЧЕМ ТОРЖЕСТВЕННОЕ ШЕВЕЛЕНИЕ ГУБ,
Dialogue: 0,0:01:05.78,0:01:08.05,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ДАЛЬШЕ РАЗНИЦА
Dialogue: 0,0:01:08.05,0:01:11.24,Caption,,0,0,0,,МЕЖДУ ОБЕЩАНИЕМ И ДЕЙСТВИЕМ СТАНЕТ ОСОБЕННО НАГЛЯДНОЙ.
Dialogue: 0,0:01:13.52,0:01:15.61,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ПРЕДЛОЖИЛИ УКРАИНЕ
Dialogue: 0,0:01:15.61,0:01:18.62,Caption,,0,0,0,,ГАРАНТИИ ПО ОБРАЗЦУ ПЯТОЙ СТАТЬИ НАТО. ЗВУЧИТ
Dialogue: 0,0:01:18.62,0:01:21.81,Caption,,0,0,0,,СОЛИДНО. ЧЛЕНСТВО БЕЗ ЧЛЕНСТВА И ПОЧТИ НАСТОЯЩИЕ
Dialogue: 0,0:01:21.81,0:01:25.37,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА, ТОЛЬКО ВХОДНОГО БИЛЕТА В АЛЬЯНС НЕТ.
Dialogue: 0,0:01:25.37,0:01:28.03,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ПАРТНЁРЫ НА ЭТОЙ ФОРМУЛЕ ЗАМЕТНО
Dialogue: 0,0:01:28.03,0:01:31.20,Caption,,0,0,0,,ПРИТОРМОЗИЛИ. ОДИН ДИПЛОМАТ ИЗ СТРАНЫ НАТО ИЗЛОЖИЛ СУТЬ
Dialogue: 0,0:01:31.20,0:01:34.16,Caption,,0,0,0,,ЖЁСТКО. ГОСУДАРСТВО ЛИБО СОСТОИТ В АЛЬЯНСЕ,
Dialogue: 0,0:01:34.31,0:01:36.64,Caption,,0,0,0,,ЛИБО НЕТ. ПРОМЕЖУТОЧНОГО КРЕСЛА НЕ
Dialogue: 0,0:01:36.64,0:01:39.96,Caption,,0,0,0,,ПРЕДУСМОТРЕНО. НЕСКОЛЬКО ЛЕТ ВОКРУГ УКРАИНЫ СОБИРАЛИ
Dialogue: 0,0:01:39.96,0:01:43.43,Caption,,0,0,0,,СХЕМЫ БЕЗОПАСНОСТИ, ПРИДУМЫВАЛИ НАЗВАНИЯ И МЕХАНИЗМЫ.
Dialogue: 0,0:01:43.43,0:01:46.08,Caption,,0,0,0,,КОГДА ВАШИНГТОН ПРЕДЛОЖИЛ ПЕРЕЙТИ ОТ УПАКОВКИ К
Dialogue: 0,0:01:46.08,0:01:49.33,Caption,,0,0,0,,СОДЕРЖИМОМУ, ПРОСТРАНСТВО МЕЖДУ ПЯТОЙ СТАТЬЁЙ И ЕЁ
Dialogue: 0,0:01:49.33,0:01:52.33,Caption,,0,0,0,,ОТСУТСТВИЕМ ОКАЗАЛОСЬ ШИРИНОЙ С ДВЕРНУЮ ЩЕЛЬ. А
Dialogue: 0,0:01:52.33,0:01:55.58,Caption,,0,0,0,,ПРОТИСНУТЬСЯ ТУДА ПЫТАЮТСЯ ВСЕ. ПРЕЗИДЕНТ РУМЫНИИ
Dialogue: 0,0:01:55.58,0:01:58.76,Caption,,0,0,0,,НИКУШОР ДАН ДОБАВИЛ ДЕТАЛЬ. ЕСЛИ СИЛЫ НАТО НАЧНУТ
Dialogue: 0,0:01:58.76,0:02:02.88,Caption,,0,0,0,,СБИВАТЬ ЦЕЛИ НАД УКРАИНОЙ, ЭТО БУДЕТ ОЗНАЧАТЬ СОВМЕСТНОЕ УЧАСТИЕ
Dialogue: 0,0:02:02.88,0:02:05.65,Caption,,0,0,0,,В БОЕВЫХ ДЕЙСТВИЯХ. ПОКА ОБЯЗАТЕЛЬСТВА ЖИВУТ В
Dialogue: 0,0:02:05.65,0:02:08.74,Caption,,0,0,0,,ЗАЯВЛЕНИЯХ, ИМ МОЖНО ПРИДАВАТЬ ЛЮБУЮ ФОРМУ. НО
Dialogue: 0,0:02:08.74,0:02:12.37,Caption,,0,0,0,,СТОИТ ЗАПУСТИТЬ ПЕРЕХВАТЧИК, НАПРАВИТЬ ВОЕННОСЛУЖАЩИХ ИЛИ ПРИНЯТЬ
Dialogue: 0,0:02:12.37,0:02:16.50,Caption,,0,0,0,,ОТВЕТСТВЕННОСТЬ ЗА УДАР, И ПОЯВЛЯЕТСЯ ЦЕНА ОБЕЩАНИЙ. ОСТАВИТЬ
Dialogue: 0,0:02:16.50,0:02:19.44,Caption,,0,0,0,,КОРЗИНУ И СКАЗАТЬ, ЧТО ВЫ ПРОСТО ПОСМОТРЕТЬ ЗАШЛИ,
Dialogue: 0,0:02:19.58,0:02:23.28,Caption,,0,0,0,,УЖЕ НЕЛЬЗЯ. ПОЭТОМУ ГАРАНТИИ, ПОХОЖИЕ НА ПЯТУЮ СТАТЬЮ,
Dialogue: 0,0:02:23.44,0:02:25.86,Caption,,0,0,0,,СТОИТ ОЦЕНИВАТЬ НЕ ПО ТОЛЩИНЕ ПАПКИ.
Dialogue: 0,0:02:25.86,0:02:31.56,Caption,,0,0,0,,ЗНАЧЕНИЕ ИМЕЕТ ОДИН ВОПРОС. ЧТО СОЮЗНИКИ СДЕЛАЮТ,
Dialogue: 0,0:02:31.71,0:02:33.24,Caption,,0,0,0,,КОГДА ПРИДЁТСЯ РИСКОВАТЬ САМИМ?
Dialogue: 0,0:02:33.94,0:02:36.52,Caption,,0,0,0,,ИЗ РАССКАЗА ДЖАРЕДА КУШНЕРА И СЛЕДУЮЩИХ ИЗ НЕГО
Dialogue: 0,0:02:36.52,0:02:39.83,Caption,,0,0,0,,ВЫВОДОВ ВИДНО, ЧТО АМЕРИКАНСКАЯ СТОРОНА ЭТУ ЛОВУШКУ
Dialogue: 0,0:02:39.83,0:02:42.31,Caption,,0,0,0,,ПОНИМАЕТ. ВЛАДИМИР ПУТИН ГОТОВ ДОПУСТИТЬ
Dialogue: 0,0:02:42.31,0:02:45.85,Caption,,0,0,0,,ОГРАНИЧЕННЫЕ УСТУПКИ РАДИ СДЕЛКИ. ВЛАДИМИР ЗЕЛЕНСКИЙ ПРИ
Dialogue: 0,0:02:45.85,0:02:49.18,Caption,,0,0,0,,ПРИБЛИЖЕНИИ К РЕШАЮЩЕМУ МОМЕНТУ УХОДИТ В СТОРОНУ.
Dialogue: 0,0:02:49.18,0:02:52.00,Caption,,0,0,0,,ЕГО ЛИЧНЫЕ ПРИЧИНЫ В ВАШИНГТОНЕ ЕДВА ЛИ ОСТАЮТСЯ
Dialogue: 0,0:02:52.00,0:02:54.91,Caption,,0,0,0,,ЗАГАДКОЙ. ЗЕЛЕНСКИЙ ЗДЕСЬ ПОХОЖ НА КАНАТОХОДЦА
Dialogue: 0,0:02:54.91,0:02:57.80,Caption,,0,0,0,,КАЖДЫЙ НОВЫЙ ШАГ УДЕРЖИВАЕТ ВНИМАНИЕ ПУБЛИКИ И
Dialogue: 0,0:02:57.80,0:03:00.68,Caption,,0,0,0,,ОТКЛАДЫВАЕТ ВОПРОСЫ О КОНЕЧНОЙ ТОЧКЕ МАРШРУТА.
Dialogue: 0,0:03:00.68,0:03:02.92,Caption,,0,0,0,,СТОИТ ЗАМЕРЕТЬ, И ЗРИТЕЛИ СПРОСЯТ,
Dialogue: 0,0:03:03.13,0:03:05.65,Caption,,0,0,0,,КУДА ВЕДЁТ КАНАТ И КТО ЕГО НАТЯНУЛ.
Dialogue: 0,0:03:05.65,0:03:08.73,Caption,,0,0,0,,СОГЛАШЕНИЕ, КОТОРОЕ НЕЛЬЗЯ ОБЪЯВИТЬ БЕЗОГОВОРОЧНОЙ
Dialogue: 0,0:03:08.73,0:03:11.13,Caption,,0,0,0,,ПОБЕДОЙ, УДАРИТ НЕ ТОЛЬКО ПО УКРАИНСКОЙ
Dialogue: 0,0:03:11.13,0:03:13.88,Caption,,0,0,0,,ПОЗИЦИИ. ОНО РАЗРУШИТ ЛИЧНУЮ ЛЕГЕНДУ ЗЕЛЕНСКОГО,
Dialogue: 0,0:03:14.12,0:03:16.54,Caption,,0,0,0,,ОБЕЩАВШЕГО ПОБЕДНЫЙ ИСХОД И ПЯТЬ ЛЕТ
Dialogue: 0,0:03:16.54,0:03:19.78,Caption,,0,0,0,,СВЯЗЫВАВШЕГО С НИМ СУДЬБУ СВОЕГО ПРАВЛЕНИЯ. УКРАИНА
Dialogue: 0,0:03:19.78,0:03:22.84,Caption,,0,0,0,,РАСПЛАЧИВАЕТСЯ ЛЮДЬМИ, РАЗРУШЕННЫМИ ГОРОДАМИ,
Dialogue: 0,0:03:23.00,0:03:26.93,Caption,,0,0,0,,ЭНЕРГЕТИКОЙ, ПРОИЗВОДСТВОМ И ГОДАМИ ВОССТАНОВЛЕНИЯ.
Dialogue: 0,0:03:26.93,0:03:29.36,Caption,,0,0,0,,ДЛЯ ЗЕЛЕНСКОГО ПРЕКРАЩЕНИЕ ВОЙНЫ ТОЖЕ
Dialogue: 0,0:03:29.36,0:03:32.49,Caption,,0,0,0,,ИМЕЕТ ЦЕНУ. ОНА ИЗМЕРЯЕТСЯ ЕГО ВЛАСТЬЮ И ОСТАТКАМИ
Dialogue: 0,0:03:32.49,0:03:36.03,Caption,,0,0,0,,СОЗДАННОГО ВОКРУГ НЕГО ОБРАЗА. ПОЭТОМУ МЯГКОЕ ДАВЛЕНИЕ
Dialogue: 0,0:03:36.03,0:03:39.56,Caption,,0,0,0,,ДЕЙСТВУЕТ КАК БУДИЛЬНИК, КОТОРЫЙ МОЖНО ПЕРЕСТАВИТЬ НА ДЕСЯТЬ
Dialogue: 0,0:03:39.56,0:03:43.31,Caption,,0,0,0,,МИНУТ. РАЗДРАЖАЕТ, НО ВСТАВАТЬ НЕОБЯЗАТЕЛЬНО. МОСКВА
Dialogue: 0,0:03:43.31,0:03:45.24,Caption,,0,0,0,,СОХРАНЯЕТ ОГРАНИЧЕННОЕ ДАВЛЕНИЕ.
Dialogue: 0,0:03:47.52,0:03:49.93,Caption,,0,0,0,,ВАШИНГТОН ПОСТУПАЕТ ТАК ЖЕ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:03:49.93,0:03:53.03,Caption,,0,0,0,,МАНЕВРИРУЕТ, СПОРИТ ОБ УСЛОВИЯХ И ОТОДВИГАЕТ
Dialogue: 0,0:03:53.03,0:03:55.92,Caption,,0,0,0,,РАЗВЯЗКУ. ПОТОМ СТОРОНЫ СНОВА ПОДХОДЯТ К ШАГУ,
Dialogue: 0,0:03:56.08,0:03:58.28,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО СЛОВА ДОЛЖНЫ СТАТЬ
Dialogue: 0,0:03:58.28,0:04:01.42,Caption,,0,0,0,,РЕШЕНИЕМ. И ТУТ ПРИХОДИТ ЭСКАЛАЦИЯ. ЧЕРЕЗ НЕКОТОРОЕ
Dialogue: 0,0:04:01.42,0:04:04.05,Caption,,0,0,0,,ВРЕМЯ ПЕРЕГОВОРЫ ВОЗОБНОВЛЯЮТСЯ. ВОЗВРАЩАЮТСЯ
Dialogue: 0,0:04:04.05,0:04:07.70,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ СТОРОН И ПОСРЕДНИКИ. ИДУТ ОБМЕНЫ ПЛЕННЫМИ И
Dialogue: 0,0:04:07.70,0:04:11.12,Caption,,0,0,0,,ТЕЛАМИ ПОГИБШИХ. ВОЗНИКАЮТ ОТДЕЛЬНЫЕ ДОГОВОРЁННОСТИ,
Dialogue: 0,0:04:11.20,0:04:13.76,Caption,,0,0,0,,ВКЛЮЧАЯ АЛЁШКИ. ВСЁ ДВИЖЕТСЯ ДО ТОЧКИ,
Dialogue: 0,0:04:14.00,0:04:16.64,Caption,,0,0,0,,ГДЕ ТРЕБУЕТСЯ НАСТОЯЩЕЕ РЕШЕНИЕ. ЗАТЕМ
Dialogue: 0,0:04:16.64,0:04:19.71,Caption,,0,0,0,,МЕХАНИЗМ СНОВА ВЫБРАСЫВАЕТ ЭСКАЛАЦИЮ. МАРШРУТ
Dialogue: 0,0:04:19.71,0:04:23.68,Caption,,0,0,0,,УЖЕ ВЫУЧЕН. АМЕРИКАНЦЫ ВИДЯТ, КОГДА КАНАТОХОДЕЦ ЗАМЕДЛИТСЯ,
Dialogue: 0,0:04:23.84,0:04:26.11,Caption,,0,0,0,,ГДЕ НАЧНЁТ РАСКАЧИВАТЬ ТРОС И ЧЕМ
Dialogue: 0,0:04:26.11,0:04:29.36,Caption,,0,0,0,,ЗАВЕРШАЛСЯ КАЖДЫЙ ПРЕДЫДУЩИЙ КРУГ. И ЧТО ПОСЛЕ ЭТОГО?
Dialogue: 0,0:04:29.76,0:04:34.00,Caption,,0,0,0,,ВЫ БУДЕТЕ ЭТО МЕНЯТЬ ИЛИ НЕТ? ИЛИ УЧАСТНИКИ ОПЯТЬ ПОТРАТЯТ МЕСЯЦЫ НА
Dialogue: 0,0:04:34.00,0:04:36.48,Caption,,0,0,0,,ВСТРЕЧИ И ВЕРНУТСЯ К ТОЙ ЖЕ РАЗВИЛКЕ С ТЕМ ЖЕ
Dialogue: 0,0:04:36.48,0:04:39.60,Caption,,0,0,0,,УДИВЛЕНИЕМ? У АДМИНИСТРАЦИИ ДОНАЛЬДА ТРАМПА ЗАПАС
Dialogue: 0,0:04:39.60,0:04:42.78,Caption,,0,0,0,,ВНИМАНИЯ ТОЖЕ ОГРАНИЧЕН. ВНУТРЕННЯЯ БОРЬБА В США
Dialogue: 0,0:04:42.78,0:04:46.10,Caption,,0,0,0,,СКОРО ПОТРЕБУЕТ ВСЁ БОЛЬШЕ ВРЕМЕНИ. ТОГДА ПЕРЕГОВОРЫ
Dialogue: 0,0:04:46.10,0:04:49.76,Caption,,0,0,0,,СМОГУТ ПРОИЗВОДИТЬ ЗАСЕДАНИЯ, ЗАЯВЛЕНИЯ И ФОТОГРАФИИ,
Dialogue: 0,0:04:49.92,0:04:52.48,Caption,,0,0,0,,НО НЕ РЕЗУЛЬТАТ. ПОДПИШИТЕСЬ НА КАНАЛ,
Dialogue: 0,0:04:52.71,0:04:54.63,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ВИДЕТЬ НЕ ТОЛЬКО ОЧЕРЕДНОЙ
Dialogue: 0,0:04:54.63,0:04:58.89,Caption,,0,0,0,,ПОВОРОТ, НО И МЕХАНИЗМ, ВОЗВРАЩАЮЩИЙ УЧАСТНИКОВ НА ПРЕЖНЕЕ
Dialogue: 0,0:04:58.89,0:05:02.40,Caption,,0,0,0,,МЕСТО. ТЕПЕРЬ К ДРУГОМУ ЭПИЗОДУ ТОЙ ЖЕ ЭСКАЛАЦИИ.
Dialogue: 0,0:05:02.40,0:05:04.48,Caption,,0,0,0,,ЗАПОМИНАЙТЕ ЕВРОПЕЙСКУЮ ВЕРСИЮ.
Dialogue: 0,0:05:06.74,0:05:08.90,Caption,,0,0,0,,НАПРЯЖЕНИЕ В БАЛТИЙСКОМ МОРЕ ПОВЫШАЕТ
Dialogue: 0,0:05:08.90,0:05:11.41,Caption,,0,0,0,,РОССИЯ. УКРАИНА СТОИТ В СТОРОНЕ И СЛУЧАЙНО
Dialogue: 0,0:05:11.41,0:05:14.42,Caption,,0,0,0,,ПРОХОДИЛА МИМО. ГЛАВНОЕ, ПОВТОРИТЬ ЭТО УВЕРЕННО,
Dialogue: 0,0:05:14.58,0:05:16.58,Caption,,0,0,0,,ПОКА НОВОСТИ С ДРУГОГО КРАЯ ЕВРОПЫ НЕ
Dialogue: 0,0:05:16.58,0:05:20.69,Caption,,0,0,0,,ИСПОРТИЛИ КАРТИНУ. ВОЗЛЕ БЕНГАЗИ АТАКОВАЛИ ДВА РОССИЙСКИХ
Dialogue: 0,0:05:20.69,0:05:22.82,Caption,,0,0,0,,КОРАБЛЯ. ОДНО СУДНО БЫЛО ГРАЖДАНСКИМ,
Dialogue: 0,0:05:22.93,0:05:26.90,Caption,,0,0,0,,ВТОРОЕ ВОЕННЫМ. ЭТО ВАЖНО, ПОСКОЛЬКУ СЛУЧИВШЕЕСЯ УЖЕ НЕ СВЕСТИ К
Dialogue: 0,0:05:26.90,0:05:29.70,Caption,,0,0,0,,ОДНОМУ ВОЕННОМУ ЭПИЗОДУ. ПРОЗВУЧАЛА ЖЁСТКАЯ
Dialogue: 0,0:05:29.70,0:05:32.69,Caption,,0,0,0,,ОЦЕНКА УКРАИНА ВПЕРВЫЕ УДАРИЛА ПО РОССИЙСКИМ КОРАБЛЯМ
Dialogue: 0,0:05:32.69,0:05:35.68,Caption,,0,0,0,,НА ТЕРРИТОРИИ ТРЕТЬЕЙ СТРАНЫ. ЭТО ПРОИЗОШЛО НЕ ВОЗЛЕ
Dialogue: 0,0:05:35.68,0:05:39.06,Caption,,0,0,0,,УКРАИНСКОГО ПОБЕРЕЖЬЯ, НЕ РЯДОМ С ОДЕССОЙ И НЕ В ЧАСТИ
Dialogue: 0,0:05:39.06,0:05:42.15,Caption,,0,0,0,,ЧЁРНОГО МОРЯ, ГДЕ РОССИЯ И УКРАИНА НЕПОСРЕДСТВЕННО
Dialogue: 0,0:05:42.15,0:05:45.43,Caption,,0,0,0,,ВЕДУТ БОЕВЫЕ ДЕЙСТВИЯ. МЕСТОМ СТАЛА ЛИВИЯ. ВЫБОР
Dialogue: 0,0:05:45.43,0:05:48.30,Caption,,0,0,0,,ВЫГЛЯДИТ РАСЧЁТЛИВЫМ. ОТ ЛИВИЙСКИХ ВЛАСТЕЙ ЕДВА
Dialogue: 0,0:05:48.30,0:05:51.95,Caption,,0,0,0,,ЛИ ОЖИДАЛИ ОТВЕТА, СПОСОБНОГО СРАЗУ ПОВЛИЯТЬ НА ПОЛОЖЕНИЕ
Dialogue: 0,0:05:51.95,0:05:54.56,Caption,,0,0,0,,УКРАИНЫ. В ОПЕРАЦИИ УЧАСТВОВАЛИ СЕМЬ МОРСКИХ
Dialogue: 0,0:05:54.56,0:05:57.41,Caption,,0,0,0,,БЕСПИЛОТНЫХ КАТЕРОВ. КОРАБЛЬ СТОЯЛ У ПРИЧАЛА И
Dialogue: 0,0:05:57.41,0:06:00.89,Caption,,0,0,0,,ПРИНИМАЛ ТОПЛИВО. НА СХЕМЕ ЗАЩИТА ОТ ТАКИХ АППАРАТОВ
Dialogue: 0,0:06:00.89,0:06:03.99,Caption,,0,0,0,,КАЖЕТСЯ РЕШАЕМОЙ ЗАДАЧЕЙ. ВО ВРЕМЯ ЗАПРАВКИ У СТЕНКИ
Dialogue: 0,0:06:03.99,0:06:07.50,Caption,,0,0,0,,ВСЁ ВЫГЛЯДИТ ХУЖЕ, ЧЕМ НА ШТАБНОЙ ПРЕЗЕНТАЦИИ. ЕСТЬ И
Dialogue: 0,0:06:07.50,0:06:10.09,Caption,,0,0,0,,ВОПРОС ПРОИСХОЖДЕНИЯ КАТЕРОВ. ИЗ ОДЕССЫ ДО
Dialogue: 0,0:06:10.09,0:06:12.64,Caption,,0,0,0,,ЛИВИИ ОНИ САМОСТОЯТЕЛЬНО НЕ ДОБРАЛИСЬ. АППАРАТЫ
Dialogue: 0,0:06:12.64,0:06:16.30,Caption,,0,0,0,,ТРЕБОВАЛОСЬ ПЕРЕВЕЗТИ, ПРОВЕСТИ ПО МАРШРУТУ И ДОСТАВИТЬ К
Dialogue: 0,0:06:16.30,0:06:21.10,Caption,,0,0,0,,МЕСТУ ЗАПУСКА. ЗА ОПЕРАЦИЕЙ СТОЯТ ТРАНСПОРТ,
Dialogue: 0,0:06:21.26,0:06:23.55,Caption,,0,0,0,,ТРАНЗИТНАЯ ИНФРАСТРУКТУРА И ЛЮДИ.
Dialogue: 0,0:06:23.55,0:06:25.98,Caption,,0,0,0,,ВМЕСТЕ С НИМИ ПОЯВЛЯЕТСЯ СПИСОК СТРАН,
Dialogue: 0,0:06:26.19,0:06:27.85,Caption,,0,0,0,,ЧЕРЕЗ КОТОРЫЕ МОГЛА ПРОЙТИ ЭТА
Dialogue: 0,0:06:27.85,0:06:30.87,Caption,,0,0,0,,ЦЕПОЧКА. ДАЛЬШЕ ОБНАРУЖИВАЕТСЯ НЕРАВНОМЕРНОСТЬ
Dialogue: 0,0:06:30.87,0:06:34.06,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ. ЗА РОССИЙСКИМИ ГРАНИЦАМИ НАХОДИТСЯ
Dialogue: 0,0:06:34.06,0:06:38.68,Caption,,0,0,0,,МНОЖЕСТВО СУДОВ, ПРЕДПРИЯТИЙ, ОБЪЕКТОВ И КОММЕРЧЕСКИХ ИНТЕРЕСОВ. У
Dialogue: 0,0:06:38.68,0:06:41.72,Caption,,0,0,0,,УКРАИНЫ СОПОСТАВИМОГО НАБОРА ЗАРУБЕЖНЫХ ЦЕЛЕЙ
Dialogue: 0,0:06:41.72,0:06:44.46,Caption,,0,0,0,,НЕТ. ОТВЕТИТЬ ТЕМ ЖЕ СПОСОБОМ И В ТОМ ЖЕ МАСШТАБЕ
Dialogue: 0,0:06:44.46,0:06:46.62,Caption,,0,0,0,,МОСКВЕ ТРУДНЕЕ. ОТСЮДА ВОПРОС,
Dialogue: 0,0:06:46.93,0:06:49.50,Caption,,0,0,0,,КОТОРЫЙ ЛИВИЕЙ НЕ ОГРАНИЧИВАЕТСЯ. ЕСЛИ
Dialogue: 0,0:06:49.50,0:06:51.93,Caption,,0,0,0,,АТАКИ В ТРЕТЬИХ СТРАНАХ СТАНОВЯТСЯ ДОПУСТИМОЙ
Dialogue: 0,0:06:51.93,0:06:54.45,Caption,,0,0,0,,ПРАКТИКОЙ, ГДЕ ЗАКАНЧИВАЕТСЯ ТЕРРИТОРИЯ
Dialogue: 0,0:06:54.45,0:06:58.93,Caption,,0,0,0,,КОНФЛИКТА? ГРАНИЦА ДЕРЖИТСЯ, ПОКА УЧАСТНИКИ СОГЛАСНЫ ВЕСТИ СЕБЯ
Dialogue: 0,0:06:58.93,0:07:01.72,Caption,,0,0,0,,ТАК, СЛОВНО ОНА СУЩЕСТВУЕТ. ПЕРВЫЙ УДАР ПО
Dialogue: 0,0:07:01.72,0:07:04.57,Caption,,0,0,0,,ОБЪЕКТУ В ЧУЖОМ ГОСУДАРСТВЕ ПРЕВРАЩАЕТ ЕЁ В
Dialogue: 0,0:07:04.57,0:07:07.64,Caption,,0,0,0,,ПРЕДМЕТ ТОРГА. НО ЕВРОПЕЙСКАЯ ПАМЯТКА ВЕЛИТ СЧИТАТЬ
Dialogue: 0,0:07:07.64,0:07:10.14,Caption,,0,0,0,,ИСТОЧНИКОМ ЭСКАЛАЦИИ РОССИЮ. ВИДИМО,
Dialogue: 0,0:07:10.33,0:07:13.42,Caption,,0,0,0,,У БАЛТИКИ ОДНА СИСТЕМА МЕР, А ВОЗЛЕ БЕНГАЗИ,
Dialogue: 0,0:07:13.51,0:07:16.03,Caption,,0,0,0,,ДРУГАЯ ФИЗИКА. ОСОБЕННО УДАЧНО РЯДОМ С
Dialogue: 0,0:07:16.03,0:07:18.07,Caption,,0,0,0,,ЭТИМ СМОТРИТСЯ ЕВРОПЕЙСКАЯ ПОМОЩЬ
Dialogue: 0,0:07:18.07,0:07:19.98,Caption,,0,0,0,,УКРАИНСКОЙ ПРОТИВОВОЗДУШНОЙ ОБОРОНЕ.
Dialogue: 0,0:07:20.62,0:07:22.38,Caption,,0,0,0,,ПЯТЬ ГОСУДАРСТВ ЕВРОПЫ ОТКАЗАЛИСЬ
Dialogue: 0,0:07:22.38,0:07:25.42,Caption,,0,0,0,,ПРЕДОСТАВИТЬ УКРАИНЕ РАКЕТЫ ДЛЯ КОМПЛЕКСОВ PATRIOT.
Dialogue: 0,0:07:25.42,0:07:28.30,Caption,,0,0,0,,МОЖНО СПОРИТЬ, ОБСУЖДАЛИСЬ СОРОК ПЕРЕХВАТЧИКОВ,
Dialogue: 0,0:07:28.39,0:07:30.85,Caption,,0,0,0,,ПЯТЬДЕСЯТ ИЛИ ШЕСТЬДЕСЯТ. ГЛАВНОГО ЭТО
Dialogue: 0,0:07:30.85,0:07:35.66,Caption,,0,0,0,,НЕ МЕНЯЕТ. ПРИ МАССИРОВАННЫХ УДАРАХ НЕСКОЛЬКО
Dialogue: 0,0:07:35.66,0:07:38.66,Caption,,0,0,0,,ДЕСЯТКОВ РАКЕТ РАСХОДУЮТСЯ ЗА СЧИТАННЫЕ ОТРАЖЕНИЯ
Dialogue: 0,0:07:38.66,0:07:42.40,Caption,,0,0,0,,АТАК. НО КИЕВ НЕ ПОЛУЧИЛ ДАЖЕ ТАКОГО ЗАПАСА. СИСТЕМАМИ
Dialogue: 0,0:07:42.40,0:07:44.43,Caption,,0,0,0,,PATRIOT ДЕФИЦИТ НЕ ИСЧЕРПЫВАЕТСЯ.
Dialogue: 0,0:07:44.99,0:07:46.95,Caption,,0,0,0,,ТРУДНОСТИ ВОЗНИКЛИ И С ЕВРОПЕЙСКИМИ
Dialogue: 0,0:07:46.95,0:07:50.39,Caption,,0,0,0,,РАКЕТАМИ ASTER. УКРАИНСКОЙ СТОРОНЕ СООБЩАЛИ О ЛИЦЕНЗИИ
Dialogue: 0,0:07:50.39,0:07:52.70,Caption,,0,0,0,,НА ПРОИЗВОДСТВО. ТЕПЕРЬ ДМИТРИЙ СНЕГИРЁВ
Dialogue: 0,0:07:52.70,0:07:55.47,Caption,,0,0,0,,ОПИСЫВАЕТ РЕЗУЛЬТАТ КОРОТКО. ОБЕЩАНИЕ ДАЛИ,
Dialogue: 0,0:07:55.72,0:07:59.28,Caption,,0,0,0,,НО НИ ЛИЦЕНЗИИ, НИ РАКЕТ НЕТ. НА ЭТОМ ФОНЕ МЕНЯЕТСЯ
Dialogue: 0,0:07:59.28,0:08:01.59,Caption,,0,0,0,,ПОЛОЖЕНИЕ В ОДЕССКОЙ ОБЛАСТИ. ПОЯВИЛИСЬ
Dialogue: 0,0:08:01.59,0:08:04.28,Caption,,0,0,0,,СООБЩЕНИЯ, ЧТО РОССИЙСКИЕ АВИАБОМБЫ ПРИМЕНЯЮТСЯ
Dialogue: 0,0:08:04.28,0:08:07.49,Caption,,0,0,0,,УЖЕ НЕ ТОЛЬКО У ПОБЕРЕЖЬЯ. ДАЛЬНОСТЬ ИХ ЗАХОДА ВГЛУБЬ
Dialogue: 0,0:08:07.49,0:08:09.81,Caption,,0,0,0,,ОБЛАСТИ ОЦЕНИВАЮТ В ДЕСЯТЬ ДВАДЦАТЬ
Dialogue: 0,0:08:09.81,0:08:12.99,Caption,,0,0,0,,КИЛОМЕТРОВ. СРАЗУ ОБОЗНАЧАЕТСЯ ВЕРОЯТНЫЙ ОБЪЕКТ РИСКА,
Dialogue: 0,0:08:13.23,0:08:15.60,Caption,,0,0,0,,МОСТ ЧЕРЕЗ ДНЕСТР В МАЯКАХ. УДАРЫ
Dialogue: 0,0:08:15.60,0:08:18.96,Caption,,0,0,0,,РАНЕЕ НАНОСИЛИСЬ ПО МОСТУ В ЗАТОКЕ. ТЕПЕРЬ ЕГО ТАКЖЕ
Dialogue: 0,0:08:18.96,0:08:21.80,Caption,,0,0,0,,ВКЛЮЧАЮТ В ЧИСЛО ОЧЕВИДНЫХ ПЕРВЫХ ЦЕЛЕЙ. С ЭТИМ
Dialogue: 0,0:08:21.80,0:08:24.62,Caption,,0,0,0,,СВЯЗЫВАЮТ ГРОМКИЕ РАЗГОВОРЫ О ПЕРЕДАЧЕ УКРАИНЕ
Dialogue: 0,0:08:24.62,0:08:27.66,Caption,,0,0,0,,АВИАЦИОННЫХ РАКЕТ ДЛЯ ПОРАЖЕНИЯ ЦЕЛЕЙ В ВОЗДУХЕ.
Dialogue: 0,0:08:27.66,0:08:30.99,Caption,,0,0,0,,ПРИЧИНА ЯСНА. ЧЕМ ДАЛЬШЕ АВИАБОМБЫ ДЕЙСТВУЮТ ОТ
Dialogue: 0,0:08:30.99,0:08:34.61,Caption,,0,0,0,,ЛИНИИ СОПРИКОСНОВЕНИЯ, ТЕМ БОЛЬШЕ ВАЖНЫХ ОБЪЕКТОВ ТЕРЯЮТ
Dialogue: 0,0:08:34.61,0:08:39.11,Caption,,0,0,0,,СТАТУС БЕЗОПАСНОГО ТЫЛА. РЕЧЬ НЕ О ЧУДЕСНОМ ОРУЖИИ. УКРАИНСКАЯ
Dialogue: 0,0:08:39.11,0:08:42.20,Caption,,0,0,0,,АРМИЯ УЖЕ ТРИ ГОДА НЕСЁТ ТЯЖЁЛЫЕ ПОТЕРИ ОТ ФАБОВ
Dialogue: 0,0:08:42.20,0:08:44.51,Caption,,0,0,0,,И КАБОВ. ИЗМЕНИЛИСЬ РАССТОЯНИЕ И
Dialogue: 0,0:08:44.51,0:08:47.44,Caption,,0,0,0,,ПЕРЕЧЕНЬ МЕСТ, ДО КОТОРЫХ ЭТИ СРЕДСТВА СПОСОБНЫ
Dialogue: 0,0:08:47.44,0:08:51.73,Caption,,0,0,0,,ДОТЯНУТЬСЯ. ПОСЛЕ ОДЕССКОЙ ОБЛАСТИ СНОВА
Dialogue: 0,0:08:51.73,0:08:55.11,Caption,,0,0,0,,ПРИХОДИТСЯ СМОТРЕТЬ НА ЛИВИЮ. ТАМ ПОСЛЕДСТВИЯ ОПЕРАЦИИ ВЫШЛИ
Dialogue: 0,0:08:55.11,0:08:57.58,Caption,,0,0,0,,ДАЛЕКО ЗА ПРЕДЕЛЫ ОТНОШЕНИЙ МОСКВЫ И КИЕВА.
Dialogue: 0,0:08:58.22,0:09:00.78,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ ПРЕДСЕДАТЕЛЯ ПРЕЗИДЕНТСКОГО СОВЕТА ЛИВИИ
Dialogue: 0,0:09:00.78,0:09:02.86,Caption,,0,0,0,,МУСА АЛЬ КОНИ ФАКТИЧЕСКИ НАЗВАЛ
Dialogue: 0,0:09:02.86,0:09:06.38,Caption,,0,0,0,,НАПАДЕНИЕ НА РОССИЙСКОЕ СУДНО ОБЪЯВЛЕНИЕМ ВОЙНЫ ЕГО
Dialogue: 0,0:09:06.38,0:09:09.50,Caption,,0,0,0,,СТРАНЕ. ПО ЕГО СЛОВАМ, ПРИЧИНЁН МАТЕРИАЛЬНЫЙ УЩЕРБ,
Dialogue: 0,0:09:09.74,0:09:11.95,Caption,,0,0,0,,СРЕДИ МИРНЫХ ЖИТЕЛЕЙ ЕСТЬ РАНЕНЫЕ.
Dialogue: 0,0:09:11.95,0:09:14.97,Caption,,0,0,0,,ОДНИМ СЕРДИТЫМ ВЫСТУПЛЕНИЕМ ЛИВИЙСКАЯ СТОРОНА НЕ
Dialogue: 0,0:09:14.97,0:09:18.07,Caption,,0,0,0,,ОГРАНИЧИТСЯ. ВЛАСТИ НАМЕРЕНЫ ОБРАТИТЬСЯ В СОВЕТ
Dialogue: 0,0:09:18.07,0:09:20.94,Caption,,0,0,0,,БЕЗОПАСНОСТИ ООН И ПОДАТЬ ПРОТИВ УКРАИНЫ ИСК В
Dialogue: 0,0:09:20.94,0:09:24.91,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ СУД. ЗАТЕМ ОТРЕАГИРОВАЛА ИТАЛИЯ. АНТОНИО
Dialogue: 0,0:09:24.91,0:09:27.53,Caption,,0,0,0,,ТАЯНИ НАЗВАЛ УДАР НАРУШЕНИЕМ ЛИВИЙСКОГО
Dialogue: 0,0:09:27.53,0:09:31.11,Caption,,0,0,0,,СУВЕРЕНИТЕТА И ОШИБОЧНЫМ РЕШЕНИЕМ. ОТДЕЛЬНО ОН СООБЩИЛ
Dialogue: 0,0:09:31.11,0:09:34.58,Caption,,0,0,0,,НЕУДОБНОЕ ДЛЯ КИЕВА ОБСТОЯТЕЛЬСТВО. ИТАЛЬЯНСКАЯ СТОРОНА
Dialogue: 0,0:09:34.58,0:09:36.77,Caption,,0,0,0,,ЗАРАНЕЕ НЕ ЗНАЛА О НАМЕРЕНИИ АТАКОВАТЬ В
Dialogue: 0,0:09:36.77,0:09:40.65,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫХ ВОДАХ ЛИВИИ. ПОСЛЕ ЭТОГО РАЗГОВОР О БЕЗУСЛОВНОЙ
Dialogue: 0,0:09:40.65,0:09:43.30,Caption,,0,0,0,,ПОДДЕРЖКЕ СТАНОВИТСЯ РАЗГОВОРОМ О ПОСЛЕДСТВИЯХ.
Dialogue: 0,0:09:43.30,0:09:45.93,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО КИЕВ ГОТОВ ЗАХОДИТЬ БЕЗ
Dialogue: 0,0:09:45.93,0:09:49.34,Caption,,0,0,0,,УВЕДОМЛЕНИЯ СОЮЗНИКОВ? И КОМУ ПРЕДЪЯВЯТ РАСХОДЫ,
Dialogue: 0,0:09:49.50,0:09:51.42,Caption,,0,0,0,,КОГДА ЕГО САМОСТОЯТЕЛЬНОСТЬ СНОВА
Dialogue: 0,0:09:51.42,0:09:53.18,Caption,,0,0,0,,ОКАЖЕТСЯ ЩЕДРОЙ ЗА ЧУЖОЙ СЧЁТ?
Dialogue: 0,0:09:53.62,0:09:55.82,Caption,,0,0,0,,ТАЯНИ РУКОВОДИТ ПАРТИЕЙ FORZA ITALIA,
Dialogue: 0,0:09:56.03,0:09:58.94,Caption,,0,0,0,,ВХОДЯЩЕЙ В ПРАВЯЩУЮ КОАЛИЦИЮ. СОСТОЯЩАЯ В ТОЙ ЖЕ
Dialogue: 0,0:09:58.94,0:10:01.50,Caption,,0,0,0,,КОАЛИЦИИ ПАРТИЯ ЛИГА ТАКЖЕ ОСУДИЛА
Dialogue: 0,0:10:01.50,0:10:03.74,Caption,,0,0,0,,ОПЕРАЦИЮ И СОЧЛА ЕЁ НЕДОПУСТИМОЙ.
Dialogue: 0,0:10:06.03,0:10:07.99,Caption,,0,0,0,,ОДНОВРЕМЕННО ЗАПАДНЫЕ ИЗДАНИЯ СО
Dialogue: 0,0:10:07.99,0:10:11.19,Caption,,0,0,0,,ССЫЛКАМИ НА ЮРИСТОВ ОБСУЖДАЮТ ВОЗМОЖНОЕ НАРУШЕНИЕ
Dialogue: 0,0:10:11.19,0:10:14.34,Caption,,0,0,0,,МЕЖДУНАРОДНОГО ПРАВА И РАЗБИРАТЕЛЬСТВО ЧЕРЕЗ МЕЖДУНАРОДНЫЙ
Dialogue: 0,0:10:14.34,0:10:17.31,Caption,,0,0,0,,УГОЛОВНЫЙ СУД. ЛИВИЯ НАМЕРЕНА ДЕЙСТВОВАТЬ ЧЕРЕЗ
Dialogue: 0,0:10:17.31,0:10:20.88,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ СУД. В ЗАПАДНЫХ ПУБЛИКАЦИЯХ РАССМАТРИВАЕТСЯ
Dialogue: 0,0:10:20.88,0:10:23.97,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ СУД. ОДНА МОРСКАЯ ОПЕРАЦИЯ
Dialogue: 0,0:10:23.97,0:10:26.19,Caption,,0,0,0,,ПОРОДИЛА ОБРАЩЕНИЕ В СОВБЕЗ ООН,
Dialogue: 0,0:10:26.59,0:10:30.80,Caption,,0,0,0,,ДВА СУДЕБНЫХ НАПРАВЛЕНИЯ, ПРЕТЕНЗИИ ЛИВИИ И ПУБЛИЧНОЕ ОСУЖДЕНИЕ
Dialogue: 0,0:10:30.80,0:10:33.55,Caption,,0,0,0,,СО СТОРОНЫ ГОСУДАРСТВА НАТО. ДЛЯ ЛЮДЕЙ,
Dialogue: 0,0:10:33.73,0:10:36.88,Caption,,0,0,0,,УВЕРЯЮЩИХ, ЧТО ЭСКАЛАЦИЕЙ МОЖНО УПРАВЛЯТЬ ТОЧНЫМИ
Dialogue: 0,0:10:36.88,0:10:40.83,Caption,,0,0,0,,ДВИЖЕНИЯМИ ПАЛЬЦЕВ, ИТОГ ПОЧТИ ЮВЕЛИРНЫЙ. ОСТАЛОСЬ ПОНЯТЬ,
Dialogue: 0,0:10:41.16,0:10:43.62,Caption,,0,0,0,,ПОЧЕМУ ПОСЛЕ РАБОТЫ ЮВЕЛИРА НА СТОЛЕ
Dialogue: 0,0:10:43.62,0:10:46.35,Caption,,0,0,0,,ОСКОЛКИ. ПОКА СОЮЗНИКИ РАЗБИРАЛИСЬ С БЕНГАЗИ,
Dialogue: 0,0:10:46.51,0:10:48.32,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ ЗАНЯЛАСЬ АТОМНЫМ
Dialogue: 0,0:10:48.32,0:10:51.73,Caption,,0,0,0,,ПОДВОДНЫМ ФЛОТОМ. ЛОНДОН НАПРАВЛЯЕТ ВОСЕМЬ МИЛЛИАРДОВ
Dialogue: 0,0:10:51.73,0:10:54.16,Caption,,0,0,0,,ФУНТОВ НА ПОДГОТОВКУ И ОБСЛУЖИВАНИЕ АТОМНЫХ
Dialogue: 0,0:10:54.16,0:10:56.80,Caption,,0,0,0,,СУБМАРИН. ПЕРВОНАЧАЛЬНЫЙ КОНТРАКТ С BABCOCK
Dialogue: 0,0:10:56.80,0:10:59.76,Caption,,0,0,0,,РАССЧИТАН НА ПЯТЬ ЛЕТ. ЦЕЛЬ ПРОСТА СОКРАТИТЬ СРОКИ
Dialogue: 0,0:10:59.76,0:11:02.90,Caption,,0,0,0,,РЕМОНТА, БЫСТРЕЕ ВОЗВРАЩАТЬ ЛОДКИ В СТРОЙ И НЕ
Dialogue: 0,0:11:02.90,0:11:05.79,Caption,,0,0,0,,ПРЕВРАЩАТЬ ДОКИ В МНОГОЛЕТНЮЮ СТОЯНКУ ДОРОГОГО
Dialogue: 0,0:11:05.79,0:11:08.75,Caption,,0,0,0,,МЕТАЛЛА. РАБОТЫ ЗАТРОНУТ БАЗЫ ДЕВОНПОРТ И КЛАЙД,
Dialogue: 0,0:11:09.06,0:11:12.68,Caption,,0,0,0,,РАКЕТОНОСЦЫ VANGUARD, МНОГОЦЕЛЕВЫЕ СУБМАРИНЫ ASTUTE И
Dialogue: 0,0:11:12.68,0:11:15.95,Caption,,0,0,0,,ПЕРЕХОД К КЛАССУ DREADNOUGHT. НОВЫЕ ЛОДКИ ДОЛЖНЫ ВОЙТИ
Dialogue: 0,0:11:15.95,0:11:18.27,Caption,,0,0,0,,В БРИТАНСКУЮ СИСТЕМУ ЯДЕРНОГО СДЕРЖИВАНИЯ.
Dialogue: 0,0:11:20.48,0:11:22.60,Caption,,0,0,0,,ПРИ ЭТОМ ВОСЕМЬЮ МИЛЛИАРДАМИ РАСХОДЫ
Dialogue: 0,0:11:22.60,0:11:25.39,Caption,,0,0,0,,НЕ ЗАКАНЧИВАЮТСЯ. BABCOCK ОЦЕНИВАЕТ ОБЩИЙ
Dialogue: 0,0:11:25.39,0:11:28.46,Caption,,0,0,0,,ОБЪЁМ СДЕЛКИ В ВОСЕМЬ МИЛЛИАРДОВ СЕМЬСОТ МИЛЛИОНОВ
Dialogue: 0,0:11:28.46,0:11:30.86,Caption,,0,0,0,,ФУНТОВ. ДОПОЛНИТЕЛЬНЫЕ СЕМЬСОТ МИЛЛИОНОВ
Dialogue: 0,0:11:30.86,0:11:33.14,Caption,,0,0,0,,ОТНОСЯТСЯ К РАМОЧНЫМ ОБЯЗАТЕЛЬСТВАМ. СРОК
Dialogue: 0,0:11:33.14,0:11:36.80,Caption,,0,0,0,,СОТРУДНИЧЕСТВА МОЖЕТ УВЕЛИЧИТЬСЯ С ПЯТИ ДО ПЯТНАДЦАТИ ЛЕТ.
Dialogue: 0,0:11:36.80,0:11:40.06,Caption,,0,0,0,,ДЛЯ КОМПАНИИ ЭТО КРУПНЕЙШИЙ КОНТРАКТ В ЕЁ ИСТОРИИ.
Dialogue: 0,0:11:40.06,0:11:42.46,Caption,,0,0,0,,ОБЪЯСНЕНИЕ ТАКОЙ ЩЕДРОСТИ НАХОДИТСЯ НЕ В
Dialogue: 0,0:11:42.46,0:11:45.89,Caption,,0,0,0,,ОКЕАНСКИХ ГЛУБИНАХ, А В РЕМОНТНОЙ ОЧЕРЕДИ. НЕКОТОРЫЕ
Dialogue: 0,0:11:45.89,0:11:49.43,Caption,,0,0,0,,БРИТАНСКИЕ АТОМНЫЕ ПОДЛОДКИ ЖДАЛИ ОБСЛУЖИВАНИЯ БОЛЬШЕ
Dialogue: 0,0:11:49.43,0:11:52.58,Caption,,0,0,0,,ДВУХ ЛЕТ. БОЛЬШЕ ДВУХ ЛЕТ У ПРИЧАЛА ДЛЯ АТОМНОЙ
Dialogue: 0,0:11:52.58,0:11:54.72,Caption,,0,0,0,,ДЕРЖАВЫ, ОБЪЯСНЯЮЩЕЙ ОСТАЛЬНЫМ,
Dialogue: 0,0:11:54.99,0:11:57.16,Caption,,0,0,0,,КАК ГОТОВИТЬСЯ К ПРОТИВОСТОЯНИЮ С
Dialogue: 0,0:11:57.16,0:12:00.30,Caption,,0,0,0,,РОССИЕЙ. МОЖНО ЗАКАЗАТЬ АВТОМОБИЛЬ И ДОЖДАТЬСЯ НОВОЙ
Dialogue: 0,0:12:00.30,0:12:03.30,Caption,,0,0,0,,МОДЕЛИ, А БРИТАНСКАЯ СУБМАРИНА ВСЁ ЕЩЁ ЖДЁТ
Dialogue: 0,0:12:03.30,0:12:06.13,Caption,,0,0,0,,МАСТЕРА. ЛОДКИ С ЯДЕРНЫМИ РАКЕТАМИ ОБСЛУЖИВАЛИ В
Dialogue: 0,0:12:06.13,0:12:09.82,Caption,,0,0,0,,ПЕРВУЮ ОЧЕРЕДЬ. МНОГОЦЕЛЕВЫЕ СУБМАРИНЫ ЗАНИМАЛИ МЕСТО
Dialogue: 0,0:12:09.82,0:12:11.68,Caption,,0,0,0,,В ХВОСТЕ. УЭС СТРИТИНГ ЗАЯВИЛ,
Dialogue: 0,0:12:11.92,0:12:14.43,Caption,,0,0,0,,ЧТО СТРАНА НЕ ДОЛЖНА ПОВТОРЯТЬ ПРЕЖНЮЮ
Dialogue: 0,0:12:14.43,0:12:17.12,Caption,,0,0,0,,ОШИБКУ И ОТКЛАДЫВАТЬ ВЛОЖЕНИЯ В ЯДЕРНЫЕ СИЛЫ.
Dialogue: 0,0:12:17.68,0:12:19.44,Caption,,0,0,0,,ДЛЯ УКРЕПЛЕНИЯ СДЕРЖИВАНИЯ ЛОНДОН
Dialogue: 0,0:12:19.44,0:12:22.72,Caption,,0,0,0,,ГОТОВ БРАТЬ ДЕНЬГИ ИЗ БЮДЖЕТОВ ДРУГИХ ВЕДОМСТВ. РЯДОМ
Dialogue: 0,0:12:22.72,0:12:26.18,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЕЩЁ ОДНО ЧИСЛО. ТЫСЯЧА ДНЕЙ. СТОЛЬКО
Dialogue: 0,0:12:26.18,0:12:29.25,Caption,,0,0,0,,ОТВОДИТСЯ НА ПОДГОТОВКУ ВЕЛИКОБРИТАНИИ К ВОЗМОЖНЫМ
Dialogue: 0,0:12:29.25,0:12:31.74,Caption,,0,0,0,,БОЕВЫМ ДЕЙСТВИЯМ ИЛИ СДЕРЖИВАНИЮ ПРОТИВНИКА
Dialogue: 0,0:12:31.74,0:12:34.23,Caption,,0,0,0,,НА ФОНЕ РОССИЙСКОЙ УГРОЗЫ. ЭТО МЕНЬШЕ ТРЁХ
Dialogue: 0,0:12:34.23,0:12:38.96,Caption,,0,0,0,,ЛЕТ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОБСУЖДАЮТ МИРНОЕ
Dialogue: 0,0:12:38.96,0:12:43.24,Caption,,0,0,0,,СОГЛАШЕНИЕ, ГАРАНТИИ, НОВЫЕ ПЛОЩАДКИ И ПОЕЗДКУ В МОСКВУ.
Dialogue: 0,0:12:43.79,0:12:46.21,Caption,,0,0,0,,ЛОНДОН ОДНОВРЕМЕННО СЧИТАЕТ МИЛЛИАРДЫ
Dialogue: 0,0:12:46.21,0:12:49.39,Caption,,0,0,0,,ДЛЯ АТОМНОГО ФЛОТА И ДНИ ДО ГОТОВНОСТИ К КРУПНОЙ
Dialogue: 0,0:12:49.39,0:12:51.80,Caption,,0,0,0,,ВОЙНЕ. УКРАИНЕ ПРЕДЛАГАЮТ ЗАЩИТУ,
Dialogue: 0,0:12:52.04,0:12:54.21,Caption,,0,0,0,,НАПОМИНАЮЩУЮ ПЯТУЮ СТАТЬЮ НАТО.
Dialogue: 0,0:12:54.21,0:12:57.72,Caption,,0,0,0,,РУМЫНИЯ ОТВЕЧАЕТ, ЧТО РЕАЛЬНЫЙ ПЕРЕХВАТ ЦЕЛЕЙ НАД
Dialogue: 0,0:12:57.72,0:13:01.06,Caption,,0,0,0,,УКРАИНОЙ УЖЕ ДЕЛАЕТ АЛЬЯНС УЧАСТНИКОМ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:13:01.06,0:13:04.18,Caption,,0,0,0,,ПЯТЬ ЕВРОПЕЙСКИХ СТРАН УДЕРЖИВАЮТ ДАЖЕ НЕБОЛЬШОЙ ЗАПАС
Dialogue: 0,0:13:04.18,0:13:07.30,Caption,,0,0,0,,РАКЕТ PATRIOT. ИТАЛИЯ УЗНАЁТ ОБ УДАРЕ В ЛИВИЙСКИХ
Dialogue: 0,0:13:07.30,0:13:10.31,Caption,,0,0,0,,ВОДАХ ПОСЛЕ СЛУЧИВШЕГОСЯ. ЛИВИЙСКИЕ ВЛАСТИ ГОТОВЯТ
Dialogue: 0,0:13:10.31,0:13:13.74,Caption,,0,0,0,,ОБРАЩЕНИЯ В ООН И МЕЖДУНАРОДНЫЕ СУДЫ. ВАШИНГТОН
Dialogue: 0,0:13:13.74,0:13:17.51,Caption,,0,0,0,,ОТЛИЧНО ВИДИТ ПРИЧИНУ, ПО КОТОРОЙ ПЕРЕГОВОРНЫЙ ЦИКЛ СНОВА
Dialogue: 0,0:13:17.51,0:13:20.20,Caption,,0,0,0,,ПРИВОДИТ СТОРОНЫ К ЗНАКОМОЙ ТОЧКЕ. ЗНАЧИТ,
Dialogue: 0,0:13:20.34,0:13:22.32,Caption,,0,0,0,,ПРОБЛЕМА ДАВНО НЕ В НЕДОСТАТКЕ
Dialogue: 0,0:13:22.32,0:13:26.01,Caption,,0,0,0,,ПОНИМАНИЯ. ПОНИМАНИЯ ТАМ ДОСТАТОЧНО. НЕ ХВАТАЕТ ОТВЕТА НА
Dialogue: 0,0:13:26.01,0:13:29.16,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС. ВЫ БУДЕТЕ ЭТО МЕНЯТЬ ИЛИ НЕТ?
Dialogue: 0,0:13:29.32,0:13:31.23,Caption,,0,0,0,,МОЖНО НАПИСАТЬ ДЛЯ УКРАИНЫ ШИРОКИЕ
Dialogue: 0,0:13:31.23,0:13:34.29,Caption,,0,0,0,,ГАРАНТИИ И ПОДОБРАТЬ УСПОКАИВАЮЩИЕ ФОРМУЛИРОВКИ.
Dialogue: 0,0:13:34.29,0:13:37.56,Caption,,0,0,0,,ТРУДНЕЕ ОПРЕДЕЛИТЬ, ВКЛЮЧАЮТ ЛИ ОБЯЗАТЕЛЬСТВА ОПЛАТУ
Dialogue: 0,0:13:37.56,0:13:40.27,Caption,,0,0,0,,РЕШЕНИЙ КИЕВА, ПОСЛЕ КОТОРЫХ ЗА ОБЪЯСНЕНИЯМИ К
Dialogue: 0,0:13:40.27,0:13:42.44,Caption,,0,0,0,,СОЮЗНИКАМ ПРИХОДЯТ ПОСТОРОННИЕ ГОСУДАРСТВА.
Dialogue: 0,0:13:42.99,0:13:45.15,Caption,,0,0,0,,ИМЕННО ЭТУ СТРОКУ В БУДУЩИХ ГАРАНТИЯХ
Dialogue: 0,0:13:45.15,0:13:47.80,Caption,,0,0,0,,ПОСТАРАЮТСЯ НАПЕЧАТАТЬ САМЫМ МЕЛКИМ ШРИФТОМ.
