Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СНОВА РЕШИЛ ПОВЫСИТЬ СТАВКИ. ПРИЧЁМ СДЕЛАЛ
Dialogue: 0,0:00:03.16,0:00:06.12,Caption,,0,0,0,,ЭТО ТАК, ЧТОБЫ СОБЫТИЕ ЗАМЕТИЛИ НЕ ТОЛЬКО В МОСКВЕ,
Dialogue: 0,0:00:06.36,0:00:09.40,Caption,,0,0,0,,НО И В ВАШИНГТОНЕ. В КИЕВЕ, СУДЯ ПО РЕАКЦИИ,
Dialogue: 0,0:00:09.54,0:00:12.28,Caption,,0,0,0,,РЕЗУЛЬТАТОМ ДОВОЛЬНЫ. А ВОТ В АМЕРИКАНСКОМ ВОЕННОМ
Dialogue: 0,0:00:12.28,0:00:15.48,Caption,,0,0,0,,ВЕДОМСТВЕ ВОСТОРГА ПОЧЕМУ ТО НЕ СЛУЧИЛОСЬ. И ТУТ
Dialogue: 0,0:00:15.48,0:00:18.04,Caption,,0,0,0,,ВОЗНИКАЕТ ЗАНЯТНАЯ ИСТОРИЯ ЧЕЛОВЕК РАССЧИТЫВАЕТ НА
Dialogue: 0,0:00:18.04,0:00:21.96,Caption,,0,0,0,,ОДИН ЭФФЕКТ, А ПОЛУЧАЕТ СОВСЕМ ДРУГУЮ РЕАКЦИЮ. ТОЛЬКО КТО СКАЗАЛ,
Dialogue: 0,0:00:22.10,0:00:23.72,Caption,,0,0,0,,ЧТО НА ЭТОМ СЮРПРИЗЫ ЗАКОНЧИЛИСЬ?
Dialogue: 0,0:00:23.86,0:00:25.64,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:25.72,0:00:29.40,Caption,,0,0,0,,ПОДПИШИТЕСЬ. КРЫМСКИЙ МОСТ СНОВА ОКАЗАЛСЯ В ЦЕНТРЕ БОЛЬШОЙ
Dialogue: 0,0:00:29.40,0:00:32.28,Caption,,0,0,0,,ПОЛИТИКИ. КИЕВ ОБЪЯВИЛ О СЕРЬЁЗНЫХ ПОВРЕЖДЕНИЯХ
Dialogue: 0,0:00:32.28,0:00:34.84,Caption,,0,0,0,,АВТОМОБИЛЬНОЙ ЧАСТИ И ПРЕДСТАВИЛ ОПЕРАЦИЮ КАК
Dialogue: 0,0:00:34.84,0:00:37.64,Caption,,0,0,0,,КРУПНЫЙ УСПЕХ. ЗЕЛЕНСКИЙ ОТДЕЛЬНО ПОБЛАГОДАРИЛ
Dialogue: 0,0:00:37.64,0:00:41.32,Caption,,0,0,0,,ВОЕННЫХ, СПЕЦСЛУЖБЫ И ПРОИЗВОДИТЕЛЕЙ УКРАИНСКОГО ОРУЖИЯ.
Dialogue: 0,0:00:41.72,0:00:44.12,Caption,,0,0,0,,ЗАОДНО ПЕРЕЧИСЛИЛИ ПОЧТИ ВЕСЬ АССОРТИМЕНТ
Dialogue: 0,0:00:44.13,0:00:46.84,Caption,,0,0,0,,"ПАЛЯНИЦА", "РУТА", FP ПЯТЬ,
Dialogue: 0,0:00:47.00,0:00:51.08,Caption,,0,0,0,,"НЕПТУН", "ФЛАМИНГО". ПОЛУЧИЛОСЬ НЕ ПРОСТО СООБЩЕНИЕ ОБ УДАРЕ,
Dialogue: 0,0:00:51.32,0:00:54.52,Caption,,0,0,0,,А НАСТОЯЩАЯ ВИТРИНА УКРАИНСКИХ ВОЗМОЖНОСТЕЙ. МОЛ,
Dialogue: 0,0:00:54.60,0:00:56.76,Caption,,0,0,0,,СМОТРИТЕ, СКОЛЬКО ВСЕГО УМЕЕМ,
Dialogue: 0,0:00:56.92,0:00:59.48,Caption,,0,0,0,,СКОЛЬКО ВСЕГО ПРОИЗВОДИМ И КУДА УЖЕ СПОСОБНЫ
Dialogue: 0,0:00:59.48,0:01:02.12,Caption,,0,0,0,,ДОСТАТЬ. ТОЛЬКО В ТАКОЙ СИТУАЦИИ ОЧЕНЬ ЛЕГКО
Dialogue: 0,0:01:02.12,0:01:05.08,Caption,,0,0,0,,ПЕРЕПУТАТЬ ДВЕ СОВЕРШЕННО РАЗНЫЕ ВЕЩИ. СПОСОБНОСТЬ
Dialogue: 0,0:01:05.08,0:01:07.24,Caption,,0,0,0,,НАНЕСТИ УДАР ПО СТРАТЕГИЧЕСКОМУ ОБЪЕКТУ И
Dialogue: 0,0:01:07.24,0:01:10.44,Caption,,0,0,0,,СПОСОБНОСТЬ ИЗМЕНИТЬ ЭТИМ ХОД КОНФЛИКТА. МОСТ
Dialogue: 0,0:01:10.44,0:01:13.48,Caption,,0,0,0,,ПОЛУЧИЛ ПОВРЕЖДЕНИЯ. ДВИЖЕНИЕ ПРИШЛОСЬ ОГРАНИЧИВАТЬ.
Dialogue: 0,0:01:15.66,0:01:18.55,Caption,,0,0,0,,КАДРЫ ПОЛУЧИЛИСЬ ГРОМКИЕ. НО РОССИЙСКАЯ СТОРОНА УЖЕ
Dialogue: 0,0:01:18.55,0:01:21.43,Caption,,0,0,0,,СООБЩИЛА О ВОССТАНОВЛЕНИИ ЖЕЛЕЗНОДОРОЖНОГО СООБЩЕНИЯ
Dialogue: 0,0:01:21.43,0:01:24.39,Caption,,0,0,0,,ПО ОДНОМУ ПУТИ И РЕМОНТЕ ВТОРОГО. ОДНОВРЕМЕННО В
Dialogue: 0,0:01:24.39,0:01:28.71,Caption,,0,0,0,,МОСКВЕ ЗАЯВИЛИ, ЧТО МОСТ ВОССТАНОВЯТ ПОЛНОСТЬЮ. А КИЕВ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:01:28.71,0:01:31.59,Caption,,0,0,0,,ОСТАНАВЛИВАТЬСЯ НЕ СОБИРАЕТСЯ. ЗЕЛЕНСКИЙ ОБЪЯВИЛ О
Dialogue: 0,0:01:31.67,0:01:34.31,Caption,,0,0,0,,НОВЫХ ОПЕРАЦИЯХ ПРОТИВ РОССИИ. МИНИСТР ОБОРОНЫ
Dialogue: 0,0:01:34.39,0:01:37.27,Caption,,0,0,0,,УКРАИНЫ ЕВГЕНИЙ ХМАРА ВЫРАЗИЛСЯ ЕЩЁ КОРОЧЕ "МЫ
Dialogue: 0,0:01:37.27,0:01:39.91,Caption,,0,0,0,,ТОЛЬКО НАЧИНАЕМ". ВОТ ЗДЕСЬ И НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:01:39.91,0:01:42.71,Caption,,0,0,0,,ИНТЕРЕСНОЕ. ПОТОМУ ЧТО ПОЧТИ ОДНОВРЕМЕННО ИЗ
Dialogue: 0,0:01:42.71,0:01:47.03,Caption,,0,0,0,,ПЕНТАГОНА ПРОЗВУЧАЛА ОЦЕНКА, КОТОРАЯ В ПРАЗДНИЧНУЮ КАРТИНУ ВПИСАЛАСЬ ПЛОХО.
Dialogue: 0,0:01:47.33,0:01:49.99,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ МИНИСТРА ОБОРОНЫ США ЭЛБРИДЖ КОЛБИ
Dialogue: 0,0:01:50.07,0:01:53.59,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО УКРАИНСКИЕ УДАРЫ В ГЛУБИНУ РОССИЙСКОЙ ТЕРРИТОРИИ
Dialogue: 0,0:01:53.82,0:01:56.63,Caption,,0,0,0,,НЕ ПРИБЛИЗИЛИ ЗАВЕРШЕНИЕ КОНФЛИКТА И НЕ ПОМОГЛИ
Dialogue: 0,0:01:56.63,0:01:59.75,Caption,,0,0,0,,ОСТАНОВИТЬ ПРОДВИЖЕНИЕ РОССИЙСКИХ ВОЙСК. БОЛЕЕ ТОГО,
Dialogue: 0,0:01:59.98,0:02:03.99,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, АТАКИ НА ОТДЕЛЬНЫЕ ГРАЖДАНСКИЕ ОБЪЕКТЫ СПОСОБНЫ ЛИШЬ
Dialogue: 0,0:02:03.99,0:02:06.79,Caption,,0,0,0,,УКРЕПИТЬ РЕШИМОСТЬ РОССИЙСКОГО ОБЩЕСТВА И ГОТОВНОСТЬ
Dialogue: 0,0:02:06.79,0:02:09.59,Caption,,0,0,0,,МОСКВЫ К ДАЛЬНЕЙШЕМУ ОБОСТРЕНИЮ. И ДАЛЬШЕ КОЛБИ
Dialogue: 0,0:02:09.67,0:02:12.87,Caption,,0,0,0,,СКАЗАЛ ЕЩЁ НЕПРИЯТНЕЕ. В ОБМЕНЕ ДАЛЬНИМИ УДАРАМИ
Dialogue: 0,0:02:12.87,0:02:16.23,Caption,,0,0,0,,ПРЕИМУЩЕСТВО СПОСОБНО ОКАЗАТЬСЯ У РОССИИ. ВОТ ЭТО
Dialogue: 0,0:02:16.31,0:02:17.99,Caption,,0,0,0,,УЖЕ НЕ ВОПРОС КРАСИВЫХ ФОТОГРАФИЙ.
Dialogue: 0,0:02:20.27,0:02:23.07,Caption,,0,0,0,,ЕСЛИ ОДНА СТОРОНА НАЧИНАЕТ СОРЕВНОВАНИЕ В ДАЛЬНОСТИ
Dialogue: 0,0:02:23.07,0:02:27.39,Caption,,0,0,0,,И МОЩНОСТИ УДАРОВ, А У ВТОРОЙ РЕСУРСОВ ДЛЯ ТАКОГО СОРЕВНОВАНИЯ БОЛЬШЕ,
Dialogue: 0,0:02:27.78,0:02:32.11,Caption,,0,0,0,,ТО ОЧЕНЬ БЫСТРО ВЫЯСНЯЕТСЯ, ЧТО ГРОМКО ОТКРЫТЬ НОВЫЙ РАУНД ГОРАЗДО ПРОЩЕ,
Dialogue: 0,0:02:32.19,0:02:34.75,Caption,,0,0,0,,ЧЕМ ОПРЕДЕЛИТЬ, ЧЕМ ЭТОТ РАУНД ЗАКОНЧИТСЯ.
Dialogue: 0,0:02:35.39,0:02:37.87,Caption,,0,0,0,,ПРИ ЭТОМ КОЛБИ ВОВСЕ НЕ ВЫСТУПИЛ ПРОТИВ УДАРОВ
Dialogue: 0,0:02:37.87,0:02:40.59,Caption,,0,0,0,,ПО РОССИЙСКИМ ВОЕННЫМ ОБЪЕКТАМ. НАОБОРОТ. ОН
Dialogue: 0,0:02:40.59,0:02:44.91,Caption,,0,0,0,,ПОДДЕРЖАЛ ДЕЙСТВИЯ, КОТОРЫЕ ПОМОГАЮТ УКРАИНСКОЙ АРМИИ УДЕРЖИВАТЬ ФРОНТ И
Dialogue: 0,0:02:44.91,0:02:47.95,Caption,,0,0,0,,НАНОСИТЬ УЩЕРБ РОССИЙСКИМ ВООРУЖЁННЫМ СИЛАМ. ТО ЕСТЬ
Dialogue: 0,0:02:48.03,0:02:52.11,Caption,,0,0,0,,СПОР ВООБЩЕ НЕ О ТОМ, ИМЕЕТ УКРАИНА ПРАВО БИТЬ ИЛИ НЕ ИМЕЕТ. СПОР
Dialogue: 0,0:02:52.19,0:02:55.07,Caption,,0,0,0,,О ДРУГОМ. ЧТО ИМЕННО ДАЁТ КОНКРЕТНЫЙ УДАР?
Dialogue: 0,0:02:55.27,0:02:57.79,Caption,,0,0,0,,ЕСЛИ ОН НЕ ОСТАНАВЛИВАЕТ ПРОДВИЖЕНИЕ РОССИЙСКИХ
Dialogue: 0,0:02:57.79,0:03:01.07,Caption,,0,0,0,,ВОЙСК, НЕ УЛУЧШАЕТ ПОЛОЖЕНИЕ УКРАИНЫ НА ФРОНТЕ И НЕ
Dialogue: 0,0:03:01.07,0:03:03.23,Caption,,0,0,0,,ДЕЛАЕТ МОСКВУ БОЛЕЕ УСТУПЧИВОЙ ЗА СТОЛОМ
Dialogue: 0,0:03:03.23,0:03:05.87,Caption,,0,0,0,,ПЕРЕГОВОРОВ, ТОГДА ЧЕМ ИЗМЕРЯТЬ ЕГО УСПЕХ?
Dialogue: 0,0:03:06.50,0:03:09.71,Caption,,0,0,0,,И ТУТ СОЮЗНИКИ НАЧАЛИ СПОРИТЬ МЕЖДУ СОБОЙ. БОРИС
Dialogue: 0,0:03:09.71,0:03:12.91,Caption,,0,0,0,,ПИСТОРИУС НАЗВАЛ АМЕРИКАНСКУЮ КРИТИКУ ГЛУПОЙ. ПО ЕГО
Dialogue: 0,0:03:12.91,0:03:16.19,Caption,,0,0,0,,МНЕНИЮ, УКРАИНА ВПРАВЕ АТАКОВАТЬ СТРАТЕГИЧЕСКИЕ ВОЕННЫЕ
Dialogue: 0,0:03:16.19,0:03:20.03,Caption,,0,0,0,,ОБЪЕКТЫ И ИНФРАСТРУКТУРУ, КОТОРАЯ ИСПОЛЬЗУЕТСЯ РОССИЙСКОЙ АРМИЕЙ.
Dialogue: 0,0:03:20.59,0:03:22.67,Caption,,0,0,0,,БРИТАНСКАЯ СТОРОНА ТОЖЕ НЕ СОГЛАСИЛАСЬ С
Dialogue: 0,0:03:22.67,0:03:27.47,Caption,,0,0,0,,ВАШИНГТОНОМ. ТАМ ЗАЯВИЛИ, ЧТО УКРАИНСКИЕ УДАРЫ ОСЛАБЛЯЮТ РОССИЙСКИЙ ВОЕННЫЙ
Dialogue: 0,0:03:27.47,0:03:30.59,Caption,,0,0,0,,ПОТЕНЦИАЛ, ВЫИГРЫВАЮТ ВРЕМЯ И СПАСАЮТ ЖИЗНИ.
Dialogue: 0,0:03:32.78,0:03:35.34,Caption,,0,0,0,,МАРК РЮТТЕ ОТДЕЛЬНО ПОДТВЕРДИЛ ПРАВО УКРАИНЫ
Dialogue: 0,0:03:35.34,0:03:37.98,Caption,,0,0,0,,НАНОСИТЬ УДАРЫ ПО РОССИЙСКИМ ЛОГИСТИЧЕСКИМ ОБЪЕКТАМ,
Dialogue: 0,0:03:38.22,0:03:41.10,Caption,,0,0,0,,ВКЛЮЧАЯ КЕРЧЕНСКИЙ МОСТ. И ПОЛУЧИЛАСЬ ЗАМЕЧАТЕЛЬНАЯ
Dialogue: 0,0:03:41.10,0:03:44.06,Caption,,0,0,0,,КОНСТРУКЦИЯ. АМЕРИКАНЦЫ СПРАШИВАЮТ ЧТО ЭТО ДАЛО?
Dialogue: 0,0:03:44.26,0:03:46.70,Caption,,0,0,0,,НЕМЦЫ ОТВЕЧАЮТ УКРАИНА ИМЕЕТ ПРАВО ЭТО ДЕЛАТЬ.
Dialogue: 0,0:03:47.02,0:03:49.42,Caption,,0,0,0,,БРИТАНЦЫ ГОВОРЯТ НЕ НАДО УКАЗЫВАТЬ КИЕВУ,
Dialogue: 0,0:03:49.61,0:03:52.78,Caption,,0,0,0,,КАК ВЕСТИ БОЕВЫЕ ДЕЙСТВИЯ. НАТО ДОБАВЛЯЕТ ПРАВО НА
Dialogue: 0,0:03:52.86,0:03:55.50,Caption,,0,0,0,,ТАКИЕ УДАРЫ ЕСТЬ. ВРОДЕ ВСЕ ГОВОРЯТ ОБ ОДНОМ
Dialogue: 0,0:03:55.50,0:03:58.54,Caption,,0,0,0,,СОБЫТИИ. А ОТВЕЧАЮТ НА СОВЕРШЕННО РАЗНЫЕ ВОПРОСЫ.
Dialogue: 0,0:03:58.70,0:04:01.98,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО С ОПЛАТОЙ
Dialogue: 0,0:04:02.06,0:04:04.94,Caption,,0,0,0,,ЗДЕСЬ ТОЖЕ ПОЛУЧИЛОСЬ ЗАНЯТНО. КОЛБИ ОДНОВРЕМЕННО
Dialogue: 0,0:04:05.02,0:04:07.82,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО ОСНОВНАЯ ОТВЕТСТВЕННОСТЬ ЗА ФИНАНСИРОВАНИЕ
Dialogue: 0,0:04:07.82,0:04:10.38,Caption,,0,0,0,,АМЕРИКАНСКИХ ПОСТАВОК ОРУЖИЯ УКРАИНЕ ПО ПРОГРАММЕ
Dialogue: 0,0:04:10.38,0:04:13.66,Caption,,0,0,0,,PURL ДОЛЖНА ЛЕЖАТЬ НА ЕВРОПЕ. ТО ЕСТЬ АМЕРИКАНСКОЕ
Dialogue: 0,0:04:13.66,0:04:17.18,Caption,,0,0,0,,ОРУЖИЕ ОСТАЁТСЯ. ПОСТАВКИ ОСТАЮТСЯ. УКРАИНА ОСТАЁТСЯ
Dialogue: 0,0:04:17.18,0:04:19.90,Caption,,0,0,0,,ПОЛУЧАТЕЛЕМ. ТОЛЬКО КОШЕЛЁК ВСЁ ЧАЩЕ ПРЕДЛАГАЕТСЯ
Dialogue: 0,0:04:19.90,0:04:22.86,Caption,,0,0,0,,ОТКРЫТЬ ЕВРОПЕЙЦАМ. И ТЕПЕРЬ КАРТИНА СТАНОВИТСЯ ЕЩЁ
Dialogue: 0,0:04:22.86,0:04:25.50,Caption,,0,0,0,,ВЕСЕЛЕЕ. ЕВРОПЕЙЦЫ СПОРЯТ С АМЕРИКАНЦАМИ И
Dialogue: 0,0:04:25.50,0:04:28.30,Caption,,0,0,0,,ДОКАЗЫВАЮТ ПОЛЕЗНОСТЬ УКРАИНСКИХ ДАЛЬНИХ УДАРОВ. А
Dialogue: 0,0:04:28.30,0:04:32.46,Caption,,0,0,0,,АМЕРИКАНЦЫ В ОТВЕТ СООБЩАЮТ, ЧТО ФИНАНСИРОВАТЬ ДАЛЬНЕЙШУЮ ПОДДЕРЖКУ В БОЛЬШЕЙ
Dialogue: 0,0:04:32.46,0:04:35.66,Caption,,0,0,0,,СТЕПЕНИ ПРИДЁТСЯ САМОЙ ЕВРОПЕ. ПРЕКРАСНОЕ РАЗДЕЛЕНИЕ
Dialogue: 0,0:04:35.74,0:04:38.86,Caption,,0,0,0,,ТРУДА. ОДИН ПРОДАЁТ. ВТОРОЙ ПЛАТИТ. ТРЕТИЙ
Dialogue: 0,0:04:38.94,0:04:40.78,Caption,,0,0,0,,ОБЪЯВЛЯЕТ, ЧТО СОБИРАЕТСЯ ПРОДОЛЖАТЬ.
Dialogue: 0,0:04:43.05,0:04:45.13,Caption,,0,0,0,,И ВСЁ ЭТО ПРОИСХОДИТ НА ФОНЕ ПЕРЕГОВОРОВ О
Dialogue: 0,0:04:45.13,0:04:48.17,Caption,,0,0,0,,ПРЕКРАЩЕНИИ КОНФЛИКТА. ВОТ ЗДЕСЬ ИСТОРИЯ С КРЫМСКИМ
Dialogue: 0,0:04:48.17,0:04:50.81,Caption,,0,0,0,,МОСТОМ СТАНОВИТСЯ УЖЕ НЕ ТОЛЬКО ВОЕННОЙ. КОГДА
Dialogue: 0,0:04:50.81,0:04:52.89,Caption,,0,0,0,,СТОРОНЫ ПОДХОДЯТ К ОБСУЖДЕНИЮ КОНКРЕТНЫХ
Dialogue: 0,0:04:52.89,0:04:56.89,Caption,,0,0,0,,КОМПРОМИССОВ, ЛЮБОЕ КРУПНОЕ ОБОСТРЕНИЕ МГНОВЕННО МЕНЯЕТ ПОВЕСТКУ.
Dialogue: 0,0:04:57.21,0:04:59.05,Caption,,0,0,0,,ВМЕСТО НЕПРИЯТНОГО РАЗГОВОРА О ТОМ,
Dialogue: 0,0:04:59.22,0:05:04.09,Caption,,0,0,0,,КТО ЧЕМ ГОТОВ ПОСТУПИТЬСЯ, НАЧИНАЕТСЯ ДРУГОЙ РАЗГОВОР. КТО ПЕРВЫЙ УДАРИЛ. КТО
Dialogue: 0,0:05:04.09,0:05:07.61,Caption,,0,0,0,,ОТВЕТИЛ. КТО СОРВАЛ ДЕЭСКАЛАЦИЮ. КТО ТЕПЕРЬ ВООБЩЕ
Dialogue: 0,0:05:07.61,0:05:10.65,Caption,,0,0,0,,ИМЕЕТ ПРАВО ТРЕБОВАТЬ УСТУПОК. ПЕРЕГОВОРЫ ПРИ ЭТОМ
Dialogue: 0,0:05:10.65,0:05:13.77,Caption,,0,0,0,,ФОРМАЛЬНО НИКТО НЕ ОТМЕНЯЕТ. ВСЕ ПРОДОЛЖАЮТ ЗАЯВЛЯТЬ
Dialogue: 0,0:05:13.77,0:05:17.05,Caption,,0,0,0,,О ГОТОВНОСТИ К МИРУ. ВСТРЕЧИ ГОТОВЯТСЯ. ПОСРЕДНИКИ
Dialogue: 0,0:05:17.13,0:05:20.25,Caption,,0,0,0,,ЕЗДЯТ. ЗАЯВЛЕНИЯ ЗВУЧАТ. ТОЛЬКО ОКОНЧАТЕЛЬНОЕ
Dialogue: 0,0:05:20.25,0:05:23.61,Caption,,0,0,0,,РЕШЕНИЕ КАЖДЫЙ РАЗ ОТОДВИГАЕТСЯ ЕЩЁ НЕМНОГО. ДЛЯ
Dialogue: 0,0:05:23.61,0:05:26.81,Caption,,0,0,0,,ПОЛИТИКА, КОТОРЫЙ НЕ ХОЧЕТ ПРИНИМАТЬ НЕПРИЯТНОЕ РЕШЕНИЕ ПРЯМО
Dialogue: 0,0:05:26.81,0:05:30.25,Caption,,0,0,0,,СЕЙЧАС, КОНСТРУКЦИЯ ПОЧТИ ИДЕАЛЬНАЯ. ОТ ПЕРЕГОВОРОВ
Dialogue: 0,0:05:30.25,0:05:32.65,Caption,,0,0,0,,ОТКАЗЫВАТЬСЯ НЕ НУЖНО. ДОСТАТОЧНО КАЖДЫЙ РАЗ
Dialogue: 0,0:05:32.65,0:05:36.73,Caption,,0,0,0,,ПОЛУЧАТЬ НОВУЮ ПРИЧИНУ, ПОЧЕМУ ДОГОВАРИВАТЬСЯ ИМЕННО СЕЙЧАС НЕУДОБНО.
Dialogue: 0,0:05:37.05,0:05:39.37,Caption,,0,0,0,,ЗАВЕРШЕНИЕ КОНФЛИКТА ПОЛИТИЧЕСКИ НЕВЫГОДНО
Dialogue: 0,0:05:39.37,0:05:42.33,Caption,,0,0,0,,ЗЕЛЕНСКОМУ. НО ТЕПЕРЬ ВАЖНЕЕ ДРУГОЕ РАСЧЁТ НА
Dialogue: 0,0:05:42.33,0:05:45.29,Caption,,0,0,0,,ОТСРОЧКУ МОЖЕТ БЫТЬ ПРИВЯЗАН К ДВУМ СРОКАМ. ЯНВАРЬ
Dialogue: 0,0:05:45.43,0:05:48.49,Caption,,0,0,0,,И ВЕСНА. С ЯНВАРЁМ РАСЧЁТ ПОНЯТЕН. В КИЕВЕ
Dialogue: 0,0:05:48.49,0:05:50.81,Caption,,0,0,0,,СПОСОБНЫ РАССЧИТЫВАТЬ НА ИЗМЕНЕНИЕ ПОЛИТИЧЕСКОГО
Dialogue: 0,0:05:50.89,0:05:56.93,Caption,,0,0,0,,БАЛАНСА В ВАШИНГТОНЕ. ЕСЛИ АМЕРИКАНСКАЯ ВНУТРЕННЯЯ СИТУАЦИЯ ИЗМЕНИТСЯ,
Dialogue: 0,0:05:57.22,0:05:59.49,Caption,,0,0,0,,ИЗМЕНИТЬСЯ СПОСОБНО И ДАВЛЕНИЕ НА УКРАИНСКОЕ
Dialogue: 0,0:05:59.49,0:06:01.97,Caption,,0,0,0,,РУКОВОДСТВО. ДАЖЕ НЕБОЛЬШАЯ КОРРЕКТИРОВКА
Dialogue: 0,0:06:01.97,0:06:04.69,Caption,,0,0,0,,АМЕРИКАНСКОЙ ПОЗИЦИИ УЖЕ ДАСТ ДОПОЛНИТЕЛЬНОЕ ВРЕМЯ.
Dialogue: 0,0:06:05.09,0:06:07.89,Caption,,0,0,0,,А ИНОГДА В ТАКИХ ИСТОРИЯХ ВРЕМЯ ВАЖНЕЕ НЕМЕДЛЕННОГО
Dialogue: 0,0:06:07.89,0:06:11.01,Caption,,0,0,0,,РЕЗУЛЬТАТА. ВЕСНА ИНТЕРЕСНЕЕ. ЗАКАНЧИВАЕТСЯ
Dialogue: 0,0:06:11.01,0:06:13.65,Caption,,0,0,0,,ОТОПИТЕЛЬНЫЙ СЕЗОН. ЭНЕРГЕТИЧЕСКАЯ ПРОБЛЕМА
Dialogue: 0,0:06:13.73,0:06:15.97,Caption,,0,0,0,,ПЕРЕСТАЁТ ДАВИТЬ НА НАСЕЛЕНИЕ ТАК СИЛЬНО,
Dialogue: 0,0:06:16.13,0:06:19.41,Caption,,0,0,0,,КАК ЗИМОЙ. САМЫЙ ТЯЖЁЛЫЙ ПЕРИОД ПРОЙДЕН. ВЛАСТЬ
Dialogue: 0,0:06:19.41,0:06:22.21,Caption,,0,0,0,,ПОЛУЧАЕТ ЕЩЁ НЕМНОГО ПРОСТРАНСТВА ДЛЯ МАНЁВРА. И
Dialogue: 0,0:06:22.21,0:06:24.77,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ ПРОСТАЯ ПОЛИТИЧЕСКАЯ АРИФМЕТИКА.
Dialogue: 0,0:06:25.00,0:06:28.21,Caption,,0,0,0,,СНАЧАЛА ДОТЯНУТЬ ДО ЯНВАРЯ. ПОТОМ ДОТЯНУТЬ ДО ВЕСНЫ.
Dialogue: 0,0:06:28.45,0:06:31.33,Caption,,0,0,0,,ПОТОМ НАЙДЁТСЯ ЕЩЁ КАКАЯ НИБУДЬ ДАТА. ПЕРЕГОВОРЫ
Dialogue: 0,0:06:31.33,0:06:34.61,Caption,,0,0,0,,ИДУТ. МИР ОБСУЖДАЕТСЯ. ПРОСТО РЕШЕНИЕ ВСЁ ВРЕМЯ ГДЕ
Dialogue: 0,0:06:34.69,0:06:37.49,Caption,,0,0,0,,ТО ВПЕРЕДИ. ТОЛЬКО ДЛЯ СТРАНЫ ЭТИ ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:06:37.49,0:06:40.45,Caption,,0,0,0,,МЕСЯЦЫ ВЫГЛЯДЯТ СОВСЕМ ИНАЧЕ. ЭТО НОВЫЕ РАСХОДЫ.
Dialogue: 0,0:06:40.68,0:06:44.13,Caption,,0,0,0,,НОВЫЕ РАЗРУШЕНИЯ. НОВЫЕ ПОСТАВКИ ОРУЖИЯ. НОВЫЕ
Dialogue: 0,0:06:44.13,0:06:47.57,Caption,,0,0,0,,ПРОСЬБЫ О ФИНАНСИРОВАНИИ. НОВЫЕ УДАРЫ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:06:47.57,0:06:50.93,Caption,,0,0,0,,ВОЗНИКАЕТ ГЛАВНЫЙ РИСК ВСЕЙ КОНСТРУКЦИИ. ЕСЛИ РАСЧЁТ
Dialogue: 0,0:06:50.93,0:06:54.37,Caption,,0,0,0,,СТРОИТСЯ НА ТОМ, ЧТО РОССИЙСКИЙ ОТВЕТ ПОЗВОЛИТ ОБВИНИТЬ МОСКВУ В
Dialogue: 0,0:06:54.37,0:06:56.93,Caption,,0,0,0,,НЕЖЕЛАНИИ ДОГОВАРИВАТЬСЯ, ТО КТО СКАЗАЛ,
Dialogue: 0,0:06:57.14,0:07:00.13,Caption,,0,0,0,,ЧТО ВАШИНГТОН ОБЯЗАТЕЛЬНО ПРИМЕТ ИМЕННО ЭТУ ВЕРСИЮ
Dialogue: 0,0:07:00.13,0:07:03.73,Caption,,0,0,0,,СОБЫТИЙ? ИМЕННО ЗДЕСЬ РАСЧЁТ КИЕВА МОЖЕТ ДАТЬ ОБРАТНЫЙ
Dialogue: 0,0:07:03.81,0:07:09.37,Caption,,0,0,0,,ЭФФЕКТ. МОСКВА СПОСОБНА ПРЕДЪЯВИТЬ ТРАМПУ ХРОНОЛОГИЮ УДАР ПО
Dialogue: 0,0:07:09.37,0:07:11.85,Caption,,0,0,0,,МОСТУ, ОБЕЩАНИЕ НОВЫХ ОПЕРАЦИЙ,
Dialogue: 0,0:07:11.94,0:07:14.73,Caption,,0,0,0,,РОССИЙСКИЙ ОТВЕТ. КИЕВ, В СВОЮ ОЧЕРЕДЬ,
Dialogue: 0,0:07:14.97,0:07:17.45,Caption,,0,0,0,,МОЖЕТ ПОПЫТАТЬСЯ ПРЕДСТАВИТЬ ЭТОТ ОТВЕТ КАК СРЫВ
Dialogue: 0,0:07:17.45,0:07:20.49,Caption,,0,0,0,,ПЕРЕГОВОРОВ. НО ТЕПЕРЬ У ТАКОЙ КОМБИНАЦИИ ПОЯВИЛАСЬ
Dialogue: 0,0:07:20.49,0:07:23.37,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНАЯ ПРОБЛЕМА. КОЛБИ УЖЕ ПУБЛИЧНО
Dialogue: 0,0:07:23.37,0:07:26.09,Caption,,0,0,0,,УСОМНИЛСЯ В ЭФФЕКТИВНОСТИ УКРАИНСКИХ ДАЛЬНИХ УДАРОВ.
Dialogue: 0,0:07:26.30,0:07:29.37,Caption,,0,0,0,,А ЗНАЧИТ, СПОР О ПОСЛЕДСТВИЯХ БУДЕТ ИДТИ С ЛЮДЬМИ,
Dialogue: 0,0:07:29.61,0:07:33.21,Caption,,0,0,0,,ОТ КОТОРЫХ ЗАВИСЯТ ДЕНЬГИ, ОРУЖИЕ И ДАЛЬНЕЙШАЯ ПОДДЕРЖКА.
Dialogue: 0,0:07:33.77,0:07:35.69,Caption,,0,0,0,,ОТДЕЛЬНЫЙ ВОПРОС ЗАКЛЮЧАЕТСЯ В ТОМ,
Dialogue: 0,0:07:35.89,0:07:39.05,Caption,,0,0,0,,КАКИМ ОКАЖЕТСЯ РОССИЙСКИЙ ОТВЕТ. ПОСЛЕ ПОВРЕЖДЕНИЯ
Dialogue: 0,0:07:39.05,0:07:41.69,Caption,,0,0,0,,КРЫМСКОГО МОСТА ОБСУЖДАЮТСЯ УДАРЫ ПО УКРАИНСКОЙ
Dialogue: 0,0:07:41.69,0:07:44.49,Caption,,0,0,0,,ТРАНСПОРТНОЙ И ЭНЕРГЕТИЧЕСКОЙ ИНФРАСТРУКТУРЕ. В
Dialogue: 0,0:07:44.57,0:07:47.45,Caption,,0,0,0,,ЧИСЛЕ ПОТЕНЦИАЛЬНО УЯЗВИМЫХ ОБЪЕКТОВ НАЗЫВАЮТ МОСТЫ
Dialogue: 0,0:07:47.53,0:07:50.01,Caption,,0,0,0,,ЧЕРЕЗ ДНЕПР, ГИДРОЭЛЕКТРОСТАНЦИИ,
Dialogue: 0,0:07:50.25,0:07:53.05,Caption,,0,0,0,,ЖЕЛЕЗНОДОРОЖНЫЕ УЗЛЫ И ДРУГИЕ ВАЖНЫЕ ЭЛЕМЕНТЫ
Dialogue: 0,0:07:53.05,0:07:56.01,Caption,,0,0,0,,ЛОГИСТИКИ. ЭТО НЕ СПИСОК УЖЕ УТВЕРЖДЁННЫХ МОСКВОЙ
Dialogue: 0,0:07:56.01,0:08:00.65,Caption,,0,0,0,,ЦЕЛЕЙ. ЭТО НАПРАВЛЕНИЯ, ВОКРУГ КОТОРЫХ СЕЙЧАС СТРОЯТСЯ ОЖИДАНИЯ ДАЛЬНЕЙШЕГО
Dialogue: 0,0:08:00.65,0:08:03.61,Caption,,0,0,0,,ОБОСТРЕНИЯ. НО ДАЖЕ БЕЗ ЗНАНИЯ КОНКРЕТНЫХ ЦЕЛЕЙ
Dialogue: 0,0:08:03.61,0:08:07.29,Caption,,0,0,0,,ПОНЯТНО ГЛАВНОЕ. КАЖДЫЙ НОВЫЙ РАУНД ПОВЫШАЕТ ЦЕНУ
Dialogue: 0,0:08:07.29,0:08:10.33,Caption,,0,0,0,,СЛЕДУЮЩЕГО. И ИМЕННО ЗДЕСЬ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА
Dialogue: 0,0:08:10.33,0:08:13.69,Caption,,0,0,0,,ПРОБЛЕМА ДЛЯ КИЕВА. ВОЕННЫЙ УСПЕХ ОПЕРАЦИИ И
Dialogue: 0,0:08:13.69,0:08:16.73,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ УСПЕХ ОПЕРАЦИИ НЕ ОБЯЗАНЫ СОВПАДАТЬ.
Dialogue: 0,0:08:17.05,0:08:19.77,Caption,,0,0,0,,МОЖНО ПОВРЕДИТЬ ВАЖНЫЙ ОБЪЕКТ И ПОЛУЧИТЬ КРАСИВУЮ
Dialogue: 0,0:08:19.77,0:08:24.77,Caption,,0,0,0,,КАРТИНКУ. НО ЕСЛИ ПОСЛЕ ЭТОГО ПРОТИВНИК НЕ СТАНОВИТСЯ
Dialogue: 0,0:08:24.77,0:08:28.05,Caption,,0,0,0,,УСТУПЧИВЕЕ, ФРОНТ НЕ МЕНЯЕТСЯ В НУЖНУЮ СТОРОНУ,
Dialogue: 0,0:08:28.21,0:08:30.53,Caption,,0,0,0,,А СОЮЗНИКАМ ПРИХОДИТСЯ ИСКАТЬ ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:08:30.53,0:08:35.57,Caption,,0,0,0,,МИЛЛИАРДЫ НА ПРОДОЛЖЕНИЕ, РЕЗУЛЬТАТ НАЧИНАЕТ ВЫГЛЯДЕТЬ КУДА СЛОЖНЕЕ. ЕСТЬ ЕЩЁ
Dialogue: 0,0:08:35.65,0:08:38.53,Caption,,0,0,0,,ОДИН ЛЮБОПЫТНЫЙ СЛОЙ ЭТОЙ ИСТОРИИ. МИХАИЛ ВИНОГРАДОВ
Dialogue: 0,0:08:38.61,0:08:42.29,Caption,,0,0,0,,ОБРАТИЛ ВНИМАНИЕ, ЧТО ВНУТРИ РОССИЙСКОГО ИНФОРМАЦИОННОГО ПРОСТРАНСТВА
Dialogue: 0,0:08:42.29,0:08:44.85,Caption,,0,0,0,,СЕЙЧАС ОДНОВРЕМЕННО ЖИВУТ ДВЕ СОВЕРШЕННО РАЗНЫЕ
Dialogue: 0,0:08:44.85,0:08:47.89,Caption,,0,0,0,,КАРТИНЫ ПРОИСХОДЯЩЕГО. В ОДНОЙ РОССИЯ ДОБИВАЕТСЯ
Dialogue: 0,0:08:47.89,0:08:50.85,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКИХ УСПЕХОВ, НАТО СПОРИТ О ДЕНЬГАХ,
Dialogue: 0,0:08:51.09,0:08:53.49,Caption,,0,0,0,,ВПЕРЕДИ БОЛЬШАЯ МЕЖДУНАРОДНАЯ СДЕЛКА И ЧУТЬ ЛИ НЕ
Dialogue: 0,0:08:53.49,0:08:56.45,Caption,,0,0,0,,НОВАЯ ЯЛТА. В ДРУГОЙ УДАРЫ ПО МОСТАМ,
Dialogue: 0,0:08:56.69,0:08:58.53,Caption,,0,0,0,,НЕФТЕПЕРЕРАБАТЫВАЮЩИМ ЗАВОДАМ,
Dialogue: 0,0:08:58.69,0:09:01.25,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИЕ ПРОБЛЕМЫ И НОВЫЕ ВНУТРЕННИЕ
Dialogue: 0,0:09:01.33,0:09:04.05,Caption,,0,0,0,,СЛОЖНОСТИ. ПРИЧЁМ СТОРОННИКИ ЭТИХ ДВУХ КАРТИН
Dialogue: 0,0:09:04.05,0:09:06.93,Caption,,0,0,0,,ПРАКТИЧЕСКИ НЕ РАЗГОВАРИВАЮТ ДРУГ С ДРУГОМ. А ОБЩЕЕ
Dialogue: 0,0:09:06.93,0:09:09.57,Caption,,0,0,0,,НАСТРОЕНИЕ ОБЩЕСТВА ПРИ ЭТОМ ОСОБЕННО НЕ МЕНЯЕТСЯ.
Dialogue: 0,0:09:09.97,0:09:12.53,Caption,,0,0,0,,ДЛЯ ОГРОМНОГО КОЛИЧЕСТВА ЛЮДЕЙ ВСЁ ПРОИСХОДЯЩЕЕ УЖЕ
Dialogue: 0,0:09:12.61,0:09:15.73,Caption,,0,0,0,,СТАЛО ПРИВЫЧНЫМ ФОНОМ. И ЭТО ТОЖЕ ВАЖНО. ПОТОМУ
Dialogue: 0,0:09:15.73,0:09:18.29,Caption,,0,0,0,,ЧТО ЕСЛИ ДАЛЬНИЕ УДАРЫ РАССЧИТЫВАЮТСЯ ЕЩЁ И НА
Dialogue: 0,0:09:18.29,0:09:22.69,Caption,,0,0,0,,ПСИХОЛОГИЧЕСКОЕ ДАВЛЕНИЕ, РЕЗУЛЬТАТ ДАЛЕКО НЕ ВСЕГДА ОКАЗЫВАЕТСЯ ТАКИМ,
Dialogue: 0,0:09:22.78,0:09:26.37,Caption,,0,0,0,,КАКИМ ЕГО РИСУЮТ НА ПРЕЗЕНТАЦИИ. К ГРОМКИМ СОБЫТИЯМ
Dialogue: 0,0:09:26.45,0:09:29.97,Caption,,0,0,0,,ЛЮДИ ПРИВЫКАЮТ. К УГРОЗАМ ПРИВЫКАЮТ. К СООБЩЕНИЯМ ОБ
Dialogue: 0,0:09:29.97,0:09:35.84,Caption,,0,0,0,,УДАРАХ ТОЖЕ. И ТОГДА ВОЗНИКАЕТ НЕПРИЯТНЫЙ ВОПРОС СКОЛЬКО ЕЩЁ
Dialogue: 0,0:09:35.84,0:09:39.52,Caption,,0,0,0,,НУЖНО ПОВЫШАТЬ СТАВКИ, ЧТОБЫ ПОЛУЧИТЬ ТОТ ПОЛИТИЧЕСКИЙ ЭФФЕКТ,
Dialogue: 0,0:09:39.76,0:09:41.60,Caption,,0,0,0,,КОТОРОГО НЕ ДАЛ ПРЕДЫДУЩИЙ РАУНД?
Dialogue: 0,0:09:41.98,0:09:44.32,Caption,,0,0,0,,У ЗЕЛЕНСКОГО ЕСТЬ ВОЗМОЖНОСТЬ ОБЪЯВИТЬ ОБ УСПЕХЕ
Dialogue: 0,0:09:44.32,0:09:46.96,Caption,,0,0,0,,ОТДЕЛЬНОГО УДАРА. ЕСТЬ ВОЗМОЖНОСТЬ ПООБЕЩАТЬ
Dialogue: 0,0:09:46.96,0:09:50.08,Caption,,0,0,0,,СЛЕДУЮЩИЕ ОПЕРАЦИИ. ЕСТЬ ДАЖЕ ВОЗМОЖНОСТЬ ЕЩЁ РАЗ
Dialogue: 0,0:09:50.08,0:09:53.04,Caption,,0,0,0,,ОТОДВИНУТЬ НЕПРИЯТНЫЙ РАЗГОВОР О КОМПРОМИССАХ. НО
Dialogue: 0,0:09:53.12,0:09:55.92,Caption,,0,0,0,,ОБЕЩАНИЯ ПРОДОЛЖАТЬ ОБХОДЯТСЯ ЗНАЧИТЕЛЬНО ДЕШЕВЛЕ,
Dialogue: 0,0:09:56.08,0:09:59.20,Caption,,0,0,0,,ЧЕМ САМО ПРОДОЛЖЕНИЕ. И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ РАЗНИЦА
Dialogue: 0,0:09:59.20,0:10:01.60,Caption,,0,0,0,,МЕЖДУ ПОЛИТИКОМ, КОТОРЫЙ ВЫИГРЫВАЕТ ВРЕМЯ,
Dialogue: 0,0:10:01.84,0:10:04.32,Caption,,0,0,0,,И СТРАНОЙ, КОТОРОЙ ПОТОМ ВЫСТАВЛЯЮТ СЧЁТ.
Dialogue: 0,0:10:04.96,0:10:07.52,Caption,,0,0,0,,А САМОЕ НЕПРИЯТНОЕ ДЛЯ БАНКОВОЙ ЗАКЛЮЧАЕТСЯ В ТОМ,
Dialogue: 0,0:10:07.76,0:10:10.16,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ЭТОТ СЧЁТ НАЧАЛИ ОБСУЖДАТЬ НЕ ТОЛЬКО
Dialogue: 0,0:10:10.24,0:10:14.00,Caption,,0,0,0,,ПРОТИВНИКИ, НО И САМИ СОЮЗНИКИ. ПРИЧЁМ ОДНИ УЖЕ СПРАШИВАЮТ,
Dialogue: 0,0:10:14.14,0:10:16.00,Caption,,0,0,0,,ЧТО ПРИНЕСЛА ВЫБРАННАЯ СТРАТЕГИЯ,
Dialogue: 0,0:10:16.32,0:10:18.80,Caption,,0,0,0,,А ДРУГИЕ ГОТОВЯТСЯ ЗА НЕЁ ПЛАТИТЬ. И ЕСЛИ
Dialogue: 0,0:10:18.88,0:10:22.56,Caption,,0,0,0,,ТАКАЯ ИГРА ПРОДОЛЖИТСЯ, КИЕВ РИСКУЕТ ПОЛУЧИТЬ СОВСЕМ НЕ ТО,
Dialogue: 0,0:10:22.66,0:10:26.00,Caption,,0,0,0,,РАДИ ЧЕГО ЗАТЕВАЛСЯ ОЧЕРЕДНОЙ ГРОМКИЙ УСПЕХ. ВРЕМЕНИ
Dialogue: 0,0:10:26.00,0:10:28.16,Caption,,0,0,0,,СТАНЕТ БОЛЬШЕ, РАЗРУШЕНИЙ ТОЖЕ,
Dialogue: 0,0:10:28.48,0:10:31.04,Caption,,0,0,0,,А ВОТ ЖЕЛАЮЩИХ ОПЛАЧИВАТЬ СЛЕДУЮЩИЙ РАУНД ОТ ЭТОГО
Dialogue: 0,0:10:31.12,0:10:32.00,Caption,,0,0,0,,БОЛЬШЕ НЕ СТАНОВИТСЯ.
