Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,В АБУ ДАБИ ЗАВЕРШИЛСЯ ОЧЕРЕДНОЙ РАУНД ПЕРЕГОВОРОВ.
Dialogue: 0,0:00:02.84,0:00:04.92,Caption,,0,0,0,,СТОРОНЫ СОГЛАСОВАЛИ ОБМЕН ПЛЕННЫМИ,
Dialogue: 0,0:00:05.08,0:00:07.08,Caption,,0,0,0,,АМЕРИКАНЦЫ ГОТОВЯТ СЛЕДУЮЩУЮ ВСТРЕЧУ,
Dialogue: 0,0:00:07.40,0:00:10.36,Caption,,0,0,0,,НО ПО ТЕРРИТОРИЯМ И ГАРАНТИЯМ БЕЗОПАСНОСТИ РЕШЕНИЯ
Dialogue: 0,0:00:10.36,0:00:13.48,Caption,,0,0,0,,НЕТ. ПОЭТОМУ ГЛАВНЫЙ ВОПРОС ОСТАЛСЯ ПРЕЖНИМ КАКУЮ
Dialogue: 0,0:00:13.56,0:00:15.96,Caption,,0,0,0,,УКРАИНУ СОБИРАЮТСЯ ПОЛУЧИТЬ ПОСЛЕ СОГЛАШЕНИЯ,
Dialogue: 0,0:00:16.28,0:00:19.00,Caption,,0,0,0,,НЫНЕШНЮЮ СТРАНУ С НОВОЙ ДАТОЙ В КАЛЕНДАРЕ ИЛИ
Dialogue: 0,0:00:19.00,0:00:20.92,Caption,,0,0,0,,ГОСУДАРСТВО С ДРУГИМИ ГРАНИЦАМИ,
Dialogue: 0,0:00:21.00,0:00:24.60,Caption,,0,0,0,,АРМИЕЙ И КУРСОМ? ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ РУКОПОЖАТИЯ У ДВЕРЕЙ,
Dialogue: 0,0:00:24.88,0:00:28.52,Caption,,0,0,0,,А РЕАЛЬНЫЕ УСЛОВИЯ, ПОДПИСЫВАЙТЕСЬ. СЕЙЧАС ПОСМОТРИМ НА ЦИФРЫ,
Dialogue: 0,0:00:28.84,0:00:31.64,Caption,,0,0,0,,РЯДОМ С КОТОРЫМИ ЗАЯВЛЕНИЯ ОБ УСПЕХЕ ЗВУЧАТ СОВСЕМ
Dialogue: 0,0:00:31.72,0:00:34.52,Caption,,0,0,0,,ИНАЧЕ. ПОСЛЕ ПЕРЕГОВОРОВ ЧИНОВНИКИ СНОВА ЗАГОВОРИЛИ
Dialogue: 0,0:00:34.60,0:00:36.52,Caption,,0,0,0,,О ПРОГРЕССЕ. ДИАЛОГ ПРОДОЛЖИТСЯ,
Dialogue: 0,0:00:36.84,0:00:39.24,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПРЕДСТАВИТЕЛИ ОТПРАВЯТСЯ НА СЛЕДУЮЩИЕ
Dialogue: 0,0:00:39.24,0:00:43.40,Caption,,0,0,0,,ВСТРЕЧИ, ОБМЕН ПЛЕННЫМИ СОГЛАСОВАН. ЕСЛИ СОБРАТЬ ОФИЦИАЛЬНЫЕ
Dialogue: 0,0:00:43.40,0:00:45.72,Caption,,0,0,0,,РЕПЛИКИ ВМЕСТЕ, МОЖЕТ ПОКАЗАТЬСЯ,
Dialogue: 0,0:00:45.89,0:00:48.44,Caption,,0,0,0,,ЧТО ДО МИРА ОСТАЛОСЬ УТОЧНИТЬ НЕСКОЛЬКО
Dialogue: 0,0:00:48.44,0:00:51.72,Caption,,0,0,0,,ФОРМАЛЬНОСТЕЙ. НО ОДНА НАЗНАЧЕННАЯ ВСТРЕЧА ЕЩЁ НЕ
Dialogue: 0,0:00:51.72,0:00:54.52,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ГЛАВНЫЕ ПРОТИВОРЕЧИЯ ИСЧЕЗЛИ.
Dialogue: 0,0:00:55.10,0:00:58.28,Caption,,0,0,0,,ПРОВЕРИТЬ РЕЗУЛЬТАТ МОЖНО БЕЗ СЛОЖНЫХ СХЕМ. РОССИЯ
Dialogue: 0,0:00:58.36,0:01:01.24,Caption,,0,0,0,,ОТКАЗАЛАСЬ ОТ ТРЕБОВАНИЙ, С КОТОРЫМИ НАЧИНАЛА КОНФЛИКТ?
Dialogue: 0,0:01:01.54,0:01:04.92,Caption,,0,0,0,,НЕТ. МОСКВА БОЛЬШЕ НЕ НАСТАИВАЕТ НА ДЕМИЛИТАРИЗАЦИИ?
Dialogue: 0,0:01:05.06,0:01:07.48,Caption,,0,0,0,,НАСТАИВАЕТ. ТЕРРИТОРИАЛЬНЫЙ ВОПРОС СНЯТ?
Dialogue: 0,0:01:07.67,0:01:13.03,Caption,,0,0,0,,ТОЖЕ НЕТ. РОССИЙСКУЮ СТОРОНУ УСТРОИЛА УКРАИНА С ПРЕЖНИМ
Dialogue: 0,0:01:13.03,0:01:16.71,Caption,,0,0,0,,КУРСОМ, ОГРОМНОЙ АРМИЕЙ И ЗАПАДНОЙ ВОЕННОЙ ИНФРАСТРУКТУРОЙ?
Dialogue: 0,0:01:17.16,0:01:19.91,Caption,,0,0,0,,НИЧЕГО ПОДОБНОГО НЕ ПРОЗВУЧАЛО. ЛАВРОВ ПОСЛЕ
Dialogue: 0,0:01:19.91,0:01:23.99,Caption,,0,0,0,,ПЕРЕГОВОРОВ ПОВТОРИЛ, ЧТО РОССИЙСКАЯ ПОЗИЦИЯ ПО ПРЕЖНЕМУ ОПРЕДЕЛЯЕТСЯ
Dialogue: 0,0:01:23.99,0:01:26.95,Caption,,0,0,0,,ДОСТИЖЕНИЕМ ЦЕЛЕЙ МОСКВЫ. В АБУ ДАБИ ГОВОРИЛИ О
Dialogue: 0,0:01:26.95,0:01:29.19,Caption,,0,0,0,,БУДУЩЕЙ СИСТЕМЕ БЕЗОПАСНОСТИ В ЕВРОПЕ,
Dialogue: 0,0:01:29.43,0:01:32.23,Caption,,0,0,0,,ОДНАКО ПУБЛИЧНОГО СОГЛАСИЯ ПО ГЛАВНЫМ ВОПРОСАМ,
Dialogue: 0,0:01:32.38,0:01:37.11,Caption,,0,0,0,,ОСОБЕННО ПО ТЕРРИТОРИЯМ, СТОРОНЫ НЕ ПОКАЗАЛИ. ПОЭТОМУ КОЛИЧЕСТВО ДОБРЫХ СЛОВ
Dialogue: 0,0:01:37.19,0:01:40.47,Caption,,0,0,0,,МАЛО ЧТО СООБЩАЕТ. СМОТРЕТЬ НУЖНО НА УСЛОВИЯ СТАЛИ
Dialogue: 0,0:01:40.55,0:01:43.75,Caption,,0,0,0,,ОНИ СОВМЕСТИМЫМИ ИЛИ КАЖДАЯ СТОРОНА ПО ПРЕЖНЕМУ
Dialogue: 0,0:01:43.75,0:01:47.83,Caption,,0,0,0,,ТРЕБУЕТ СВОЕГО? НАЧНЁМ С ТЕРРИТОРИЙ. БРИТАНСКАЯ ПРЕССА РАССКАЗАЛА О
Dialogue: 0,0:01:47.83,0:01:50.47,Caption,,0,0,0,,ПРЕДЛОЖЕНИИ ИЗМЕНИТЬ АДМИНИСТРАТИВНЫЕ ГРАНИЦЫ
Dialogue: 0,0:01:50.47,0:01:53.67,Caption,,0,0,0,,ДОНЕЦКОЙ И ЛУГАНСКОЙ ОБЛАСТЕЙ. РОССИЯ В ТАКОМ СЛУЧАЕ
Dialogue: 0,0:01:53.67,0:01:57.51,Caption,,0,0,0,,СМОЖЕТ ЗАЯВИТЬ, ЧТО ПОЛУЧИЛА КОНТРОЛЬ НАД НЕОБХОДИМЫМИ ТЕРРИТОРИЯМИ,
Dialogue: 0,0:01:57.73,0:02:00.79,Caption,,0,0,0,,А УКРАИНА ФОРМАЛЬНО НИЧЕГО НЕ УСТУПИТ. ЗЕМЛЮ НЕ
Dialogue: 0,0:02:00.79,0:02:04.63,Caption,,0,0,0,,ПОДЕЛИЛИ, ЗАТО ЛИНИЮ НА КАРТЕ ПЕРЕДВИНУЛИ. МОЖНО РАСХОДИТЬСЯ.
Dialogue: 0,0:02:04.92,0:02:08.07,Caption,,0,0,0,,ГОРОДА НИКУДА НЕ УЕХАЛИ. НАСЕЛЕНИЕ ОСТАЛОСЬ ТАМ ЖЕ.
Dialogue: 0,0:02:08.39,0:02:11.59,Caption,,0,0,0,,ТРЕБОВАНИЯ СТОРОН НЕ ИЗМЕНИЛИСЬ. ПОМЕНЯЛАСЬ ТОЛЬКО
Dialogue: 0,0:02:11.59,0:02:15.75,Caption,,0,0,0,,АДМИНИСТРАТИВНАЯ ЧЕРТА, ПОСЛЕ ЧЕГО ВСЕМ ПРЕДЛАГАЮТ СЧИТАТЬ ПРЕЖНИЙ СПОР
Dialogue: 0,0:02:15.75,0:02:19.11,Caption,,0,0,0,,РЕШЁННЫМ. КОГО СОБИРАЮТСЯ УБЕДИТЬ ЭТИМ ПРИЁМОМ?
Dialogue: 0,0:02:19.50,0:02:21.75,Caption,,0,0,0,,ДЛЯ МОСКВЫ СТАТУС ЭТИХ ТЕРРИТОРИЙ ДАВНО НЕ
Dialogue: 0,0:02:21.75,0:02:24.15,Caption,,0,0,0,,ОГРАНИЧИВАЕТСЯ ВНУТРЕННИМ ДЕЛЕНИЕМ УКРАИНЫ.
Dialogue: 0,0:02:26.43,0:02:28.99,Caption,,0,0,0,,РОССИЯ ВКЛЮЧИЛА ДОНЕЦКУЮ И ЛУГАНСКУЮ НАРОДНЫЕ
Dialogue: 0,0:02:29.07,0:02:32.11,Caption,,0,0,0,,РЕСПУБЛИКИ В СОСТАВ ФЕДЕРАЦИИ И ВЫСТРОИЛА ВОКРУГ
Dialogue: 0,0:02:32.11,0:02:35.07,Caption,,0,0,0,,ЭТОГО СОБСТВЕННУЮ ПРАВОВУЮ ПОЗИЦИЮ. КИЕВ ЕЁ
Dialogue: 0,0:02:35.07,0:02:38.03,Caption,,0,0,0,,ОТВЕРГАЕТ. ЕСЛИ УКРАИНСКИЕ ВЛАСТИ ПЕРЕКРОЯТ
Dialogue: 0,0:02:38.03,0:02:42.83,Caption,,0,0,0,,АДМИНИСТРАТИВНУЮ СЕТКУ, РОССИЙСКАЯ ТРАКТОВКА ОТ ЭТОГО НЕ ИСЧЕЗНЕТ. У КИЕВА
Dialogue: 0,0:02:42.83,0:02:45.55,Caption,,0,0,0,,ВОЗНИКАЕТ ОБРАТНАЯ ПРОБЛЕМА. ПОСЛЕ ПЕРЕНОСА
Dialogue: 0,0:02:45.55,0:02:48.11,Caption,,0,0,0,,ОБЛАСТНОЙ ГРАНИЦЫ ОН ПЕРЕСТАНЕТ СЧИТАТЬ СПОРНУЮ
Dialogue: 0,0:02:48.11,0:02:52.99,Caption,,0,0,0,,ЗЕМЛЮ УКРАИНСКОЙ? ЕСЛИ НЕТ, ТО РЕЗУЛЬТАТ ВСЕЙ ОПЕРАЦИИ ОСТАНЕТСЯ НА ОДНОМ ЛИСТЕ
Dialogue: 0,0:02:52.99,0:02:56.27,Caption,,0,0,0,,БУМАГИ. ЧЕРНИЛА ПОТРАТИЛИ, СПОР СОХРАНИЛИ.
Dialogue: 0,0:02:56.83,0:02:59.63,Caption,,0,0,0,,С ТАКИМ ПОДХОДОМ МОЖНО ПЕРЕИМЕНОВАТЬ СПОРНЫЕ РАЙОНЫ
Dialogue: 0,0:02:59.71,0:03:03.47,Caption,,0,0,0,,И НАУТРО СООБЩИТЬ, ЧТО ВЧЕРАШНИЕ ПРЕТЕНЗИИ ОТНОСИЛИСЬ К ОБЪЕКТАМ,
Dialogue: 0,0:03:03.63,0:03:07.39,Caption,,0,0,0,,КОТОРЫХ ТЕПЕРЬ НЕТ. ДЛЯ ТАКОГО МИРОТВОРЧЕСТВА ДАЖЕ БОЛЬШОЙ СТОЛ
Dialogue: 0,0:03:07.39,0:03:11.55,Caption,,0,0,0,,ПЕРЕГОВОРОВ НЕ НУЖЕН, ДОСТАТОЧНО КАБИНЕТА С ПРИНТЕРОМ. ОДНАКО КИЕВ,
Dialogue: 0,0:03:11.71,0:03:15.79,Caption,,0,0,0,,СУДЯ ПО ПУБЛИКАЦИЯМ, ЭТОТ ВАРИАНТ УЖЕ ОТКЛОНИЛ. ЗЕЛЕНСКИЙ ГОВОРИЛ,
Dialogue: 0,0:03:15.98,0:03:19.07,Caption,,0,0,0,,ЧТО АМЕРИКАНЦЫ ПОСТОЯННО ВОЗВРАЩАЮТСЯ К ДОНБАССУ И
Dialogue: 0,0:03:19.15,0:03:23.23,Caption,,0,0,0,,ВЫВОДУ УКРАИНСКИХ ВОЙСК. РОССИЯ ПРОДОЛЖАЕТ ВЫДВИГАТЬ ТЕРРИТОРИАЛЬНЫЕ
Dialogue: 0,0:03:23.23,0:03:26.51,Caption,,0,0,0,,ТРЕБОВАНИЯ. НОВАЯ ЛИНИЯ НА КАРТЕ НЕ УСТРАНИЛА НИ
Dialogue: 0,0:03:26.51,0:03:29.71,Caption,,0,0,0,,ОДНОГО ПРОТИВОРЕЧИЯ. СНОВА СВЕРЯЕМ УСЛЫШАННОЕ С
Dialogue: 0,0:03:29.71,0:03:32.11,Caption,,0,0,0,,РОССИЙСКИМИ ЦЕЛЯМИ. МОСКВА ЗАЯВЛЯЕТ,
Dialogue: 0,0:03:32.28,0:03:34.43,Caption,,0,0,0,,ЧТО ОНИ ОСТАЮТСЯ ПРЕЖНИМИ. ЗНАЧИТ,
Dialogue: 0,0:03:34.61,0:03:36.99,Caption,,0,0,0,,УЛЫБКИ В КОРИДОРЕ МОЖНО ОСТАВИТЬ ФОТОГРАФАМ,
Dialogue: 0,0:03:37.19,0:03:40.03,Caption,,0,0,0,,А НАМ НУЖНЫ КОНКРЕТНЫЕ ПАРАМЕТРЫ БУДУЩЕЙ УКРАИНЫ.
Dialogue: 0,0:03:42.32,0:03:44.88,Caption,,0,0,0,,И ТЕРРИТОРИЯ ЗДЕСЬ ДАЖЕ НЕ САМЫЙ ПОКАЗАТЕЛЬНЫЙ
Dialogue: 0,0:03:44.96,0:03:48.48,Caption,,0,0,0,,ПУНКТ. КУДА ИНТЕРЕСНЕЕ БУДУЩАЯ АРМИЯ. УКРАИНСКАЯ
Dialogue: 0,0:03:48.56,0:03:51.12,Caption,,0,0,0,,СТОРОНА ХОЧЕТ ПОСЛЕ ЗАВЕРШЕНИЯ КОНФЛИКТА СОХРАНИТЬ
Dialogue: 0,0:03:51.12,0:03:53.84,Caption,,0,0,0,,ВООРУЖЁННЫЕ СИЛЫ ЧИСЛЕННОСТЬЮ ВОСЕМЬСОТ ТЫСЯЧ
Dialogue: 0,0:03:53.84,0:03:57.28,Caption,,0,0,0,,ЧЕЛОВЕК. ЗАПАД ДОЛЖЕН ОПЛАЧИВАТЬ ИХ СОДЕРЖАНИЕ КАК
Dialogue: 0,0:03:57.36,0:04:00.48,Caption,,0,0,0,,МИНИМУМ ДЕСЯТЬ ЛЕТ. ИМЕННО ТАКИЕ ПАРАМЕТРЫ КИЕВ
Dialogue: 0,0:04:00.56,0:04:02.64,Caption,,0,0,0,,ПЕРЕДАЛ ЧЕРЕЗ АГЕНТСТВО ФРАНС ПРЕСС ВО ВРЕМЯ
Dialogue: 0,0:04:02.64,0:04:06.00,Caption,,0,0,0,,НЫНЕШНЕГО РАУНДА. ВОСЕМЬСОТ ТЫСЯЧ ВОЕННОСЛУЖАЩИХ
Dialogue: 0,0:04:06.00,0:04:09.12,Caption,,0,0,0,,ПОСЛЕ ВОЙНЫ. ЗАПАДНОЕ ФИНАНСИРОВАНИЕ НА ЦЕЛОЕ
Dialogue: 0,0:04:09.12,0:04:12.72,Caption,,0,0,0,,ДЕСЯТИЛЕТИЕ. ТЕПЕРЬ ВСПОМИНАЕМ СТАМБУЛЬСКИЙ ПРОЕКТ ДВАДЦАТЬ
Dialogue: 0,0:04:12.72,0:04:15.52,Caption,,0,0,0,,ВТОРОГО ГОДА. ТОГДА РОССИЯ ПРЕДЛАГАЛА ОГРАНИЧИТЬ
Dialogue: 0,0:04:15.52,0:04:18.08,Caption,,0,0,0,,УКРАИНСКУЮ АРМИЮ ВОСЕМЬЮДЕСЯТЬЮ ПЯТЬЮ ТЫСЯЧАМИ
Dialogue: 0,0:04:18.08,0:04:21.28,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. В ПЕРЕЧНЕ ТАКЖЕ ФИГУРИРОВАЛИ ТРИСТА
Dialogue: 0,0:04:21.36,0:04:24.72,Caption,,0,0,0,,СОРОК ДВА ТАНКА, ПЯТЬСОТ ДЕВЯТНАДЦАТЬ АРТИЛЛЕРИЙСКИХ ОРУДИЙ,
Dialogue: 0,0:04:24.90,0:04:28.00,Caption,,0,0,0,,ПРЕДЕЛ ДЛЯ ДАЛЬНОСТИ РАКЕТ И ЗАПРЕТ НА ИНОСТРАННОЕ
Dialogue: 0,0:04:28.00,0:04:30.80,Caption,,0,0,0,,ВООРУЖЕНИЕ. УКРАИНА ДОБИВАЛАСЬ БОЛЕЕ ВЫСОКИХ
Dialogue: 0,0:04:30.80,0:04:34.72,Caption,,0,0,0,,ПОКАЗАТЕЛЕЙ, А МОСКВА ТРЕБОВАЛА СЕРЬЁЗНО УМЕНЬШИТЬ ЕЁ ВОЕННЫЕ
Dialogue: 0,0:04:34.72,0:04:37.52,Caption,,0,0,0,,ВОЗМОЖНОСТИ. ТОГДА РЕЧЬ ШЛА О ВОСЬМИДЕСЯТИ ПЯТИ
Dialogue: 0,0:04:37.52,0:04:40.24,Caption,,0,0,0,,ТЫСЯЧАХ ЧЕЛОВЕК. СЕГОДНЯ КИЕВ ПРОСИТ ОСТАВИТЬ
Dialogue: 0,0:04:40.30,0:04:43.52,Caption,,0,0,0,,ВОСЕМЬСОТ ТЫСЯЧ. РАЗНИЦА ПОЧТИ В ДЕВЯТЬ С ПОЛОВИНОЙ
Dialogue: 0,0:04:43.52,0:04:46.96,Caption,,0,0,0,,РАЗ. НЕПЛОХОЕ СБЛИЖЕНИЕ ПОЗИЦИЙ. ЕЩЁ НЕСКОЛЬКО ТАКИХ
Dialogue: 0,0:04:47.04,0:04:50.64,Caption,,0,0,0,,ШАГОВ НАВСТРЕЧУ, И СТОРОНЫ БУДУТ РАЗГОВАРИВАТЬ ИЗ РАЗНЫХ ЧАСОВЫХ
Dialogue: 0,0:04:50.64,0:04:53.20,Caption,,0,0,0,,ПОЯСОВ. ГЛАВНЫЙ ВОПРОС ПРОСТ МОСКВА НА ЭТО
Dialogue: 0,0:04:53.20,0:04:58.83,Caption,,0,0,0,,СОГЛАСИЛАСЬ? ЕСЛИ ДЕМИЛИТАРИЗАЦИЯ ОСТАЁТСЯ ОДНОЙ ИЗ РОССИЙСКИХ
Dialogue: 0,0:04:58.83,0:05:02.35,Caption,,0,0,0,,ЦЕЛЕЙ, АРМИЯ ИЗ ВОСЬМИСОТ ТЫСЯЧ ЧЕЛОВЕК НА ЗАПАДНОМ
Dialogue: 0,0:05:02.35,0:05:05.63,Caption,,0,0,0,,СОДЕРЖАНИИ ЯВНО ЕЙ ПРОТИВОРЕЧИТ. В ДВАДЦАТЬ ВТОРОМ
Dialogue: 0,0:05:05.63,0:05:08.35,Caption,,0,0,0,,ГОДУ РОССИЯ ПРЕДЛАГАЛА ОСТАВИТЬ ПОЧТИ В ДЕСЯТЬ РАЗ
Dialogue: 0,0:05:08.43,0:05:11.55,Caption,,0,0,0,,МЕНЬШЕ ВОЕННЫХ. ТЕПЕРЬ ЕЙ ПОКАЗЫВАЮТ МНОГОКРАТНО
Dialogue: 0,0:05:11.55,0:05:13.87,Caption,,0,0,0,,УВЕЛИЧЕННЫЙ ВАРИАНТ И ЖДУТ ОДОБРЕНИЯ.
Dialogue: 0,0:05:14.43,0:05:16.75,Caption,,0,0,0,,ЭТО НЕ СПОР О НЕСКОЛЬКИХ БАТАЛЬОНАХ И НЕ
Dialogue: 0,0:05:16.75,0:05:19.95,Caption,,0,0,0,,РАСХОЖДЕНИЕ В ТАБЛИЦЕ. ПЕРЕД НАМИ ДВЕ НЕСОВМЕСТИМЫЕ
Dialogue: 0,0:05:19.95,0:05:22.83,Caption,,0,0,0,,ВЕРСИИ ПОСЛЕВОЕННОЙ УКРАИНЫ. В ПЕРВОЙ УКРАИНСКИЕ
Dialogue: 0,0:05:22.83,0:05:25.87,Caption,,0,0,0,,ВООРУЖЁННЫЕ СИЛЫ ЖЁСТКО ОГРАНИЧЕНЫ И НЕ МОГУТ
Dialogue: 0,0:05:25.87,0:05:28.91,Caption,,0,0,0,,ПРЕДСТАВЛЯТЬ ПРЕЖНЮЮ УГРОЗУ ДЛЯ РОССИИ. ВО ВТОРОЙ
Dialogue: 0,0:05:28.91,0:05:31.31,Caption,,0,0,0,,ОСТАЁТСЯ ОДНА ИЗ КРУПНЕЙШИХ АРМИЙ ЕВРОПЫ,
Dialogue: 0,0:05:31.59,0:05:34.51,Caption,,0,0,0,,А ЗАРУБЕЖНЫЕ ПАРТНЁРЫ ЕЩЁ ДЕСЯТЬ ЛЕТ ОПЛАЧИВАЮТ ЕЁ
Dialogue: 0,0:05:34.59,0:05:37.47,Caption,,0,0,0,,СОДЕРЖАНИЕ. ЗАКРЫТЬ ЭТУ ПРОПАСТЬ СЛОВОМ "ГАРАНТИИ"
Dialogue: 0,0:05:37.47,0:05:39.71,Caption,,0,0,0,,НЕ ПОЛУЧИТСЯ. СНАЧАЛА НАДО ОТВЕТИТЬ,
Dialogue: 0,0:05:39.95,0:05:43.15,Caption,,0,0,0,,КОМУ ИМЕННО ИХ ПРЕДОСТАВЛЯЮТ. УКРАИНЕ В КАКИХ
Dialogue: 0,0:05:43.15,0:05:46.19,Caption,,0,0,0,,ГРАНИЦАХ? С КАКОЙ ВЛАСТЬЮ? С КАКИМ ВОЕННЫМ ПОТЕНЦИАЛОМ?
Dialogue: 0,0:05:46.27,0:05:50.03,Caption,,0,0,0,,С КАКИМ ВНЕШНИМ КУРСОМ? С ПРЕЖНИМ ОТНОШЕНИЕМ К РОССИИ ИЛИ С НОВЫМ?
Dialogue: 0,0:05:50.71,0:05:52.51,Caption,,0,0,0,,БЕЗ ЭТИХ ОТВЕТОВ НЕВОЗМОЖНО ПОНЯТЬ,
Dialogue: 0,0:05:52.75,0:05:55.31,Caption,,0,0,0,,ЧТО ИМЕННО СТОРОНЫ СОБИРАЮТСЯ ГАРАНТИРОВАТЬ.
Dialogue: 0,0:05:55.86,0:05:58.75,Caption,,0,0,0,,БЕЗОПАСНОСТЬ СТРАНЫ И СОХРАНЕНИЕ НЫНЕШНЕЙ СИСТЕМЫ
Dialogue: 0,0:05:58.75,0:06:01.15,Caption,,0,0,0,,ВЛАСТИ, НЕ ОДНО И ТО ЖЕ. ПРЕДСТАВИМ,
Dialogue: 0,0:06:01.39,0:06:04.27,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ УХОДИТ И ПРЕЗИДЕНТСКОЕ КРЕСЛО ЗАНИМАЕТ
Dialogue: 0,0:06:04.35,0:06:07.55,Caption,,0,0,0,,ДРУГОЙ ЧЕЛОВЕК. У НЕГО НОВАЯ ФАМИЛИЯ И СОБСТВЕННАЯ
Dialogue: 0,0:06:07.55,0:06:13.99,Caption,,0,0,0,,МАНЕРА СМОТРЕТЬ В КАМЕРУ. ПРИ ЭТОМ АНТИРОССИЙСКИЙ КУРС ОСТАЁТСЯ. ВОЕННАЯ
Dialogue: 0,0:06:13.99,0:06:16.79,Caption,,0,0,0,,ПОЛИТИКА НЕ МЕНЯЕТСЯ. ЗАПАДНАЯ ИНФРАСТРУКТУРА
Dialogue: 0,0:06:16.79,0:06:20.15,Caption,,0,0,0,,СОХРАНЯЕТСЯ. АРМИЯ НАСЧИТЫВАЕТ ТЕ ЖЕ ВОСЕМЬСОТ ТЫСЯЧ
Dialogue: 0,0:06:20.23,0:06:23.43,Caption,,0,0,0,,ЧЕЛОВЕК. ОТНОШЕНИЕ К ЯЗЫКУ И ИСТОРИИ ОСТАЁТСЯ
Dialogue: 0,0:06:23.51,0:06:26.15,Caption,,0,0,0,,ПРЕЖНИМ. ДЛЯ МОСКВЫ КАКАЯ ЗДЕСЬ ПРИНЦИПИАЛЬНАЯ
Dialogue: 0,0:06:26.15,0:06:29.51,Caption,,0,0,0,,ПЕРЕМЕНА? НИКАКОЙ. ПОРТРЕТ В КАБИНЕТЕ ЗАМЕНИЛИ,
Dialogue: 0,0:06:29.74,0:06:32.87,Caption,,0,0,0,,А РЕШЕНИЯ ПРИНИМАЮТСЯ ПО СТАРЫМ ПРАВИЛАМ. ПОЭТОМУ
Dialogue: 0,0:06:32.87,0:06:35.83,Caption,,0,0,0,,ДЕНАЦИФИКАЦИЯ В РОССИЙСКОМ ПОНИМАНИИ НЕ МОЖЕТ
Dialogue: 0,0:06:35.83,0:06:37.91,Caption,,0,0,0,,СВОДИТЬСЯ К ЛИЧНОЙ СУДЬБЕ ЗЕЛЕНСКОГО.
Dialogue: 0,0:06:38.47,0:06:41.67,Caption,,0,0,0,,РЕЧЬ ИДЁТ О ПОЛНОЙ СМЕНЕ ДЕЙСТВУЮЩЕЙ МОДЕЛИ ВЛАСТИ.
Dialogue: 0,0:06:42.12,0:06:45.11,Caption,,0,0,0,,ДРУГОЙ ПРЕЗИДЕНТ ПРИ ПРЕЖНЕМ АНТИРОССИЙСКОМ КУРСЕ
Dialogue: 0,0:06:45.31,0:06:48.63,Caption,,0,0,0,,НИЧЕГО ДЛЯ МОСКВЫ НЕ РЕШАЕТ. ЕЙ НУЖНЫ ИНАЯ
Dialogue: 0,0:06:48.63,0:06:51.19,Caption,,0,0,0,,ВЛАСТЬ, ДРУГАЯ НАПРАВЛЕННОСТЬ ГОСУДАРСТВА,
Dialogue: 0,0:06:51.43,0:06:55.11,Caption,,0,0,0,,НОВОЕ ОТНОШЕНИЕ К РОССИИ И РАДИКАЛЬНО СОКРАЩЁННЫЕ
Dialogue: 0,0:06:55.11,0:06:58.31,Caption,,0,0,0,,ВООРУЖЁННЫЕ СИЛЫ. ЛИШЬ ПОСЛЕ ПОЯВЛЕНИЯ ТАКОЙ УКРАИНЫ
Dialogue: 0,0:06:58.39,0:07:02.31,Caption,,0,0,0,,СТАНЕТ ПОНЯТНО, О ЧЬЕЙ БЕЗОПАСНОСТИ И НА КАКИХ УСЛОВИЯХ МОЖНО
Dialogue: 0,0:07:02.31,0:07:04.07,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ. ПОДПИСЫВАЙТЕСЬ,
Dialogue: 0,0:07:04.23,0:07:07.91,Caption,,0,0,0,,ЕСЛИ ЕЩЁ ЭТОГО НЕ СДЕЛАЛИ. ЦЕНТРАЛЬНЫЙ ВОПРОС УЖЕ НЕ В ТОМ,
Dialogue: 0,0:07:08.07,0:07:11.27,Caption,,0,0,0,,КТО БУДЕТ ДЕРЖАТЬ РУЧКУ НА ЦЕРЕМОНИИ. ВАЖНЕЕ,
Dialogue: 0,0:07:11.51,0:07:14.63,Caption,,0,0,0,,КАКОЕ ГОСУДАРСТВО ПОДПИШЕТ СОГЛАШЕНИЕ И БУДЕТ ЕГО
Dialogue: 0,0:07:14.63,0:07:18.87,Caption,,0,0,0,,ВЫПОЛНЯТЬ. У ВОСЬМИСОТТЫСЯЧНОЙ АРМИИ ЕСТЬ ЕЩЁ ОДНА СТОРОНА,
Dialogue: 0,0:07:19.11,0:07:22.07,Caption,,0,0,0,,КОТОРУЮ КРАСИВЫМИ ФОРМУЛИРОВКАМИ НЕ ПРИКРОЕШЬ. ДЛЯ
Dialogue: 0,0:07:22.15,0:07:24.71,Caption,,0,0,0,,НЕЁ НУЖНЫ ЛЮДИ. ПРИЧЁМ НЕ НА МЕСЯЦ И
Dialogue: 0,0:07:24.71,0:07:27.43,Caption,,0,0,0,,НЕ ДО СЛЕДУЮЩЕГО САММИТА, А НА ДЕСЯТЬ ЛЕТ.
Dialogue: 0,0:07:29.71,0:07:32.27,Caption,,0,0,0,,ТАКУЮ ЧИСЛЕННОСТЬ ПРИДЁТСЯ ПОСТОЯННО ПОДДЕРЖИВАТЬ.
Dialogue: 0,0:07:32.42,0:07:34.99,Caption,,0,0,0,,ПОНАДОБЯТСЯ КОНТРАКТНИКИ, РЕЗЕРВИСТЫ,
Dialogue: 0,0:07:35.07,0:07:40.03,Caption,,0,0,0,,МОБИЛИЗАЦИОННЫЙ МЕХАНИЗМ, РОТАЦИИ И ОГРАНИЧЕНИЯ. ДЕТАЛИ ЕЩЁ МОГУТ МЕНЯТЬСЯ,
Dialogue: 0,0:07:40.35,0:07:43.71,Caption,,0,0,0,,НО ВОСЕМЬСОТ ТЫСЯЧ ВОЕННОСЛУЖАЩИХ ИЗ ПРЕСС РЕЛИЗА НЕ
Dialogue: 0,0:07:43.79,0:07:47.95,Caption,,0,0,0,,ПОЯВЯТСЯ. ОБЫЧНОГО УКРАИНЦА ЗАИНТЕРЕСУЕТ БОЛЕЕ ПРИЗЕМЛЁННАЯ
Dialogue: 0,0:07:48.03,0:07:50.75,Caption,,0,0,0,,ВЕЩЬ ПОСЛЕ ОКОНЧАНИЯ КОНФЛИКТА ЕМУ РАЗРЕШАТ СВОБОДНО
Dialogue: 0,0:07:50.75,0:07:54.59,Caption,,0,0,0,,ВЫЕХАТЬ ИЗ СТРАНЫ? ЧЕЛОВЕК НЕСКОЛЬКО ЛЕТ ПРОЖИЛ ПРИ МОБИЛИЗАЦИИ И
Dialogue: 0,0:07:54.59,0:07:57.79,Caption,,0,0,0,,ЗАКРЫТОЙ ГРАНИЦЕ. РАССУЖДЕНИЯ О ЕВРОПЕЙСКОЙ СИСТЕМЕ
Dialogue: 0,0:07:57.79,0:07:59.79,Caption,,0,0,0,,БЕЗОПАСНОСТИ МОГУТ ЗВУЧАТЬ СОЛИДНО,
Dialogue: 0,0:08:00.19,0:08:02.99,Caption,,0,0,0,,НО ЕМУ НУЖНО ЗНАТЬ ДРУГОЕ. СМОЖЕТ ОН ПОЛОЖИТЬ
Dialogue: 0,0:08:02.99,0:08:06.75,Caption,,0,0,0,,ВЕЩИ В БАГАЖНИК, ПРОЙТИ ПОГРАНИЧНЫЙ КОНТРОЛЬ И УЕХАТЬ БЕЗ РИСКА
Dialogue: 0,0:08:06.83,0:08:11.15,Caption,,0,0,0,,ПОЛУЧИТЬ ПОВЕСТКУ? ВОЗНИКАЕТ СТРАННАЯ ПОСЛЕВОЕННАЯ КАРТИНА. БОЕВЫЕ
Dialogue: 0,0:08:11.15,0:08:15.23,Caption,,0,0,0,,ДЕЙСТВИЯ ЗАКОНЧИЛИСЬ, А СТРАНА ЕЩЁ ДЕСЯТИЛЕТИЕ ЖИВЁТ С АРМИЕЙ ПОЧТИ
Dialogue: 0,0:08:15.31,0:08:17.79,Caption,,0,0,0,,В МИЛЛИОН ЧЕЛОВЕК. ФОРМАЛЬНО НАСТУПИЛ МИР,
Dialogue: 0,0:08:18.11,0:08:20.59,Caption,,0,0,0,,НО ПОРЯДОК КОМПЛЕКТОВАНИЯ ВООРУЖЁННЫХ СИЛ И
Dialogue: 0,0:08:20.59,0:08:23.63,Caption,,0,0,0,,СВЯЗАННЫЕ С НИМ ОГРАНИЧЕНИЯ МОГУТ СОХРАНИТЬСЯ. КТО
Dialogue: 0,0:08:23.63,0:08:28.27,Caption,,0,0,0,,ОПЛАТИТ ТАКУЮ СИСТЕМУ, КИЕВ ТОЖЕ СООБЩИЛ. ДЕНЬГИ ОЖИДАЮТСЯ ОТ ЗАПАДНЫХ
Dialogue: 0,0:08:28.35,0:08:30.99,Caption,,0,0,0,,ПАРТНЁРОВ МИНИМУМ ДЕСЯТЬ ЛЕТ. СЛЕДОВАТЕЛЬНО,
Dialogue: 0,0:08:31.16,0:08:33.63,Caption,,0,0,0,,ПОСЛЕ ЗАВЕРШЕНИЯ КОНФЛИКТА УКРАИНСКАЯ АРМИЯ
Dialogue: 0,0:08:33.63,0:08:36.67,Caption,,0,0,0,,ПРОДОЛЖИТ ЗАВИСЕТЬ ОТ ВНЕШНЕГО ФИНАНСИРОВАНИЯ. ЭТО
Dialogue: 0,0:08:36.67,0:08:39.63,Caption,,0,0,0,,НАМНОГО БОЛЬШЕ, ЧЕМ СТРАХОВКА НА СЛУЧАЙ НОВОЙ ВОЙНЫ.
Dialogue: 0,0:08:41.84,0:08:44.72,Caption,,0,0,0,,ЗАПАДУ ПРЕДЛАГАЮТ ВЗЯТЬ НА СОДЕРЖАНИЕ ОДНУ ИЗ САМЫХ
Dialogue: 0,0:08:44.72,0:08:47.52,Caption,,0,0,0,,МНОГОЧИСЛЕННЫХ АРМИЙ ЕВРОПЫ И ОПЛАЧИВАТЬ ЕЁ ДО
Dialogue: 0,0:08:47.52,0:08:50.56,Caption,,0,0,0,,СЕРЕДИНЫ СЛЕДУЮЩЕГО ДЕСЯТИЛЕТИЯ. РОССИЯ ПРИ ЭТОМ
Dialogue: 0,0:08:50.56,0:08:52.88,Caption,,0,0,0,,ТРЕБУЕТ ДЕМИЛИТАРИЗАЦИИ И УСЛОВИЙ,
Dialogue: 0,0:08:53.12,0:08:55.92,Caption,,0,0,0,,ПРИ КОТОРЫХ УКРАИНА НЕ СМОЖЕТ СНОВА СТАТЬ ИСТОЧНИКОМ
Dialogue: 0,0:08:55.92,0:08:59.92,Caption,,0,0,0,,ВОЕННОЙ УГРОЗЫ. МЕЖДУ РОССИЙСКИМ ТРЕБОВАНИЕМ И УКРАИНСКИМ ПЛАНОМ
Dialogue: 0,0:08:59.92,0:09:02.96,Caption,,0,0,0,,ПОКА НЕТ НИЧЕГО ПОХОЖЕГО НА КОМПРОМИСС. СОВМЕСТИМЫ
Dialogue: 0,0:09:03.04,0:09:06.24,Caption,,0,0,0,,ЛИ ОНИ? НА СЕГОДНЯШНИЙ ДЕНЬ НЕТ. СЛЕДОМ К ПЕРЕГОВОРАМ
Dialogue: 0,0:09:06.24,0:09:08.96,Caption,,0,0,0,,ПЫТАЕТСЯ ПОДКЛЮЧИТЬСЯ ЕВРОПА. ВАШИНГТОН ХОЧЕТ,
Dialogue: 0,0:09:09.20,0:09:12.16,Caption,,0,0,0,,ЧТОБЫ ЕВРОПЕЙСКИЕ ГОСУДАРСТВА АКТИВНЕЕ УЧАСТВОВАЛИ В
Dialogue: 0,0:09:12.16,0:09:15.28,Caption,,0,0,0,,ДАЛЬНЕЙШИХ РАУНДАХ. КУШНЕР ПРЕДЛОЖИЛ ИМ ОПРЕДЕЛИТЬ
Dialogue: 0,0:09:15.28,0:09:19.60,Caption,,0,0,0,,ОДНОГО ПРЕДСТАВИТЕЛЯ, КОТОРЫЙ СМОЖЕТ ГОВОРИТЬ ОТ ОБЩЕГО ИМЕНИ. В АБУ
Dialogue: 0,0:09:19.60,0:09:22.56,Caption,,0,0,0,,ДАБИ РОССИЯ ОТДЕЛЬНО С ЕВРОПЕЙЦАМИ НЕ ВСТРЕЧАЛАСЬ.
Dialogue: 0,0:09:22.88,0:09:26.72,Caption,,0,0,0,,МЕДИНСКИЙ ЗАЯВИЛ, ЧТО КОНКРЕТНЫХ МИРНЫХ ПРЕДЛОЖЕНИЙ ОТ НИХ МОСКВА НЕ
Dialogue: 0,0:09:26.72,0:09:29.60,Caption,,0,0,0,,ПОЛУЧИЛА. САМО ПРИСУТСТВИЕ ПРЕДСТАВИТЕЛЯ ПРОБЛЕМУ НЕ
Dialogue: 0,0:09:29.60,0:09:33.84,Caption,,0,0,0,,РЕШИТ. ДОПУСТИМ, ЕВРОПЕЙЦЫ ВЫБРАЛИ ЧЕЛОВЕКА. ОН ПРИЕХАЛ И ПОЛОЖИЛ
Dialogue: 0,0:09:33.84,0:09:37.36,Caption,,0,0,0,,ПЕРЕД СОБОЙ ПАПКУ. ЧТО В НЕЙ? ПРИНЯТИЕ РОССИЙСКИХ УСЛОВИЙ?
Dialogue: 0,0:09:37.68,0:09:39.60,Caption,,0,0,0,,НОВАЯ МОДЕЛЬ УКРАИНСКОГО ГОСУДАРСТВА?
Dialogue: 0,0:09:40.00,0:09:42.16,Caption,,0,0,0,,ДОГОВОРЁННОСТЬ О БЕЗОПАСНОСТИ ВСЕЙ ЕВРОПЫ?
Dialogue: 0,0:09:42.56,0:09:45.36,Caption,,0,0,0,,ИЛИ ПРОГРАММА СЛЕДУЮЩЕЙ ВСТРЕЧИ И СПИСОК ЖЕЛАЮЩИХ
Dialogue: 0,0:09:45.36,0:09:48.72,Caption,,0,0,0,,ВЫСТУПИТЬ? ДОПОЛНИТЕЛЬНЫЙ УЧАСТНИК ЕЩЁ НЕ СОЗДАЁТ ОБЩЕГО
Dialogue: 0,0:09:48.72,0:09:53.56,Caption,,0,0,0,,РЕШЕНИЯ. ИНОГДА ЭТО ВСЕГО ЛИШЬ ЕЩЁ ОДИН ЧЕЛОВЕК,
Dialogue: 0,0:09:53.83,0:09:56.36,Caption,,0,0,0,,КОТОРОМУ НУЖНЫ МИКРОФОН И МЕСТО ЗА СТОЛОМ.
Dialogue: 0,0:09:57.08,0:09:59.56,Caption,,0,0,0,,ТЕМ БОЛЕЕ РАЗГОВОР РОССИИ И СОЕДИНЁННЫХ ШТАТОВ УЖЕ
Dialogue: 0,0:09:59.56,0:10:02.20,Caption,,0,0,0,,ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ УКРАИНСКОГО ВОПРОСА.
Dialogue: 0,0:10:02.76,0:10:05.16,Caption,,0,0,0,,В АБУ ДАБИ РАССМАТРИВАЛИ БУДУЩЕЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:10:05.16,0:10:07.96,Caption,,0,0,0,,БЕЗОПАСНОСТИ. МОСКВА ОПЯТЬ ПОДНИМАЕТ ТЕМУ
Dialogue: 0,0:10:07.96,0:10:10.84,Caption,,0,0,0,,ДОЛГОСРОЧНЫХ ГАРАНТИЙ И ДОПУСКАЕТ СОГЛАШЕНИЯ С
Dialogue: 0,0:10:10.84,0:10:15.00,Caption,,0,0,0,,ЕВРОПЕЙСКИМИ СТРАНАМИ, ВКЛЮЧАЯ ПАКТЫ О НЕНАПАДЕНИИ. ВАШИНГТОН ТЕПЕРЬ НЕ
Dialogue: 0,0:10:15.08,0:10:17.80,Caption,,0,0,0,,ОТМЕТАЕТ ТАКОЙ РАЗГОВОР СРАЗУ. УКРАИНА ПРИ ТАКОМ
Dialogue: 0,0:10:17.80,0:10:19.56,Caption,,0,0,0,,МАСШТАБЕ ОКАЗЫВАЕТСЯ ВАЖНЕЙШЕЙ,
Dialogue: 0,0:10:19.88,0:10:22.92,Caption,,0,0,0,,НО ВСЁ ЖЕ ЧАСТЬЮ ОБЩЕЙ СИСТЕМЫ. РОССИЯ СВЯЗЫВАЕТ
Dialogue: 0,0:10:22.92,0:10:25.08,Caption,,0,0,0,,ПРИЧИНЫ КОНФЛИКТА С РАСШИРЕНИЕМ НАТО,
Dialogue: 0,0:10:25.32,0:10:27.88,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ СИСТЕМОЙ БЕЗОПАСНОСТИ И ВОЕННЫМ
Dialogue: 0,0:10:27.88,0:10:31.24,Caption,,0,0,0,,ПОЛОЖЕНИЕМ УКРАИНЫ. ПОЭТОМУ ВЫДАТЬ КИЕВУ ДОКУМЕНТ С
Dialogue: 0,0:10:31.24,0:10:34.12,Caption,,0,0,0,,ТОРЖЕСТВЕННОЙ НАДПИСЬЮ НЕДОСТАТОЧНО. ОН ДОЛЖЕН
Dialogue: 0,0:10:34.12,0:10:39.00,Caption,,0,0,0,,СОДЕРЖАТЬ ОТВЕТЫ НА ВОПРОСЫ, РАДИ КОТОРЫХ НАЧАЛИСЬ НЫНЕШНИЕ ПЕРЕГОВОРЫ. КАКИЕ
Dialogue: 0,0:10:39.00,0:10:40.68,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ПОЛУЧАЕТ РОССИЯ?
Dialogue: 0,0:10:41.00,0:10:44.68,Caption,,0,0,0,,ЧТО ОБЕЩАЮТ УКРАИНЕ? КАКУЮ РОЛЬ ПРИНИМАЕТ НА СЕБЯ ЕВРОПА?
Dialogue: 0,0:10:44.95,0:10:47.24,Caption,,0,0,0,,ОТ КАКИХ ДЕЙСТВИЙ ЕВРОПЕЙСКИЕ СТРАНЫ ДОЛЖНЫ
Dialogue: 0,0:10:47.24,0:10:50.20,Caption,,0,0,0,,ОТКАЗАТЬСЯ? КАК БУДЕТ УСТРОЕНА ВЛАСТЬ НА УКРАИНЕ?
Dialogue: 0,0:10:50.44,0:10:52.60,Caption,,0,0,0,,КАКОЙ ВОЕННЫЙ ПОТЕНЦИАЛ ЕЙ ОСТАВЯТ?
Dialogue: 0,0:10:52.85,0:10:55.56,Caption,,0,0,0,,ТОЛЬКО ПОСЛЕ ЭТОГО МОЖНО СРАВНИВАТЬ ИТОГ С
Dialogue: 0,0:10:55.56,0:10:58.92,Caption,,0,0,0,,ЗАЯВЛЕННЫМИ ЦЕЛЯМИ СТОРОН. ПОКА КАРТИНА ВЫГЛЯДИТ
Dialogue: 0,0:10:58.92,0:11:02.04,Caption,,0,0,0,,ТАК. МОСКВА ТРЕБУЕТ ДОСТИЖЕНИЯ ПРЕЖНИХ ЦЕЛЕЙ.
Dialogue: 0,0:11:04.31,0:11:06.95,Caption,,0,0,0,,КИЕВ ПРОСИТ АРМИЮ ЧИСЛЕННОСТЬЮ ВОСЕМЬСОТ ТЫСЯЧ
Dialogue: 0,0:11:06.95,0:11:09.51,Caption,,0,0,0,,ЧЕЛОВЕК И ЗАПАДНЫЕ ДЕНЬГИ НА ДЕСЯТЬ ЛЕТ.
Dialogue: 0,0:11:09.99,0:11:12.23,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЙ СПОР ПЫТАЮТСЯ РЕШИТЬ ПЕРЕНОСОМ
Dialogue: 0,0:11:12.23,0:11:15.35,Caption,,0,0,0,,АДМИНИСТРАТИВНОЙ ГРАНИЦЫ. ЕВРОПЕ ПРЕДЛАГАЮТ ВЫБРАТЬ
Dialogue: 0,0:11:15.40,0:11:18.07,Caption,,0,0,0,,ОБЩЕГО ПРЕДСТАВИТЕЛЯ. ПОСЛЕ ОБМЕНА ПЛЕННЫМИ
Dialogue: 0,0:11:18.15,0:11:20.95,Caption,,0,0,0,,ГОТОВИТСЯ СЛЕДУЮЩИЙ РАУНД. И ВСЁ ЭТО НАЗЫВАЮТ
Dialogue: 0,0:11:20.95,0:11:25.59,Caption,,0,0,0,,ПРОГРЕССОМ. ВОЗМОЖНО, НЕКОТОРОЕ ПРОДВИЖЕНИЕ ДЕЙСТВИТЕЛЬНО ЕСТЬ. НО ПРИ
Dialogue: 0,0:11:25.59,0:11:28.55,Caption,,0,0,0,,ПЕРЕХОДЕ К ГЛАВНЫМ ВОПРОСАМ ОНО ПОКА НЕ ПРЕВРАЩАЕТСЯ
Dialogue: 0,0:11:28.63,0:11:32.07,Caption,,0,0,0,,В СОГЛАШЕНИЕ. ПО ТЕРРИТОРИЯМ СОГЛАСИЯ НЕТ. МЕЖДУ
Dialogue: 0,0:11:32.07,0:11:34.39,Caption,,0,0,0,,ПРЕЖНИМ РОССИЙСКИМ ПРЕДЛОЖЕНИЕМ ПО ЧИСЛЕННОСТИ
Dialogue: 0,0:11:34.39,0:11:37.67,Caption,,0,0,0,,УКРАИНСКОЙ АРМИИ И НЫНЕШНИМ ЗАПРОСОМ КИЕВА ЛЕЖИТ
Dialogue: 0,0:11:37.67,0:11:41.11,Caption,,0,0,0,,ПОЧТИ ДЕСЯТИКРАТНАЯ РАЗНИЦА. БУДУЩЕЕ УКРАИНСКОЙ
Dialogue: 0,0:11:41.11,0:11:44.15,Caption,,0,0,0,,ВЛАСТИ И ЕЁ КУРС НЕ ОПРЕДЕЛЕНЫ. РАЗГОВОР О
Dialogue: 0,0:11:44.15,0:11:47.11,Caption,,0,0,0,,НОВОЙ СИСТЕМЕ БЕЗОПАСНОСТИ ЕВРОПЫ ТОЛЬКО НАЧИНАЕТСЯ.
Dialogue: 0,0:11:47.41,0:11:50.15,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ИТОГ ПЕРЕГОВОРОВ НУЖНО ИЗМЕРЯТЬ НЕ
Dialogue: 0,0:11:50.15,0:11:53.11,Caption,,0,0,0,,КОЛИЧЕСТВОМ ВСТРЕЧ И НЕ ТЕМПЕРАТУРОЙ РУКОПОЖАТИЙ.
Dialogue: 0,0:11:53.59,0:11:56.39,Caption,,0,0,0,,ВНЯТНЫЙ КРИТЕРИЙ ЗДЕСЬ ОДИН НАСКОЛЬКО ОБСУЖДАЕМЫЕ
Dialogue: 0,0:11:56.39,0:12:01.19,Caption,,0,0,0,,РЕШЕНИЯ СООТВЕТСТВУЮТ ЦЕЛЯМ, ОТ КОТОРЫХ МОСКВА НЕ ОТКАЗЫВАЛАСЬ. ПЕРЕГОВОРЫ НЕ
Dialogue: 0,0:12:01.19,0:12:04.47,Caption,,0,0,0,,РАБОТАЮТ КАК ТУРНИРНАЯ ТАБЛИЦА. ВСТРЕЧА СОСТОЯЛАСЬ,
Dialogue: 0,0:12:04.71,0:12:07.43,Caption,,0,0,0,,НО ОЧКО ЗА ЭТО НЕ НАЧИСЛЯЮТ. ПРЕДСТАВИТЕЛИ
Dialogue: 0,0:12:07.43,0:12:11.27,Caption,,0,0,0,,УЛЫБНУЛИСЬ, ОДНАКО УСЛОВИЯ СТОРОН НЕ СБЛИЗИЛИСЬ. ДОГОВОРИЛИСЬ
Dialogue: 0,0:12:11.27,0:12:14.55,Caption,,0,0,0,,ПОГОВОРИТЬ ЕЩЁ РАЗ, НО ЭТО ЛИШЬ ПРОДОЛЖЕНИЕ ПРОЦЕССА,
Dialogue: 0,0:12:14.83,0:12:19.23,Caption,,0,0,0,,А НЕ ИТОГ. РЕЗУЛЬТАТ ПОЯВИТСЯ ТОГДА,
Dialogue: 0,0:12:19.52,0:12:22.11,Caption,,0,0,0,,КОГДА СТОРОНЫ СОГЛАСУЮТ СОДЕРЖАНИЕ БУДУЩЕГО
Dialogue: 0,0:12:22.11,0:12:25.23,Caption,,0,0,0,,СОГЛАШЕНИЯ. МОСКВА НЕ ЗАЯВЛЯЛА ОБ ОТКАЗЕ ОТ СВОИХ
Dialogue: 0,0:12:25.23,0:12:29.79,Caption,,0,0,0,,ТРЕБОВАНИЙ. ЗНАЧИТ, КАЖДЫЙ НОВЫЙ ВАРИАНТ ПРИДЁТСЯ СРАВНИВАТЬ ИМЕННО С
Dialogue: 0,0:12:29.79,0:12:33.47,Caption,,0,0,0,,НИМИ. ДЕМИЛИТАРИЗАЦИЯ СОЧЕТАЕТСЯ С АРМИЕЙ В ВОСЕМЬСОТ
Dialogue: 0,0:12:33.55,0:12:36.83,Caption,,0,0,0,,ТЫСЯЧ ЧЕЛОВЕК? НЕТ. ТЕРРИТОРИАЛЬНЫЙ ВОПРОС ЗАКРЫТ?
Dialogue: 0,0:12:37.07,0:12:39.63,Caption,,0,0,0,,НЕТ. БУДУЩИЙ КУРС УКРАИНЫ ОПРЕДЕЛЁН?
Dialogue: 0,0:12:39.92,0:12:43.47,Caption,,0,0,0,,НЕТ. НОВАЯ СИСТЕМА ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ СОЗДАНА?
Dialogue: 0,0:12:43.86,0:12:46.35,Caption,,0,0,0,,ОНА ПОКА ТОЛЬКО РАССМАТРИВАЕТСЯ. НАПИШИТЕ В
Dialogue: 0,0:12:46.43,0:12:49.79,Caption,,0,0,0,,КОММЕНТАРИЯХ, ЧТО В ТАКОМ СЛУЧАЕ СЛЕДУЕТ СЧИТАТЬ НАСТОЯЩИМ
Dialogue: 0,0:12:49.79,0:12:52.99,Caption,,0,0,0,,ПРОДВИЖЕНИЕМ САМ ФАКТ ПРОДОЛЖЕНИЯ ДИАЛОГА ИЛИ
Dialogue: 0,0:12:52.99,0:12:57.23,Caption,,0,0,0,,ПОЯВЛЕНИЕ УСЛОВИЙ, КОТОРЫЕ ОБЕ СТОРОНЫ ДЕЙСТВИТЕЛЬНО ГОТОВЫ ВЫПОЛНИТЬ?
Dialogue: 0,0:12:57.99,0:13:00.35,Caption,,0,0,0,,ПОДПИСЬ ПОД ДОКУМЕНТОМ МОЖНО ПОСТАВИТЬ ЗА НЕСКОЛЬКО
Dialogue: 0,0:13:00.35,0:13:03.15,Caption,,0,0,0,,СЕКУНД. ГОРАЗДО ДОЛЬШЕ СТОРОНЫ БУДУТ РЕШАТЬ,
Dialogue: 0,0:13:03.39,0:13:06.35,Caption,,0,0,0,,КАКИЕ ОБЯЗАТЕЛЬСТВА ОКАЖУТСЯ ВНУТРИ ЭТОГО ДОКУМЕНТА.
Dialogue: 0,0:13:06.63,0:13:10.27,Caption,,0,0,0,,СЛОВО "МИР" ВЫНЕСУТ В ЗАГОЛОВОК. НО ЦЕНУ СОГЛАШЕНИЯ
Dialogue: 0,0:13:10.27,0:13:14.03,Caption,,0,0,0,,ОПРЕДЕЛЯТ ПУНКТЫ, КОТОРЫЕ ПЕРЕД КАМЕРАМИ ОБЫЧНО НЕ ЗАЧИТЫВАЮТ.
