Dialogue: 0,0:00:00.12,0:00:03.72,Caption,,0,0,0,,НУ ЧТО, ВЫБОРЫ В АМЕРИКЕ ЗАКОНЧИЛИСЬ... ЗА ОКЕАНОМ КОНГРЕСС
Dialogue: 0,0:00:03.72,0:00:06.76,Caption,,0,0,0,,ГОТОВИТСЯ КУСАТЬ БЕЛЫЙ ДОМ. В ЕВРОПЕ СПОРЯТ,
Dialogue: 0,0:00:06.84,0:00:09.48,Caption,,0,0,0,,ЧЕЙ РОССИЙСКИЙ ГАЗ МОРАЛЬНЕЕ. ФРАНЦУЗСКОМУ
Dialogue: 0,0:00:09.48,0:00:11.72,Caption,,0,0,0,,ПРЕЗИДЕНТУ ПОДЫСКИВАЮТ УКРЫТИЕ ОТ СОБСТВЕННЫХ
Dialogue: 0,0:00:11.72,0:00:14.44,Caption,,0,0,0,,ГРАЖДАН. НА ВОСТОЧНОМ ФЛАНГЕ НАТО БАРАХЛИТ
Dialogue: 0,0:00:14.52,0:00:17.64,Caption,,0,0,0,,НАВИГАЦИЯ. ИРАН СНИМАЕТ ОГРАНИЧИТЕЛЬ С РАКЕТ,
Dialogue: 0,0:00:18.04,0:00:20.28,Caption,,0,0,0,,А ЕГО СУДА ЗАЧЕМ ТО КРУЖАТ ВОЗЛЕ ПОДВОДНЫХ
Dialogue: 0,0:00:20.28,0:00:23.00,Caption,,0,0,0,,КАБЕЛЕЙ. САМОЕ ВРЕМЯ ВЫЗВАТЬ ОТВЕТСТВЕННОГО
Dialogue: 0,0:00:23.00,0:00:26.04,Caption,,0,0,0,,ВЗРОСЛОГО. НО ОТВЕТСТВЕННЫЙ ВЗРОСЛЫЙ СЕЙЧАС ЗАНЯТ
Dialogue: 0,0:00:26.04,0:00:28.68,Caption,,0,0,0,,РАССЛЕДОВАНИЕМ ДРУГОГО ОТВЕТСТВЕННОГО ВЗРОСЛОГО.
Dialogue: 0,0:00:29.06,0:00:31.32,Caption,,0,0,0,,СВАЛИВАТЬ ВСЁ ЭТО В ОДНУ КУЧУ И ОБЪЯВЛЯТЬ
Dialogue: 0,0:00:31.32,0:00:34.44,Caption,,0,0,0,,ЕДИНЫМ ЗАГОВОРОМ НЕ НАДО. США ЖИВУТ СВОЕЙ
Dialogue: 0,0:00:34.44,0:00:38.20,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ ДРАКОЙ, ЕВРОПА РАЗБИРАЕТСЯ СО СВОИМИ СТРАХАМИ,
Dialogue: 0,0:00:38.51,0:00:41.48,Caption,,0,0,0,,ИРАН ИСПОЛЬЗУЕТ СОБСТВЕННЫЕ ВОЗМОЖНОСТИ. ЭТО РАЗНЫЕ
Dialogue: 0,0:00:41.56,0:00:43.64,Caption,,0,0,0,,ЛИНИИ. НО ЕСЛИ ПОСТАВИТЬ ИХ РЯДОМ,
Dialogue: 0,0:00:43.80,0:00:48.28,Caption,,0,0,0,,СТАНОВИТСЯ ВИДНО, ЧЕМ СЕГОДНЯ ЯВЛЯЕТСЯ ЗАПАД. НЕ МОНОЛИТОМ С ЕДИНЫМ
Dialogue: 0,0:00:48.28,0:00:50.76,Caption,,0,0,0,,ПУЛЬТОМ УПРАВЛЕНИЯ, А БОЛЬШОЙ КОМПАНИЕЙ,
Dialogue: 0,0:00:51.00,0:00:53.40,Caption,,0,0,0,,ГДЕ КАЖДЫЙ УЖЕ ОТКРЫЛ СВОЙ АВАРИЙНЫЙ ЧАТ И
Dialogue: 0,0:00:53.40,0:00:56.84,Caption,,0,0,0,,ТРЕБУЕТ, ЧТОБЫ ОСТАЛЬНЫЕ СРОЧНО ПРОЧИТАЛИ ИМЕННО ЕГО
Dialogue: 0,0:00:56.84,0:00:59.32,Caption,,0,0,0,,СООБЩЕНИЕ. НАЧАТЬ СТОИТ С ИРАНА,
Dialogue: 0,0:00:59.64,0:01:02.44,Caption,,0,0,0,,ПОТОМУ ЧТО ТЕГЕРАН МЕНЬШЕ ВСЕХ ИНТЕРЕСУЕТСЯ ИТОГАМИ
Dialogue: 0,0:01:02.44,0:01:05.08,Caption,,0,0,0,,АМЕРИКАНСКИХ ВЫБОРОВ. ПОКА В ВАШИНГТОНЕ СЧИТАЮТ
Dialogue: 0,0:01:05.08,0:01:07.40,Caption,,0,0,0,,КРЕСЛА И ГОТОВЯТ ПАПКИ ДЛЯ РАССЛЕДОВАНИЙ,
Dialogue: 0,0:01:07.65,0:01:11.80,Caption,,0,0,0,,ИРАНЦЫ УЖЕ ШУТЯТ, ЧТО ЭТО ОНИ СМЕНИЛИ РЕЖИМ В СОЕДИНЁННЫХ ШТАТАХ,
Dialogue: 0,0:01:11.96,0:01:18.17,Caption,,0,0,0,,А НЕ СОЕДИНЁННЫЕ ШТАТЫ У НИХ. ШУТКА ЕХИДНАЯ И ВЫБРАНА СО ВКУСОМ.
Dialogue: 0,0:01:18.80,0:01:21.05,Caption,,0,0,0,,ВАШИНГТОН ПОСЛЕ ИРАНСКОЙ ИСТОРИИ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:01:21.13,0:01:23.85,Caption,,0,0,0,,ПОЛУЧИЛ НОВЫЙ ВНУТРЕННИЙ КОНФЛИКТ И ТЕПЕРЬ УВЛЕЧЁННО
Dialogue: 0,0:01:23.85,0:01:28.17,Caption,,0,0,0,,ВЫЯСНЯЕТ, КТО ДОПУСТИЛ, КТО НЕ ПРЕДОТВРАТИЛ И КОГО ЗА ЭТО НАДО
Dialogue: 0,0:01:28.17,0:01:29.85,Caption,,0,0,0,,ТОРЖЕСТВЕННО ВЫЗВАТЬ НА КОВЁР.
Dialogue: 0,0:01:30.56,0:01:33.21,Caption,,0,0,0,,ОДНАКО ЗА НАСМЕШКАМИ ПОКАЗАЛОСЬ КОЕ ЧТО ТЯЖЕЛЕЕ.
Dialogue: 0,0:01:33.51,0:01:37.21,Caption,,0,0,0,,ИРАН ОБЪЯВИЛ, ЧТО ПРЕЖНЕЕ ДОБРОВОЛЬНОЕ ОГРАНИЧЕНИЕ ДАЛЬНОСТИ
Dialogue: 0,0:01:37.21,0:01:40.01,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИХ РАКЕТ В ДВЕ ТЫСЯЧИ КИЛОМЕТРОВ БОЛЬШЕ
Dialogue: 0,0:01:40.09,0:01:44.01,Caption,,0,0,0,,ЕГО НЕ СВЯЗЫВАЕТ. РАНЬШЕ ДВЕ ТЫСЯЧИ КИЛОМЕТРОВ БЫЛИ ОБОЗНАЧЕННЫМ
Dialogue: 0,0:01:44.01,0:01:46.81,Caption,,0,0,0,,ПОЛИТИЧЕСКИМ ПОТОЛКОМ. ТЕПЕРЬ ТЕГЕРАН ГОВОРИТ,
Dialogue: 0,0:01:47.05,0:01:49.61,Caption,,0,0,0,,ЧТО ПОТОЛОК СНЯТ. А КОГДА КТО ТО СНИМАЕТ
Dialogue: 0,0:01:49.61,0:01:53.85,Caption,,0,0,0,,ПОТОЛОК НАД РАКЕТАМИ, СОСЕДИ ОБЫЧНО НЕ РАДУЮТСЯ ДОПОЛНИТЕЛЬНОМУ ПРОСТОРУ В
Dialogue: 0,0:01:53.93,0:01:57.05,Caption,,0,0,0,,ПОМЕЩЕНИИ. В ИРАНСКИХ ЗАЯВЛЕНИЯХ УЖЕ УПОМИНАЮТСЯ
Dialogue: 0,0:01:57.05,0:01:59.93,Caption,,0,0,0,,АМЕРИКАНСКИЕ БАЗЫ В ЕВРОПЕ. ЕВРОПЕЙЦАМ ПРЕДЛАГАЮТ
Dialogue: 0,0:01:59.93,0:02:02.89,Caption,,0,0,0,,НОВУЮ ГЕОГРАФИЮ РИСКА. ОНИ ЕЩЁ НЕ ЗАКОНЧИЛИ
Dialogue: 0,0:02:02.89,0:02:04.65,Caption,,0,0,0,,ОБСУЖДАТЬ ОТНОШЕНИЯ С ТРАМПОМ,
Dialogue: 0,0:02:04.89,0:02:09.61,Caption,,0,0,0,,ТОПЛИВО И САНКЦИИ, А ИМ УЖЕ ПРИНЕСЛИ СЛЕДУЮЩУЮ ПАПКУ. БЕЗ ОЧЕРЕДИ
Dialogue: 0,0:02:09.61,0:02:12.81,Caption,,0,0,0,,И С ПОМЕТКОЙ "ПОСМОТРЕТЬ НЕМЕДЛЕННО". КОРПУС СТРАЖЕЙ
Dialogue: 0,0:02:12.81,0:02:15.53,Caption,,0,0,0,,ИСЛАМСКОЙ РЕВОЛЮЦИИ СООБЩАЕТ О НОВЫХ РАКЕТНЫХ
Dialogue: 0,0:02:15.53,0:02:18.49,Caption,,0,0,0,,ГОРОДАХ В ТЕГЕРАНЕ И МЕШХЕДЕ. В ПРИДАЧУ ОБЕЩАН
Dialogue: 0,0:02:18.49,0:02:22.49,Caption,,0,0,0,,НЕКИЙ СЮРПРИЗ, СВЯЗАННЫЙ С КОСМОСОМ. СЛОВО ВЫБРАНО ПОЧТИ
Dialogue: 0,0:02:22.49,0:02:25.93,Caption,,0,0,0,,ПРАЗДНИЧНОЕ. ПРАВДА, КОГДА О СЮРПРИЗЕ ГОВОРЯТ ЛЮДИ,
Dialogue: 0,0:02:26.17,0:02:28.17,Caption,,0,0,0,,ТОЛЬКО ЧТО ОБСУЖДАВШИЕ РАКЕТЫ,
Dialogue: 0,0:02:28.33,0:02:31.05,Caption,,0,0,0,,ШАРИКИ И ТОРТ ПОЧЕМУ ТО НИКТО НЕ ПРЕДСТАВЛЯЕТ.
Dialogue: 0,0:02:33.33,0:02:36.93,Caption,,0,0,0,,НО ЕЩЁ ЛЮБОПЫТНЕЕ ИСТОРИЯ, КОТОРАЯ ВООБЩЕ МОЖЕТ НИКУДА НЕ ЛЕТЕТЬ.
Dialogue: 0,0:02:37.56,0:02:40.29,Caption,,0,0,0,,ЗА ПОСЛЕДНИЕ НЕДЕЛИ ПО МЕНЬШЕЙ МЕРЕ ЧЕТЫРЕ СУДНА,
Dialogue: 0,0:02:40.37,0:02:44.69,Caption,,0,0,0,,СВЯЗАННЫЕ С ИРАНОМ, ЗАМЕТИЛИ ЗА НЕОБЫЧНЫМИ МАНЁВРАМИ РЯДОМ С ПОДВОДНЫМИ
Dialogue: 0,0:02:44.77,0:02:47.89,Caption,,0,0,0,,КАБЕЛЯМИ СВЯЗИ В ОМАНСКОМ ЗАЛИВЕ. ПО ЭТИМ ЛИНИЯМ
Dialogue: 0,0:02:47.97,0:02:52.53,Caption,,0,0,0,,ИДУТ ЦИФРОВЫЕ СЕРВИСЫ, ФИНАНСОВЫЕ ОПЕРАЦИИ И ОГРОМНЫЕ ПОТОКИ ИНФОРМАЦИИ.
Dialogue: 0,0:02:52.75,0:02:55.49,Caption,,0,0,0,,СОВРЕМЕННАЯ ЭКОНОМИКА ЛЮБИТ ИЗОБРАЖАТЬ ИЗ СЕБЯ НЕЧТО
Dialogue: 0,0:02:55.49,0:03:00.45,Caption,,0,0,0,,ВОЗДУШНОЕ И БЕСПЛОТНОЕ, НО ЗНАЧИТЕЛЬНАЯ ЕЁ ЧАСТЬ ДЕРЖИТСЯ НА НАСТОЯЩИХ НИТЯХ
Dialogue: 0,0:03:00.53,0:03:03.57,Caption,,0,0,0,,ПОД ВОДОЙ. ПОЭТОМУ СТРАННЫЕ МАНЁВРЫ СУДОВ РЯДОМ С
Dialogue: 0,0:03:03.57,0:03:06.45,Caption,,0,0,0,,КАБЕЛЯМИ ВЫЗЫВАЮТ ВНИМАНИЕ БЕЗ ДОПОЛНИТЕЛЬНЫХ
Dialogue: 0,0:03:06.45,0:03:09.49,Caption,,0,0,0,,СПЕЦЭФФЕКТОВ. ЧТОБЫ СОЗДАТЬ КРУПНУЮ ПРОБЛЕМУ,
Dialogue: 0,0:03:09.73,0:03:12.77,Caption,,0,0,0,,НЕ ВСЕГДА ТРЕБУЕТСЯ УДАР ПО ВОЕННОЙ БАЗЕ. ИНОГДА
Dialogue: 0,0:03:12.77,0:03:14.69,Caption,,0,0,0,,ДОСТАТОЧНО ЗАСТАВИТЬ ПРАВИТЕЛЬСТВА,
Dialogue: 0,0:03:14.92,0:03:17.97,Caption,,0,0,0,,КОМПАНИИ И ВОЕННЫХ ЧАСАМИ СМОТРЕТЬ НА МОРСКУЮ КАРТУ
Dialogue: 0,0:03:18.05,0:03:20.37,Caption,,0,0,0,,И ПРИКИДЫВАТЬ, ЧТО ПЕРЕСТАНЕТ РАБОТАТЬ,
Dialogue: 0,0:03:20.61,0:03:24.53,Caption,,0,0,0,,ЕСЛИ ОДНА ИЗ ЛИНИЙ ИСЧЕЗНЕТ. ДАВЛЕНИЕ ПОЛУЧАЕТСЯ ТИХОЕ,
Dialogue: 0,0:03:24.75,0:03:29.73,Caption,,0,0,0,,А НЕРВНИЧАЮТ ВСЕ ГРОМКО. НЕПОДАЛЁКУ ЕСТЬ ЕЩЁ КРАСНОЕ МОРЕ. ПО СООБЩЕНИЯМ
Dialogue: 0,0:03:29.73,0:03:33.89,Caption,,0,0,0,,АМЕРИКАНСКОЙ ПРЕССЫ, ХУСИТЫ УСИЛИВАЮТ КОНТРОЛЬ ЗА ДВИЖЕНИЕМ СУДОВ.
Dialogue: 0,0:03:34.17,0:03:36.61,Caption,,0,0,0,,СКЛЕИВАТЬ ЭТО С КАБЕЛЯМИ И ВЫДАВАТЬ ЗА ОДНУ
Dialogue: 0,0:03:36.69,0:03:39.33,Caption,,0,0,0,,ОПЕРАЦИЮ БЫЛО БЫ ДЕШЁВЫМ ФОКУСОМ. ЭТО
Dialogue: 0,0:03:39.33,0:03:42.85,Caption,,0,0,0,,САМОСТОЯТЕЛЬНАЯ ПРОБЛЕМА, ПРОСТО ОНА СНОВА КАСАЕТСЯ МОРЯ,
Dialogue: 0,0:03:43.01,0:03:47.25,Caption,,0,0,0,,ТОРГОВЫХ ПУТЕЙ, ИНФРАСТРУКТУРЫ И ДВИЖЕНИЯ ТОВАРОВ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:03:47.47,0:03:49.57,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНА ИМЕННО ТАКАЯ КАРТИНА.
Dialogue: 0,0:03:51.85,0:03:54.73,Caption,,0,0,0,,НЕ КОГДА РАЗНЫЕ НОВОСТИ СИЛОЙ ЗАПИХИВАЮТ В ОДНУ
Dialogue: 0,0:03:54.73,0:03:57.69,Caption,,0,0,0,,ТЕОРИЮ, А КОГДА ИХ СТАВЯТ РЯДОМ И СМОТРЯТ,
Dialogue: 0,0:03:57.85,0:04:00.89,Caption,,0,0,0,,ПОЧЕМУ У БОЛЬШОГО ЗАПАДНОГО МЕХАНИЗМА ОДНОВРЕМЕННО
Dialogue: 0,0:04:00.97,0:04:02.89,Caption,,0,0,0,,СКРИПЯТ СОВЕРШЕННО РАЗНЫЕ ДЕТАЛИ.
Dialogue: 0,0:04:03.47,0:04:07.77,Caption,,0,0,0,,ТЕПЕРЬ ПЕРЕНЕСЁМСЯ В ЕВРОПУ. ТАМ ОСОБЕННО ХОРОШО УМЕЮТ ТРЕБОВАТЬ ОТ ДРУГИХ
Dialogue: 0,0:04:07.77,0:04:11.13,Caption,,0,0,0,,ПРИНЦИПИАЛЬНОСТИ, ОСТАВЛЯЯ СЕБЕ НЕБОЛЬШУЮ СЛУЖЕБНУЮ ДВЕРЬ ДЛЯ
Dialogue: 0,0:04:11.13,0:04:15.05,Caption,,0,0,0,,УДОБСТВА. ЕВРОПЕЙЦЕВ ВСТРЕВОЖИЛА СДЕЛКА ТРАМПА И ПУТИНА ПО
Dialogue: 0,0:04:15.05,0:04:18.17,Caption,,0,0,0,,ДИЗЕЛЬНОМУ ТОПЛИВУ. ПАНИКА ПОЛУЧИЛАСЬ ГРОМКАЯ И
Dialogue: 0,0:04:18.17,0:04:22.57,Caption,,0,0,0,,НРАВСТВЕННО БЕЗУПРЕЧНАЯ, ПОКА МАРК РЮТТЕ НЕ НАПОМНИЛ НЕУДОБНУЮ ПОДРОБНОСТЬ.
Dialogue: 0,0:04:23.36,0:04:26.25,Caption,,0,0,0,,ЕВРОСОЮЗ САМ ПРОДОЛЖАЕТ ПОКУПАТЬ РОССИЙСКИЕ
Dialogue: 0,0:04:26.25,0:04:30.09,Caption,,0,0,0,,ЭНЕРГОРЕСУРСЫ, А РОССИЙСКОГО СЖИЖЕННОГО ГАЗА ПРИОБРЁЛ СТОЛЬКО,
Dialogue: 0,0:04:30.33,0:04:32.97,Caption,,0,0,0,,ЧТО АМЕРИКАНСКАЯ ДИЗЕЛЬНАЯ СДЕЛКА УЖЕ НЕ ВЫГЛЯДИТ
Dialogue: 0,0:04:32.97,0:04:36.09,Caption,,0,0,0,,ОДИНОКОЙ ВЕРШИНОЙ ПОЛИТИЧЕСКОГО ЦИНИЗМА. ПОЛУЧАЕТСЯ
Dialogue: 0,0:04:36.09,0:04:39.21,Caption,,0,0,0,,ЗАНЯТНАЯ БУХГАЛТЕРИЯ. ЕСЛИ РОССИЙСКОЕ ТОПЛИВО
Dialogue: 0,0:04:39.29,0:04:43.37,Caption,,0,0,0,,ПОКУПАЕТ ТРАМП, ЭТО ТРЕВОЖНЫЙ УДАР ПО ОБЩЕЙ ЛИНИИ. ЕСЛИ РОССИЙСКИЙ
Dialogue: 0,0:04:43.37,0:04:46.41,Caption,,0,0,0,,ГАЗ ПОКУПАЕТ ЕВРОПА, ЭТО, ВИДИМО,
Dialogue: 0,0:04:46.59,0:04:49.29,Caption,,0,0,0,,ГАЗ С ХОРОШИМ ВОСПИТАНИЕМ. ОН ЗНАЕТ ПРАВИЛА
Dialogue: 0,0:04:49.29,0:04:53.13,Caption,,0,0,0,,ПРИЛИЧИЯ, АККУРАТНО ПРОХОДИТ ТАМОЖНЮ И НЕ ЗАДАЁТ ЛИШНИХ
Dialogue: 0,0:04:53.13,0:04:55.61,Caption,,0,0,0,,ВОПРОСОВ О ГЕОПОЛИТИКЕ. РЕСУРС ОДИН,
Dialogue: 0,0:04:55.83,0:04:59.61,Caption,,0,0,0,,ПРОИСХОЖДЕНИЕ ОДНО, НО МОРАЛЬНАЯ ХАРАКТЕРИСТИКА МЕНЯЕТСЯ ВМЕСТЕ С
Dialogue: 0,0:04:59.61,0:05:02.41,Caption,,0,0,0,,ФАМИЛИЕЙ ПЛАТЕЛЬЩИКА. В СОВРЕМЕННОЙ ПОЛИТИКЕ ЧЕК
Dialogue: 0,0:05:02.49,0:05:04.65,Caption,,0,0,0,,ИНОГДА ВАЖНЕЕ СОДЕРЖИМОГО ЦИСТЕРНЫ.
Dialogue: 0,0:05:06.93,0:05:11.01,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ ВИДНО, ПОЧЕМУ ЕВРОПЕ ТРУДНО ВЫСТРОИТЬ ОТНОШЕНИЯ С ТРАМПОМ.
Dialogue: 0,0:05:11.40,0:05:13.73,Caption,,0,0,0,,ОТ НЕГО ХОТЯТ СОЮЗНИЧЕСКОЙ ДИСЦИПЛИНЫ,
Dialogue: 0,0:05:13.90,0:05:17.01,Caption,,0,0,0,,ПРЕДСКАЗУЕМОСТИ И УВАЖЕНИЯ К СОГЛАСОВАННОЙ ПОЗИЦИИ.
Dialogue: 0,0:05:17.41,0:05:20.45,Caption,,0,0,0,,А ОН ДЕЙСТВУЕТ ПРОЩЕ. ОБЩАЯ ПОЗИЦИЯ ПРЕКРАСНА,
Dialogue: 0,0:05:20.63,0:05:23.65,Caption,,0,0,0,,ПОКА СОВПАДАЕТ С ЕГО ИНТЕРЕСОМ. КАК ТОЛЬКО ПЕРЕСТАЁТ
Dialogue: 0,0:05:23.65,0:05:27.17,Caption,,0,0,0,,СОВПАДАТЬ, ОБЩЕЙ ВНЕЗАПНО ОКАЗЫВАЕТСЯ ТОЛЬКО ФОТОГРАФИЯ ПОСЛЕ
Dialogue: 0,0:05:27.25,0:05:29.89,Caption,,0,0,0,,ВСТРЕЧИ. ФРИДРИХ МЕРЦ, СУДЯ ПО ВСЕМУ,
Dialogue: 0,0:05:29.98,0:05:33.65,Caption,,0,0,0,,ЭТО ПОНИМАЕТ. ЕГО РАСЧЁТ ПРЕДЕЛЬНО ЗЕМНОЙ. РАНЬШЕ
Dialogue: 0,0:05:33.73,0:05:35.97,Caption,,0,0,0,,ТРАМП СТАРАЛСЯ ОБХОДИТЬ КОНГРЕСС В ВОПРОСАХ,
Dialogue: 0,0:05:36.29,0:05:38.61,Caption,,0,0,0,,ГДЕ ПРЕЗИДЕНТ СПОСОБЕН ДЕЙСТВОВАТЬ САМОСТОЯТЕЛЬНО.
Dialogue: 0,0:05:38.99,0:05:41.33,Caption,,0,0,0,,ПОСЛЕ ВЫБОРОВ ОН ПРОДОЛЖИТ ДЕЛАТЬ ТО ЖЕ САМОЕ.
Dialogue: 0,0:05:41.73,0:05:44.77,Caption,,0,0,0,,ПОЛОЖЕНИЕ У ЕВРОПЫ ДОВОЛЬНО КОМИЧНОЕ. ОНА НАДЕЕТСЯ,
Dialogue: 0,0:05:45.04,0:05:47.73,Caption,,0,0,0,,ЧТО АМЕРИКАНСКАЯ ВНУТРЕННЯЯ ПОЛИТИКА НЕМНОГО СВЯЖЕТ
Dialogue: 0,0:05:47.81,0:05:49.97,Caption,,0,0,0,,ТРАМПУ РУКИ. И ОДНОВРЕМЕННО ПОНИМАЕТ,
Dialogue: 0,0:05:50.13,0:05:52.77,Caption,,0,0,0,,ЧТО РАЗГОВАРИВАТЬ ВСЁ РАВНО ПРИДЁТСЯ С НИМ. ЭТО
Dialogue: 0,0:05:52.77,0:05:56.05,Caption,,0,0,0,,КАК ОБРАДОВАТЬСЯ, ЧТО СТРОГОМУ СОСЕДУ ВЫПИСАЛИ ШТРАФ,
Dialogue: 0,0:05:56.36,0:05:59.73,Caption,,0,0,0,,А ПОТОМ ВСПОМНИТЬ, ЧТО КЛЮЧ ОТ ОБЩЕГО ПОДВАЛА ПО ПРЕЖНЕМУ У
Dialogue: 0,0:05:59.81,0:06:02.29,Caption,,0,0,0,,НЕГО. НА ЭТОМ ЕВРОПЕЙСКИЕ СТРАННОСТИ НЕ
Dialogue: 0,0:06:02.29,0:06:05.41,Caption,,0,0,0,,ЗАКАНЧИВАЮТСЯ. ЭММАНЮЭЛЬ МАКРОН УСПЕЛ ПОЖАЛОВАТЬСЯ,
Dialogue: 0,0:06:05.65,0:06:07.41,Caption,,0,0,0,,ЧТО ЕМУ НЕДОСТАЁТ АНГЕЛЫ МЕРКЕЛЬ,
Dialogue: 0,0:06:07.73,0:06:10.61,Caption,,0,0,0,,А С НЫНЕШНИМ РУКОВОДСТВОМ ЕВРОСОЮЗА СКУЧНО. ПРОБЛЕМА
Dialogue: 0,0:06:10.61,0:06:14.37,Caption,,0,0,0,,РЕДКАЯ, ПОЧТИ АРИСТОКРАТИЧЕСКАЯ. У ОКРУЖАЮЩИХ ЭКОНОМИКА,
Dialogue: 0,0:06:14.50,0:06:16.93,Caption,,0,0,0,,БЕЗОПАСНОСТЬ, МИГРАЦИЯ И ЦЕНЫ,
Dialogue: 0,0:06:17.32,0:06:19.33,Caption,,0,0,0,,А У ПРЕЗИДЕНТА ФРАНЦИИ ЕЩЁ И НЕДОСТАТОК
Dialogue: 0,0:06:19.33,0:06:25.29,Caption,,0,0,0,,УВЛЕКАТЕЛЬНЫХ СОБЕСЕДНИКОВ. ЕВРОПА СТАЛКИВАЛАСЬ С РАЗНЫМИ КРИЗИСАМИ,
Dialogue: 0,0:06:25.45,0:06:28.41,Caption,,0,0,0,,НО БОРЬБА С ПОЛИТИЧЕСКОЙ СКУКОЙ ДЕЙСТВИТЕЛЬНО ЗВУЧИТ
Dialogue: 0,0:06:28.41,0:06:31.69,Caption,,0,0,0,,СВЕЖО. НА ЭТОМ ФОНЕ ПРЕССА СООБЩАЕТ О СЕКРЕТНОМ
Dialogue: 0,0:06:31.69,0:06:35.37,Caption,,0,0,0,,БУНКЕРЕ, ПОДГОТОВЛЕННОМ ДЛЯ МАКРОНА В ПРИГОРОДЕ ПАРИЖА. ОН
Dialogue: 0,0:06:35.45,0:06:39.21,Caption,,0,0,0,,МОЖЕТ ПОНАДОБИТЬСЯ, ЕСЛИ ПРОТЕСТУЮЩИЕ ЗАХВАТЯТ ЕЛИСЕЙСКИЙ ДВОРЕЦ.
Dialogue: 0,0:06:39.85,0:06:42.97,Caption,,0,0,0,,НО РЯДОМ ОНИ СМОТРЯТСЯ БЕЗУПРЕЧНО. ПРЕЗИДЕНТ ТОСКУЕТ
Dialogue: 0,0:06:43.05,0:06:46.17,Caption,,0,0,0,,ПО ПРЕЖНИМ ВРЕМЕНАМ И СКУЧАЕТ С НЫНЕШНИМИ КОЛЛЕГАМИ.
Dialogue: 0,0:06:46.40,0:06:48.81,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ НЕПОДАЛЁКУ ГОТОВЯТ МЕСТО,
Dialogue: 0,0:06:48.98,0:06:50.65,Caption,,0,0,0,,ГДЕ ОН СМОЖЕТ ПРОДОЛЖИТЬ СКУЧАТЬ,
Dialogue: 0,0:06:50.96,0:06:53.45,Caption,,0,0,0,,ЕСЛИ РАЗГОВОР ГРАЖДАН С ВЛАСТЬЮ СТАНЕТ ЧЕРЕСЧУР
Dialogue: 0,0:06:53.45,0:06:56.25,Caption,,0,0,0,,ОЖИВЛЁННЫМ. ФРАНЦИЯ ВСЁ ТАКИ УМЕЕТ ПРЕДЛАГАТЬ
Dialogue: 0,0:06:56.25,0:06:59.45,Caption,,0,0,0,,КУЛЬТУРНУЮ ПРОГРАММУ. СОВСЕМ ДРУГОЙ ВИД НАПРЯЖЕНИЯ
Dialogue: 0,0:06:59.53,0:07:02.73,Caption,,0,0,0,,ЗАМЕТЕН НА ВОСТОКЕ ЕВРОПЫ. КАРТА НАВИГАЦИОННЫХ ПОМЕХ
Dialogue: 0,0:07:02.81,0:07:05.21,Caption,,0,0,0,,РИСУЕТ СПЛОШНУЮ ЛИНИЮ ПОМЕХ ЧУТЬ ЛИ НЕ ПО
Dialogue: 0,0:07:05.21,0:07:08.09,Caption,,0,0,0,,ВСЕМУ ВОСТОЧНОМУ ФЛАНГУ НАТО. ТУТ УЖЕ НЕТ НИ
Dialogue: 0,0:07:08.09,0:07:10.81,Caption,,0,0,0,,НОСТАЛЬГИИ, НИ ТОПЛИВНОГО ЛИЦЕМЕРИЯ,
Dialogue: 0,0:07:11.05,0:07:14.09,Caption,,0,0,0,,НИ ФРАНЦУЗСКИХ ЖАЛОБ НА СКУКУ. ЕСТЬ ТЕХНИЧЕСКАЯ
Dialogue: 0,0:07:14.09,0:07:17.13,Caption,,0,0,0,,СИСТЕМА, ОТ КОТОРОЙ ЗАВИСИТ МНОЖЕСТВО ПРОЦЕССОВ,
Dialogue: 0,0:07:17.64,0:07:20.33,Caption,,0,0,0,,И ЭТА СИСТЕМА НАЧИНАЕТ ВЕСТИ СЕБЯ КРАЙНЕ НЕРВНО.
Dialogue: 0,0:07:20.82,0:07:24.65,Caption,,0,0,0,,А ТЕПЕРЬ АМЕРИКА, ГДЕ ПОСЛЕ ВЫБОРОВ НИКТО НЕ СОБИРАЕТСЯ ОТДЫХАТЬ.
Dialogue: 0,0:07:25.09,0:07:27.05,Caption,,0,0,0,,ДЕМОКРАТЫ ПОЛУЧИЛИ НОВЫЕ РЫЧАГИ,
Dialogue: 0,0:07:27.29,0:07:29.21,Caption,,0,0,0,,ТРАМП СОХРАНИЛ ПРЕЗИДЕНТСКИЙ ПОСТ,
Dialogue: 0,0:07:29.37,0:07:32.17,Caption,,0,0,0,,СВОЙ КАБИНЕТ И ИСПОЛНИТЕЛЬНУЮ ВЛАСТЬ. У КАЖДОЙ
Dialogue: 0,0:07:32.17,0:07:36.81,Caption,,0,0,0,,СТОРОНЫ ЕСТЬ ИНСТРУМЕНТЫ, АМБИЦИИ И ЖЕЛАНИЕ ПРОВЕРИТЬ ПРОЧНОСТЬ ДРУГОЙ
Dialogue: 0,0:07:36.81,0:07:42.61,Caption,,0,0,0,,СТОРОНЫ. ВАШИНГТОН ГОТОВ К ПРОДУКТИВНОЙ РАБОТЕ. В ТОМ СМЫСЛЕ,
Dialogue: 0,0:07:42.84,0:07:46.21,Caption,,0,0,0,,ЧТО ПАПОК С ОБВИНЕНИЯМИ ХВАТИТ ВСЕМ. БЕЛЫЙ ДОМ
Dialogue: 0,0:07:46.29,0:07:50.69,Caption,,0,0,0,,УЖЕ УБЕЖДАЕТ СТОРОННИКОВ, ЧТО ЗА ОСТАВШИЕСЯ ДВА ГОДА ПРЕЗИДЕНТСКОГО СРОКА
Dialogue: 0,0:07:50.93,0:07:53.73,Caption,,0,0,0,,ДЕМОКРАТЫ НЕ СМОГУТ ВЗЯТЬ И ОТМЕНИТЬ ВСЁ СДЕЛАННОЕ
Dialogue: 0,0:07:53.73,0:07:56.85,Caption,,0,0,0,,ТРАМПОМ. ЗАЯВЛЕНИЕ ДОЛЖНО УСПОКАИВАТЬ. НО КОГДА
Dialogue: 0,0:07:56.85,0:07:59.41,Caption,,0,0,0,,СРАЗУ ПОСЛЕ ГОЛОСОВАНИЯ ПРИХОДИТСЯ ОТДЕЛЬНО
Dialogue: 0,0:07:59.41,0:08:02.93,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО ПРЕЗИДЕНТА ПОКА НЕ РАЗОБРАЛИ НА ЗАПЧАСТИ,
Dialogue: 0,0:08:03.24,0:08:06.13,Caption,,0,0,0,,АТМОСФЕРА СТАНОВИТСЯ ПОНЯТНА БЕЗ СОЦИОЛОГИЧЕСКИХ
Dialogue: 0,0:08:06.13,0:08:09.25,Caption,,0,0,0,,ОПРОСОВ. ЭТО НЕ КОНЕЦ АМЕРИКАНСКОЙ ГОСУДАРСТВЕННОСТИ
Dialogue: 0,0:08:09.25,0:08:12.85,Caption,,0,0,0,,И НЕ ПОСЛЕДНЯЯ ГЛАВА ВЕЛИКОЙ ТРАГЕДИИ. ЭТО ЗНАКОМОЕ
Dialogue: 0,0:08:12.93,0:08:16.85,Caption,,0,0,0,,БОДАНИЕ ИНСТИТУТОВ, ТОЛЬКО ТЕПЕРЬ ОНО ЗАЙМЁТ ОСТАВШИЕСЯ ДВА ГОДА
Dialogue: 0,0:08:16.85,0:08:19.65,Caption,,0,0,0,,ТРАМПОВСКОГО СРОКА. ПРЕДСТАВЛЕНИЕ ОБЕЩАЕТ БЫТЬ
Dialogue: 0,0:08:19.65,0:08:24.61,Caption,,0,0,0,,ДОЛГИМ, А АНТРАКТ, ПОХОЖЕ, ОТМЕНИЛИ. ПЕРВОЙ КРУПНОЙ ФИГУРОЙ ПОД УДАРОМ МОЖЕТ
Dialogue: 0,0:08:24.69,0:08:27.57,Caption,,0,0,0,,ОКАЗАТЬСЯ ПИТ ХЕГСЕТ. В КОНГРЕССЕ ОБСУЖДАЮТ
Dialogue: 0,0:08:27.57,0:08:30.37,Caption,,0,0,0,,ИМПИЧМЕНТ ГЛАВЫ ПЕНТАГОНА. ПАРАЛЛЕЛЬНО ЗВУЧАТ
Dialogue: 0,0:08:30.37,0:08:33.33,Caption,,0,0,0,,РАЗГОВОРЫ О ТОМ, ЧТО ЕГО ХОТЯТ СНЯТЬ С ДОЛЖНОСТИ.
Dialogue: 0,0:08:33.89,0:08:36.69,Caption,,0,0,0,,ДЛЯ ХЕГСЕТА НЕПРИЯТНО НЕ ТОЛЬКО ДАВЛЕНИЕ ДЕМОКРАТОВ.
Dialogue: 0,0:08:37.01,0:08:39.65,Caption,,0,0,0,,ВОПРОСЫ К НЕМУ ВОЗНИКАЮТ И СРЕДИ РЕСПУБЛИКАНЦЕВ.
Dialogue: 0,0:08:40.03,0:08:42.53,Caption,,0,0,0,,ПОЭТОМУ ОТМАХНУТЬСЯ ПРИВЫЧНОЙ ФРАЗОЙ О ТОМ,
Dialogue: 0,0:08:42.76,0:08:45.49,Caption,,0,0,0,,ЧТО ПРОТИВНИКИ ТРАМПА ОПЯТЬ УСТРОИЛИ СПЕКТАКЛЬ,
Dialogue: 0,0:08:45.80,0:08:49.57,Caption,,0,0,0,,УЖЕ ТРУДНЕЕ. КОГДА НЕДОВОЛЬНЫЕ ПОЯВЛЯЮТСЯ В СОБСТВЕННОМ РЯДУ,
Dialogue: 0,0:08:49.95,0:08:52.37,Caption,,0,0,0,,ДЕКОРАЦИИ ВНЕЗАПНО СТАНОВЯТСЯ НАСТОЯЩИМИ.
Dialogue: 0,0:08:54.64,0:08:56.72,Caption,,0,0,0,,САМ ГЛАВА ПЕНТАГОНА ТИХОГО УХОДА,
Dialogue: 0,0:08:56.86,0:09:00.56,Caption,,0,0,0,,ПОХОЖЕ, НЕ ПЛАНИРУЕТ. ТРАМПУ ТОЖЕ НЕВЫГОДНО ПРОСТО ОТДАТЬ
Dialogue: 0,0:09:00.64,0:09:03.84,Caption,,0,0,0,,СВОЕГО МИНИСТРА. КАРТИНА ПОЛУЧИТСЯ СЛИШКОМ УДОБНАЯ
Dialogue: 0,0:09:03.92,0:09:06.16,Caption,,0,0,0,,ДЛЯ ПРОТИВНИКОВ. ВЫБОРЫ ПРОИГРАНЫ,
Dialogue: 0,0:09:06.42,0:09:10.56,Caption,,0,0,0,,ДАВЛЕНИЕ НАЧАЛОСЬ, ЗАМЕТНЫЙ ЧЛЕН КОМАНДЫ ПЕРВЫМ ПОКИДАЕТ ДОЛЖНОСТЬ.
Dialogue: 0,0:09:10.80,0:09:14.16,Caption,,0,0,0,,ОППОНЕНТЫ ПОЛУЧАЮТ ТРОФЕЙ, СТОРОННИКИ ПОЛУЧАЮТ СИГНАЛ,
Dialogue: 0,0:09:14.40,0:09:16.88,Caption,,0,0,0,,А ПРЕССА ПОЛУЧАЕТ ПИТАНИЕ НА НЕСКОЛЬКО НЕДЕЛЬ.
Dialogue: 0,0:09:17.17,0:09:19.60,Caption,,0,0,0,,ДЕШЕВЛЕ ОСТАВИТЬ ЧЕЛОВЕКА В КРЕСЛЕ И ПРОДОЛЖИТЬ
Dialogue: 0,0:09:19.68,0:09:23.36,Caption,,0,0,0,,ДРАКУ. ДЕМОКРАТЫ ТЕМ ВРЕМЕНЕМ ГОТОВЯТ НОВЫЙ ПАКЕТ ПОМОЩИ
Dialogue: 0,0:09:23.44,0:09:26.64,Caption,,0,0,0,,УКРАИНЕ НА ПЯТНАДЦАТЬ МИЛЛИАРДОВ ДОЛЛАРОВ. И С ЭТОГО
Dialogue: 0,0:09:26.72,0:09:30.24,Caption,,0,0,0,,МОМЕНТА ВНУТРЕННИЙ АМЕРИКАНСКИЙ СПОР ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:09:30.32,0:09:32.08,Caption,,0,0,0,,ДЕЛОМ ТОЛЬКО САМИХ АМЕРИКАНЦЕВ.
Dialogue: 0,0:09:32.64,0:09:35.36,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ РЫЧАГИ В КОНГРЕССЕ ОЗНАЧАЮТ ВЛИЯНИЕ
Dialogue: 0,0:09:35.44,0:09:41.04,Caption,,0,0,0,,НА ДЕНЬГИ, ВООРУЖЕНИЕ, САНКЦИИ И ВНЕШНЮЮ ПОЛИТИКУ. ПОСЛЕДСТВИЯ РЕШЕНИЙ,
Dialogue: 0,0:09:41.12,0:09:43.04,Caption,,0,0,0,,ПРИНЯТЫХ В ВАШИНГТОНСКИХ КАБИНЕТАХ,
Dialogue: 0,0:09:43.28,0:09:46.00,Caption,,0,0,0,,БЫСТРО ОБНАРУЖИВАЮТ СЕБЯ ДАЛЕКО ОТ ВАШИНГТОНА.
Dialogue: 0,0:09:46.54,0:09:49.68,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ ССОРА ОСТАЁТСЯ ДОМАШНЕЙ РОВНО ДО ТОГО
Dialogue: 0,0:09:49.68,0:09:53.20,Caption,,0,0,0,,МОМЕНТА, ПОКА К НЕЙ НЕ ПРИКРЕПЛЯЮТ СУММУ В ПЯТНАДЦАТЬ
Dialogue: 0,0:09:53.20,0:09:56.00,Caption,,0,0,0,,МИЛЛИАРДОВ ДОЛЛАРОВ. ТРАМП ОТВЕЧАЕТ ПРИВЫЧНЫМ
Dialogue: 0,0:09:56.08,0:09:58.96,Caption,,0,0,0,,СПОСОБОМ. ВМЕСТО ТОРЖЕСТВЕННОЙ РЕЧИ О НАЦИОНАЛЬНОМ
Dialogue: 0,0:09:58.96,0:10:01.60,Caption,,0,0,0,,ПРИМИРЕНИИ ОН ПОТРЕБОВАЛ РАССЛЕДОВАТЬ ДЕМОКРАТОВ ЗА
Dialogue: 0,0:10:01.68,0:10:04.16,Caption,,0,0,0,,УГРОЗЫ ИМПИЧМЕНТОМ. ДЕМОКРАТЫ СОБИРАЮТСЯ
Dialogue: 0,0:10:04.16,0:10:06.96,Caption,,0,0,0,,РАССЛЕДОВАТЬ ЛЮДЕЙ ТРАМПА. ТРАМП ПРЕДЛАГАЕТ
Dialogue: 0,0:10:07.04,0:10:10.16,Caption,,0,0,0,,РАССЛЕДОВАТЬ ТЕХ, КТО СОБИРАЕТСЯ РАССЛЕДОВАТЬ ЛЮДЕЙ ТРАМПА.
Dialogue: 0,0:10:12.43,0:10:16.03,Caption,,0,0,0,,ЕЩЁ НЕМНОГО, И В ВАШИНГТОНЕ ПОНАДОБИТСЯ ОТДЕЛЬНОЕ ВЕДОМСТВО,
Dialogue: 0,0:10:16.27,0:10:18.43,Caption,,0,0,0,,КОТОРОЕ БУДЕТ ВЫДАВАТЬ СЛЕДОВАТЕЛЯМ НОМЕРКИ В
Dialogue: 0,0:10:18.43,0:10:21.63,Caption,,0,0,0,,ОЧЕРЕДИ. И ЗДЕСЬ ОСОБЕННО ВАЖНО НЕ ВЫДУМЫВАТЬ ЛИШНЮЮ
Dialogue: 0,0:10:21.63,0:10:25.87,Caption,,0,0,0,,СВЯЗЬ. МАНЁВРЫ ИРАНСКИХ СУДОВ ВОЗЛЕ КАБЕЛЕЙ НЕ ЯВЛЯЮТСЯ
Dialogue: 0,0:10:25.95,0:10:29.39,Caption,,0,0,0,,ПРОДОЛЖЕНИЕМ СПОРА В КОНГРЕССЕ. ЖАЛОБЫ МАКРОНА НЕ
Dialogue: 0,0:10:29.39,0:10:33.07,Caption,,0,0,0,,ОБЪЯСНЯЮТ НАВИГАЦИОННЫЕ ПОМЕХИ. ДИЗЕЛЬНАЯ СДЕЛКА НЕ
Dialogue: 0,0:10:33.15,0:10:36.11,Caption,,0,0,0,,ОТПРАВЛЯЕТ ХЕГСЕТА ПОД ИМПИЧМЕНТ. ИСКУССТВЕННО
Dialogue: 0,0:10:36.11,0:10:39.55,Caption,,0,0,0,,ПРИВЯЗЫВАТЬ ОДНО К ДРУГОМУ НЕЗАЧЕМ. СЕЙЧАС УДОБСТВА
Dialogue: 0,0:10:39.63,0:10:42.83,Caption,,0,0,0,,НЕТ. АМЕРИКАНСКИЙ КОНФЛИКТ ТРЕБУЕТ ОДНОГО ОТВЕТА.
Dialogue: 0,0:10:43.14,0:10:45.87,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ЭНЕРГЕТИЧЕСКИЕ ПРОТИВОРЕЧИЯ ДРУГОГО.
Dialogue: 0,0:10:46.19,0:10:49.23,Caption,,0,0,0,,НАВИГАЦИОННЫЕ ПОМЕХИ ТРЕТЬЕГО. ИРАНСКИЕ РАКЕТЫ
Dialogue: 0,0:10:49.23,0:10:52.75,Caption,,0,0,0,,ЧЕТВЁРТОГО. КАБЕЛИ И СУДОХОДСТВО ПЯТОГО. ПОПЫТКА
Dialogue: 0,0:10:52.83,0:10:55.71,Caption,,0,0,0,,НАКРЫТЬ ВСЁ ОДНИМ РЕШЕНИЕМ НАПОМИНАЕТ ПОПЫТКУ ЧИНИТЬ
Dialogue: 0,0:10:55.79,0:10:59.07,Caption,,0,0,0,,КВАРТИРУ ОДНИМ ГАЕЧНЫМ КЛЮЧОМ. КРАН ЕЩЁ МОЖНО
Dialogue: 0,0:10:59.07,0:11:02.59,Caption,,0,0,0,,УБЕДИТЬ, А ПРОВОДКА УЖЕ НАЧИНАЕТ СМЕЯТЬСЯ. ПОДПИШИТЕСЬ НА
Dialogue: 0,0:11:02.59,0:11:05.31,Caption,,0,0,0,,КАНАЛ, ЕСЛИ ХОТИТЕ ВИДЕТЬ НЕ СКЛАД НОВОСТЕЙ,
Dialogue: 0,0:11:05.55,0:11:08.51,Caption,,0,0,0,,А УСТРОЙСТВО ВСЕЙ ЭТОЙ НЕРВНОЙ СИСТЕМЫ. ОТДЕЛЬНЫЕ
Dialogue: 0,0:11:08.59,0:11:11.39,Caption,,0,0,0,,СООБЩЕНИЯ БЫСТРО ЗАБЫВАЮТСЯ. ВАЖНЕЕ ПОНЯТЬ,
Dialogue: 0,0:11:11.63,0:11:14.35,Caption,,0,0,0,,ПОЧЕМУ ОНИ НАЧИНАЮТ МЕШАТЬ ДРУГ ДРУГУ ИМЕННО В
Dialogue: 0,0:11:14.35,0:11:17.95,Caption,,0,0,0,,ОДИН МОМЕНТ. ДЕНЕГ У ЗАПАДА ДОСТАТОЧНО. ЗАЯВЛЕНИЙ
Dialogue: 0,0:11:17.95,0:11:20.91,Caption,,0,0,0,,ЕЩЁ БОЛЬШЕ. ЧИНОВНИКОВ ТОЖЕ НИКТО НЕ ОТМЕНЯЛ,
Dialogue: 0,0:11:21.13,0:11:24.27,Caption,,0,0,0,,ХОТЯ НЕКОТОРЫЕ ЯВНО СТАРАЮТСЯ. НЕ ХВАТАЕТ ДРУГОГО
Dialogue: 0,0:11:24.35,0:11:26.67,Caption,,0,0,0,,РЕСУРСА, КОТОРЫЙ НЕЛЬЗЯ НАПЕЧАТАТЬ,
Dialogue: 0,0:11:26.82,0:11:29.87,Caption,,0,0,0,,ЗАНЯТЬ ИЛИ УТВЕРДИТЬ ГОЛОСОВАНИЕМ. НЕ ХВАТАЕТ
Dialogue: 0,0:11:29.87,0:11:34.78,Caption,,0,0,0,,ВНИМАНИЯ. КАЖДАЯ ОТДЕЛЬНАЯ ПРОБЛЕМА ТРЕБУЕТ,
Dialogue: 0,0:11:34.90,0:11:37.98,Caption,,0,0,0,,ЧТОБЫ ЕЁ ПРИЗНАЛИ ГЛАВНОЙ. НО ГЛАВНЫХ УЖЕ СЛИШКОМ
Dialogue: 0,0:11:37.98,0:11:41.34,Caption,,0,0,0,,МНОГО. ПОКА ВАШИНГТОН РЕШАЕТ, КОГО РАССЛЕДОВАТЬ,
Dialogue: 0,0:11:41.82,0:11:44.70,Caption,,0,0,0,,ЕВРОПА ВЫБИРАЕТ МЕЖДУ ПРИНЦИПАМИ И УДОБСТВОМ.
Dialogue: 0,0:11:45.26,0:11:50.62,Caption,,0,0,0,,ПОКА ЕВРОПА СПОРИТ О ТОПЛИВЕ, ТЕГЕРАН МЕНЯЕТ РАКЕТНЫЕ РАМКИ. ПОКА ВОЕННЫЕ СМОТРЯТ
Dialogue: 0,0:11:50.62,0:11:52.54,Caption,,0,0,0,,ВВЕРХ НА НАВИГАЦИОННЫЕ СИГНАЛЫ,
Dialogue: 0,0:11:52.94,0:11:55.02,Caption,,0,0,0,,КОРАБЛИ ЗАСТАВЛЯЮТ ВСЕХ СМОТРЕТЬ ВНИЗ,
Dialogue: 0,0:11:55.26,0:11:59.66,Caption,,0,0,0,,НА КАБЕЛИ. ВОТ ЧТО СЕГОДНЯ ПРЕДСТАВЛЯЕТ СОБОЙ ЗАПАД. НЕ СТРОЙ,
Dialogue: 0,0:11:59.74,0:12:02.30,Caption,,0,0,0,,ИДУЩИЙ В ОДНУ СТОРОНУ, А ПЕРЕКРЁСТОК,
Dialogue: 0,0:12:02.48,0:12:06.46,Caption,,0,0,0,,ГДЕ КАЖДЫЙ УВЕРЕН, ЧТО ЗЕЛЁНЫЙ СВЕТ СЕЙЧАС ДОЛЖЕН ЗАГОРЕТЬСЯ ИМЕННО
Dialogue: 0,0:12:06.54,0:12:09.74,Caption,,0,0,0,,ЕМУ. РЕГУЛИРОВЩИК ПРИ ЭТОМ ЗАНЯТ. НА НЕГО УЖЕ
Dialogue: 0,0:12:09.74,0:12:10.94,Caption,,0,0,0,,ОТКРЫЛИ РАССЛЕДОВАНИЕ.
