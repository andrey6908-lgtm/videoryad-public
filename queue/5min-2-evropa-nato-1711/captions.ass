Dialogue: 0,0:00:00.12,0:00:04.76,Caption,,0,0,0,,ЛОНДОН, КАЖЕТСЯ, НАЧАЛ КОЕ ЧТО СООБРАЖАТЬ. ПЯТЬ ЛЕТ ПОВЫШАЛИ СТАВКИ,
Dialogue: 0,0:00:04.92,0:00:09.64,Caption,,0,0,0,,ДВИГАЛИ КРАСНЫЕ ЛИНИИ, ОБЕЩАЛИ ИДТИ ДО КОНЦА. А ТЕПЕРЬ ВДРУГ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:00:09.95,0:00:12.12,Caption,,0,0,0,,ЧТО С МОСКВОЙ НЕПЛОХО БЫ И ПОГОВОРИТЬ. НУ
Dialogue: 0,0:00:12.12,0:00:14.28,Caption,,0,0,0,,НАКОНЕЦ ТО! ТОЛЬКО ВОТ ВОПРОС,
Dialogue: 0,0:00:14.52,0:00:17.24,Caption,,0,0,0,,ЧТО ИМЕННО ЗАСТАВИЛО БРИТАНЦЕВ ВСПОМНИТЬ О ТАКОЙ
Dialogue: 0,0:00:17.24,0:00:19.40,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНОЙ ВЕЩИ, КАК ПЕРЕГОВОРЫ?
Dialogue: 0,0:00:19.72,0:00:22.12,Caption,,0,0,0,,И ПОЧЕМУ ОНИ ВСПОМНИЛИ ОБ ЭТОМ ИМЕННО СЕЙЧАС?
Dialogue: 0,0:00:22.44,0:00:26.60,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ ПОСМОТРЕТЬ, ЧТО ПРОИСХОДИТ ВОКРУГ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ.
Dialogue: 0,0:00:26.92,0:00:29.72,Caption,,0,0,0,,ПОТОМУ ЧТО ТАКИЕ ПЕРЕМЕНЫ ПРОСТО ТАК НЕ ПРОИСХОДЯТ.
Dialogue: 0,0:00:29.96,0:00:32.68,Caption,,0,0,0,,ОСОБЕННО КОГДА ЛЮДИ НАЧИНАЮТ ГОВОРИТЬ СОВСЕМ НЕ ТО,
Dialogue: 0,0:00:32.98,0:00:35.80,Caption,,0,0,0,,ЧТО ГОВОРИЛИ ЕЩЁ СОВСЕМ НЕДАВНО. БРИТАНИЯ ТЕПЕРЬ
Dialogue: 0,0:00:35.80,0:00:37.96,Caption,,0,0,0,,ПРИЗЫВАЕТ ЗАКАНЧИВАТЬ КОНФЛИКТ ЗА СТОЛОМ
Dialogue: 0,0:00:37.96,0:00:40.84,Caption,,0,0,0,,ПЕРЕГОВОРОВ. УЖЕ САМА ЭТА ФРАЗА ЗВУЧИТ ЗАНЯТНО.
Dialogue: 0,0:00:41.08,0:00:43.80,Caption,,0,0,0,,ПОТОМУ ЧТО ЕЩЁ НЕДАВНО ИЗ ЛОНДОНА ДОНОСИЛОСЬ СОВСЕМ
Dialogue: 0,0:00:43.80,0:00:47.40,Caption,,0,0,0,,ДРУГОЕ. НУЖНО УСИЛИВАТЬ ДАВЛЕНИЕ. НУЖНО ПОВЫШАТЬ
Dialogue: 0,0:00:47.40,0:00:50.52,Caption,,0,0,0,,ЦЕНУ ДЛЯ МОСКВЫ. НУЖНО ПРОДОЛЖАТЬ ПОДДЕРЖКУ КИЕВА.
Dialogue: 0,0:00:50.76,0:00:53.40,Caption,,0,0,0,,НУЖНО ГОТОВИТЬСЯ НАДОЛГО. А ТЕПЕРЬ ВДРУГ ДАВАЙТЕ
Dialogue: 0,0:00:53.40,0:00:56.20,Caption,,0,0,0,,ЗАКАНЧИВАТЬ. ДАЖЕ АНГЛИЯ ДОБРАЛАСЬ ДО ЭТОЙ МЫСЛИ.
Dialogue: 0,0:00:56.44,0:00:58.92,Caption,,0,0,0,,ПРИЧЁМ ВЕДЬ БУКВАЛЬНО НЕДАВНО БРИТАНЦАМ ПОНАДОБИЛАСЬ
Dialogue: 0,0:00:58.92,0:01:02.44,Caption,,0,0,0,,ПРЯМАЯ СВЯЗЬ С МОСКВОЙ. ВОЕННЫЙ ТЕЛЕФОН. КАНАЛ,
Dialogue: 0,0:01:02.67,0:01:05.24,Caption,,0,0,0,,ПО КОТОРОМУ В СЛУЧАЕ ОПАСНОЙ СИТУАЦИИ МОЖНО БЫСТРО
Dialogue: 0,0:01:05.24,0:01:08.52,Caption,,0,0,0,,СВЯЗАТЬСЯ И ВЫЯСНИТЬ, КТО ЧТО СДЕЛАЛ И ЧТО ТЕПЕРЬ С ЭТИМ
Dialogue: 0,0:01:08.52,0:01:11.40,Caption,,0,0,0,,ДЕЛАТЬ. ТОГДА ЛОНДОН ВОВСЕ НЕ СОБИРАЛСЯ ПРЕКРАЩАТЬ
Dialogue: 0,0:01:11.40,0:01:17.77,Caption,,0,0,0,,ПОВЫШЕНИЕ СТАВОК. НАОБОРОТ. ЛОГИКА БЫЛА ИНТЕРЕСНАЯ. МЫ ПРОДОЛЖИМ
Dialogue: 0,0:01:17.77,0:01:21.05,Caption,,0,0,0,,ДЕЛАТЬ ВСЁ ТО ЖЕ САМОЕ, ТОЛЬКО ХОРОШО БЫ ИМЕТЬ НОМЕР ТЕЛЕФОНА,
Dialogue: 0,0:01:21.23,0:01:23.61,Caption,,0,0,0,,ЧТОБЫ В САМЫЙ НУЖНЫЙ МОМЕНТ СКАЗАТЬ РЕБЯТА,
Dialogue: 0,0:01:23.71,0:01:25.69,Caption,,0,0,0,,ВЫ ТАМ НЕ ПЕРЕПУТАЙТЕ, ЭТО НЕ МЫ.
Dialogue: 0,0:01:26.48,0:01:28.97,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ СЛЕДУЮЩИЙ ШАГ. ТЕЛЕФОН УЖЕ ЕСТЬ
Dialogue: 0,0:01:29.05,0:01:31.21,Caption,,0,0,0,,В ПОЛИТИЧЕСКОЙ ПОВЕСТКЕ. ТЕПЕРЬ ПОЯВИЛИСЬ
Dialogue: 0,0:01:31.21,0:01:34.65,Caption,,0,0,0,,ПЕРЕГОВОРЫ. ПОХОЖЕ, ЭСКАЛАЦИЯ ПОДОШЛА К ТОМУ РУБЕЖУ,
Dialogue: 0,0:01:34.97,0:01:37.21,Caption,,0,0,0,,ГДЕ ДАЖЕ САМЫМ БОДРЫМ СТАЛО ИНТЕРЕСНО,
Dialogue: 0,0:01:37.37,0:01:40.25,Caption,,0,0,0,,ЧТО НАХОДИТСЯ ЗА СЛЕДУЮЩЕЙ КРАСНОЙ ЛИНИЕЙ. ПОТОМУ
Dialogue: 0,0:01:40.33,0:01:42.49,Caption,,0,0,0,,ЧТО ОДНО ДЕЛО ГОДАМИ ДВИГАТЬ ЭТУ ЛИНИЮ ПО
Dialogue: 0,0:01:42.49,0:01:45.37,Caption,,0,0,0,,КАРТЕ. СОВСЕМ ДРУГОЕ ДЕЛО ОДНАЖДЫ ОБНАРУЖИТЬ,
Dialogue: 0,0:01:45.53,0:01:48.01,Caption,,0,0,0,,ЧТО ДАЛЬШЕ УЖЕ НЕ ОЧЕРЕДНОЕ ПРЕДУПРЕЖДЕНИЕ,
Dialogue: 0,0:01:48.17,0:01:52.33,Caption,,0,0,0,,А ПОСЛЕДСТВИЯ, КОТОРЫЕ ПРИЛЕТЯТ НЕПОСРЕДСТВЕННО ТЕБЕ. ТОГДА ТЕЛЕФОН
Dialogue: 0,0:01:52.33,0:01:55.21,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО СТАНОВИТСЯ ПОЛЕЗНОЙ ВЕЩЬЮ. ХОТЯ ТАКИМИ
Dialogue: 0,0:01:55.21,0:01:58.09,Caption,,0,0,0,,ТЕМПАМИ СКОРО ПОНАДОБИТСЯ УЖЕ НЕ ТЕЛЕФОН. БУНКЕР.
Dialogue: 0,0:01:58.73,0:02:01.85,Caption,,0,0,0,,САМОЕ СМЕШНОЕ, ЧТО БРИТАНИЯ ПРИ ЭТОМ НИ ОТ ЧЕГО ОСОБО
Dialogue: 0,0:02:01.93,0:02:04.49,Caption,,0,0,0,,НЕ ОТКАЗЫВАЕТСЯ. ВОЕННАЯ ПОДДЕРЖКА КИЕВА
Dialogue: 0,0:02:04.49,0:02:06.97,Caption,,0,0,0,,ПРОДОЛЖАЕТСЯ. БРИТАНСКИЕ ОБЯЗАТЕЛЬСТВА ПЕРЕД
Dialogue: 0,0:02:07.05,0:02:09.61,Caption,,0,0,0,,УКРАИНОЙ УЖЕ ИСЧИСЛЯЮТСЯ ДЕСЯТКАМИ МИЛЛИАРДОВ
Dialogue: 0,0:02:09.61,0:02:12.73,Caption,,0,0,0,,ФУНТОВ. ОБУЧЕНИЕ УКРАИНСКИХ ВОЕННЫХ ПРОДОЛЖАЕТСЯ.
Dialogue: 0,0:02:13.12,0:02:16.09,Caption,,0,0,0,,ЛОНДОН ВМЕСТЕ С ПАРИЖЕМ ОБСУЖДАЕТ БУДУЩИЕ ГАРАНТИИ И
Dialogue: 0,0:02:16.09,0:02:18.81,Caption,,0,0,0,,ПРИСУТСТВИЕ ИНОСТРАННЫХ СИЛ ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ.
Dialogue: 0,0:02:19.29,0:02:21.61,Caption,,0,0,0,,ТО ЕСТЬ ЭТО НЕ ПРЕВРАЩЕНИЕ ЯСТРЕБА В ГОЛУБЯ
Dialogue: 0,0:02:21.69,0:02:24.17,Caption,,0,0,0,,МИРА. ЯСТРЕБ ПРОСТО НАЧАЛ ИНТЕРЕСОВАТЬСЯ,
Dialogue: 0,0:02:24.34,0:02:26.73,Caption,,0,0,0,,ГДЕ БЛИЖАЙШИЙ ВЫХОД. И ЭТО УЖЕ ВАЖНО.
Dialogue: 0,0:02:29.02,0:02:31.58,Caption,,0,0,0,,ПОТОМУ ЧТО ВЕСЬ ПЯТЫЙ ГОД КОНФЛИКТА МЫ НАБЛЮДАЕМ
Dialogue: 0,0:02:31.58,0:02:34.06,Caption,,0,0,0,,ОДНУ И ТУ ЖЕ КАРТИНУ. СНАЧАЛА КАКОЕ ТО
Dialogue: 0,0:02:34.06,0:02:37.02,Caption,,0,0,0,,ДЕЙСТВИЕ ОБЪЯВЛЯЕТСЯ АБСОЛЮТНО НЕВОЗМОЖНЫМ. ПОТОМ
Dialogue: 0,0:02:37.10,0:02:40.06,Caption,,0,0,0,,ЕГО НАЧИНАЮТ ОСТОРОЖНО ОБСУЖДАТЬ. ПОТОМ ОБЪЯСНЯЮТ,
Dialogue: 0,0:02:40.14,0:02:43.42,Caption,,0,0,0,,ПОЧЕМУ ОНО НЕОБХОДИМО. А ЕЩЁ ЧЕРЕЗ НЕСКОЛЬКО МЕСЯЦЕВ
Dialogue: 0,0:02:43.42,0:02:46.94,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО БЕЗ НЕГО ВООБЩЕ НИКАК НЕЛЬЗЯ БЫЛО ОБОЙТИСЬ.
Dialogue: 0,0:02:47.40,0:02:50.78,Caption,,0,0,0,,ТАК ДВИГАЛАСЬ ПЛАНКА ЭСКАЛАЦИИ. ШАГ ЗА ШАГОМ. И
Dialogue: 0,0:02:50.78,0:02:55.10,Caption,,0,0,0,,СЕЙЧАС ЛОНДОН, ПОХОЖЕ, ПЕРВЫМ ИЗ САМЫХ АКТИВНЫХ ЕВРОПЕЙСКИХ ИГРОКОВ
Dialogue: 0,0:02:55.10,0:02:57.66,Caption,,0,0,0,,ПУБЛИЧНО ПРОИЗНОСИТ ПРОСТУЮ ВЕЩЬ ЗАКАНЧИВАТЬ ВСЁ
Dialogue: 0,0:02:57.74,0:03:00.30,Caption,,0,0,0,,РАВНО ПРИДЁТСЯ ПЕРЕГОВОРАМИ. ДО ПРИНЯТИЯ,
Dialogue: 0,0:03:00.45,0:03:04.70,Caption,,0,0,0,,КАК ГОВОРИТСЯ, ДОБРАЛИСЬ. С ОТРИЦАНИЕМ ТОЛЬКО НЕМНОГО ЗАТЯНУЛИ. А
Dialogue: 0,0:03:04.70,0:03:08.30,Caption,,0,0,0,,ТЕПЕРЬ ПОСМОТРИМ, НА КАКОМ ФОНЕ БРИТАНЦЕВ ПОТЯНУЛО К РАЗГОВОРУ.
Dialogue: 0,0:03:08.51,0:03:11.18,Caption,,0,0,0,,БЕЛОРУССКИЙ МИНИСТР ОБОРОНЫ ВИКТОР ХРЕНИН ГОВОРИТ,
Dialogue: 0,0:03:11.37,0:03:13.58,Caption,,0,0,0,,ЧТО У ГРАНИЦ БЕЛАРУСИ ЕВРОПЕЙСКИЕ СТРАНЫ
Dialogue: 0,0:03:13.58,0:03:17.10,Caption,,0,0,0,,СОВЕРШЕНСТВУЮТ ВОЕННУЮ ИНФРАСТРУКТУРУ И ЛОГИСТИКУ. И
Dialogue: 0,0:03:17.10,0:03:21.10,Caption,,0,0,0,,ТУТ УЖЕ НЕ ЛОЗУНГИ. АЭРОДРОМЫ. БАЗЫ ХРАНЕНИЯ. ПУНКТЫ
Dialogue: 0,0:03:21.10,0:03:24.14,Caption,,0,0,0,,УПРАВЛЕНИЯ. ПОДГОТОВКА МАРШРУТОВ. УЧЕНИЯ.
Dialogue: 0,0:03:24.33,0:03:27.34,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНАЯ АКТИВНОСТЬ. ЭТО ГОРАЗДО ИНТЕРЕСНЕЕ
Dialogue: 0,0:03:27.34,0:03:30.30,Caption,,0,0,0,,ОЧЕРЕДНОЙ РЕЧИ ПОЛИТИКА С ТРИБУНЫ. РЕЧЬ ЗАКОНЧИЛАСЬ,
Dialogue: 0,0:03:30.46,0:03:34.86,Caption,,0,0,0,,МИКРОФОН ВЫКЛЮЧИЛИ, ВСЕ ПОШЛИ УЖИНАТЬ. А АЭРОДРОМ ОСТАЛСЯ. СКЛАД
Dialogue: 0,0:03:34.86,0:03:37.74,Caption,,0,0,0,,ОСТАЛСЯ. ПУНКТ УПРАВЛЕНИЯ ТОЖЕ ПОЧЕМУ ТО ДОМОЙ НЕ
Dialogue: 0,0:03:37.74,0:03:43.29,Caption,,0,0,0,,УШЁЛ. БЕЛОРУССКАЯ СТОРОНА ГОВОРИТ ПРЯМО ЕВРОПЕЙЦЫ ГОТОВЯТ
Dialogue: 0,0:03:43.29,0:03:45.53,Caption,,0,0,0,,ИНФРАСТРУКТУРУ ДЛЯ ВОЕННОГО ПРОТИВОСТОЯНИЯ.
Dialogue: 0,0:03:45.85,0:03:50.57,Caption,,0,0,0,,ЕВРОПЕЙЦЫ, В СВОЮ ОЧЕРЕДЬ, ОБЪЯСНЯЮТ УСИЛЕНИЕ ВОСТОЧНОГО ФЛАНГА НЕОБХОДИМОСТЬЮ
Dialogue: 0,0:03:50.57,0:03:53.21,Caption,,0,0,0,,ЗАЩИЩАТЬСЯ ОТ РОССИИ И БЕЛАРУСИ. И ВОТ ТУТ
Dialogue: 0,0:03:53.29,0:03:56.41,Caption,,0,0,0,,ОБРАЗУЕТСЯ ПРЕКРАСНЫЙ ЗАМКНУТЫЙ КРУГ. ОДНИ СТРОЯТ
Dialogue: 0,0:03:56.41,0:04:00.57,Caption,,0,0,0,,ВОЕННУЮ ИНФРАСТРУКТУРУ, ПОТОМУ ЧТО БОЯТСЯ ВТОРЫХ. ВТОРЫЕ ВИДЯТ ЭТУ
Dialogue: 0,0:04:00.57,0:04:05.53,Caption,,0,0,0,,ИНФРАСТРУКТУРУ И УСИЛИВАЮТСЯ, ПОТОМУ ЧТО БОЯТСЯ ПЕРВЫХ. ПОСЛЕ ЭТОГО ПЕРВЫЕ СМОТРЯТ
Dialogue: 0,0:04:05.61,0:04:07.53,Caption,,0,0,0,,НА УСИЛЕНИЕ ВТОРЫХ И ГОВОРЯТ НУ ВОТ,
Dialogue: 0,0:04:07.69,0:04:10.89,Caption,,0,0,0,,МЫ ЖЕ ПРЕДУПРЕЖДАЛИ. ОЧЕНЬ УДОБНАЯ СИСТЕМА. РАБОТАЕТ
Dialogue: 0,0:04:10.89,0:04:14.57,Caption,,0,0,0,,САМА. ГЛАВНОЕ, ЧТОБЫ В КАКОЙ ТО МОМЕНТ НИКТО СЛУЧАЙНО НЕ
Dialogue: 0,0:04:14.65,0:04:16.89,Caption,,0,0,0,,РЕШИЛ ПРОВЕРИТЬ ЕЁ НА ПРАКТИКЕ. И ВОТ НА
Dialogue: 0,0:04:16.89,0:04:20.01,Caption,,0,0,0,,ЭТОМ ФОНЕ БРИТАНИЯ ВСПОМИНАЕТ О ПЕРЕГОВОРАХ. ПОЭТОМУ
Dialogue: 0,0:04:20.01,0:04:22.49,Caption,,0,0,0,,БРИТАНСКОЕ ЗАЯВЛЕНИЕ ИНТЕРЕСНО НЕ САМО ПО СЕБЕ.
Dialogue: 0,0:04:22.81,0:04:26.25,Caption,,0,0,0,,ИНТЕРЕСНО, КОГДА ОНО ПРОЗВУЧАЛО. ПОТОМУ ЧТО ПАРАЛЛЕЛЬНО
Dialogue: 0,0:04:26.25,0:04:29.93,Caption,,0,0,0,,НАЧИНАЕТ ТРЕЩАТЬ ЕЩЁ ОДНА КРАСИВАЯ КОНСТРУКЦИЯ. НАТО
Dialogue: 0,0:04:29.93,0:04:33.53,Caption,,0,0,0,,ОТМЕНИЛО САММИТ ЛИДЕРОВ, КОТОРЫЙ ДОЛЖЕН БЫЛ ПРОЙТИ В АЛБАНИИ В ДВЕ
Dialogue: 0,0:04:33.61,0:04:36.41,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ. ОБЪЯСНЕНИЯ ЗВУЧАТ
Dialogue: 0,0:04:36.41,0:04:39.37,Caption,,0,0,0,,АККУРАТНО. ГРАФИК СТАНЕТ ГИБЧЕ. ЛИДЕРЫ БУДУТ
Dialogue: 0,0:04:39.37,0:04:41.77,Caption,,0,0,0,,ВСТРЕЧАТЬСЯ ПО НЕОБХОДИМОСТИ. ВСЁ НОРМАЛЬНО,
Dialogue: 0,0:04:41.93,0:04:44.73,Caption,,0,0,0,,ПРОСТО РЕШИЛИ РЕЖЕ СОБИРАТЬСЯ БОЛЬШОЙ КОМПАНИЕЙ. НУ
Dialogue: 0,0:04:44.73,0:04:48.09,Caption,,0,0,0,,ДА. ОЧЕНЬ УДОБНО. ОСОБЕННО КОГДА ВНУТРИ КОМПАНИИ ВСЁ
Dialogue: 0,0:04:48.09,0:04:54.13,Caption,,0,0,0,,ТРУДНЕЕ ДОГОВОРИТЬСЯ. СРЕДИ ПРИЧИН ОТМЕНЫ САММИТА НАЗЫВАЮТ СПОРЫ ВОКРУГ
Dialogue: 0,0:04:54.13,0:04:58.13,Caption,,0,0,0,,УКРАИНЫ, ИРАНА И РАСХОДОВ НА ОБОРОНУ. НО ЕСТЬ ЦИФРА,
Dialogue: 0,0:04:58.22,0:05:00.69,Caption,,0,0,0,,КОТОРАЯ ГОВОРИТ ГОРАЗДО БОЛЬШЕ ЛЮБЫХ КРАСИВЫХ
Dialogue: 0,0:05:00.69,0:05:03.41,Caption,,0,0,0,,ЗАЯВЛЕНИЙ. ПРЕДЛОЖЕНИЕ ЕЖЕГОДНО ВЫДЕЛЯТЬ НА
Dialogue: 0,0:05:03.41,0:05:05.97,Caption,,0,0,0,,ПОДДЕРЖКУ УКРАИНЫ ЧЕТВЕРТЬ ПРОЦЕНТА ВАЛОВОГО
Dialogue: 0,0:05:05.97,0:05:08.69,Caption,,0,0,0,,ВНУТРЕННЕГО ПРОДУКТА ПОДДЕРЖАЛИ ТОЛЬКО СЕМЬ
Dialogue: 0,0:05:08.69,0:05:12.53,Caption,,0,0,0,,ГОСУДАРСТВ НАТО ИЗ ТРИДЦАТИ ДВУХ. СЕМЬ. ИЗ ТРИДЦАТИ
Dialogue: 0,0:05:12.61,0:05:15.01,Caption,,0,0,0,,ДВУХ. ВОТ ТУТ ЗАКАНЧИВАЮТСЯ РЕЧИ О НЕРУШИМОМ
Dialogue: 0,0:05:15.01,0:05:17.97,Caption,,0,0,0,,ЕДИНСТВЕ И НАЧИНАЕТСЯ БУХГАЛТЕРИЯ. ПОКА НУЖНО
Dialogue: 0,0:05:17.97,0:05:21.97,Caption,,0,0,0,,ВЫСТУПИТЬ ВОЗЛЕ ФЛАГОВ, ВСЕ ВМЕСТЕ. ПОКА НУЖНО НАПИСАТЬ ЗАЯВЛЕНИЕ,
Dialogue: 0,0:05:22.05,0:05:25.01,Caption,,0,0,0,,ТОЖЕ ПРОБЛЕМ ОСОБЫХ НЕТ. А КОГДА ПОЯВЛЯЕТСЯ СТРОЧКА
Dialogue: 0,0:05:25.09,0:05:27.49,Caption,,0,0,0,,СКОЛЬКО КОНКРЕТНО ВЫ ГОТОВЫ ПЛАТИТЬ КАЖДЫЙ ГОД,
Dialogue: 0,0:05:27.89,0:05:30.93,Caption,,0,0,0,,ХОР НЕОЖИДАННО СТАНОВИТСЯ КАМЕРНЫМ АНСАМБЛЕМ. И ЭТО
Dialogue: 0,0:05:30.94,0:05:33.81,Caption,,0,0,0,,ОЧЕНЬ ВАЖНЫЙ МОМЕНТ. ПОТОМУ ЧТО ЗЕЛЕНСКИЙ КАК РАЗ
Dialogue: 0,0:05:33.81,0:05:36.61,Caption,,0,0,0,,РАССЧИТЫВАЕТ СОБРАТЬ ЕДИНУЮ ЕВРОПЕЙСКУЮ ПОЗИЦИЮ
Dialogue: 0,0:05:36.69,0:05:39.65,Caption,,0,0,0,,ПЕРЕД ПЕРЕГОВОРАМИ С РОССИЕЙ. ТРИДЦАТЬ СЕМЬ СТРАН В
Dialogue: 0,0:05:39.65,0:05:41.81,Caption,,0,0,0,,ТАК НАЗЫВАЕМОЙ КОАЛИЦИИ ЖЕЛАЮЩИХ ДОЛЖНЫ
Dialogue: 0,0:05:41.81,0:05:45.17,Caption,,0,0,0,,ДОГОВОРИТЬСЯ, ЧЕГО ИМЕННО ЕВРОПА ХОЧЕТ И С ЧЕМ ОНА
Dialogue: 0,0:05:45.17,0:05:48.13,Caption,,0,0,0,,ПОЙДЁТ ЗА ПЕРЕГОВОРНЫЙ СТОЛ. ТРИДЦАТЬ СЕМЬ СТРАН.
Dialogue: 0,0:05:48.39,0:05:51.73,Caption,,0,0,0,,ЗВУЧИТ СОЛИДНО. ОСТАЛАСЬ МЕЛОЧЬ. ЭТИМ ТРИДЦАТИ СЕМИ
Dialogue: 0,0:05:51.73,0:05:53.97,Caption,,0,0,0,,СТРАНАМ ЕЩЁ НАДО ДОГОВОРИТЬСЯ МЕЖДУ СОБОЙ.
Dialogue: 0,0:05:56.25,0:05:58.65,Caption,,0,0,0,,ЕСЛИ В НАТО ИЗ ТРИДЦАТИ ДВУХ ТОЛЬКО СЕМЬ
Dialogue: 0,0:05:58.73,0:06:01.45,Caption,,0,0,0,,ГОТОВЫ ПОДДЕРЖАТЬ КОНКРЕТНОЕ ФИНАНСОВОЕ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:06:01.85,0:06:05.61,Caption,,0,0,0,,ТО ПРЕДСТАВИТЬ, КАК БЫСТРО ТРИДЦАТЬ СЕМЬ ПРАВИТЕЛЬСТВ ДОГОВОРЯТСЯ О
Dialogue: 0,0:06:05.61,0:06:08.57,Caption,,0,0,0,,ТЕРРИТОРИЯХ, НАТО, ИНОСТРАННЫХ ВОЙСКАХ,
Dialogue: 0,0:06:08.81,0:06:11.61,Caption,,0,0,0,,ГАРАНТИЯХ БЕЗОПАСНОСТИ, САНКЦИЯХ И ДЕНЬГАХ,
Dialogue: 0,0:06:11.77,0:06:16.89,Caption,,0,0,0,,СОВСЕМ НЕСЛОЖНО. НАВЕРНОЕ, МИНУТ ЗА ДВАДЦАТЬ. ОСТАНЕТСЯ КОФЕ ДОПИТЬ. НО
Dialogue: 0,0:06:16.89,0:06:19.85,Caption,,0,0,0,,ЗЕЛЕНСКОМУ ТАКАЯ БОЛЬШАЯ ЕВРОПЕЙСКАЯ КОМПАНИЯ НУЖНА.
Dialogue: 0,0:06:20.05,0:06:22.33,Caption,,0,0,0,,ПОТОМУ ЧТО ЧЕМ БОЛЬШЕ УЧАСТНИКОВ СТОЯТ РЯДОМ С
Dialogue: 0,0:06:22.41,0:06:25.77,Caption,,0,0,0,,КИЕВОМ, ТЕМ ТРУДНЕЕ ПРЕВРАТИТЬ ПЕРЕГОВОРЫ В РАЗГОВОР МОСКВЫ
Dialogue: 0,0:06:25.85,0:06:29.45,Caption,,0,0,0,,И ВАШИНГТОНА, ПОСЛЕ КОТОРОГО УКРАИНЕ ПРИНЕСУТ ИТОГОВЫЙ ДОКУМЕНТ И
Dialogue: 0,0:06:29.45,0:06:33.53,Caption,,0,0,0,,РУЧКУ. КИЕВ ХОЧЕТ СИДЕТЬ ЗА СТОЛОМ. ЕВРОПА ХОЧЕТ СИДЕТЬ
Dialogue: 0,0:06:33.61,0:06:36.81,Caption,,0,0,0,,ЗА СТОЛОМ. КАЖДАЯ КРУПНАЯ ЕВРОПЕЙСКАЯ СТОЛИЦА ТОЖЕ
Dialogue: 0,0:06:36.81,0:06:39.53,Caption,,0,0,0,,ХОЧЕТ СИДЕТЬ ЗА СТОЛОМ. СКОРО ПОНАДОБИТСЯ СТОЛ
Dialogue: 0,0:06:39.53,0:06:41.85,Caption,,0,0,0,,РАЗМЕРОМ С ФУТБОЛЬНОЕ ПОЛЕ. ТОЛЬКО ЕСТЬ ОДНА
Dialogue: 0,0:06:41.85,0:06:43.93,Caption,,0,0,0,,ПРОБЛЕМА. ЧТОБЫ СИДЕТЬ ЗА СТОЛОМ,
Dialogue: 0,0:06:44.04,0:06:46.57,Caption,,0,0,0,,МАЛО ПРИНЕСТИ СТУЛ. НУЖНО ЕЩЁ ПОНИМАТЬ,
Dialogue: 0,0:06:46.70,0:06:49.61,Caption,,0,0,0,,КАКУЮ ПОЗИЦИЮ ТЫ ПРЕДСТАВЛЯЕШЬ. А ВОТ С ЭТИМ
Dialogue: 0,0:06:49.69,0:06:52.73,Caption,,0,0,0,,У ЕВРОПЫ НАЧИНАЮТСЯ ПРИКЛЮЧЕНИЯ. МАКРОН ПРОДОЛЖАЕТ
Dialogue: 0,0:06:52.73,0:06:56.81,Caption,,0,0,0,,УБЕЖДАТЬ ФРАНЦУЗОВ, ЧТО ПОДДЕРЖКА УКРАИНЫ ЯВЛЯЕТСЯ ВОПРОСОМ БЕЗОПАСНОСТИ
Dialogue: 0,0:06:56.81,0:06:59.93,Caption,,0,0,0,,САМОЙ ФРАНЦИИ. ЛОГИКА ПРОСТАЯ. ЕСЛИ УКРАИНА
Dialogue: 0,0:06:59.93,0:07:02.81,Caption,,0,0,0,,ПРОИГРАЕТ, ЕВРОПА СТАНЕТ СЛАБЕЕ. ЗНАЧИТ,
Dialogue: 0,0:07:02.89,0:07:06.17,Caption,,0,0,0,,ФИНАНСИРОВАТЬ КИЕВ НУЖНО ДАЛЬШЕ. РОБЕРТ ФИЦО СМОТРИТ
Dialogue: 0,0:07:06.17,0:07:08.65,Caption,,0,0,0,,НА ТУ ЖЕ СИТУАЦИЮ И ГОВОРИТ ПРОТИВОПОЛОЖНОЕ.
Dialogue: 0,0:07:10.93,0:07:13.57,Caption,,0,0,0,,СЛОВАКИЯ ГОТОВА УЧАСТВОВАТЬ В ЕВРОПЕЙСКОМ РАЗГОВОРЕ
Dialogue: 0,0:07:13.57,0:07:16.93,Caption,,0,0,0,,О МИРЕ, НО НОВЫЙ ВОЕННЫЙ КРЕДИТ УКРАИНЕ ПОДДЕРЖИВАТЬ НЕ
Dialogue: 0,0:07:16.93,0:07:20.29,Caption,,0,0,0,,БУДЕТ. ДВА ЕВРОПЕЙСКИХ ЛИДЕРА. ОБА ГОВОРЯТ О МИРЕ.
Dialogue: 0,0:07:20.61,0:07:24.13,Caption,,0,0,0,,ОДИН СЧИТАЕТ, ЧТО К МИРУ ВЕДЁТ ПРОДОЛЖЕНИЕ ВОЕННОЙ ПОДДЕРЖКИ.
Dialogue: 0,0:07:24.45,0:07:28.13,Caption,,0,0,0,,ВТОРОЙ СЧИТАЕТ, ЧТО ОЧЕРЕДНОЙ ВОЕННЫЙ КРЕДИТ ВЕДЁТ СОВСЕМ НЕ ТУДА.
Dialogue: 0,0:07:28.52,0:07:31.17,Caption,,0,0,0,,ВОТ ВАМ ЕДИНАЯ ЕВРОПЕЙСКАЯ ПОЗИЦИЯ В НАТУРАЛЬНУЮ
Dialogue: 0,0:07:31.25,0:07:34.13,Caption,,0,0,0,,ВЕЛИЧИНУ. НО ОСОБЕННО КРАСИВО ВСЁ ЭТО ВЫГЛЯДИТ ВО
Dialogue: 0,0:07:34.13,0:07:37.25,Caption,,0,0,0,,ФРАНЦИИ. РЕЙТИНГ ОДОБРЕНИЯ МАКРОНА ОПУСТИЛСЯ ДО
Dialogue: 0,0:07:37.25,0:07:40.29,Caption,,0,0,0,,ЧЕТЫРНАДЦАТИ ПРОЦЕНТОВ. ВОСЕМЬДЕСЯТ ТРИ ПРОЦЕНТА
Dialogue: 0,0:07:40.29,0:07:42.69,Caption,,0,0,0,,ОПРОШЕННЫХ ОЦЕНИВАЮТ ЕГО РАБОТУ ОТРИЦАТЕЛЬНО.
Dialogue: 0,0:07:42.94,0:07:45.57,Caption,,0,0,0,,ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ПОДДЕРЖКИ. И С ЭТОЙ
Dialogue: 0,0:07:45.57,0:07:48.21,Caption,,0,0,0,,ВЕЛИКОЛЕПНОЙ СТАРТОВОЙ ПЛОЩАДКИ МАКРОН СОБИРАЕТСЯ
Dialogue: 0,0:07:48.21,0:07:49.97,Caption,,0,0,0,,ОБЪЯСНЯТЬ НЕ ТОЛЬКО ФРАНЦУЗАМ,
Dialogue: 0,0:07:50.21,0:07:54.45,Caption,,0,0,0,,НО И ВСЕЙ ЕВРОПЕ, КУДА ИДТИ ДАЛЬШЕ. ТЫ СНАЧАЛА С ФРАНЦИЕЙ СВОЕЙ
Dialogue: 0,0:07:54.45,0:07:57.17,Caption,,0,0,0,,РАЗБЕРИСЬ. ПОТОМУ ЧТО У ФРАНЦУЗОВ НА ПЕРВОМ МЕСТЕ
Dialogue: 0,0:07:57.17,0:08:00.13,Caption,,0,0,0,,СОВСЕМ ДРУГИЕ ПРОБЛЕМЫ. ПОКУПАТЕЛЬНАЯ СПОСОБНОСТЬ.
Dialogue: 0,0:08:00.37,0:08:04.13,Caption,,0,0,0,,СОЦИАЛЬНАЯ СИСТЕМА. ГОСУДАРСТВЕННЫЙ ДОЛГ. БЮДЖЕТНЫЙ
Dialogue: 0,0:08:04.13,0:08:07.41,Caption,,0,0,0,,ДЕФИЦИТ. ТО ЕСТЬ ОБЫЧНЫЙ ФРАНЦУЗ СМОТРИТ В КОШЕЛЁК,
Dialogue: 0,0:08:07.57,0:08:12.05,Caption,,0,0,0,,СМОТРИТ НА СЧЕТА, СМОТРИТ НА СОСТОЯНИЕ БЮДЖЕТА. А ЕМУ ОБЪЯСНЯЮТ,
Dialogue: 0,0:08:12.21,0:08:16.37,Caption,,0,0,0,,ЧТО НУЖНО ЕЩЁ ПОТЕРПЕТЬ, ПОТОМУ ЧТО ВСЁ ЭТО ВОПРОС БОЛЬШОЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:08:16.37,0:08:18.93,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ОБЪЯСНЯТЬ, КОНЕЧНО,
Dialogue: 0,0:08:19.01,0:08:21.73,Caption,,0,0,0,,МОЖНО. ТОЛЬКО ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ПОДДЕРЖКИ
Dialogue: 0,0:08:21.73,0:08:24.53,Caption,,0,0,0,,ПОКАЗЫВАЮТ, НАСКОЛЬКО УБЕДИТЕЛЬНО ПОЛУЧАЕТСЯ.
Dialogue: 0,0:08:26.74,0:08:29.14,Caption,,0,0,0,,И ВОТ НА ЭТОМ ФОНЕ БЫВШИЙ КАНЦЛЕР ГЕРМАНИИ
Dialogue: 0,0:08:29.14,0:08:32.10,Caption,,0,0,0,,ОЛАФ ШОЛЬЦ ГОВОРИТ ЕЩЁ ОДНУ НЕПРИЯТНУЮ ДЛЯ ПРЕЖНЕЙ
Dialogue: 0,0:08:32.10,0:08:35.54,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ ЛИНИИ ВЕЩЬ. РОССИЯ НИКУДА НЕ ИСЧЕЗНЕТ.
Dialogue: 0,0:08:35.87,0:08:38.90,Caption,,0,0,0,,ЭТО БОЛЬШАЯ ЯДЕРНАЯ ДЕРЖАВА С СЕРЬЁЗНЫМ ВОЕННЫМ
Dialogue: 0,0:08:38.90,0:08:41.78,Caption,,0,0,0,,ПОТЕНЦИАЛОМ. И ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ ВСЁ РАВНО
Dialogue: 0,0:08:41.78,0:08:44.82,Caption,,0,0,0,,ПРИДЁТСЯ ОБСУЖДАТЬ С ЕЁ УЧАСТИЕМ. ВОТ ВЕДЬ ОТКРЫТИЕ.
Dialogue: 0,0:08:44.98,0:08:46.58,Caption,,0,0,0,,ПЯТЬ ЛЕТ МОЖНО БЫЛО РАССКАЗЫВАТЬ,
Dialogue: 0,0:08:46.82,0:08:49.46,Caption,,0,0,0,,ЧТО РОССИЮ НУЖНО ИЗОЛИРОВАТЬ, ОСЛАБИТЬ,
Dialogue: 0,0:08:49.70,0:08:52.50,Caption,,0,0,0,,ВЫТОЛКНУТЬ КУДА НИБУДЬ ЗА КРАЙ ЕВРОПЕЙСКОЙ ПОЛИТИКИ.
Dialogue: 0,0:08:52.65,0:08:57.46,Caption,,0,0,0,,А ПОТОМ ВЫЯСНЯЕТСЯ, ЧТО ГЕОГРАФИЯ УПРЯМАЯ ШТУКА. РОССИЯ КАК ЛЕЖАЛА РЯДОМ
Dialogue: 0,0:08:57.54,0:09:00.50,Caption,,0,0,0,,С ЕВРОПОЙ, ТАК И ЛЕЖИТ. ТОЛЬКО ТЕПЕРЬ ВОКРУГ ЕЩЁ И
Dialogue: 0,0:09:00.58,0:09:03.46,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЫ СТАЛО БОЛЬШЕ. ШОЛЬЦ ПРИ ЭТОМ
Dialogue: 0,0:09:03.54,0:09:06.02,Caption,,0,0,0,,ГОВОРИТ НЕ О КАКИХ ТО ОСОБЫХ ГЕРМАНСКИХ ОТНОШЕНИЯХ
Dialogue: 0,0:09:06.10,0:09:09.14,Caption,,0,0,0,,С МОСКВОЙ. ОН ПРЕДЛАГАЕТ ЕВРОПЕЙСКИЙ ФОРМАТ. НО ТУТ
Dialogue: 0,0:09:09.14,0:09:11.70,Caption,,0,0,0,,СНОВА ВОЗВРАЩАЕМСЯ К ВОПРОСУ А ГДЕ ЭТА ЕДИНАЯ
Dialogue: 0,0:09:11.70,0:09:13.70,Caption,,0,0,0,,ЕВРОПА, КОТОРАЯ БУДЕТ ГОВОРИТЬ?
Dialogue: 0,0:09:14.02,0:09:17.38,Caption,,0,0,0,,МАКРОН ГОВОРИТ ОДНО. ФИЦО ДРУГОЕ. ВНУТРИ НАТО ПО
Dialogue: 0,0:09:17.38,0:09:19.86,Caption,,0,0,0,,ФИНАНСИРОВАНИЮ УКРАИНЫ СЕМЬ ИЗ ТРИДЦАТИ ДВУХ.
Dialogue: 0,0:09:20.18,0:09:22.26,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СОБИРАЕТ ТРИДЦАТЬ СЕМЬ СТРАН,
Dialogue: 0,0:09:22.42,0:09:25.46,Caption,,0,0,0,,ЧТОБЫ ВЫРАБОТАТЬ ЕЩЁ ОДНУ ОБЩУЮ ПОЗИЦИЮ. И ВСЕ
Dialogue: 0,0:09:25.46,0:09:28.82,Caption,,0,0,0,,ХОТЯТ ЕДИНСТВА. ОСОБЕННО ДО ПЕРВОГО СЧЁТА. У ШОЛЬЦА
Dialogue: 0,0:09:28.82,0:09:31.86,Caption,,0,0,0,,ЕСТЬ И ВТОРАЯ ВАЖНАЯ МЫСЛЬ. ЕВРОПА СЛИШКОМ ДОЛГО
Dialogue: 0,0:09:31.86,0:09:34.34,Caption,,0,0,0,,РАЗГОВАРИВАЛА СО СТРАНАМИ ГЛОБАЛЬНОГО ЮГА ТАК,
Dialogue: 0,0:09:34.58,0:09:38.74,Caption,,0,0,0,,БУДТО БРЮССЕЛЬ УЖЕ ВСЁ РЕШИЛ, А ОСТАЛЬНЫМ ОСТАЛОСЬ ТОЛЬКО ПОСТАВИТЬ ПОДПИСЬ.
Dialogue: 0,0:09:41.00,0:09:44.76,Caption,,0,0,0,,РОССИЯ ПЛОХАЯ. МЫ ХОРОШИЕ. ВОТ ДОКУМЕНТ. ПОДПИШИТЕ
Dialogue: 0,0:09:44.76,0:09:48.04,Caption,,0,0,0,,ЗДЕСЬ. А ИНДИЯ ПОЧЕМУ ТО НЕ ПОДПИСЫВАЕТ. КИТАЙ
Dialogue: 0,0:09:48.12,0:09:51.16,Caption,,0,0,0,,ТОЖЕ НЕ ТОРОПИТСЯ. СТРАНЫ АФРИКИ НАЧИНАЮТ ЗАДАВАТЬ
Dialogue: 0,0:09:51.24,0:09:54.04,Caption,,0,0,0,,СВОИ ВОПРОСЫ. ГОСУДАРСТВА БЛИЖНЕГО ВОСТОКА ВООБЩЕ
Dialogue: 0,0:09:54.12,0:09:56.60,Caption,,0,0,0,,СМОТРЯТ НА ВСЁ ЭТО ЧЕРЕЗ СОБСТВЕННЫЕ ИНТЕРЕСЫ. И
Dialogue: 0,0:09:56.68,0:09:59.48,Caption,,0,0,0,,ВДРУГ ВЫЯСНЯЕТСЯ СТРАШНОЕ У ДРУГИХ СТРАН ЕСТЬ СВОЯ
Dialogue: 0,0:09:59.48,0:10:01.96,Caption,,0,0,0,,ВНЕШНЯЯ ПОЛИТИКА. КТО БЫ МОГ ПОДУМАТЬ.
Dialogue: 0,0:10:02.20,0:10:04.52,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ДАЛЬШЕ
Dialogue: 0,0:10:04.52,0:10:07.72,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ ГЛАВНОЕ. ВСЕ ЭТИ ЕВРОПЕЙСКИЕ СПОРЫ
Dialogue: 0,0:10:07.72,0:10:10.45,Caption,,0,0,0,,УПИРАЮТСЯ НЕ ПРОСТО В УКРАИНУ. МОСКВА СНОВА
Dialogue: 0,0:10:10.45,0:10:15.16,Caption,,0,0,0,,ПОДНИМАЕТ ВОПРОС О ТОМ, КАК ВООБЩЕ ДОЛЖНА ВЫГЛЯДЕТЬ БЕЗОПАСНОСТЬ ЕВРОПЫ. В
Dialogue: 0,0:10:15.16,0:10:17.72,Caption,,0,0,0,,ОБСУЖДАЕМОЙ ВЕРСИИ РОССИЙСКИХ ТРЕБОВАНИЙ ФИГУРИРУЕТ
Dialogue: 0,0:10:17.72,0:10:20.52,Caption,,0,0,0,,ДАЖЕ БРИТАНСКИЙ ЯДЕРНЫЙ ЩИТ. КРОМЕ ЭТОГО,
Dialogue: 0,0:10:20.84,0:10:23.64,Caption,,0,0,0,,РЕЧЬ ИДЁТ О СОКРАЩЕНИИ ВОЕННОЙ ИНФРАСТРУКТУРЫ НАТО В
Dialogue: 0,0:10:23.72,0:10:27.24,Caption,,0,0,0,,ВОСТОЧНОЙ ЕВРОПЕ, ОТКАЗЕ УКРАИНЫ ОТ ЧЛЕНСТВА В АЛЬЯНСЕ,
Dialogue: 0,0:10:27.41,0:10:30.21,Caption,,0,0,0,,ИНОСТРАННЫХ ВОЙСКАХ И ПОСТАВКАХ ЗАПАДНОГО ОРУЖИЯ.
Dialogue: 0,0:10:30.53,0:10:33.33,Caption,,0,0,0,,СНОВА ОБСУЖДАЕТСЯ РОССИЙСКОЕ ТРЕБОВАНИЕ ВЕРНУТЬСЯ К
Dialogue: 0,0:10:33.33,0:10:36.36,Caption,,0,0,0,,КОНФИГУРАЦИИ НАТО ДЕВЯНОСТО СЕДЬМОГО ГОДА. СУТЬ ВОТ
Dialogue: 0,0:10:36.45,0:10:41.00,Caption,,0,0,0,,В ЧЁМ. МОСКВА СЧИТАЕТ, ЧТО УКРАИНСКИЙ КОНФЛИКТ НЕВОЗМОЖНО ОКОНЧАТЕЛЬНО
Dialogue: 0,0:10:41.00,0:10:45.00,Caption,,0,0,0,,УРЕГУЛИРОВАТЬ, ЕСЛИ ОСТАВИТЬ НЕТРОНУТОЙ ТУ СИСТЕМУ БЕЗОПАСНОСТИ,
Dialogue: 0,0:10:45.26,0:10:47.33,Caption,,0,0,0,,КОТОРУЮ САМА РОССИЯ СЧИТАЕТ УГРОЗОЙ.
Dialogue: 0,0:10:47.94,0:10:50.68,Caption,,0,0,0,,И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ НАСТОЯЩАЯ ПРОБЛЕМА. ПОТОМУ
Dialogue: 0,0:10:50.68,0:10:53.33,Caption,,0,0,0,,ЧТО НАТО НЕ СОБИРАЕТСЯ ПРОСТО ВЗЯТЬ И СОГЛАСИТЬСЯ.
Dialogue: 0,0:10:55.61,0:10:57.93,Caption,,0,0,0,,ДЛЯ МОСКВЫ ГАРАНТИИ БЕЗОПАСНОСТИ ОЗНАЧАЮТ
Dialogue: 0,0:10:57.93,0:11:00.65,Caption,,0,0,0,,ОГРАНИЧЕНИЯ ВОЕННОЙ ИНФРАСТРУКТУРЫ АЛЬЯНСА ВОЗЛЕ
Dialogue: 0,0:11:00.73,0:11:03.69,Caption,,0,0,0,,РОССИЙСКИХ ГРАНИЦ. ДЛЯ НАТО БЕЗОПАСНОСТЬ ОЗНАЧАЕТ
Dialogue: 0,0:11:03.77,0:11:06.81,Caption,,0,0,0,,КАК РАЗ ВОЗМОЖНОСТЬ ЭТУ ИНФРАСТРУКТУРУ СОХРАНЯТЬ. ТО
Dialogue: 0,0:11:06.89,0:11:10.25,Caption,,0,0,0,,ЕСТЬ СЛОВО ОДНО. БЕЗОПАСНОСТЬ. А СМЫСЛ У КАЖДОЙ
Dialogue: 0,0:11:10.33,0:11:12.97,Caption,,0,0,0,,СТОРОНЫ СВОЙ. ВОТ ПОЧЕМУ МОЖНО ХОТЬ ДЕСЯТЬ РАЗ
Dialogue: 0,0:11:13.05,0:11:14.65,Caption,,0,0,0,,ДОГОВОРИТЬСЯ О КРАСИВОЙ ВСТРЕЧЕ,
Dialogue: 0,0:11:14.89,0:11:17.29,Caption,,0,0,0,,ВЫПУСТИТЬ СОВМЕСТНУЮ ФОТОГРАФИЮ И РАССКАЗАТЬ,
Dialogue: 0,0:11:17.46,0:11:19.29,Caption,,0,0,0,,ЧТО ПЕРЕГОВОРЫ БЫЛИ КОНСТРУКТИВНЫМИ.
Dialogue: 0,0:11:19.85,0:11:21.69,Caption,,0,0,0,,КОГДА ДОЙДЁТ ДО КОНКРЕТНЫХ ПУНКТОВ,
Dialogue: 0,0:11:21.89,0:11:24.73,Caption,,0,0,0,,ТАМ НАЧИНАЕТСЯ СОВСЕМ ДРУГОЙ РАЗГОВОР. ХОТИТЕ ИМЕТЬ
Dialogue: 0,0:11:24.73,0:11:28.41,Caption,,0,0,0,,НАТО? ПОЖАЛУЙСТА. ФОРМУ ГЛАДЬТЕ. НА ПАРАДАХ ХОДИТЕ.
Dialogue: 0,0:11:28.64,0:11:31.13,Caption,,0,0,0,,ТАНЧИКИ ПОКАЗЫВАЙТЕ. А ВОТ РАКЕТЫ,
Dialogue: 0,0:11:31.27,0:11:34.17,Caption,,0,0,0,,БАЗЫ И ВОЕННАЯ ИНФРАСТРУКТУРА У РОССИЙСКИХ ГРАНИЦ
Dialogue: 0,0:11:34.25,0:11:36.73,Caption,,0,0,0,,МОСКВА ТРЕБУЕТ УБРАТЬ. И ЧТО НА ЭТО ОТВЕТИТ
Dialogue: 0,0:11:36.81,0:11:40.01,Caption,,0,0,0,,НАТО? НЕТ. ВОТ ВАМ ВСЯ ПРОБЛЕМА В ДВУХ БУКВАХ.
Dialogue: 0,0:11:40.41,0:11:42.89,Caption,,0,0,0,,ПОЭТОМУ ДАЖЕ ЕСЛИ УКРАИНСКАЯ ЧАСТЬ КОГДА НИБУДЬ
Dialogue: 0,0:11:42.89,0:11:46.97,Caption,,0,0,0,,СДВИНЕТСЯ, ЕВРОПЕЙСКАЯ СИСТЕМА БЕЗОПАСНОСТИ ОСТАНЕТСЯ ОГРОМНЫМ
Dialogue: 0,0:11:46.97,0:11:50.17,Caption,,0,0,0,,ОТДЕЛЬНЫМ УЗЛОМ. И ИМЕННО ПОЭТОМУ ИНТЕРЕСНА НОВАЯ
Dialogue: 0,0:11:50.17,0:11:52.97,Caption,,0,0,0,,БРИТАНСКАЯ РИТОРИКА. ПОТОМУ ЧТО ЛОНДОН ПРЕКРАСНО
Dialogue: 0,0:11:52.97,0:11:56.09,Caption,,0,0,0,,ПОНИМАЕТ, ЧТО РАЗГОВОР ИДЁТ УЖЕ НЕ ТОЛЬКО О ДОНБАССЕ
Dialogue: 0,0:11:56.09,0:11:59.53,Caption,,0,0,0,,ИЛИ О ТОМ, ГДЕ БУДЕТ ПРОХОДИТЬ КАКАЯ ТО ЛИНИЯ. ЕСЛИ В
Dialogue: 0,0:11:59.53,0:12:02.01,Caption,,0,0,0,,ПЕРЕГОВОРЫ ЗАЛЕЗАЕТ БРИТАНСКИЙ ЯДЕРНЫЙ ФАКТОР,
Dialogue: 0,0:12:02.33,0:12:05.13,Caption,,0,0,0,,ЭТО УЖЕ РАЗГОВОР НЕПОСРЕДСТВЕННО О БРИТАНИИ. И ВОТ
Dialogue: 0,0:12:05.21,0:12:07.85,Caption,,0,0,0,,ТУТ ЧУЖАЯ ПРОБЛЕМА ВНЕЗАПНО СТАНОВИТСЯ СВОЕЙ.
Dialogue: 0,0:12:10.14,0:12:12.86,Caption,,0,0,0,,А ЗЕЛЕНСКИЙ ТЕМ ВРЕМЕНЕМ НЕ УНИМАЕТСЯ. ТЕПЕРЬ ОН
Dialogue: 0,0:12:12.86,0:12:15.58,Caption,,0,0,0,,ОПЯТЬ ПРЕДЛАГАЕТ ЗАСТАВИТЬ РОССИЮ ПОЙТИ НА УСТУПКИ.
Dialogue: 0,0:12:15.79,0:12:19.66,Caption,,0,0,0,,КАК? НОВЫЕ САНКЦИИ. АМЕРИКАНСКОЕ ОРУЖИЕ. ВЕЛИКОЛЕПНО.
Dialogue: 0,0:12:19.95,0:12:23.50,Caption,,0,0,0,,КАКИЕ ЕЩЁ САНКЦИИ? А ВСЕ ПРЕДЫДУЩИЕ ПАКЕТЫ ЧЕМ ЗАНИМАЛИСЬ?
Dialogue: 0,0:12:23.51,0:12:27.42,Caption,,0,0,0,,РАЗМИНАЛИСЬ? ЕВРОПА УЖЕ ПРИНИМАЛА ПАКЕТ ЗА ПАКЕТОМ. ОРУЖИЕ НА
Dialogue: 0,0:12:27.50,0:12:30.14,Caption,,0,0,0,,УКРАИНУ ШЛО ГОДАМИ. И ТЕПЕРЬ НАМ ОБЪЯСНЯЮТ,
Dialogue: 0,0:12:30.46,0:12:33.18,Caption,,0,0,0,,ЧТО НУЖЕН ЕЩЁ ОДИН ПРАВИЛЬНЫЙ КОМПЛЕКТ САНКЦИЙ И
Dialogue: 0,0:12:33.18,0:12:37.02,Caption,,0,0,0,,ВООРУЖЕНИЙ, ПОСЛЕ КОТОРОГО МОСКВА НАКОНЕЦ СТАНЕТ УСТУПЧИВОЙ. НУ
Dialogue: 0,0:12:37.02,0:12:40.06,Caption,,0,0,0,,КОНЕЧНО. СТУДИЯ ДЕВЯНОСТО ПЯТЫЙ КВАРТАЛ ПРОДОЛЖАЕТ
Dialogue: 0,0:12:40.14,0:12:43.18,Caption,,0,0,0,,РАБОТАТЬ. КРЕАТИВА ТАМ ХОТЬ ОТБАВЛЯЙ. ЕСЛИ СВОИХ
Dialogue: 0,0:12:43.18,0:12:47.10,Caption,,0,0,0,,ИДЕЙ НЕ ХВАТИТ, БРИТАНСКИЕ ДРУЗЬЯ ПОДСКАЖУТ. ТОЛЬКО ЗЕЛЕНСКИЙ ЗДЕСЬ
Dialogue: 0,0:12:47.18,0:12:49.90,Caption,,0,0,0,,ДЕЙСТВУЕТ ВПОЛНЕ ПОНЯТНО. ЕМУ НЕЛЬЗЯ ИСЧЕЗНУТЬ ИЗ
Dialogue: 0,0:12:49.90,0:12:52.22,Caption,,0,0,0,,ПЕРЕГОВОРНОЙ КОНСТРУКЦИИ. ПОКА ВАШИНГТОН
Dialogue: 0,0:12:52.22,0:12:55.82,Caption,,0,0,0,,РАЗГОВАРИВАЕТ С МОСКВОЙ, ЕВРОПА СОБИРАЕТ СВОИ КОАЛИЦИИ,
Dialogue: 0,0:12:55.98,0:12:58.70,Caption,,0,0,0,,А ОТДЕЛЬНЫЕ ЕВРОПЕЙСКИЕ ГОСУДАРСТВА СЧИТАЮТ ДЕНЬГИ,
Dialogue: 0,0:12:59.02,0:13:02.14,Caption,,0,0,0,,КИЕВ ДОЛЖЕН ПОСТОЯННО НАПОМИНАТЬ Я ЗДЕСЬ. НОВЫЕ
Dialogue: 0,0:13:02.14,0:13:06.62,Caption,,0,0,0,,УСЛОВИЯ. НОВЫЕ ТРЕБОВАНИЯ. НОВЫЕ ПРЕДЛОЖЕНИЯ. НОВАЯ
Dialogue: 0,0:13:06.62,0:13:09.98,Caption,,0,0,0,,ИДЕЯ, КАК ЗАСТАВИТЬ ПУТИНА УСТУПИТЬ. ПОТОМУ ЧТО ЕСЛИ
Dialogue: 0,0:13:09.98,0:13:12.30,Caption,,0,0,0,,РЕШЕНИЯ НАЧНУТ ПРИНИМАТЬ БЕЗ ЗЕЛЕНСКОГО,
Dialogue: 0,0:13:12.62,0:13:15.50,Caption,,0,0,0,,ЭТО ДЛЯ НЕГО ГОРАЗДО ОПАСНЕЕ ЛЮБОГО НЕУДАЧНОГО ПРЕСС
Dialogue: 0,0:13:15.50,0:13:18.30,Caption,,0,0,0,,КОНФЕРЕНЦИОННОГО ВОПРОСА. И ЗАКАНЧИВАТЬ ВСЮ ЭТУ
Dialogue: 0,0:13:18.30,0:13:20.30,Caption,,0,0,0,,ИСТОРИЮ ЕМУ ПОЛИТИЧЕСКИ НЕВЫГОДНО.
Dialogue: 0,0:13:22.58,0:13:24.90,Caption,,0,0,0,,ОБ ЭТОМ УЖЕ ЗНАЕТ ЛЮБАЯ ДОМОХОЗЯЙКА ХОТЬ В
Dialogue: 0,0:13:24.90,0:13:28.66,Caption,,0,0,0,,ТВЕРИ, ХОТЬ В ОДЕССЕ, ХОТЬ В ИЗМАИЛЕ. ПОЭТОМУ ЖДАТЬ,
Dialogue: 0,0:13:28.82,0:13:31.38,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ ОДНАЖДЫ ПРОСНЁТСЯ И СКАЖЕТ ВСЁ,
Dialogue: 0,0:13:31.57,0:13:34.66,Caption,,0,0,0,,РЕБЯТА, Я ПЕРЕДУМАЛ, ДАВАЙТЕ БЫСТРЕНЬКО ЗАКАНЧИВАТЬ,
Dialogue: 0,0:13:34.97,0:13:37.70,Caption,,0,0,0,,НЕ ПРИХОДИТСЯ. ОН БУДЕТ ИСКАТЬ НОВУЮ КОНСТРУКЦИЮ.
Dialogue: 0,0:13:37.93,0:13:42.02,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ. АМЕРИКАНСКУЮ. САНКЦИОННУЮ. ВОЕННУЮ.
Dialogue: 0,0:13:42.26,0:13:46.98,Caption,,0,0,0,,КАКУЮ УГОДНО. ГЛАВНОЕ, ЧТОБЫ МЕСТО ДЛЯ НЕГО В ЭТОЙ КОНСТРУКЦИИ СОХРАНЯЛОСЬ.
Dialogue: 0,0:13:47.38,0:13:51.22,Caption,,0,0,0,,НО ТЕПЕРЬ ЕСТЬ ФАКТОР, КОТОРОГО РАНЬШЕ НЕ БЫЛО В ТАКОЙ ФОРМЕ. ДАЖЕ
Dialogue: 0,0:13:51.22,0:13:54.50,Caption,,0,0,0,,БРИТАНИЯ ЗАГОВОРИЛА О ПЕРЕГОВОРАХ. НАТО СОКРАЩАЕТ
Dialogue: 0,0:13:54.50,0:13:56.82,Caption,,0,0,0,,КОЛИЧЕСТВО БОЛЬШИХ ВСТРЕЧ НА ФОНЕ ВНУТРЕННИХ
Dialogue: 0,0:13:56.82,0:14:01.54,Caption,,0,0,0,,РАЗНОГЛАСИЙ. ШОЛЬЦ ГОВОРИТ, ЧТО БЕЗ РОССИИ ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ ВСЁ РАВНО НЕ
Dialogue: 0,0:14:01.54,0:14:04.58,Caption,,0,0,0,,ПОСТРОИТЬ. ФИЦО ОТКАЗЫВАЕТСЯ УЧАСТВОВАТЬ В НОВОМ
Dialogue: 0,0:14:04.58,0:14:07.70,Caption,,0,0,0,,ВОЕННОМ КРЕДИТЕ. МАКРОН ПРОДОЛЖАЕТ ПРИЗЫВАТЬ ПЛАТИТЬ
Dialogue: 0,0:14:07.70,0:14:11.70,Caption,,0,0,0,,ДАЛЬШЕ, ИМЕЯ ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ПОДДЕРЖКИ ДОМА. БЕЛАРУСЬ
Dialogue: 0,0:14:11.70,0:14:16.50,Caption,,0,0,0,,ПОКАЗЫВАЕТ НА АЭРОДРОМЫ, БАЗЫ И РАСТУЩУЮ ВОЕННУЮ АКТИВНОСТЬ У ГРАНИЦ. А
Dialogue: 0,0:14:16.58,0:14:18.90,Caption,,0,0,0,,МОСКВА ПОДНИМАЕТ ВОПРОС УЖЕ НЕ ТОЛЬКО УКРАИНЫ,
Dialogue: 0,0:14:19.14,0:14:22.10,Caption,,0,0,0,,НО ВСЕЙ АРХИТЕКТУРЫ БЕЗОПАСНОСТИ. ЭТО ЕЩЁ НЕ МИР.
Dialogue: 0,0:14:22.31,0:14:24.50,Caption,,0,0,0,,СОВСЕМ НЕТ. НО ЭТО УЖЕ СТАДИЯ,
Dialogue: 0,0:14:24.66,0:14:26.98,Caption,,0,0,0,,КОГДА ОТРИЦАТЬ НЕОБХОДИМОСТЬ БОЛЬШОГО РАЗГОВОРА
Dialogue: 0,0:14:26.98,0:14:29.62,Caption,,0,0,0,,СТАНОВИТСЯ ВСЁ ТРУДНЕЕ. СНАЧАЛА ГОВОРИЛИ,
Dialogue: 0,0:14:29.78,0:14:32.34,Caption,,0,0,0,,ЧТО ДОГОВАРИВАТЬСЯ НЕ О ЧЕМ. ПОТОМ ПОНАДОБИЛСЯ
Dialogue: 0,0:14:32.34,0:14:36.50,Caption,,0,0,0,,ТЕЛЕФОН. ТЕПЕРЬ УЖЕ ГОВОРЯТ, ЧТО ЗАКАНЧИВАТЬ НАДО ЗА СТОЛОМ ПЕРЕГОВОРОВ.
Dialogue: 0,0:14:38.77,0:14:42.38,Caption,,0,0,0,,ГЛЯДИШЬ, ТАКИМИ ТЕМПАМИ ДОЙДУТ И ДО НЕПРИЯТНЕЙШЕЙ МЫСЛИ ЗА
Dialogue: 0,0:14:42.38,0:14:44.06,Caption,,0,0,0,,СТОЛОМ ПРИДЁТСЯ НЕ ТОЛЬКО ГОВОРИТЬ,
Dialogue: 0,0:14:44.38,0:14:46.46,Caption,,0,0,0,,НО ЕЩЁ И ЧЕМ ТО ПОСТУПАТЬСЯ. А ВОТ
Dialogue: 0,0:14:46.46,0:14:49.82,Caption,,0,0,0,,ТУТ НАЧНЁТСЯ НАСТОЯЩЕЕ ВЕСЕЛЬЕ. ПОТОМУ ЧТО ЖЕЛАЮЩИХ
Dialogue: 0,0:14:49.90,0:14:51.74,Caption,,0,0,0,,НА УСТУПКИ ПОКА ЗНАЧИТЕЛЬНО МЕНЬШЕ,
Dialogue: 0,0:14:51.83,0:14:54.86,Caption,,0,0,0,,ЧЕМ ЖЕЛАЮЩИХ НА ПЕРЕГОВОРЫ. НУ И НАПОСЛЕДОК НЕМНОГО
Dialogue: 0,0:14:54.86,0:14:58.06,Caption,,0,0,0,,ВЫСОКОЙ БРИТАНСКОЙ ДИПЛОМАТИИ. БОРИС ДЖОНСОН РЕШИЛ
Dialogue: 0,0:14:58.06,0:15:00.70,Caption,,0,0,0,,ВСПОМНИТЬ СВОЮ ВСТРЕЧУ С СЕРГЕЕМ ЛАВРОВЫМ В МОСКВЕ
Dialogue: 0,0:15:00.78,0:15:03.90,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ СЕМНАДЦАТОМ ГОДУ. ПО ВЕРСИИ ДЖОНСОНА,
Dialogue: 0,0:15:04.13,0:15:06.38,Caption,,0,0,0,,ЛАВРОВ ЗАСТАВЛЯЛ ЕГО ПИТЬ МНОГО ВОДКИ ВОЗЛЕ
Dialogue: 0,0:15:06.38,0:15:09.82,Caption,,0,0,0,,РАСКАЛЁННОГО КАМИНА. БЫЛО ТЯЖЕЛО. БЫЛО МУЧИТЕЛЬНО.
Dialogue: 0,0:15:10.15,0:15:13.26,Caption,,0,0,0,,ПЕРЕГОВОРЫ ОКАЗАЛИСЬ БЕСПОЛЕЗНЫМИ. МАРИЯ ЗАХАРОВА
Dialogue: 0,0:15:13.26,0:15:15.02,Caption,,0,0,0,,ОТВЕТИЛА ПРИМЕРНО В ДУХЕ БОРИС,
Dialogue: 0,0:15:15.10,0:15:20.30,Caption,,0,0,0,,НЕ НАДО. ПО ЕЁ ВЕРСИИ, ДЖОНСОНА НИКТО НЕ ЗАСТАВЛЯЛ. ОН САМ ПОСТОЯННО ПРОСИЛ
Dialogue: 0,0:15:20.38,0:15:23.10,Caption,,0,0,0,,НАЛИТЬ ЕЩЁ. А ПОТОМ, ГОВОРИТ ЗАХАРОВА,
Dialogue: 0,0:15:23.34,0:15:28.54,Caption,,0,0,0,,ПРИЕХАЛА ЛИЗ ТРАСС, И АТМОСФЕРА СТАЛА ЕЩЁ ВЕСЕЛЕЕ. ВОТ ТАКАЯ ДИПЛОМАТИЯ.
Dialogue: 0,0:15:28.64,0:15:30.30,Caption,,0,0,0,,ОДИН СПУСТЯ ГОДЫ РАССКАЗЫВАЕТ,
Dialogue: 0,0:15:30.39,0:15:33.02,Caption,,0,0,0,,ЧТО ЕГО ЗАСТАВЛЯЛИ ПИТЬ. ДРУГАЯ ОТВЕЧАЕТ,
Dialogue: 0,0:15:33.18,0:15:35.50,Caption,,0,0,0,,ЧТО ОН САМ НЕ ХОТЕЛ ОСТАНАВЛИВАТЬСЯ. И ЭТИ
Dialogue: 0,0:15:35.50,0:15:40.78,Caption,,0,0,0,,ЛЮДИ ПОТОМ ГОДАМИ ОПРЕДЕЛЯЛИ, КАК ИМЕННО ЕВРОПЕ СТРОИТЬ ОТНОШЕНИЯ С РОССИЕЙ. ВОТ
Dialogue: 0,0:15:40.78,0:15:43.58,Caption,,0,0,0,,С ТАКИМИ ИДИОТАМИ ПРИХОДИТСЯ РАБОТАТЬ. ХОТЯ ТЕПЕРЬ
Dialogue: 0,0:15:43.58,0:15:45.42,Caption,,0,0,0,,ЕСТЬ ПРОГРЕСС. РАНЬШЕ СПОРИЛИ,
Dialogue: 0,0:15:45.50,0:15:48.38,Caption,,0,0,0,,КТО КОМУ НАЛИВАЛ. ТЕПЕРЬ ХОТЯ БЫ НАЧАЛИ ВСПОМИНАТЬ,
Dialogue: 0,0:15:48.61,0:15:50.78,Caption,,0,0,0,,ЧТО ЗА СТОЛОМ МОЖНО ЕЩЁ И РАЗГОВАРИВАТЬ.
