Dialogue: 0,0:00:00.12,0:00:04.20,Caption,,0,0,0,,НУ ЧТО, ПОХОЖЕ, ЧТО ТО ВСЁ ТАКИ СДВИНУЛОСЬ. ПОТОМУ ЧТО КОГДА
Dialogue: 0,0:00:04.20,0:00:06.52,Caption,,0,0,0,,ВОКРУГ ПЕРЕГОВОРОВ ВДРУГ НАЧИНАЮТ ОДНОВРЕМЕННО
Dialogue: 0,0:00:06.52,0:00:10.04,Caption,,0,0,0,,СУЕТИТЬСЯ МОСКВА, КИЕВ, ВАШИНГТОН И ВСЯ ЕВРОПА,
Dialogue: 0,0:00:10.36,0:00:13.64,Caption,,0,0,0,,ЗНАЧИТ РАЗГОВОР УЖЕ НЕ ДЛЯ ГАЛОЧКИ. ЕВРОПЕЙЦЫ СРОЧНО
Dialogue: 0,0:00:13.72,0:00:17.56,Caption,,0,0,0,,ИЩУТ, КОГО ПОСАДИТЬ ЗА СТОЛ, КИЕВ ТО ГОВОРИТ О ПРОГРЕССЕ,
Dialogue: 0,0:00:17.72,0:00:21.24,Caption,,0,0,0,,ТО ПРЕДУПРЕЖДАЕТ, ЧТО МИРА БЫСТРО НЕ БУДЕТ. ОДНИ УЖЕ ДЕЛЯТ
Dialogue: 0,0:00:21.24,0:00:25.24,Caption,,0,0,0,,КРЕСЛА, ДРУГИЕ ЗАРАНЕЕ ГОТОВЯТСЯ К ПРОДОЛЖЕНИЮ. КРАСОТА. И
Dialogue: 0,0:00:25.32,0:00:27.40,Caption,,0,0,0,,ВОТ ЗДЕСЬ ХОЧЕТСЯ ПОНЯТЬ ОДНУ ВЕЩЬ. ОНИ
Dialogue: 0,0:00:27.40,0:00:29.48,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО НАЧАЛИ ДОГОВАРИВАТЬСЯ ИЛИ ПРОСТО
Dialogue: 0,0:00:29.48,0:00:31.80,Caption,,0,0,0,,КАЖДЫЙ УВИДЕЛ В ЭТИХ ПЕРЕГОВОРАХ ЧТО ТО СВОЁ?
Dialogue: 0,0:00:32.07,0:00:34.68,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО СЕЙЧАС САМОЕ
Dialogue: 0,0:00:34.76,0:00:37.24,Caption,,0,0,0,,ИНТЕРЕСНОЕ ПРОИСХОДИТ УЖЕ НЕ В ЗАЯВЛЕНИЯХ О МИРЕ,
Dialogue: 0,0:00:37.51,0:00:41.08,Caption,,0,0,0,,А В ТОМ, КАК ВСЕ ВОКРУГ ЭТОГО МИРА НАЧАЛИ ДВИГАТЬСЯ. И
Dialogue: 0,0:00:41.08,0:00:43.48,Caption,,0,0,0,,ВОТ САМ ЭТОТ ЕВРОПЕЙСКИЙ ПЕРЕПОЛОХ Я БЫ ТОЧНО
Dialogue: 0,0:00:43.48,0:00:46.04,Caption,,0,0,0,,НЕ СПИСЫВАЛ НА ПУСТУЮ СУЕТУ. ПОТОМУ ЧТО ЕЩЁ
Dialogue: 0,0:00:46.04,0:00:48.60,Caption,,0,0,0,,СОВСЕМ НЕДАВНО ЕВРОПА ЖИЛА В ДРУГОЙ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:00:48.60,0:00:51.48,Caption,,0,0,0,,РЕАЛЬНОСТИ. РАЗГОВОРЫ С МОСКВОЙ ВОСПРИНИМАЛИСЬ ЧУТЬ
Dialogue: 0,0:00:51.56,0:00:54.52,Caption,,0,0,0,,ЛИ НЕ КАК ДУРНОЙ ТОН. ЛЮБАЯ ПОПЫТКА СПРОСИТЬ,
Dialogue: 0,0:00:54.60,0:00:56.52,Caption,,0,0,0,,А РАЗГОВАРИВАТЬ ВСЁ ТАКИ КОГДА БУДЕМ,
Dialogue: 0,0:00:56.84,0:00:59.40,Caption,,0,0,0,,ВЫЗЫВАЛА ЦЕЛУЮ ЛЕКЦИЮ О ПРАВИЛЬНЫХ ЦЕННОСТЯХ,
Dialogue: 0,0:00:59.48,0:01:02.52,Caption,,0,0,0,,НЕПРАВИЛЬНОМ ВРЕМЕНИ И НЕОБХОДИМОСТИ СНАЧАЛА СДЕЛАТЬ
Dialogue: 0,0:01:02.52,0:01:05.16,Caption,,0,0,0,,ЕЩЁ ЧТО НИБУДЬ ЖЁСТКОЕ. А ТЕПЕРЬ ВНЕЗАПНО
Dialogue: 0,0:01:05.16,0:01:08.44,Caption,,0,0,0,,ВЫЯСНИЛОСЬ, ЧТО РАЗГОВАРИВАТЬ НАДО. ПРИЧЁМ НЕ КОГДА НИБУДЬ
Dialogue: 0,0:01:08.52,0:01:12.40,Caption,,0,0,0,,ПОТОМ. УЖЕ СЕЙЧАС ВЫЯСНЯЮТ,
Dialogue: 0,0:01:12.52,0:01:15.04,Caption,,0,0,0,,КТО ПОЕДЕТ, КТО БУДЕТ ПРЕДСТАВЛЯТЬ ЕВРОПУ,
Dialogue: 0,0:01:15.20,0:01:17.68,Caption,,0,0,0,,КТО ПОЛУЧИТ ПРАВО ГОВОРИТЬ ОТ ИМЕНИ ОСТАЛЬНЫХ И
Dialogue: 0,0:01:17.76,0:01:19.68,Caption,,0,0,0,,КТО ВООБЩЕ С КЕМ ДОЛЖЕН СИДЕТЬ ЗА ОДНИМ
Dialogue: 0,0:01:19.68,0:01:22.96,Caption,,0,0,0,,СТОЛОМ. ПРЕЗИДЕНТ ФИНЛЯНДИИ УЖЕ ГОВОРИТ О ПЕРЕГОВОРАХ С
Dialogue: 0,0:01:23.04,0:01:27.68,Caption,,0,0,0,,УЧАСТИЕМ РОССИИ, США И ЕВРОПЫ В БЛИЖАЙШИЕ НЕДЕЛИ. ЕВРОПЕЙЦЕВ
Dialogue: 0,0:01:27.68,0:01:30.64,Caption,,0,0,0,,СОБИРАЮТСЯ ПОДКЛЮЧАТЬ К СЛЕДУЮЩЕМУ РАУНДУ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:01:30.64,0:01:33.84,Caption,,0,0,0,,ВСТРЕЧАЕТСЯ С УИТКОФФОМ И КУШНЕРОМ. СЛЕДУЮЩИЙ ЭТАП
Dialogue: 0,0:01:33.84,0:01:37.52,Caption,,0,0,0,,ОБСУЖДАЮТ ТО В ЭМИРАТАХ, ТО В ШВЕЙЦАРИИ. ТО ЕСТЬ ПОЕЗД НЕ ПРОСТО
Dialogue: 0,0:01:37.60,0:01:40.00,Caption,,0,0,0,,СТОИТ НА ВОКЗАЛЕ И ГУДИТ ДЛЯ КРАСОТЫ. ОН
Dialogue: 0,0:01:40.08,0:01:43.04,Caption,,0,0,0,,ХОТЯ БЫ НАЧАЛ ДЁРГАТЬСЯ. И ЕВРОПА ЭТО ПОЧУВСТВОВАЛА.
Dialogue: 0,0:01:43.25,0:01:46.32,Caption,,0,0,0,,ОТСЮДА И ВСЯ ЭТА БЕГОТНЯ ВОКРУГ ПЕРЕГОВОРЩИКА. ВОТ
Dialogue: 0,0:01:46.32,0:01:49.44,Caption,,0,0,0,,МАКРОН. УЖЕ ПРИЗЫВАЕТ ЕВРОПУ ВЫРАБОТАТЬ ЕДИНУЮ
Dialogue: 0,0:01:49.44,0:01:52.56,Caption,,0,0,0,,СТРАТЕГИЮ И САМ ЯВНО НЕ ПРОТИВ ОКАЗАТЬСЯ ЧЕЛОВЕКОМ,
Dialogue: 0,0:01:52.80,0:01:55.76,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ ПРЕДСТАВЛЯТЬ ВЕСЬ ЕВРОСОЮЗ. И ТУТ,
Dialogue: 0,0:01:55.84,0:01:59.04,Caption,,0,0,0,,КОНЕЧНО, ХОЧЕТСЯ ЗАДАТЬ ПРОСТОЙ ВОПРОС. ЭММАНУЭЛЬ,
Dialogue: 0,0:01:59.36,0:02:01.12,Caption,,0,0,0,,А С ФРАНЦИЕЙ СНАЧАЛА ВСЁ НОРМАЛЬНО?
Dialogue: 0,0:02:01.37,0:02:04.24,Caption,,0,0,0,,ПО НОЯБРЬСКОМУ ИССЛЕДОВАНИЮ ELABE МАКРОНУ ДОВЕРЯЮТ
Dialogue: 0,0:02:04.24,0:02:06.96,Caption,,0,0,0,,ТРИНАДЦАТЬ ПРОЦЕНТОВ ФРАНЦУЗОВ. ПО VERIAN,
Dialogue: 0,0:02:07.12,0:02:10.08,Caption,,0,0,0,,ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ. НЕДОВЕРИЕ В ОБОИХ СЛУЧАЯХ
Dialogue: 0,0:02:10.08,0:02:12.88,Caption,,0,0,0,,ПРЕВЫШАЕТ ВОСЕМЬДЕСЯТ ПРОЦЕНТОВ. ТРИНАДЦАТЬ
Dialogue: 0,0:02:12.88,0:02:16.08,Caption,,0,0,0,,ПРОЦЕНТОВ ДОВЕРИЯ ДОМА. И ПОСЛЕ ЭТОГО ВОЗНИКАЕТ ИДЕЯ
Dialogue: 0,0:02:16.08,0:02:18.72,Caption,,0,0,0,,ГОВОРИТЬ ОТ ИМЕНИ ВСЕЙ ЕВРОПЫ. СОГЛАСИТЕСЬ,
Dialogue: 0,0:02:18.87,0:02:21.04,Caption,,0,0,0,,КОНСТРУКЦИЯ ЗАНЯТНАЯ. ЭММАНУЭЛЬ,
Dialogue: 0,0:02:21.28,0:02:23.28,Caption,,0,0,0,,ТЫ СНАЧАЛА СО СВОЕЙ ФРАНЦИЕЙ РАЗБЕРИСЬ.
Dialogue: 0,0:02:25.56,0:02:27.73,Caption,,0,0,0,,ТЕБЕ ДОМА ДОВЕРЯЮТ ТРИНАДЦАТЬ ЧЕТЫРНАДЦАТЬ
Dialogue: 0,0:02:27.73,0:02:31.25,Caption,,0,0,0,,ПРОЦЕНТОВ, А ТЫ УЖЕ СОБРАЛСЯ ПРЕДСТАВЛЯТЬ ВСЮ ЕВРОПУ. ДА
Dialogue: 0,0:02:31.33,0:02:33.57,Caption,,0,0,0,,ТЫ С ТАКИМ ДОВЕРИЕМ СОБСТВЕННУЮ СТРАНУ ТОЛКОМ
Dialogue: 0,0:02:33.57,0:02:37.49,Caption,,0,0,0,,ПРЕДСТАВЛЯТЬ НЕ МОЖЕШЬ! И ВЕДЬ ПРОБЛЕМА НЕ ТОЛЬКО В МАКРОНЕ. МНОГИЕ
Dialogue: 0,0:02:37.57,0:02:40.61,Caption,,0,0,0,,НЫНЕШНИЕ ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ У СЕБЯ ДОМА ДАВНО
Dialogue: 0,0:02:40.69,0:02:43.01,Caption,,0,0,0,,ПОТЕРЯЛИ ДОВЕРИЕ ОГРОМНОЙ ЧАСТИ ИЗБИРАТЕЛЕЙ.
Dialogue: 0,0:02:43.41,0:02:45.65,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ НЕУДАЧНИКИ ВНУТРИ СОБСТВЕННЫХ
Dialogue: 0,0:02:45.65,0:02:47.81,Caption,,0,0,0,,ГОСУДАРСТВ СОБИРАЮТСЯ ОБЪЯСНЯТЬ МОСКВЕ,
Dialogue: 0,0:02:47.97,0:02:50.69,Caption,,0,0,0,,ЧЕГО ХОЧЕТ ВЕСЬ ЕВРОСОЮЗ. А КТО ВАМ ТАКОЕ
Dialogue: 0,0:02:50.69,0:02:53.09,Caption,,0,0,0,,ПРАВО ВООБЩЕ ДАЛ? КОГО ВЫ ПРЕДСТАВЛЯЕТЕ,
Dialogue: 0,0:02:53.23,0:02:56.69,Caption,,0,0,0,,КРОМЕ САМИХ СЕБЯ? ТЕМ БОЛЕЕ ЧТО САМА ЕВРОПА ПОКА НЕ ЗНАЕТ,
Dialogue: 0,0:02:56.86,0:02:59.09,Caption,,0,0,0,,ЧЕГО ОНА ХОЧЕТ И КТО ИМЕННО ДОЛЖЕН ЭТО
Dialogue: 0,0:02:59.09,0:03:02.53,Caption,,0,0,0,,ОЗВУЧИВАТЬ. ОДНИ ПРОДВИГАЮТ АНТОНИУ КОШТУ. ДРУГИЕ
Dialogue: 0,0:03:02.61,0:03:05.25,Caption,,0,0,0,,ХОТЯТ ПРЕДСТАВИТЕЛЕЙ ФРАНЦИИ И ГЕРМАНИИ. ТРЕТЬИ
Dialogue: 0,0:03:05.25,0:03:08.13,Caption,,0,0,0,,ПРЕДЛАГАЮТ КАЮ КАЛЛАС. ТРИ ЛАГЕРЯ ТОЛЬКО ВОКРУГ
Dialogue: 0,0:03:08.21,0:03:11.09,Caption,,0,0,0,,ОДНОГО КРЕСЛА. ПРИЧЁМ ЧАСТЬ ЕВРОПЕЙСКИХ ДИПЛОМАТОВ
Dialogue: 0,0:03:11.09,0:03:15.17,Caption,,0,0,0,,САМА СОМНЕВАЕТСЯ, ЧТО КАЛЛАС ВООБЩЕ ПОДХОДИТ ДЛЯ РАЗГОВОРА С МОСКВОЙ
Dialogue: 0,0:03:15.41,0:03:18.61,Caption,,0,0,0,,ИЗ ЗА ЕЁ ПРЕЖНЕЙ ПОЗИЦИИ. ОЧЕНЬ УДОБНО ПОЛУЧАЕТСЯ.
Dialogue: 0,0:03:18.77,0:03:21.33,Caption,,0,0,0,,СНАЧАЛА НУЖНО ДОГОВОРИТЬСЯ С РОССИЕЙ. ПОТОМ
Dialogue: 0,0:03:21.33,0:03:24.69,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО ДЛЯ ЭТОГО ЕВРОПЕ СНАЧАЛА НАДО ДОГОВОРИТЬСЯ С
Dialogue: 0,0:03:24.69,0:03:27.57,Caption,,0,0,0,,ЕВРОПОЙ. А ВЕДЬ ЕСТЬ ЕЩЁ НАЦИОНАЛЬНЫЕ ПРАВИТЕЛЬСТВА.
Dialogue: 0,0:03:27.80,0:03:30.13,Caption,,0,0,0,,И У НИХ СВОИ ИНТЕРЕСЫ, СВОИ ДЕНЬГИ,
Dialogue: 0,0:03:30.21,0:03:32.93,Caption,,0,0,0,,СВОИ ИЗБИРАТЕЛИ И СВОИ ПРЕДСТАВЛЕНИЯ О ТОМ,
Dialogue: 0,0:03:33.04,0:03:35.73,Caption,,0,0,0,,СКОЛЬКО ВСЁ ЭТО ДОЛЖНО ПРОДОЛЖАТЬСЯ. ТАК КТО В
Dialogue: 0,0:03:35.81,0:03:39.53,Caption,,0,0,0,,ИТОГЕ БУДЕТ ГОВОРИТЬ? КОШТА?
Dialogue: 0,0:03:39.75,0:03:42.89,Caption,,0,0,0,,КАЛЛАС? МАКРОН? НЕМЦЫ С ФРАНЦУЗАМИ ОТДЕЛЬНО?
Dialogue: 0,0:03:43.37,0:03:46.73,Caption,,0,0,0,,И ГЛАВНОЕ, ЧТО ИМЕННО ЭТОТ ЧЕЛОВЕК СМОЖЕТ ОБЕЩАТЬ ОТ ИМЕНИ
Dialogue: 0,0:03:46.73,0:03:50.01,Caption,,0,0,0,,ОСТАЛЬНЫХ? ПОТОМУ ЧТО КРАСИВОЕ КРЕСЛО ПЕРЕГОВОРЩИКА ЕЩЁ НЕ
Dialogue: 0,0:03:50.01,0:03:52.81,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ЗА СПИНОЙ У НЕГО СТОЯТ ДВАДЦАТЬ СЕМЬ
Dialogue: 0,0:03:52.81,0:03:55.93,Caption,,0,0,0,,ГОСУДАРСТВ С ОДНОЙ ПОЗИЦИЕЙ. И РОССИЯ ЭТО ПРЕКРАСНО
Dialogue: 0,0:03:56.01,0:03:58.73,Caption,,0,0,0,,ВИДИТ. В АБУ ДАБИ МОСКВА ОТКАЗАЛАСЬ ПРОВОДИТЬ
Dialogue: 0,0:03:58.73,0:04:01.37,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ВСТРЕЧИ С ПРЕДСТАВИТЕЛЯМИ ЕВРОПЫ И НАТО.
Dialogue: 0,0:04:01.66,0:04:04.01,Caption,,0,0,0,,РОССИЙСКАЯ ДЕЛЕГАЦИЯ ВООБЩЕ ПОСТАВИЛА ВОПРОС
Dialogue: 0,0:04:04.01,0:04:06.73,Caption,,0,0,0,,ДОВОЛЬНО ЖЁСТКО. В КАКОМ КАЧЕСТВЕ ВЫ ПРИЕХАЛИ И
Dialogue: 0,0:04:06.81,0:04:11.37,Caption,,0,0,0,,ЧТО КОНКРЕТНО ПРЕДЛАГАЕТЕ? И ТУТ НАЧИНАЕТСЯ САМОЕ СМЕШНОЕ. ЕВРОПА ХОЧЕТ
Dialogue: 0,0:04:11.45,0:04:14.73,Caption,,0,0,0,,УЧАСТВОВАТЬ В ПЕРЕГОВОРАХ, НО ОДНОВРЕМЕННО ПРОДОЛЖАЕТ ВЫСТАВЛЯТЬ
Dialogue: 0,0:04:14.73,0:04:17.05,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНЫЕ УСЛОВИЯ. КАЛЛАС ГОВОРИТ,
Dialogue: 0,0:04:17.29,0:04:19.21,Caption,,0,0,0,,ЧТО СНАЧАЛА НУЖНО ПРЕКРАЩЕНИЕ ОГНЯ,
Dialogue: 0,0:04:19.37,0:04:22.09,Caption,,0,0,0,,ПОТОМ РАЗГОВОР. МОСКВА ГОВОРИТ О БОЛЕЕ ШИРОКОЙ
Dialogue: 0,0:04:22.17,0:04:25.37,Caption,,0,0,0,,СИСТЕМЕ БЕЗОПАСНОСТИ. КИЕВ ГОВОРИТ О СВОИХ УСЛОВИЯХ.
Dialogue: 0,0:04:25.61,0:04:28.25,Caption,,0,0,0,,АМЕРИКАНЦЫ ПЫТАЮТСЯ СВЕСТИ ЭТО ВСЁ В ОДНУ КОМНАТУ.
Dialogue: 0,0:04:28.41,0:04:30.97,Caption,,0,0,0,,НОРМАЛЬНАЯ ТАКАЯ СЕМЕЙНАЯ ВСТРЕЧА. ВСЕ ПРИШЛИ
Dialogue: 0,0:04:30.97,0:04:34.25,Caption,,0,0,0,,МИРИТЬСЯ, НО КАЖДЫЙ ЗАРАНЕЕ НАПИСАЛ СПИСОК ТОГО,
Dialogue: 0,0:04:34.41,0:04:37.21,Caption,,0,0,0,,ЧТО ОСТАЛЬНЫЕ ОБЯЗАНЫ СДЕЛАТЬ ДО ПРИМИРЕНИЯ. ПРИ
Dialogue: 0,0:04:37.29,0:04:40.01,Caption,,0,0,0,,ЭТОМ САМ ФАКТ, ЧТО ЭТА ВСТРЕЧА ВООБЩЕ ПРОИСХОДИТ,
Dialogue: 0,0:04:40.24,0:04:43.05,Caption,,0,0,0,,УЖЕ ВАЖЕН. ЗЕЛЕНСКИЙ ПОСЛЕ АБУ ДАБИ ГОВОРИТ О
Dialogue: 0,0:04:43.05,0:04:46.49,Caption,,0,0,0,,ПРОГРЕССЕ. СЛЕДУЮЩИЙ РАУНД ОБСУЖДАЕТСЯ. АМЕРИКАНЦЫ
Dialogue: 0,0:04:46.49,0:04:49.37,Caption,,0,0,0,,ПРОДОЛЖАЮТ ЕЗДИТЬ МЕЖДУ УЧАСТНИКАМИ. ЕВРОПЕЙЦЕВ
Dialogue: 0,0:04:49.37,0:04:55.09,Caption,,0,0,0,,ГОТОВЯТ К ПОДКЛЮЧЕНИЮ. ТО ЕСТЬ РАЗГОВОР ПОШЁЛ. ТОЛЬКО ВОТ ЗДЕСЬ И
Dialogue: 0,0:04:55.09,0:04:57.97,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ГЛАВНЫЙ ВОПРОС. О ЧЁМ ИМЕННО ПОШЁЛ
Dialogue: 0,0:04:57.97,0:05:00.93,Caption,,0,0,0,,РАЗГОВОР? ПОТОМУ ЧТО ЗЕЛЕНСКИЙ ОДНОВРЕМЕННО ГОВОРИТ ДВЕ
Dialogue: 0,0:05:00.93,0:05:03.49,Caption,,0,0,0,,СОВЕРШЕННО РАЗНЫЕ ВЕЩИ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:05:03.58,0:05:06.85,Caption,,0,0,0,,ПРОГРЕСС ЕСТЬ. С ДРУГОЙ, ОН СОМНЕВАЕТСЯ,
Dialogue: 0,0:05:07.09,0:05:09.81,Caption,,0,0,0,,ЧТО В РАМКАХ УКРАИНСКОГО УРЕГУЛИРОВАНИЯ ВООБЩЕ НАДО
Dialogue: 0,0:05:09.81,0:05:12.77,Caption,,0,0,0,,ОБСУЖДАТЬ НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ МЕЖДУ ЕВРОПОЙ И
Dialogue: 0,0:05:12.85,0:05:15.49,Caption,,0,0,0,,РОССИЕЙ. А РОССИЯ КАК РАЗ СЧИТАЕТ ЭТУ СИСТЕМУ
Dialogue: 0,0:05:15.49,0:05:18.69,Caption,,0,0,0,,БЕЗОПАСНОСТИ ОДНИМ ИЗ КЛЮЧЕВЫХ ВОПРОСОВ. ВОТ ВАМ И
Dialogue: 0,0:05:18.77,0:05:21.57,Caption,,0,0,0,,ВСЯ РАЗНИЦА. ДЛЯ ОДНОГО ПЕРЕГОВОРЫ ЭТО ОСТАНОВИТЬ
Dialogue: 0,0:05:21.57,0:05:23.81,Caption,,0,0,0,,УДАРЫ, ДОГОВОРИТЬСЯ О ПЕРЕМИРИИ,
Dialogue: 0,0:05:24.05,0:05:27.01,Caption,,0,0,0,,РЕШИТЬ КОНКРЕТНЫЕ УКРАИНСКИЕ ВОПРОСЫ. ДЛЯ ДРУГОГО
Dialogue: 0,0:05:27.01,0:05:31.25,Caption,,0,0,0,,ЭТО РАЗГОВОР О ТОМ, КАК ПОСЛЕ ОКОНЧАНИЯ НЫНЕШНЕГО КОНФЛИКТА ВООБЩЕ БУДЕТ
Dialogue: 0,0:05:31.33,0:05:34.21,Caption,,0,0,0,,УСТРОЕНА БЕЗОПАСНОСТЬ НА КОНТИНЕНТЕ. А ЭТО УЖЕ ДВА
Dialogue: 0,0:05:34.21,0:05:37.25,Caption,,0,0,0,,СОВЕРШЕННО РАЗНЫХ РАЗМЕРА СТОЛА. ЗЕЛЕНСКИЙ ОТДЕЛЬНО
Dialogue: 0,0:05:37.25,0:05:40.85,Caption,,0,0,0,,ГОВОРИТ, ЧТО РОССИЯ НЕ ХОЧЕТ ОБСУЖДАТЬ ОГРАНИЧЕНИЯ УДАРОВ И
Dialogue: 0,0:05:40.93,0:05:43.97,Caption,,0,0,0,,МЕРЫ ПО СНИЖЕНИЮ ПОСЛЕДСТВИЙ БОЕВЫХ ДЕЙСТВИЙ. МОСКВА
Dialogue: 0,0:05:44.05,0:05:46.77,Caption,,0,0,0,,СО СВОЕЙ СТОРОНЫ СНОВА ПОДНИМАЕТ ВОПРОСЫ НАТО И
Dialogue: 0,0:05:46.77,0:05:49.81,Caption,,0,0,0,,ОБЩЕЙ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. И ВОТ ЗДЕСЬ НЕЛЬЗЯ
Dialogue: 0,0:05:49.81,0:05:52.13,Caption,,0,0,0,,ДЕЛАТЬ ВИД, ЧТО РЕЧЬ ИДЁТ ТОЛЬКО О ТОМ,
Dialogue: 0,0:05:52.29,0:05:55.41,Caption,,0,0,0,,КТО КУДА ОТВЕДЁТ ВОЙСКА ЗАВТРА УТРОМ. ЭТОТ КОНФЛИКТ
Dialogue: 0,0:05:55.41,0:05:58.13,Caption,,0,0,0,,ДАВНО ВЫЛЕЗ ЗА РАМКИ ОДНОГО УКРАИНСКОГО ВОПРОСА.
Dialogue: 0,0:06:00.32,0:06:03.04,Caption,,0,0,0,,И ЕСЛИ ПОСЛЕ ВСЕГО ЭТОГО ПРОСТО ОСТАНОВИТЬ СТРЕЛЬБУ,
Dialogue: 0,0:06:03.20,0:06:06.00,Caption,,0,0,0,,СФОТОГРАФИРОВАТЬСЯ, ПОЖАТЬ РУКИ И РАЗОЙТИСЬ,
Dialogue: 0,0:06:06.20,0:06:08.24,Caption,,0,0,0,,ОСТАВИВ СТАРЫЕ ПРОТИВОРЕЧИЯ ПОД КОВРОМ,
Dialogue: 0,0:06:08.63,0:06:10.96,Caption,,0,0,0,,ТО ЗАЧЕМ ВООБЩЕ БЫЛО СОБИРАТЬ СТОЛЬКО ДИПЛОМАТОВ?
Dialogue: 0,0:06:11.29,0:06:13.60,Caption,,0,0,0,,ЧТОБЫ ЧЕРЕЗ КАКОЕ ТО ВРЕМЯ СНОВА ДОСТАТЬ ТОТ
Dialogue: 0,0:06:13.60,0:06:18.00,Caption,,0,0,0,,ЖЕ КОВЁР? ПОЭТОМУ СЛОВА О ПРОГРЕССЕ ЗВУЧАТ ХОРОШО. НО ГОРАЗДО
Dialogue: 0,0:06:18.00,0:06:21.28,Caption,,0,0,0,,ВАЖНЕЕ ПОНЯТЬ, В ЧЁМ ЭТОТ ПРОГРЕСС СОСТОИТ. В ТОМ,
Dialogue: 0,0:06:21.52,0:06:23.44,Caption,,0,0,0,,ЧТО УЧАСТНИКИ НАКОНЕЦ РАЗГОВАРИВАЮТ?
Dialogue: 0,0:06:23.66,0:06:26.96,Caption,,0,0,0,,ДА. В ТОМ, ЧТО ОНИ ДОГОВОРИЛИСЬ ПО ГЛАВНЫМ ВОПРОСАМ?
Dialogue: 0,0:06:27.31,0:06:29.76,Caption,,0,0,0,,ВОТ ЭТОГО ПОКА НЕ ВИДНО. И ТУТ ЕВРОПА
Dialogue: 0,0:06:29.76,0:06:32.72,Caption,,0,0,0,,ПОПАДАЕТ В ОСОБЕННО ИНТЕРЕСНОЕ ПОЛОЖЕНИЕ. МАКРОН
Dialogue: 0,0:06:32.72,0:06:36.16,Caption,,0,0,0,,ГОВОРИТ, ЧТО ОСНОВНУЮ ПОДДЕРЖКУ УКРАИНЕ СЕЙЧАС ПРЕДОСТАВЛЯЮТ
Dialogue: 0,0:06:36.16,0:06:39.04,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ГОСУДАРСТВА И ДРУГИЕ УЧАСТНИКИ КОАЛИЦИИ,
Dialogue: 0,0:06:39.36,0:06:42.24,Caption,,0,0,0,,А ПРЕЖНЕЙ АМЕРИКАНСКОЙ ПОДДЕРЖКИ УЖЕ НЕТ. ХОРОШО.
Dialogue: 0,0:06:42.78,0:06:45.60,Caption,,0,0,0,,ТОГДА ПОЛУЧАЕТСЯ ОЧЕНЬ ПРОСТОЙ РАЗГОВОР. ЕСЛИ ЕВРОПА
Dialogue: 0,0:06:45.60,0:06:47.76,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО СТАНОВИТСЯ ГЛАВНЫМ СПОНСОРОМ
Dialogue: 0,0:06:47.76,0:06:52.08,Caption,,0,0,0,,УКРАИНСКОЙ ПОЛИТИКИ, ОНА ХОЧЕТ И МЕСТО ЗА СТОЛОМ. ЛОГИЧНО. ТОЛЬКО
Dialogue: 0,0:06:52.08,0:06:54.40,Caption,,0,0,0,,ДЕНЬГИ И ПОЛИТИЧЕСКИЙ ВЕС НЕ СОВСЕМ ОДНО И
Dialogue: 0,0:06:54.48,0:06:57.44,Caption,,0,0,0,,ТО ЖЕ. МОЖНО ОПЛАЧИВАТЬ ЗНАЧИТЕЛЬНУЮ ЧАСТЬ РАСХОДОВ,
Dialogue: 0,0:06:57.68,0:07:00.00,Caption,,0,0,0,,НО ПРИ ЭТОМ ЗАВИСЕТЬ ОТ АМЕРИКАНСКОЙ РАЗВЕДКИ,
Dialogue: 0,0:07:00.08,0:07:05.76,Caption,,0,0,0,,ЛОГИСТИКИ, ВООРУЖЕНИЙ, ТЕХНОЛОГИЙ И ОБЩЕЙ СИСТЕМЫ БЕЗОПАСНОСТИ. И ВАШИНГТОН
Dialogue: 0,0:07:05.76,0:07:07.60,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЕТ ЭТУ РАЗНИЦУ.
Dialogue: 0,0:07:09.89,0:07:12.61,Caption,,0,0,0,,ПОЭТОМУ АМЕРИКАНЦЫ ВЕДУТ СВОИ КОНТАКТЫ С МОСКВОЙ,
Dialogue: 0,0:07:12.85,0:07:15.89,Caption,,0,0,0,,РАЗГОВАРИВАЮТ С КИЕВОМ, ВСТРЕЧАЮТСЯ С ЕВРОПЕЙЦАМИ,
Dialogue: 0,0:07:16.13,0:07:20.21,Caption,,0,0,0,,А ЕВРОПА ПАРАЛЛЕЛЬНО РЕШАЕТ, КОГО ВООБЩЕ ОТПРАВИТЬ ГОВОРИТЬ ОТ СВОЕГО ИМЕНИ.
Dialogue: 0,0:07:20.63,0:07:24.45,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСЕН ИМЕННО ЭТОТ ВТОРОЙ СЛОЙ. ПОТОМУ
Dialogue: 0,0:07:24.53,0:07:26.85,Caption,,0,0,0,,ЧТО ЗАЯВЛЕНИЯ ПОЛИТИКОВ МЕНЯЮТСЯ КАЖДЫЙ ДЕНЬ,
Dialogue: 0,0:07:27.09,0:07:29.97,Caption,,0,0,0,,А РЕАЛЬНЫЕ РЫЧАГИ ОБЫЧНО МЕНЯЮТСЯ ГОРАЗДО МЕДЛЕННЕЕ.
Dialogue: 0,0:07:30.18,0:07:34.29,Caption,,0,0,0,,А ТЕПЕРЬ ПОСМОТРИМ, НАСКОЛЬКО ЕВРОПА ВООБЩЕ ЕДИНА ВНУТРИ. ФИЦО
Dialogue: 0,0:07:34.29,0:07:37.89,Caption,,0,0,0,,РАССКАЗЫВАЕТ, ЧТО БЫЛ БУКВАЛЬНО ШОКИРОВАН РАЗГОВОРОМ С УКРАИНСКИМ
Dialogue: 0,0:07:37.97,0:07:41.25,Caption,,0,0,0,,ПРЕМЬЕРОМ О ВОЙНЕ И ПЕРСПЕКТИВАХ ЕЁ ОКОНЧАНИЯ. ТОТ
Dialogue: 0,0:07:41.25,0:07:45.17,Caption,,0,0,0,,ЖЕ ФИЦО ВСПОМИНАЕТ, КАК КАНЦЛЕР ГЕРМАНИИ МЕРЦ КРИЧАЛ НА НЕГО ИЗ
Dialogue: 0,0:07:45.17,0:07:48.21,Caption,,0,0,0,,ЗА БЛОКИРОВКИ АНТИРОССИЙСКИХ САНКЦИЙ. ЗАМЕЧАТЕЛЬНАЯ
Dialogue: 0,0:07:48.21,0:07:51.33,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ГАРМОНИЯ. ОДИН ЕВРОПЕЙСКИЙ ЛИДЕР КРИЧИТ
Dialogue: 0,0:07:51.33,0:07:53.73,Caption,,0,0,0,,НА ДРУГОГО ЕВРОПЕЙСКОГО ЛИДЕРА ИЗ ЗА ТОГО,
Dialogue: 0,0:07:53.89,0:07:58.45,Caption,,0,0,0,,КАК ТОТ ГОЛОСУЕТ ПО РОССИИ, А ПОТОМ ВЕСЬ ЭТОТ КОЛЛЕКТИВ ДОЛЖЕН ВЫБРАТЬ ЧЕЛОВЕКА,
Dialogue: 0,0:07:58.69,0:08:00.85,Caption,,0,0,0,,КОТОРЫЙ ПОЕДЕТ К РОССИИ И СКАЖЕТ ВОТ НАША
Dialogue: 0,0:08:00.93,0:08:04.05,Caption,,0,0,0,,ЕДИНАЯ ЕВРОПЕЙСКАЯ ПОЗИЦИЯ. КАКАЯ ИМЕННО ЕДИНАЯ?
Dialogue: 0,0:08:04.05,0:08:06.45,Caption,,0,0,0,,ЕСЛИ СЛОВАКИЯ СМОТРИТ НА ЧАСТЬ ВОПРОСОВ ОДНИМ
Dialogue: 0,0:08:06.45,0:08:09.57,Caption,,0,0,0,,ОБРАЗОМ, ГЕРМАНИЯ ДРУГИМ, ФРАНЦИЯ ТРЕТЬИМ,
Dialogue: 0,0:08:09.73,0:08:12.53,Caption,,0,0,0,,ПРИБАЛТИЙСКИЕ ГОСУДАРСТВА ЧЕТВЁРТЫМ. ФИЦО ВООБЩЕ
Dialogue: 0,0:08:12.53,0:08:15.41,Caption,,0,0,0,,ГОВОРИТ, ЧТО В ПРОДОЛЖЕНИИ КОНФЛИКТА ЕСТЬ СИЛЫ,
Dialogue: 0,0:08:15.65,0:08:18.45,Caption,,0,0,0,,ЗАИНТЕРЕСОВАННЫЕ В ДЕНЬГАХ И ВЛИЯНИИ. ЭТО ЕГО
Dialogue: 0,0:08:18.53,0:08:24.32,Caption,,0,0,0,,ОЦЕНКА. НО САМО НАЛИЧИЕ ТАКИХ ВЗАИМНЫХ ОБВИНЕНИЙ УЖЕ ГОВОРИТ
Dialogue: 0,0:08:24.40,0:08:26.88,Caption,,0,0,0,,О КАЧЕСТВЕ ЕВРОПЕЙСКОГО ЕДИНСТВА ГОРАЗДО БОЛЬШЕ,
Dialogue: 0,0:08:27.12,0:08:30.48,Caption,,0,0,0,,ЧЕМ ОЧЕРЕДНАЯ ОБЩАЯ ФОТОГРАФИЯ ПОСЛЕ САММИТА. И ВОТ
Dialogue: 0,0:08:30.48,0:08:34.88,Caption,,0,0,0,,ТЕПЕРЬ СТАНОВИТСЯ ПОНЯТНО, ПОЧЕМУ ВЫБОР ПЕРЕГОВОРЩИКА ПРЕВРАЩАЕТСЯ В ОТДЕЛЬНУЮ
Dialogue: 0,0:08:34.88,0:08:37.60,Caption,,0,0,0,,ПОЛИТИЧЕСКУЮ ДРАКУ. ЭТО НЕ СПОР О КРАСИВОЙ
Dialogue: 0,0:08:37.60,0:08:39.84,Caption,,0,0,0,,ДОЛЖНОСТИ. КТО СИДИТ ЗА СТОЛОМ,
Dialogue: 0,0:08:39.92,0:08:41.92,Caption,,0,0,0,,ТОТ ПОЛУЧАЕТ ВОЗМОЖНОСТЬ ФОРМУЛИРОВАТЬ,
Dialogue: 0,0:08:42.08,0:08:45.12,Caption,,0,0,0,,ЧТО ИМЕННО СЧИТАЕТСЯ ЕВРОПЕЙСКИМ ИНТЕРЕСОМ. А
Dialogue: 0,0:08:45.12,0:08:47.28,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ИНТЕРЕС СЕГОДНЯ У БЕРЛИНА,
Dialogue: 0,0:08:47.36,0:08:50.96,Caption,,0,0,0,,ПАРИЖА, БРАТИСЛАВЫ И ТАЛЛИНА ДАЛЕКО НЕ ВСЕГДА ВЫГЛЯДИТ
Dialogue: 0,0:08:51.04,0:08:53.92,Caption,,0,0,0,,ОДИНАКОВО. ТЕМ ВРЕМЕНЕМ КИЕВ ТОЖЕ ДЕМОНСТРИРУЕТ
Dialogue: 0,0:08:53.92,0:08:56.88,Caption,,0,0,0,,УДИВИТЕЛЬНУЮ ДВОЙНУЮ КАРТИНУ. ЗЕЛЕНСКИЙ ГОВОРИТ О
Dialogue: 0,0:08:56.88,0:08:59.92,Caption,,0,0,0,,ПРОГРЕССЕ ПЕРЕГОВОРОВ. А ЗАМЕСТИТЕЛЬ ГЛАВЫ ЕГО ОФИСА
Dialogue: 0,0:09:00.00,0:09:02.56,Caption,,0,0,0,,ВЕРЕЩУК ГОВОРИТ УКРАИНЦАМ НЕ РАССЧИТЫВАТЬ НА СКОРЫЙ
Dialogue: 0,0:09:02.56,0:09:06.88,Caption,,0,0,0,,МИР. ОНА ПРЯМО ПРЕДУПРЕЖДАЕТ, ЧТО РОССИЯ НАРАЩИВАЕТ ПРОИЗВОДСТВО РАКЕТ И
Dialogue: 0,0:09:06.88,0:09:09.28,Caption,,0,0,0,,БЕСПИЛОТНИКОВ, ЧТО ЗИМА БУДЕТ ТЯЖЁЛОЙ,
Dialogue: 0,0:09:09.52,0:09:11.84,Caption,,0,0,0,,ЧТО ИНФРАСТРУКТУРА ПОВРЕЖДЕНА И ЛЮДЯМ НАДО
Dialogue: 0,0:09:11.84,0:09:14.96,Caption,,0,0,0,,ГОТОВИТЬСЯ. ЗАПАСАЙТЕСЬ ВОДОЙ. ГОТОВЬТЕСЬ К
Dialogue: 0,0:09:14.96,0:09:18.32,Caption,,0,0,0,,ПЕРЕБОЯМ. НА БЫСТРЫЙ МИР НЕ РАССЧИТЫВАЙТЕ. И ВСЁ
Dialogue: 0,0:09:18.40,0:09:20.64,Caption,,0,0,0,,ЭТО ЗВУЧИТ ОДНОВРЕМЕННО СО СЛОВАМИ О ПРОГРЕССЕ В
Dialogue: 0,0:09:20.64,0:09:23.84,Caption,,0,0,0,,АБУ ДАБИ. НЕТ ЗДЕСЬ НИКАКОЙ МИСТИКИ. ПЕРЕГОВОРЫ
Dialogue: 0,0:09:23.92,0:09:25.44,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО МОГУТ ИДТИ ВПЕРЁД,
Dialogue: 0,0:09:25.76,0:09:28.32,Caption,,0,0,0,,А ПОЛИТИЧЕСКОЕ РУКОВОДСТВО ОДНОВРЕМЕННО ГОТОВИТСЯ К
Dialogue: 0,0:09:28.40,0:09:30.96,Caption,,0,0,0,,ТОМУ, ЧТО ОНИ НИЧЕМ БЫСТРО НЕ ЗАКОНЧАТСЯ.
Dialogue: 0,0:09:33.17,0:09:36.53,Caption,,0,0,0,,ТАК ОБЫЧНО И ДЕЛАЮТ, КОГДА НЕ ХОТЯТ СКЛАДЫВАТЬ ВСЕ ЯЙЦА В ОДНУ
Dialogue: 0,0:09:36.53,0:09:39.73,Caption,,0,0,0,,КОРЗИНУ. ТОЛЬКО НАСЕЛЕНИЮ ОТ ЭТОЙ МУДРОЙ СТРАТЕГИИ
Dialogue: 0,0:09:39.81,0:09:42.53,Caption,,0,0,0,,НЕ ЛЕГЧЕ. ОСОБЕННО КОГДА ПОЯВЛЯЕТСЯ ЕЩЁ ОДНО
Dialogue: 0,0:09:42.61,0:09:45.25,Caption,,0,0,0,,ЗАЯВЛЕНИЕ. ДЕПУТАТ РАДЫ ЧЕРНЕВ ГОВОРИТ,
Dialogue: 0,0:09:45.47,0:09:47.65,Caption,,0,0,0,,ЧТО У РОССИИ ОСТАЛОСЬ ПОЛТОРА МЕСЯЦА,
Dialogue: 0,0:09:47.81,0:09:50.45,Caption,,0,0,0,,ЧТОБЫ ЗАКОНЧИТЬ КОНФЛИКТ НА ПРИЕМЛЕМЫХ УСЛОВИЯХ.
Dialogue: 0,0:09:50.60,0:09:55.01,Caption,,0,0,0,,ПОТОМ, ПО ЕГО ЛОГИКЕ, ДЕМОКРАТЫ В США ДАДУТ УКРАИНЕ НОВУЮ ПОМОЩЬ,
Dialogue: 0,0:09:55.25,0:09:58.37,Caption,,0,0,0,,А ПРОТИВ РОССИИ ПОЯВЯТСЯ НОВЫЕ САНКЦИИ. ВОТ ЗДЕСЬ
Dialogue: 0,0:09:58.37,0:10:00.93,Caption,,0,0,0,,УЖЕ СОВСЕМ ИНТЕРЕСНО. ТО ЕСТЬ ПОЛУЧАЕТСЯ,
Dialogue: 0,0:10:01.17,0:10:03.89,Caption,,0,0,0,,ЧТО КРОМЕ ПЕРЕГОВОРНОГО КАЛЕНДАРЯ СУЩЕСТВУЕТ ЕЩЁ
Dialogue: 0,0:10:03.97,0:10:07.25,Caption,,0,0,0,,ОДИН КАЛЕНДАРЬ. АМЕРИКАНСКИЙ ПОЛИТИЧЕСКИЙ. И ЧАСТЬ
Dialogue: 0,0:10:07.25,0:10:09.17,Caption,,0,0,0,,УКРАИНСКОГО РАСЧЁТА СТРОИТСЯ НА ТОМ,
Dialogue: 0,0:10:09.41,0:10:11.81,Caption,,0,0,0,,ЧТО НАДО ДОТЯНУТЬ ДО ИЗМЕНЕНИЯ РАСКЛАДА В
Dialogue: 0,0:10:11.81,0:10:15.01,Caption,,0,0,0,,ВАШИНГТОНЕ. НЕ ДОГОВОРИТЬСЯ СЕГОДНЯ НА ТЕХ УСЛОВИЯХ,
Dialogue: 0,0:10:15.16,0:10:17.81,Caption,,0,0,0,,КОТОРЫЕ ЕСТЬ СЕГОДНЯ, А ДОЖДАТЬСЯ МОМЕНТА,
Dialogue: 0,0:10:18.12,0:10:21.09,Caption,,0,0,0,,КОГДА ВНЕШНЯЯ СИТУАЦИЯ СТАНЕТ ЛУЧШЕ. ХОРОШИЙ ПЛАН.
Dialogue: 0,0:10:21.31,0:10:24.13,Caption,,0,0,0,,ТОЛЬКО ЕСТЬ ОДНА МАЛЕНЬКАЯ ПРОБЛЕМА. РОССИЯ ТОЖЕ
Dialogue: 0,0:10:24.21,0:10:26.61,Caption,,0,0,0,,УМЕЕТ СМОТРЕТЬ НА КАЛЕНДАРЬ. И ЕСЛИ В КИЕВЕ
Dialogue: 0,0:10:26.61,0:10:29.65,Caption,,0,0,0,,СЧИТАЮТ, ЧТО ЧЕРЕЗ ПОЛТОРА МЕСЯЦА ИХ ПОЛОЖЕНИЕ СТАНЕТ
Dialogue: 0,0:10:29.65,0:10:32.61,Caption,,0,0,0,,СИЛЬНЕЕ, ПОЧЕМУ МОСКВА ДОЛЖНА СЧИТАТЬ ИНАЧЕ?
Dialogue: 0,0:10:32.84,0:10:34.77,Caption,,0,0,0,,ТЕМ БОЛЕЕ ЧТО РОССИЯ УЖЕ МНОГО ЛЕТ ЖИВЁТ
Dialogue: 0,0:10:34.85,0:10:38.05,Caption,,0,0,0,,ПОД САНКЦИЯМИ. ОБЕЩАНИЕ ЕЩЁ ОДНОГО ПАКЕТА САМО ПО
Dialogue: 0,0:10:38.05,0:10:40.37,Caption,,0,0,0,,СЕБЕ ВРЯД ЛИ ВЫГЛЯДИТ КАК ВОЛШЕБНАЯ КНОПКА,
Dialogue: 0,0:10:40.60,0:10:42.93,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ КРЕМЛЬ ВНЕЗАПНО СКАЖЕТ ВСЁ,
Dialogue: 0,0:10:43.08,0:10:46.21,Caption,,0,0,0,,УБЕДИЛИ. И ЗДЕСЬ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ВАЖНАЯ МЫСЛЬ.
Dialogue: 0,0:10:48.48,0:10:50.72,Caption,,0,0,0,,НА УКРАИНЕ ПАРАЛЛЕЛЬНО ПРОДВИГАЕТСЯ ТЕЗИС,
Dialogue: 0,0:10:51.04,0:10:53.12,Caption,,0,0,0,,ЧТО МИР СЕЙЧАС БОЛЬШЕ НУЖЕН РОССИИ,
Dialogue: 0,0:10:53.34,0:10:56.40,Caption,,0,0,0,,ЧЕМ УКРАИНЕ. ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ. ЕСЛИ
Dialogue: 0,0:10:56.40,0:11:00.80,Caption,,0,0,0,,ПРОТИВНИКУ НУЖНЕЕ МИР, ЗНАЧИТ МОЖНО НЕ СПЕШИТЬ. МОЖНО ЖДАТЬ. МОЖНО
Dialogue: 0,0:11:00.80,0:11:03.76,Caption,,0,0,0,,ТРЕБОВАТЬ БОЛЬШЕ. МОЖНО НАДЕЯТЬСЯ НА АМЕРИКАНСКУЮ
Dialogue: 0,0:11:03.76,0:11:06.64,Caption,,0,0,0,,ПОЛИТИЧЕСКУЮ ПЕРЕСТРОЙКУ. ТОЛЬКО ТОГДА НАДО ЧЕСТНО
Dialogue: 0,0:11:06.72,0:11:09.68,Caption,,0,0,0,,ПОСМОТРЕТЬ И НА СОБСТВЕННУЮ СТОРОНУ. ВЕРЕЩУК ГОВОРИТ
Dialogue: 0,0:11:09.76,0:11:12.32,Caption,,0,0,0,,О ТЯЖЁЛОЙ ЗИМЕ. ЗЕЛЕНСКИЙ ГОВОРИТ О НЕОБХОДИМОСТИ
Dialogue: 0,0:11:12.32,0:11:15.04,Caption,,0,0,0,,ВОЗВРАЩЕНИЯ МУЖЧИН МОБИЛИЗАЦИОННОГО ВОЗРАСТА.
Dialogue: 0,0:11:15.42,0:11:17.44,Caption,,0,0,0,,ПРОДОЛЖАЮТСЯ ПРОБЛЕМЫ С ИНФРАСТРУКТУРОЙ.
Dialogue: 0,0:11:17.69,0:11:19.60,Caption,,0,0,0,,ПРОДОЛЖАЕТСЯ ПОТРЕБНОСТЬ В ЛЮДЯХ,
Dialogue: 0,0:11:19.66,0:11:23.52,Caption,,0,0,0,,ДЕНЬГАХ, ВООРУЖЕНИЯХ. И ПОСЛЕ ЭТОГО РАССКАЗЫВАТЬ ОБЩЕСТВУ,
Dialogue: 0,0:11:23.76,0:11:26.32,Caption,,0,0,0,,ЧТО ВРЕМЯ РАБОТАЕТ ИСКЛЮЧИТЕЛЬНО ПРОТИВ РОССИИ,
Dialogue: 0,0:11:26.44,0:11:29.04,Caption,,0,0,0,,ДОВОЛЬНО СМЕЛО. ОСОБЕННО КРАСИВО ПОЛУЧИЛОСЬ С
Dialogue: 0,0:11:29.04,0:11:31.92,Caption,,0,0,0,,УКРАИНСКИМИ МУЖЧИНАМИ В ЕВРОПЕ. ЗЕЛЕНСКИЙ ПРИЗЫВАЕТ
Dialogue: 0,0:11:32.00,0:11:34.64,Caption,,0,0,0,,МУЖЧИН МОБИЛИЗАЦИОННОГО ВОЗРАСТА ВОЗВРАЩАТЬСЯ ДОМОЙ.
Dialogue: 0,0:11:35.01,0:11:37.60,Caption,,0,0,0,,ПРЕМЬЕР ИРЛАНДИИ ОТВЕЧАЕТ МЫ ОТПРАВЛЯТЬ УКРАИНСКИХ
Dialogue: 0,0:11:37.68,0:11:40.08,Caption,,0,0,0,,МУЖЧИН ОБРАТНО НЕ БУДЕМ. ВОТ ВАМ ЕЩЁ ОДИН
Dialogue: 0,0:11:40.08,0:11:42.48,Caption,,0,0,0,,МАЛЕНЬКИЙ КУСОЧЕК ТОЙ САМОЙ ЕВРОПЕЙСКОЙ ЕДИНОЙ
Dialogue: 0,0:11:42.48,0:11:45.84,Caption,,0,0,0,,ПОЗИЦИИ. УКРАИНА ГОВОРИТ НАМ НУЖНЫ НАШИ ГРАЖДАНЕ.
Dialogue: 0,0:11:46.15,0:11:48.48,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ГОСУДАРСТВО ОТВЕЧАЕТ ПРИНУДИТЕЛЬНО
Dialogue: 0,0:11:48.48,0:11:50.48,Caption,,0,0,0,,ОТДАВАТЬ ИХ НЕ БУДЕМ. И ЗДЕСЬ УЖЕ НЕ
Dialogue: 0,0:11:50.48,0:11:52.88,Caption,,0,0,0,,ПОМОГУТ НИКАКИЕ КРАСИВЫЕ РЕЧИ О ЕДИНСТВЕ.
Dialogue: 0,0:11:55.06,0:11:57.86,Caption,,0,0,0,,КОГДА РАЗГОВОР ДОХОДИТ НЕ ДО ЗАЯВЛЕНИЯ НА САММИТЕ,
Dialogue: 0,0:11:58.10,0:12:01.70,Caption,,0,0,0,,А ДО КОНКРЕТНОГО ЧЕЛОВЕКА, КОТОРОГО НАДО ПОСАДИТЬ В САМОЛЁТ И ОТПРАВИТЬ
Dialogue: 0,0:12:01.78,0:12:04.42,Caption,,0,0,0,,ОБРАТНО, ВНЕЗАПНО ПОЯВЛЯЮТСЯ ЗАКОНЫ,
Dialogue: 0,0:12:04.50,0:12:07.62,Caption,,0,0,0,,ПРАВА, ВНУТРЕННЯЯ ПОЛИТИКА И СОБСТВЕННЫЕ ИНТЕРЕСЫ
Dialogue: 0,0:12:07.62,0:12:10.90,Caption,,0,0,0,,ГОСУДАРСТВА. ВОТ ЭТО И ЕСТЬ РЕАЛЬНАЯ ЕВРОПА. НЕ
Dialogue: 0,0:12:10.90,0:12:14.02,Caption,,0,0,0,,ОДИН МАКРОН. НЕ ОДНА КАЛЛАС. НЕ ОДИН КОШТА.
Dialogue: 0,0:12:14.34,0:12:18.42,Caption,,0,0,0,,ДВАДЦАТЬ СЕМЬ ГОСУДАРСТВ, КАЖДОЕ СО СВОИМИ ПРОБЛЕМАМИ. И ТЕПЕРЬ ЭТУ
Dialogue: 0,0:12:18.42,0:12:21.22,Caption,,0,0,0,,КОНСТРУКЦИЮ ПЫТАЮТСЯ ПОСАДИТЬ ЗА ОДИН ПЕРЕГОВОРНЫЙ
Dialogue: 0,0:12:21.30,0:12:24.10,Caption,,0,0,0,,СТОЛ И ДАТЬ ЕЙ ОДИН ГОЛОС. ЗАДАЧА,
Dialogue: 0,0:12:24.21,0:12:27.54,Caption,,0,0,0,,МЯГКО ГОВОРЯ, НЕ ИЗ ПРОСТЫХ. НО ПРИ ВСЕЙ ИРОНИИ Я
Dialogue: 0,0:12:27.62,0:12:29.94,Caption,,0,0,0,,БЫ НЕ ПРОПУСКАЛ ГЛАВНОЕ. ПОЛИТИЧЕСКИЙ ПРОЦЕСС
Dialogue: 0,0:12:29.94,0:12:33.06,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ИЗМЕНИЛСЯ. ЕВРОПА УЖЕ НЕ СПОРИТ ТОЛЬКО
Dialogue: 0,0:12:33.14,0:12:36.26,Caption,,0,0,0,,О ТОМ, НУЖНО ЛИ РАЗГОВАРИВАТЬ С МОСКВОЙ. ОНА СПОРИТ О
Dialogue: 0,0:12:36.26,0:12:39.62,Caption,,0,0,0,,ТОМ, КТО БУДЕТ РАЗГОВАРИВАТЬ. СЛЕДУЮЩИЙ РАУНД УЖЕ
Dialogue: 0,0:12:39.62,0:12:42.66,Caption,,0,0,0,,ОБСУЖДАЕТСЯ. АМЕРИКАНСКИЕ ПОСРЕДНИКИ ПЕРЕМЕЩАЮТСЯ
Dialogue: 0,0:12:42.66,0:12:47.14,Caption,,0,0,0,,МЕЖДУ МОСКВОЙ, КИЕВОМ И ЕВРОПЕЙСКИМИ СТОЛИЦАМИ. ЗЕЛЕНСКИЙ ПУБЛИЧНО
Dialogue: 0,0:12:47.22,0:12:50.18,Caption,,0,0,0,,ГОВОРИТ О ПРОГРЕССЕ. РОССИЯ ПРОДОЛЖАЕТ ФОРМУЛИРОВАТЬ
Dialogue: 0,0:12:50.18,0:12:53.14,Caption,,0,0,0,,СВОИ ТРЕБОВАНИЯ. ДАЖЕ САМА ЕВРОПЕЙСКАЯ БОРЬБА ЗА
Dialogue: 0,0:12:53.14,0:12:55.70,Caption,,0,0,0,,КРЕСЛО ПЕРЕГОВОРЩИКА ЯВЛЯЕТСЯ ПРИЗНАКОМ ТОГО,
Dialogue: 0,0:12:55.87,0:12:58.66,Caption,,0,0,0,,ЧТО ЭТО КРЕСЛО ВНЕЗАПНО СТАЛО ЦЕННЫМ. А ВОТ
Dialogue: 0,0:12:58.74,0:13:01.70,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ ТЯЖЁЛОЕ. ПОТОМУ ЧТО СОБРАТЬ
Dialogue: 0,0:13:01.70,0:13:03.86,Caption,,0,0,0,,ВСЕХ ВОКРУГ СТОЛА НАМНОГО ПРОЩЕ,
Dialogue: 0,0:13:04.10,0:13:08.42,Caption,,0,0,0,,ЧЕМ СДЕЛАТЬ ТАК, ЧТОБЫ ОНИ ОДИНАКОВО ПОНИМАЛИ ПРЕДМЕТ РАЗГОВОРА. КИЕВ
Dialogue: 0,0:13:08.42,0:13:14.78,Caption,,0,0,0,,ХОЧЕТ ОДНОГО. МОСКВА ГОВОРИТ О ДРУГОМ. ЕВРОПЕЙСКИЕ СТРАНЫ СПОРЯТ
Dialogue: 0,0:13:14.86,0:13:18.30,Caption,,0,0,0,,ДАЖЕ МЕЖДУ СОБОЙ. ВАШИНГТОН ПЫТАЕТСЯ ЭТО СВЕСТИ. И
Dialogue: 0,0:13:18.30,0:13:20.06,Caption,,0,0,0,,КАЖДЫЙ СМОТРИТ НЕ ТОЛЬКО НА ФРОНТ,
Dialogue: 0,0:13:20.22,0:13:22.86,Caption,,0,0,0,,НО И НА ВЫБОРЫ, РЕЙТИНГИ, БЮДЖЕТЫ,
Dialogue: 0,0:13:22.94,0:13:27.10,Caption,,0,0,0,,САНКЦИИ, МОБИЛИЗАЦИЮ И СОБСТВЕННОЕ ПОЛИТИЧЕСКОЕ БУДУЩЕЕ.
Dialogue: 0,0:13:27.66,0:13:30.14,Caption,,0,0,0,,ПОЭТОМУ ГЛАВНЫМ РЕЗУЛЬТАТОМ ПОСЛЕДНИХ ДНЕЙ Я БЫ
Dialogue: 0,0:13:30.22,0:13:33.02,Caption,,0,0,0,,СЧИТАЛ НЕ ОЧЕРЕДНУЮ КРАСИВУЮ ФОРМУЛУ О ПРИБЛИЖЕНИИ
Dialogue: 0,0:13:33.02,0:13:36.22,Caption,,0,0,0,,МИРА. РЕЗУЛЬТАТ ГОРАЗДО ПРИЗЕМЛЁННЕЕ. ВСЕ НАКОНЕЦ
Dialogue: 0,0:13:36.30,0:13:38.70,Caption,,0,0,0,,НАЧАЛИ ДВИГАТЬСЯ. ТЕПЕРЬ ОСТАЛОСЬ ВЫЯСНИТЬ,
Dialogue: 0,0:13:38.94,0:13:41.58,Caption,,0,0,0,,ДВИЖУТСЯ ОНИ НАВСТРЕЧУ ДРУГ ДРУГУ ИЛИ ПРОСТО
Dialogue: 0,0:13:41.58,0:13:43.50,Caption,,0,0,0,,ОДНОВРЕМЕННО ПОБЕЖАЛИ К ОДНОМУ СТОЛУ,
Dialogue: 0,0:13:43.67,0:13:45.74,Caption,,0,0,0,,ЧТОБЫ НИКТО ДРУГОЙ НЕ ДОГОВОРИЛСЯ БЕЗ НИХ.
