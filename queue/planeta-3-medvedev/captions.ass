Dialogue: 0,0:00:00.12,0:00:01.79,Caption,,0,0,0,,КОГДА НА ЗАБОРЕ ВИСИТ ТАБЛИЧКА О
Dialogue: 0,0:00:01.79,0:00:05.33,Caption,,0,0,0,,СМЕРТЕЛЬНОМ НАПРЯЖЕНИИ, НОРМАЛЬНЫЙ ЧЕЛОВЕК К ПРОВОЛОКЕ НЕ
Dialogue: 0,0:00:05.33,0:00:08.28,Caption,,0,0,0,,ЛЕЗЕТ. НО ЕСЛИ ОН СПОКОЙНО ПЕРЕЛЕЗАЕТ ЧЕРЕЗ ОГРАДУ,
Dialogue: 0,0:00:08.52,0:00:10.84,Caption,,0,0,0,,УСТРАИВАЕТСЯ ПОУДОБНЕЕ И ЕЩЁ ЗОВЁТ
Dialogue: 0,0:00:10.84,0:00:13.85,Caption,,0,0,0,,ДРУЗЕЙ, ВАРИАНТОВ НЕМНОГО. ЛИБО ОН СОШЁЛ С
Dialogue: 0,0:00:13.85,0:00:17.32,Caption,,0,0,0,,УМА, ЛИБО УВЕРЕН, ЧТО ТОК ВКЛЮЧАТ ТОЛЬКО ПОСЛЕ ТОГО,
Dialogue: 0,0:00:17.56,0:00:19.63,Caption,,0,0,0,,КАК ОН УЖЕ УНЕСЁТ ПОЛОВИНУ ДВОРА.
Dialogue: 0,0:00:19.63,0:00:22.45,Caption,,0,0,0,,ИМЕННО ВТОРОЙ ВАРИАНТ СЕЙЧАС ВЫГЛЯДИТ ОСОБЕННО
Dialogue: 0,0:00:22.45,0:00:25.00,Caption,,0,0,0,,НЕПРИЯТНО. ЕСЛИ ВАМ ИНТЕРЕСЕН РАЗБОР ПРИЧИН,
Dialogue: 0,0:00:25.16,0:00:26.91,Caption,,0,0,0,,А НЕ ТОРЖЕСТВЕННОЕ ЧТЕНИЕ ЧУЖИХ
Dialogue: 0,0:00:26.91,0:00:29.91,Caption,,0,0,0,,ЗАЯВЛЕНИЙ, ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ МЫ СМОТРИМ
Dialogue: 0,0:00:29.91,0:00:32.12,Caption,,0,0,0,,НЕ НА ГРОМКОСТЬ СЛОВ, А НА ТО,
Dialogue: 0,0:00:32.29,0:00:34.76,Caption,,0,0,0,,ПОЧЕМУ ПОСЛЕ НИХ ПРОТИВНИК НЕ ОТСТУПАЕТ,
Dialogue: 0,0:00:34.92,0:00:36.68,Caption,,0,0,0,,А ПРОСИТ ПРИНЕСТИ ЛЕСТНИЦУ ПОВЫШЕ.
Dialogue: 0,0:00:37.65,0:00:39.67,Caption,,0,0,0,,ДМИТРИЙ МЕДВЕДЕВ СНОВА ВЫШЕЛ ВПЕРЁД И
Dialogue: 0,0:00:39.67,0:00:42.42,Caption,,0,0,0,,ЗАГОВОРИЛ ТАК, БУДТО ОСТАЛЬНЫЕ ПОКА ТОЛЬКО
Dialogue: 0,0:00:42.42,0:00:44.60,Caption,,0,0,0,,РАЗМИНАЮТСЯ. РЕЗКО, НАПОРИСТО,
Dialogue: 0,0:00:44.92,0:00:46.60,Caption,,0,0,0,,С ПРИВЫЧНЫМ ВЫРАЖЕНИЕМ ЧЕЛОВЕКА,
Dialogue: 0,0:00:46.84,0:00:48.92,Caption,,0,0,0,,КОТОРЫЙ УЖЕ ВСЁ РЕШИЛ И ТЕПЕРЬ ЖДЁТ,
Dialogue: 0,0:00:49.08,0:00:51.41,Caption,,0,0,0,,КОГДА ОКРУЖАЮЩИЕ ДОГАДАЮТСЯ. НА ЭТОТ
Dialogue: 0,0:00:51.41,0:00:53.24,Caption,,0,0,0,,РАЗ РЕЧЬ НЕ О КОРОТКОЙ ЗАПИСИ,
Dialogue: 0,0:00:53.39,0:00:57.08,Caption,,0,0,0,,А О БОЛЬШОЙ НАУЧНОЙ СТАТЬЕ, ПОСВЯЩЁННОЙ ЯДЕРНОМУ ОРУЖИЮ,
Dialogue: 0,0:00:57.29,0:00:59.32,Caption,,0,0,0,,РОССИЙСКОЙ ДОКТРИНЕ И ГРАНИЦАМ,
Dialogue: 0,0:00:59.48,0:01:01.40,Caption,,0,0,0,,ПОСЛЕ КОТОРЫХ МОСКВА МОЖЕТ ПЕРЕЙТИ К
Dialogue: 0,0:01:01.40,0:01:05.58,Caption,,0,0,0,,СОВЕРШЕННО ИНЫМ СРЕДСТВАМ. САМАЯ ВАЖНАЯ МЫСЛЬ ТАМ ЗВУЧИТ КУДА
Dialogue: 0,0:01:05.58,0:01:09.00,Caption,,0,0,0,,СЕРЬЁЗНЕЕ ОБЫЧНЫХ ПРЕДУПРЕЖДЕНИЙ. ПО ЛОГИКЕ МЕДВЕДЕВА,
Dialogue: 0,0:01:09.27,0:01:12.58,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВА, ПОЗВОЛЯВШИЕ РОССИИ ПРИМЕНИТЬ ЯДЕРНОЕ
Dialogue: 0,0:01:12.58,0:01:17.52,Caption,,0,0,0,,ОРУЖИЕ, УЖЕ ВОЗНИКАЛИ. ОТВЕТА НЕ ПОСЛЕДОВАЛО,
Dialogue: 0,0:01:17.73,0:01:19.45,Caption,,0,0,0,,ПОСКОЛЬКУ РУКОВОДСТВО ОЦЕНИВАЛО
Dialogue: 0,0:01:19.45,0:01:22.08,Caption,,0,0,0,,НАНЕСЁННЫЙ УЩЕРБ, ВОЗМОЖНЫЕ ПОСЛЕДСТВИЯ,
Dialogue: 0,0:01:22.16,0:01:24.37,Caption,,0,0,0,,СОРАЗМЕРНОСТЬ И ОБЩУЮ ОБСТАНОВКУ.
Dialogue: 0,0:01:24.37,0:01:27.58,Caption,,0,0,0,,ПОЛУЧАЕТСЯ СТРАННАЯ КОНСТРУКЦИЯ. ФОРМАЛЬНОЕ ПРАВО
Dialogue: 0,0:01:27.58,0:01:30.48,Caption,,0,0,0,,НА УДАР УЖЕ ПОЯВЛЯЛОСЬ, ДВЕРЬ К НЕМУ ОТКРЫВАЛАСЬ,
Dialogue: 0,0:01:30.96,0:01:32.84,Caption,,0,0,0,,НО МОСКВА КАЖДЫЙ РАЗ ОСТАВАЛАСЬ В
Dialogue: 0,0:01:32.84,0:01:36.56,Caption,,0,0,0,,КОРИДОРЕ, ВЗВЕШИВАЯ ЦЕНУ СЛЕДУЮЩЕГО ШАГА. ДАЛЬШЕ
Dialogue: 0,0:01:36.56,0:01:39.46,Caption,,0,0,0,,МЕДВЕДЕВ ОБОЗНАЧАЕТ НОВУЮ ГРАНИЦУ. ПЕРЕДАЧА
Dialogue: 0,0:01:39.46,0:01:42.64,Caption,,0,0,0,,УКРАИНЕ ЯДЕРНОГО ОРУЖИЯ, ТАЙНАЯ ИЛИ ОТКРЫТАЯ,
Dialogue: 0,0:01:42.96,0:01:44.67,Caption,,0,0,0,,ДОЛЖНА ПРИВЕСТИ К ПРЕВЕНТИВНОМУ
Dialogue: 0,0:01:44.67,0:01:48.53,Caption,,0,0,0,,ЯДЕРНОМУ УДАРУ РОССИИ. ВТОРОЙ ВАРИАНТ СВЯЗАН С МАССИРОВАННЫМ
Dialogue: 0,0:01:48.53,0:01:50.24,Caption,,0,0,0,,ПРИМЕНЕНИЕМ ОБЫЧНЫХ ВООРУЖЕНИЙ,
Dialogue: 0,0:01:50.48,0:01:52.88,Caption,,0,0,0,,ЕСЛИ ОНО ГРОЗИТ КОЛОССАЛЬНОЙ ТЕХНОГЕННОЙ,
Dialogue: 0,0:01:53.02,0:01:55.28,Caption,,0,0,0,,ЭКОЛОГИЧЕСКОЙ ЛИБО СОЦИАЛЬНОЙ КАТАСТРОФОЙ.
Dialogue: 0,0:01:55.80,0:01:58.00,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЕ ТЯЖЁЛОЕ. ЗДЕСЬ УЖЕ НЕ
Dialogue: 0,0:01:58.00,0:02:01.06,Caption,,0,0,0,,ПРО ОЧЕРЕДНОЙ ПАКЕТ САНКЦИЙ И НЕ ПРО СЕРДИТЫЙ ЗВОНОК
Dialogue: 0,0:02:01.06,0:02:03.52,Caption,,0,0,0,,ПОСЛЕ ОБЕДА. ОДНАКО ВОЗНИКАЕТ ВОПРОС,
Dialogue: 0,0:02:03.65,0:02:05.54,Caption,,0,0,0,,БЕЗ КОТОРОГО ВСЯ ГРОЗНОСТЬ НАЧИНАЕТ
Dialogue: 0,0:02:05.54,0:02:08.84,Caption,,0,0,0,,РАСПЛЫВАТЬСЯ. ВОКРУГ УЖЕ УВЕРЕННО РАССУЖДАЮТ ОБ
Dialogue: 0,0:02:08.84,0:02:12.24,Caption,,0,0,0,,УДАРЕ ПО КИЕВУ И НАТО, ХОТЯ САМ МЕДВЕДЕВ ТОЧНУЮ ЦЕЛЬ НЕ
Dialogue: 0,0:02:12.24,0:02:14.81,Caption,,0,0,0,,УКАЗАЛ. ПОЛУЧАТЕЛЕМ СТАНЕТ УКРАИНСКОЕ
Dialogue: 0,0:02:14.81,0:02:18.08,Caption,,0,0,0,,РУКОВОДСТВО? ГОСУДАРСТВО, ПЕРЕДАВШЕЕ БОЕПРИПАС?
Dialogue: 0,0:02:18.48,0:02:20.48,Caption,,0,0,0,,ОБЪЕКТЫ СЕВЕРОАТЛАНТИЧЕСКОГО АЛЬЯНСА?
Dialogue: 0,0:02:20.96,0:02:24.59,Caption,,0,0,0,,ИЛИ СПИСОК НАСТОЛЬКО ШИРОКИЙ, ЧТО КУРЬЕРУ ПОНАДОБИТСЯ ОТДЕЛЬНАЯ
Dialogue: 0,0:02:24.59,0:02:28.47,Caption,,0,0,0,,ТЕЛЕЖКА? ОСОБЕННО ЗАНЯТНО, ЧТО НАИБОЛЕЕ ЖЁСТКИЕ ПОЛОЖЕНИЯ
Dialogue: 0,0:02:28.47,0:02:31.68,Caption,,0,0,0,,СПРЯТАЛИСЬ В СНОСКАХ, А НЕ ВСТРЕТИЛИ ЧИТАТЕЛЯ НА ПЕРВОЙ
Dialogue: 0,0:02:31.68,0:02:35.93,Caption,,0,0,0,,СТРАНИЦЕ. У ПУБЛИЧНЫХ ДОКУМЕНТОВ ВООБЩЕ
Dialogue: 0,0:02:35.93,0:02:39.41,Caption,,0,0,0,,УДИВИТЕЛЬНЫЙ ХАРАКТЕР. ГЛАВНОЕ ОБЕЩАЮТ СВЕРХУ КРУПНО И
Dialogue: 0,0:02:39.41,0:02:42.51,Caption,,0,0,0,,УВЕРЕННО, А НАСТОЯЩИЙ СЮРПРИЗ ОСТАВЛЯЮТ ВНИЗУ
Dialogue: 0,0:02:42.51,0:02:46.08,Caption,,0,0,0,,МЕЛКИМИ БУКВАМИ. ПОЧТИ КАК БАНКОВСКИЙ ДОГОВОР СНАЧАЛА
Dialogue: 0,0:02:46.08,0:02:48.18,Caption,,0,0,0,,ВАМ УЛЫБАЮТСЯ, ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:02:48.34,0:02:50.71,Caption,,0,0,0,,ЧТО УЛЫБКА ТОЖЕ ВКЛЮЧЕНА В ЕЖЕМЕСЯЧНЫЙ
Dialogue: 0,0:02:50.71,0:02:53.22,Caption,,0,0,0,,ПЛАТЁЖ. МЕДВЕДЕВ ПРЕДЛАГАЕТ И ПОНЯТНОЕ
Dialogue: 0,0:02:53.22,0:02:55.87,Caption,,0,0,0,,СРАВНЕНИЕ. В ДВЕ ТЫСЯЧИ ДЕВЯТНАДЦАТОМ ГОДУ
Dialogue: 0,0:02:55.87,0:02:59.22,Caption,,0,0,0,,УКРАИНА ВНЕСЛА В СВОЮ КОНСТИТУЦИЮ КУРС НА ВСТУПЛЕНИЕ В
Dialogue: 0,0:02:59.22,0:03:01.79,Caption,,0,0,0,,НАТО. В ДВЕ ТЫСЯЧИ ДВАДЦАТОМ ГОДУ ОНА ПОЛУЧИЛА
Dialogue: 0,0:03:01.79,0:03:04.03,Caption,,0,0,0,,СТАТУС ПАРТНЁРА АЛЬЯНСА С РАСШИРЕННЫМИ
Dialogue: 0,0:03:04.03,0:03:07.66,Caption,,0,0,0,,ВОЗМОЖНОСТЯМИ. РОССИЯ МНОГО ЛЕТ НАЗЫВАЛА ДАЛЬНЕЙШЕЕ
Dialogue: 0,0:03:07.66,0:03:10.36,Caption,,0,0,0,,ВОЕННОЕ СБЛИЖЕНИЕ НЕПОСРЕДСТВЕННОЙ УГРОЗОЙ.
Dialogue: 0,0:03:10.36,0:03:13.62,Caption,,0,0,0,,ТЕПЕРЬ ПРЕДСТАВИМ, ЧТО МОСКВА ПРЕДЛАГАЕТ ИРАНУ ПОРЯДОК,
Dialogue: 0,0:03:13.78,0:03:16.27,Caption,,0,0,0,,ПОХОЖИЙ НА НАТОВСКИЙ. ЯДЕРНОЕ ОРУЖИЕ
Dialogue: 0,0:03:16.27,0:03:19.70,Caption,,0,0,0,,ОСТАЁТСЯ РОССИЙСКИМ, УПРАВЛЯЕТ ИМ РОССИЙСКОЕ КОМАНДОВАНИЕ,
Dialogue: 0,0:03:19.94,0:03:21.74,Caption,,0,0,0,,НО ФИЗИЧЕСКИ ОНО РАЗМЕЩАЕТСЯ НА
Dialogue: 0,0:03:21.74,0:03:25.35,Caption,,0,0,0,,ИРАНСКОЙ ТЕРРИТОРИИ. ВАШИНГТОН ВРЯД ЛИ СОЗВАЛ БЫ СПОКОЙНЫЙ
Dialogue: 0,0:03:25.35,0:03:27.24,Caption,,0,0,0,,СЕМИНАР О ТЕХНИЧЕСКИХ ОСОБЕННОСТЯХ
Dialogue: 0,0:03:27.24,0:03:30.57,Caption,,0,0,0,,СОТРУДНИЧЕСТВА. ТАМ БЫ БЫСТРО ЗАКОНЧИЛИСЬ УМНЫЕ ТЕРМИНЫ И
Dialogue: 0,0:03:30.57,0:03:33.96,Caption,,0,0,0,,НАЧАЛИСЬ ОЧЕНЬ НЕРВНЫЕ СОВЕЩАНИЯ. В ЭТОЙ ЧАСТИ ДОВОД
Dialogue: 0,0:03:33.96,0:03:36.98,Caption,,0,0,0,,МЕДВЕДЕВА ПРЕДЕЛЬНО ЯСЕН. НЕЛЬЗЯ СЧИТАТЬ ОДНУ И
Dialogue: 0,0:03:36.98,0:03:39.36,Caption,,0,0,0,,ТУ ЖЕ СХЕМУ СМЕРТЕЛЬНОЙ ОПАСНОСТЬЮ ВОЗЛЕ
Dialogue: 0,0:03:39.36,0:03:42.25,Caption,,0,0,0,,СОБСТВЕННОЙ ГРАНИЦЫ И БЕЗОБИДНЫМ ПАРТНЁРСТВОМ
Dialogue: 0,0:03:42.25,0:03:47.66,Caption,,0,0,0,,ВОЗЛЕ ЧУЖОЙ. ТАКАЯ АРИФМЕТИКА РАБОТАЕТ ЛИШЬ ДО ТЕХ
Dialogue: 0,0:03:47.66,0:03:49.98,Caption,,0,0,0,,ПОР, ПОКА ВТОРОЙ УЧАСТНИК СОГЛАШАЕТСЯ
Dialogue: 0,0:03:49.98,0:03:53.43,Caption,,0,0,0,,ИЗОБРАЖАТЬ КАЛЬКУЛЯТОР БЕЗ БАТАРЕЕК. НО НАЛИЧИЕ
Dialogue: 0,0:03:53.43,0:03:55.73,Caption,,0,0,0,,ЯДЕРНОГО АРСЕНАЛА САМО ПО СЕБЕ ЕЩЁ НЕ
Dialogue: 0,0:03:55.73,0:03:58.31,Caption,,0,0,0,,ГАРАНТИРУЕТ СДЕРЖИВАНИЯ. ДЛЯ ЭТОГО ПРОТИВНИК
Dialogue: 0,0:03:58.31,0:04:00.71,Caption,,0,0,0,,ДОЛЖЕН ВЕРИТЬ НЕ ТОЛЬКО В ИСПРАВНОСТЬ РАКЕТ,
Dialogue: 0,0:04:00.95,0:04:02.73,Caption,,0,0,0,,НО И В ГОТОВНОСТЬ ГОСУДАРСТВА ИМИ
Dialogue: 0,0:04:02.73,0:04:06.09,Caption,,0,0,0,,ВОСПОЛЬЗОВАТЬСЯ. КОЛИЧЕСТВО РОССИЙСКИХ БОЕГОЛОВОК ТАМ
Dialogue: 0,0:04:06.09,0:04:09.59,Caption,,0,0,0,,ИЗВЕСТНО. О ПОДВОДНЫХ ЛОДКАХ, СТРАТЕГИЧЕСКОЙ АВИАЦИИ,
Dialogue: 0,0:04:09.74,0:04:12.06,Caption,,0,0,0,,РАКЕТНЫХ КОМПЛЕКСАХ И ПОСЕЙДОНЕ ТОЖЕ
Dialogue: 0,0:04:12.06,0:04:15.30,Caption,,0,0,0,,НИКТО НЕ ЗАБЫЛ. В ШТАБАХ НЕ ПОТЕРЯЛИ ПАПКУ И НЕ
Dialogue: 0,0:04:15.30,0:04:17.03,Caption,,0,0,0,,ПЕРЕПУТАЛИ ЕЁ С МЕНЮ СТОЛОВОЙ.
Dialogue: 0,0:04:17.66,0:04:20.53,Caption,,0,0,0,,ПОХОЖЕ, ВЫВОД СДЕЛАН ДРУГОЙ. РОССИЙСКИЙ
Dialogue: 0,0:04:20.53,0:04:24.05,Caption,,0,0,0,,АРСЕНАЛ СУЩЕСТВУЕТ, ОБЛАДАЕТ ЧУДОВИЩНОЙ МОЩЬЮ И СПОСОБЕН
Dialogue: 0,0:04:24.05,0:04:26.96,Caption,,0,0,0,,ПРИВЕСТИ К ГЛОБАЛЬНОЙ КАТАСТРОФЕ. НО МОСКВА НЕ
Dialogue: 0,0:04:26.96,0:04:29.76,Caption,,0,0,0,,ПРИМЕНИТ ЕГО, ПОКА ПОЛОЖЕНИЕ НЕ СТАНЕТ ПОЧТИ
Dialogue: 0,0:04:29.76,0:04:33.22,Caption,,0,0,0,,БЕЗВЫХОДНЫМ. ТАКОЙ ВЫВОД МЕНЯЕТ ЗНАЧЕНИЕ ВСЕГО АРСЕНАЛА
Dialogue: 0,0:04:33.22,0:04:35.62,Caption,,0,0,0,,СИЛЬНЕЕ, ЧЕМ ЛЮБЫЕ ТАБЛИЦЫ С КОЛИЧЕСТВОМ
Dialogue: 0,0:04:35.62,0:04:38.23,Caption,,0,0,0,,ЗАРЯДОВ. ЧТОБЫ ДОБРАТЬСЯ ДО ЭТОЙ ЧЕРТЫ,
Dialogue: 0,0:04:38.55,0:04:40.53,Caption,,0,0,0,,РОССИЯ ДОЛЖНА ПРОЙТИ ЧЕРЕЗ КРАЙНЕ
Dialogue: 0,0:04:40.53,0:04:43.79,Caption,,0,0,0,,ТЯЖЁЛУЮ ЦЕПОЧКУ СОБЫТИЙ. ФАКТИЧЕСКИ ПРИБЛИЗИТЬСЯ К
Dialogue: 0,0:04:43.79,0:04:47.04,Caption,,0,0,0,,ПОРАЖЕНИЮ НАСТОЛЬКО, ЧТОБЫ ОБЫЧНЫЕ СРЕДСТВА БОЛЬШЕ НЕ
Dialogue: 0,0:04:47.04,0:04:49.59,Caption,,0,0,0,,ПОЗВОЛЯЛИ УДЕРЖАТЬ СИТУАЦИЮ. ЗАПАД,
Dialogue: 0,0:04:49.90,0:04:53.32,Caption,,0,0,0,,СУДЯ ПО ЕГО ДЕЙСТВИЯМ, ИЗУЧИЛ МАНЕРУ МОСКВЫ ПРИНИМАТЬ САМЫЕ
Dialogue: 0,0:04:53.32,0:04:58.56,Caption,,0,0,0,,ТРУДНЫЕ РЕШЕНИЯ. ВЛАДИМИР ПУТИН ОБЫЧНО ДОЛГО СОХРАНЯЕТ
Dialogue: 0,0:04:58.56,0:05:00.50,Caption,,0,0,0,,ПРОСТРАНСТВО ДЛЯ ЕЩЁ ОДНОГО ХОДА,
Dialogue: 0,0:05:00.67,0:05:04.22,Caption,,0,0,0,,ЕЩЁ ОДНОЙ ПАУЗЫ, ЕЩЁ ОДНОЙ ВОЗМОЖНОСТИ НЕ ПЕРЕСТУПАТЬ
Dialogue: 0,0:05:04.22,0:05:07.46,Caption,,0,0,0,,ПОСЛЕДНЮЮ ЧЕРТУ. ИМЕННО ЭТУ ОСТОРОЖНОСТЬ ТАМ,
Dialogue: 0,0:05:07.62,0:05:10.66,Caption,,0,0,0,,ВЕРОЯТНО, И ВКЛЮЧИЛИ В СОБСТВЕННЫЙ РАСЧЁТ. НИКТО
Dialogue: 0,0:05:10.66,0:05:13.74,Caption,,0,0,0,,НЕ УБЕЖДАЕТ СЕБЯ, ЧТО РОССИЙСКОГО ЯДЕРНОГО ОРУЖИЯ НЕ
Dialogue: 0,0:05:13.74,0:05:16.32,Caption,,0,0,0,,СУЩЕСТВУЕТ. УБЕЖДАЮТ СЕБЯ В ДРУГОМ ДО ЕГО
Dialogue: 0,0:05:16.32,0:05:19.50,Caption,,0,0,0,,ПРИМЕНЕНИЯ МОЖНО УСПЕТЬ СДЕЛАТЬ ОЧЕНЬ МНОГОЕ. ПОЭТОМУ
Dialogue: 0,0:05:19.50,0:05:22.46,Caption,,0,0,0,,НОВАЯ СТАТЬЯ МЕДВЕДЕВА НЕ ПЕРЕВОРАЧИВАЕТ ИГРУ ОДНИМ
Dialogue: 0,0:05:22.46,0:05:25.36,Caption,,0,0,0,,СВОИМ ПОЯВЛЕНИЕМ. ОН СНОВА ГОВОРИТ ГРОМЧЕ И
Dialogue: 0,0:05:25.36,0:05:27.62,Caption,,0,0,0,,ЖЁСТЧЕ БОЛЬШИНСТВА РОССИЙСКИХ ЧИНОВНИКОВ,
Dialogue: 0,0:05:27.78,0:05:30.18,Caption,,0,0,0,,ПЕРЕЧИСЛЯЕТ ПОСЛЕДСТВИЯ, ПОКАЗЫВАЕТ,
Dialogue: 0,0:05:30.34,0:05:32.73,Caption,,0,0,0,,ГДЕ ЯКОБЫ ЗАКАНЧИВАЕТСЯ ТЕРПЕНИЕ.
Dialogue: 0,0:05:32.73,0:05:36.07,Caption,,0,0,0,,ВЫГЛЯДИТ ЭФФЕКТНО, НО ПОДОБНЫХ ВЫСТУПЛЕНИЙ УЖЕ БЫЛО
Dialogue: 0,0:05:36.07,0:05:38.57,Caption,,0,0,0,,ДОСТАТОЧНО, А ЗАПАДНЫЕ РЕШЕНИЯ ПОСЛЕ НИХ НЕ
Dialogue: 0,0:05:38.57,0:05:41.30,Caption,,0,0,0,,СТАНОВИЛИСЬ ЗАМЕТНО РОБЧЕ. МИКРОФОН ДРОГНУЛ,
Dialogue: 0,0:05:41.62,0:05:43.44,Caption,,0,0,0,,А ВОЕННЫЕ ПЛАНЫ ОСТАЛИСЬ ЛЕЖАТЬ НА
Dialogue: 0,0:05:43.44,0:05:46.76,Caption,,0,0,0,,ПРЕЖНЕМ МЕСТЕ. ТЕПЕРЬ К ЭТОЙ ИСТОРИИ ДОБАВЛЯЕТСЯ
Dialogue: 0,0:05:46.76,0:05:49.68,Caption,,0,0,0,,ОРБИТА. ЗАПАДНЫЕ РАЗВЕДЫВАТЕЛЬНЫЕ СТРУКТУРЫ ОБСУЖДАЮТ
Dialogue: 0,0:05:49.68,0:05:52.97,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ТОГО, ЧТО РОССИЯ ДО КОНЦА ГОДА ЗАПУСТИТ
Dialogue: 0,0:05:52.97,0:05:56.47,Caption,,0,0,0,,АППАРАТ, НАЗЫВАЕМЫЙ ИМИ СПУТНИКОМ С. ПО ИХ
Dialogue: 0,0:05:56.47,0:05:59.47,Caption,,0,0,0,,ВЕРСИИ, ОН СПОСОБЕН НЕСТИ ЯДЕРНЫЙ ЗАРЯД.
Dialogue: 0,0:05:59.47,0:06:02.30,Caption,,0,0,0,,УТВЕРЖДАЕТСЯ, ЧТО НЕСКОЛЬКО ЛЕТ ЭТОТ АППАРАТ
Dialogue: 0,0:06:02.30,0:06:05.62,Caption,,0,0,0,,НАХОДИЛСЯ В ГОТОВОМ СОСТОЯНИИ В МОСКОВСКОМ РЕГИОНЕ. В
Dialogue: 0,0:06:05.62,0:06:08.58,Caption,,0,0,0,,НАЧАЛЕ НОЯБРЯ СОЮЗНИКИ ПОЛУЧИЛИ ПРЕДУПРЕЖДЕНИЕ О
Dialogue: 0,0:06:08.58,0:06:11.14,Caption,,0,0,0,,ВОЗМОЖНОМ ЗАПУСКЕ В ТЕЧЕНИЕ ШЕСТИДЕСЯТИ ДНЕЙ.
Dialogue: 0,0:06:13.33,0:06:15.17,Caption,,0,0,0,,НЕМЕЦКОЕ КОСМИЧЕСКОЕ КОМАНДОВАНИЕ
Dialogue: 0,0:06:15.17,0:06:17.49,Caption,,0,0,0,,ДОПУСКАЕТ, ЧТО ЭТО ПРОИЗОЙДЁТ В ДЕКАБРЕ.
Dialogue: 0,0:06:18.06,0:06:20.53,Caption,,0,0,0,,ТЕМА ВОЗНИКЛА НЕ ВНЕЗАПНО. ВНУТРЕННИЕ
Dialogue: 0,0:06:20.53,0:06:23.06,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПРЕДУПРЕЖДЕНИЯ О ПОДОБНОЙ СИСТЕМЕ
Dialogue: 0,0:06:23.06,0:06:25.66,Caption,,0,0,0,,РАСПРОСТРАНЯЛИСЬ ЕЩЁ С ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:06:25.66,0:06:29.43,Caption,,0,0,0,,ТРЕТЬЕГО ГОДА. ПОЗДНЕЕ ВОЕННАЯ РАЗВЕДКА СОЕДИНЁННЫХ
Dialogue: 0,0:06:29.43,0:06:31.89,Caption,,0,0,0,,ШТАТОВ СООБЩАЛА О РОССИЙСКОЙ РАЗРАБОТКЕ,
Dialogue: 0,0:06:32.13,0:06:34.60,Caption,,0,0,0,,СПОСОБНОЙ ДОСТАВИТЬ ЯДЕРНОЕ ОРУЖИЕ В
Dialogue: 0,0:06:34.60,0:06:37.56,Caption,,0,0,0,,КОСМОС. И ТУТ ВОЗМУЩЕНИЕ ЗАПАДНЫХ СТРАН ВЫГЛЯДИТ
Dialogue: 0,0:06:37.56,0:06:41.11,Caption,,0,0,0,,ОСОБЕННО ИЗЯЩНО. СОЕДИНЁННЫЕ ШТАТЫ САМИ ОФИЦИАЛЬНО
Dialogue: 0,0:06:41.11,0:06:43.75,Caption,,0,0,0,,ПРИЗНАЛИСЬ, ЧТО ЗАВЕЛИ НА ОРБИТЕ ВОЕННУЮ
Dialogue: 0,0:06:43.75,0:06:46.93,Caption,,0,0,0,,ГРУППИРОВКУ, САМИ ПЕРВЫМИ ПРИНЕСЛИ ТУДА МЕЧ,
Dialogue: 0,0:06:47.09,0:06:51.09,Caption,,0,0,0,,ВСТРОИВ СПУТНИКИ В РАЗВЕДКУ, НАВЕДЕНИЕ И УПРАВЛЕНИЕ ВОЙСКАМИ,
Dialogue: 0,0:06:51.40,0:06:55.03,Caption,,0,0,0,,А ТЕПЕРЬ УДИВЛЯЮТСЯ, ЧТО ОППОНЕНТ ТАЩИТ В ОТВЕТ ЩИТ. ИМ
Dialogue: 0,0:06:55.03,0:06:57.17,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО НЕ ХВАТИЛО СУШИ,
Dialogue: 0,0:06:57.32,0:07:01.12,Caption,,0,0,0,,МОРЕЙ, НЕБА, ГЛУБИНЫ ОКЕАНА И ЦИФРОВЫХ СЕТЕЙ.
Dialogue: 0,0:07:01.12,0:07:03.57,Caption,,0,0,0,,ПОНАДОБИЛОСЬ ЕЩЁ ПОДНЯТЬ СПОР ПОВЫШЕ,
Dialogue: 0,0:07:03.80,0:07:08.17,Caption,,0,0,0,,ЧТОБЫ СНИЗУ БЫЛО ХУЖЕ ВИДНО, КТО НАЧАЛ. ПОСЛЕ ЭТОГО КАЖДЫЙ УЧАСТНИК
Dialogue: 0,0:07:08.17,0:07:11.00,Caption,,0,0,0,,ПРИНИМАЕТ НЕВИННЫЙ ВИД. СОБСТВЕННЫЕ СИСТЕМЫ
Dialogue: 0,0:07:11.00,0:07:13.62,Caption,,0,0,0,,СЛУЖАТ ИСКЛЮЧИТЕЛЬНО БЕЗОПАСНОСТИ. ЧУЖОЙ
Dialogue: 0,0:07:13.62,0:07:17.06,Caption,,0,0,0,,ОТВЕТ НЕМЕДЛЕННО ОБЪЯВЛЯЕТСЯ ОПАСНОЙ ЭСКАЛАЦИЕЙ. ВСЁ
Dialogue: 0,0:07:17.06,0:07:19.25,Caption,,0,0,0,,УДОБНО МОЯ ДУБИНКА ОХРАНЯЕТ ПОРЯДОК,
Dialogue: 0,0:07:19.49,0:07:23.01,Caption,,0,0,0,,ВАША КАСКА ПОЧЕМУ ТО УГРОЖАЕТ ЧЕЛОВЕЧЕСТВУ. ЕСЛИ ВАМ
Dialogue: 0,0:07:23.01,0:07:25.73,Caption,,0,0,0,,БЛИЗОК ТАКОЙ ФОРМАТ, ПОДДЕРЖИТЕ КАНАЛ ПОДПИСКОЙ.
Dialogue: 0,0:07:28.02,0:07:30.22,Caption,,0,0,0,,ДАЛЬШЕ РЕЧЬ ИДЁТ УЖЕ НЕ О СОРЕВНОВАНИИ
Dialogue: 0,0:07:30.22,0:07:33.91,Caption,,0,0,0,,ФОРМУЛИРОВОК, А О ЦЕНЕ, КОТОРУЮ ЗАПЛАТЯТ ДАЛЕКО НЕ ТОЛЬКО
Dialogue: 0,0:07:33.91,0:07:36.80,Caption,,0,0,0,,ВОЕННЫЕ. ПО ОЦЕНКЕ АМЕРИКАНСКОГО КОСМИЧЕСКОГО
Dialogue: 0,0:07:36.80,0:07:39.85,Caption,,0,0,0,,КОМАНДОВАНИЯ, ЯДЕРНЫЙ ВЗРЫВ НА НИЗКОЙ ОКОЛОЗЕМНОЙ
Dialogue: 0,0:07:39.85,0:07:43.46,Caption,,0,0,0,,ОРБИТЕ СПОСОБЕН В ПЕРВЫЕ ЧАСЫ ИЛИ ДНИ ВЫВЕСТИ ИЗ СТРОЯ
Dialogue: 0,0:07:43.46,0:07:45.63,Caption,,0,0,0,,ПРИМЕРНО ТРЕТЬ НАХОДЯЩИХСЯ ТАМ
Dialogue: 0,0:07:45.63,0:07:48.42,Caption,,0,0,0,,СПУТНИКОВ. В ПОСЛЕДУЮЩИЕ МЕСЯЦЫ МОГУТ ОТКАЗАТЬ И
Dialogue: 0,0:07:48.42,0:07:51.64,Caption,,0,0,0,,ДРУГИЕ АППАРАТЫ. ЭЛЕКТРОМАГНИТНЫЙ ИМПУЛЬС ГРОЗИТ
Dialogue: 0,0:07:51.64,0:07:54.54,Caption,,0,0,0,,МАСШТАБНЫМИ НАРУШЕНИЯМИ НА ЗЕМЛЕ. ЭТО НЕ ОДИН
Dialogue: 0,0:07:54.54,0:07:57.82,Caption,,0,0,0,,ПОГАСШИЙ ОГОНЁК, КОТОРЫЙ ПОКАЖУТ В ЗАМЕДЛЕННОЙ СЪЁМКЕ И
Dialogue: 0,0:07:57.82,0:08:00.91,Caption,,0,0,0,,ЗАБУДУТ ПОСЛЕ РЕКЛАМЫ. ЕСТЬ И ПРОБЛЕМА ОБЛОМКОВ.
Dialogue: 0,0:08:00.91,0:08:03.54,Caption,,0,0,0,,РАЗРУШЕННЫЙ АППАРАТ РАЗБРАСЫВАЕТ ФРАГМЕНТЫ,
Dialogue: 0,0:08:03.82,0:08:05.94,Caption,,0,0,0,,ОНИ СТАЛКИВАЮТСЯ С ДРУГИМИ ОБЪЕКТАМИ,
Dialogue: 0,0:08:06.18,0:08:08.19,Caption,,0,0,0,,ПОСЛЕ ЧЕГО КОЛИЧЕСТВО ОПАСНЫХ ЧАСТИЦ
Dialogue: 0,0:08:08.19,0:08:10.90,Caption,,0,0,0,,РАСТЁТ ДАЛЬШЕ. ТАК РАЗВИВАЕТСЯ ЭФФЕКТ КЕССЛЕРА,
Dialogue: 0,0:08:11.21,0:08:13.30,Caption,,0,0,0,,ПРИ КОТОРОМ ОРБИТА ПОСТЕПЕННО СТАНОВИТСЯ
Dialogue: 0,0:08:13.30,0:08:15.86,Caption,,0,0,0,,НЕПРОХОДИМОЙ СВАЛКОЙ. ПРИЧЁМ МУСОР ТАМ
Dialogue: 0,0:08:15.86,0:08:17.70,Caption,,0,0,0,,НЕ ЛЕЖИТ ТИХО ВОЗЛЕ КОНТЕЙНЕРА,
Dialogue: 0,0:08:17.93,0:08:21.54,Caption,,0,0,0,,А ЛЕТИТ С ТАКОЙ СКОРОСТЬЮ, ЧТО ДАЖЕ МАЛЕНЬКИЙ КУСОК ПРЕВРАЩАЕТСЯ
Dialogue: 0,0:08:21.54,0:08:24.79,Caption,,0,0,0,,В СНАРЯД. ГЕРМАНИЯ УЖЕ ОБСУЖДАЕТ СПОСОБЫ ЗАЩИТЫ
Dialogue: 0,0:08:24.79,0:08:28.19,Caption,,0,0,0,,СОБСТВЕННЫХ СПУТНИКОВ, А ТАКЖЕ СРЕДСТВА НЕЙТРАЛИЗАЦИИ И
Dialogue: 0,0:08:28.19,0:08:31.80,Caption,,0,0,0,,УНИЧТОЖЕНИЯ ЧУЖИХ АППАРАТОВ. ЦЕПОЧКА ПОЛУЧАЕТСЯ ПОЧТИ
Dialogue: 0,0:08:31.80,0:08:35.13,Caption,,0,0,0,,ОБРАЗЦОВАЯ. ОДНА СТОРОНА НАРАЩИВАЕТ ВОЕННЫЕ ВОЗМОЖНОСТИ
Dialogue: 0,0:08:35.13,0:08:38.90,Caption,,0,0,0,,В КОСМОСЕ. ВТОРАЯ ГОТОВИТ ОТВЕТ. ПЕРВАЯ ВИДИТ
Dialogue: 0,0:08:38.90,0:08:41.86,Caption,,0,0,0,,ОТВЕТ И ТРЕБУЕТ НОВОЕ ОРУЖИЕ ПРОТИВ НЕГО.
Dialogue: 0,0:08:44.14,0:08:46.27,Caption,,0,0,0,,ЗАТЕМ ВТОРАЯ ОБЪЯСНЯЕТ СЛЕДУЮЩУЮ
Dialogue: 0,0:08:46.27,0:08:48.80,Caption,,0,0,0,,РАЗРАБОТКУ ПРЕДЫДУЩЕЙ РАЗРАБОТКОЙ ПЕРВОЙ.
Dialogue: 0,0:08:48.80,0:08:52.22,Caption,,0,0,0,,НЕСКОЛЬКО ОБОРОТОВ, И ПРОИСХОЖДЕНИЕ КОНФЛИКТА УЖЕ НИКОГО
Dialogue: 0,0:08:52.22,0:08:55.64,Caption,,0,0,0,,НЕ ИНТЕРЕСУЕТ. ЗАТО У КАЖДОГО НА ОРБИТЕ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:08:55.64,0:08:58.86,Caption,,0,0,0,,СВОЙ ШКАФ С ИНСТРУМЕНТАМИ, КОТОРЫМИ ЛУЧШЕ НИКОГДА НЕ
Dialogue: 0,0:08:58.86,0:09:02.27,Caption,,0,0,0,,ПОЛЬЗОВАТЬСЯ. РАЗУМЕЕТСЯ, ВЕСЬ ЭТОТ ШКАФ ОПЛАЧИВАЕТСЯ НЕ
Dialogue: 0,0:09:02.27,0:09:05.02,Caption,,0,0,0,,КОСМИЧЕСКОЙ ПЫЛЬЮ. ФРИДРИХ МЕРЦ ЗАЯВЛЯЕТ,
Dialogue: 0,0:09:05.28,0:09:07.54,Caption,,0,0,0,,ЧТО СВЕЖИЕ РАЗВЕДЫВАТЕЛЬНЫЕ СВЕДЕНИЯ
Dialogue: 0,0:09:07.54,0:09:10.26,Caption,,0,0,0,,УКАЗЫВАЮТ НА ГОТОВНОСТЬ РОССИИ К ДАЛЬНЕЙШЕМУ
Dialogue: 0,0:09:10.26,0:09:13.74,Caption,,0,0,0,,ПОВЫШЕНИЮ СТАВОК. ПРАВИТЕЛЬСТВО ГЕРМАНИИ СООБЩАЕТ,
Dialogue: 0,0:09:13.85,0:09:15.83,Caption,,0,0,0,,ЧТО ВОСПРИНИМАЕТ ДАННЫЕ О РОССИЙСКОМ
Dialogue: 0,0:09:15.83,0:09:17.82,Caption,,0,0,0,,ЯДЕРНОМ СПУТНИКЕ ПРЕДЕЛЬНО СЕРЬЁЗНО.
Dialogue: 0,0:09:18.38,0:09:20.06,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ПОЯВИЛИСЬ СВЕДЕНИЯ,
Dialogue: 0,0:09:20.26,0:09:22.87,Caption,,0,0,0,,БУДТО АППАРАТ УЖЕ ЗАБРАЛИ ИЗ ХРАНИЛИЩА
Dialogue: 0,0:09:22.87,0:09:25.12,Caption,,0,0,0,,И НАЧАЛИ ГОТОВИТЬ К СТАРТУ. НЕОБХОДИМАЯ
Dialogue: 0,0:09:25.12,0:09:28.49,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ ДЛЯ РАСХОДОВ УЖЕ СОБРАНА. УГРОЗА
Dialogue: 0,0:09:28.49,0:09:31.83,Caption,,0,0,0,,ПОЛУЧИЛА ИМЯ. СРОЧНОСТЬ ОБОЗНАЧЕНА. НАСЕЛЕНИЮ
Dialogue: 0,0:09:31.83,0:09:34.83,Caption,,0,0,0,,ОБЪЯСНИЛИ, ПОЧЕМУ ПРЕЖНЕЙ ЗАЩИТЫ НЕДОСТАТОЧНО.
Dialogue: 0,0:09:34.83,0:09:38.32,Caption,,0,0,0,,ОСТАЛОСЬ ОТКРЫТЬ БЮДЖЕТ, А ОН В ТАКИХ СЛУЧАЯХ ОТКРЫВАЕТСЯ
Dialogue: 0,0:09:38.32,0:09:40.97,Caption,,0,0,0,,ЗАМЕТНО ЛЕГЧЕ, ЧЕМ КОШЕЛЁК ЧЕЛОВЕКА ПЕРЕД ОПЛАТОЙ
Dialogue: 0,0:09:40.97,0:09:44.02,Caption,,0,0,0,,КОММУНАЛЬНЫХ СЧЕТОВ. ДАЛЬШЕ МЕХАНИЗМ БУДЕТ КОРМИТЬ
Dialogue: 0,0:09:44.02,0:09:47.04,Caption,,0,0,0,,САМ СЕБЯ. ЗАПАД ПОТРЕБУЕТ ДЕНЬГИ НА НОВЫЕ
Dialogue: 0,0:09:47.04,0:09:50.14,Caption,,0,0,0,,СИСТЕМЫ ИЗ ЗА РОССИЙСКОГО АППАРАТА. МОСКВА ОТВЕТИТ,
Dialogue: 0,0:09:50.38,0:09:52.88,Caption,,0,0,0,,ЧТО АППАРАТ ПОНАДОБИЛСЯ ИЗ ЗА ЗАПАДНОЙ
Dialogue: 0,0:09:52.88,0:09:58.47,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЫ. НА СЛЕДУЮЩИЙ КРУГ ОБЕ СТОРОНЫ ПРИДУТ С
Dialogue: 0,0:09:58.47,0:10:00.53,Caption,,0,0,0,,БОЛЕЕ ДОРОГИМИ ПРОЕКТАМИ И ТЕМИ ЖЕ
Dialogue: 0,0:10:00.53,0:10:03.78,Caption,,0,0,0,,УДИВЛЁННЫМИ ЛИЦАМИ. ПРИ ЭТОМ ДЕЙСТВУЕТ ДОГОВОР О КОСМОСЕ
Dialogue: 0,0:10:03.78,0:10:07.04,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ШЕСТЬДЕСЯТ СЕДЬМОГО ГОДА. ОН ЗАПРЕЩАЕТ
Dialogue: 0,0:10:07.04,0:10:09.73,Caption,,0,0,0,,РАЗМЕЩЕНИЕ НА ОРБИТЕ ЯДЕРНОГО ОРУЖИЯ И ДРУГИХ
Dialogue: 0,0:10:09.73,0:10:12.98,Caption,,0,0,0,,РАЗНОВИДНОСТЕЙ ОРУЖИЯ МАССОВОГО УНИЧТОЖЕНИЯ. В ДВЕ
Dialogue: 0,0:10:12.98,0:10:16.08,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ ГОДУ РОССИЯ ЗАБЛОКИРОВАЛА
Dialogue: 0,0:10:16.08,0:10:18.34,Caption,,0,0,0,,РЕЗОЛЮЦИЮ СОВЕТА БЕЗОПАСНОСТИ ООН,
Dialogue: 0,0:10:18.50,0:10:20.52,Caption,,0,0,0,,ПОДТВЕРЖДАВШУЮ ЭТОТ ЗАПРЕТ. ЗА
Dialogue: 0,0:10:20.52,0:10:22.98,Caption,,0,0,0,,ДОКУМЕНТ ПРОГОЛОСОВАЛИ ТРИНАДЦАТЬ ГОСУДАРСТВ,
Dialogue: 0,0:10:23.12,0:10:25.32,Caption,,0,0,0,,КИТАЙ ВОЗДЕРЖАЛСЯ. МОСКВА ОТВЕРГАЕТ
Dialogue: 0,0:10:25.32,0:10:27.82,Caption,,0,0,0,,ОБВИНЕНИЯ В ПОДГОТОВКЕ ЯДЕРНОГО ЗАПУСКА И
Dialogue: 0,0:10:27.82,0:10:30.99,Caption,,0,0,0,,НАСТАИВАЕТ НА МИРНОМ ХАРАКТЕРЕ СВОЕЙ ДЕЯТЕЛЬНОСТИ В
Dialogue: 0,0:10:30.99,0:10:34.46,Caption,,0,0,0,,КОСМОСЕ. ГЛАВНЫЙ ИТОГ ВИДЕН НЕВООРУЖЁННЫМ ГЛАЗОМ. ВСЕ УЖЕ
Dialogue: 0,0:10:34.46,0:10:37.70,Caption,,0,0,0,,ВЕДУТ СЕБЯ ТАК, БУДТО СЛЕДУЮЩИЙ РАУНД НЕИЗБЕЖЕН. А
Dialogue: 0,0:10:37.70,0:10:40.74,Caption,,0,0,0,,ПОКА НАД ЗЕМЛЁЙ ГОТОВЯТ ОЧЕРЕДНОЙ ЭТАЖ ПРОТИВОСТОЯНИЯ,
Dialogue: 0,0:10:40.99,0:10:43.14,Caption,,0,0,0,,НА САМОЙ ЗЕМЛЕ СНОВА ОБСУЖДАЮТ МОСТЫ
Dialogue: 0,0:10:43.14,0:10:46.34,Caption,,0,0,0,,ЧЕРЕЗ ДНЕПР. ПОСЛЕ ПРЕДПОЛАГАЕМОГО ОБРУШЕНИЯ АРКИ
Dialogue: 0,0:10:46.34,0:10:48.50,Caption,,0,0,0,,КРЫМСКОГО МОСТА ПОЯВИЛИСЬ СООБЩЕНИЯ,
Dialogue: 0,0:10:48.62,0:10:51.62,Caption,,0,0,0,,БУДТО ВЛАДИМИР ПУТИН ПОРУЧИЛ ПОДГОТОВИТЬ КОНКРЕТНЫЙ
Dialogue: 0,0:10:51.62,0:10:54.10,Caption,,0,0,0,,ПЛАН УДАРОВ ПО УКРАИНСКИМ ПЕРЕПРАВАМ.
Dialogue: 0,0:10:54.10,0:10:56.58,Caption,,0,0,0,,В ЭТИХ РАССКАЗАХ УЖЕ НАЗНАЧЕНЫ ОТВЕТСТВЕННЫЕ,
Dialogue: 0,0:10:56.82,0:10:59.37,Caption,,0,0,0,,ПРЕДСТАВЛЕНЫ ПРЕДЛОЖЕНИЯ И РАСПИСАНЫ
Dialogue: 0,0:10:59.37,0:11:02.08,Caption,,0,0,0,,СРОКИ. В ТЕЧЕНИЕ ТРЁХ МЕСЯЦЕВ ЯКОБЫ СОБИРАЮТСЯ
Dialogue: 0,0:11:02.08,0:11:05.26,Caption,,0,0,0,,ВЫВЕСТИ ИЗ СТРОЯ НЕ МЕНЕЕ ДВУХ МОСТОВ. ПЕРВЫМИ
Dialogue: 0,0:11:05.26,0:11:09.90,Caption,,0,0,0,,НАЗЫВАЮТ ЗАПОРОЖСКИЕ. КИЕВСКИЕ ПЕРЕПРАВЫ,
Dialogue: 0,0:11:10.05,0:11:13.70,Caption,,0,0,0,,СОГЛАСНО ТОМУ ЖЕ СЛУХУ, НАМЕРЕНЫ ПОРАЖАТЬ ДО ОСЕНИ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:11:13.70,0:11:16.40,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОГО ГОДА. НОВОСТЬ ЗВУЧИТ ЗНАКОМО
Dialogue: 0,0:11:16.40,0:11:18.62,Caption,,0,0,0,,ДО СКРИПА. СКОЛЬКО РАЗ УЖЕ ОБЪЯВЛЯЛОСЬ,
Dialogue: 0,0:11:18.79,0:11:22.86,Caption,,0,0,0,,ЧТО РЕШЕНИЕ НАКОНЕЦ ПРИНЯТО? ЧТО ТЕПЕРЬ ТОЧНО ЗАЙМУТСЯ МОСТАМИ?
Dialogue: 0,0:11:23.02,0:11:24.94,Caption,,0,0,0,,ЧТО ЛОГИСТИКУ ВОТ ВОТ ПЕРЕРЕЖУТ?
Dialogue: 0,0:11:25.17,0:11:28.62,Caption,,0,0,0,,ЧТО ПРИКАЗ УЖЕ ПОДПИСАН, ПАПКА ЗАКРЫТА И ЧАСЫ ПОШЛИ?
Dialogue: 0,0:11:28.98,0:11:30.84,Caption,,0,0,0,,КАЖДЫЙ РАЗ НАХОДИТСЯ ОСВЕДОМЛЁННЫЙ
Dialogue: 0,0:11:30.84,0:11:33.47,Caption,,0,0,0,,ИСТОЧНИК, КОТОРЫЙ ЗНАЕТ СОДЕРЖАНИЕ РАЗГОВОРА ЗА
Dialogue: 0,0:11:33.47,0:11:35.98,Caption,,0,0,0,,ЗАКРЫТОЙ ДВЕРЬЮ, ФАМИЛИИ ИСПОЛНИТЕЛЕЙ,
Dialogue: 0,0:11:36.14,0:11:38.47,Caption,,0,0,0,,ГРАФИК УДАРОВ И ПЛАНЫ ПРЕЗИДЕНТА НА
Dialogue: 0,0:11:38.47,0:11:41.91,Caption,,0,0,0,,МНОГО МЕСЯЦЕВ ВПЕРЁД. ОЧЕНЬ ПОЛЕЗНЫЙ ЧЕЛОВЕК. СУДЯ
Dialogue: 0,0:11:41.91,0:11:44.74,Caption,,0,0,0,,ПО ОБЪЁМУ ЗНАНИЙ, ОН НЕ ПРОСТО ПРИСУТСТВУЕТ НА
Dialogue: 0,0:11:44.74,0:11:47.87,Caption,,0,0,0,,СОВЕЩАНИЯХ, А ЛИЧНО ДЕРЖИТ ПРЕЗИДЕНТУ НАСТОЛЬНУЮ
Dialogue: 0,0:11:47.87,0:11:52.04,Caption,,0,0,0,,ЛАМПУ. ПОКА НЕТ ДЕЙСТВИЙ, ЭТА ИСТОРИЯ ОСТАЁТСЯ СЛУХОМ. ИСТОЧНИКИ
Dialogue: 0,0:11:52.04,0:11:54.56,Caption,,0,0,0,,ПОДОБНОГО РОДА ЧАСТО ПРЕВРАЩАЮТ СОБСТВЕННОЕ
Dialogue: 0,0:11:54.56,0:11:57.47,Caption,,0,0,0,,ЖЕЛАНИЕ В СООБЩЕНИЕ О ПРИНЯТОМ РЕШЕНИИ. ОДИН
Dialogue: 0,0:11:57.47,0:12:00.98,Caption,,0,0,0,,ЧЕЛОВЕК ОЧЕНЬ ХОЧЕТ УВИДЕТЬ УДАР. ВТОРОЙ ХОЧЕТ ТОГО
Dialogue: 0,0:12:00.98,0:12:03.78,Caption,,0,0,0,,ЖЕ И ССЫЛАЕТСЯ НА ПЕРВОГО. ТРЕТИЙ ДОБАВЛЯЕТ
Dialogue: 0,0:12:03.78,0:12:07.03,Caption,,0,0,0,,УВЕРЕННЫЙ ТОН. ПОСЛЕ НЕСКОЛЬКИХ ПЕРЕСКАЗОВ ОЖИДАНИЕ
Dialogue: 0,0:12:07.03,0:12:09.51,Caption,,0,0,0,,УЖЕ ХОДИТ ПО КАНАЛАМ В ГЕНЕРАЛЬСКОЙ ФОРМЕ И
Dialogue: 0,0:12:09.51,0:12:12.15,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТСЯ ПРИКАЗОМ. ЗАТЕМ НАЧИНАЕТСЯ
Dialogue: 0,0:12:12.15,0:12:14.30,Caption,,0,0,0,,КОЛЛЕКТИВНОЕ ОЖИДАНИЕ СОБЫТИЯ,
Dialogue: 0,0:12:14.54,0:12:17.62,Caption,,0,0,0,,КОТОРОЕ НИКТО, КРОМЕ ПЕРЕСКАЗЫВАЮЩИХ ДРУГ ДРУГА
Dialogue: 0,0:12:17.62,0:12:20.38,Caption,,0,0,0,,СОБЕСЕДНИКОВ, НЕ ОБЕЩАЛ. ПОДПИШИСЬ,
Dialogue: 0,0:12:20.59,0:12:22.38,Caption,,0,0,0,,ЕСЛИ ХОЧЕШЬ ВИДЕТЬ РАЗБОР ЦЕЛИКОМ,
Dialogue: 0,0:12:22.54,0:12:24.06,Caption,,0,0,0,,А НЕ В ПЕРЕСКАЗЕ ПРЕСС СЛУЖБЫ.
Dialogue: 0,0:12:26.33,0:12:28.62,Caption,,0,0,0,,НО МОСТЫ ЗДЕСЬ ЛИШЬ ЕЩЁ ОДИН ПРИМЕР
Dialogue: 0,0:12:28.62,0:12:31.14,Caption,,0,0,0,,ТОЙ ЖЕ ГЛАВНОЙ ПРОБЛЕМЫ. КАК И СТАТЬЯ
Dialogue: 0,0:12:31.14,0:12:34.37,Caption,,0,0,0,,МЕДВЕДЕВА. КАК И ПОЛОЖЕНИЯ ЯДЕРНОЙ ДОКТРИНЫ. КАК И
Dialogue: 0,0:12:34.37,0:12:38.33,Caption,,0,0,0,,СООБЩЕНИЯ О СПУТНИКЕ. УГРОЗА РАБОТАЕТ НЕ ТОГДА,
Dialogue: 0,0:12:38.49,0:12:40.17,Caption,,0,0,0,,КОГДА ЕЁ КРАСИВО СФОРМУЛИРОВАЛИ,
Dialogue: 0,0:12:40.57,0:12:43.21,Caption,,0,0,0,,А КОГДА ПРОТИВНИК УВЕРЕН В ПОСЛЕДСТВИЯХ СВОЕГО
Dialogue: 0,0:12:43.29,0:12:46.81,Caption,,0,0,0,,СЛЕДУЮЩЕГО ШАГА. МОЖНО ПОСТАВИТЬ В КОМНАТЕ ОГРОМНЫЙ
Dialogue: 0,0:12:46.81,0:12:48.89,Caption,,0,0,0,,СЕЙФ С ОРУЖИЕМ И КАЖДЫЙ ДЕНЬ НАПОМИНАТЬ,
Dialogue: 0,0:12:49.07,0:12:51.15,Caption,,0,0,0,,ЧТО КЛЮЧ ЛЕЖИТ В КАРМАНЕ. НО ЕСЛИ
Dialogue: 0,0:12:51.15,0:12:54.74,Caption,,0,0,0,,ОКРУЖАЮЩИЕ УБЕЖДЕНЫ, ЧТО СЕЙФ ОТКРОЮТ ЛИШЬ ПОСЛЕ ПОЛНОГО
Dialogue: 0,0:12:54.74,0:12:57.61,Caption,,0,0,0,,РАЗГРОМА КОМНАТЫ, ОНИ СНАЧАЛА ВЫНЕСУТ СТОЛ,
Dialogue: 0,0:12:57.74,0:13:00.89,Caption,,0,0,0,,КРЕСЛА И ТЕЛЕВИЗОР. ПОТОМ ЕЩЁ ПОИНТЕРЕСУЮТСЯ,
Dialogue: 0,0:13:01.13,0:13:03.70,Caption,,0,0,0,,НЕ МЕШАЕТ ЛИ ХОЗЯИНУ ПУСТАЯ ТУМБОЧКА.
Dialogue: 0,0:13:03.70,0:13:08.65,Caption,,0,0,0,,РАСЧЁТ У НИХ, ПОХОЖЕ, ОДИН. МОСКВА ДО ПОСЛЕДНЕГО БУДЕТ ИСКАТЬ
Dialogue: 0,0:13:08.65,0:13:11.80,Caption,,0,0,0,,ЗАМЕНУ ОКОНЧАТЕЛЬНОМУ ШАГУ. ПРЕДЛОЖИТ ИНОЙ
Dialogue: 0,0:13:11.80,0:13:15.40,Caption,,0,0,0,,ОТВЕТ. ПЕРЕДАСТ НОВЫЙ СИГНАЛ. ОБОЗНАЧИТ ОЧЕРЕДНОЙ
Dialogue: 0,0:13:15.40,0:13:18.73,Caption,,0,0,0,,ПРЕДЕЛ. ВЫПУСТИТ ЕЩЁ ОДНО ПРЕДУПРЕЖДЕНИЕ. ЯДЕРНОЕ
Dialogue: 0,0:13:18.73,0:13:21.45,Caption,,0,0,0,,ОРУЖИЕ ОСТАНЕТСЯ В САМОМ ДАЛЬНЕМ ЯЩИКЕ,
Dialogue: 0,0:13:21.63,0:13:23.63,Caption,,0,0,0,,ДОРОГА К КОТОРОМУ ПРОХОДИТ ЧЕРЕЗ
Dialogue: 0,0:13:23.63,0:13:27.27,Caption,,0,0,0,,ТЯЖЕЛЕЙШИЙ КРИЗИС И ПОЧТИ БЕЗВЫХОДНОЕ ПОЛОЖЕНИЕ. ЕСЛИ
Dialogue: 0,0:13:27.27,0:13:29.92,Caption,,0,0,0,,ИМЕННО ЭТО УБЕЖДЕНИЕ ЛЕГЛО В ОСНОВУ ЗАПАДНОЙ
Dialogue: 0,0:13:29.92,0:13:32.76,Caption,,0,0,0,,СТРАТЕГИИ, ТО КОЛИЧЕСТВО РОССИЙСКИХ БОЕГОЛОВОК
Dialogue: 0,0:13:32.76,0:13:35.90,Caption,,0,0,0,,УЖЕ НЕ РЕШАЕТ ГЛАВНУЮ ЗАДАЧУ. СТРАШНЫХ СРЕДСТВ У
Dialogue: 0,0:13:35.90,0:13:38.87,Caption,,0,0,0,,РОССИИ БОЛЕЕ ЧЕМ ДОСТАТОЧНО. НЕ ХВАТАЕТ ДРУГОГО
Dialogue: 0,0:13:38.87,0:13:42.85,Caption,,0,0,0,,УВЕРЕННОСТИ ПРОТИВНИКА, ЧТО ЭТИ СРЕДСТВА ВЛИЯЮТ НА ЕГО ВЫБОР
Dialogue: 0,0:13:42.85,0:13:44.81,Caption,,0,0,0,,РАНЬШЕ, ЧЕМ НАСТУПИТ КАТАСТРОФА.
Dialogue: 0,0:13:47.10,0:13:49.14,Caption,,0,0,0,,ОРУЖИЕ СДЕРЖИВАНИЯ НАЧИНАЕТ ТЕРЯТЬ
Dialogue: 0,0:13:49.14,0:13:52.92,Caption,,0,0,0,,СМЫСЛ НЕ В МОМЕНТ, КОГДА ОНО ОКАЗАЛОСЬ НЕИСПРАВНЫМ. ОНО
Dialogue: 0,0:13:52.92,0:13:56.78,Caption,,0,0,0,,ТЕРЯЕТ ЕГО ТОГДА, КОГДА ДРУГАЯ СТОРОНА ЗАРАНЕЕ РЕШИЛА,
Dialogue: 0,0:13:57.02,0:13:58.92,Caption,,0,0,0,,ЧТО ВЫ ВСЁ РАВНО НЕ ВОСПОЛЬЗУЕТЕСЬ ИМ
Dialogue: 0,0:13:58.92,0:14:02.81,Caption,,0,0,0,,ДО ПОСЛЕДНЕЙ СЕКУНДЫ. И НА ФОНЕ ЭТОГО РЕШЕНИЯ ДАЖЕ САМАЯ
Dialogue: 0,0:14:02.81,0:14:04.80,Caption,,0,0,0,,ГРОЗНАЯ СТАТЬЯ РИСКУЕТ ОСТАТЬСЯ НЕ
Dialogue: 0,0:14:04.80,0:14:07.90,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЕМ, А ЕЩЁ ОДНОЙ ТАБЛИЧКОЙ НА ЗАБОРЕ,
Dialogue: 0,0:14:08.07,0:14:09.74,Caption,,0,0,0,,ЧЕРЕЗ КОТОРЫЙ УЖЕ ПЕРЕЛЕЗЛИ.
