Dialogue: 0,0:00:00.11,0:00:03.32,Caption,,0,0,0,,ПРЕДСТАВЬТЕ ЧЕЛОВЕКА, КОТОРЫЙ САМ ПОДЖИГАЕТ ЗАНАВЕСКИ,
Dialogue: 0,0:00:03.56,0:00:06.52,Caption,,0,0,0,,А ПОТОМ ПЕРВЫМ ЗВОНИТ ПОЖАРНЫМ И ТРЕБУЕТ АРЕСТОВАТЬ
Dialogue: 0,0:00:06.60,0:00:09.56,Caption,,0,0,0,,СОСЕДА. РАСЧЁТ ПОНЯТЕН КТО РАНЬШЕ ПОЖАЛОВАЛСЯ,
Dialogue: 0,0:00:09.88,0:00:12.52,Caption,,0,0,0,,ТОТ ВРОДЕ БЫ И ПОСТРАДАВШИЙ. ПРИМЕРНО ТАКУЮ
Dialogue: 0,0:00:12.52,0:00:14.84,Caption,,0,0,0,,КОМБИНАЦИЮ СЕЙЧАС ПЫТАЮТСЯ РАЗЫГРАТЬ ВОКРУГ
Dialogue: 0,0:00:14.84,0:00:17.80,Caption,,0,0,0,,КРЫМСКОГО МОСТА. ТОЛЬКО МОСКВА ТОЖЕ МОЖЕТ ПОЗВОНИТЬ
Dialogue: 0,0:00:17.88,0:00:22.04,Caption,,0,0,0,,ТРАМПУ И РАССКАЗАТЬ, КТО ПЕРВЫМ ПОЛЕЗ ЗА СПИЧКАМИ. ЕСЛИ ВАМ НРАВЯТСЯ
Dialogue: 0,0:00:22.04,0:00:25.64,Caption,,0,0,0,,РАЗБОРЫ, В КОТОРЫХ СОБЫТИЯ НЕ РАССЫПАЮТ ПО РАЗНЫМ КОРОБКАМ,
Dialogue: 0,0:00:25.78,0:00:29.40,Caption,,0,0,0,,ПОДПИШИТЕСЬ. КРЫМСКИЙ МОСТ СНОВА ОКАЗАЛСЯ В ЦЕНТРЕ
Dialogue: 0,0:00:29.40,0:00:32.44,Caption,,0,0,0,,ПРОТИВОСТОЯНИЯ. ЗНАЧЕНИЕ ИМЕЕТ НЕ ЧИСЛО ПОПЫТОК
Dialogue: 0,0:00:32.52,0:00:36.60,Caption,,0,0,0,,УДАРИТЬ ПО НЕМУ, А САМА МИШЕНЬ И ВЫБРАННЫЙ МОМЕНТ. ДЛЯ РОССИИ
Dialogue: 0,0:00:36.60,0:00:41.08,Caption,,0,0,0,,ЭТО ТРАНСПОРТНЫЙ ОБЪЕКТ, ГОСУДАРСТВЕННЫЙ СИМВОЛ И ГРОМКАЯ МЕДИЙНАЯ ЦЕЛЬ.
Dialogue: 0,0:00:41.51,0:00:44.44,Caption,,0,0,0,,ПОСЛЕ АТАКИ МОСКВЕ ТРУДНО НЕ ОТВЕТИТЬ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:00:44.44,0:00:47.72,Caption,,0,0,0,,СЕЙЧАС НЕ ЗАИНТЕРЕСОВАН В ЗАВЕРШЕНИИ КОНФЛИКТА. НО
Dialogue: 0,0:00:47.72,0:00:51.16,Caption,,0,0,0,,ОДНОГО ЖЕЛАНИЯ ЗАТЯНУТЬ ПРОТИВОСТОЯНИЕ МАЛО. ПЕРЕД
Dialogue: 0,0:00:51.16,0:00:53.32,Caption,,0,0,0,,СЕРЬЁЗНЫМИ КОНТАКТАМИ НУЖЕН ЭПИЗОД,
Dialogue: 0,0:00:53.49,0:00:55.80,Caption,,0,0,0,,КОТОРЫЙ ЗАСТАВИТ РОССИЮ ОТВЕТИТЬ ЖЁСТКО,
Dialogue: 0,0:00:56.03,0:00:58.84,Caption,,0,0,0,,ЧТОБЫ ЗАТЕМ ОБВИНИТЬ ЕЁ ПЕРЕД ЗАПАДНЫМИ ПАРТНЁРАМИ.
Dialogue: 0,0:00:59.32,0:01:02.44,Caption,,0,0,0,,КИЕВ НАНОСИТ ДЕМОНСТРАТИВНЫЙ УДАР. МОСКВА РЕАГИРУЕТ.
Dialogue: 0,0:01:02.72,0:01:05.64,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ЗЕЛЕНСКИЙ ЗАЯВЛЯЕТ УКРАИНА ГОВОРИЛА О
Dialogue: 0,0:01:05.64,0:01:07.96,Caption,,0,0,0,,МИРЕ, А РОССИЯ СНОВА АТАКОВАЛА,
Dialogue: 0,0:01:08.18,0:01:11.96,Caption,,0,0,0,,ЗНАЧИТ, ИМЕННО МОСКВА МЕШАЕТ ДОГОВОРЁННОСТЯМ. ГЛАВНЫЙ
Dialogue: 0,0:01:12.04,0:01:14.44,Caption,,0,0,0,,ЗРИТЕЛЬ ЭТОГО ПРЕДСТАВЛЕНИЯ НАХОДИТСЯ В ВАШИНГТОНЕ.
Dialogue: 0,0:01:16.63,0:01:19.51,Caption,,0,0,0,,ОДНАКО У ТЕЛЕФОНА ТРАМПА НЕ ОДНА ВХОДЯЩАЯ ЛИНИЯ.
Dialogue: 0,0:01:19.73,0:01:22.63,Caption,,0,0,0,,ПУТИН СПОСОБЕН ИЗЛОЖИТЬ ЕМУ ВСЮ ИСТОРИЮ С НАЧАЛА.
Dialogue: 0,0:01:22.95,0:01:26.15,Caption,,0,0,0,,РОССИЯ ОБСУЖДАЕТ ПЕРЕГОВОРЫ. КИЕВ ВЫБИРАЕТ ЦЕЛЬ,
Dialogue: 0,0:01:26.39,0:01:29.59,Caption,,0,0,0,,НА АТАКУ ПО КОТОРОЙ НЕВОЗМОЖНО НЕ ОТВЕТИТЬ. МОСКВА
Dialogue: 0,0:01:29.67,0:01:32.55,Caption,,0,0,0,,НАНОСИТ ОТВЕТНЫЙ УДАР. ЗАТЕМ УКРАИНСКАЯ СТОРОНА
Dialogue: 0,0:01:32.55,0:01:35.59,Caption,,0,0,0,,УБИРАЕТ ПЕРВЫЙ ЭПИЗОД И ПОКАЗЫВАЕТ ТОЛЬКО ВТОРОЙ,
Dialogue: 0,0:01:35.73,0:01:38.31,Caption,,0,0,0,,ИЗОБРАЖАЯ СОРВАННЫЙ МИР. АМЕРИКАНСКИЙ ПРЕЗИДЕНТ
Dialogue: 0,0:01:38.31,0:01:41.99,Caption,,0,0,0,,ГОВОРИЛ, ЧТО РОССИЯ ИСПОЛЬЗУЕТ ДАЛЕКО НЕ ВСЕ СВОИ ВОЗМОЖНОСТИ
Dialogue: 0,0:01:42.30,0:01:45.35,Caption,,0,0,0,,И МОГЛА БЫ ДЕЙСТВОВАТЬ ЗНАЧИТЕЛЬНО СУРОВЕЕ. ЗНАЧИТ,
Dialogue: 0,0:01:45.50,0:01:49.03,Caption,,0,0,0,,ОН ПОНИМАЕТ У МОСКВЫ ОСТАЁТСЯ ЗАПАС ВАРИАНТОВ. И
Dialogue: 0,0:01:49.03,0:01:51.27,Caption,,0,0,0,,ИМЕННО ПЕРЕД БОЛЬШИМ РАЗГОВОРОМ КИЕВ РЕШИЛ
Dialogue: 0,0:01:51.35,0:01:55.35,Caption,,0,0,0,,ПРОВЕРИТЬ, ГДЕ ПРОХОДИТ ПРЕДЕЛ. ПОХОЖИЙ МЕХАНИЗМ УЖЕ СРАБАТЫВАЛ
Dialogue: 0,0:01:55.35,0:01:57.59,Caption,,0,0,0,,ПОСЛЕ УДАРА ПО МОСТУ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:01:57.67,0:02:00.07,Caption,,0,0,0,,ВТОРОМ ГОДУ. ВСЛЕД ЗА НИМ РОССИЯ ЗНАЧИТЕЛЬНО
Dialogue: 0,0:02:00.07,0:02:03.11,Caption,,0,0,0,,РАСШИРИЛА АТАКИ НА УКРАИНСКУЮ ЭНЕРГЕТИКУ. В КИЕВЕ
Dialogue: 0,0:02:03.11,0:02:05.75,Caption,,0,0,0,,ЭТОТ ОПЫТ ПОМНЯТ И НЕ МОГУТ ВСЕРЬЁЗ РАССЧИТЫВАТЬ,
Dialogue: 0,0:02:05.98,0:02:08.55,Caption,,0,0,0,,ЧТО МОСКВА НЕ ОТВЕТИТ. ПРЕДСТАВИТЕЛЬ ВОЗДУШНЫХ СИЛ
Dialogue: 0,0:02:08.55,0:02:11.35,Caption,,0,0,0,,УКРАИНЫ ЮРИЙ ИГНАТ СООБЩИЛ О ПОДГОТОВКЕ НОВЫХ
Dialogue: 0,0:02:11.43,0:02:14.15,Caption,,0,0,0,,РОССИЙСКИХ УДАРОВ ПО ЭНЕРГЕТИЧЕСКИМ ОБЪЕКТАМ И
Dialogue: 0,0:02:14.15,0:02:16.95,Caption,,0,0,0,,КРИТИЧЕСКОЙ ИНФРАСТРУКТУРЕ. ПОЧТИ ОДНОВРЕМЕННО
Dialogue: 0,0:02:16.95,0:02:19.59,Caption,,0,0,0,,СПИКЕР ВЕРХОВНОЙ РАДЫ РУСЛАН СТЕФАНЧУК НАЧАЛ
Dialogue: 0,0:02:19.59,0:02:22.39,Caption,,0,0,0,,РАССУЖДАТЬ О РАБОТЕ ПАРЛАМЕНТА В СЛУЧАЕ РАЗРУШЕНИЯ
Dialogue: 0,0:02:22.47,0:02:26.59,Caption,,0,0,0,,ЕГО ЗДАНИЯ. ОБСУЖДАЮТСЯ УКРЫТИЯ,
Dialogue: 0,0:02:26.74,0:02:29.95,Caption,,0,0,0,,ЗАПАСНЫЕ СПОСОБЫ ГОЛОСОВАНИЯ И СОХРАНЕНИЕ УПРАВЛЕНИЯ
Dialogue: 0,0:02:30.03,0:02:32.03,Caption,,0,0,0,,ПРИ КРАЙНЕ ТЯЖЁЛОМ РАЗВИТИИ СОБЫТИЙ.
Dialogue: 0,0:02:32.67,0:02:34.43,Caption,,0,0,0,,РУКОВОДСТВО ЕЩЁ НЕ ПОЛУЧИЛО СЧЁТ,
Dialogue: 0,0:02:34.67,0:02:37.31,Caption,,0,0,0,,А УЖЕ ВЫЯСНЯЕТ, ГДЕ БУДЕТ РАСПЛАЧИВАТЬСЯ.
Dialogue: 0,0:02:38.07,0:02:40.67,Caption,,0,0,0,,ИГНАТ И СТЕФАНЧУК НЕ ОБЫЧНЫЕ ЧИТАТЕЛИ НОВОСТНЫХ
Dialogue: 0,0:02:40.75,0:02:43.31,Caption,,0,0,0,,КАНАЛОВ. ИХ ДОЛЖНОСТИ ПРЕДПОЛАГАЮТ ДОСТУП К
Dialogue: 0,0:02:43.31,0:02:47.71,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЯМ И ОЦЕНКАМ, КОТОРЫЕ ПОЯВЛЯЮТСЯ РАНЬШЕ ПУБЛИЧНЫХ СООБЩЕНИЙ.
Dialogue: 0,0:02:48.06,0:02:52.67,Caption,,0,0,0,,ПОЭТОМУ ВАЖЕН МОМЕНТ, КОГДА НАЧАЛИСЬ ЭТИ РАЗГОВОРЫ. ЧТО ВНУТРИ УКРАИНСКОЙ
Dialogue: 0,0:02:52.67,0:02:55.79,Caption,,0,0,0,,СИСТЕМЫ УЖЕ ЗНАЛИ О ВЕРОЯТНОМ ОТВЕТЕ И ПОЧЕМУ
Dialogue: 0,0:02:55.79,0:02:57.63,Caption,,0,0,0,,ПОДГОТОВКУ ОБОЗНАЧИЛИ ЗАРАНЕЕ?
Dialogue: 0,0:02:58.15,0:03:00.91,Caption,,0,0,0,,СТЕФАНЧУК НЕ ОБЯЗАН ЛИЧНО ВЫБИРАТЬ ЦЕЛЬ НА КАРТЕ.
Dialogue: 0,0:03:01.28,0:03:03.87,Caption,,0,0,0,,НО ЕСЛИ РУКОВОДСТВО ГОТОВИТ ПАРЛАМЕНТ К РАБОТЕ ПОСЛЕ
Dialogue: 0,0:03:03.87,0:03:05.71,Caption,,0,0,0,,ВОЗМОЖНОГО УНИЧТОЖЕНИЯ ЗДАНИЯ,
Dialogue: 0,0:03:05.95,0:03:08.91,Caption,,0,0,0,,РЕЧЬ ИДЁТ НЕ О РЯДОВОЙ ТРЕВОГЕ. МАСШТАБ СЛЕДУЮЩЕГО
Dialogue: 0,0:03:08.91,0:03:11.39,Caption,,0,0,0,,ЭТАПА УЖЕ СОЧЛИ ДОСТАТОЧНО СЕРЬЁЗНЫМ,
Dialogue: 0,0:03:11.55,0:03:14.35,Caption,,0,0,0,,ЧТОБЫ ЗАРАНЕЕ ПРОДУМЫВАТЬ СОХРАНЕНИЕ ВЛАСТИ. ТЕМ
Dialogue: 0,0:03:14.43,0:03:17.39,Caption,,0,0,0,,ВРЕМЕНЕМ ЗЕЛЕНСКИЙ ПРОДОЛЖАЕТ ЗАРУБЕЖНЫЕ ПОЕЗДКИ.
Dialogue: 0,0:03:17.69,0:03:20.27,Caption,,0,0,0,,ДОМА ОБСУЖДАЮТ ЭНЕРГЕТИКУ, УБЕЖИЩА,
Dialogue: 0,0:03:20.48,0:03:22.67,Caption,,0,0,0,,НОВЫЕ УДАРЫ И ЗАПАСНОЙ ПАРЛАМЕНТ.
Dialogue: 0,0:03:23.26,0:03:26.99,Caption,,0,0,0,,ВЛАДИМИР АЛЕКСАНДРОВИЧ, ВОЗВРАЩАЙТЕСЬ. ВАС ТАМ УЖЕ НАСТОЛЬКО ЖДУТ,
Dialogue: 0,0:03:27.23,0:03:29.55,Caption,,0,0,0,,ЧТО ДАЖЕ РАБОЧЕЕ МЕСТО ГОТОВЯТ В НЕСКОЛЬКИХ
Dialogue: 0,0:03:29.55,0:03:32.59,Caption,,0,0,0,,ЭКЗЕМПЛЯРАХ. ЗА ШУТКОЙ ОСТАЁТСЯ КОНКРЕТНЫЙ ВЫВОД.
Dialogue: 0,0:03:32.85,0:03:35.39,Caption,,0,0,0,,КИЕВ СМОТРИТ НЕ ТОЛЬКО НА СЕГОДНЯШНИЕ СОБЫТИЯ,
Dialogue: 0,0:03:35.59,0:03:39.07,Caption,,0,0,0,,НО И ГОТОВИТСЯ К ТОМУ, ЧТО ПРОИЗОЙДЁТ ПОСЛЕ СЛЕДУЮЩЕГО ХОДА.
Dialogue: 0,0:03:41.35,0:03:43.51,Caption,,0,0,0,,ПОЭТОМУ ОЦЕНИВАТЬ НУЖНО ВСЮ ЦЕПОЧКУ,
Dialogue: 0,0:03:43.76,0:03:46.71,Caption,,0,0,0,,ВКЛЮЧАЯ ЗАРАНЕЕ ПРЕДУСМОТРЕННЫЕ ПОСЛЕДСТВИЯ. ПО
Dialogue: 0,0:03:46.79,0:03:51.35,Caption,,0,0,0,,ПОСТУПИВШЕЙ ИНФОРМАЦИИ, РОССИЙСКИМ ВОЕННЫМ ПОСЛЕ НОВОГО ВИТКА ПРОТИВОСТОЯНИЯ
Dialogue: 0,0:03:51.60,0:03:54.87,Caption,,0,0,0,,МОГЛИ РАСШИРИТЬ ПЕРЕЧЕНЬ ДОСТУПНЫХ ЦЕЛЕЙ. В ВОЕННОЙ
Dialogue: 0,0:03:54.87,0:03:56.95,Caption,,0,0,0,,СРЕДЕ ТАКОЕ РЕШЕНИЕ ЯКОБЫ ВСТРЕТИЛИ С
Dialogue: 0,0:03:56.95,0:04:01.03,Caption,,0,0,0,,ВООДУШЕВЛЕНИЕМ, ПОСКОЛЬКУ СНЯТИЯ ПРЕЖНИХ ОГРАНИЧЕНИЙ ЖДАЛИ ДАВНО.
Dialogue: 0,0:04:01.67,0:04:06.79,Caption,,0,0,0,,ЕСЛИ ИНФОРМАЦИЯ ВЕРНА, ЦЕНА УКРАИНСКОЙ ОПЕРАЦИИ РЕЗКО ВОЗРАСТАЕТ. ОДИН
Dialogue: 0,0:04:06.87,0:04:09.27,Caption,,0,0,0,,ЭФФЕКТНЫЙ УДАР СПОСОБЕН ОТКРЫТЬ РОССИЙСКОЙ СТОРОНЕ
Dialogue: 0,0:04:09.27,0:04:12.87,Caption,,0,0,0,,ВОЗМОЖНОСТИ, КОТОРЫЕ ПРЕЖДЕ СДЕРЖИВАЛИСЬ РЕШЕНИЯМИ СВЕРХУ.
Dialogue: 0,0:04:13.59,0:04:16.15,Caption,,0,0,0,,КИЕВ ХОТЕЛ ПОЛУЧИТЬ КРАСИВЫЙ КАДР ДЛЯ ЗАПАДНОЙ
Dialogue: 0,0:04:16.15,0:04:19.43,Caption,,0,0,0,,АУДИТОРИИ, А МОГ ДАТЬ МОСКВЕ ПОВОД УДАРИТЬ ПО НОВЫМ
Dialogue: 0,0:04:19.43,0:04:23.11,Caption,,0,0,0,,ЦЕЛЯМ. НАСТОЯЩАЯ СТОИМОСТЬ ТАКИХ ДЕЙСТВИЙ ОБНАРУЖИВАЕТСЯ НЕ
Dialogue: 0,0:04:23.19,0:04:26.15,Caption,,0,0,0,,В ПЕРВЫЕ ЧАСЫ. СНАЧАЛА ЗВУЧАТ ПОЗДРАВЛЕНИЯ,
Dialogue: 0,0:04:26.31,0:04:29.43,Caption,,0,0,0,,СОСТАВЛЯЮТСЯ БОДРЫЕ ОТЧЁТЫ И ВЫБИРАЮТСЯ УДАЧНЫЕ
Dialogue: 0,0:04:29.43,0:04:31.83,Caption,,0,0,0,,ФОТОГРАФИИ. ПОЗДНЕЕ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:04:32.06,0:04:35.43,Caption,,0,0,0,,ЧТО ПРОТИВНИК ИЗМЕНИЛ ПРАВИЛА И ВОЗВРАЩАТЬ ПРЕЖНИЕ
Dialogue: 0,0:04:35.43,0:04:38.63,Caption,,0,0,0,,ОГРАНИЧЕНИЯ НЕ СОБИРАЕТСЯ. ПРАЗДНИЧНЫЙ СТОЛ ЕЩЁ НЕ
Dialogue: 0,0:04:38.63,0:04:45.11,Caption,,0,0,0,,УБРАЛИ, А СЧЁТ УЖЕ ПРИНЕСЛИ. ОТДЕЛЬНОГО ВНИМАНИЯ ЗАСЛУЖИВАЕТ STARLINK. ДАЖЕ ПРИ
Dialogue: 0,0:04:45.11,0:04:47.83,Caption,,0,0,0,,ОГРАНИЧЕНИЯХ В РАБОТЕ ЭТОЙ СИСТЕМЫ УКРАИНСКАЯ
Dialogue: 0,0:04:47.83,0:04:50.71,Caption,,0,0,0,,СТОРОНА СОХРАНЯЛА ВОЗМОЖНОСТЬ НАНОСИТЬ ТОЧНЫЕ И
Dialogue: 0,0:04:50.71,0:04:53.27,Caption,,0,0,0,,ЧУВСТВИТЕЛЬНЫЕ УДАРЫ. ПОЭТОМУ ОБЪЯСНЕНИЕ,
Dialogue: 0,0:04:53.42,0:04:55.99,Caption,,0,0,0,,В КОТОРОМ ВСЁ ЗАВИСИТ ОТ ОДНОГО СПУТНИКОВОГО
Dialogue: 0,0:04:56.07,0:04:58.39,Caption,,0,0,0,,СЕРВИСА, СЛИШКОМ УПРОЩАЕТ СИТУАЦИЮ.
Dialogue: 0,0:05:00.66,0:05:03.30,Caption,,0,0,0,,ПОСТОЯННАЯ СВЯЗЬ НА ОГРОМНОЙ ПРОТЯЖЁННОСТИ ФРОНТА
Dialogue: 0,0:05:03.30,0:05:05.06,Caption,,0,0,0,,ТРЕБУЕТ МОЩНОЙ ИНФРАСТРУКТУРЫ,
Dialogue: 0,0:05:05.22,0:05:07.62,Caption,,0,0,0,,НЕПРЕРЫВНОЙ РАБОТЫ И БОЛЬШОГО КОЛИЧЕСТВА
Dialogue: 0,0:05:07.62,0:05:11.62,Caption,,0,0,0,,ОБОРУДОВАНИЯ. ДЛЯ ОТДЕЛЬНОЙ ОПЕРАЦИИ НА КОНКРЕТНОМ УЧАСТКЕ НУЖНЫ
Dialogue: 0,0:05:11.62,0:05:16.26,Caption,,0,0,0,,ОГРАНИЧЕННОЕ ВРЕМЯ, НУЖНАЯ ЗОНА И ЗАРАНЕЕ ПОСТАВЛЕННАЯ ЗАДАЧА.
Dialogue: 0,0:05:16.68,0:05:19.46,Caption,,0,0,0,,ОБЕСПЕЧИВАТЬ СВЯЗЬЮ ТЫСЯЧУ КИЛОМЕТРОВ МЕСЯЦАМИ
Dialogue: 0,0:05:19.60,0:05:22.66,Caption,,0,0,0,,НЕОБЯЗАТЕЛЬНО. КРОМЕ STARLINK СУЩЕСТВУЮТ ДРУГИЕ
Dialogue: 0,0:05:22.66,0:05:26.18,Caption,,0,0,0,,КАНАЛЫ СВЯЗИ, НАВИГАЦИОННЫЕ СРЕДСТВА И РАЗВЕДЫВАТЕЛЬНЫЕ
Dialogue: 0,0:05:26.18,0:05:28.98,Caption,,0,0,0,,ВОЗМОЖНОСТИ. ОНИ НЕ ДОЛЖНЫ ЗАМЕНЯТЬ ВСЮ СИСТЕМУ
Dialogue: 0,0:05:28.98,0:05:33.30,Caption,,0,0,0,,ЦЕЛИКОМ. ДОСТАТОЧНО, ЧТОБЫ НУЖНЫЙ НАБОР ИНСТРУМЕНТОВ НЕСКОЛЬКО ЧАСОВ
Dialogue: 0,0:05:33.38,0:05:37.14,Caption,,0,0,0,,РАБОТАЛ ТАМ, ГДЕ ГОТОВИТСЯ АТАКА. И ЗДЕСЬ ПОЯВЛЯЕТСЯ КАРТА
Dialogue: 0,0:05:37.14,0:05:39.78,Caption,,0,0,0,,ПОЛЁТОВ НАД ЧЁРНЫМ МОРЕМ. НА НЕЙ ОДНОВРЕМЕННО
Dialogue: 0,0:05:39.78,0:05:42.26,Caption,,0,0,0,,ОТМЕЧЕНЫ МАРШРУТЫ БРИТАНСКОГО РАЗВЕДЫВАТЕЛЬНОГО
Dialogue: 0,0:05:42.26,0:05:47.14,Caption,,0,0,0,,САМОЛЁТА РИВЕТ ДЖОЙНТ, АМЕРИКАНСКОГО АРТЕМИС ДВА И ИТАЛЬЯНСКОЙ МАШИНЫ
Dialogue: 0,0:05:47.14,0:05:50.58,Caption,,0,0,0,,ДАЛЬНЕГО РАДИОЛОКАЦИОННОГО ОБНАРУЖЕНИЯ. ЭКИПАЖИ ЭТИХ
Dialogue: 0,0:05:50.58,0:05:53.06,Caption,,0,0,0,,САМОЛЁТОВ НЕ ОБЯЗАНЫ НЕПОСРЕДСТВЕННО УПРАВЛЯТЬ
Dialogue: 0,0:05:53.06,0:05:56.02,Caption,,0,0,0,,УДАРОМ ПО МОСТУ, ЧТОБЫ ИХ ПРИСУТСТВИЕ ИМЕЛО ЗНАЧЕНИЕ.
Dialogue: 0,0:05:56.68,0:05:59.46,Caption,,0,0,0,,КАРТА ПОКАЗЫВАЕТ ПЛОТНОСТЬ ЗАПАДНОЙ РАЗВЕДЫВАТЕЛЬНОЙ
Dialogue: 0,0:05:59.46,0:06:02.42,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ ВОКРУГ РЕГИОНА. У КИЕВА ОСТАЮТСЯ
Dialogue: 0,0:06:02.42,0:06:08.34,Caption,,0,0,0,,ВНЕШНИЕ ИСТОЧНИКИ НАБЛЮДЕНИЯ, СВЯЗИ И ТЕХНИЧЕСКОЙ ИНФОРМАЦИИ. STARLINK ВАЖЕН,
Dialogue: 0,0:06:08.48,0:06:10.58,Caption,,0,0,0,,НО НЕ ЯВЛЯЕТСЯ ЕДИНСТВЕННЫМ ИНСТРУМЕНТОМ.
Dialogue: 0,0:06:12.86,0:06:16.62,Caption,,0,0,0,,ПОЭТОМУ ВЕРСИЯ, БУДТО ОГРАНИЧЕНИЯ ОДНОГО СЕРВИСА АВТОМАТИЧЕСКИ
Dialogue: 0,0:06:16.62,0:06:19.66,Caption,,0,0,0,,ЛИШАЮТ УКРАИНУ ВОЗМОЖНОСТИ ГОТОВИТЬ ТОЧНЫЕ ОПЕРАЦИИ,
Dialogue: 0,0:06:19.98,0:06:24.22,Caption,,0,0,0,,ВЫГЛЯДИТ СЛИШКОМ УДОБНОЙ. РЯДОМ РАБОТАЮТ НЕСКОЛЬКО ПЛАТФОРМ СО СВОИМИ
Dialogue: 0,0:06:24.22,0:06:27.82,Caption,,0,0,0,,ЗАДАЧАМИ. ОДНА НАБЛЮДАЕТ, ДРУГАЯ СОБИРАЕТ ДАННЫЕ,
Dialogue: 0,0:06:28.14,0:06:30.86,Caption,,0,0,0,,ТРЕТЬЯ ПОМОГАЕТ ПЕРЕДАВАТЬ ИНФОРМАЦИЮ. ПОЛНОГО
Dialogue: 0,0:06:30.86,0:06:33.50,Caption,,0,0,0,,СОВПАДЕНИЯ ФУНКЦИЙ НЕ ТРЕБУЕТСЯ. НАПИШИТЕ В
Dialogue: 0,0:06:33.50,0:06:37.42,Caption,,0,0,0,,КОММЕНТАРИЯХ, КАК ВЫ СЧИТАЕТЕ СПОСОБНО ЛИ ОГРАНИЧЕНИЕ ОДНОЙ
Dialogue: 0,0:06:37.42,0:06:40.54,Caption,,0,0,0,,КРУПНОЙ СИСТЕМЫ ОСТАНОВИТЬ ОТДЕЛЬНУЮ ТОЧНУЮ
Dialogue: 0,0:06:40.54,0:06:44.14,Caption,,0,0,0,,ОПЕРАЦИЮ, ЕСЛИ ВОКРУГ РЕГИОНА ПРОДОЛЖАЕТ РАБОТАТЬ СЕТЬ ДРУГИХ
Dialogue: 0,0:06:44.22,0:06:48.78,Caption,,0,0,0,,СРЕДСТВ СВЯЗИ И РАЗВЕДКИ? ПОЧТИ ОДНОВРЕМЕННО ВОЗНИКЛА ИСТОРИЯ С ОПЕРАЦИЕЙ,
Dialogue: 0,0:06:48.94,0:06:51.50,Caption,,0,0,0,,КОТОРУЮ УЖЕ НАЗЫВАЮТ "ПАУТИНОЙ ДВА НОЛЬ".
Dialogue: 0,0:06:52.12,0:06:55.18,Caption,,0,0,0,,ФСБ СООБЩИЛА О ПРЕДОТВРАЩЕНИИ АТАК НА РОССИЙСКИЕ
Dialogue: 0,0:06:55.26,0:06:58.86,Caption,,0,0,0,,ПОРТЫ, КОРАБЛИ И АЭРОДРОМЫ. ДЛЯ ИХ ПОДГОТОВКИ,
Dialogue: 0,0:06:59.02,0:07:03.10,Caption,,0,0,0,,ПО ДАННЫМ СПЕЦСЛУЖБЫ, СОБИРАЛИСЬ ИСПОЛЬЗОВАТЬ УДАРНЫЕ БЕСПИЛОТНИКИ,
Dialogue: 0,0:07:03.26,0:07:08.06,Caption,,0,0,0,,ВЗРЫВЧАТКУ И ГИДРОЦИКЛЫ. КОГДА ОДНА ОПЕРАЦИЯ ЗАКАНЧИВАЕТСЯ ТАМ,
Dialogue: 0,0:07:08.30,0:07:12.94,Caption,,0,0,0,,ГДЕ НАЧИНАЕТСЯ СЛЕДУЮЩАЯ, СЛУЧАЙНОСТЬЮ ЭТО НАЗВАТЬ ТРУДНО. КИЕВ МЕШАЕТ
Dialogue: 0,0:07:12.94,0:07:15.58,Caption,,0,0,0,,ПЕРЕГОВОРАМ, А ЗАТЕМ ОБВИНЯЕТ ДРУГИХ В ТОМ,
Dialogue: 0,0:07:15.73,0:07:18.22,Caption,,0,0,0,,ЧТО ОБСУЖДЕНИЕ НЕ ПРОДВИГАЕТСЯ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:07:18.38,0:07:20.62,Caption,,0,0,0,,ЕСЛИ ДО СИХ ПОР ЭТОГО НЕ СДЕЛАЛИ. ТЕПЕРЬ
Dialogue: 0,0:07:20.62,0:07:23.34,Caption,,0,0,0,,ВЕРНЁМСЯ К ЦЕНТРАЛЬНОМУ РАСЧЁТУ. У КИЕВА ЕСТЬ
Dialogue: 0,0:07:23.34,0:07:25.02,Caption,,0,0,0,,ВЛИЯТЕЛЬНЫЙ СОЮЗНИК В ЛОНДОНЕ.
Dialogue: 0,0:07:27.31,0:07:30.03,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ ПОСЛЕДОВАТЕЛЬНО ПОДДЕРЖИВАЕТ ЖЁСТКИЙ
Dialogue: 0,0:07:30.03,0:07:33.07,Caption,,0,0,0,,КУРС В ОТНОШЕНИИ РОССИИ И МОЖЕТ ПОМОЧЬ ЗЕЛЕНСКОМУ
Dialogue: 0,0:07:33.07,0:07:36.67,Caption,,0,0,0,,ПРЕДСТАВИТЬ ТРАМПУ НУЖНУЮ ВЕРСИЮ СОБЫТИЙ. В НЕЙ
Dialogue: 0,0:07:36.67,0:07:41.87,Caption,,0,0,0,,УКРАИНА СТРЕМИТСЯ К МИРУ, А РОССИЙСКИЕ УДАРЫ ДОКАЗЫВАЮТ ОБРАТНОЕ. ЭТОТ РАСЧЁТ
Dialogue: 0,0:07:41.95,0:07:46.27,Caption,,0,0,0,,СРАБОТАЕТ ЛИШЬ В ТОМ СЛУЧАЕ, ЕСЛИ ТРАМП ПОСМОТРИТ НА ПОСЛЕДНИЙ ЭПИЗОД И НЕ
Dialogue: 0,0:07:46.27,0:07:49.95,Caption,,0,0,0,,СПРОСИТ, ЧТО ЕМУ ПРЕДШЕСТВОВАЛО. НО ТРАМП УЖЕ ПРИЗНАВАЛ,
Dialogue: 0,0:07:50.11,0:07:52.91,Caption,,0,0,0,,ЧТО МОСКВА СПОСОБНА ДЕЙСТВОВАТЬ НАМНОГО СИЛЬНЕЕ.
Dialogue: 0,0:07:53.36,0:07:55.95,Caption,,0,0,0,,РОССИЯ ПРИ ЭТОМ ЗАЯВЛЯЕТ О ГОТОВНОСТИ ПРОДОЛЖАТЬ
Dialogue: 0,0:07:56.03,0:07:59.47,Caption,,0,0,0,,ПЕРЕГОВОРЫ ДАЖЕ ПОСЛЕ АТАКИ НА МОСТ. ПОЭТОМУ ПУТИН
Dialogue: 0,0:07:59.47,0:08:02.19,Caption,,0,0,0,,МОЖЕТ ПОКАЗАТЬ АМЕРИКАНСКОМУ ПРЕЗИДЕНТУ НЕ ТОЛЬКО
Dialogue: 0,0:08:02.19,0:08:04.83,Caption,,0,0,0,,РОССИЙСКИЙ ОТВЕТ, НО И УКРАИНСКОЕ РЕШЕНИЕ,
Dialogue: 0,0:08:04.96,0:08:07.95,Caption,,0,0,0,,КОТОРОЕ ЕГО ЗАПУСТИЛО. ТОГДА ВОПРОС МЕНЯЕТСЯ ЗАЧЕМ
Dialogue: 0,0:08:07.95,0:08:10.75,Caption,,0,0,0,,КИЕВ ПЕРЕД ВАЖНЫМИ КОНТАКТАМИ ПРЕДПРИНЯЛ ДЕЙСТВИЕ,
Dialogue: 0,0:08:10.96,0:08:13.31,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО СЕРЬЁЗНАЯ РЕАКЦИЯ МОСКВЫ БЫЛА
Dialogue: 0,0:08:13.31,0:08:17.07,Caption,,0,0,0,,ПРЕДСКАЗУЕМА? ДЛЯ ЗЕЛЕНСКОГО ТАКОЙ ПОВОРОТ ЗНАЧИТЕЛЬНО ОПАСНЕЕ
Dialogue: 0,0:08:17.07,0:08:20.67,Caption,,0,0,0,,САМОГО ОБМЕНА ОБВИНЕНИЯМИ. ЗАПАДУ ГОДАМИ ПОКАЗЫВАЮТ
Dialogue: 0,0:08:20.67,0:08:24.91,Caption,,0,0,0,,УКРАИНУ КАК СТОРОНУ, КОТОРАЯ ИСКЛЮЧИТЕЛЬНО ЗАЩИЩАЕТСЯ. ЭТА ВЕРСИЯ
Dialogue: 0,0:08:24.91,0:08:28.75,Caption,,0,0,0,,РАБОТАЕТ, ПОКА КАЖДЫЙ ЭПИЗОД РАССМАТРИВАЮТ ОТДЕЛЬНО. НО ЕСЛИ
Dialogue: 0,0:08:28.75,0:08:30.83,Caption,,0,0,0,,ТРАМП УВИДИТ ВСЮ ЦЕПОЧКУ РЕШЕНИЙ,
Dialogue: 0,0:08:31.17,0:08:34.19,Caption,,0,0,0,,ЕМУ ПРИДЁТСЯ ОЦЕНИВАТЬ, КТО ПЕРВЫМ ПОДНЯЛ СТАВКУ,
Dialogue: 0,0:08:34.50,0:08:37.71,Caption,,0,0,0,,КТО ПОНИМАЛ ПОСЛЕДСТВИЯ И КТО СОБИРАЛСЯ ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:08:37.79,0:08:43.82,Caption,,0,0,0,,ИХ В БУДУЩЕМ РАЗГОВОРЕ. ТОГДА ПРЕДУПРЕЖДЕНИЯ ИГНАТА ПЕРЕСТАЮТ БЫТЬ ОБЫЧНЫМ
Dialogue: 0,0:08:43.82,0:08:46.86,Caption,,0,0,0,,ПРОГНОЗОМ. ПОДГОТОВКА ВЕРХОВНОЙ РАДЫ ВЫГЛЯДИТ УЖЕ НЕ
Dialogue: 0,0:08:46.86,0:08:48.70,Caption,,0,0,0,,ОТВЛЕЧЁННОЙ МЕРОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:08:49.30,0:08:51.58,Caption,,0,0,0,,ЗАРУБЕЖНЫЕ ПОЕЗДКИ ЗЕЛЕНСКОГО ПРИОБРЕТАЮТ
Dialogue: 0,0:08:51.58,0:08:54.14,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЙ СМЫСЛ. АТАКА НА МОСТ,
Dialogue: 0,0:08:54.47,0:08:57.82,Caption,,0,0,0,,ДРУГИЕ ГОТОВИВШИЕСЯ ОПЕРАЦИИ И ВЕРОЯТНОЕ РАСШИРЕНИЕ
Dialogue: 0,0:08:57.82,0:09:01.26,Caption,,0,0,0,,РОССИЙСКИХ ЦЕЛЕЙ ОКАЗЫВАЮТСЯ ЧАСТЯМИ БОРЬБЫ ЗА БОЛЕЕ
Dialogue: 0,0:09:01.26,0:09:04.70,Caption,,0,0,0,,ВЫГОДНОЕ ПОЛОЖЕНИЕ ПЕРЕД ПЕРЕГОВОРАМИ. МОСКВА ВЕДЁТ
Dialogue: 0,0:09:04.70,0:09:07.58,Caption,,0,0,0,,СОБСТВЕННУЮ ЛИНИЮ. ЕЁ ЗАДАЧА СОСТОИТ В ТОМ,
Dialogue: 0,0:09:07.82,0:09:10.70,Caption,,0,0,0,,ЧТОБЫ СОХРАНИТЬ ВОЗМОЖНОСТЬ КОНТАКТА С ТРАМПОМ И
Dialogue: 0,0:09:10.70,0:09:12.86,Caption,,0,0,0,,ОДНОВРЕМЕННО ПОКАЗАТЬ ПРЕДЕЛ ТЕРПЕНИЯ.
Dialogue: 0,0:09:13.62,0:09:16.30,Caption,,0,0,0,,ОБЪЯСНЕНИЕ ДЛЯ АМЕРИКАНСКОГО ПРЕЗИДЕНТА КОРОТКОЕ
Dialogue: 0,0:09:16.30,0:09:20.62,Caption,,0,0,0,,РОССИЯ ГОТОВА ОБСУЖДАТЬ МИР, НО НЕ ОСТАВИТ БЕЗ ОТВЕТА АТАКИ НА ЗНАЧИМЫЕ
Dialogue: 0,0:09:20.70,0:09:23.18,Caption,,0,0,0,,ОБЪЕКТЫ. ДЛЯ ЭТОГО НЕ НУЖНЫ ДЛИННЫЕ ЛЕКЦИИ О
Dialogue: 0,0:09:23.26,0:09:26.14,Caption,,0,0,0,,ВОЕННЫХ ДОКТРИНАХ. ДОСТАТОЧНО РАСПОЛОЖИТЬ СОБЫТИЯ ПО
Dialogue: 0,0:09:26.14,0:09:29.82,Caption,,0,0,0,,ПОРЯДКУ. СНАЧАЛА РЕШЕНИЕ КИЕВА. ЗАТЕМ РОССИЙСКАЯ
Dialogue: 0,0:09:29.82,0:09:32.70,Caption,,0,0,0,,РЕАКЦИЯ. ПОТОМ ПОПЫТКА УКРАИНСКОГО РУКОВОДСТВА
Dialogue: 0,0:09:32.70,0:09:35.18,Caption,,0,0,0,,ВЫДАТЬ ЕЁ ЗА САМОСТОЯТЕЛЬНЫЙ ОТКАЗ МОСКВЫ ОТ
Dialogue: 0,0:09:35.18,0:09:38.38,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ИМЕННО ЗДЕСЬ ВОЗМОЖНАЯ ОШИБКА КИЕВА
Dialogue: 0,0:09:38.38,0:09:43.02,Caption,,0,0,0,,СТАНОВИТСЯ ОСОБЕННО ДОРОГОЙ. ПРИ УДАЧНОМ ДЛЯ ЗЕЛЕНСКОГО РАЗВИТИИ СОБЫТИЙ
Dialogue: 0,0:09:43.32,0:09:45.90,Caption,,0,0,0,,РОССИЙСКИЙ ОТВЕТ ПРЕВРАТИТСЯ В АРГУМЕНТ ПРОТИВ
Dialogue: 0,0:09:45.90,0:09:49.34,Caption,,0,0,0,,МОСКВЫ. ЕГО ПОКАЖУТ ТРАМПУ КАК ПОДТВЕРЖДЕНИЕ ТОГО,
Dialogue: 0,0:09:49.50,0:09:51.90,Caption,,0,0,0,,ЧТО РОССИЯ ВЫБИРАЕТ ПРОДОЛЖЕНИЕ КОНФЛИКТА.
Dialogue: 0,0:09:54.17,0:09:56.41,Caption,,0,0,0,,НА ЭТОМ МОЖНО СТРОИТЬ НОВЫЕ ТРЕБОВАНИЯ,
Dialogue: 0,0:09:56.58,0:09:58.89,Caption,,0,0,0,,ПРОСИТЬ ПОДДЕРЖКУ И ЗАТЯГИВАТЬ ПЕРЕГОВОРЫ.
Dialogue: 0,0:09:59.59,0:10:02.17,Caption,,0,0,0,,ОДНА ОПЕРАЦИЯ СПОСОБНА ПРИНЕСТИ ДВА РАЗНЫХ
Dialogue: 0,0:10:02.17,0:10:05.53,Caption,,0,0,0,,РЕЗУЛЬТАТА. ОНА ЛИБО УХУДШИТ ПОЛОЖЕНИЕ МОСКВЫ ПЕРЕД
Dialogue: 0,0:10:05.53,0:10:08.81,Caption,,0,0,0,,ТРАМПОМ, ЛИБО ЗАСТАВИТ ЕГО ВНИМАТЕЛЬНЕЕ ПРИСМОТРЕТЬСЯ К
Dialogue: 0,0:10:08.81,0:10:11.29,Caption,,0,0,0,,ДЕЙСТВИЯМ КИЕВА. ВСЁ ЗАВИСИТ ОТ ТОГО,
Dialogue: 0,0:10:11.52,0:10:14.09,Caption,,0,0,0,,С КАКОГО МОМЕНТА ОН НАЧНЁТ РАЗБИРАТЬ СОБЫТИЯ.
Dialogue: 0,0:10:14.49,0:10:17.29,Caption,,0,0,0,,ПОЭТОМУ СУТЬ ПРОИСХОДЯЩЕГО НЕ В БЕТОННЫХ ПРОЛЁТАХ,
Dialogue: 0,0:10:17.53,0:10:20.57,Caption,,0,0,0,,БЕСПИЛОТНИКАХ И КОЛИЧЕСТВЕ ПОВРЕЖДЕНИЙ. БОРЬБА ИДЁТ
Dialogue: 0,0:10:20.65,0:10:22.89,Caption,,0,0,0,,ЗА ПРАВО ОБЪЯСНИТЬ АМЕРИКАНСКОМУ ПРЕЗИДЕНТУ
Dialogue: 0,0:10:22.89,0:10:25.37,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ ПРИЧИН И ПОСЛЕДСТВИЙ.
Dialogue: 0,0:10:26.00,0:10:28.57,Caption,,0,0,0,,ВО ВРЕМЯ ПЕРЕГОВОРОВ ЗНАЧЕНИЕ ИМЕЕТ НЕ ТОЛЬКО ТО,
Dialogue: 0,0:10:28.73,0:10:33.05,Caption,,0,0,0,,ЧТО ЛЕТИТ К ЦЕЛИ, НО И ПОРЯДОК РЕШЕНИЙ. КТО СДЕЛАЛ ПЕРВЫЙ ШАГ.
Dialogue: 0,0:10:33.33,0:10:36.65,Caption,,0,0,0,,КТО ОЖИДАЛ ОТВЕТ. КТО ЗАРАНЕЕ ГОТОВИЛ СТРАНУ К
Dialogue: 0,0:10:36.73,0:10:39.13,Caption,,0,0,0,,ЕГО ПОСЛЕДСТВИЯМ. И КТО ПОСЛЕ ЭТОГО ПРИШЁЛ К
Dialogue: 0,0:10:39.13,0:10:42.89,Caption,,0,0,0,,ПОСРЕДНИКУ, ИЗОБРАЖАЯ СЛУЧАЙНОГО СВИДЕТЕЛЯ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:10:42.89,0:10:45.69,Caption,,0,0,0,,РАССЧИТЫВАЕТ ПОКАЗАТЬ ТРАМПУ РОССИЙСКУЮ РЕАКЦИЮ БЕЗ
Dialogue: 0,0:10:45.69,0:10:48.65,Caption,,0,0,0,,УКРАИНСКОГО ВСТУПЛЕНИЯ. ПУТИН ПОСТАРАЕТСЯ ВЕРНУТЬ
Dialogue: 0,0:10:48.65,0:10:51.85,Caption,,0,0,0,,ВСТУПЛЕНИЕ НА МЕСТО. ЛОНДОН ПОМОЖЕТ КИЕВУ РАССТАВИТЬ
Dialogue: 0,0:10:51.85,0:10:54.65,Caption,,0,0,0,,НУЖНЫЕ АКЦЕНТЫ. МОСКВА ПРЕДЛОЖИТ СОБСТВЕННУЮ
Dialogue: 0,0:10:54.65,0:10:57.21,Caption,,0,0,0,,ХРОНОЛОГИЮ. А ТРАМП, ВЕРОЯТНО,
Dialogue: 0,0:10:57.43,0:11:01.21,Caption,,0,0,0,,СПРОСИТ ТО, ЧЕГО В КИЕВЕ ХОТЕЛИ БЫ ИЗБЕЖАТЬ КОМУ ПОНАДОБИЛОСЬ
Dialogue: 0,0:11:01.21,0:11:03.45,Caption,,0,0,0,,ПОВЫШАТЬ СТАВКИ ПЕРЕД РАЗГОВОРОМ О МИРЕ?
Dialogue: 0,0:11:05.72,0:11:08.28,Caption,,0,0,0,,ЕСЛИ ИСТОРИЯ С КРЫМСКИМ МОСТОМ ЗАДУМЫВАЛАСЬ КАК
Dialogue: 0,0:11:08.28,0:11:12.44,Caption,,0,0,0,,КАПКАН ДЛЯ РОССИИ, ЕГО СОЗДАТЕЛЯМ СТОИТ ПОСМОТРЕТЬ ПОД НОГИ. У ТАКИХ
Dialogue: 0,0:11:12.44,0:11:14.60,Caption,,0,0,0,,УСТРОЙСТВ ЕСТЬ НЕПРИЯТНОЕ СВОЙСТВО ОНИ НЕ
Dialogue: 0,0:11:14.60,0:11:17.80,Caption,,0,0,0,,СПРАШИВАЮТ, ЧЬЯ РУКА ПЕРВОЙ ПОТЯНУЛАСЬ К МЕХАНИЗМУ.
