Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,ЙОХАНН ВАДЕФУЛЬ ОТВЕТИЛ ДЕПУТАТУ БУНДЕСТАГА МАРКУСУ
Dialogue: 0,0:00:02.92,0:00:07.08,Caption,,0,0,0,,ФРОНМАЙЕРУ ИЗ АДГ, ЧТО ТОТ ЧРЕЗМЕРНО УВЛЕКАЕТСЯ ВНЕШНЕЙ ПОЛИТИКОЙ В
Dialogue: 0,0:00:07.08,0:00:10.12,Caption,,0,0,0,,УЩЕРБ ИНТЕРЕСАМ ГЕРМАНИИ. СОПОСТАВЛЕНИЕ ПОМОЩИ
Dialogue: 0,0:00:10.20,0:00:12.68,Caption,,0,0,0,,НЕМЦАМ И ПОМОЩИ УКРАИНЕ МИНИСТР НАЗВАЛ ПОЧТИ
Dialogue: 0,0:00:12.68,0:00:16.84,Caption,,0,0,0,,ПОЩЁЧИНОЙ ЛЮДЯМ, КОТОРЫЕ СТРАДАЮТ ОТ КОНФЛИКТА. ПОЛУЧИЛСЯ РЕДКИЙ
Dialogue: 0,0:00:16.84,0:00:20.36,Caption,,0,0,0,,РАЗГОВОР, ГДЕ ВОПРОС О НЕМЕЦКИХ ИНТЕРЕСАХ ОБЪЯВИЛИ ВРЕДНЫМ ДЛЯ
Dialogue: 0,0:00:20.36,0:00:23.24,Caption,,0,0,0,,НЕМЕЦКИХ ИНТЕРЕСОВ. ДЕПУТАТ СПРОСИЛ О ТЕПЛЕ,
Dialogue: 0,0:00:23.39,0:00:26.28,Caption,,0,0,0,,МИНИСТР ПРОВЕРИЛ ЕГО НРАВСТВЕННОСТЬ. ЕЩЁ ПАРА ТАКИХ
Dialogue: 0,0:00:26.36,0:00:29.08,Caption,,0,0,0,,ОТВЕТОВ, И ТЕМПЕРАТУРУ В КВАРТИРЕ НАЧНУТ ИЗМЕРЯТЬ НЕ
Dialogue: 0,0:00:29.08,0:00:32.68,Caption,,0,0,0,,ГРАДУСНИКОМ, А УРОВНЕМ СОЛИДАРНОСТИ. ЗАМЁРЗ ПРАВИЛЬНО,
Dialogue: 0,0:00:32.76,0:00:35.00,Caption,,0,0,0,,ПОЛУЧИ БЛАГОДАРНОСТЬ. ЗАДАЛ ВОПРОС,
Dialogue: 0,0:00:35.31,0:00:38.92,Caption,,0,0,0,,ЗНАЧИТ, БАТАРЕЯ У ТЕБЯ НЕДОСТАТОЧНО ИДЕЙНО ХОЛОДНАЯ. А
Dialogue: 0,0:00:39.00,0:00:42.20,Caption,,0,0,0,,СПРАШИВАЛ ФРОНМАЙЕР О ПРЕДЕЛЬНО ЗЕМНОМ. ЗЕЛЕНСКОМУ,
Dialogue: 0,0:00:42.27,0:00:46.28,Caption,,0,0,0,,ПРИЕХАВШЕМУ В БЕРЛИН, ГЕРМАНИЯ ВЫДЕЛЯЕТ ЕЩЁ ДВЕСТИ МИЛЛИОНОВ ЕВРО ТАК
Dialogue: 0,0:00:46.28,0:00:49.16,Caption,,0,0,0,,НАЗЫВАЕМОЙ ЗИМНЕЙ ПОМОЩИ. КОГДА ТАКАЯ ПОМОЩЬ
Dialogue: 0,0:00:49.16,0:00:53.56,Caption,,0,0,0,,ПОЯВИТСЯ ДЛЯ САМИХ НЕМЦЕВ? ЕСЛИ ГОСУДАРСТВО УМЕЕТ ОПЛАЧИВАТЬ БОРЬБУ С ХОЛОДОМ
Dialogue: 0,0:00:53.64,0:00:57.08,Caption,,0,0,0,,ЗА ПРЕДЕЛАМИ СТРАНЫ, ЧТО ОНО СОБИРАЕТСЯ ДЕЛАТЬ С ХОЛОДОМ В ДОМАХ
Dialogue: 0,0:00:57.08,0:01:01.24,Caption,,0,0,0,,СОБСТВЕННЫХ ГРАЖДАН? ДО ПЯТИ МИЛЛИОНОВ ЧЕЛОВЕК В ГЕРМАНИИ ЭТОЙ ЗИМОЙ
Dialogue: 0,0:01:01.40,0:01:04.04,Caption,,0,0,0,,СНОВА МОГУТ ЭКОНОМИТЬ НА ОТОПЛЕНИИ. ВОТ
Dialogue: 0,0:01:04.04,0:01:07.56,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВО, НА ФОНЕ КОТОРОГО ВОПРОС О ПРИОРИТЕТАХ ПРОЗВУЧАЛ
Dialogue: 0,0:01:07.64,0:01:10.84,Caption,,0,0,0,,ОСОБЕННО НЕУДОБНО. ХОЛОД В КВАРТИРЕ НЕ ИНТЕРЕСУЕТСЯ
Dialogue: 0,0:01:10.84,0:01:16.25,Caption,,0,0,0,,ПРАВИЛЬНОСТЬЮ ВНЕШНЕГО КУРСА. ОН ПРОСТО ОСТАЁТСЯ ХОЛОДОМ,
Dialogue: 0,0:01:16.49,0:01:18.89,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ЧИНОВНИК ПОДОБРАЛ ДЛЯ НЕГО БЕЗУПРЕЧНОЕ
Dialogue: 0,0:01:18.89,0:01:21.69,Caption,,0,0,0,,ОБОСНОВАНИЕ. СОЦИАЛЬНЫЕ РАСХОДЫ ПЕРЕСТАЛИ БЫТЬ
Dialogue: 0,0:01:21.69,0:01:24.81,Caption,,0,0,0,,НЕПРИКОСНОВЕННЫМИ. ПЕНСИОНЕР ОКАЗАЛСЯ САМЫМ УДОБНЫМ
Dialogue: 0,0:01:24.81,0:01:27.61,Caption,,0,0,0,,МЕСТОМ ДЛЯ ЭКОНОМИИ. МОЛОДОЙ ЧЕЛОВЕК МОЖЕТ СМЕНИТЬ
Dialogue: 0,0:01:27.61,0:01:31.93,Caption,,0,0,0,,РАБОТУ, УЕХАТЬ ИЛИ НАЧАТЬ ЗАНОВО. ПОЖИЛОЙ УЖЕ ОТДАЛ СИСТЕМЕ
Dialogue: 0,0:01:31.93,0:01:35.37,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯ. ЕГО ТРУД УЧТЁН, ВЗНОСЫ ПОЛУЧЕНЫ,
Dialogue: 0,0:01:35.60,0:01:38.01,Caption,,0,0,0,,А ТЕПЕРЬ ВЫЯСНЯЕТСЯ, ЧТО САМИ ПРАВИЛА,
Dialogue: 0,0:01:38.10,0:01:42.25,Caption,,0,0,0,,ПО КОТОРЫМ ОН ПЛАТИЛ, ДЛЯ СИСТЕМЫ УЖЕ НЕОБЯЗАТЕЛЬНЫ. ОСОБАЯ ЛОВКОСТЬ
Dialogue: 0,0:01:42.33,0:01:44.97,Caption,,0,0,0,,СОСТОИТ В ВЫБОРЕ МОМЕНТА. ПРОСИТЬ ПЕНСИОНЕРА
Dialogue: 0,0:01:44.97,0:01:47.13,Caption,,0,0,0,,ПРИСПОСОБИТЬСЯ ПРОЩЕ, ЧЕМ ПРИЗНАТЬ,
Dialogue: 0,0:01:47.29,0:01:50.25,Caption,,0,0,0,,ЧТО ОБЕЩАНИЕ СТАЛО ДОРОЖЕ ДЛЯ ГОСУДАРСТВА. ОН НЕ
Dialogue: 0,0:01:50.25,0:01:52.81,Caption,,0,0,0,,ПЕРЕНЕСЁТ СОРОК ЛЕТ РАБОТЫ В ДРУГУЮ СТРАНУ И
Dialogue: 0,0:01:52.89,0:01:56.01,Caption,,0,0,0,,НЕ НАЧНЁТ ТРУДОВОЙ ПУТЬ ЗАНОВО. СИСТЕМА ПОЛУЧИЛА ОТ
Dialogue: 0,0:01:56.09,0:02:00.73,Caption,,0,0,0,,НЕГО ВСЁ ПО СТАРЫМ ПРАВИЛАМ, А РАССЧИТЫВАТЬСЯ ПРЕДЛАГАЕТ УЖЕ ПО НОВЫМ. СЛОВАКИЯ
Dialogue: 0,0:02:00.73,0:02:03.45,Caption,,0,0,0,,ХОЧЕТ ЖЁСТЧЕ СВЯЗАТЬ ПЕНСИОННЫЙ ВОЗРАСТ С ОЖИДАЕМОЙ
Dialogue: 0,0:02:03.45,0:02:06.01,Caption,,0,0,0,,ПРОДОЛЖИТЕЛЬНОСТЬЮ ЖИЗНИ. ВО ФРАНЦИИ ОБСУЖДАЛИ
Dialogue: 0,0:02:06.01,0:02:08.73,Caption,,0,0,0,,ОГРАНИЧЕНИЕ ИНДЕКСАЦИИ ДЛЯ ПЕНСИОНЕРОВ С ВЫПЛАТАМИ
Dialogue: 0,0:02:08.73,0:02:12.09,Caption,,0,0,0,,ДО ТЫСЯЧИ ДВУХСОТ ШЕСТИДЕСЯТИ ЕВРО В МЕСЯЦ. ЧЕХИЯ
Dialogue: 0,0:02:12.17,0:02:14.89,Caption,,0,0,0,,УРЕЗАЛА ДОПОЛНИТЕЛЬНУЮ ИНДЕКСАЦИЮ. РУМЫНИЯ
Dialogue: 0,0:02:14.89,0:02:17.93,Caption,,0,0,0,,ЗАМОРОЗИЛА ГОСУДАРСТВЕННЫЕ ПЕНСИИ НА ДВА ГОДА. А В
Dialogue: 0,0:02:17.93,0:02:20.25,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ ПРЕДЛОЖЕНО С ДВЕ ТЫСЯЧИ ТРИДЦАТОГО
Dialogue: 0,0:02:20.25,0:02:23.29,Caption,,0,0,0,,ГОДА УБРАТЬ ИЗ ИНДЕКСАЦИИ ПОКАЗАТЕЛЬ РОСТА ЗАРПЛАТ.
Dialogue: 0,0:02:25.57,0:02:28.05,Caption,,0,0,0,,СОВПАДЕНИЕ ПО СРОКАМ СЛИШКОМ ПОКАЗАТЕЛЬНОЕ ДЛЯ
Dialogue: 0,0:02:28.05,0:02:30.77,Caption,,0,0,0,,СЛУЧАЙНОСТИ. ПЯТЬ ПРАВИТЕЛЬСТВ ДЕЙСТВУЮТ ПОЧТИ
Dialogue: 0,0:02:30.77,0:02:34.53,Caption,,0,0,0,,ОДНОВРЕМЕННО, И КАЖДОЕ ОБЪЯВЛЯЕТ СВОЮ МЕРУ ОТДЕЛЬНЫМ НАЦИОНАЛЬНЫМ
Dialogue: 0,0:02:34.61,0:02:38.37,Caption,,0,0,0,,РЕШЕНИЕМ, А НЕ ЧАСТЬЮ ОБЩЕГО КУРСА. ТОЛЬКО КАРМАН ПЕНСИОНЕРА
Dialogue: 0,0:02:38.37,0:02:40.69,Caption,,0,0,0,,ВО ВСЕХ ПЯТИ СЛУЧАЯХ ПОЛУЧАЕТСЯ РОВНО ОДИН И
Dialogue: 0,0:02:40.77,0:02:44.21,Caption,,0,0,0,,ТОТ ЖЕ, ПРОСТО ФАМИЛИЯ МИНИСТРА КАЖДЫЙ РАЗ ДРУГАЯ. МОЖНО
Dialogue: 0,0:02:44.29,0:02:46.53,Caption,,0,0,0,,ДАЖЕ ПРЕДСТАВИТЬ КОНСУЛЬТАЦИЮ. ПЕНСИОНЕРУ
Dialogue: 0,0:02:46.61,0:02:49.17,Caption,,0,0,0,,ПРЕДЪЯВЛЯЮТ ЕГО ЖЕ ПРОДОЛЖИТЕЛЬНОСТЬ ЖИЗНИ КАК ПОВОД
Dialogue: 0,0:02:49.17,0:02:51.33,Caption,,0,0,0,,ОТОДВИНУТЬ ВЫПЛАТУ. ЕСЛИ ОН СПРОСИТ,
Dialogue: 0,0:02:51.50,0:02:53.81,Caption,,0,0,0,,ПОЧЕМУ ВЫПЛАТЫ ПРИ ЭТОМ НЕ СПЕШАТ РАСТИ ВМЕСТЕ
Dialogue: 0,0:02:53.89,0:02:56.53,Caption,,0,0,0,,С ЗАРПЛАТАМИ, КОНСУЛЬТАНТ УЛЫБНЁТСЯ И СООБЩИТ,
Dialogue: 0,0:02:56.77,0:02:59.49,Caption,,0,0,0,,ЧТО ДОЛГОЛЕТИЕ ЯВЛЯЕТСЯ ПРЕИМУЩЕСТВОМ САМО ПО СЕБЕ.
Dialogue: 0,0:02:59.80,0:03:03.65,Caption,,0,0,0,,ПОЛЬЗУЙТЕСЬ НА ЗДОРОВЬЕ, ПОКА ЕГО ТОЖЕ НЕ ВКЛЮЧИЛИ В РАСЧЁТ. ВОКРУГ
Dialogue: 0,0:03:03.65,0:03:06.69,Caption,,0,0,0,,АДГ ТЕМ ВРЕМЕНЕМ ВЫСТРОЕНА СТЕНА ИЗ ОТКАЗОВ ВСТУПАТЬ
Dialogue: 0,0:03:06.69,0:03:09.57,Caption,,0,0,0,,С НЕЙ В КОАЛИЦИЮ. ЗА НЕЁ РАЗРЕШАЮТ ГОЛОСОВАТЬ.
Dialogue: 0,0:03:09.97,0:03:12.85,Caption,,0,0,0,,ЕЙ РАЗРЕШАЮТ ВЫИГРЫВАТЬ ОПРОСЫ. ГРАЖДАНАМ НЕ
Dialogue: 0,0:03:12.85,0:03:15.81,Caption,,0,0,0,,ЗАПРЕЩАЮТ ВЫВОДИТЬ ЕЁ НА ПЕРВОЕ МЕСТО. А ДАЛЬШЕ
Dialogue: 0,0:03:15.81,0:03:18.85,Caption,,0,0,0,,НАЧИНАЕТСЯ НОМЕР С ЗАКРЫТОЙ ДВЕРЬЮ. ИЗБИРАТЕЛЬ СВОЙ
Dialogue: 0,0:03:18.85,0:03:21.09,Caption,,0,0,0,,БЮЛЛЕТЕНЬ ПРИНЁС, РЕЗУЛЬТАТ ПОКАЗАЛ,
Dialogue: 0,0:03:21.33,0:03:24.29,Caption,,0,0,0,,БЛАГОДАРИМ ЗА УЧАСТИЕ. ДО КАБИНЕТОВ ВЛАСТИ ЭТОТ
Dialogue: 0,0:03:24.29,0:03:27.17,Caption,,0,0,0,,ВЫБОР НЕ ДОЕДЕТ. ГЕРМАНИЯ ЯВЛЯЕТСЯ ПАРЛАМЕНТСКОЙ
Dialogue: 0,0:03:27.17,0:03:30.05,Caption,,0,0,0,,РЕСПУБЛИКОЙ. ОДИН ОПРОС НЕ СНИМАЕТ КАНЦЛЕРА,
Dialogue: 0,0:03:30.29,0:03:33.01,Caption,,0,0,0,,КАК ПЛОХО ПРИКЛЕЕННУЮ ТАБЛИЧКУ. СУЩЕСТВУЮТ
Dialogue: 0,0:03:33.01,0:03:36.85,Caption,,0,0,0,,ПАРЛАМЕНТ, КОАЛИЦИЯ, ВЫБОРЫ И УСТАНОВЛЕННЫЕ ПРОЦЕДУРЫ.
Dialogue: 0,0:03:39.13,0:03:41.61,Caption,,0,0,0,,НИКТО НЕ ОБЯЗАН УТРОМ УВИДЕТЬ ПЛОХИЕ ЦИФРЫ И
Dialogue: 0,0:03:41.69,0:03:44.01,Caption,,0,0,0,,К ОБЕДУ ВЫНОСИТЬ МЕБЕЛЬ ИЗ ВЕДОМСТВА. ВСЁ ЭТО
Dialogue: 0,0:03:44.09,0:03:48.65,Caption,,0,0,0,,ПОНЯТНО. НЕПОНЯТНО ДРУГОЕ. ЕСЛИ НАРОД СЧИТАЕТСЯ ИСТОЧНИКОМ ВЛАСТИ,
Dialogue: 0,0:03:49.05,0:03:50.89,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЕТСЯ ЕГО ПОЛНОМОЧИЕ?
Dialogue: 0,0:03:51.12,0:03:53.05,Caption,,0,0,0,,У УРНЫ? НА СТРАНИЦЕ С ИТОГАМИ?
Dialogue: 0,0:03:53.37,0:03:56.09,Caption,,0,0,0,,В ТОТ МОМЕНТ, КОГДА ПАРТИИ, ПРОИГРАВШИЕ ОПРОС,
Dialogue: 0,0:03:56.33,0:03:58.49,Caption,,0,0,0,,ДОГОВАРИВАЮТСЯ НЕ ПОДПУСКАТЬ ПОБЕДИТЕЛЯ?
Dialogue: 0,0:03:58.78,0:04:02.65,Caption,,0,0,0,,ПОЛУЧАЕТСЯ, ГРАЖДАНИНУ ДАЮТ ПРАВО НАЗВАТЬ ЖЕЛАЕМОЕ НАПРАВЛЕНИЕ,
Dialogue: 0,0:04:02.97,0:04:07.53,Caption,,0,0,0,,А ЗАТЕМ ВЕЖЛИВО СООБЩАЮТ, ЧТО НАВИГАТОР ПРИНИМАЕТ ТОЛЬКО ЗАРАНЕЕ ОДОБРЕННЫЕ
Dialogue: 0,0:04:07.53,0:04:10.97,Caption,,0,0,0,,АДРЕСА. ИСТОРИЯ ЗДЕСЬ НЕ ТОЛЬКО ПРО АДГ И ДАЖЕ
Dialogue: 0,0:04:11.05,0:04:13.77,Caption,,0,0,0,,НЕ ТОЛЬКО ПРО МЕРЦА. СЕГОДНЯ РЕЙТИНГ ПРОВАЛИЛСЯ У
Dialogue: 0,0:04:13.77,0:04:17.69,Caption,,0,0,0,,ОДНОГО КАНЦЛЕРА, ЗАВТРА ФАМИЛИЯ В КАБИНЕТЕ СМЕНИТСЯ. ГОРАЗДО
Dialogue: 0,0:04:17.69,0:04:22.01,Caption,,0,0,0,,СЕРЬЁЗНЕЕ МОМЕНТ, КОГДА ИЗБИРАТЕЛЬ ВИДИТ ПЕРВОЕ МЕСТО ОДНОЙ ПАРТИИ И
Dialogue: 0,0:04:22.01,0:04:26.09,Caption,,0,0,0,,ВЛАСТЬ СОВСЕМ ДРУГИХ, ПОСЛЕ ЧЕГО НАЧИНАЕТ СОМНЕВАТЬСЯ УЖЕ НЕ В КАНДИДАТЕ,
Dialogue: 0,0:04:26.25,0:04:30.97,Caption,,0,0,0,,А В СОБСТВЕННОМ БЮЛЛЕТЕНЕ. ДЕМОКРАТИЯ БЕЗ ОЩУЩЕНИЯ ВЛИЯНИЯ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:04:30.97,0:04:33.53,Caption,,0,0,0,,ТОРЖЕСТВЕННУЮ ЦЕРЕМОНИЮ. МУЗЫКА ИГРАЕТ,
Dialogue: 0,0:04:33.77,0:04:37.61,Caption,,0,0,0,,УЧАСТНИКИ НАРЯДНЫЕ, А ПОБЕДИТЕЛЯ ОПРЕДЕЛИЛИ В СОСЕДНЕМ ПОМЕЩЕНИИ.
Dialogue: 0,0:04:38.17,0:04:40.57,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ ПАРТИЙНЫЕ ЦИФРЫ ПОКАЗЫВАЮТ РАЗМЕР
Dialogue: 0,0:04:40.57,0:04:43.21,Caption,,0,0,0,,ПРОТИВОРЕЧИЯ. АДГ ПОЛУЧАЕТ ДВАДЦАТЬ ДЕВЯТЬ
Dialogue: 0,0:04:43.21,0:04:47.13,Caption,,0,0,0,,ПРОЦЕНТОВ. БЛОК ХДС И ХСС, НА КОТОРЫЙ ОПИРАЕТСЯ МЕРЦ,
Dialogue: 0,0:04:47.29,0:04:50.17,Caption,,0,0,0,,ПОЛУЧАЕТ ДЕВЯТНАДЦАТЬ. СОЦИАЛ ДЕМОКРАТЫ НАБИРАЮТ
Dialogue: 0,0:04:50.17,0:04:53.05,Caption,,0,0,0,,ЧЕТЫРНАДЦАТЬ. ПАРТИЯ ОПЕРЕЖАЕТ БЛОК КАНЦЛЕРА НА
Dialogue: 0,0:04:53.05,0:04:58.85,Caption,,0,0,0,,ДЕСЯТЬ ПРОЦЕНТНЫХ ПУНКТОВ. ЭТО УЖЕ НЕ СЛУЧАЙНЫЙ ЧИХ СОЦИОЛОГИИ,
Dialogue: 0,0:04:59.02,0:05:02.29,Caption,,0,0,0,,КОТОРЫЙ МОЖНО ПЕРЕЖДАТЬ ЗА ЧАШКОЙ КОФЕ. РАЗРЫВ ВИДЕН
Dialogue: 0,0:05:02.29,0:05:06.93,Caption,,0,0,0,,БЕЗ ЛУПЫ И БЕЗ СПЕЦИАЛИСТА, СПОСОБНОГО ОБЪЯСНИТЬ ЛЮБОЙ ПРОВАЛ СЛОВОМ "ДИНАМИКА".
Dialogue: 0,0:05:07.47,0:05:10.45,Caption,,0,0,0,,ГЛАВНАЯ ЦИФРА ВСПЛЫВАЕТ ТОЛЬКО СЕЙЧАС. НЕДОВОЛЬНЫХ
Dialogue: 0,0:05:10.45,0:05:13.01,Caption,,0,0,0,,РАБОТОЙ ФРИДРИХА МЕРЦА СРЕДИ ОПРОШЕННЫХ НЕМЦЕВ
Dialogue: 0,0:05:13.04,0:05:16.29,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ДВА ПРОЦЕНТА. ДОВОЛЬНЫХ НАБРАЛОСЬ ВСЕГО
Dialogue: 0,0:05:16.29,0:05:20.85,Caption,,0,0,0,,ТРИНАДЦАТЬ. КАЗАЛОСЬ БЫ, ПРИ ТАКОМ РЕЗУЛЬТАТЕ КАНЦЛЕРУ УЖЕ ВПОРУ НЕ РЕЙТИНГ
Dialogue: 0,0:05:20.85,0:05:24.61,Caption,,0,0,0,,ОБСУЖДАТЬ, А РАЗЫСКИВАТЬ ДОВОЛЬНЫХ ПО ОДНОМУ И СРОЧНО ОФОРМЛЯТЬ
Dialogue: 0,0:05:24.61,0:05:27.25,Caption,,0,0,0,,КАЖДОГО КАК ИСЧЕЗАЮЩИЙ ВИД НЕМЕЦКОЙ ПОЛИТИКИ.
Dialogue: 0,0:05:27.72,0:05:29.89,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ НУЖНЫ РАЗБОРЫ,
Dialogue: 0,0:05:30.13,0:05:33.17,Caption,,0,0,0,,ГДЕ ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ ИЩУТ КОНКРЕТНУЮ ЦЕНУ,
Dialogue: 0,0:05:33.32,0:05:38.37,Caption,,0,0,0,,ВЛАДЕЛЬЦА РЕШЕНИЯ И ТОГО, КОМУ ПРИНЕСУТ ПОСЛЕДСТВИЯ. ЗАПАДНЫЕ КОМПАНИИ ДОЛГО
Dialogue: 0,0:05:38.37,0:05:41.17,Caption,,0,0,0,,НАДЕЯЛИСЬ, ЧТО СПОР ГОСУДАРСТВ МОЖНО ПЕРЕЖДАТЬ,
Dialogue: 0,0:05:41.33,0:05:43.73,Caption,,0,0,0,,СОХРАНИВ ИМУЩЕСТВО. ОДНИ УХОДИЛИ,
Dialogue: 0,0:05:43.97,0:05:47.65,Caption,,0,0,0,,ДРУГИЕ ОСТАВАЛИСЬ, ТРЕТЬИ РАССЧИТЫВАЛИ ВЕРНУТЬСЯ ПОЗЖЕ. ТЕПЕРЬ
Dialogue: 0,0:05:47.65,0:05:51.17,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО РЕШЕНИЯ ГОСУДАРСТВ ДОХОДЯТ ДО СОБСТВЕННОСТИ.
Dialogue: 0,0:05:51.61,0:05:53.97,Caption,,0,0,0,,ПОКА СОВЕТ ДИРЕКТОРОВ ВЫБИРАЕТ УДОБНЫЙ МОМЕНТ,
Dialogue: 0,0:05:54.20,0:05:56.69,Caption,,0,0,0,,УПРАВЛЕНИЕ МОЖЕТ ПОЛУЧИТЬ СОВСЕМ ДРУГОЙ ДИРЕКТОР,
Dialogue: 0,0:05:56.93,0:05:59.65,Caption,,0,0,0,,КОТОРОГО В КОРПОРАТИВНОМ ПЛАНЕ НЕ БЫЛО. ЯПОНСКИЙ
Dialogue: 0,0:05:59.73,0:06:02.45,Caption,,0,0,0,,СЛУЧАЙ ПОКАЗЫВАЕТ ЭТО ОСОБЕННО ЯСНО. ОТНОШЕНИЯ
Dialogue: 0,0:06:02.45,0:06:05.49,Caption,,0,0,0,,МОСКВЫ И ТОКИО УХУДШАЛИСЬ. СООБЩАЛОСЬ О ПЕРЕДАЧЕ
Dialogue: 0,0:06:05.57,0:06:08.77,Caption,,0,0,0,,ЯПОНИЕЙ БЕСПИЛОТНИКОВ УКРАИНЕ. РОССИЯ ПРЕДУПРЕЖДАЛА
Dialogue: 0,0:06:08.85,0:06:14.64,Caption,,0,0,0,,О ЖЁСТКОМ ОТВЕТЕ. ВСКОРЕ КРУПНАЯ ЯПОНСКАЯ КОМПАНИЯ ПОТЕРЯЛА КОНТРОЛЬ
Dialogue: 0,0:06:14.64,0:06:17.04,Caption,,0,0,0,,НАД РОССИЙСКИМИ АКТИВАМИ. ПОСЛЕДОВАТЕЛЬНОСТЬ
Dialogue: 0,0:06:17.04,0:06:18.72,Caption,,0,0,0,,ПОЛУЧИЛАСЬ НАСТОЛЬКО ВЫРАЗИТЕЛЬНОЙ,
Dialogue: 0,0:06:18.96,0:06:21.36,Caption,,0,0,0,,ЧТО ОТДЕЛУ РИСКОВ ОСТАЁТСЯ ТОЛЬКО ОБВЕСТИ ДАТЫ
Dialogue: 0,0:06:21.36,0:06:25.28,Caption,,0,0,0,,КРАСНЫМ КАРАНДАШОМ. ОДНОВРЕМЕННО КИРИЛЛ ДМИТРИЕВ ВСТРЕЧАЕТСЯ С
Dialogue: 0,0:06:25.28,0:06:27.76,Caption,,0,0,0,,ИНОСТРАННЫМ БИЗНЕСОМ И ГОВОРИТ О СОТРУДНИЧЕСТВЕ,
Dialogue: 0,0:06:28.00,0:06:31.28,Caption,,0,0,0,,НОВЫХ ВОЗМОЖНОСТЯХ И ВОЗВРАЩЕНИИ. ПОЛУЧИЛАСЬ НОВАЯ
Dialogue: 0,0:06:31.28,0:06:33.68,Caption,,0,0,0,,ФОРМА ГОСТЕПРИИМСТВА. ВАС РАДЫ ВИДЕТЬ,
Dialogue: 0,0:06:33.82,0:06:37.28,Caption,,0,0,0,,ПРОХОДИТЕ. ТОЛЬКО КРЕСЛО, СТОЛ И ДОЛИ УЖЕ ЗАНЯТЫ,
Dialogue: 0,0:06:37.67,0:06:39.36,Caption,,0,0,0,,ПОЭТОМУ РАСПОЛАГАЙТЕСЬ ГДЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:06:39.92,0:06:41.68,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ ЕВРОПЕЙСКОГО БИЗНЕСА,
Dialogue: 0,0:06:41.79,0:06:43.60,Caption,,0,0,0,,КОТОРЫХ ЦИТИРУЕТ LE MONDE, ГОВОРЯТ,
Dialogue: 0,0:06:43.92,0:06:46.08,Caption,,0,0,0,,ЧТО ЗА ПОСЛЕДНИЕ ДВА МЕСЯЦА ПРОЦЕСС ЗАМЕТНО
Dialogue: 0,0:06:46.08,0:06:49.20,Caption,,0,0,0,,УСКОРИЛСЯ. ОДИН ИЗ НИХ ОПИСАЛ ПОЛОЖЕНИЕ БЕЗ ЛИШНЕЙ
Dialogue: 0,0:06:49.20,0:06:51.28,Caption,,0,0,0,,УПАКОВКИ ИХ ЗОВУТ ВОЗВРАЩАТЬСЯ В РОССИЮ,
Dialogue: 0,0:06:51.52,0:06:54.40,Caption,,0,0,0,,А ОДНОВРЕМЕННО ПРИСТАВЛЯЮТ НОЖ К ГОРЛУ. ДО ЭТОГО
Dialogue: 0,0:06:54.48,0:06:56.64,Caption,,0,0,0,,ПОД ВРЕМЕННОЕ УПРАВЛЕНИЕ УЖЕ ПЕРЕХОДИЛИ АКТИВЫ
Dialogue: 0,0:06:56.64,0:07:01.52,Caption,,0,0,0,,NESTLE, METRO, AUCHAN И ДРУГИХ ИНОСТРАННЫХ ВЛАДЕЛЬЦЕВ. СЛОВО
Dialogue: 0,0:07:01.52,0:07:03.92,Caption,,0,0,0,,"ВРЕМЕННОЕ" ЗВУЧИТ СПОКОЙНО ЛИШЬ ДО ТОЙ МИНУТЫ,
Dialogue: 0,0:07:04.16,0:07:06.32,Caption,,0,0,0,,ПОКА ВРЕМЕННО РАСПОРЯЖАТЬСЯ НАЧИНАЮТ ТЕМ,
Dialogue: 0,0:07:06.48,0:07:09.36,Caption,,0,0,0,,ЧТО ПРИНАДЛЕЖАЛО ТЕБЕ. ОДНОЙ ИЗ ПОСЛЕДНИХ СТАЛА
Dialogue: 0,0:07:09.36,0:07:12.56,Caption,,0,0,0,,ЯПОНСКАЯ JAPAN TOBACCO INTERNATIONAL. ПОД КОНТРОЛЬ
Dialogue: 0,0:07:12.56,0:07:15.12,Caption,,0,0,0,,РОССИЙСКОЙ СТРУКТУРЫ УХОДЯТ ДОЛИ СРАЗУ В ЧЕТЫРЁХ
Dialogue: 0,0:07:15.12,0:07:17.84,Caption,,0,0,0,,КОМПАНИЯХ. НАЗВАНИЯ ЗНАКОМЫЕ WINSTON,
Dialogue: 0,0:07:17.97,0:07:22.56,Caption,,0,0,0,,CAMEL, AMERICAN SPIRIT, BENSON AND HEDGES. ДЛЯ ПОКУПАТЕЛЯ ЭТО МАРКИ.
Dialogue: 0,0:07:24.74,0:07:29.47,Caption,,0,0,0,,ДЛЯ ВЛАДЕЛЬЦА ЭТО АКТИВЫ, УПРАВЛЕНИЕ И ДЕНЬГИ. В КОРПОРАТИВНОМ ПЛАНЕ ТАКОГО
Dialogue: 0,0:07:29.47,0:07:34.51,Caption,,0,0,0,,ВЛАДЕЛЬЦА, РАЗУМЕЕТСЯ, НЕ БЫЛО. НА АРМЯНСКОМ НАПРАВЛЕНИИ ВОПРОС ЕЩЁ ЖЁСТЧЕ.
Dialogue: 0,0:07:34.91,0:07:37.79,Caption,,0,0,0,,САМ ЛИ НИКОЛ ПАШИНЯН ПРИНИМАЕТ РЕШЕНИЕ О ВЫБРАННОМ
Dialogue: 0,0:07:37.87,0:07:40.75,Caption,,0,0,0,,МАРШРУТЕ? ЕСЛИ РУКОВОДИТЕЛЬ ВИДИТ РАСЧЁТЫ,
Dialogue: 0,0:07:40.91,0:07:45.07,Caption,,0,0,0,,СОСЕДНИЕ ПРИМЕРЫ, МНОГОЛЕТНЮЮ ОЧЕРЕДЬ И ВСЁ РАВНО ВЕДЁТ СТРАНУ ТЕМ
Dialogue: 0,0:07:45.07,0:07:48.91,Caption,,0,0,0,,ЖЕ ПУТЁМ, ВЛИЯНИЕ НА ЕГО ВЫБОР СТАНОВИТСЯ ЧАСТЬЮ ВСЕЙ ИСТОРИИ.
Dialogue: 0,0:07:49.31,0:07:51.39,Caption,,0,0,0,,ГРАЖДАНАМ ПРЕДЛАГАЮТ РИСКНУТЬ ГАЗОМ,
Dialogue: 0,0:07:51.54,0:07:54.27,Caption,,0,0,0,,ТОРГОВЛЕЙ И ДОЛЕЙ ЭКОНОМИКИ, НО СИЛА,
Dialogue: 0,0:07:54.42,0:07:56.27,Caption,,0,0,0,,ПОДТАЛКИВАЮЩАЯ К ТАКОЙ СРОЧНОСТИ,
Dialogue: 0,0:07:56.51,0:08:00.19,Caption,,0,0,0,,ОСТАЁТСЯ ЗА ЗАКРЫТОЙ ДВЕРЬЮ. РЯДОМ УКРАИНА. ЕЁ
Dialogue: 0,0:08:00.19,0:08:04.03,Caption,,0,0,0,,ПРИМЕР ПОКАЗАЛ, ЧТО СЛОВО "ЕВРОИНТЕГРАЦИЯ" НЕ ОТКРЫВАЕТ ПОТАЙНОЙ
Dialogue: 0,0:08:04.03,0:08:07.15,Caption,,0,0,0,,ЛЮК, ИЗ КОТОРОГО НЕМЕДЛЕННО ВЫЕЗЖАЮТ БЛАГОПОЛУЧИЕ,
Dialogue: 0,0:08:07.31,0:08:11.07,Caption,,0,0,0,,БЕЗОПАСНОСТЬ И ГОТОВОЕ ЧЛЕНСТВО. РЯДОМ ГРУЗИЯ. ЕЁ
Dialogue: 0,0:08:11.15,0:08:13.31,Caption,,0,0,0,,ДВИЖЕНИЕ К ЕВРОПЕ СОПРОВОЖДАЛОСЬ НАДЕЖДАМИ,
Dialogue: 0,0:08:13.55,0:08:15.55,Caption,,0,0,0,,НО ОТНОШЕНИЯ С БРЮССЕЛЕМ ИСПОРТИЛИСЬ,
Dialogue: 0,0:08:15.79,0:08:17.79,Caption,,0,0,0,,СТОРОНЫ ДОШЛИ ДО ВЗАИМНЫХ ОБВИНЕНИЙ,
Dialogue: 0,0:08:17.95,0:08:20.99,Caption,,0,0,0,,А ПРОДВИЖЕНИЕ ОСТАНОВИЛОСЬ. ПЕРЕД АРМЕНИЕЙ СТОИТ
Dialogue: 0,0:08:21.08,0:08:24.03,Caption,,0,0,0,,ОЧЕНЬ НАГЛЯДНАЯ ОЧЕРЕДЬ. ТУРЦИЯ ПОДАЛА ЗАЯВКУ В
Dialogue: 0,0:08:24.03,0:08:26.11,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ СООБЩЕСТВО В ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:08:26.11,0:08:28.99,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ СЕДЬМОМ ГОДУ. КАНДИДАТОМ СТАЛА В ТЫСЯЧА
Dialogue: 0,0:08:28.99,0:08:31.71,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО ДЕВЯТОМ. ПЕРЕГОВОРЫ НАЧАЛИСЬ В
Dialogue: 0,0:08:31.79,0:08:34.75,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ПЯТОМ. СЕЙЧАС ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ
Dialogue: 0,0:08:34.83,0:08:37.79,Caption,,0,0,0,,ГОД, А ТУРЕЦКАЯ ЗАЯВКА ВСЁ ЕЩЁ НАХОДИТСЯ В ПУТИ.
Dialogue: 0,0:08:40.06,0:08:42.38,Caption,,0,0,0,,ЗА ЭТО ВРЕМЯ ПАПКА С ТУРЕЦКОЙ ЗАЯВКОЙ УСПЕЛА
Dialogue: 0,0:08:42.38,0:08:44.38,Caption,,0,0,0,,СТАТЬ ШТАТНОЙ ЕДИНИЦЕЙ ЕВРОПЕЙСКОГО
Dialogue: 0,0:08:44.38,0:08:46.86,Caption,,0,0,0,,ДЕЛОПРОИЗВОДСТВА. ЕЙ УЖЕ НЕ НУЖЕН НОМЕР,
Dialogue: 0,0:08:47.18,0:08:49.98,Caption,,0,0,0,,ДОСТАТОЧНО ПОСТОЯННОГО МЕСТА НА СТОЛЕ. МЕНЯЮТСЯ
Dialogue: 0,0:08:49.98,0:08:52.86,Caption,,0,0,0,,СОСТАВЫ ЕВРОКОМИССИИ, А ОНА, КАК ПРЕЖДЕ,
Dialogue: 0,0:08:53.08,0:08:55.90,Caption,,0,0,0,,ОБЕСПЕЧИВАЕТ ВЕДОМСТВУ СТАБИЛЬНОСТЬ. САМ ПАШИНЯН
Dialogue: 0,0:08:55.98,0:08:58.54,Caption,,0,0,0,,ГОВОРИЛ О ВОЗМОЖНОЙ ЗАЯВКЕ НА ВСТУПЛЕНИЕ В ЕВРОСОЮЗ
Dialogue: 0,0:08:58.62,0:09:00.86,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ИЛИ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:09:00.94,0:09:03.18,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ПРИ ЭТОМ ОН ПРИЗНАЁТ,
Dialogue: 0,0:09:03.42,0:09:06.38,Caption,,0,0,0,,ЧТО ОДНОВРЕМЕННО СОСТОЯТЬ В ЕВРОСОЮЗЕ И ЕВРАЗИЙСКОМ
Dialogue: 0,0:09:06.38,0:09:09.58,Caption,,0,0,0,,ЭКОНОМИЧЕСКОМ СОЮЗЕ НЕЛЬЗЯ. УСТРОИТЬСЯ СРАЗУ В ДВА
Dialogue: 0,0:09:09.58,0:09:12.38,Caption,,0,0,0,,ЭКОНОМИЧЕСКИХ ДОМА НЕ ПОЛУЧИТСЯ. РАНО ИЛИ ПОЗДНО
Dialogue: 0,0:09:12.38,0:09:15.10,Caption,,0,0,0,,ПОПРОСЯТ ВЫБРАТЬ КВАРТИРУ, А ЗАОДНО УТОЧНЯТ,
Dialogue: 0,0:09:15.32,0:09:18.54,Caption,,0,0,0,,КТО ОПЛАЧИВАЕТ ПЕРЕЕЗД. С РАСЧЁТАМИ ПАРТНЁРОВ ОН НЕ
Dialogue: 0,0:09:18.54,0:09:21.66,Caption,,0,0,0,,СОГЛАСИЛСЯ. ЕГО ПРАВО. ЭКОНОМИСТЫ ВООБЩЕ УМЕЮТ
Dialogue: 0,0:09:21.66,0:09:25.58,Caption,,0,0,0,,СПОРИТЬ ТАК ДОЛГО, ЧТО ЗА ВРЕМЯ ДИСКУССИИ ПРОГНОЗ ИНОГДА УСПЕВАЕТ СТАТЬ
Dialogue: 0,0:09:25.58,0:09:28.22,Caption,,0,0,0,,ВОСПОМИНАНИЕМ. НО НЕСОГЛАСИЕ РУКОВОДИТЕЛЯ НЕ
Dialogue: 0,0:09:28.22,0:09:30.62,Caption,,0,0,0,,ОТМЕНЯЕТ САМ ВЫБОР. ОНО ЛИШЬ ОЗНАЧАЕТ,
Dialogue: 0,0:09:30.79,0:09:32.78,Caption,,0,0,0,,ЧТО НА СТОЛЕ ЛЕЖАТ РАЗНЫЕ ОЦЕНКИ,
Dialogue: 0,0:09:33.10,0:09:35.02,Caption,,0,0,0,,А ПЛАТИТЬ В СЛУЧАЕ ОШИБКИ БУДЕТ ОДНА И
Dialogue: 0,0:09:35.10,0:09:38.30,Caption,,0,0,0,,ТА ЖЕ СТРАНА. А САМИ РАСЧЁТЫ ПАРТНЁРОВ ПО ЕВРАЗИЙСКОМУ
Dialogue: 0,0:09:38.30,0:09:41.34,Caption,,0,0,0,,ЭКОНОМИЧЕСКОМУ СОЮЗУ ВЫГЛЯДЯТ ТАК. ПО ИХ ОЦЕНКЕ,
Dialogue: 0,0:09:41.58,0:09:44.14,Caption,,0,0,0,,ГАЗ МОЖЕТ ПОДОРОЖАТЬ ПРИМЕРНО НА ШЕСТЬДЕСЯТ ДЕВЯТЬ
Dialogue: 0,0:09:44.14,0:09:46.94,Caption,,0,0,0,,ПРОЦЕНТОВ. В ТЯЖЁЛОМ СЦЕНАРИИ ВАЛОВОЙ ВНУТРЕННИЙ
Dialogue: 0,0:09:46.94,0:09:49.34,Caption,,0,0,0,,ПРОДУКТ ТЕРЯЕТ ПЯТНАДЦАТЬ ЦЕЛЫХ ШЕСТЬ ДЕСЯТЫХ
Dialogue: 0,0:09:49.34,0:09:54.74,Caption,,0,0,0,,ПРОЦЕНТА. РУКОВОДСТВО ГОТОВО ПРИНЯТЬ ВОЗМОЖНОЕ ПОДОРОЖАНИЕ И
Dialogue: 0,0:09:54.74,0:09:57.07,Caption,,0,0,0,,ПОТЕРЮ ОГРОМНОЙ ДОЛИ ЭКОНОМИКИ СЕЙЧАС,
Dialogue: 0,0:09:57.32,0:09:59.78,Caption,,0,0,0,,А РЕЗУЛЬТАТ ПОЛУЧИТЬ БЕЗ ДАТЫ И ОБЯЗАТЕЛЬСТВ СО
Dialogue: 0,0:09:59.78,0:10:02.83,Caption,,0,0,0,,СТОРОНЫ ЕВРОСОЮЗА. НА ЭТОМ ФОНЕ ОСОБЕННО ЗАМЕТНА
Dialogue: 0,0:10:02.83,0:10:06.02,Caption,,0,0,0,,СКОРОСТЬ БЮДЖЕТНЫХ РЕШЕНИЙ. ПОД БОЛЬШУЮ ВНЕШНЮЮ ЦЕЛЬ
Dialogue: 0,0:10:06.02,0:10:08.74,Caption,,0,0,0,,ГОСУДАРСТВО УМЕЕТ ДЕЙСТВОВАТЬ РЕШИТЕЛЬНО. СТРОКУ
Dialogue: 0,0:10:08.74,0:10:12.02,Caption,,0,0,0,,НАХОДЯТ, ДЕНЬГИ ПОЛУЧАЮТ МАРШРУТ. ПЕРЕД ЧЕЛОВЕКОМ,
Dialogue: 0,0:10:12.12,0:10:16.10,Caption,,0,0,0,,СЧИТАЮЩИМ СТОИМОСТЬ ТЕПЛА, ОНО НЕОЖИДАННО ВСПОМИНАЕТ ВСЕ ПРИЧИНЫ,
Dialogue: 0,0:10:16.34,0:10:18.74,Caption,,0,0,0,,ПО КОТОРЫМ РЕШИТЕЛЬНОСТЬ СЕГОДНЯ НЕ ПРЕДУСМОТРЕНА.
Dialogue: 0,0:10:19.14,0:10:21.95,Caption,,0,0,0,,ИМЕННО ТАКОЙ ПОРЯДОК И РАЗДРАЖАЕТ ВНЕШНЕЙ ПРОГРАММЕ
Dialogue: 0,0:10:22.02,0:10:26.66,Caption,,0,0,0,,ДОСТАЁТСЯ БЫСТРЫЙ ОТВЕТ, ВНУТРЕННЕЙ НУЖДЕ ДОСТАЁТСЯ ДЛИННЫЙ КОММЕНТАРИЙ. ДЛЯ
Dialogue: 0,0:10:26.66,0:10:28.66,Caption,,0,0,0,,БОЛЬШОЙ ЦЕЛИ ОТКРЫТ ЛЮБОЙ КАБИНЕТ,
Dialogue: 0,0:10:28.98,0:10:31.71,Caption,,0,0,0,,ДЛЯ ОБЫЧНОЙ ПРОСЬБЫ КАЖДЫЙ КАБИНЕТ ВНЕЗАПНО ЗАНЯТ
Dialogue: 0,0:10:31.71,0:10:34.42,Caption,,0,0,0,,ДРУГОЙ ВАЖНОЙ РАБОТОЙ И ПРЕДЛАГАЕТ СВОЙ НОВЫЙ
Dialogue: 0,0:10:34.42,0:10:37.22,Caption,,0,0,0,,КРАЙНИЙ СРОК. КОНЕЧНО, РЕЧЬ НЕ О ТОМ,
Dialogue: 0,0:10:37.38,0:10:39.54,Caption,,0,0,0,,ЧТОБЫ СЛОЖИТЬ ВСЮ СУММУ В КОНВЕРТЫ И РАЗДАТЬ
Dialogue: 0,0:10:39.62,0:10:42.90,Caption,,0,0,0,,ЖИТЕЛЯМ ГЕРМАНИИ. БЮДЖЕТ УСТРОЕН ИНАЧЕ. НО ЕГО
Dialogue: 0,0:10:42.90,0:10:45.54,Caption,,0,0,0,,УСТРОЙСТВО УДИВИТЕЛЬНЫМ ОБРАЗОМ СТАНОВИТСЯ ПРОСТЫМ,
Dialogue: 0,0:10:45.86,0:10:49.07,Caption,,0,0,0,,КОГДА ОПРЕДЕЛЕНА БОЛЬШАЯ ВНЕШНЯЯ ЦЕЛЬ. ДЕНЬГИ ТОГДА
Dialogue: 0,0:10:49.14,0:10:51.54,Caption,,0,0,0,,НЕ СПРАШИВАЮТ, СЛОЖНЫЕ ЛИ СЕЙЧАС ВРЕМЕНА,
Dialogue: 0,0:10:51.83,0:10:54.02,Caption,,0,0,0,,И НЕ ТРЕБУЮТ ОТ ЧИНОВНИКА СНАЧАЛА ДОКАЗАТЬ
Dialogue: 0,0:10:54.10,0:10:55.94,Caption,,0,0,0,,НРАВСТВЕННУЮ БЕЗУПРЕЧНОСТЬ ПОЛУЧАТЕЛЯ.
Dialogue: 0,0:10:56.67,0:10:59.30,Caption,,0,0,0,,ОБЩИЙ ОБЪЁМ НЕМЕЦКОЙ ПОМОЩИ С НАЧАЛА КОНФЛИКТА,
Dialogue: 0,0:10:59.47,0:11:03.06,Caption,,0,0,0,,ПО ПРИВЕДЁННОЙ ОЦЕНКЕ, СОСТАВЛЯЕТ ОКОЛО СТА МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:11:05.35,0:11:09.59,Caption,,0,0,0,,СТО МИЛЛИАРДОВ ЭТО СУММА, КОТОРУЮ ОБЫЧНОМУ ЧЕЛОВЕКУ НЕ ПОТРАТИТЬ И ЗА СТО
Dialogue: 0,0:11:09.67,0:11:12.87,Caption,,0,0,0,,ЖИЗНЕЙ ПОДРЯД. МАСШТАБ ПОЛЕЗНО ПРОИЗНЕСТИ ПОЛНОСТЬЮ,
Dialogue: 0,0:11:13.11,0:11:15.19,Caption,,0,0,0,,ПОТОМУ ЧТО БОЛЬШОЕ ЧИСЛО ЛЕГКО СПРЯТАТЬ ЗА
Dialogue: 0,0:11:15.19,0:11:17.99,Caption,,0,0,0,,АККУРАТНЫМ ВЕДОМСТВЕННЫМ СЛОВОМ. ЕЩЁ ДВЕСТИ
Dialogue: 0,0:11:17.99,0:11:21.03,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО ГЕРМАНИЯ ОТДЕЛЬНО ДАЁТ НА УКРАИНСКУЮ
Dialogue: 0,0:11:21.03,0:11:23.99,Caption,,0,0,0,,ЭНЕРГЕТИКУ. ИМЕННО ЭТА СУММА ПРОЗВУЧАЛА В ВОПРОСЕ
Dialogue: 0,0:11:23.99,0:11:26.79,Caption,,0,0,0,,ФРОНМАЙЕРА. ОНА НЕ ИСЧЕРПЫВАЕТ ВСЕЙ ПОМОЩИ,
Dialogue: 0,0:11:27.11,0:11:31.35,Caption,,0,0,0,,ЗАТО ОЧЕНЬ ТОЧНО ПОКАЗЫВАЕТ, КАК БЫСТРО ПОЯВЛЯЕТСЯ ОТДЕЛЬНАЯ СТРОКА,
Dialogue: 0,0:11:31.59,0:11:33.59,Caption,,0,0,0,,КОГДА КАБИНЕТ УЖЕ ОПРЕДЕЛИЛ НАПРАВЛЕНИЕ.
Dialogue: 0,0:11:34.31,0:11:36.87,Caption,,0,0,0,,ПОСЛЕДНИМ В ЭТОЙ ЦЕПОЧКЕ СТОИТ ПАКЕТ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:11:36.87,0:11:39.51,Caption,,0,0,0,,КОМИССИИ НА ЧЕТЫРЕ МИЛЛИАРДА ТРИСТА ШЕСТЬДЕСЯТ
Dialogue: 0,0:11:39.59,0:11:42.79,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО. СЛОВО "ПАКЕТ" УМЕЕТ ДЕЛАТЬ МИЛЛИАРДЫ
Dialogue: 0,0:11:42.87,0:11:45.75,Caption,,0,0,0,,МАЛЕНЬКИМИ И АККУРАТНЫМИ. ПАКЕТ МОЖНО ПОСТАВИТЬ У
Dialogue: 0,0:11:45.83,0:11:48.63,Caption,,0,0,0,,ДВЕРИ. ЧЕТЫРЕ МИЛЛИАРДА ТУДА НЕ ПОМЕСТЯТСЯ,
Dialogue: 0,0:11:48.87,0:11:51.99,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ЧИНОВНИК ОЧЕНЬ УВЕРЕННО ПРИЖМЁТ КРЫШКУ. ЗА
Dialogue: 0,0:11:51.99,0:11:54.95,Caption,,0,0,0,,ЭТИМИ СУММАМИ НАХОДИТСЯ ОБЫЧНЫЙ БЫТ. МОЛОДЫМ ВСЁ
Dialogue: 0,0:11:54.95,0:11:56.95,Caption,,0,0,0,,ТРУДНЕЕ ПРИОБРЕСТИ СОБСТВЕННОЕ ЖИЛЬЁ,
Dialogue: 0,0:11:57.27,0:11:59.59,Caption,,0,0,0,,ДЕСЯТКИ МИЛЛИОНОВ ЛЮДЕЙ СЧИТАЮТ РАСХОДЫ НА
Dialogue: 0,0:11:59.59,0:12:02.07,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО, ОТОПЛЕНИЕ И ПРОДУКТЫ,
Dialogue: 0,0:12:02.39,0:12:04.23,Caption,,0,0,0,,А В ДОМАШНЕМ БЮДЖЕТЕ НЕТ ОТДЕЛА,
Dialogue: 0,0:12:04.41,0:12:07.43,Caption,,0,0,0,,КОТОРЫЙ УМЕЕТ НАПЕЧАТАТЬ НОВОЕ ОБОСНОВАНИЕ. ЕСЛИ
Dialogue: 0,0:12:07.43,0:12:11.59,Caption,,0,0,0,,СУММА НЕ СХОДИТСЯ, ЧЕЛОВЕК ПРОСТО ОТКАЗЫВАЕТСЯ ОТ ПОКУПКИ ИЛИ УМЕНЬШАЕТ
Dialogue: 0,0:12:11.59,0:12:14.98,Caption,,0,0,0,,ТЕПЛО. ПОДПИШИТЕСЬ,
Dialogue: 0,0:12:15.14,0:12:16.90,Caption,,0,0,0,,ЧТОБЫ ВМЕСТЕ РАЗБИРАТЬ РЕШЕНИЯ,
Dialogue: 0,0:12:17.14,0:12:19.94,Caption,,0,0,0,,ПОСЛЕ КОТОРЫХ ЧИНОВНИКИ ПОКАЗЫВАЮТ СВЕТЛОЕ БУДУЩЕЕ,
Dialogue: 0,0:12:20.26,0:12:22.90,Caption,,0,0,0,,А ГРАЖДАНИНУ ОСТАВЛЯЮТ КАЛЬКУЛЯТОР И ПРОСЬБУ НЕ
Dialogue: 0,0:12:22.90,0:12:26.10,Caption,,0,0,0,,ЗАДАВАТЬ ЛИШНИХ ВОПРОСОВ. ТЕПЕРЬ ВСЕ ЧАСТИ СХОДЯТСЯ
Dialogue: 0,0:12:26.18,0:12:29.14,Caption,,0,0,0,,БЕЗ ДОПОЛНИТЕЛЬНЫХ УКРАШЕНИЙ. ЦЕНА ВЫБРАННОГО КУРСА
Dialogue: 0,0:12:29.14,0:12:31.46,Caption,,0,0,0,,РАСТЁТ, НЕДОВОЛЬНЫХ СТАНОВИТСЯ БОЛЬШЕ,
Dialogue: 0,0:12:31.79,0:12:35.22,Caption,,0,0,0,,РЕЙТИНГИ ВЛАСТИ ПАДАЮТ, СОЦИАЛЬНЫЕ РАСХОДЫ СОКРАЩАЮТ,
Dialogue: 0,0:12:35.47,0:12:38.10,Caption,,0,0,0,,ИНОСТРАННЫЙ БИЗНЕС ТЕРЯЕТ КОНТРОЛЬ НАД АКТИВАМИ,
Dialogue: 0,0:12:38.33,0:12:41.54,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЕ ПРЕДУПРЕЖДЕНИЯ ЗВУЧАТ ГРОМЧЕ. ПРИ ЭТОМ
Dialogue: 0,0:12:41.54,0:12:44.58,Caption,,0,0,0,,НАПРАВЛЕНИЕ НЕ МЕНЯЕТСЯ. В ГЕРМАНИИ ВОСЕМЬДЕСЯТ ДВА
Dialogue: 0,0:12:44.58,0:12:46.90,Caption,,0,0,0,,ПРОЦЕНТА НЕДОВОЛЬНЫХ НЕ ЗАСТАВЛЯЮТ КАНЦЛЕРА
Dialogue: 0,0:12:46.90,0:12:50.02,Caption,,0,0,0,,ПЕРЕСМОТРЕТЬ КУРС. ПЕРВОЕ МЕСТО АДГ В ОПРОСЕ НЕ
Dialogue: 0,0:12:50.02,0:12:53.14,Caption,,0,0,0,,ДАЁТ ПАРТИИ ПУТИ К ВЛАСТИ. В АРМЕНИИ РАСЧЁТЫ
Dialogue: 0,0:12:53.14,0:12:56.18,Caption,,0,0,0,,ОБЕЩАЮТ РЕЗКОЕ ПОДОРОЖАНИЕ ГАЗА И ТЯЖЁЛУЮ ПОТЕРЮ ДЛЯ
Dialogue: 0,0:12:56.18,0:12:59.94,Caption,,0,0,0,,ЭКОНОМИКИ, НО ДВИЖЕНИЕ ПРОДОЛЖАЕТСЯ. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА
Dialogue: 0,0:12:59.94,0:13:02.90,Caption,,0,0,0,,НАХОДЯТ МИЛЛИАРДЫ ДЛЯ ВНЕШНИХ ЗАДАЧ И ОДНОВРЕМЕННО
Dialogue: 0,0:13:02.90,0:13:05.78,Caption,,0,0,0,,ИЩУТ ЭКОНОМИЮ В ПЕНСИЯХ. КОМПАНИИ УЗНАЮТ,
Dialogue: 0,0:13:05.94,0:13:07.86,Caption,,0,0,0,,ЧТО РЕШЕНИЯ ГОСУДАРСТВ ДОБРАЛИСЬ ДО ИХ
Dialogue: 0,0:13:07.86,0:13:11.30,Caption,,0,0,0,,СОБСТВЕННОСТИ. САМОЕ ВАЖНОЕ ЗДЕСЬ НЕ ОТДЕЛЬНАЯ СУММА
Dialogue: 0,0:13:11.40,0:13:14.66,Caption,,0,0,0,,И НЕ ОТДЕЛЬНАЯ ФАМИЛИЯ. ВЛАСТЬ ВСЁ ЧАЩЕ ОБРАЩАЕТСЯ
Dialogue: 0,0:13:14.74,0:13:17.14,Caption,,0,0,0,,С ПОСЛЕДСТВИЯМИ КАК С ДОКАЗАТЕЛЬСТВОМ СОБСТВЕННОЙ
Dialogue: 0,0:13:17.14,0:13:19.54,Caption,,0,0,0,,ПРАВОТЫ. СТАЛО ДОРОЖЕ, ЗНАЧИТ,
Dialogue: 0,0:13:19.75,0:13:22.34,Caption,,0,0,0,,НЕЛЬЗЯ ОСТАНАВЛИВАТЬСЯ. НЕДОВОЛЬНЫХ БОЛЬШЕ,
Dialogue: 0,0:13:22.42,0:13:25.78,Caption,,0,0,0,,ЗНАЧИТ, ИМ НАДО ЛУЧШЕ ОБЪЯСНИТЬ. РЕЙТИНГ УПАЛ,
Dialogue: 0,0:13:25.86,0:13:32.79,Caption,,0,0,0,,ЗНАЧИТ, РЕШЕНИЯ БЫЛИ СМЕЛЫМИ. ПРИ ТАКОЙ ЛОГИКЕ ОШИБКА ВООБЩЕ НЕВОЗМОЖНА. ЛЮБОЙ
Dialogue: 0,0:13:32.79,0:13:35.27,Caption,,0,0,0,,РЕЗУЛЬТАТ ПРЕВРАЩАЮТ В РАСПОРЯЖЕНИЕ ПРОДОЛЖАТЬ.
Dialogue: 0,0:13:35.59,0:13:38.47,Caption,,0,0,0,,ТОГДА ВОПРОС "ЗА КОГО ГОЛОСОВАТЬ" ТЕРЯЕТ СМЫСЛ. НА
Dialogue: 0,0:13:38.47,0:13:41.11,Caption,,0,0,0,,ЕГО МЕСТЕ ПОЯВЛЯЕТСЯ ДРУГОЙ СПОСОБЕН ЛИ МОЙ ГОЛОС
Dialogue: 0,0:13:41.11,0:13:44.87,Caption,,0,0,0,,ИЗМЕНИТЬ ХОТЬ ЧТО ЛИБО, КРОМЕ СОСТАВА ФОТОГРАФИИ ПОСЛЕ ВЫБОРОВ?
Dialogue: 0,0:13:45.27,0:13:48.87,Caption,,0,0,0,,ЧЕЛОВЕК ПРИХОДИТ, ВЫБИРАЕТ, ЖДЁТ РЕЗУЛЬТАТА И ВИДИТ,
Dialogue: 0,0:13:49.11,0:13:51.59,Caption,,0,0,0,,КАК ЕГО РЕШЕНИЕ ПЕРЕВОДЯТ В РЕЖИМ ОЗНАКОМЛЕНИЯ.
Dialogue: 0,0:13:51.81,0:13:54.39,Caption,,0,0,0,,МНЕНИЕ ЗАРЕГИСТРИРОВАНО. ВЛИЯНИЕ ВРЕМЕННО
Dialogue: 0,0:13:54.39,0:13:57.59,Caption,,0,0,0,,НЕДОСТУПНО. БЛАГОДАРИМ ЗА ТЕРПЕНИЕ. МЕРЦ УЙДЁТ.
Dialogue: 0,0:13:57.90,0:14:00.95,Caption,,0,0,0,,ПАШИНЯН УЙДЁТ. УРСУЛА ФОН ДЕР ЛЯЙЕН ТОЖЕ ОДНАЖДЫ
Dialogue: 0,0:14:00.95,0:14:03.59,Caption,,0,0,0,,ОСВОБОДИТ КАБИНЕТ. НА ДВЕРЯХ ПОЯВЯТСЯ ДРУГИЕ
Dialogue: 0,0:14:03.59,0:14:06.47,Caption,,0,0,0,,ФАМИЛИИ, ПОМОЩНИКИ РАЗЛОЖАТ НОВЫЕ ДОКУМЕНТЫ,
Dialogue: 0,0:14:06.72,0:14:09.67,Caption,,0,0,0,,ПРЕСС СЛУЖБЫ НАПИШУТ О НАЧАЛЕ НОВОГО ЭТАПА. ВСЁ
Dialogue: 0,0:14:09.67,0:14:12.39,Caption,,0,0,0,,ЭТО СДЕЛАТЬ НЕСЛОЖНО. ТАБЛИЧКА ДЕРЖИТСЯ НА ДВУХ
Dialogue: 0,0:14:12.39,0:14:15.43,Caption,,0,0,0,,ВИНТАХ. С ДОВЕРИЕМ ТАК НЕ ПОЛУЧИТСЯ. ЕГО НЕЛЬЗЯ
Dialogue: 0,0:14:15.43,0:14:19.51,Caption,,0,0,0,,ВЕРНУТЬ НАЗНАЧЕНИЕМ, КОАЛИЦИОННЫМ СОГЛАШЕНИЕМ ИЛИ ТОРЖЕСТВЕННОЙ РЕЧЬЮ.
Dialogue: 0,0:14:19.91,0:14:23.35,Caption,,0,0,0,,ЕСЛИ ЧЕЛОВЕК РЕШИЛ, ЧТО РЕЗУЛЬТАТ ВЫБОРОВ ПРИЗНАЮТ ЛИШЬ ТОГДА,
Dialogue: 0,0:14:23.67,0:14:28.07,Caption,,0,0,0,,КОГДА ОН УДОБЕН ВЛАСТИ, КАЖДОЕ СЛЕДУЮЩЕЕ ГОЛОСОВАНИЕ ВЫГЛЯДИТ НЕ КАК ПРАВО,
Dialogue: 0,0:14:28.31,0:14:30.15,Caption,,0,0,0,,А КАК ПРОСЬБА. ПРИЧЁМ ПРОСЬБА,
Dialogue: 0,0:14:30.39,0:14:33.67,Caption,,0,0,0,,КОТОРУЮ РАЗРЕШЕНО ОСТАВИТЬ БЕЗ УДОВЛЕТВОРЕНИЯ. КУРС,
Dialogue: 0,0:14:33.84,0:14:38.47,Caption,,0,0,0,,КОТОРЫЙ НЕ РЕАГИРУЕТ НА ЦЕНУ, РАНО ИЛИ ПОЗДНО НАЧИНАЕТ РАЗРУШАТЬ САМ ИСТОЧНИК
Dialogue: 0,0:14:38.47,0:14:43.31,Caption,,0,0,0,,ЗАКОННОСТИ. ВЛАСТЬ МОЖЕТ ВЫДЕРЖАТЬ ПЛОХОЙ ОПРОС,
Dialogue: 0,0:14:43.55,0:14:46.59,Caption,,0,0,0,,СПОР О РАСХОДАХ И НЕДОВОЛЬСТВО ПЕНСИОНЕРОВ. НО ЕЙ
Dialogue: 0,0:14:46.59,0:14:48.75,Caption,,0,0,0,,ГОРАЗДО ТРУДНЕЕ СУЩЕСТВОВАТЬ В ОБЩЕСТВЕ,
Dialogue: 0,0:14:49.07,0:14:50.91,Caption,,0,0,0,,ГДЕ УЧАСТИЕ СЧИТАЮТ БЕССМЫСЛЕННЫМ.
Dialogue: 0,0:14:51.47,0:14:54.35,Caption,,0,0,0,,ЧЕЛОВЕК БЕЗ ДОВЕРИЯ УЖЕ НЕ ЖДЁТ СЛЕДУЮЩЕГО ОБЕЩАНИЯ.
Dialogue: 0,0:14:54.67,0:14:58.27,Caption,,0,0,0,,ОН ЗАРАНЕЕ ИЩЕТ, ГДЕ ИМЕННО В НЁМ СПРЯТАНО УСЛОВИЕ,
Dialogue: 0,0:14:58.51,0:15:01.23,Caption,,0,0,0,,О КОТОРОМ ЗАБЫЛИ СКАЗАТЬ. ПОЭТОМУ ГЛАВНЫЙ ИТОГ
Dialogue: 0,0:15:01.23,0:15:04.43,Caption,,0,0,0,,ИЗМЕРЯЕТСЯ НЕ МИЛЛИАРДАМИ И НЕ ПРОЦЕНТАМИ. ДЕНЬГИ
Dialogue: 0,0:15:04.43,0:15:07.55,Caption,,0,0,0,,МОЖНО ЗАРАБОТАТЬ СНОВА, АКТИВЫ ИНОГДА ВОЗВРАЩАЮТ,
Dialogue: 0,0:15:07.79,0:15:11.31,Caption,,0,0,0,,ПРАВИЛА ИНДЕКСАЦИИ МЕНЯЮТ ЕЩЁ РАЗ. ПОТЕРЯННАЯ ВЕРА В
Dialogue: 0,0:15:11.31,0:15:13.55,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ВЛИЯТЬ ВОССТАНАВЛИВАЕТСЯ НАМНОГО
Dialogue: 0,0:15:13.55,0:15:16.19,Caption,,0,0,0,,МЕДЛЕННЕЕ. ДЛЯ НЕЁ НЕТ СРОЧНОГО ПАКЕТА,
Dialogue: 0,0:15:16.43,0:15:18.67,Caption,,0,0,0,,ОТДЕЛЬНОЙ СТРОКИ БЮДЖЕТА И СПЕЦИАЛИСТА,
Dialogue: 0,0:15:18.91,0:15:21.15,Caption,,0,0,0,,КОТОРЫЙ ИСПРАВИТ ВСЁ БОДРОЙ ПРЕЗЕНТАЦИЕЙ.
Dialogue: 0,0:15:21.62,0:15:24.75,Caption,,0,0,0,,СЕГОДНЯШНЯЯ ЦЕНА ВОЗНИКЛА НЕ ИЗ ОДНОГО РЕШЕНИЯ. ЕЁ
Dialogue: 0,0:15:24.75,0:15:28.43,Caption,,0,0,0,,НАКОПИЛ ПОРЯДОК, ПРИ КОТОРОМ МНЕНИЕ ГРАЖДАНИНА ОХОТНО ПРИНИМАЮТ К
Dialogue: 0,0:15:28.43,0:15:32.35,Caption,,0,0,0,,СВЕДЕНИЮ, НО РЕДКО ПРИНИМАЮТ К ИСПОЛНЕНИЮ. ВЛАСТЬ ОСТАВЛЯЕТ ЗА
Dialogue: 0,0:15:32.43,0:15:36.11,Caption,,0,0,0,,СОБОЙ ПРАВО ВЫБИРАТЬ КУРС, СКОРОСТЬ И ПРЕДЕЛ ДОПУСТИМЫХ ПОТЕРЬ,
Dialogue: 0,0:15:36.49,0:15:39.07,Caption,,0,0,0,,А ОБЩЕСТВУ ВЫДАЁТ РОЛЬ ПЛАТЕЛЬЩИКА С СОВЕЩАТЕЛЬНЫМ
Dialogue: 0,0:15:39.07,0:15:42.03,Caption,,0,0,0,,ГОЛОСОМ. И КОГДА ЭТОТ ПЛАТЕЛЬЩИК НАКОНЕЦ ПОНИМАЕТ
Dialogue: 0,0:15:42.11,0:15:43.95,Caption,,0,0,0,,ПРАВИЛА, ЕМУ УЖЕ НЕ ТАК ВАЖНО,
Dialogue: 0,0:15:44.11,0:15:45.79,Caption,,0,0,0,,ЧЬЯ ФАМИЛИЯ ВИСИТ НА КАБИНЕТЕ.
Dialogue: 0,0:15:48.07,0:15:50.40,Caption,,0,0,0,,ОН СМОТРИТ НА САМ МЕХАНИЗМ И ЗАДАЁТ САМЫЙ
Dialogue: 0,0:15:50.40,0:15:53.12,Caption,,0,0,0,,НЕУДОБНЫЙ ВОПРОС ЗАЧЕМ МЕНЯТЬ УПРАВЛЯЮЩЕГО,
Dialogue: 0,0:15:53.44,0:15:55.68,Caption,,0,0,0,,ЕСЛИ УПРАВЛЕНИЕ НЕ СОБИРАЕТСЯ СЛЫШАТЬ ТЕХ,
Dialogue: 0,0:15:55.92,0:16:00.80,Caption,,0,0,0,,ОТ ЧЬЕГО ИМЕНИ ОНО ДЕЙСТВУЕТ? ВОТ ЭТОТ ВОПРОС И СТАНОВИТСЯ НАСТОЯЩЕЙ ЦЕНОЙ. НЕ
Dialogue: 0,0:16:00.80,0:16:05.04,Caption,,0,0,0,,ОЧЕРЕДНАЯ КВИТАНЦИЯ, НЕ ОДИН ПРОВАЛЕННЫЙ РЕЙТИНГ И НЕ ОДИН УТРАЧЕННЫЙ
Dialogue: 0,0:16:05.04,0:16:08.32,Caption,,0,0,0,,АКТИВ. САМАЯ ТЯЖЁЛАЯ ПОТЕРЯ НАЧИНАЕТСЯ ТОГДА,
Dialogue: 0,0:16:08.56,0:16:10.88,Caption,,0,0,0,,КОГДА ВЛАСТЬ ЕЩЁ ГОВОРИТ ОТ ИМЕНИ НАРОДА,
Dialogue: 0,0:16:11.11,0:16:13.04,Caption,,0,0,0,,А НАРОД УЖЕ НЕ УЗНАЁТ В ЭТОМ ГОЛОСЕ
Dialogue: 0,0:16:13.04,0:16:13.44,Caption,,0,0,0,,СЕБЯ.
