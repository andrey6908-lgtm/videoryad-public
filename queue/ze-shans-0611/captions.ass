Dialogue: 0,0:00:00.12,0:00:04.44,Caption,,0,0,0,,КОГДА ТЕБЕ ПОМОГАЮТ, СЛОВО "ВЛИЯНИЕ" ПОЧЕМУ ТО ЗВУЧИТ НЕ ОЧЕНЬ КРАСИВО.
Dialogue: 0,0:00:04.66,0:00:07.40,Caption,,0,0,0,,ЛУЧШЕ ГОВОРИТЬ "ПОДДЕРЖКА", "ПАРТНЁРСТВО",
Dialogue: 0,0:00:07.41,0:00:10.68,Caption,,0,0,0,,"СОТРУДНИЧЕСТВО". НО ЕСТЬ ОДИН МАЛЕНЬКИЙ ФОКУС.
Dialogue: 0,0:00:10.92,0:00:12.92,Caption,,0,0,0,,ИНОГДА МЕНЯЕТСЯ ВСЕГО ОДНО РЕШЕНИЕ,
Dialogue: 0,0:00:13.24,0:00:17.40,Caption,,0,0,0,,И СРАЗУ СТАНОВИТСЯ ПОНЯТНО, КТО НА КОГО НА САМОМ ДЕЛЕ СПОСОБЕН ВЛИЯТЬ.
Dialogue: 0,0:00:17.85,0:00:20.84,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. СЕГОДНЯ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:21.08,0:00:23.64,Caption,,0,0,0,,КОГДА ПОЛЕЗНО НЕ СЛУШАТЬ КАЖДОЕ ЗАЯВЛЕНИЕ ОТДЕЛЬНО,
Dialogue: 0,0:00:23.96,0:00:26.68,Caption,,0,0,0,,А ПОСТАВИТЬ ИХ РЯДОМ. ТАМ СРАЗУ НАЧИНАЮТ ВЫЛЕЗАТЬ
Dialogue: 0,0:00:26.74,0:00:29.40,Caption,,0,0,0,,ОЧЕНЬ ИНТЕРЕСНЫЕ ВОПРОСЫ. ЗЕЛЕНСКИЙ В ИНТЕРВЬЮ
Dialogue: 0,0:00:29.40,0:00:32.04,Caption,,0,0,0,,НЕМЕЦКОМУ ТЕЛЕВИДЕНИЮ ЗАГОВОРИЛ О ПОЛИТИКЕ США.
Dialogue: 0,0:00:32.78,0:00:35.80,Caption,,0,0,0,,РЕСПУБЛИКАНЦАМ СПАСИБО. НО ДЕМОКРАТЫ,
Dialogue: 0,0:00:35.93,0:00:40.20,Caption,,0,0,0,,ГОВОРИТ ОН, ГОРАЗДО ЧЁТЧЕ ВЫСТУПАЮТ ЗА ПОМОЩЬ УКРАИНЕ. ЛОГИКА
Dialogue: 0,0:00:40.20,0:00:43.08,Caption,,0,0,0,,ПОНЯТНАЯ. ЕСЛИ ДЕМОКРАТЫ СИЛЬНЕЕ В КОНГРЕССЕ,
Dialogue: 0,0:00:43.44,0:00:45.16,Caption,,0,0,0,,КИЕВ РАССЧИТЫВАЕТ НА БОЛЬШЕ ДЕНЕГ,
Dialogue: 0,0:00:45.32,0:00:48.28,Caption,,0,0,0,,БОЛЬШЕ ОРУЖИЯ И БОЛЕЕ ЖЁСТКОЕ ДАВЛЕНИЕ НА РОССИЮ.
Dialogue: 0,0:00:48.57,0:00:51.40,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРЯМО СВЯЗЫВАЕТ УСИЛЕНИЕ ДЕМОКРАТОВ С
Dialogue: 0,0:00:51.40,0:00:54.44,Caption,,0,0,0,,НАДЕЖДОЙ НА НОВУЮ АМЕРИКАНСКУЮ ПОДДЕРЖКУ. И ЗДЕСЬ
Dialogue: 0,0:00:54.44,0:00:57.48,Caption,,0,0,0,,СРАЗУ ПЕРВАЯ СТРАННОСТЬ. ПРЕЗИДЕНТ США ДОНАЛЬД ТРАМП
Dialogue: 0,0:00:57.69,0:01:00.36,Caption,,0,0,0,,НИКУДА НЕ ДЕЛСЯ. ТО ЕСТЬ С ТРАМПОМ КИЕВУ
Dialogue: 0,0:01:00.36,0:01:02.60,Caption,,0,0,0,,НАДО РАЗГОВАРИВАТЬ, ДОГОВАРИВАТЬСЯ,
Dialogue: 0,0:01:02.76,0:01:07.08,Caption,,0,0,0,,ЧТО ТО ПРОСИТЬ, ЧТО ТО ОБЪЯСНЯТЬ. НО ПОЛИТИЧЕСКИЕ НАДЕЖДЫ УЖЕ КЛАДУТ
Dialogue: 0,0:01:07.08,0:01:10.44,Caption,,0,0,0,,В ДРУГУЮ КОРЗИНУ. НА ДЕМОКРАТОВ. ХОРОШАЯ СЕМЕЙНАЯ
Dialogue: 0,0:01:10.44,0:01:13.32,Caption,,0,0,0,,ЖИЗНЬ ПОЛУЧАЕТСЯ. С ОДНИМ ЖИВЁМ. НА ДРУГОГО
Dialogue: 0,0:01:13.32,0:01:18.32,Caption,,0,0,0,,НАДЕЕМСЯ. ПРИЧЁМ В ТОМ ЖЕ РАЗГОВОРЕ ЗЕЛЕНСКИЙ НАЧИНАЕТ
Dialogue: 0,0:01:18.32,0:01:21.68,Caption,,0,0,0,,ОБЪЯСНЯТЬ, КТО ВООБЩЕ ИМЕЕТ ПРАВО ВЛИЯТЬ НА УКРАИНСКУЮ
Dialogue: 0,0:01:21.68,0:01:24.48,Caption,,0,0,0,,ПОЛИТИКУ. И ВОТ ТУТ НА СЦЕНУ ВЫХОДИТ ИЛОН
Dialogue: 0,0:01:24.48,0:01:29.60,Caption,,0,0,0,,МАСК. ЗЕЛЕНСКИЙ ГОВОРИТ, ЧТО МАСК ГРАЖДАНИН ДРУГОГО ГОСУДАРСТВА И НЕ ДОЛЖЕН
Dialogue: 0,0:01:29.60,0:01:33.52,Caption,,0,0,0,,ВЛИЯТЬ НА ТО, КТО БУДЕТ У ВЛАСТИ НА УКРАИНЕ. ЗВУЧИТ КРАСИВО.
Dialogue: 0,0:01:33.89,0:01:36.96,Caption,,0,0,0,,УКРАИНА САМА ДОЛЖНА ВЫБИРАТЬ СЕБЕ ВЛАСТЬ. СПОРИТЬ С
Dialogue: 0,0:01:37.04,0:01:39.12,Caption,,0,0,0,,ЭТИМ ПРИНЦИПОМ ТРУДНО. НО ТОГДА ДАВАЙТЕ НЕ
Dialogue: 0,0:01:39.12,0:01:42.24,Caption,,0,0,0,,ОСТАНАВЛИВАТЬСЯ НА ПОЛПУТИ. ИНОСТРАННОМУ МИЛЛИАРДЕРУ
Dialogue: 0,0:01:42.24,0:01:45.28,Caption,,0,0,0,,ВЛИЯТЬ НА УКРАИНСКУЮ ВЛАСТЬ НЕЛЬЗЯ. А ИНОСТРАННЫМ
Dialogue: 0,0:01:45.28,0:01:48.24,Caption,,0,0,0,,ПОЛИТИКАМ МОЖНО? АМЕРИКАНСКИМ СЕНАТОРАМ МОЖНО?
Dialogue: 0,0:01:48.56,0:01:51.04,Caption,,0,0,0,,ЕВРОПЕЙСКИМ ЛИДЕРАМ МОЖНО? ПРАВИТЕЛЬСТВАМ,
Dialogue: 0,0:01:51.28,0:01:53.36,Caption,,0,0,0,,КОТОРЫЕ ДАЮТ КИЕВУ МИЛЛИАРДЫ, МОЖНО?
Dialogue: 0,0:01:53.59,0:01:56.88,Caption,,0,0,0,,КОНГРЕССУ США МОЖНО? А ЕСЛИ НЕЛЬЗЯ НИКОМУ,
Dialogue: 0,0:01:57.12,0:01:59.92,Caption,,0,0,0,,ТОГДА ЗАЧЕМ УКРАИНСКИЙ ПРЕЗИДЕНТ САМ РАССУЖДАЕТ О
Dialogue: 0,0:01:59.92,0:02:02.88,Caption,,0,0,0,,ТОМ, КАК ИЗМЕНЕНИЕ АМЕРИКАНСКОГО КОНГРЕССА ДОЛЖНО
Dialogue: 0,0:02:02.88,0:02:07.36,Caption,,0,0,0,,ИЗМЕНИТЬ ПОЛОЖЕНИЕ УКРАИНЫ? ВОТ ЗДЕСЬ НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ. ПОТОМУ ЧТО
Dialogue: 0,0:02:07.36,0:02:09.28,Caption,,0,0,0,,ВЛИЯНИЕ ЭТО НЕ ОБЯЗАТЕЛЬНО ЧЕЛОВЕК,
Dialogue: 0,0:02:09.50,0:02:11.84,Caption,,0,0,0,,КОТОРЫЙ ЗВОНИТ И ГОВОРИТ ДЕЛАЙ ВОТ ТАК. ТАК
Dialogue: 0,0:02:11.84,0:02:14.56,Caption,,0,0,0,,БЫВАЕТ В ПЛОХИХ ФИЛЬМАХ. В РЕАЛЬНОЙ ПОЛИТИКЕ ВСЁ
Dialogue: 0,0:02:14.64,0:02:17.60,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО ПРОЩЕ. ЕСТЬ ДЕНЬГИ. ЕСТЬ ВООРУЖЕНИЯ.
Dialogue: 0,0:02:17.85,0:02:21.36,Caption,,0,0,0,,ЕСТЬ СВЯЗЬ. ЕСТЬ РЕШЕНИЕ ПРОДЛИТЬ КОНТРАКТ. ЕСТЬ
Dialogue: 0,0:02:21.36,0:02:25.20,Caption,,0,0,0,,РЕШЕНИЕ НЕ ПРОДЛЕВАТЬ. ЕСТЬ РАЗРЕШЕНИЕ. ЕСТЬ ЗАПРЕТ.
Dialogue: 0,0:02:25.50,0:02:27.76,Caption,,0,0,0,,И НИКТО ДАЖЕ ГОЛОС ПОВЫШАТЬ НЕ ОБЯЗАН.
Dialogue: 0,0:02:30.04,0:02:34.68,Caption,,0,0,0,,ОДНО РЕШЕНИЕ ПОМЕНЯЛИ, И У ТЕБЯ ВНЕЗАПНО ИЗМЕНИЛОСЬ ОЧЕНЬ МНОГОЕ. ПОЭТОМУ
Dialogue: 0,0:02:34.76,0:02:38.76,Caption,,0,0,0,,РАЗГОВОР ЗЕЛЕНСКОГО О ТОМ, ЧТО МАСК НЕ ИМЕЕТ ПРАВА ВЛИЯТЬ НА УКРАИНСКУЮ
Dialogue: 0,0:02:38.76,0:02:42.44,Caption,,0,0,0,,ПОЛИТИКУ, САМ ПО СЕБЕ ПРАВИЛЬНЫЙ ВОПРОС. ТОЛЬКО ЗАДАВАТЬ ЕГО
Dialogue: 0,0:02:42.52,0:02:45.40,Caption,,0,0,0,,НАДО НЕ ОДНОМУ МАСКУ. ЕГО НАДО ЗАДАВАТЬ ВСЕМ.
Dialogue: 0,0:02:45.79,0:02:48.84,Caption,,0,0,0,,ИНАЧЕ ПОЛУЧАЕТСЯ СТАРОЕ ДОБРОЕ ПРАВИЛО. ЕСЛИ ЧЕЛОВЕК
Dialogue: 0,0:02:48.84,0:02:50.76,Caption,,0,0,0,,ГОВОРИТ ТО, ЧТО ТЕБЕ НРАВИТСЯ,
Dialogue: 0,0:02:50.99,0:02:53.32,Caption,,0,0,0,,ЭТО ПАРТНЁР. ЕСЛИ ГОВОРИТ НЕПРИЯТНОЕ,
Dialogue: 0,0:02:53.56,0:02:56.68,Caption,,0,0,0,,ЭТО ВМЕШАТЕЛЬСТВО. ПРИЧЁМ САМ ЗЕЛЕНСКИЙ ДОБАВИЛ ЕЩЁ
Dialogue: 0,0:02:56.76,0:02:58.68,Caption,,0,0,0,,ОДНУ ЗАНЯТНУЮ МЫСЛЬ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:02:58.83,0:03:00.76,Caption,,0,0,0,,ДАЖЕ НЕПРАВИЛЬНЫЙ ВЫБОР ЛУЧШЕ,
Dialogue: 0,0:03:01.06,0:03:03.48,Caption,,0,0,0,,ЧЕМ КОГДА ТЕБЕ КОГО ТО НАВЯЗЫВАЮТ. ВОТ ТУТ
Dialogue: 0,0:03:03.48,0:03:06.20,Caption,,0,0,0,,ВООБЩЕ ПРЕКРАСНО. ПОЛНОСТЬЮ СОГЛАСУЕТСЯ С ИДЕЕЙ
Dialogue: 0,0:03:06.20,0:03:09.40,Caption,,0,0,0,,ВЫБОРОВ. ОСТАЛОСЬ ТОЛЬКО ЭТИ ВЫБОРЫ ПРОВЕСТИ. А ВОТ
Dialogue: 0,0:03:09.48,0:03:12.20,Caption,,0,0,0,,С ЭТИМ УЖЕ НАЧИНАЕТСЯ ЦИРК. ЗЕЛЕНСКИЙ РАССКАЗАЛ,
Dialogue: 0,0:03:12.50,0:03:15.00,Caption,,0,0,0,,ЧТО ПРЕДЛАГАЛ АМЕРИКАНЦАМ ДОГОВОРИТЬСЯ С РОССИЕЙ О
Dialogue: 0,0:03:15.00,0:03:18.12,Caption,,0,0,0,,ПРЕКРАЩЕНИИ ОГНЯ ЗИМОЙ. ЛЮДИ ПОЛУЧАЮТ ЭЛЕКТРИЧЕСТВО
Dialogue: 0,0:03:18.20,0:03:21.56,Caption,,0,0,0,,И ВОДУ. БОЕВЫЕ ДЕЙСТВИЯ ОСТАНАВЛИВАЮТСЯ. И В ЭТОТ
Dialogue: 0,0:03:21.56,0:03:24.44,Caption,,0,0,0,,ПЕРИОД УКРАИНА ПРОВОДИТ ПРЕЗИДЕНТСКИЕ ВЫБОРЫ. ПОСЛЕ
Dialogue: 0,0:03:24.44,0:03:26.52,Caption,,0,0,0,,ЧЕГО ЗЕЛЕНСКИЙ ГОВОРИТ АМЕРИКАНЦАМ ПРИМЕРНО
Dialogue: 0,0:03:26.52,0:03:28.20,Caption,,0,0,0,,СЛЕДУЮЩЕЕ ХОТИТЕ МЕНЯ ЗАМЕНИТЬ,
Dialogue: 0,0:03:28.40,0:03:31.88,Caption,,0,0,0,,У ВАС БЫЛ ШАНС. ШАНС БЫЛ. А УЖЕ ВСЁ!
Dialogue: 0,0:03:31.93,0:03:36.04,Caption,,0,0,0,,НАДО БЫЛО РАНЬШЕ! СЛУШАЙТЕ, ЗАМЕЧАТЕЛЬНАЯ ПОСТАНОВКА ВОПРОСА. АМЕРИКАНЦЫ
Dialogue: 0,0:03:36.04,0:03:38.68,Caption,,0,0,0,,УПУСТИЛИ ШАНС ЗАМЕНИТЬ ПРЕЗИДЕНТА УКРАИНЫ. А
Dialogue: 0,0:03:38.68,0:03:41.32,Caption,,0,0,0,,УКРАИНЦЫ В ЭТОЙ СХЕМЕ ГДЕ? У НИХ ТАМ КАКАЯ РОЛЬ?
Dialogue: 0,0:03:43.60,0:03:46.16,Caption,,0,0,0,,АПЛОДИРОВАТЬ АМЕРИКАНЦАМ, ЕСЛИ ОНИ УСПЕЛИ?
Dialogue: 0,0:03:46.54,0:03:48.72,Caption,,0,0,0,,ИЛИ РАССТРОИТЬСЯ, ЕСЛИ НЕ УСПЕЛИ?
Dialogue: 0,0:03:49.12,0:03:51.12,Caption,,0,0,0,,ПОТОМУ ЧТО ФОРМАЛЬНО РЕЧЬ ВСЁ ТАКИ ИДЁТ О
Dialogue: 0,0:03:51.12,0:03:54.08,Caption,,0,0,0,,ПРЕЗИДЕНТЕ УКРАИНЫ. ЕГО ДОЛЖНЫ ВЫБИРАТЬ ГРАЖДАНЕ
Dialogue: 0,0:03:54.08,0:03:59.28,Caption,,0,0,0,,УКРАИНЫ. НО ФРАЗА ЗВУЧИТ ТАК, БУДТО В ВАШИНГТОНЕ КОМУ ТО НЕ ХВАТИЛО РАСТОРОПНОСТИ
Dialogue: 0,0:03:59.36,0:04:02.16,Caption,,0,0,0,,ОФОРМИТЬ КАДРОВОЕ РЕШЕНИЕ. САМОЕ СМЕШНОЕ,
Dialogue: 0,0:04:02.48,0:04:05.28,Caption,,0,0,0,,ЧТО ТЕМА ВЫБОРОВ НА ЭТОМ НЕ ЗАКАНЧИВАЕТСЯ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:04:05.28,0:04:07.84,Caption,,0,0,0,,ТУТ ЖЕ ГОВОРИТ ОБ ОНЛАЙН ГОЛОСОВАНИИ. ТО ЕСТЬ
Dialogue: 0,0:04:07.84,0:04:10.48,Caption,,0,0,0,,ВАРИАНТ ЕСТЬ. МОЖНО РАССМОТРЕТЬ ДИСТАНЦИОННЫЕ
Dialogue: 0,0:04:10.48,0:04:13.28,Caption,,0,0,0,,ВЫБОРЫ. ПАРЛАМЕНТ ДОЛЖЕН ПОДГОТОВИТЬ НУЖНЫЕ РЕШЕНИЯ.
Dialogue: 0,0:04:13.48,0:04:17.44,Caption,,0,0,0,,ХОРОШО. НАКОНЕЦ ТО ДВИЖЕНИЕ. НО БУКВАЛЬНО СЛЕДОМ
Dialogue: 0,0:04:17.44,0:04:20.96,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО ВСЁ НЕ ТАК ПРОСТО. ВОЕННЫЕ НА ФРОНТЕ.
Dialogue: 0,0:04:21.20,0:04:23.76,Caption,,0,0,0,,ГОЛОСОВАТЬ ИМ ТРУДНО. БЕЗ НИХ ПРОВОДИТЬ ВЫБОРЫ
Dialogue: 0,0:04:23.76,0:04:27.12,Caption,,0,0,0,,НЕСПРАВЕДЛИВО. И ВСЁ. ПРИЕХАЛИ. ВЫБОРЫ МОЖНО
Dialogue: 0,0:04:27.12,0:04:30.80,Caption,,0,0,0,,ПРОВЕСТИ, НО НЕЛЬЗЯ. СОЛДАТЫ ОБИДЯТСЯ. ПРАВО ГОЛОСА
Dialogue: 0,0:04:30.80,0:04:34.64,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ, КОНЕЧНО, НИКТО НЕ ОТМЕНЯЛ. НО ВЕДЬ ИМЕННО ПОЭТОМУ И
Dialogue: 0,0:04:34.64,0:04:37.44,Caption,,0,0,0,,НУЖЕН НОВЫЙ МЕХАНИЗМ. ЕСЛИ СТАРЫЙ СПОСОБ НЕ
Dialogue: 0,0:04:37.44,0:04:39.68,Caption,,0,0,0,,РАБОТАЕТ, А НОВЫЙ УЖЕ ОБСУЖДАЮТ,
Dialogue: 0,0:04:40.00,0:04:45.12,Caption,,0,0,0,,ЛОГИЧНЫЙ СЛЕДУЮЩИЙ ШАГ КАКОЙ? ДОВЕСТИ НОВЫЙ СПОСОБ ДО РАБОЧЕГО СОСТОЯНИЯ. А ЗДЕСЬ
Dialogue: 0,0:04:45.12,0:04:47.60,Caption,,0,0,0,,ПОЛУЧАЕТСЯ НАОБОРОТ. СНАЧАЛА НАМ ГОВОРЯТ,
Dialogue: 0,0:04:47.83,0:04:50.56,Caption,,0,0,0,,ЧТО ЕСТЬ ТЕХНИЧЕСКИЙ ВАРИАНТ. ПОТОМ ЭТОТ ТЕХНИЧЕСКИЙ
Dialogue: 0,0:04:50.64,0:04:53.12,Caption,,0,0,0,,ВАРИАНТ ПРЕВРАЩАЕТСЯ В ЕЩЁ ОДНО ОБЪЯСНЕНИЕ,
Dialogue: 0,0:04:53.32,0:04:56.00,Caption,,0,0,0,,ПОЧЕМУ НИЧЕГО НЕ СОСТОИТСЯ. ТО ЕСТЬ ВОПРОС УЖЕ
Dialogue: 0,0:04:56.00,0:04:58.80,Caption,,0,0,0,,ДАЖЕ НЕ В ТОМ, СЛОЖНЫЕ ВЫБОРЫ ИЛИ ПРОСТЫЕ.
Dialogue: 0,0:05:01.08,0:05:04.28,Caption,,0,0,0,,КОНЕЧНО СЛОЖНЫЕ. ВОПРОС В ДРУГОМ. ВЫ РЕАЛЬНО
Dialogue: 0,0:05:04.28,0:05:09.08,Caption,,0,0,0,,ПЫТАЕТЕСЬ РЕШИТЬ ПРОБЛЕМУ? ИЛИ ОБСУЖДЕНИЕ САМОЙ ПРОБЛЕМЫ УЖЕ СТАЛО УДОБНОЙ
Dialogue: 0,0:05:09.08,0:05:13.00,Caption,,0,0,0,,ЗАМЕНОЙ РЕШЕНИЮ? ПОТОМУ ЧТО ЗЕЛЕНСКИЙ ОДНОВРЕМЕННО ПРОИЗНОСИТ ЕЩЁ
Dialogue: 0,0:05:13.00,0:05:16.20,Caption,,0,0,0,,ОДНУ ФРАЗУ. КОНЦЕНТРАЦИЯ ВЛАСТИ У ОДНОГО ЧЕЛОВЕКА
Dialogue: 0,0:05:16.20,0:05:19.08,Caption,,0,0,0,,ОПАСНА. И ТУТ ХОЧЕТСЯ СПРОСИТЬ. НУ ТАК,
Dialogue: 0,0:05:19.28,0:05:21.24,Caption,,0,0,0,,СОБСТВЕННЫМ СОВЕТАМ НЕ ХОЧЕШЬ ПРИСЛУШИВАТЬСЯ?
Dialogue: 0,0:05:21.46,0:05:24.44,Caption,,0,0,0,,ПЯТИЛЕТНИЙ СРОК, НА КОТОРЫЙ ЗЕЛЕНСКОГО ИЗБРАЛИ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:05:24.44,0:05:29.00,Caption,,0,0,0,,ДЕВЯТНАДЦАТОМ ГОДУ, ЗАКОНЧИЛСЯ. НОВЫХ ПРЕЗИДЕНТСКИХ ВЫБОРОВ НЕТ. А
Dialogue: 0,0:05:29.00,0:05:32.04,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫЙ ПРОДОЛЖАЕТ ЗАНИМАТЬ ПРЕЗИДЕНТСКИЙ ПОСТ,
Dialogue: 0,0:05:32.36,0:05:35.00,Caption,,0,0,0,,ОБЪЯСНЯЕТ ИЛОНУ МАСКУ, ПОЧЕМУ ПЛОХО,
Dialogue: 0,0:05:35.24,0:05:38.60,Caption,,0,0,0,,КОГДА СЛИШКОМ МНОГО ВЛИЯНИЯ И ВЛАСТИ СОСРЕДОТОЧЕНО В
Dialogue: 0,0:05:38.60,0:05:41.64,Caption,,0,0,0,,ОДНИХ РУКАХ. ВОТ ТАКОЙ УРОК ПОЛИТОЛОГИИ. ПРИЧЁМ
Dialogue: 0,0:05:41.64,0:05:45.80,Caption,,0,0,0,,МАСКУ ЕЩЁ И ОБЪЯСНЯЮТ, ЧТО ОН ГРАЖДАНИН ДРУГОГО ГОСУДАРСТВА. ЛОГИЧНО.
Dialogue: 0,0:05:46.10,0:05:49.08,Caption,,0,0,0,,ТОЛЬКО ТОГДА ОПЯТЬ ВОЗВРАЩАЕМСЯ К НАЧАЛУ. А ДЕНЬГИ
Dialogue: 0,0:05:49.08,0:05:53.08,Caption,,0,0,0,,ДРУГОГО ГОСУДАРСТВА ВЛИЯЮТ? ОРУЖИЕ ДРУГОГО ГОСУДАРСТВА ВЛИЯЕТ?
Dialogue: 0,0:05:53.56,0:05:55.80,Caption,,0,0,0,,РЕШЕНИЕ ДРУГОГО ГОСУДАРСТВА ПРЕКРАТИТЬ ИЛИ
Dialogue: 0,0:05:55.80,0:06:00.12,Caption,,0,0,0,,ПРОДОЛЖИТЬ ПОМОЩЬ ВЛИЯЕТ? СПУТНИКОВАЯ СИСТЕМА ЧАСТНОЙ КОМПАНИИ ДРУГОГО
Dialogue: 0,0:06:00.12,0:06:04.84,Caption,,0,0,0,,ГОСУДАРСТВА ВЛИЯЕТ? ВОТ ТЕПЕРЬ УЖЕ СТАНОВИТСЯ ВЕСЕЛЕЕ. ПОДПИСЫВАЙТЕСЬ НА
Dialogue: 0,0:06:04.84,0:06:08.12,Caption,,0,0,0,,КАНАЛ, ПОТОМУ ЧТО ДАЛЬШЕ ЭТОТ СПОР О ВЛИЯНИИ ВНЕЗАПНО
Dialogue: 0,0:06:08.12,0:06:11.24,Caption,,0,0,0,,ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ МАСКА И УПИРАЕТСЯ УЖЕ
Dialogue: 0,0:06:11.32,0:06:15.88,Caption,,0,0,0,,В ПЕРЕГОВОРЫ РОССИИ, США И УСТРОЙСТВО БЕЗОПАСНОСТИ ВСЕЙ ЕВРОПЫ.
Dialogue: 0,0:06:18.16,0:06:20.72,Caption,,0,0,0,,В УКРАИНСКОМ ИНФОРМАЦИОННОМ ПОЛЕ ПОЯВИЛАСЬ ВЕРСИЯ
Dialogue: 0,0:06:20.72,0:06:23.92,Caption,,0,0,0,,БОЛЬШОГО ПЕРЕГОВОРНОГО ПАКЕТА. ЕЁ ИЗЛОЖИЛ УКРАИНСКИЙ
Dialogue: 0,0:06:23.92,0:06:26.56,Caption,,0,0,0,,АНАЛИТИК СЕРГЕЙ ПАВЛЮЧЕНКО. ПО ЕГО ВЕРСИИ,
Dialogue: 0,0:06:26.89,0:06:29.60,Caption,,0,0,0,,КИРИЛЛ ДМИТРИЕВ ПЕРЕДАЛ ТРАМПУ И КУШНЕРУ НАБОР
Dialogue: 0,0:06:29.68,0:06:32.96,Caption,,0,0,0,,РОССИЙСКИХ УСЛОВИЙ. И НАЧИНАЕТСЯ ВСЁ ПОЧТИ УЮТНО.
Dialogue: 0,0:06:33.28,0:06:36.40,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЕ ПЕРЕМИРИЕ ДО КОНЦА ГОДА. НЕ БЬЁМ ПО
Dialogue: 0,0:06:36.40,0:06:39.68,Caption,,0,0,0,,ЭНЕРГЕТИКЕ. ЛЮДИ ПОЛУЧАЮТ СВЕТ. ЗИМОЙ СТАНОВИТСЯ
Dialogue: 0,0:06:39.76,0:06:42.64,Caption,,0,0,0,,НЕМНОГО СПОКОЙНЕЕ. КРАСИВО. НО ЗАТЕМ ОТКРЫВАЕМ
Dialogue: 0,0:06:42.64,0:06:45.04,Caption,,0,0,0,,СЛЕДУЮЩУЮ СТРАНИЦУ, И ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:06:45.12,0:06:48.16,Caption,,0,0,0,,ЧТО УЮТ ЗАКОНЧИЛСЯ. МОСКВА, ПО ЭТОЙ ВЕРСИИ,
Dialogue: 0,0:06:48.48,0:06:51.28,Caption,,0,0,0,,ТРЕБУЕТ ПОЛНОГО ПРЕКРАЩЕНИЯ УКРАИНСКИХ АТАК НА
Dialogue: 0,0:06:51.28,0:06:53.60,Caption,,0,0,0,,РОССИЙСКУЮ ГРАЖДАНСКУЮ ЭНЕРГЕТИЧЕСКУЮ
Dialogue: 0,0:06:53.60,0:06:56.80,Caption,,0,0,0,,ИНФРАСТРУКТУРУ, ПРЕЖДЕ ВСЕГО НЕФТЕГАЗОВЫЕ ОБЪЕКТЫ И
Dialogue: 0,0:06:56.80,0:07:00.08,Caption,,0,0,0,,НЕФТЕПЕРЕРАБАТЫВАЮЩИЕ ЗАВОДЫ. ДАЛЬШЕ ИДЁТ ДОНБАСС.
Dialogue: 0,0:07:00.30,0:07:05.04,Caption,,0,0,0,,ПАВЛЮЧЕНКО УТВЕРЖДАЕТ, ЧТО РОССИЯ ГОТОВА ОСТАВИТЬ КИЕВУ ТУ ЧАСТЬ ДОНБАССА,
Dialogue: 0,0:07:05.36,0:07:07.84,Caption,,0,0,0,,КОТОРАЯ СЕЙЧАС ОСТАЁТСЯ ПОД УКРАИНСКИМ КОНТРОЛЕМ.
Dialogue: 0,0:07:08.28,0:07:13.12,Caption,,0,0,0,,ЗВУЧИТ КАК СЕРЬЁЗНАЯ УСТУПКА. НО ЦЕНА ТАМ ТОЖЕ НЕ МАЛЕНЬКАЯ. РЕЗКОЕ СОКРАЩЕНИЕ
Dialogue: 0,0:07:13.12,0:07:16.16,Caption,,0,0,0,,ЧИСЛЕННОСТИ УКРАИНСКОЙ АРМИИ. СОКРАЩЕНИЕ ТЯЖЁЛЫХ
Dialogue: 0,0:07:16.16,0:07:18.96,Caption,,0,0,0,,ВООРУЖЕНИЙ. ЗАКОНОДАТЕЛЬНЫЕ ГАРАНТИИ ДЛЯ РУССКОГО
Dialogue: 0,0:07:18.96,0:07:22.16,Caption,,0,0,0,,ЯЗЫКА. ВОССТАНОВЛЕНИЕ ПРАВ КАНОНИЧЕСКОЙ ПРАВОСЛАВНОЙ
Dialogue: 0,0:07:22.16,0:07:24.48,Caption,,0,0,0,,ЦЕРКВИ. И НА ЭТОМ СПИСОК ДАЖЕ НЕ ДУМАЕТ
Dialogue: 0,0:07:24.48,0:07:27.28,Caption,,0,0,0,,ЗАКАНЧИВАТЬСЯ. СЛЕДОМ ЗАПАДНЫЕ ВОЙСКА.
Dialogue: 0,0:07:29.56,0:07:33.48,Caption,,0,0,0,,ПО ЭТОЙ ВЕРСИИ, ВОЗМОЖНЫЙ ИНОСТРАННЫЙ КОНТИНГЕНТ ДОПУСКАЕТСЯ ТОЛЬКО
Dialogue: 0,0:07:33.56,0:07:36.04,Caption,,0,0,0,,В ЗАПАДНОЙ ЧАСТИ УКРАИНЫ И НА УСЛОВИЯХ,
Dialogue: 0,0:07:36.28,0:07:40.68,Caption,,0,0,0,,КОТОРЫЕ УСТРАИВАЮТ МОСКВУ. А ДАЛЬШЕ ВООБЩЕ ВЫХОДИМ ЗА ПРЕДЕЛЫ УКРАИНЫ.
Dialogue: 0,0:07:41.39,0:07:45.64,Caption,,0,0,0,,ПО ВЕРСИИ ПАВЛЮЧЕНКО, РОССИЯ ТРЕБУЕТ ОТОДВИНУТЬ ВОЕННУЮ ИНФРАСТРУКТУРУ
Dialogue: 0,0:07:45.72,0:07:48.36,Caption,,0,0,0,,НАТО ОТ СТРАН БАЛТИИ И СКАНДИНАВИИ. ТО ЕСТЬ
Dialogue: 0,0:07:48.44,0:07:51.16,Caption,,0,0,0,,НАЧИНАЛИ С ЭЛЕКТРОСТАНЦИЙ. ЧЕРЕЗ НЕСКОЛЬКО ПУНКТОВ
Dialogue: 0,0:07:51.24,0:07:53.88,Caption,,0,0,0,,УЖЕ ДВИГАЕМ НАТО ПО ЕВРОПЕ. ХОРОШИЙ ТАКОЙ ПРЫЖОК.
Dialogue: 0,0:07:54.27,0:07:59.16,Caption,,0,0,0,,СНАЧАЛА ДОГОВОРИМСЯ, ЧТОБЫ ЗИМОЙ ЛАМПОЧКА ГОРЕЛА. ПОТОМ ЗАОДНО ПЕРЕДЕЛАЕМ
Dialogue: 0,0:07:59.16,0:08:01.32,Caption,,0,0,0,,ВСЮ ЕВРОПЕЙСКУЮ СИСТЕМУ БЕЗОПАСНОСТИ.
Dialogue: 0,0:08:01.99,0:08:03.80,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ РАЗГОВОРЫ О ТОМ,
Dialogue: 0,0:08:04.03,0:08:06.84,Caption,,0,0,0,,ЧТО ВЕСЬ КОНФЛИКТ ЯКОБЫ СВОДИТСЯ ТОЛЬКО К НЕСКОЛЬКИМ
Dialogue: 0,0:08:06.84,0:08:10.44,Caption,,0,0,0,,ТЕРРИТОРИЯМ, ВЫГЛЯДЯТ СЛИШКОМ ПРОСТЫМИ. ЕСЛИ ИЗЛОЖЕННЫЙ
Dialogue: 0,0:08:10.52,0:08:13.08,Caption,,0,0,0,,ПАВЛЮЧЕНКО ПАКЕТ ХОТЯ БЫ ОТРАЖАЕТ НАПРАВЛЕНИЕ
Dialogue: 0,0:08:13.08,0:08:17.40,Caption,,0,0,0,,РОССИЙСКИХ ТРЕБОВАНИЙ, ТО ТЕРРИТОРИЯ ТАМ ЛИШЬ ОДИН ЭЛЕМЕНТ. ДАЛЬШЕ АРМИЯ.
Dialogue: 0,0:08:17.62,0:08:22.04,Caption,,0,0,0,,ВООРУЖЕНИЯ. НАТО. ИНОСТРАННЫЕ ВОЙСКА. ЯЗЫК. ЦЕРКОВЬ.
Dialogue: 0,0:08:22.20,0:08:24.84,Caption,,0,0,0,,БЕЗОПАСНОСТЬ РОССИИ. БЕЗОПАСНОСТЬ УКРАИНЫ.
Dialogue: 0,0:08:25.08,0:08:27.96,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ЕВРОПЫ. И ТУТ СНОВА ВОЗВРАЩАЮТСЯ
Dialogue: 0,0:08:28.04,0:08:30.84,Caption,,0,0,0,,ВЫБОРЫ. ПОТОМУ ЧТО МИРНЫЙ ДОГОВОР МАЛО СОГЛАСОВАТЬ.
Dialogue: 0,0:08:31.07,0:08:33.80,Caption,,0,0,0,,ЕГО ЕЩЁ КОМУ ТО НАДО ПОДПИСАТЬ. МОСКВА УЖЕ
Dialogue: 0,0:08:33.80,0:08:37.16,Caption,,0,0,0,,ПОДНИМАЛА ВОПРОС, КОГО ОНА ВООБЩЕ ГОТОВА СЧИТАТЬ УКРАИНСКИМ
Dialogue: 0,0:08:37.16,0:08:39.80,Caption,,0,0,0,,ПОДПИСАНТОМ. КИЕВ ТАКУЮ РОССИЙСКУЮ ПОЗИЦИЮ
Dialogue: 0,0:08:39.80,0:08:42.52,Caption,,0,0,0,,ОТВЕРГАЕТ. НО ОТ ЭТОГО ПРОБЛЕМА НЕ ИСПАРЯЕТСЯ.
Dialogue: 0,0:08:44.79,0:08:47.27,Caption,,0,0,0,,ЕСЛИ ОДНА СТОРОНА ЗАРАНЕЕ ГОВОРИТ ВОТ ЭТУ ПОДПИСЬ
Dialogue: 0,0:08:47.27,0:08:50.95,Caption,,0,0,0,,Я ПОТОМ БУДУ ОСПАРИВАТЬ, ТО ДОГОВОР МОЖНО НАПИСАТЬ ХОТЬ ЗОЛОТЫМИ БУКВАМИ.
Dialogue: 0,0:08:51.20,0:08:52.71,Caption,,0,0,0,,ЧЕРЕЗ МЕСЯЦ ВСЁ ОПЯТЬ ПО НОВОЙ.
Dialogue: 0,0:08:53.33,0:08:56.31,Caption,,0,0,0,,И ВОТ ТУТ ВЫБОРЫ ПЕРЕСТАЮТ БЫТЬ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:08:56.31,0:08:59.03,Caption,,0,0,0,,УКРАИНСКИМ ВНУТРЕННИМ ВОПРОСОМ. ПОТОМУ ЧТО ОНИ
Dialogue: 0,0:08:59.03,0:09:01.99,Caption,,0,0,0,,НАЧИНАЮТ КАСАТЬСЯ УЖЕ И БУДУЩЕГО СОГЛАШЕНИЯ. КТО
Dialogue: 0,0:09:01.99,0:09:04.79,Caption,,0,0,0,,ПОЛУЧАЕТ ПОЛНОМОЧИЯ? КТО СТАВИТ ПОДПИСЬ?
Dialogue: 0,0:09:05.11,0:09:08.07,Caption,,0,0,0,,КТО ПРИЗНАЁТ ЭТУ ПОДПИСЬ? И ЧТО ПРОИСХОДИТ ДАЛЬШЕ?
Dialogue: 0,0:09:08.38,0:09:10.31,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ ЕВРОПА ДЕЙСТВУЕТ ТАК,
Dialogue: 0,0:09:10.55,0:09:13.91,Caption,,0,0,0,,БУДТО ЖДАТЬ ИТОГОВОГО ОТВЕТА НИКТО НЕ СОБИРАЕТСЯ. НО
Dialogue: 0,0:09:13.99,0:09:17.19,Caption,,0,0,0,,ДЕЙСТВУЕТ ОНА ОЧЕНЬ ПО РАЗНОМУ. ИТАЛИЯ ПРОДОЛЖАЕТ
Dialogue: 0,0:09:17.19,0:09:20.47,Caption,,0,0,0,,ЛИНИЮ ВОЕННОЙ ПОМОЩИ. МИНИСТР ОБОРОНЫ ГУИДО КРОЗЕТТО
Dialogue: 0,0:09:20.79,0:09:23.43,Caption,,0,0,0,,НАМЕРЕН ПРЕДЛОЖИТЬ ПРОДЛИТЬ ДЕЙСТВУЮЩИЙ МЕХАНИЗМ
Dialogue: 0,0:09:23.51,0:09:26.63,Caption,,0,0,0,,ПОМОЩИ УКРАИНЕ НА СЛЕДУЮЩИЙ ГОД. ЭТО ВАЖНО. РЕЧЬ
Dialogue: 0,0:09:26.71,0:09:29.51,Caption,,0,0,0,,НЕ ТОЛЬКО ОБ ОЧЕРЕДНОЙ КОНКРЕТНОЙ ПОСТАВКЕ. РЕЧЬ О
Dialogue: 0,0:09:29.59,0:09:32.07,Caption,,0,0,0,,ТОМ, ЧТОБЫ СОХРАНИТЬ САМ МЕХАНИЗМ,
Dialogue: 0,0:09:32.22,0:09:35.19,Caption,,0,0,0,,ЧЕРЕЗ КОТОРЫЙ ИТАЛИЯ ПРОДОЛЖИТ ОТПРАВЛЯТЬ ВООРУЖЕНИЯ
Dialogue: 0,0:09:35.27,0:09:40.07,Caption,,0,0,0,,ДАЛЬШЕ. КРОЗЕТТО НАПОМИНАЕТ, ЧТО ЭТОТ МЕХАНИЗМ ПОЯВИЛСЯ ЕЩЁ ПРИ МАРИО ДРАГИ
Dialogue: 0,0:09:40.07,0:09:42.39,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ ГОДУ. ТОГДА ЕГО
Dialogue: 0,0:09:42.39,0:09:45.91,Caption,,0,0,0,,ПОДДЕРЖИВАЛИ ПАРТИИ, КОТОРЫЕ СЕЙЧАС НАХОДЯТСЯ И ВО ВЛАСТИ,
Dialogue: 0,0:09:46.13,0:09:49.75,Caption,,0,0,0,,И В ОППОЗИЦИИ. ЗА ПРОШЕДШИЕ ГОДЫ ПОЗИЦИИ НЕКОТОРЫХ
Dialogue: 0,0:09:49.83,0:09:52.95,Caption,,0,0,0,,ИЗ НИХ ИЗМЕНИЛИСЬ. КРОЗЕТТО СПРАШИВАЕТ ЕСЛИ ТОГДА
Dialogue: 0,0:09:52.95,0:09:56.31,Caption,,0,0,0,,ПОМОЩЬ БЫЛА ПРАВИЛЬНОЙ, ПОЧЕМУ ТЕПЕРЬ ОНА ДОЛЖНА БЫТЬ НЕПРАВИЛЬНОЙ?
Dialogue: 0,0:09:56.50,0:10:02.42,Caption,,0,0,0,,НУ, ВОПРОС КРАСИВЫЙ. ТОЛЬКО ЗА ЧЕТЫРЕ ГОДА МИР ТОЖЕ НЕ СТОЯЛ
Dialogue: 0,0:10:02.42,0:10:05.86,Caption,,0,0,0,,НА МЕСТЕ. РАСХОДЫ ВЫРОСЛИ. ПОЛИТИЧЕСКИЕ НАСТРОЕНИЯ
Dialogue: 0,0:10:05.86,0:10:08.90,Caption,,0,0,0,,ИЗМЕНИЛИСЬ. СОЕДИНЁННЫЕ ШТАТЫ ИЗМЕНИЛИ ПОДХОД.
Dialogue: 0,0:10:09.11,0:10:12.18,Caption,,0,0,0,,ВНУТРИ ЕВРОПЫ РАЗНОГЛАСИЙ СТАЛО БОЛЬШЕ. ТАК ЧТО
Dialogue: 0,0:10:12.26,0:10:14.98,Caption,,0,0,0,,ОТВЕТ "ПОТОМУ ЧТО ЧЕТЫРЕ ГОДА НАЗАД МЫ ГОЛОСОВАЛИ
Dialogue: 0,0:10:14.98,0:10:17.86,Caption,,0,0,0,,ИНАЧЕ" САМ ПО СЕБЕ ТОЖЕ НЕ ЖЕЛЕЗНЫЙ. НО
Dialogue: 0,0:10:17.86,0:10:20.66,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО ДЖОРДЖИ МЕЛОНИ ОБЩИЙ КУРС СОХРАНЯЕТ.
Dialogue: 0,0:10:20.96,0:10:23.30,Caption,,0,0,0,,НА ДЕСЯТОЕ НОЯБРЯ КРОЗЕТТО ДОЛЖЕН ПРЕДСТАВИТЬ
Dialogue: 0,0:10:23.30,0:10:25.70,Caption,,0,0,0,,ПАРЛАМЕНТСКОМУ КОМИТЕТУ ПО БЕЗОПАСНОСТИ УЖЕ
Dialogue: 0,0:10:25.70,0:10:29.62,Caption,,0,0,0,,ТРИНАДЦАТЫЙ ПАКЕТ ПОМОЩИ УКРАИНЕ. ТРИНАДЦАТЫЙ. СРЕДИ
Dialogue: 0,0:10:29.62,0:10:32.42,Caption,,0,0,0,,ОЖИДАЕМЫХ ЭЛЕМЕНТОВ НАЗЫВАЮТСЯ РАКЕТЫ ДЛЯ КОМПЛЕКСА
Dialogue: 0,0:10:32.45,0:10:38.18,Caption,,0,0,0,,S A M P КОСАЯ ЧЕРТА T. А ВНУТРИ САМОЙ ИТАЛИИ ЕСТЬ СОПРОТИВЛЕНИЕ ДАЛЬНЕЙШИМ
Dialogue: 0,0:10:38.18,0:10:41.06,Caption,,0,0,0,,ПОСТАВКАМ. МАТТЕО САЛЬВИНИ ВЫСТУПАЕТ ПРОТИВ
Dialogue: 0,0:10:41.06,0:10:44.18,Caption,,0,0,0,,ПРОДОЛЖЕНИЯ ОТПРАВКИ ВООРУЖЕНИЙ. ТО ЕСТЬ ТАМ СПОР НЕ
Dialogue: 0,0:10:44.26,0:10:47.14,Caption,,0,0,0,,О КРАСИВЫХ ЛОЗУНГАХ. СПОР СОВЕРШЕННО ПРАКТИЧЕСКИЙ.
Dialogue: 0,0:10:47.46,0:10:51.06,Caption,,0,0,0,,ПРОДЛЕВАЕМ ПРОГРАММУ ИЛИ НЕТ? ОТПРАВЛЯЕМ СЛЕДУЮЩИЙ ПАКЕТ ИЛИ НЕТ?
Dialogue: 0,0:10:51.37,0:10:54.18,Caption,,0,0,0,,ИСПАНИЯ ИДЁТ СВОИМ ПУТЁМ. ТАМ ЗЕЛЕНСКИЙ ПОСЛЕ
Dialogue: 0,0:10:54.18,0:10:56.90,Caption,,0,0,0,,ВСТРЕЧИ С ПЕДРО САНЧЕСОМ ОБЪЯВИЛ О НОВОМ ВОЕННОМ
Dialogue: 0,0:10:56.90,0:11:00.10,Caption,,0,0,0,,ПАКЕТЕ НА ЧЕТЫРЕСТА ТРИДЦАТЬ СЕМЬ МИЛЛИОНОВ ЕВРО. И
Dialogue: 0,0:11:00.18,0:11:03.70,Caption,,0,0,0,,ЭТО ИМЕННО ИСПАНСКИЕ ДЕНЬГИ. НЕ ИТАЛИЯ ПЛЮС ИСПАНИЯ.
Dialogue: 0,0:11:03.94,0:11:06.98,Caption,,0,0,0,,НЕ ОБЩИЙ ЕВРОПЕЙСКИЙ ПАКЕТ. ИСПАНИЯ. ЧЕТЫРЕСТА
Dialogue: 0,0:11:06.98,0:11:10.10,Caption,,0,0,0,,ТРИДЦАТЬ СЕМЬ МИЛЛИОНОВ ЕВРО. ЭТО ЧЕТЫРЕСТА ТРИДЦАТЬ
Dialogue: 0,0:11:10.18,0:11:13.46,Caption,,0,0,0,,СЕМЬ ТЫСЯЧ ВЫПЛАТ ПО ТЫСЯЧЕ ЕВРО КАЖДАЯ. И
Dialogue: 0,0:11:13.54,0:11:15.94,Caption,,0,0,0,,РЕЧЬ ИДЁТ ТОЛЬКО ОБ ОДНОМ НОВОМ ПАКЕТЕ ОДНОЙ
Dialogue: 0,0:11:15.94,0:11:21.74,Caption,,0,0,0,,СТРАНЫ. ПЛЮС В ОБЩЕЙ КАРТИНЕ ЕСТЬ ЧЕТЫРЕ МИЛЛИАРДА ТРИСТА
Dialogue: 0,0:11:21.74,0:11:25.02,Caption,,0,0,0,,ШЕСТЬДЕСЯТ МИЛЛИОНОВ ЕВРО ЕВРОПЕЙСКОЙ ПОМОЩИ. ПЛЮС
Dialogue: 0,0:11:25.02,0:11:27.34,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ ДВЕСТИ МИЛЛИОНОВ ГЕРМАНИИ НА
Dialogue: 0,0:11:27.34,0:11:31.34,Caption,,0,0,0,,УКРАИНСКУЮ ЭНЕРГЕТИКУ. НО СВАЛИВАТЬ ВСЕ ЭТИ ЦИФРЫ В ОДНУ КУЧУ
Dialogue: 0,0:11:31.34,0:11:35.66,Caption,,0,0,0,,СМЫСЛА НЕТ. ПОТОМУ ЧТО НАЗНАЧЕНИЕ У ДЕНЕГ РАЗНОЕ. ВОЕННАЯ ПОМОЩЬ
Dialogue: 0,0:11:35.74,0:11:39.18,Caption,,0,0,0,,ЭТО ОДНО. ЭНЕРГЕТИКА ДРУГОЕ. БЮДЖЕТНАЯ ПОДДЕРЖКА
Dialogue: 0,0:11:39.18,0:11:42.46,Caption,,0,0,0,,ТРЕТЬЕ. ЗАТО ОДНА ВЕЩЬ ВИДНА ПРЕКРАСНО. ПОКА
Dialogue: 0,0:11:42.46,0:11:44.22,Caption,,0,0,0,,ПОЛИТИКИ ОБСУЖДАЮТ БУДУЩИЙ МИР,
Dialogue: 0,0:11:44.44,0:11:47.42,Caption,,0,0,0,,ДЕНЬГИ ПРОДОЛЖАЮТ ИДТИ. СЛОВАКИЯ ВООБЩЕ ПОКАЗЫВАЕТ
Dialogue: 0,0:11:47.50,0:11:50.38,Caption,,0,0,0,,ТРЕТИЙ ВАРИАНТ. РОБЕРТ ФИЦО ОБЪЯВЛЯЕТ ПОМОЩЬ НЕ НА
Dialogue: 0,0:11:50.46,0:11:53.82,Caption,,0,0,0,,РАКЕТЫ. НЕ НА БРОНЕТЕХНИКУ. А НА ГЕНЕРАТОРЫ И
Dialogue: 0,0:11:53.82,0:11:56.46,Caption,,0,0,0,,УКРЫТИЯ. ПЛЮС СЛОВАКИЯ ХОЧЕТ УЧАСТВОВАТЬ В
Dialogue: 0,0:11:56.46,0:11:59.74,Caption,,0,0,0,,ВОССТАНОВЛЕНИИ УКРАИНЫ. ДОРОГИ. ИНФРАСТРУКТУРА.
Dialogue: 0,0:11:59.98,0:12:03.10,Caption,,0,0,0,,АВТОМАГИСТРАЛИ МЕЖДУ ДВУМЯ СТРАНАМИ. ТО ЕСТЬ ИТАЛИЯ
Dialogue: 0,0:12:03.10,0:12:06.38,Caption,,0,0,0,,ДУМАЕТ О ПРОДОЛЖЕНИИ ВОЕННОЙ ПРОГРАММЫ. ИСПАНИЯ
Dialogue: 0,0:12:06.46,0:12:09.34,Caption,,0,0,0,,ОБЪЯВЛЯЕТ КРУПНЫЙ ПАКЕТ ВООРУЖЕНИЙ. СЛОВАКИЯ УЖЕ
Dialogue: 0,0:12:09.34,0:12:12.38,Caption,,0,0,0,,СМОТРИТ ЕЩЁ И В СТОРОНУ ВОССТАНОВЛЕНИЯ. ТРИ СТРАНЫ.
Dialogue: 0,0:12:12.76,0:12:15.74,Caption,,0,0,0,,ТРИ РАЗНЫХ ПОДХОДА. И ВСЁ ЭТО НАЗЫВАЕТСЯ ОДНИМ
Dialogue: 0,0:12:15.74,0:12:19.10,Caption,,0,0,0,,СЛОВОМ ПОМОЩЬ. А ТЕПЕРЬ САМОЕ ИНТЕРЕСНОЕ. ВЕРНЁМСЯ К
Dialogue: 0,0:12:19.18,0:12:22.14,Caption,,0,0,0,,МАСКУ. ПОТОМУ ЧТО КОГДА ЗЕЛЕНСКИЙ РАССУЖДАЕТ О ТОМ,
Dialogue: 0,0:12:22.22,0:12:24.54,Caption,,0,0,0,,ЧТО МАСК НЕ ДОЛЖЕН ВЛИЯТЬ НА УКРАИНУ,
Dialogue: 0,0:12:24.84,0:12:27.50,Caption,,0,0,0,,ЕСТЬ ОДНА ПРОБЛЕМА. МАСК НЕ ПРОСТО ЧЕЛОВЕК С
Dialogue: 0,0:12:27.50,0:12:30.38,Caption,,0,0,0,,БОЛЬШИМ АККАУНТОМ В СОЦИАЛЬНОЙ СЕТИ. ЗА НИМ SPACEX.
Dialogue: 0,0:12:32.66,0:12:35.22,Caption,,0,0,0,,А УКРАИНА ИСПОЛЬЗУЕТ СПУТНИКОВУЮ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:12:35.34,0:12:40.42,Caption,,0,0,0,,СВЯЗАННУЮ С ЭТОЙ КОМПАНИЕЙ. И ВОТ ЗДЕСЬ СЛОВО "ВЛИЯНИЕ" ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:12:40.42,0:12:44.02,Caption,,0,0,0,,ФИЛОСОФИЕЙ. КОНТРАКТ НА УКРАИНСКИЙ ДОСТУП К STARSHIELD ЧЕРЕЗ
Dialogue: 0,0:12:44.02,0:12:46.58,Caption,,0,0,0,,АМЕРИКАНСКОЕ ПРАВИТЕЛЬСТВО ЗАКАНЧИВАЕТСЯ В СЕРЕДИНЕ
Dialogue: 0,0:12:46.58,0:12:49.78,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА. КИЕВ УЖЕ ХОЧЕТ
Dialogue: 0,0:12:49.78,0:12:52.50,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ О ПРОДОЛЖЕНИИ. НЕ КОГДА КОНТРАКТ
Dialogue: 0,0:12:52.50,0:12:55.62,Caption,,0,0,0,,ЗАКОНЧИТСЯ. ЗАРАНЕЕ. ПОТОМУ ЧТО НАДО ПОНИМАТЬ,
Dialogue: 0,0:12:55.78,0:12:58.98,Caption,,0,0,0,,ОСТАНЕТСЯ СИСТЕМА ИЛИ НЕТ. НА КАКИХ УСЛОВИЯХ. С
Dialogue: 0,0:12:58.98,0:13:01.94,Caption,,0,0,0,,КАКИМИ ОГРАНИЧЕНИЯМИ. И УКРАИНСКИЙ ДИПЛОМАТ ДЕНИС
Dialogue: 0,0:13:02.02,0:13:06.42,Caption,,0,0,0,,СЕНИК КАК РАЗ ГОВОРИТ, ЧТО КИЕВУ НУЖНА ЯСНОСТЬ. ВОТ ТОЛЬКО С ЯСНОСТЬЮ
Dialogue: 0,0:13:06.50,0:13:09.54,Caption,,0,0,0,,ТАМ ВСЁ ТРАДИЦИОННО ПРЕКРАСНО. УКРАИНА УЖЕ ПЫТАЛАСЬ
Dialogue: 0,0:13:09.54,0:13:12.02,Caption,,0,0,0,,ПОЛУЧИТЬ ОБЪЯСНЕНИЯ ПО ОГРАНИЧЕНИЯМ STARSHIELD.
Dialogue: 0,0:13:12.25,0:13:15.62,Caption,,0,0,0,,ОБРАЩАЛАСЬ К ПЕНТАГОНУ. К БЕЛОМУ ДОМУ. К SPACEX.
Dialogue: 0,0:13:16.00,0:13:19.38,Caption,,0,0,0,,И ОТВЕТА НЕ ПОЛУЧИЛА. ТО ВКЛЮЧАЕМ. ТО ВЫКЛЮЧАЕМ.
Dialogue: 0,0:13:19.77,0:13:25.06,Caption,,0,0,0,,ТО ЭТО МЫ. ТО НЕ МЫ. ТО НЕ ЗНАЕМ. ТО НЕ СКАЖЕМ. РОМАШКА ЗА МИЛЛИАРДЫ. ТОЛЬКО
Dialogue: 0,0:13:25.14,0:13:27.94,Caption,,0,0,0,,ЭТА РОМАШКА СВЯЗАНА С ВОЕННЫМИ ВОЗМОЖНОСТЯМИ. И
Dialogue: 0,0:13:27.94,0:13:30.58,Caption,,0,0,0,,ПОЭТОМУ ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. ЕСЛИ ЧЕЛОВЕК
Dialogue: 0,0:13:30.58,0:13:34.18,Caption,,0,0,0,,КОНТРОЛИРУЕТ КОМПАНИЮ, ТЕХНОЛОГИЯ КОТОРОЙ ВСТРОЕНА В ТВОЮ АРМИЮ,
Dialogue: 0,0:13:34.50,0:13:36.82,Caption,,0,0,0,,РАЗВЕ ЕГО ВЛИЯНИЕ НАЧИНАЕТСЯ ТОЛЬКО ТОГДА,
Dialogue: 0,0:13:37.05,0:13:38.82,Caption,,0,0,0,,КОГДА ОН НАПИСАЛ НЕПРИЯТНЫЙ ПОСТ?
Dialogue: 0,0:13:39.19,0:13:42.58,Caption,,0,0,0,,НЕТ. ОНО НАЧИНАЕТСЯ ГОРАЗДО РАНЬШЕ. ОНО НАЧИНАЕТСЯ В
Dialogue: 0,0:13:42.58,0:13:46.50,Caption,,0,0,0,,ТОТ МОМЕНТ, КОГДА БЕЗ ЕГО ТЕХНОЛОГИИ ТЕБЕ СТАНОВИТСЯ ХУЖЕ.
Dialogue: 0,0:13:48.78,0:13:50.94,Caption,,0,0,0,,И МАСК ТЕПЕРЬ ЕЩЁ ПОДЛИЛ МАСЛА В ОГОНЬ.
Dialogue: 0,0:13:51.57,0:13:54.14,Caption,,0,0,0,,ОН ПОДДЕРЖАЛ ПУБЛИКАЦИЮ, В КОТОРОЙ ГОВОРИЛОСЬ,
Dialogue: 0,0:13:54.38,0:13:58.06,Caption,,0,0,0,,ЧТО SPACEX ЗРЯ ОТПРАВИЛА УКРАИНЕ ТЫСЯЧИ БЕСПЛАТНЫХ
Dialogue: 0,0:13:58.14,0:14:01.50,Caption,,0,0,0,,ТЕРМИНАЛОВ STARLINK В НАЧАЛЕ КОНФЛИКТА И БЕСПЛАТНО
Dialogue: 0,0:14:01.50,0:14:05.34,Caption,,0,0,0,,ОБЕСПЕЧИВАЛА СВЯЗЬ НА МИЛЛИОНЫ ДОЛЛАРОВ В МЕСЯЦ. САМ
Dialogue: 0,0:14:05.42,0:14:10.86,Caption,,0,0,0,,МАСК ЭТИ СЛОВА НЕ ПИСАЛ. НО ПУБЛИКАЦИЮ ПОДДЕРЖАЛ И РАСПРОСТРАНИЛ. А СМЫСЛ ТАМ
Dialogue: 0,0:14:10.86,0:14:13.90,Caption,,0,0,0,,НЕПРИЯТНЫЙ ДЛЯ КИЕВА. НАЧИНАЛОСЬ ВСЁ КАК ПОМОЩЬ
Dialogue: 0,0:14:13.90,0:14:17.18,Caption,,0,0,0,,ГРАЖДАНСКОМУ НАСЕЛЕНИЮ. ПОТОМ STARLINK СТАЛ ЧАСТЬЮ
Dialogue: 0,0:14:17.18,0:14:19.34,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЫ. В ТОМ ЧИСЛЕ ДЛЯ
Dialogue: 0,0:14:19.34,0:14:21.98,Caption,,0,0,0,,БЕСПИЛОТНИКОВ. А ЗАТЕМ КОМПАНИЯ ОКАЗАЛАСЬ В
Dialogue: 0,0:14:21.98,0:14:24.70,Caption,,0,0,0,,СИТУАЦИИ, КОГДА ЕЁ РУГАЮТ УЖЕ ЗА ТО,
Dialogue: 0,0:14:24.94,0:14:27.58,Caption,,0,0,0,,ЧТО ОНА НЕ ХОЧЕТ ПОДДЕРЖИВАТЬ ОТДЕЛЬНЫЕ ВИДЫ
Dialogue: 0,0:14:27.58,0:14:29.82,Caption,,0,0,0,,ВОЕННОГО ПРИМЕНЕНИЯ СОБСТВЕННОЙ СИСТЕМЫ.
Dialogue: 0,0:14:30.53,0:14:32.94,Caption,,0,0,0,,ТО ЕСТЬ ПУТЬ ПОЛУЧИЛСЯ ЗАМЕЧАТЕЛЬНЫЙ. СНАЧАЛА
Dialogue: 0,0:14:32.94,0:14:36.46,Caption,,0,0,0,,ОГРОМНОЕ СПАСИБО. ПОТОМ БЕЗ ВАС ТРУДНО. ПОТОМ ВЫ
Dialogue: 0,0:14:36.46,0:14:40.30,Caption,,0,0,0,,ОБЯЗАНЫ. ПОТОМ НЕ СМЕЙТЕ ВЛИЯТЬ. А КОМПАНИЯ СМОТРИТ
Dialogue: 0,0:14:40.38,0:14:41.82,Caption,,0,0,0,,НА ВСЁ ЭТО И ГОВОРИТ ПОГОДИТЕ,
Dialogue: 0,0:14:42.13,0:14:44.22,Caption,,0,0,0,,А КОГДА МЫ ВООБЩЕ ПОДПИСЫВАЛИСЬ НА ТАКУЮ РОЛЬ?
Dialogue: 0,0:14:44.93,0:14:47.26,Caption,,0,0,0,,ВОТ ЗДЕСЬ СПОР ЗЕЛЕНСКОГО С МАСКОМ СТАНОВИТСЯ
Dialogue: 0,0:14:47.34,0:14:50.38,Caption,,0,0,0,,НАМНОГО ШИРЕ ЛИЧНОЙ ПЕРЕПАЛКИ. ПОТОМУ ЧТО ЭТО ВОПРОС
Dialogue: 0,0:14:50.38,0:14:53.58,Caption,,0,0,0,,ЗАВИСИМОСТИ. КОГДА ЧУЖАЯ СИСТЕМА СТАНОВИТСЯ ЧАСТЬЮ
Dialogue: 0,0:14:53.58,0:14:58.22,Caption,,0,0,0,,ТВОЕЙ ПОВСЕДНЕВНОЙ РАБОТЫ, ЧЕЛОВЕК НА ДРУГОМ КОНЦЕ ЭТОЙ СИСТЕМЫ ПОЛУЧАЕТ РЫЧАГ
Dialogue: 0,0:14:58.22,0:15:00.70,Caption,,0,0,0,,ДАЖЕ БЕЗ ВСЯКОЙ ДОЛЖНОСТИ. ОН МОЖЕТ ВООБЩЕ НЕ
Dialogue: 0,0:15:00.78,0:15:03.66,Caption,,0,0,0,,ЗВОНИТЬ ПРЕЗИДЕНТУ. НЕ ТРЕБОВАТЬ СМЕНИТЬ МИНИСТРА.
Dialogue: 0,0:15:05.94,0:15:08.90,Caption,,0,0,0,,НЕ ПИСАТЬ ПОЛИТИЧЕСКИХ ПРОГРАММ. ДОСТАТОЧНО ИЗМЕНИТЬ
Dialogue: 0,0:15:08.90,0:15:11.86,Caption,,0,0,0,,УСЛОВИЯ ДОСТУПА. И ВСЯ ТВОЯ КРАСИВАЯ ТЕОРИЯ О
Dialogue: 0,0:15:11.94,0:15:14.74,Caption,,0,0,0,,ТОМ, ЧТО ИНОСТРАНЦЫ НЕ ДОЛЖНЫ ВЛИЯТЬ НА ВНУТРЕННЮЮ
Dialogue: 0,0:15:14.82,0:15:18.66,Caption,,0,0,0,,ПОЛИТИКУ, СТАЛКИВАЕТСЯ С ОЧЕНЬ ПРОСТОЙ РЕАЛЬНОСТЬЮ. ЧЕМ БОЛЬШЕ
Dialogue: 0,0:15:18.66,0:15:20.98,Caption,,0,0,0,,ЧУЖИХ РЕСУРСОВ ВСТРОЕНО В ТВОЮ СИСТЕМУ,
Dialogue: 0,0:15:21.30,0:15:23.62,Caption,,0,0,0,,ТЕМ МЕНЬШЕ У ТЕБЯ ВОЗМОЖНОСТЕЙ ДЕЛАТЬ ВИД,
Dialogue: 0,0:15:23.79,0:15:26.34,Caption,,0,0,0,,ЧТО РЕШЕНИЯ ВЛАДЕЛЬЦЕВ ЭТИХ РЕСУРСОВ ТЕБЯ НЕ
Dialogue: 0,0:15:26.34,0:15:28.66,Caption,,0,0,0,,КАСАЮТСЯ. И ЗДЕСЬ УЖЕ НЕ ТАК ВАЖНО,
Dialogue: 0,0:15:28.82,0:15:31.46,Caption,,0,0,0,,ФАМИЛИЯ ЭТОГО ЧЕЛОВЕКА МАСК, ТРАМП,
Dialogue: 0,0:15:31.62,0:15:36.74,Caption,,0,0,0,,САНЧЕС ИЛИ КРОЗЕТТО. МЕХАНИЗМ ОДИН И ТОТ ЖЕ. КТО КОНТРОЛИРУЕТ ТО,
Dialogue: 0,0:15:36.82,0:15:38.50,Caption,,0,0,0,,БЕЗ ЧЕГО ТЕБЕ ТРУДНО ОБОЙТИСЬ,
Dialogue: 0,0:15:38.82,0:15:41.78,Caption,,0,0,0,,ТОТ ПОЛУЧАЕТ ВОЗМОЖНОСТЬ ВЛИЯТЬ НА ТВОИ РЕШЕНИЯ. НЕ
