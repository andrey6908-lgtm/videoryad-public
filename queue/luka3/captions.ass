Dialogue: 0,0:00:00.12,0:00:04.84,Caption,,0,0,0,,У ЛУКАШЕНКО, Я СМОТРЮ, ПЛАН ДОВОЛЬНО ПРОСТОЙ. В БЛИЖАЙШИЕ МЕСЯЦЫ ВОЙНА
Dialogue: 0,0:00:04.84,0:00:07.00,Caption,,0,0,0,,ЗАКОНЧИТСЯ. А ЕСЛИ НЕ ЗАКОНЧИТСЯ,
Dialogue: 0,0:00:07.40,0:00:09.88,Caption,,0,0,0,,МОЖЕМ ПРИЕХАТЬ УЖЕ В ТРЕТЬЮ МИРОВУЮ. НОРМАЛЬНАЯ
Dialogue: 0,0:00:09.96,0:00:12.20,Caption,,0,0,0,,ТАКАЯ РАЗВИЛКА. ОСОБЕННО ЕСЛИ УЧЕСТЬ,
Dialogue: 0,0:00:12.52,0:00:15.24,Caption,,0,0,0,,ЧТО НИКТО ПОКА ТОЛКОМ НЕ ОБЪЯСНИЛ ОДНУ МАЛЕНЬКУЮ
Dialogue: 0,0:00:15.24,0:00:18.28,Caption,,0,0,0,,ДЕТАЛЬ. А ЧТО ИМЕННО ЗА ЭТИ НЕСКОЛЬКО МЕСЯЦЕВ
Dialogue: 0,0:00:18.28,0:00:23.32,Caption,,0,0,0,,ДОЛЖНО ИЗМЕНИТЬСЯ? ЛУКАШЕНКО ОБЪЯСНИЛ ПРОСТО. СИЛ НЕТ. РЕСУРСОВ НЕТ.
Dialogue: 0,0:00:23.53,0:00:26.20,Caption,,0,0,0,,ВСЕ УСТАЛИ. ПОЭТОМУ, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:00:26.52,0:00:29.32,Caption,,0,0,0,,ВОЙНА ЗАКОНЧИТСЯ УЖЕ В БЛИЖАЙШИЕ МЕСЯЦЫ. А ЕСЛИ
Dialogue: 0,0:00:29.32,0:00:31.40,Caption,,0,0,0,,НЕ ОСТАНОВИТЬСЯ И ПРОДОЛЖИТЬ ЭСКАЛАЦИЮ,
Dialogue: 0,0:00:31.56,0:00:35.64,Caption,,0,0,0,,ДАЛЬШЕ ТРЕТЬЯ МИРОВАЯ, ПРИЧЁМ УЖЕ С ЯДЕРНОЙ ПЕРСПЕКТИВОЙ. КРАСИВО.
Dialogue: 0,0:00:36.60,0:00:38.84,Caption,,0,0,0,,МЕЖДУ МИРОМ И МИРОВОЙ ВОЙНОЙ ОСТАЛОСЬ ТОЛЬКО
Dialogue: 0,0:00:38.84,0:00:41.72,Caption,,0,0,0,,ОБЪЯСНИТЬ ОДНУ МЕЛОЧЬ. КАК ИЗ НЫНЕШНЕГО ТУПИКА
Dialogue: 0,0:00:41.72,0:00:43.40,Caption,,0,0,0,,ВООБЩЕ ВЫБРАТЬСЯ В СТОРОНУ МИРА?
Dialogue: 0,0:00:43.98,0:00:45.64,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:45.84,0:00:48.52,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО УСТАЛОСТЬ САМА ПО СЕБЕ
Dialogue: 0,0:00:48.52,0:00:51.24,Caption,,0,0,0,,ДОГОВОРЫ НЕ ПОДПИСЫВАЕТ. УСТАВШИЙ ЧЕЛОВЕК ХОЧЕТ
Dialogue: 0,0:00:51.24,0:00:55.08,Caption,,0,0,0,,СПАТЬ. УСТАВШАЯ СТРАНА ХОЧЕТ ЗАКОНЧИТЬ ВОЙНУ. НО
Dialogue: 0,0:00:55.16,0:00:57.72,Caption,,0,0,0,,ЕСЛИ ДВЕ СТОРОНЫ ХОТЯТ ЗАКОНЧИТЬ ЕЁ СОВЕРШЕННО ПО
Dialogue: 0,0:00:57.72,0:01:01.48,Caption,,0,0,0,,РАЗНОМУ, ОТ ОБЩЕЙ УСТАЛОСТИ УСЛОВИЯ ПОЧЕМУ ТО ОДИНАКОВЫМИ НЕ
Dialogue: 0,0:01:01.48,0:01:04.84,Caption,,0,0,0,,СТАНОВЯТСЯ. И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ САМОЕ НЕУДОБНОЕ.
Dialogue: 0,0:01:05.23,0:01:08.04,Caption,,0,0,0,,ЧЕРЕЗ НЕДЕЛЮ, ДЕСЯТОГО И ОДИННАДЦАТОГО НОЯБРЯ,
Dialogue: 0,0:01:08.44,0:01:12.44,Caption,,0,0,0,,РОССИЯ, УКРАИНА И СОЕДИНЁННЫЕ ШТАТЫ СОБИРАЮТСЯ В АБУ ДАБИ.
Dialogue: 0,0:01:12.64,0:01:18.23,Caption,,0,0,0,,УИТКОФФ УЖЕ ОБЪЯВИЛ ПОВЕСТКУ. БЕЗОПАСНОСТЬ ПОСЛЕ ВОЙНЫ,
Dialogue: 0,0:01:18.53,0:01:21.67,Caption,,0,0,0,,СНИЖЕНИЕ ЭСКАЛАЦИИ, ГУМАНИТАРНЫЕ ВОПРОСЫ,
Dialogue: 0,0:01:21.89,0:01:24.87,Caption,,0,0,0,,ДАЛЬНЕЙШЕЕ УРЕГУЛИРОВАНИЕ. СЛОВА ХОРОШИЕ.
Dialogue: 0,0:01:25.32,0:01:27.67,Caption,,0,0,0,,АККУРАТНЫЕ. ЕСЛИ ЧИТАТЬ МЕДЛЕННО,
Dialogue: 0,0:01:27.91,0:01:32.55,Caption,,0,0,0,,ПОЧТИ ПАХНЕТ МИРОМ. РОССИЙСКУЮ ДЕЛЕГАЦИЮ СНОВА ВОЗГЛАВИТ ВЛАДИМИР
Dialogue: 0,0:01:32.55,0:01:35.19,Caption,,0,0,0,,МЕДИНСКИЙ. И ЭТО ОЧЕНЬ ИНТЕРЕСНАЯ ДЕТАЛЬ.
Dialogue: 0,0:01:35.74,0:01:37.83,Caption,,0,0,0,,ПОТОМУ ЧТО МЕДИНСКИЙ НЕ НОВЫЙ ЧЕЛОВЕК,
Dialogue: 0,0:01:38.06,0:01:41.19,Caption,,0,0,0,,КОТОРОГО ВНЕЗАПНО ДОСТАЛИ ИЗ ШКАФА СО СЛОВАМИ СЕЙЧАС
Dialogue: 0,0:01:41.19,0:01:44.15,Caption,,0,0,0,,ПОПРОБУЕМ ПО ДРУГОМУ. ЭТО ТОТ ЖЕ ПЕРЕГОВОРЩИК,
Dialogue: 0,0:01:44.47,0:01:46.71,Caption,,0,0,0,,КОТОРЫЙ УЖЕ ПРЕДСТАВЛЯЛ РОССИЙСКУЮ ПОЗИЦИЮ НА
Dialogue: 0,0:01:46.71,0:01:49.67,Caption,,0,0,0,,ПРЕДЫДУЩИХ РАУНДАХ. А ЗА ЧЕТЫРЕ ДНЯ ДО ОБЪЯВЛЕНИЯ
Dialogue: 0,0:01:49.75,0:01:52.55,Caption,,0,0,0,,ЕГО УЧАСТИЯ ЛАВРОВ СКАЗАЛ ПРЯМЫМ ТЕКСТОМ ПОЗИЦИЯ
Dialogue: 0,0:01:52.63,0:01:57.03,Caption,,0,0,0,,РОССИИ НЕ ИЗМЕНИЛАСЬ. ВОТ ТУТ УЖЕ ХОЧЕТСЯ ВЗЯТЬ КАРАНДАШ. ЛУКАШЕНКО
Dialogue: 0,0:01:57.03,0:01:59.75,Caption,,0,0,0,,ГОВОРИТ, СКОРО ВСЁ ЗАКОНЧИТСЯ. ЛАВРОВ ГОВОРИТ,
Dialogue: 0,0:02:00.04,0:02:03.11,Caption,,0,0,0,,РОССИЙСКАЯ ПОЗИЦИЯ ПРЕЖНЯЯ. МЕДИНСКИЙ СНОВА ЕДЕТ ЕЁ
Dialogue: 0,0:02:03.11,0:02:06.31,Caption,,0,0,0,,ПРЕДСТАВЛЯТЬ. ХОРОШО. ТОГДА СЛЕДУЮЩИЙ ВОПРОС. КТО
Dialogue: 0,0:02:06.31,0:02:09.75,Caption,,0,0,0,,ИЗМЕНИЛ СВОЮ? ПОТОМУ ЧТО РОССИЙСКИЕ УСЛОВИЯ ИЗВЕСТНЫ НЕ ПЕРВЫЙ
Dialogue: 0,0:02:09.75,0:02:13.91,Caption,,0,0,0,,ДЕНЬ. МОСКВА ТРЕБУЕТ, ЧТОБЫ УКРАИНА ОТКАЗАЛАСЬ ОТ ВСТУПЛЕНИЯ В НАТО.
Dialogue: 0,0:02:14.23,0:02:16.79,Caption,,0,0,0,,ТРЕБУЕТ НЕЙТРАЛЬНОГО СТАТУСА. ТРЕБУЕТ ВЫВОДА
Dialogue: 0,0:02:16.87,0:02:18.95,Caption,,0,0,0,,УКРАИНСКИХ ВОЙСК ИЗ ЧЕТЫРЁХ РЕГИОНОВ,
Dialogue: 0,0:02:19.16,0:02:22.15,Caption,,0,0,0,,КОТОРЫЕ РОССИЯ СЧИТАЕТ СВОЕЙ ТЕРРИТОРИЕЙ. РЕЧЬ ИДЁТ
Dialogue: 0,0:02:22.27,0:02:24.71,Caption,,0,0,0,,И ОБ ОГРАНИЧЕНИЯХ ВОЕННОГО ПОТЕНЦИАЛА УКРАИНЫ,
Dialogue: 0,0:02:24.94,0:02:27.83,Caption,,0,0,0,,И О БОЛЕЕ ШИРОКОЙ СИСТЕМЕ БЕЗОПАСНОСТИ. КИЕВ ВСЁ
Dialogue: 0,0:02:27.91,0:02:30.79,Caption,,0,0,0,,ЭТО ПРЕКРАСНО ЗНАЕТ. И ПРИНИМАТЬ РОССИЙСКИЙ ПАКЕТ НЕ
Dialogue: 0,0:02:30.79,0:02:36.12,Caption,,0,0,0,,СОБИРАЕТСЯ. ТЕРРИТОРИИ ПРИЗНАВАТЬ РОССИЙСКИМИ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:02:36.35,0:02:39.56,Caption,,0,0,0,,ВОЕННУЮ СИСТЕМУ РАЗБИРАТЬ НЕ СОБИРАЕТСЯ. ОТ ЗАПАДНЫХ
Dialogue: 0,0:02:39.56,0:02:42.68,Caption,,0,0,0,,ГАРАНТИЙ ОТКАЗЫВАТЬСЯ НЕ СОБИРАЕТСЯ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:02:42.68,0:02:45.56,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ ПЕРЕГОВОРНАЯ КОНСТРУКЦИЯ. РОССИЯ
Dialogue: 0,0:02:45.56,0:02:48.20,Caption,,0,0,0,,ГОВОРИТ, УСЛОВИЯ ИЗВЕСТНЫ. УКРАИНА ГОВОРИТ,
Dialogue: 0,0:02:48.42,0:02:51.24,Caption,,0,0,0,,ЭТИ УСЛОВИЯ НЕ ПРИНИМАЕМ. ВСЕ ОСТАЛЬНЫЕ ГОВОРЯТ,
Dialogue: 0,0:02:51.48,0:02:53.72,Caption,,0,0,0,,МИР БЛИЗКО. ГДЕ ИМЕННО ОН БЛИЗКО?
Dialogue: 0,0:02:53.94,0:02:55.64,Caption,,0,0,0,,ЗА ДВЕРЬЮ СТОИТ? В ЛИФТЕ ЕДЕТ?
Dialogue: 0,0:02:55.69,0:02:57.96,Caption,,0,0,0,,МОЖЕТ, ДОМ ПЕРЕПУТАЛ? ПОДПИШИТЕСЬ,
Dialogue: 0,0:02:58.12,0:03:02.60,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ ПУТИН ПУБЛИЧНО
Dialogue: 0,0:03:02.60,0:03:06.12,Caption,,0,0,0,,НАЗЫВАЛ УСЛОВИЯ ПРЕКРАЩЕНИЯ ВОЙНЫ. ВЫВОД УКРАИНСКИХ
Dialogue: 0,0:03:06.20,0:03:12.12,Caption,,0,0,0,,ВОЙСК ИЗ ДОНЕЦКОЙ, ЛУГАНСКОЙ, ХЕРСОНСКОЙ И ЗАПОРОЖСКОЙ ОБЛАСТЕЙ. ОТКАЗ ОТ НАТО.
Dialogue: 0,0:03:12.44,0:03:17.00,Caption,,0,0,0,,НЕЙТРАЛЬНЫЙ, ВНЕБЛОКОВЫЙ И БЕЗЪЯДЕРНЫЙ СТАТУС. КИЕВ ТОГДА НАЗВАЛ
Dialogue: 0,0:03:17.00,0:03:19.72,Caption,,0,0,0,,ЭТО ТРЕБОВАНИЕМ КАПИТУЛЯЦИИ. ЛЕТОМ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:03:19.72,0:03:21.80,Caption,,0,0,0,,ДВАДЦАТЬ ШЕСТОГО ПЕСКОВ СНОВА СКАЗАЛ,
Dialogue: 0,0:03:21.96,0:03:24.52,Caption,,0,0,0,,ЧТО РОССИЙСКАЯ ПОЗИЦИЯ ПО УСЛОВИЯМ МИРА НЕ
Dialogue: 0,0:03:24.52,0:03:27.64,Caption,,0,0,0,,ИЗМЕНИЛАСЬ. ТО ЕСТЬ ЗДЕСЬ НЕТ НИКАКОЙ ЗАГАДКИ. ВСЕ
Dialogue: 0,0:03:27.64,0:03:30.20,Caption,,0,0,0,,ВСЁ СЛЫШАЛИ. И ВОТ ТЕПЕРЬ ЛУКАШЕНКО ГОВОРИТ,
Dialogue: 0,0:03:30.36,0:03:32.52,Caption,,0,0,0,,ЧТО ЧЕРЕЗ НЕСКОЛЬКО МЕСЯЦЕВ ВСЁ ЗАКОНЧИТСЯ.
Dialogue: 0,0:03:32.73,0:03:34.76,Caption,,0,0,0,,ПРЕКРАСНО. ТОГДА КТО СДАЁТ НАЗАД?
Dialogue: 0,0:03:34.97,0:03:37.48,Caption,,0,0,0,,РОССИЯ? ПОКАЖИТЕ, ГДЕ ОНА ОБЪЯВИЛА,
Dialogue: 0,0:03:37.64,0:03:40.44,Caption,,0,0,0,,ЧТО БОЛЬШЕ НЕ ТРЕБУЕТ НЕЙТРАЛЬНОГО СТАТУСА УКРАИНЫ.
Dialogue: 0,0:03:40.80,0:03:43.72,Caption,,0,0,0,,УКРАИНА? ПОКАЖИТЕ, ГДЕ КИЕВ СКАЗАЛ,
Dialogue: 0,0:03:43.80,0:03:46.44,Caption,,0,0,0,,ЧТО ПРИНИМАЕТ РОССИЙСКИЕ ТЕРРИТОРИАЛЬНЫЕ УСЛОВИЯ.
Dialogue: 0,0:03:46.65,0:03:49.48,Caption,,0,0,0,,ЕВРОПА? СЕЙЧАС ПОКАЖУ, ЧТО ДЕЛАЕТ ЕВРОПА.
Dialogue: 0,0:03:51.67,0:03:54.23,Caption,,0,0,0,,И ВОТ ТАМ СЛОВО МИР НАЧИНАЕТ ЗВУЧАТЬ ОСОБЕННО
Dialogue: 0,0:03:54.23,0:03:58.15,Caption,,0,0,0,,ВЕСЕЛО. ДЕВЯТОГО НОЯБРЯ, ЗА ДЕНЬ ДО ПЕРЕГОВОРОВ В АБУ ДАБИ,
Dialogue: 0,0:03:58.50,0:04:01.51,Caption,,0,0,0,,В ПОЛЬШЕ НАЧИНАЮТСЯ КРУПНЫЕ УЧЕНИЯ МНОГОНАЦИОНАЛЬНЫХ
Dialogue: 0,0:04:01.51,0:04:03.99,Caption,,0,0,0,,СИЛ ДЛЯ УКРАИНЫ. ДВЕ ТЫСЯЧИ ВОСЕМЬСОТ
Dialogue: 0,0:04:03.99,0:04:07.51,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. БРИТАНИЯ И ФРАНЦИЯ РУКОВОДЯТ. КРОМЕ
Dialogue: 0,0:04:07.59,0:04:10.15,Caption,,0,0,0,,НИХ, УЧАСТВУЮТ БЕЛЬГИЯ, ЭСТОНИЯ,
Dialogue: 0,0:04:10.24,0:04:12.95,Caption,,0,0,0,,ГЕРМАНИЯ, ЛИТВА, НИДЕРЛАНДЫ,
Dialogue: 0,0:04:13.12,0:04:18.39,Caption,,0,0,0,,ПОЛЬША, ИСПАНИЯ, ШВЕЦИЯ И ТУРЦИЯ. ОДИННАДЦАТЬ СТРАН. И ВСЕ
Dialogue: 0,0:04:18.39,0:04:20.95,Caption,,0,0,0,,ОДИННАДЦАТЬ ВХОДЯТ В НАТО. НО БРИТАНСКОЕ
Dialogue: 0,0:04:21.03,0:04:23.67,Caption,,0,0,0,,МИНИСТЕРСТВО ОБОРОНЫ СПЕЦИАЛЬНО ОБЪЯСНЯЕТ ЭТО НЕ
Dialogue: 0,0:04:23.67,0:04:27.03,Caption,,0,0,0,,НАТО. НУ КОНЕЧНО. БРИТАНСКИЕ ВОЕННЫЕ ЯВЛЯЮТСЯ
Dialogue: 0,0:04:27.03,0:04:30.31,Caption,,0,0,0,,ВОЕННЫМИ СТРАНЫ НАТО. ФРАНЦУЗСКИЕ ЯВЛЯЮТСЯ ВОЕННЫМИ
Dialogue: 0,0:04:30.31,0:04:33.11,Caption,,0,0,0,,СТРАНЫ НАТО. НЕМЕЦКИЕ, ПОЛЬСКИЕ,
Dialogue: 0,0:04:33.19,0:04:36.23,Caption,,0,0,0,,ЭСТОНСКИЕ, ЛИТОВСКИЕ, ИСПАНСКИЕ,
Dialogue: 0,0:04:36.38,0:04:39.11,Caption,,0,0,0,,ТУРЕЦКИЕ ТОЖЕ. ВСЕ ОДИННАДЦАТЬ СТРАН,
Dialogue: 0,0:04:39.27,0:04:44.31,Caption,,0,0,0,,УЧАСТВУЮЩИХ В УЧЕНИЯХ, СОСТОЯТ В НАТО. НО САМА ОПЕРАЦИЯ НЕ НАТОВСКАЯ.
Dialogue: 0,0:04:44.62,0:04:47.03,Caption,,0,0,0,,ОЧЕНЬ ВАЖНАЯ ТОНКОСТЬ. ПРЯМ ПРЕДСТАВЛЯЮ,
Dialogue: 0,0:04:47.27,0:04:49.43,Caption,,0,0,0,,КАК В МОСКВЕ ОТКРЫВАЮТ ДОКУМЕНТ И ГОВОРЯТ ФУХ,
Dialogue: 0,0:04:49.67,0:04:52.31,Caption,,0,0,0,,НУ СЛАВА БОГУ. МЫ УЖЕ ПОДУМАЛИ БРИТАНСКАЯ АРМИЯ
Dialogue: 0,0:04:52.31,0:04:55.03,Caption,,0,0,0,,ПРИЕХАЛА. А ЭТО ПРОСТО БРИТАНСКАЯ АРМИЯ БЕЗ
Dialogue: 0,0:04:55.03,0:04:57.43,Caption,,0,0,0,,НАТОВСКОЙ НАКЛЕЙКИ. ТОГДА НИКАКИХ ВОПРОСОВ.
Dialogue: 0,0:04:58.04,0:04:59.59,Caption,,0,0,0,,ОСОБЕННО ЗАБАВНО ЭТО ВЫГЛЯДИТ,
Dialogue: 0,0:04:59.85,0:05:03.27,Caption,,0,0,0,,ЕСЛИ ВСПОМНИТЬ, О ЧЁМ РОССИЯ ГОВОРИЛА ЕЩЁ ДО ФЕВРАЛЯ ДВЕ
Dialogue: 0,0:05:03.35,0:05:09.94,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА. МОСКВА ГОДАМИ НАЗЫВАЛА РАСШИРЕНИЕ НАТО И ПРОДВИЖЕНИЕ
Dialogue: 0,0:05:09.94,0:05:12.26,Caption,,0,0,0,,ЗАПАДНОЙ ВОЕННОЙ ИНФРАСТРУКТУРЫ К РОССИЙСКИМ
Dialogue: 0,0:05:12.26,0:05:15.94,Caption,,0,0,0,,ГРАНИЦАМ УГРОЗОЙ СОБСТВЕННОЙ БЕЗОПАСНОСТИ. В ДЕКАБРЕ
Dialogue: 0,0:05:16.02,0:05:18.18,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА РОССИЯ ВООБЩЕ
Dialogue: 0,0:05:18.26,0:05:20.74,Caption,,0,0,0,,ПЕРЕДАЛА США И НАТО ПРОЕКТЫ СОГЛАШЕНИЙ ПО
Dialogue: 0,0:05:20.82,0:05:23.54,Caption,,0,0,0,,БЕЗОПАСНОСТИ. УКРАИНА, НАТО,
Dialogue: 0,0:05:23.73,0:05:25.70,Caption,,0,0,0,,ИНОСТРАННАЯ ВОЕННАЯ ИНФРАСТРУКТУРА,
Dialogue: 0,0:05:25.86,0:05:31.14,Caption,,0,0,0,,РАКЕТЫ, РАЗМЕЩЕНИЕ СИЛ, ВСЁ ЭТО БЫЛО В ЦЕНТРЕ СПОРА. ДВАДЦАТЬ ЧЕТВЁРТОГО
Dialogue: 0,0:05:31.14,0:05:34.10,Caption,,0,0,0,,ФЕВРАЛЯ ПУТИН СНОВА НАЗВАЛ РАСШИРЕНИЕ НАТО И
Dialogue: 0,0:05:34.10,0:05:37.06,Caption,,0,0,0,,ПРИБЛИЖЕНИЕ ЕГО ВОЕННОЙ ИНФРАСТРУКТУРЫ ОДНИМ ИЗ
Dialogue: 0,0:05:37.14,0:05:39.62,Caption,,0,0,0,,КЛЮЧЕВЫХ АРГУМЕНТОВ РОССИЙСКОГО РЕШЕНИЯ НАЧАТЬ
Dialogue: 0,0:05:39.62,0:05:42.66,Caption,,0,0,0,,ВОЕННУЮ ОПЕРАЦИЮ. МОЖНО СОГЛАШАТЬСЯ С РОССИЙСКИМ
Dialogue: 0,0:05:42.66,0:05:46.90,Caption,,0,0,0,,ОБЪЯСНЕНИЕМ ПРИЧИН ВОЙНЫ, МОЖНО НЕ СОГЛАШАТЬСЯ. НО СДЕЛАТЬ ВИД,
Dialogue: 0,0:05:47.14,0:05:49.14,Caption,,0,0,0,,ЧТО НИКТО НИКОГДА ЭТОГО НЕ СЛЫШАЛ,
Dialogue: 0,0:05:49.30,0:05:52.10,Caption,,0,0,0,,УЖЕ НЕ ПОЛУЧИТСЯ. ПОЧТИ ПЯТЬ ЛЕТ ИДЁТ ВОЙНА.
Dialogue: 0,0:05:52.56,0:05:55.46,Caption,,0,0,0,,ПЯТЬ ЛЕТ ОБСУЖДАЮТ НАТО. ПЯТЬ ЛЕТ ОБСУЖДАЮТ
Dialogue: 0,0:05:55.46,0:05:58.82,Caption,,0,0,0,,БЕЗОПАСНОСТЬ РОССИИ. ПЯТЬ ЛЕТ ОБСУЖДАЮТ БЕЗОПАСНОСТЬ
Dialogue: 0,0:05:58.82,0:06:00.90,Caption,,0,0,0,,УКРАИНЫ. И ВОТ НАКОНЕЦ ПРИДУМАЛИ,
Dialogue: 0,0:06:01.14,0:06:03.94,Caption,,0,0,0,,КАК ОБЕСПЕЧИТЬ ДОЛГИЙ МИР. ВВЕСТИ НА УКРАИНУ
Dialogue: 0,0:06:03.94,0:06:07.30,Caption,,0,0,0,,ВООРУЖЁННЫЕ ПОДРАЗДЕЛЕНИЯ ГОСУДАРСТВ НАТО. РЕБЯТА,
Dialogue: 0,0:06:07.51,0:06:11.14,Caption,,0,0,0,,ВЫ ГДЕ БЫЛИ ВСЁ ЭТО ВРЕМЯ? А ДОКУМЕНТЫ ДВАДЦАТЬ ПЕРВОГО ГОДА У ВАС ГДЕ?
Dialogue: 0,0:06:11.37,0:06:12.90,Caption,,0,0,0,,ПОД НОЖКОЙ ШАТКОГО СТОЛА ЛЕЖАТ?
Dialogue: 0,0:06:13.30,0:06:15.30,Caption,,0,0,0,,БРИТАНСКОЕ МИНИСТЕРСТВО ОБОРОНЫ ПИШЕТ,
Dialogue: 0,0:06:15.62,0:06:18.42,Caption,,0,0,0,,ЧТО ЭТИ СИЛЫ ДОЛЖНЫ ПОЯВИТЬСЯ ПОСЛЕ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:06:18.50,0:06:24.15,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ. ОНИ ДОЛЖНЫ ПОМОГАТЬ ВОССТАНАВЛИВАТЬ УКРАИНСКУЮ
Dialogue: 0,0:06:24.15,0:06:28.39,Caption,,0,0,0,,АРМИЮ, УСИЛИВАТЬ ЕЁ, ОБЕСПЕЧИВАТЬ БЕЗОПАСНОСТЬ В ВОЗДУХЕ И НА МОРЕ.
Dialogue: 0,0:06:28.86,0:06:31.27,Caption,,0,0,0,,ПРИЧЁМ БРИТАНЦЫ ОТДЕЛЬНО ПОДЧЁРКИВАЮТ ЭТО НЕ
Dialogue: 0,0:06:31.27,0:06:34.63,Caption,,0,0,0,,МИРОТВОРЦЫ. ЕЩЁ ЛУЧШЕ. ТО ЕСТЬ ЭТО НЕ НЕЙТРАЛЬНЫЙ
Dialogue: 0,0:06:34.63,0:06:37.59,Caption,,0,0,0,,КОНТИНГЕНТ, КОТОРЫЙ ВСТАНЕТ МЕЖДУ ДВУМЯ СТОРОНАМИ,
Dialogue: 0,0:06:37.75,0:06:39.75,Caption,,0,0,0,,БУДЕТ СМОТРЕТЬ В БИНОКЛЬ И ЗАПИСЫВАТЬ,
Dialogue: 0,0:06:39.91,0:06:43.35,Caption,,0,0,0,,КТО ПЕРВЫМ НАРУШИЛ ДОГОВОР. НЕТ. ЭТО ВОЕННАЯ СИЛА
Dialogue: 0,0:06:43.43,0:06:48.07,Caption,,0,0,0,,НА СТОРОНЕ УКРАИНЫ, ЗАДАЧА КОТОРОЙ УКРЕПЛЯТЬ УКРАИНСКУЮ АРМИЮ И ПОМОГАТЬ
Dialogue: 0,0:06:48.07,0:06:50.63,Caption,,0,0,0,,ЕЙ СДЕРЖИВАТЬ РОССИЮ. ТУТ ХОТЯ БЫ ВСЁ ЧЕСТНО.
Dialogue: 0,0:06:50.87,0:06:52.95,Caption,,0,0,0,,В ЯНВАРСКОМ ДОКУМЕНТЕ БРИТАНИИ,
Dialogue: 0,0:06:53.03,0:06:56.87,Caption,,0,0,0,,ФРАНЦИИ И УКРАИНЫ ПРОПИСАНО ЕЩЁ ИНТЕРЕСНЕЕ. ЭТИМ
Dialogue: 0,0:06:56.87,0:06:59.43,Caption,,0,0,0,,СИЛАМ ПРЕДОСТАВЛЯЕТСЯ ПРАВО ПРИМЕНЯТЬ СИЛУ ДЛЯ
Dialogue: 0,0:06:59.43,0:07:02.39,Caption,,0,0,0,,ВЫПОЛНЕНИЯ СВОЕЙ МИССИИ И ЗАЩИТЫ СОБСТВЕННОГО
Dialogue: 0,0:07:02.39,0:07:07.67,Caption,,0,0,0,,ПЕРСОНАЛА, ТЕХНИКИ, ИНФРАСТРУКТУРЫ И УКРАИНЫ. ЭТО ВООРУЖЁННЫЕ
Dialogue: 0,0:07:07.67,0:07:10.71,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЯ. У НИХ ЕСТЬ ОРУЖИЕ. У НИХ ЕСТЬ
Dialogue: 0,0:07:10.71,0:07:13.99,Caption,,0,0,0,,КОМАНДОВАНИЕ. У НИХ ЕСТЬ ЗАДАЧИ. ИМ РАЗРЕШЕНО
Dialogue: 0,0:07:13.99,0:07:17.59,Caption,,0,0,0,,ПРИМЕНЯТЬ СИЛУ. THE TIMES ПИШЕТ ЕЩЁ ПРЯМЕЕ. ЕСЛИ
Dialogue: 0,0:07:17.59,0:07:19.91,Caption,,0,0,0,,РОССИЙСКИЕ ВОЙСКА АТАКУЮТ БРИТАНЦЕВ ИЛИ ИХ
Dialogue: 0,0:07:19.91,0:07:22.71,Caption,,0,0,0,,СОЮЗНИКОВ, ТЕ ПОЛУЧАТ ПРАВО СТРЕЛЯТЬ В ОТВЕТ.
Dialogue: 0,0:07:23.42,0:07:26.31,Caption,,0,0,0,,ВОТ ТЕПЕРЬ УБИРАЕМ КРАСИВУЮ УПАКОВКУ. РЕЧЬ НЕ О
Dialogue: 0,0:07:26.39,0:07:29.91,Caption,,0,0,0,,ТОМ, ЧТО КАКИЕ ТО ИНОСТРАННЫЕ СОЛДАТЫ СТАНУТ АБСТРАКТНЫМИ
Dialogue: 0,0:07:29.99,0:07:33.75,Caption,,0,0,0,,ВОЕННЫМИ ЦЕЛЯМИ. ВОЕННАЯ ЦЕЛЬ БЫВАЕТ РАЗНАЯ. СКЛАД
Dialogue: 0,0:07:33.81,0:07:38.15,Caption,,0,0,0,,ТОЖЕ ВОЕННАЯ ЦЕЛЬ. РАДАР ВОЕННАЯ ЦЕЛЬ. АНГАР ВОЕННАЯ
Dialogue: 0,0:07:38.15,0:07:40.15,Caption,,0,0,0,,ЦЕЛЬ. АНГАР В ОТВЕТ НЕ СТРЕЛЯЕТ.
Dialogue: 0,0:07:42.44,0:07:44.68,Caption,,0,0,0,,А ЗДЕСЬ БУДУТ СТОЯТЬ РЕГУЛЯРНЫЕ ПОДРАЗДЕЛЕНИЯ
Dialogue: 0,0:07:44.68,0:07:46.60,Caption,,0,0,0,,ЕВРОПЕЙСКИХ АРМИЙ. ПРЕДСТАВИМ,
Dialogue: 0,0:07:46.84,0:07:49.96,Caption,,0,0,0,,ЧТО РОССИЙСКИЕ СИЛЫ НАНОСЯТ УДАР. БРИТАНЦЫ ОТВЕЧАЮТ.
Dialogue: 0,0:07:50.12,0:07:53.56,Caption,,0,0,0,,ФРАНЦУЗЫ ОТВЕЧАЮТ. ДАЛЬШЕ РОССИЙСКИЕ ВОЙСКА ОТВЕЧАЮТ
Dialogue: 0,0:07:53.64,0:07:56.04,Caption,,0,0,0,,НА ИХ ОТВЕТ. ДАЛЬШЕ НУЖНЫ БОЕПРИПАСЫ,
Dialogue: 0,0:07:56.27,0:07:58.92,Caption,,0,0,0,,АВИАЦИЯ, ПВО, ПОДКРЕПЛЕНИЯ,
Dialogue: 0,0:07:59.00,0:08:02.92,Caption,,0,0,0,,СВЯЗЬ, РАЗВЕДКА. ПОЗДРАВЛЯЮ. ВОТ У НАС УЖЕ НЕ РОССИЯ
Dialogue: 0,0:08:02.92,0:08:06.12,Caption,,0,0,0,,ВОЮЕТ С УКРАИНОЙ. У НАС РОССИЙСКАЯ АРМИЯ ВЕДЁТ
Dialogue: 0,0:08:06.12,0:08:08.68,Caption,,0,0,0,,БОЙ С АРМИЯМИ ГОСУДАРСТВ НАТО. И ВСЁ ЭТО
Dialogue: 0,0:08:08.68,0:08:12.36,Caption,,0,0,0,,ПРЕДЛАГАЕТСЯ КАК КОНСТРУКЦИЯ, КОТОРАЯ ДОЛЖНА ОБЕСПЕЧИТЬ МИР.
Dialogue: 0,0:08:13.04,0:08:16.28,Caption,,0,0,0,,ВОТ ТУТ ДАЖЕ ШУТИТЬ ТРУДНО. СИТУАЦИЯ САМА ПРЕКРАСНО
Dialogue: 0,0:08:16.28,0:08:19.00,Caption,,0,0,0,,СПРАВЛЯЕТСЯ. РОССИЯ ЕЩЁ ЛЕТОМ СКАЗАЛА,
Dialogue: 0,0:08:19.10,0:08:21.32,Caption,,0,0,0,,ЧТО ИНОСТРАННЫЕ ВОЙСКА НА УКРАИНЕ ДЛЯ НЕЁ
Dialogue: 0,0:08:21.32,0:08:26.36,Caption,,0,0,0,,НЕПРИЕМЛЕМЫ. И ЗАЯВИЛА, ЧТО ТАКИЕ ПОДРАЗДЕЛЕНИЯ СТАНУТ ЗАКОННЫМИ ЦЕЛЯМИ ДЛЯ
Dialogue: 0,0:08:26.36,0:08:30.20,Caption,,0,0,0,,РОССИЙСКОЙ АРМИИ. ЕВРОПЕЙЦЫ УСЛЫШАЛИ. ПОДУМАЛИ. И
Dialogue: 0,0:08:30.20,0:08:33.00,Caption,,0,0,0,,НАЧАЛИ ГОТОВИТЬ УЧЕНИЯ ПО ИХ РАЗВЁРТЫВАНИЮ. ОЧЕНЬ
Dialogue: 0,0:08:33.00,0:08:36.36,Caption,,0,0,0,,ПРОДУКТИВНЫЙ ДИАЛОГ. ПРИЧЁМ ЭТО НЕ БУМАЖНЫЙ КРУЖОК
Dialogue: 0,0:08:36.36,0:08:39.48,Caption,,0,0,0,,ПО ИНТЕРЕСАМ. БРИТАНСКОЕ МИНОБОРОНЫ ТРЕТЬЕГО НОЯБРЯ
Dialogue: 0,0:08:39.48,0:08:42.67,Caption,,0,0,0,,СПЕЦИАЛЬНО ПОХВАСТАЛОСЬ ЭТО УЖЕ РЕАЛЬНАЯ СИЛА. ОНА
Dialogue: 0,0:08:42.67,0:08:45.72,Caption,,0,0,0,,ГОТОВИТСЯ К РАЗВЁРТЫВАНИЮ. ЕСТЬ КОМАНДУЮЩИЙ. ЕСТЬ
Dialogue: 0,0:08:45.79,0:08:49.32,Caption,,0,0,0,,ШТАБ. ЕСТЬ СТРАНЫ УЧАСТНИЦЫ. ЕСТЬ СУХОПУТНАЯ ЧАСТЬ.
Dialogue: 0,0:08:49.48,0:08:52.92,Caption,,0,0,0,,ЕСТЬ АВИАЦИЯ. ЕСТЬ МОРСКОЙ КОМПОНЕНТ. ЕСТЬ ОТРАБОТКА
Dialogue: 0,0:08:52.92,0:08:57.48,Caption,,0,0,0,,ПЕРЕБРОСКИ ЛЮДЕЙ, ТЕХНИКИ И СНАБЖЕНИЯ. ДЕВЯТОГО НОЯБРЯ ОНИ НАЧИНАЮТ
Dialogue: 0,0:08:57.48,0:09:00.67,Caption,,0,0,0,,ТРЕНИРОВКУ. ДЕСЯТОГО НОЯБРЯ НАЧИНАЮТСЯ ПЕРЕГОВОРЫ В
Dialogue: 0,0:09:00.67,0:09:04.00,Caption,,0,0,0,,АБУ ДАБИ. КАЛЕНДАРЬ,
Dialogue: 0,0:09:04.15,0:09:07.04,Caption,,0,0,0,,КОНЕЧНО, ПРЕКРАСЕН. В ПОНЕДЕЛЬНИК ОТРАБАТЫВАЕМ,
Dialogue: 0,0:09:07.28,0:09:10.32,Caption,,0,0,0,,КАК ЗАВЕСТИ ЕВРОПЕЙСКИЕ ВОЙСКА В УКРАИНУ. ВО ВТОРНИК
Dialogue: 0,0:09:10.40,0:09:13.20,Caption,,0,0,0,,ОБСУЖДАЕМ С РОССИЕЙ БУДУЩИЕ ГАРАНТИИ БЕЗОПАСНОСТИ.
Dialogue: 0,0:09:13.44,0:09:18.64,Caption,,0,0,0,,ГЛАВНОЕ ПАПКИ НЕ ПЕРЕПУТАТЬ. А ТЕПЕРЬ ВЕРНЁМСЯ К ИСХОДНОЙ ПРОБЛЕМЕ. ЗАПАДНОЕ
Dialogue: 0,0:09:18.64,0:09:21.36,Caption,,0,0,0,,ВОЕННОЕ ПРИСУТСТВИЕ НА УКРАИНЕ БЫЛО ОДНИМ ИЗ ГЛАВНЫХ
Dialogue: 0,0:09:21.44,0:09:24.08,Caption,,0,0,0,,ПРЕДМЕТОВ СПОРА ЕЩЁ ДО НАЧАЛА ВОЙНЫ. А ТЕПЕРЬ
Dialogue: 0,0:09:24.16,0:09:27.84,Caption,,0,0,0,,ЕГО ПРЕДЛАГАЮТ КАК ГАРАНТИЮ ОКОНЧАНИЯ ВОЙНЫ. ЭТО УЖЕ
Dialogue: 0,0:09:27.84,0:09:31.04,Caption,,0,0,0,,ДАЖЕ НЕ КРУГ. ЭТО КАКОЙ ТО ГЕОПОЛИТИЧЕСКИЙ БЕГ
Dialogue: 0,0:09:31.12,0:09:34.32,Caption,,0,0,0,,НА МЕСТЕ. ТОЛЬКО ДОРОЖКА СТОИТ НЕСКОЛЬКО СОТЕН ТЫСЯЧ
Dialogue: 0,0:09:34.32,0:09:37.52,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКИХ ЖИЗНЕЙ И ОГРОМНЫЕ ДЕНЬГИ. И ОСОБЕННО
Dialogue: 0,0:09:37.60,0:09:42.40,Caption,,0,0,0,,ИНТЕРЕСНО, ЧТО ЭТУ СИЛУ НАЗЫВАЮТ ГАРАНТИЕЙ БЕЗОПАСНОСТИ. ЧЬЕЙ?
Dialogue: 0,0:09:42.76,0:09:46.40,Caption,,0,0,0,,УКРАИНСКОЙ, ПОНЯТНО. А РОССИЙСКАЯ БЕЗОПАСНОСТЬ ГДЕ В ЭТОЙ
Dialogue: 0,0:09:46.40,0:09:50.00,Caption,,0,0,0,,ФОРМУЛЕ? ЕЁ СОБИРАЮТСЯ ОБСУЖДАТЬ В АБУ ДАБИ. СНАЧАЛА
Dialogue: 0,0:09:50.00,0:09:53.84,Caption,,0,0,0,,БРИТАНЦЫ, ФРАНЦУЗЫ И ОСТАЛЬНЫЕ ГОТОВЯТ ВОЕННУЮ СИЛУ ДЛЯ
Dialogue: 0,0:09:53.84,0:09:56.80,Caption,,0,0,0,,УКРАИНЫ. ПОТОМ АМЕРИКАНЦЫ САДЯТСЯ С РОССИЯНАМИ
Dialogue: 0,0:09:56.80,0:09:59.92,Caption,,0,0,0,,ОБСУЖДАТЬ ОБЩУЮ АРХИТЕКТУРУ БЕЗОПАСНОСТИ. ВОТ ТАКОЙ
Dialogue: 0,0:09:59.92,0:10:02.48,Caption,,0,0,0,,КОНСТРУКТОР. ДЕТАЛИ ОТ РАЗНЫХ НАБОРОВ,
Dialogue: 0,0:10:02.66,0:10:06.88,Caption,,0,0,0,,ИНСТРУКЦИЯ ПОТЕРЯЛАСЬ, ЗАТО КОРОБКА КРАСИВАЯ. РОССИЯ ГОВОРИТ,
Dialogue: 0,0:10:07.12,0:10:10.08,Caption,,0,0,0,,ЧТО НЕ ХОЧЕТ ЗАПАДНЫХ ВОЙСК НА УКРАИНЕ. ЕВРОПА
Dialogue: 0,0:10:10.08,0:10:13.28,Caption,,0,0,0,,ГОТОВИТ ЗАПАДНЫЕ ВОЙСКА ДЛЯ УКРАИНЫ. УКРАИНА ХОЧЕТ
Dialogue: 0,0:10:13.28,0:10:17.20,Caption,,0,0,0,,ГАРАНТИИ, ЧТО РОССИЯ СНОВА НЕ НАЧНЁТ ВОЙНУ. РОССИЯ ХОЧЕТ
Dialogue: 0,0:10:17.20,0:10:20.56,Caption,,0,0,0,,ГАРАНТИИ, ЧТО УКРАИНА НЕ ПРЕВРАТИТСЯ В ЗАПАДНЫЙ ВОЕННЫЙ
Dialogue: 0,0:10:20.64,0:10:26.12,Caption,,0,0,0,,ПЛАЦДАРМ. И ТЕПЕРЬ ВСЕ ЭТИ ЧЕТЫРЕ ПРЕДЛОЖЕНИЯ НАДО КАКИМ
Dialogue: 0,0:10:26.12,0:10:29.00,Caption,,0,0,0,,ТО ЧУДОМ ПРЕВРАТИТЬ В ОДИН ДОКУМЕНТ. ВОТ ЭТО
Dialogue: 0,0:10:29.00,0:10:32.12,Caption,,0,0,0,,УЖЕ ДЕЙСТВИТЕЛЬНО ПЕРЕГОВОРЫ. НЕ РАЗГОВОР О ТОМ,
Dialogue: 0,0:10:32.36,0:10:35.56,Caption,,0,0,0,,КАК КРАСИВО НАЗВАТЬ СОГЛАШЕНИЕ. А РАЗГОВОР О ТОМ,
Dialogue: 0,0:10:35.79,0:10:39.96,Caption,,0,0,0,,КТО ОТКАЖЕТСЯ ОТ ТОГО, ЧТО СЧИТАЕТ ВОПРОСОМ СОБСТВЕННОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:10:40.26,0:10:42.04,Caption,,0,0,0,,ПОТОМУ ЧТО ДРУГОГО СПОСОБА ЗДЕСЬ НЕТ.
Dialogue: 0,0:10:42.67,0:10:45.96,Caption,,0,0,0,,МОЖНО ДЕСЯТЬ РАЗ СКАЗАТЬ ПРОЧНЫЙ МИР. МОЖНО ДВАДЦАТЬ
Dialogue: 0,0:10:46.04,0:10:48.92,Caption,,0,0,0,,РАЗ СКАЗАТЬ ГАРАНТИИ. МОЖНО СОБРАТЬ ТРИДЦАТЬ ПЯТЬ
Dialogue: 0,0:10:49.00,0:10:51.88,Caption,,0,0,0,,СТРАН В КОАЛИЦИЮ ЖЕЛАЮЩИХ. НО ЕСЛИ ВАША ГАРАНТИЯ
Dialogue: 0,0:10:51.88,0:10:55.00,Caption,,0,0,0,,БЕЗОПАСНОСТИ ДЛЯ ОДНОЙ СТОРОНЫ ВЫГЛЯДИТ ДЛЯ ДРУГОЙ
Dialogue: 0,0:10:55.00,0:10:58.60,Caption,,0,0,0,,КАК ТА САМАЯ УГРОЗА, ИЗ ЗА КОТОРОЙ ВЫ ПЯТЬ ЛЕТ ВОЮЕТЕ,
Dialogue: 0,0:10:58.98,0:11:02.04,Caption,,0,0,0,,ПРОБЛЕМА НЕ ИСЧЕЗАЕТ ОТ НОВОГО НАЗВАНИЯ. СЛОВО
Dialogue: 0,0:11:02.04,0:11:05.00,Caption,,0,0,0,,КОАЛИЦИЯ НЕ ДЕЛАЕТ БРИТАНСКОГО СОЛДАТА МЕНЕЕ
Dialogue: 0,0:11:05.00,0:11:08.60,Caption,,0,0,0,,БРИТАНСКИМ. СЛОВО МНОГОНАЦИОНАЛЬНАЯ НЕ ВЫКЛЮЧАЕТ
Dialogue: 0,0:11:08.68,0:11:11.80,Caption,,0,0,0,,ОРУЖИЕ. СЛОВО СДЕРЖИВАНИЕ НЕ ПРЕВРАЩАЕТ ВООРУЖЁННОЕ
Dialogue: 0,0:11:11.80,0:11:15.40,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЕ В НАБЛЮДАТЕЛЕЙ ОБСЕ. А СЛОВО МИР НЕ
Dialogue: 0,0:11:15.40,0:11:17.48,Caption,,0,0,0,,ОТМЕНЯЕТ ВОПРОС, ЧТО ПРОИЗОЙДЁТ,
Dialogue: 0,0:11:17.72,0:11:20.44,Caption,,0,0,0,,ЕСЛИ РОССИЙСКАЯ И БРИТАНСКАЯ АРМИИ НАЧНУТ СТРЕЛЯТЬ
Dialogue: 0,0:11:20.44,0:11:23.88,Caption,,0,0,0,,ДРУГ В ДРУГА. ВОТ ТУТ ЛУКАШЕНКО СО СВОЕЙ ТРЕТЬЕЙ МИРОВОЙ УЖЕ
Dialogue: 0,0:11:23.96,0:11:26.76,Caption,,0,0,0,,ЗВУЧИТ СОВСЕМ ИНАЧЕ. ПОТОМУ ЧТО ЛУЧШИЙ СПОСОБ
Dialogue: 0,0:11:26.84,0:11:29.56,Caption,,0,0,0,,ПОЛУЧИТЬ ПРЯМОЕ СТОЛКНОВЕНИЕ РОССИИ СО СТРАНАМИ НАТО
Dialogue: 0,0:11:29.79,0:11:32.52,Caption,,0,0,0,,ТРУДНО ПРИДУМАТЬ. НЕ ГДЕ ТО В ТЕОРИИ. НЕ
Dialogue: 0,0:11:32.60,0:11:35.96,Caption,,0,0,0,,ЧЕРЕЗ ЗАЯВЛЕНИЯ. НЕ ЧЕРЕЗ ОЧЕРЕДНОЙ СПОР В СОВБЕЗЕ
Dialogue: 0,0:11:36.04,0:11:41.20,Caption,,0,0,0,,ООН. А БУКВАЛЬНО ПОСТАВИТЬ ИХ ВООРУЖЁННЫЕ ПОДРАЗДЕЛЕНИЯ
Dialogue: 0,0:11:41.28,0:11:43.92,Caption,,0,0,0,,НА ОДНОЙ ТЕРРИТОРИИ И ЗАРАНЕЕ ОБЪЯВИТЬ,
Dialogue: 0,0:11:44.15,0:11:47.04,Caption,,0,0,0,,ЧТО ПРИ НАПАДЕНИИ ОНИ БУДУТ ОТВЕЧАТЬ ОГНЁМ. А
Dialogue: 0,0:11:47.12,0:11:51.52,Caption,,0,0,0,,ДАЛЬШЕ НАДЕЯТЬСЯ, ЧТО ВСЕ БУДУТ ВЕСТИ СЕБЯ АККУРАТНО. КОНЕЧНО. ВОЙНЫ
Dialogue: 0,0:11:51.52,0:11:53.92,Caption,,0,0,0,,ВООБЩЕ ИЗВЕСТНЫ ИСКЛЮЧИТЕЛЬНОЙ АККУРАТНОСТЬЮ.
Dialogue: 0,0:11:54.30,0:11:56.64,Caption,,0,0,0,,ОСОБЕННО КОГДА ВОКРУГ СТОЯТ АРМИИ НЕСКОЛЬКИХ
Dialogue: 0,0:11:56.64,0:11:59.36,Caption,,0,0,0,,ГОСУДАРСТВ, НАД НИМИ ЛЕТАЕТ АВИАЦИЯ,
Dialogue: 0,0:11:59.60,0:12:04.00,Caption,,0,0,0,,РЯДОМ РАБОТАЕТ ПВО, ВСЕ ДРУГ ДРУГА СЧИТАЮТ УГРОЗОЙ И У КАЖДОГО
Dialogue: 0,0:12:04.00,0:12:06.24,Caption,,0,0,0,,ОРУЖИЕ УЖЕ ЗАРЯЖЕНО. И ВОТ НА ЭТОМ ФОНЕ
Dialogue: 0,0:12:06.24,0:12:09.84,Caption,,0,0,0,,ЛУКАШЕНКО ГОВОРИТ ОСТАЛОСЬ НЕСКОЛЬКО МЕСЯЦЕВ. МОЖЕТ,
Dialogue: 0,0:12:09.98,0:12:12.16,Caption,,0,0,0,,У НЕГО ДЕЙСТВИТЕЛЬНО ЕСТЬ ИНФОРМАЦИЯ,
Dialogue: 0,0:12:12.28,0:12:14.88,Caption,,0,0,0,,КОТОРОЙ НЕТ У НАС. ОН РЕГУЛЯРНО ОБЩАЕТСЯ С
Dialogue: 0,0:12:14.96,0:12:17.84,Caption,,0,0,0,,ПУТИНЫМ И НАХОДИТСЯ ЗНАЧИТЕЛЬНО БЛИЖЕ К РОССИЙСКОЙ
Dialogue: 0,0:12:17.84,0:12:22.40,Caption,,0,0,0,,ПЕРЕГОВОРНОЙ КУХНЕ, ЧЕМ ЛЮБОЙ ЖУРНАЛИСТ. НО НАМ ПОКА ПОКАЗАЛИ ПУБЛИЧНУЮ
Dialogue: 0,0:12:22.48,0:12:24.72,Caption,,0,0,0,,ЧАСТЬ. А ПУБЛИЧНАЯ ЧАСТЬ ВЫГЛЯДИТ ТАК.
Dialogue: 0,0:12:25.35,0:12:29.60,Caption,,0,0,0,,МОСКВА ГОВОРИТ, ПОЗИЦИЯ НЕ ИЗМЕНИЛАСЬ. КИЕВ КЛЮЧЕВЫЕ РОССИЙСКИЕ
Dialogue: 0,0:12:29.68,0:12:32.48,Caption,,0,0,0,,УСЛОВИЯ НЕ ПРИНИМАЕТ. ЕВРОПА ГОТОВИТ ВОЕННЫЙ
Dialogue: 0,0:12:32.48,0:12:36.48,Caption,,0,0,0,,КОНТИНГЕНТ, ПРОТИВ КОТОРОГО РОССИЯ ВЫСТУПАЕТ КАТЕГОРИЧЕСКИ. ЭТОТ
Dialogue: 0,0:12:36.48,0:12:39.20,Caption,,0,0,0,,КОНТИНГЕНТ СОСТОИТ ИЗ ВООРУЖЁННЫХ СИЛ ГОСУДАРСТВ
Dialogue: 0,0:12:39.28,0:12:42.16,Caption,,0,0,0,,НАТО. ЕМУ ЗАРАНЕЕ ДАЮТ ПРАВО ПРИМЕНЯТЬ СИЛУ.
Dialogue: 0,0:12:42.56,0:12:44.88,Caption,,0,0,0,,РОССИЙСКАЯ СТОРОНА ЗАРАНЕЕ ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:12:45.12,0:12:48.08,Caption,,0,0,0,,ЧТО БУДЕТ СЧИТАТЬ ТАКОЕ ПРИСУТСТВИЕ УГРОЗОЙ. И
Dialogue: 0,0:12:48.08,0:12:52.00,Caption,,0,0,0,,ДЕСЯТОГО НОЯБРЯ ВСЕ ЕДУТ ОБСУЖДАТЬ БЕЗОПАСНОСТЬ. ВОТ
Dialogue: 0,0:12:52.00,0:12:53.52,Caption,,0,0,0,,ТЕПЕРЬ ДЕЙСТВИТЕЛЬНО ИНТЕРЕСНО.
Dialogue: 0,0:12:55.80,0:12:58.52,Caption,,0,0,0,,ЧТО ОНИ ТАМ СОБИРАЮТСЯ ПОЛОЖИТЬ НА СТОЛ ТАКОГО,
Dialogue: 0,0:12:58.72,0:13:02.36,Caption,,0,0,0,,ЧЕГО МЫ ПОКА НЕ ВИДИМ? ПОТОМУ ЧТО МИР НЕ НАСТУПАЕТ ОТ ТОГО,
Dialogue: 0,0:13:02.68,0:13:05.64,Caption,,0,0,0,,ЧТО ПОЛИТИКИ УСТАЛИ ГОВОРИТЬ СЛОВО ВОЙНА. МИР
Dialogue: 0,0:13:05.64,0:13:09.96,Caption,,0,0,0,,НАСТУПАЕТ, КОГДА МЕНЯЮТСЯ УСЛОВИЯ. КОГДА КТО ТО ОТ ЧЕГО
Dialogue: 0,0:13:10.04,0:13:12.92,Caption,,0,0,0,,ТО ОТКАЗЫВАЕТСЯ. КОГДА СТОРОНЫ СОГЛАШАЮТСЯ НА
Dialogue: 0,0:13:12.92,0:13:16.36,Caption,,0,0,0,,ПРАВИЛА, КОТОРЫЕ ПРЕЖДЕ ОТВЕРГАЛИ. А ПОКА МЫ ВИДИМ СОВСЕМ
Dialogue: 0,0:13:16.44,0:13:19.80,Caption,,0,0,0,,ДРУГОЕ. ВСЕ ГОВОРЯТ О СКОРОМ МИРЕ. КАЖДЫЙ ПРОДОЛЖАЕТ
Dialogue: 0,0:13:19.80,0:13:22.44,Caption,,0,0,0,,ГОТОВИТЬСЯ К СВОЕМУ ВАРИАНТУ МИРА. И ЭТИ ВАРИАНТЫ
Dialogue: 0,0:13:22.52,0:13:24.76,Caption,,0,0,0,,ДО СИХ ПОР СМОТРЯТ В РАЗНЫЕ СТОРОНЫ. ТАК
Dialogue: 0,0:13:24.84,0:13:26.68,Caption,,0,0,0,,ЧТО Я БЫ ПОКА НЕ ПОКУПАЛ КАЛЕНДАРЬ И
Dialogue: 0,0:13:26.68,0:13:31.08,Caption,,0,0,0,,НЕ ОБВОДИЛ КРАСНЫМ МЕСЯЦ, КОГДА ВСЁ ЗАКОНЧИТСЯ. СНАЧАЛА ХОТЕЛОСЬ БЫ УВИДЕТЬ
Dialogue: 0,0:13:31.16,0:13:34.28,Caption,,0,0,0,,ОТВЕТ НА КУДА БОЛЕЕ ПРОСТОЙ ВОПРОС. КТО ИМЕННО
Dialogue: 0,0:13:34.28,0:13:37.32,Caption,,0,0,0,,СОБИРАЕТСЯ УСТУПИТЬ В ТОМ, ИЗ ЗА ЧЕГО ОНИ ДО СИХ ПОР НЕ
Dialogue: 0,0:13:37.32,0:13:40.52,Caption,,0,0,0,,ДОГОВОРИЛИСЬ? ПОТОМУ ЧТО БЕЗ ЭТОГО ЛУКАШЕНКО ПРАВ ТОЛЬКО В
Dialogue: 0,0:13:40.52,0:13:43.64,Caption,,0,0,0,,ОДНОЙ ЧАСТИ. РАЗВИЛКА ДЕЙСТВИТЕЛЬНО ЕСТЬ. А ВОТ
Dialogue: 0,0:13:43.72,0:13:46.12,Caption,,0,0,0,,ДОРОЖНОГО ЗНАКА С НАДПИСЬЮ МИР НА НЕЙ ПОКА
Dialogue: 0,0:13:46.20,0:13:46.92,Caption,,0,0,0,,ЧТО ТО НЕ ВИДНО.
