Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,ЕСЛИ FINANCIAL TIMES НИЧЕГО НЕ ПЕРЕПУТАЛА,
Dialogue: 0,0:00:02.78,0:00:05.24,Caption,,0,0,0,,РАЗГОВОР ТАМ БЫЛ ОЧЕНЬ КОРОТКИЙ. ПУТИН,
Dialogue: 0,0:00:05.38,0:00:09.32,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, ПЕРЕСТАЛ УГОВАРИВАТЬ И ПРОСТО НАЗВАЛ УСЛОВИЯ. ПРИЧЁМ
Dialogue: 0,0:00:09.32,0:00:12.76,Caption,,0,0,0,,ТАКИМ ТОНОМ, ПОСЛЕ КОТОРОГО ОБЫЧНО УЖЕ НЕ СПРАШИВАЮТ "А МОЖНО
Dialogue: 0,0:00:12.84,0:00:16.84,Caption,,0,0,0,,ЕЩЁ ПОДУМАТЬ?" И ВОТ ТУТ ВОЗНИКАЕТ НЕПРИЯТНЫЙ ВОПРОС. ЧТО ДОЛЖНО
Dialogue: 0,0:00:16.92,0:00:20.12,Caption,,0,0,0,,БЫЛО ПРОИЗОЙТИ, ЧТОБЫ РАЗГОВОР ДОШЁЛ ДО ТАКОЙ ТОЧКИ?
Dialogue: 0,0:00:20.34,0:00:23.08,Caption,,0,0,0,,ПОТОМУ ЧТО FINANCIAL TIMES ОПИСЫВАЕТ ПОЗИЦИЮ МОСКВЫ
Dialogue: 0,0:00:23.30,0:00:26.44,Caption,,0,0,0,,УЖЕ НЕ КАК ОЧЕРЕДНОЙ ДИПЛОМАТИЧЕСКИЙ ОБМЕН ВЕЖЛИВЫМИ
Dialogue: 0,0:00:26.44,0:00:29.24,Caption,,0,0,0,,ПОЖЕЛАНИЯМИ. ИЗДАНИЕ ССЫЛАЕТСЯ НА ЧЕЛОВЕКА,
Dialogue: 0,0:00:29.48,0:00:31.16,Caption,,0,0,0,,ЗНАКОМОГО С ХОДОМ ПЕРЕГОВОРОВ,
Dialogue: 0,0:00:31.59,0:00:34.20,Caption,,0,0,0,,И ПИШЕТ ПУТИН СЧИТАЕТ УДАРЫ ПО УКРАИНСКОЙ
Dialogue: 0,0:00:34.20,0:00:37.08,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ ОТВЕТОМ НА АТАКИ ПРОТИВ РОССИЙСКИХ
Dialogue: 0,0:00:37.31,0:00:39.80,Caption,,0,0,0,,НЕФТЕПЕРЕРАБАТЫВАЮЩИХ ЗАВОДОВ И КОММЕРЧЕСКИХ
Dialogue: 0,0:00:39.80,0:00:44.28,Caption,,0,0,0,,ОБЪЕКТОВ. КРОМЕ ТОГО, МОСКВА ОБВИНЯЕТ КИЕВ В СРЫВЕ ПРЕЖНИХ ПОПЫТОК
Dialogue: 0,0:00:44.28,0:00:45.96,Caption,,0,0,0,,ДОГОВОРИТЬСЯ О ПРЕКРАЩЕНИИ ОГНЯ.
Dialogue: 0,0:00:46.68,0:00:49.32,Caption,,0,0,0,,ДАЛЬШЕ СМЫСЛ ПЕРЕДАННОЙ ФОРМУЛЫ СТАНОВИТСЯ СОВСЕМ
Dialogue: 0,0:00:49.32,0:00:53.00,Caption,,0,0,0,,ПРОСТЫМ. ПРИНИМАЙТЕ УСЛОВИЯ, ИНАЧЕ БУДЕТЕ ТЕРЯТЬ ИНФРАСТРУКТУРУ.
Dialogue: 0,0:00:53.64,0:00:55.88,Caption,,0,0,0,,ЭТО УЖЕ НЕ ПРИГЛАШЕНИЕ ЕЩЁ РАЗ ВСЁ СПОКОЙНО
Dialogue: 0,0:00:55.96,0:00:57.72,Caption,,0,0,0,,ОБСУДИТЬ ПО ТЕЛЕФОНУ. ОБСУЖДАТЬ,
Dialogue: 0,0:00:57.81,0:01:01.48,Caption,,0,0,0,,ПОХОЖЕ, ПРЕДЛАГАЮТ ТОЛЬКО СКОРОСТЬ ПРИНЯТИЯ РЕШЕНИЯ. ЕСЛИ
Dialogue: 0,0:01:01.56,0:01:04.44,Caption,,0,0,0,,ИМЕННО ТАК ПУТИН ОБОЗНАЧИЛ РОССИЙСКУЮ ПОЗИЦИЮ,
Dialogue: 0,0:01:04.77,0:01:09.32,Caption,,0,0,0,,ТО, ГОСПОДА, ДОИГРАЛИСЬ. ИЗМЕНИЛИСЬ НЕ ОТДЕЛЬНЫЕ СЛОВА,
Dialogue: 0,0:01:09.55,0:01:15.77,Caption,,0,0,0,,А САМ ЯЗЫК ПЕРЕГОВОРОВ. ЕЩЁ НЕДАВНО СПОР ШЁЛ О ЛИНИИ ОСТАНОВКИ,
Dialogue: 0,0:01:16.00,0:01:21.05,Caption,,0,0,0,,СРОКАХ ПРЕКРАЩЕНИЯ ОГНЯ, ГАРАНТИЯХ И ВЗАИМНЫХ ОБЯЗАТЕЛЬСТВАХ. ТЕПЕРЬ ВМЕСТЕ С
Dialogue: 0,0:01:21.05,0:01:24.41,Caption,,0,0,0,,УСЛОВИЯМИ ПРЕДЪЯВЛЯЮТ СЧЁТ ЗА ОТКАЗ. ЕСЛИ ВАМ НУЖНЫ
Dialogue: 0,0:01:24.49,0:01:26.81,Caption,,0,0,0,,ТАКИЕ РАЗБОРЫ БЕЗ ДИПЛОМАТИЧЕСКОЙ ВАТЫ,
Dialogue: 0,0:01:26.95,0:01:30.01,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДЛЯ КИЕВА ЗДЕСЬ НАЧИНАЕТСЯ САМАЯ
Dialogue: 0,0:01:30.09,0:01:32.89,Caption,,0,0,0,,НЕУДОБНАЯ ЧАСТЬ. УКРАИНА ОТВЕЧАЕТ С ПРЯМО
Dialogue: 0,0:01:32.89,0:01:35.77,Caption,,0,0,0,,ПРОТИВОПОЛОЖНОЙ ЛОГИКОЙ. ГЛАВА УКРАИНСКОГО МИДА
Dialogue: 0,0:01:35.85,0:01:39.37,Caption,,0,0,0,,СИБИГА ЗАЯВЛЯЕТ, ЧТО ДАЛЬНОБОЙНЫЕ АТАКИ ПО ТЕРРИТОРИИ РОССИИ
Dialogue: 0,0:01:39.37,0:01:42.89,Caption,,0,0,0,,ПРОДОЛЖАТСЯ. ЕГО ФОРМУЛА ЗВУЧИТ ЭФФЕКТНО ЧЕМ ДАЛЬШЕ
Dialogue: 0,0:01:42.89,0:01:48.49,Caption,,0,0,0,,СПОСОБНА УДАРИТЬ УКРАИНА, ТЕМ БЛИЖЕ ЗАВЕРШЕНИЕ КОНФЛИКТА. РАСЧЁТ ПОНЯТЕН. ЕСЛИ
Dialogue: 0,0:01:48.49,0:01:50.81,Caption,,0,0,0,,РОССИЙСКИЕ ОБЪЕКТЫ БУДУТ ДОСТАВАТЬ НА БОЛЬШЕЙ
Dialogue: 0,0:01:50.81,0:01:54.81,Caption,,0,0,0,,ГЛУБИНЕ, ДАВЛЕНИЕ НА МОСКВУ УСИЛИТСЯ И ЗАСТАВИТ ЕЁ УСТУПИТЬ.
Dialogue: 0,0:01:55.20,0:01:57.77,Caption,,0,0,0,,НО МОСКВА, ЕСЛИ ВЕРИТЬ FINANCIAL TIMES,
Dialogue: 0,0:01:58.09,0:02:01.69,Caption,,0,0,0,,ДЕЛАЕТ ИЗ ТЕХ ЖЕ СОБЫТИЙ ОБРАТНЫЙ ВЫВОД. ПРОДОЛЖАЕТЕ
Dialogue: 0,0:02:01.77,0:02:05.29,Caption,,0,0,0,,АТАКОВАТЬ РОССИЙСКИЕ НПЗ, СКЛАДЫ И КОММЕРЧЕСКИЕ ОБЪЕКТЫ,
Dialogue: 0,0:02:05.53,0:02:07.45,Caption,,0,0,0,,ЗНАЧИТ ЦЕНА ДЛЯ ВАС БУДЕТ РАСТИ,
Dialogue: 0,0:02:07.67,0:02:11.21,Caption,,0,0,0,,И РАСТИ БЫСТРО. ПОЛУЧАЕТСЯ ПОЧТИ ИДЕАЛЬНЫЙ ЗАМКНУТЫЙ
Dialogue: 0,0:02:11.21,0:02:16.17,Caption,,0,0,0,,КРУГ. КИЕВ УВЕРЕН, ЧТО КАЖДЫЙ НОВЫЙ ДАЛЬНИЙ УДАР ПРИБЛИЖАЕТ ФИНАЛ.
Dialogue: 0,0:02:16.57,0:02:20.97,Caption,,0,0,0,,МОСКВА ОТВЕЧАЕТ ТАК, СЛОВНО КАЖДЫЙ ТАКОЙ УДАР ДОБАВЛЯЕТ НОВЫЕ ПУНКТЫ В
Dialogue: 0,0:02:21.05,0:02:24.09,Caption,,0,0,0,,СПИСОК УКРАИНСКИХ ЦЕЛЕЙ. ОБЕ СТОРОНЫ РАССЧИТЫВАЮТ,
Dialogue: 0,0:02:24.34,0:02:27.53,Caption,,0,0,0,,ЧТО ДАВЛЕНИЕ ИСПРАВИТ ЧУЖУЮ АРИФМЕТИКУ. ОСТАЛОСЬ
Dialogue: 0,0:02:27.53,0:02:30.09,Caption,,0,0,0,,ПОНЯТЬ, У КОГО РАНЬШЕ СЛОМАЕТСЯ КАЛЬКУЛЯТОР.
Dialogue: 0,0:02:32.36,0:02:34.92,Caption,,0,0,0,,ПРОБЛЕМА УКРАИНЫ ВОВСЕ НЕ В ОДНОЙ ГРОЗНОЙ ФРАЗЕ
Dialogue: 0,0:02:34.92,0:02:37.80,Caption,,0,0,0,,ПУТИНА. ЗА ГОДЫ КОНФЛИКТА ПОЛИТИКИ ПРОИЗНЕСЛИ
Dialogue: 0,0:02:37.80,0:02:42.04,Caption,,0,0,0,,СТОЛЬКО ГРОЗНЫХ ФРАЗ, ЧТО ИМИ УЖЕ МОЖНО ОТАПЛИВАТЬ НЕБОЛЬШУЮ БИБЛИОТЕКУ.
Dialogue: 0,0:02:42.57,0:02:45.48,Caption,,0,0,0,,ОПАСНОСТЬ В ДРУГОМ. ЧТОБЫ ПЕРЕЙТИ ОТ УГРОЗЫ К
Dialogue: 0,0:02:45.48,0:02:49.00,Caption,,0,0,0,,ДЕЙСТВИЮ, РОССИИ НЕ ТРЕБУЕТСЯ ПРИДУМЫВАТЬ ФАНТАСТИЧЕСКОЕ
Dialogue: 0,0:02:49.08,0:02:52.44,Caption,,0,0,0,,ОРУЖИЕ, СТРОИТЬ С НУЛЯ ДЕСЯТОК ПРЕДПРИЯТИЙ И ПРОСИТЬ ВСЕХ
Dialogue: 0,0:02:52.44,0:02:55.88,Caption,,0,0,0,,ПОДОЖДАТЬ ЕЩЁ ЛЕТ ПЯТЬ. НУЖНЫЕ ВОЗМОЖНОСТИ УЖЕ
Dialogue: 0,0:02:55.88,0:02:58.76,Caption,,0,0,0,,ПРИМЕНЯЮТСЯ. ВО ВРЕМЯ ПОСЛЕДНЕГО КРУПНОГО УДАРА
Dialogue: 0,0:02:58.84,0:03:01.80,Caption,,0,0,0,,ОСНОВНЫМИ ЦЕЛЯМИ СТАЛИ ЭНЕРГЕТИЧЕСКАЯ И ПРОМЫШЛЕННАЯ
Dialogue: 0,0:03:01.80,0:03:04.52,Caption,,0,0,0,,ИНФРАСТРУКТУРА. ПОД АТАКАМИ ОКАЗАЛИСЬ ОБЪЕКТЫ В
Dialogue: 0,0:03:04.60,0:03:06.92,Caption,,0,0,0,,КИЕВСКОМ РЕГИОНЕ, ТРИПОЛЬСКАЯ ТЭС,
Dialogue: 0,0:03:07.08,0:03:10.52,Caption,,0,0,0,,СТОЛИЧНЫЕ ТЭЦ И БОЛЬШИЕ ПОДСТАНЦИИ. ДЛЯ ЖИТЕЛЯ
Dialogue: 0,0:03:10.52,0:03:13.16,Caption,,0,0,0,,ГОРОДА НАЗВАНИЕ РАКЕТЫ В ЭТОЙ СИТУАЦИИ ИНТЕРЕСНЕЕ
Dialogue: 0,0:03:13.16,0:03:16.44,Caption,,0,0,0,,РАЗВЕ ЧТО ВОЕННОГО СПРАВОЧНИКА. ЧЕЛОВЕКА ВОЛНУЕТ,
Dialogue: 0,0:03:16.68,0:03:20.52,Caption,,0,0,0,,ГОРИТ ЛИ ДОМА СВЕТ, ТЕЧЁТ ЛИ ВОДА И МОЖЕТ ЛИ ОН УТРОМ
Dialogue: 0,0:03:20.52,0:03:23.40,Caption,,0,0,0,,ДОЕХАТЬ НА РАБОТУ. ДОСТАТОЧНО ВЫВЕСТИ ИЗ НОРМАЛЬНОГО
Dialogue: 0,0:03:23.48,0:03:25.32,Caption,,0,0,0,,РЕЖИМА НЕСКОЛЬКО КЛЮЧЕВЫХ УЗЛОВ,
Dialogue: 0,0:03:25.74,0:03:27.80,Caption,,0,0,0,,И МЕГАПОЛИС ВНЕЗАПНО ВСПОМИНАЕТ,
Dialogue: 0,0:03:27.96,0:03:30.84,Caption,,0,0,0,,ЧТО ПОЧТИ ВСЯ ЕГО СОВРЕМЕННАЯ ЖИЗНЬ НАЧИНАЕТСЯ С
Dialogue: 0,0:03:30.84,0:03:33.88,Caption,,0,0,0,,ЭЛЕКТРИЧЕСКОЙ РОЗЕТКИ. САМ КИЕВ УЖЕ НЕ СПОРИТ С
Dialogue: 0,0:03:33.88,0:03:36.36,Caption,,0,0,0,,МАСШТАБОМ ПРОБЛЕМЫ. КЛИЧКО ПРИЗНАЁТ,
Dialogue: 0,0:03:36.60,0:03:38.92,Caption,,0,0,0,,ЧТО ПОЛНОСТЬЮ ПЕРЕВЕСТИ СТОЛИЦУ НА ГЕНЕРАТОРЫ
Dialogue: 0,0:03:38.92,0:03:43.80,Caption,,0,0,0,,НЕВОЗМОЖНО. КИЕВУ ТРЕБУЕТСЯ ПРИМЕРНО ДВА ГИГАВАТТА МОЩНОСТИ. ДВА
Dialogue: 0,0:03:43.88,0:03:46.52,Caption,,0,0,0,,ГИГАВАТТА ПРЕДЛАГАЕТСЯ КОМПЕНСИРОВАТЬ ГЕНЕРАТОРАМИ.
Dialogue: 0,0:03:48.80,0:03:51.44,Caption,,0,0,0,,ЭТО ДАВНО НЕ ЗАДАЧА ИЗ СЕРИИ "ДОКУПИМ ДИЗЕЛЬНЫЕ
Dialogue: 0,0:03:51.52,0:03:54.32,Caption,,0,0,0,,УСТАНОВКИ ДЛЯ НЕСКОЛЬКИХ БОЛЬНИЦ". МОЖНО РАССТАВИТЬ
Dialogue: 0,0:03:54.32,0:03:56.08,Caption,,0,0,0,,ГЕНЕРАТОРЫ ВДОЛЬ КАЖДОЙ УЛИЦЫ,
Dialogue: 0,0:03:56.32,0:03:58.64,Caption,,0,0,0,,НО ВМЕСТО ГОРОДСКОЙ ЭНЕРГОСИСТЕМЫ ПОЛУЧИТСЯ
Dialogue: 0,0:03:58.64,0:04:02.00,Caption,,0,0,0,,ГРАНДИОЗНЫЙ ФЕСТИВАЛЬ ДИЗЕЛЬНОГО МОТОРА С ЗАПАХОМ
Dialogue: 0,0:04:02.00,0:04:04.80,Caption,,0,0,0,,ТОПЛИВА И КРУГЛОСУТОЧНОЙ КОНЦЕРТНОЙ ПРОГРАММОЙ.
Dialogue: 0,0:04:05.36,0:04:08.56,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ФОРМУЛИРУЕТ ПОЛОЖЕНИЕ ЕЩЁ ЖЁСТЧЕ. ПО ЕГО
Dialogue: 0,0:04:08.56,0:04:12.24,Caption,,0,0,0,,СЛОВАМ, НА УКРАИНЕ НЕ ОСТАЛОСЬ НИ ОДНОЙ ЭЛЕКТРОСТАНЦИИ,
Dialogue: 0,0:04:12.48,0:04:14.64,Caption,,0,0,0,,КОТОРУЮ СОВСЕМ НЕ ЗАТРОНУЛИ ПОВРЕЖДЕНИЯ.
Dialogue: 0,0:04:15.27,0:04:17.92,Caption,,0,0,0,,ПОСЛЕ ТАКОГО ПРИЗНАНИЯ СЛОВА ОБ УНИЧТОЖЕНИИ
Dialogue: 0,0:04:17.92,0:04:20.80,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ ВОСПРИНИМАЮТСЯ УЖЕ НЕ КАК ОТВЛЕЧЁННАЯ
Dialogue: 0,0:04:20.80,0:04:24.00,Caption,,0,0,0,,УГРОЗА. ОДНО ДЕЛО ОБЕЩАТЬ СЛОМАТЬ КОМУ ТО ЗАБОР,
Dialogue: 0,0:04:24.21,0:04:27.28,Caption,,0,0,0,,ЕСЛИ ЗА НИМ СТОИТ БЕТОННАЯ КРЕПОСТЬ. СОВСЕМ ДРУГОЕ,
Dialogue: 0,0:04:27.44,0:04:30.16,Caption,,0,0,0,,ЕСЛИ САМ ЗАБОР ДЕРЖИТСЯ НА ПАРЕ СТОЛБОВ,
Dialogue: 0,0:04:30.40,0:04:33.52,Caption,,0,0,0,,ПРОВОЛОКЕ И УДИВИТЕЛЬНОМ ЧЕЛОВЕЧЕСКОМ ОПТИМИЗМЕ.
Dialogue: 0,0:04:33.73,0:04:36.16,Caption,,0,0,0,,ПРИЧЁМ ПОСЛЕДСТВИЯ ДАВНО НЕ ОГРАНИЧИВАЮТСЯ
Dialogue: 0,0:04:36.16,0:04:39.20,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВОМ. В КИЕВЕ ВСЕРЬЁЗ ОБСУЖДАЮТ СЦЕНАРИИ,
Dialogue: 0,0:04:39.36,0:04:42.72,Caption,,0,0,0,,КОТОРЫЕ НЕДАВНО ЗВУЧАЛИ КАК МРАЧНЫЙ АНЕКДОТ. ГЛАВА
Dialogue: 0,0:04:42.72,0:04:45.12,Caption,,0,0,0,,ДЕСНЯНСКОЙ РАЙОННОЙ АДМИНИСТРАЦИИ БАХМАТОВ
Dialogue: 0,0:04:45.12,0:04:49.12,Caption,,0,0,0,,ПРЕДУПРЕЖДАЛ, ЧТО В СЛУЧАЕ ДОЛГОГО ОТКЛЮЧЕНИЯ ЭНЕРГИИ НА ТРОЕЩИНЕ
Dialogue: 0,0:04:49.36,0:04:52.72,Caption,,0,0,0,,МОГУТ ПОТРЕБОВАТЬСЯ УЛИЧНЫЕ ТУАЛЕТЫ. СНАЧАЛА НАД
Dialogue: 0,0:04:52.72,0:04:55.44,Caption,,0,0,0,,ЭТОЙ ИДЕЕЙ ДРУЖНО СМЕЯЛИСЬ. ТЕПЕРЬ БАХМАТОВ
Dialogue: 0,0:04:55.44,0:04:59.04,Caption,,0,0,0,,СООБЩАЕТ, ЧТО ПРЕДЛОЖЕНИЕ ПОДДЕРЖАЛИ УЖЕ ДЛЯ ВСЕГО ГОРОДА.
Dialogue: 0,0:04:59.48,0:05:02.32,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ МЫСЛЬ СОВЕРШИЛА СТРЕМИТЕЛЬНЫЙ РЫВОК.
Dialogue: 0,0:05:04.60,0:05:07.56,Caption,,0,0,0,,ВЧЕРА ВСЕ ШУТИЛИ НАД УЛИЧНЫМИ ТУАЛЕТАМИ. СЕГОДНЯ
Dialogue: 0,0:05:07.56,0:05:12.12,Caption,,0,0,0,,СПОР ИДЁТ О ТОМ, СКОЛЬКО ИХ ПОТРЕБУЕТСЯ И ГДЕ УДОБНЕЕ ПОСТАВИТЬ. ЭТО
Dialogue: 0,0:05:12.20,0:05:14.44,Caption,,0,0,0,,И ЕСТЬ УСКОРЕННЫЙ КУРС ВЗРОСЛЕНИЯ ГОРОДСКОЙ
Dialogue: 0,0:05:14.44,0:05:17.32,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. БАХМАТОВ ЗАДАЁТ И ДРУГОЙ,
Dialogue: 0,0:05:17.53,0:05:20.04,Caption,,0,0,0,,ГОРАЗДО МЕНЕЕ СМЕШНОЙ ВОПРОС. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:05:20.28,0:05:22.36,Caption,,0,0,0,,РЕЗЕРВНЫЕ СИСТЕМЫ ВОДОСНАБЖЕНИЯ,
Dialogue: 0,0:05:22.55,0:05:25.24,Caption,,0,0,0,,ЭЛЕКТРОСНАБЖЕНИЯ И ОТОПЛЕНИЯ НОРМАЛЬНО НЕ
Dialogue: 0,0:05:25.24,0:05:29.32,Caption,,0,0,0,,ПОДГОТОВЛЕНЫ, ХОТЯ НА ГОРОД ВЫДЕЛЯЛИСЬ ОГРОМНЫЕ СРЕДСТВА. КУДА ОНИ
Dialogue: 0,0:05:29.40,0:05:33.40,Caption,,0,0,0,,УШЛИ, ОСТАЁТСЯ ЗАГАДКОЙ ВНУТРЕННЕГО УСТРОЙСТВА СИСТЕМЫ. С
Dialogue: 0,0:05:33.48,0:05:37.24,Caption,,0,0,0,,ОДНОЙ СТОРОНЫ, ВЛАСТИ ОБЕЩАЮТ РАСШИРЯТЬ ДАЛЬНОБОЙНУЮ КАМПАНИЮ
Dialogue: 0,0:05:37.32,0:05:39.16,Caption,,0,0,0,,ПРОТИВ РОССИИ. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:05:39.43,0:05:42.36,Caption,,0,0,0,,В СТОЛИЦЕ РАССЧИТЫВАЮТ, КУДА НАПРАВИТСЯ ЧЕЛОВЕК,
Dialogue: 0,0:05:42.68,0:05:45.40,Caption,,0,0,0,,ЕСЛИ ИЗ ЗА ОТКЛЮЧЁННОГО ЭЛЕКТРИЧЕСТВА ПЕРЕСТАНУТ
Dialogue: 0,0:05:45.40,0:05:48.60,Caption,,0,0,0,,РАБОТАТЬ ВОДЯНЫЕ НАСОСЫ. ГЕОПОЛИТИЧЕСКИЙ РАЗМАХ И
Dialogue: 0,0:05:48.68,0:05:51.64,Caption,,0,0,0,,КОММУНАЛЬНАЯ ГОТОВНОСТЬ НАКОНЕЦ ВСТРЕТИЛИСЬ. ПРАВДА,
Dialogue: 0,0:05:51.73,0:05:54.44,Caption,,0,0,0,,МЕСТО ВСТРЕЧИ ОКАЗАЛОСЬ ВОЗЛЕ УЛИЧНОГО ТУАЛЕТА.
Dialogue: 0,0:05:55.08,0:05:56.84,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ВОЗНИКАЕТ НОВОСТЬ,
Dialogue: 0,0:05:57.08,0:05:59.64,Caption,,0,0,0,,КОТОРАЯ СНАЧАЛА КАЖЕТСЯ СОВЕРШЕННО ОТДЕЛЬНОЙ.
Dialogue: 0,0:06:00.27,0:06:03.32,Caption,,0,0,0,,РОССИЯ ВЫВЕЛА НА ОРБИТУ УЖЕ ТРИДЦАТЬ ДВА СПУТНИКА
Dialogue: 0,0:06:03.32,0:06:06.36,Caption,,0,0,0,,СИСТЕМЫ "РАССВЕТ" И НАМЕРЕНА ПРОДОЛЖИТЬ ЗАПУСКИ.
Dialogue: 0,0:06:06.81,0:06:08.92,Caption,,0,0,0,,УКРАИНСКАЯ ВОЕННАЯ РАЗВЕДКА УТВЕРЖДАЕТ,
Dialogue: 0,0:06:09.19,0:06:11.72,Caption,,0,0,0,,ЧТО ЭТА ГРУППИРОВКА УЖЕ РАБОТАЕТ НАД ТЕРРИТОРИЕЙ
Dialogue: 0,0:06:11.72,0:06:15.08,Caption,,0,0,0,,УКРАИНЫ И ИСПОЛЬЗУЕТСЯ ДЛЯ ВЫПОЛНЕНИЯ ВОЕННЫХ ЗАДАЧ.
Dialogue: 0,0:06:15.48,0:06:18.60,Caption,,0,0,0,,И ТУТ ИНТЕРНЕТ ПРИСТУПАЕТ К ЛЮБИМОМУ СОСТЯЗАНИЮ.
Dialogue: 0,0:06:20.88,0:06:23.68,Caption,,0,0,0,,"РАССВЕТ" СРАВНИВАЮТ СО STARLINK И ТОРЖЕСТВЕННО
Dialogue: 0,0:06:23.68,0:06:27.52,Caption,,0,0,0,,ОБНАРУЖИВАЮТ, ЧТО РОССИЙСКАЯ СЕТЬ МЕНЬШЕ. СПУТНИКОВ НЕМНОГО,
Dialogue: 0,0:06:27.76,0:06:31.52,Caption,,0,0,0,,ГЛОБАЛЬНОГО ПОКРЫТИЯ НЕТ, МИЛЛИОНЫ ТЕРМИНАЛОВ НЕ ПРОИЗВЕДЕНЫ,
Dialogue: 0,0:06:31.76,0:06:35.36,Caption,,0,0,0,,ИНТЕРНЕТ В КАЖДУЮ ДЕРЕВНЮ НЕ ПРОВЕДЁН. НО ЗАЧЕМ
Dialogue: 0,0:06:35.36,0:06:38.24,Caption,,0,0,0,,РОССИИ ПРЯМО СЕЙЧАС ОБЕСПЕЧИВАТЬ СПУТНИКОВЫМ
Dialogue: 0,0:06:38.24,0:06:40.72,Caption,,0,0,0,,ИНТЕРНЕТОМ КАЖДЫЙ КУРЯТНИК НА ПЛАНЕТЕ?
Dialogue: 0,0:06:41.02,0:06:43.20,Caption,,0,0,0,,ДЛЯ ВЕДЕНИЯ БОЕВЫХ ДЕЙСТВИЙ ЕЙ НЕ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:06:43.28,0:06:45.92,Caption,,0,0,0,,ПОМОГАТЬ УСЛОВНОМУ ДЕДУШКЕ ПОСРЕДИ ОКЕАНА СМОТРЕТЬ
Dialogue: 0,0:06:45.92,0:06:47.84,Caption,,0,0,0,,ВИДЕО О ПРАВИЛЬНОЙ ПОСАДКЕ ПОМИДОРОВ.
Dialogue: 0,0:06:48.40,0:06:51.20,Caption,,0,0,0,,ПЕРЕД СИСТЕМОЙ СТОЯТ ДРУГИЕ ЗАДАЧИ. ОНА ДОЛЖНА
Dialogue: 0,0:06:51.20,0:06:54.32,Caption,,0,0,0,,ОБЕСПЕЧИВАТЬ СВЯЗЬ, ПЕРЕДАВАТЬ ДАННЫЕ И КОМАНДЫ,
Dialogue: 0,0:06:54.52,0:06:58.32,Caption,,0,0,0,,ПОМОГАТЬ УПРАВЛЕНИЮ, ПОДДЕРЖИВАТЬ РАБОТУ БЕСПИЛОТНЫХ КОМПЛЕКСОВ И
Dialogue: 0,0:06:58.32,0:07:01.04,Caption,,0,0,0,,ДОСТАВЛЯТЬ ИНФОРМАЦИЮ ВОЕННЫМ ИМЕННО ТОГДА,
Dialogue: 0,0:07:01.32,0:07:04.16,Caption,,0,0,0,,КОГДА ОНА ТРЕБУЕТСЯ. ПО ЭТИМ ФУНКЦИЯМ "РАССВЕТ" И
Dialogue: 0,0:07:04.16,0:07:08.24,Caption,,0,0,0,,СЛЕДУЕТ ОЦЕНИВАТЬ. REUTERS, ССЫЛАЯСЬ НА УКРАИНСКУЮ РАЗВЕДКУ,
Dialogue: 0,0:07:08.32,0:07:12.00,Caption,,0,0,0,,СООБЩАЕТ, ЧТО СЕТЬ УЖЕ ПРИМЕНЯЮТ ДЛЯ СВЯЗИ НАД УКРАИНОЙ.
Dialogue: 0,0:07:12.22,0:07:16.64,Caption,,0,0,0,,И ЧТО ИЗ ЭТОГО СЛЕДУЕТ? МОЛОТОК ТОЖЕ СОВЕРШЕННО БЕСПОЛЕЗЕН ПРИ ПРИГОТОВЛЕНИИ
Dialogue: 0,0:07:16.64,0:07:19.60,Caption,,0,0,0,,КОФЕ. ОДНАКО ЗАБИВАТЬ ГВОЗДИ ЕМУ ЭТО ПОЧЕМУ ТО
Dialogue: 0,0:07:19.68,0:07:22.96,Caption,,0,0,0,,НЕ МЕШАЕТ. ЕСЛИ АРМИИ ТРЕБУЕТСЯ УСТОЙЧИВЫЙ КАНАЛ В
Dialogue: 0,0:07:22.96,0:07:25.20,Caption,,0,0,0,,КОНКРЕТНОМ РАЙОНЕ НА ОПРЕДЕЛЁННОЕ ВРЕМЯ,
Dialogue: 0,0:07:25.44,0:07:28.08,Caption,,0,0,0,,ДЛЯ ЭТОГО НЕ НУЖНО СНАЧАЛА УКУТЫВАТЬ СПУТНИКАМИ ВСЮ
Dialogue: 0,0:07:28.08,0:07:31.12,Caption,,0,0,0,,ЗЕМЛЮ. ТРИДЦАТЬ ДВА АППАРАТА УЖЕ ОБРАЗУЮТ
Dialogue: 0,0:07:31.12,0:07:37.56,Caption,,0,0,0,,ДЕЙСТВУЮЩУЮ ГРУППИРОВКУ. НОВЫЕ ЗАПУСКИ ДОЛЖНЫ УВЕЛИЧИТЬ ЧИСЛО СЕАНСОВ СВЯЗИ,
Dialogue: 0,0:07:37.88,0:07:40.60,Caption,,0,0,0,,РАСШИРИТЬ РАЙОНЫ РАБОТЫ И ПОВЫСИТЬ УСТОЙЧИВОСТЬ
Dialogue: 0,0:07:40.60,0:07:44.52,Caption,,0,0,0,,СИСТЕМЫ. ИМЕННО ПОЭТОМУ ИСТОРИЯ С "РАССВЕТОМ" СВЯЗАНА С
Dialogue: 0,0:07:44.52,0:07:47.64,Caption,,0,0,0,,УЛЬТИМАТУМОМ. КОГДА МОСКВА ОБЕЩАЕТ УСИЛИВАТЬ
Dialogue: 0,0:07:47.64,0:07:49.80,Caption,,0,0,0,,ВОЗДЕЙСТВИЕ НА УКРАИНСКУЮ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:07:50.04,0:07:52.68,Caption,,0,0,0,,СЧИТАТЬ ТОЛЬКО РАКЕТЫ И БЕСПИЛОТНИКИ НЕДОСТАТОЧНО.
Dialogue: 0,0:07:53.07,0:07:55.64,Caption,,0,0,0,,ЗНАЧЕНИЕ ИМЕЕТ ВСЯ ТЕХНИЧЕСКАЯ ЦЕПОЧКА,
Dialogue: 0,0:07:55.88,0:07:58.84,Caption,,0,0,0,,КОТОРАЯ ПОЗВОЛЯЕТ НАХОДИТЬ ЦЕЛИ И ВЫПОЛНЯТЬ ЗАДАЧИ.
Dialogue: 0,0:07:59.06,0:08:01.80,Caption,,0,0,0,,ПОЭТОМУ "РАССВЕТ" НЕЛЬЗЯ РАССМАТРИВАТЬ КАК
Dialogue: 0,0:08:01.80,0:08:06.28,Caption,,0,0,0,,КОСМИЧЕСКУЮ ИГРУШКУ, ЗАПУЩЕННУЮ РАДИ ОТЧЁТА. ЭТО ДОПОЛНИТЕЛЬНАЯ ДЕТАЛЬ
Dialogue: 0,0:08:06.36,0:08:10.36,Caption,,0,0,0,,БОЛЬШОЙ ВОЕННОЙ МАШИНЫ, КОТОРУЮ СОВЕРШЕНСТВУЮТ УЖЕ ВО ВРЕМЯ КОНФЛИКТА.
Dialogue: 0,0:08:10.60,0:08:13.56,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ТЕПЕРЬ ПОСМОТРИМ,
Dialogue: 0,0:08:13.86,0:08:15.88,Caption,,0,0,0,,ЧЕМ НЕОЖИДАННО ПОМОГ МАРК РЮТТЕ.
Dialogue: 0,0:08:16.48,0:08:19.48,Caption,,0,0,0,,ГЕНЕРАЛЬНЫЙ СЕКРЕТАРЬ НАТО РЕШИЛ ВСЛУХ ОБЪЯСНИТЬ
Dialogue: 0,0:08:19.56,0:08:21.96,Caption,,0,0,0,,ОДНУ НЕПРИЯТНУЮ ОСОБЕННОСТЬ РОССИЙСКОЙ ВОЕННОЙ
Dialogue: 0,0:08:21.96,0:08:26.52,Caption,,0,0,0,,ЭКОНОМИКИ. РЮТТЕ ПРИЗНАЁТ, ЧТО ПРИ СОПОСТАВИМЫХ РАСХОДАХ РОССИЯ СПОСОБНА
Dialogue: 0,0:08:26.52,0:08:30.20,Caption,,0,0,0,,ПРИОБРЕСТИ БОЛЬШЕ ВООРУЖЕНИЙ, ЧЕМ ЕВРОПЕЙСКИЕ ГОСУДАРСТВА НАТО.
Dialogue: 0,0:08:30.76,0:08:33.16,Caption,,0,0,0,,НЕ САМАЯ ПРИЯТНАЯ НОВОСТЬ ДЛЯ ЛЮБИТЕЛЕЙ СЧИТАТЬ
Dialogue: 0,0:08:33.16,0:08:37.64,Caption,,0,0,0,,ПОБЕДУ РАЗМЕРОМ БЮДЖЕТА. ДОЛГОЕ ВРЕМЯ ЕВРОПЕЙСКАЯ СХЕМА РАССУЖДЕНИЙ БЫЛА
Dialogue: 0,0:08:37.64,0:08:40.60,Caption,,0,0,0,,ПРЕДЕЛЬНО УДОБНОЙ. ЕВРОПЕЙСКАЯ ЭКОНОМИКА КРУПНЕЕ,
Dialogue: 0,0:08:40.92,0:08:44.76,Caption,,0,0,0,,ДЕНЕГ БОЛЬШЕ, СЛЕДОВАТЕЛЬНО И ВОЕННЫЕ ВОЗМОЖНОСТИ АВТОМАТИЧЕСКИ
Dialogue: 0,0:08:44.76,0:08:47.72,Caption,,0,0,0,,ДОЛЖНЫ БЫТЬ ВЫШЕ. ЗАТЕМ ОБНАРУЖИЛАСЬ МЕРЗКАЯ БЫТОВАЯ
Dialogue: 0,0:08:47.72,0:08:53.20,Caption,,0,0,0,,ПОДРОБНОСТЬ. КОЛИЧЕСТВО ДЕНЕГ ИМЕЕТ ЗНАЧЕНИЕ ТОЛЬКО ВМЕСТЕ С
Dialogue: 0,0:08:53.20,0:08:58.00,Caption,,0,0,0,,КОЛИЧЕСТВОМ ВЕЩЕЙ, КОТОРЫЕ НА НИХ УДАЁТСЯ ПРОИЗВЕСТИ ИЛИ КУПИТЬ. МОЖНО
Dialogue: 0,0:08:58.00,0:09:00.56,Caption,,0,0,0,,ЗАЙТИ В МАГАЗИН С ТЫСЯЧЕЙ ЕВРО И ВЫЙТИ
Dialogue: 0,0:09:00.56,0:09:02.96,Caption,,0,0,0,,С ОДНИМ ДИЗАЙНЕРСКИМ СТУЛОМ ИЗ ЭКОЛОГИЧНОЙ
Dialogue: 0,0:09:02.96,0:09:06.56,Caption,,0,0,0,,ДРЕВЕСИНЫ, СНАБЖЁННЫМ СЕРТИФИКАТОМ УСТОЙЧИВОГО РАЗВИТИЯ,
Dialogue: 0,0:09:06.72,0:09:08.96,Caption,,0,0,0,,БИОГРАФИЕЙ МАСТЕРА И, ВЕРОЯТНО,
Dialogue: 0,0:09:09.12,0:09:12.00,Caption,,0,0,0,,СОБСТВЕННЫМ ПСИХОЛОГОМ. А ЧЕЛОВЕК ИЗ СОСЕДНЕГО
Dialogue: 0,0:09:12.08,0:09:15.20,Caption,,0,0,0,,МАГАЗИНА НА ТУ ЖЕ СУММУ ПРИОБРЕТЁТ ДВАДЦАТЬ ОБЫЧНЫХ
Dialogue: 0,0:09:15.20,0:09:18.48,Caption,,0,0,0,,СТУЛЬЕВ. КОГДА УЧАСТНИКИ ПЕРЕХОДЯТ К ДРАКЕ СТУЛЬЯМИ,
Dialogue: 0,0:09:18.72,0:09:21.36,Caption,,0,0,0,,СЕРТИФИКАТ ЭКОЛОГИЧЕСКОЙ ОТВЕТСТВЕННОСТИ ЗАМЕТНО
Dialogue: 0,0:09:21.36,0:09:24.56,Caption,,0,0,0,,ТЕРЯЕТ УБЕДИТЕЛЬНОСТЬ. ИМЕННО ЭТУ РАЗНИЦУ ОПИСЫВАЕТ
Dialogue: 0,0:09:24.56,0:09:28.32,Caption,,0,0,0,,РЮТТЕ. РОССИЙСКОЕ ВОЕННОЕ ПРОИЗВОДСТВО ДАЁТ БОЛЬШЕ ГОТОВОЙ
Dialogue: 0,0:09:28.32,0:09:30.00,Caption,,0,0,0,,ПРОДУКЦИИ НА ВЛОЖЕННЫЕ СРЕДСТВА,
Dialogue: 0,0:09:30.24,0:09:32.80,Caption,,0,0,0,,ЕСЛИ СРАВНИВАТЬ РЕЗУЛЬТАТ С ЗАПАДНЫМИ РАСХОДАМИ.
Dialogue: 0,0:09:33.19,0:09:35.76,Caption,,0,0,0,,ПОЭТОМУ РЮТТЕ УЖЕ ПРИКИДЫВАЕТ ДЛЯ ЕВРОПЕЙСКИХ
Dialogue: 0,0:09:35.76,0:09:38.80,Caption,,0,0,0,,АВТОКОНЦЕРНОВ ДОМАШНЕЕ ЗАДАНИЕ СКОЛЬКО СНАРЯДОВ И
Dialogue: 0,0:09:38.80,0:09:41.04,Caption,,0,0,0,,БРОНЕВИКОВ МОЖНО ВЫЖАТЬ ИЗ КОНВЕЙЕРОВ,
Dialogue: 0,0:09:41.28,0:09:46.40,Caption,,0,0,0,,ГДЕ ВЧЕРА СОБИРАЛИ ХЭТЧБЕКИ. ЭВОЛЮЦИЯ ПОЛУЧИЛАСЬ ПРЕКРАСНАЯ. СНАЧАЛА ЕВРОПА
Dialogue: 0,0:09:46.48,0:09:50.48,Caption,,0,0,0,,ГОДАМИ УЧИЛА РОССИЮ, ПОЧЕМУ ВОЕННАЯ ЭКОНОМИКА УСТРОЕНА НЕПРАВИЛЬНО.
Dialogue: 0,0:09:50.80,0:09:52.96,Caption,,0,0,0,,ТЕПЕРЬ ЕВРОПЕЙСКИМ АВТОМОБИЛЬНЫМ КОНЦЕРНАМ
Dialogue: 0,0:09:52.96,0:09:56.56,Caption,,0,0,0,,ОБЪЯСНЯЮТ, КАК СРОЧНО ПЕРЕХОДИТЬ НА ПРОИЗВОДСТВО ДЛЯ АРМИИ.
Dialogue: 0,0:09:56.83,0:09:58.48,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ВЕРНЁМСЯ К СЛОВАМ,
Dialogue: 0,0:09:58.56,0:10:04.83,Caption,,0,0,0,,ПЕРЕДАННЫМ FINANCIAL TIMES. СЧИТАТЬ УЛЬТИМАТУМ ОБЫЧНЫМ ЭМОЦИОНАЛЬНЫМ
Dialogue: 0,0:10:04.91,0:10:07.79,Caption,,0,0,0,,ВЫСТУПЛЕНИЕМ ПУТИНА СТАНОВИТСЯ ВСЁ ТРУДНЕЕ. ЕСЛИ
Dialogue: 0,0:10:07.79,0:10:10.43,Caption,,0,0,0,,ИЗДАНИЕ ТОЧНО ИЗЛОЖИЛО РОССИЙСКУЮ ПОЗИЦИЮ,
Dialogue: 0,0:10:10.74,0:10:13.39,Caption,,0,0,0,,МОСКВА СООБЩАЕТ КИЕВУ СЛЕДУЮЩЕЕ ДАЛЬНИЕ УДАРЫ
Dialogue: 0,0:10:13.39,0:10:16.99,Caption,,0,0,0,,ПРОДОЛЖАТСЯ, ЗНАЧИТ ОТВЕТНАЯ ЦЕНА БУДЕТ ПОВЫШАТЬСЯ. ПРИЧЁМ
Dialogue: 0,0:10:16.99,0:10:19.23,Caption,,0,0,0,,ДАВЛЕНИЕ НАПРАВЯТ НА ТУ ЧАСТЬ УКРАИНСКОГО
Dialogue: 0,0:10:19.23,0:10:22.75,Caption,,0,0,0,,ГОСУДАРСТВА, КОТОРАЯ УЖЕ РАБОТАЕТ НА ПРЕДЕЛЕ ВОЗМОЖНОСТЕЙ.
Dialogue: 0,0:10:22.90,0:10:25.23,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ СИСТЕМА ПОЛУЧИЛА СЕРЬЁЗНЫЕ
Dialogue: 0,0:10:25.23,0:10:28.43,Caption,,0,0,0,,ПОВРЕЖДЕНИЯ. ОБЕСПЕЧИТЬ КИЕВ ГЕНЕРАТОРАМИ НЕЛЬЗЯ.
Dialogue: 0,0:10:28.59,0:10:31.23,Caption,,0,0,0,,ГОРОДСКИЕ РУКОВОДИТЕЛИ ГОТОВЯТСЯ К ВАРИАНТАМ ЖИЗНИ,
Dialogue: 0,0:10:31.47,0:10:34.27,Caption,,0,0,0,,КОТОРЫЕ НЕДАВНО КАЗАЛИСЬ САТИРОЙ. РОССИЙСКАЯ
Dialogue: 0,0:10:34.27,0:10:37.23,Caption,,0,0,0,,СПУТНИКОВАЯ СЕТЬ ДЛЯ ВОЕННЫХ ЗАДАЧ РАСШИРЯЕТСЯ.
Dialogue: 0,0:10:37.47,0:10:39.23,Caption,,0,0,0,,ВОЕННАЯ ПРОМЫШЛЕННОСТЬ РОССИИ,
Dialogue: 0,0:10:39.39,0:10:41.07,Caption,,0,0,0,,ПО ПРИЗНАНИЮ РУКОВОДИТЕЛЯ НАТО,
Dialogue: 0,0:10:41.31,0:10:44.43,Caption,,0,0,0,,ПРОИЗВОДИТ БОЛЬШЕ ЗА СРАВНИМЫЕ ДЕНЬГИ. А ОТВЕТ КИЕВА
Dialogue: 0,0:10:44.43,0:10:47.95,Caption,,0,0,0,,ОСТАЁТСЯ ПРЕЖНИМ БУДЕМ НАНОСИТЬ УДАРЫ ЕЩЁ ДАЛЬШЕ.
Dialogue: 0,0:10:48.22,0:10:52.91,Caption,,0,0,0,,ПЕРЕД НАМИ ДВА ЧЕЛОВЕКА, КОТОРЫЕ УВЕРЕННО ИДУТ НАВСТРЕЧУ ДРУГ ДРУГУ. ПОЧЕМУ
Dialogue: 0,0:10:52.99,0:10:54.99,Caption,,0,0,0,,ТО КАЖДЫЙ НЕСЁТ КИРПИЧ И СЧИТАЕТ,
Dialogue: 0,0:10:55.15,0:10:58.19,Caption,,0,0,0,,ЧТО ПЕРВЫМ ИСПУГАЕТСЯ ДРУГОЙ. ВАЖНЕЕ ВСЕГО ЗДЕСЬ
Dialogue: 0,0:10:58.19,0:11:01.07,Caption,,0,0,0,,ДАЖЕ НЕ ВЫЯСНЕНИЕ МОРАЛЬНОЙ ПРАВОТЫ. ПРАКТИЧЕСКИЙ
Dialogue: 0,0:11:01.15,0:11:04.19,Caption,,0,0,0,,ВОПРОС ЗВУЧИТ ПРОЩЕ ЧЬЯ СТРАТЕГИЯ ВЫДЕРЖИТ БОЛЕЕ
Dialogue: 0,0:11:04.19,0:11:08.54,Caption,,0,0,0,,ДОЛГУЮ ПРОВЕРКУ? КИЕВ ПРЕДПОЛАГАЕТ,
Dialogue: 0,0:11:08.77,0:11:14.14,Caption,,0,0,0,,ЧТО АТАКИ ПО РОССИЙСКИМ НПЗ, ХРАНИЛИЩАМ И ДРУГИМ ОБЪЕКТАМ СДЕЛАЮТ ПРОДОЛЖЕНИЕ
Dialogue: 0,0:11:14.14,0:11:16.46,Caption,,0,0,0,,КОНФЛИКТА ДЛЯ МОСКВЫ НАСТОЛЬКО ДОРОГИМ,
Dialogue: 0,0:11:16.70,0:11:19.26,Caption,,0,0,0,,ЧТО РОССИЙСКАЯ СТОРОНА ИЗМЕНИТ СВОИ ТРЕБОВАНИЯ.
Dialogue: 0,0:11:19.78,0:11:22.54,Caption,,0,0,0,,МОСКВА, СУДЯ ПО ПЕРЕСКАЗУ FINANCIAL TIMES,
Dialogue: 0,0:11:22.78,0:11:26.06,Caption,,0,0,0,,РАЗВЕРНУЛА ЭТУ ФОРМУЛУ В ОБРАТНУЮ СТОРОНУ. ХОТИТЕ
Dialogue: 0,0:11:26.06,0:11:27.74,Caption,,0,0,0,,ИСПЫТЫВАТЬ РОССИЙСКУЮ УСТОЙЧИВОСТЬ,
Dialogue: 0,0:11:27.90,0:11:30.62,Caption,,0,0,0,,ПОЖАЛУЙСТА. ТОГДА РОССИЯ ЗАЙМЁТСЯ ИСПЫТАНИЕМ
Dialogue: 0,0:11:30.62,0:11:33.66,Caption,,0,0,0,,УКРАИНСКОЙ. ОДНАКО ИСХОДНЫЕ ВОЗМОЖНОСТИ У СТОРОН
Dialogue: 0,0:11:33.74,0:11:36.78,Caption,,0,0,0,,ЗАМЕТНО РАЗЛИЧАЮТСЯ. У РОССИИ БОЛЬШАЯ ТЕРРИТОРИЯ,
Dialogue: 0,0:11:37.01,0:11:39.18,Caption,,0,0,0,,РАСПРЕДЕЛЁННАЯ ЭНЕРГЕТИЧЕСКАЯ СИСТЕМА,
Dialogue: 0,0:11:39.35,0:11:43.18,Caption,,0,0,0,,СОБСТВЕННЫЕ ЗАПАСЫ ТОПЛИВА, КРУПНАЯ ПРОМЫШЛЕННОСТЬ И СПОСОБНОСТЬ
Dialogue: 0,0:11:43.18,0:11:45.58,Caption,,0,0,0,,ПЕРЕРАСПРЕДЕЛЯТЬ ЧАСТЬ НАГРУЗКИ МЕЖДУ РЕГИОНАМИ.
Dialogue: 0,0:11:46.13,0:11:49.02,Caption,,0,0,0,,УКРАИНА ЗНАЧИТЕЛЬНО МЕНЬШЕ. МНОГИЕ ГЕНЕРИРУЮЩИЕ
Dialogue: 0,0:11:49.02,0:11:52.06,Caption,,0,0,0,,ОБЪЕКТЫ УЖЕ ПОВРЕЖДЕНЫ. ЭНЕРГОСИСТЕМА ПОСТОЯННО
Dialogue: 0,0:11:52.06,0:11:56.14,Caption,,0,0,0,,НАХОДИТСЯ ПОД НАГРУЗКОЙ, А РЕМОНТ ОДНИХ УЗЛОВ ИДЁТ ОДНОВРЕМЕННО С НОВЫМИ
Dialogue: 0,0:11:56.22,0:11:59.10,Caption,,0,0,0,,УДАРАМИ ПО ДРУГИМ. ДЛЯ ЭФФЕКТИВНОГО ДАВЛЕНИЯ ТАКОЙ
Dialogue: 0,0:11:59.10,0:12:01.66,Caption,,0,0,0,,РЕЗУЛЬТАТ И НЕ ТРЕБУЕТСЯ. ДОСТАТОЧНО ДОБИТЬСЯ
Dialogue: 0,0:12:01.66,0:12:05.10,Caption,,0,0,0,,ПОЛОЖЕНИЯ, ПРИ КОТОРОМ КАЖДЫЙ СЛЕДУЮЩИЙ МЕСЯЦ ПОГЛОЩАЕТ ВСЁ
Dialogue: 0,0:12:05.18,0:12:07.42,Caption,,0,0,0,,БОЛЬШЕ ОБОРУДОВАНИЯ, СПЕЦИАЛИСТОВ,
Dialogue: 0,0:12:07.58,0:12:09.90,Caption,,0,0,0,,ДЕНЕГ, РЕЗЕРВОВ И РЕМОНТНЫХ РАБОТ.
Dialogue: 0,0:12:10.60,0:12:13.10,Caption,,0,0,0,,ОДИН ОБЪЕКТ ВЫВЕЛИ ИЗ СТРОЯ. ЕГО НАЧАЛИ
Dialogue: 0,0:12:13.10,0:12:16.46,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬ. В ЭТО ВРЕМЯ ПОВРЕЖДЁН ДРУГОЙ. СЕТЬ
Dialogue: 0,0:12:16.46,0:12:19.66,Caption,,0,0,0,,ПЕРЕВЕЛИ НА РЕЗЕРВНУЮ СХЕМУ. ЗАТЕМ УДАР ПРИШЁЛСЯ ПО
Dialogue: 0,0:12:19.66,0:12:26.02,Caption,,0,0,0,,СЛЕДУЮЩЕМУ ВАЖНОМУ УЗЛУ. ПОСТЕПЕННО ВСЯ СИСТЕМА ПЕРЕСТАЁТ НОРМАЛЬНО
Dialogue: 0,0:12:26.02,0:12:29.06,Caption,,0,0,0,,РАЗВИВАТЬСЯ И ЗАНИМАЕТСЯ БЕСКОНЕЧНЫМ РЕМОНТОМ САМОЙ
Dialogue: 0,0:12:29.06,0:12:32.74,Caption,,0,0,0,,СЕБЯ. ЭТО НАМНОГО НЕПРИЯТНЕЕ ЛЮБЫХ ЭФФЕКТНЫХ СТРЕЛОК НА
Dialogue: 0,0:12:32.82,0:12:35.54,Caption,,0,0,0,,КАРТЕ. СТРЕЛКИ МОЖНО ГОДАМИ ДВИГАТЬ В РАЗНЫЕ
Dialogue: 0,0:12:35.54,0:12:38.90,Caption,,0,0,0,,СТОРОНЫ. НО ВОДА ЧЕЛОВЕКУ ТРЕБУЕТСЯ КАЖДОЕ УТРО.
Dialogue: 0,0:12:39.20,0:12:42.58,Caption,,0,0,0,,СВЕТ НУЖЕН КАЖДЫЙ ВЕЧЕР. МЕТРО ОБЯЗАНО ПЕРЕВОЗИТЬ
Dialogue: 0,0:12:42.58,0:12:46.10,Caption,,0,0,0,,ПАССАЖИРОВ. НАСОСЫ ДОЛЖНЫ ПОДАВАТЬ ВОДУ. В ДОМАХ
Dialogue: 0,0:12:46.10,0:12:49.14,Caption,,0,0,0,,ДОЛЖНО СОХРАНЯТЬСЯ ТЕПЛО. КОГДА ЭТИ ОБЫЧНЫЕ ЗАДАЧИ
Dialogue: 0,0:12:49.14,0:12:51.86,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ В ЕЖЕДНЕВНУЮ ИНЖЕНЕРНУЮ ЛОТЕРЕЮ,
Dialogue: 0,0:12:52.21,0:12:54.26,Caption,,0,0,0,,ЦЕНА КОНФЛИКТА ПЕРЕСТАЁТ ИЗМЕРЯТЬСЯ ТОЛЬКО
Dialogue: 0,0:12:54.26,0:12:57.22,Caption,,0,0,0,,ТЕРРИТОРИЯМИ И РАССТОЯНИЯМИ. ТЕПЕРЬ СНОВА ВСПОМНИМ
Dialogue: 0,0:12:57.22,0:13:00.82,Caption,,0,0,0,,ЗАЯВЛЕНИЕ СИБИГИ. ЧЕМ ДАЛЬШЕ МОЖЕТ УДАРИТЬ УКРАИНА,
Dialogue: 0,0:13:01.05,0:13:03.62,Caption,,0,0,0,,ТЕМ БЛИЖЕ ОКОНЧАНИЕ КОНФЛИКТА. ДОПУСТИМ.
Dialogue: 0,0:13:04.26,0:13:06.90,Caption,,0,0,0,,ТОЛЬКО У ЭТОЙ КРАСИВОЙ ФОРМУЛЫ ПОЯВИЛАСЬ ОТВЕТНАЯ
Dialogue: 0,0:13:06.98,0:13:09.78,Caption,,0,0,0,,ЧАСТЬ. ЧЕМ ГЛУБЖЕ УКРАИНА НАНОСИТ УДАРЫ ПО
Dialogue: 0,0:13:09.86,0:13:13.14,Caption,,0,0,0,,РОССИЙСКОЙ ТЕРРИТОРИИ, ТЕМ ЖЁСТЧЕ МОСКВА ДЕМОНСТРИРУЕТ,
Dialogue: 0,0:13:13.28,0:13:15.78,Caption,,0,0,0,,ЧТО СОБИРАЕТСЯ ДЕЛАТЬ С УКРАИНСКОЙ ИНФРАСТРУКТУРОЙ.
Dialogue: 0,0:13:16.16,0:13:19.46,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ ЧИСТАЯ АРИФМЕТИКА. КАКАЯ СТОРОНА
Dialogue: 0,0:13:19.46,0:13:22.50,Caption,,0,0,0,,БЫСТРЕЕ ПРИБЛИЗИТ ЗАВЕРШЕНИЕ КОНФЛИКТА ИМЕННО К ТОМУ
Dialogue: 0,0:13:22.50,0:13:24.90,Caption,,0,0,0,,ИСХОДУ, КОТОРЫЙ САМА НАЗЫВАЕТ ПОБЕДОЙ?
Dialogue: 0,0:13:25.52,0:13:28.58,Caption,,0,0,0,,ПО ЭТОЙ ПРИЧИНЕ УСЛОВИЯ АНКОРИДЖА ВАЖНЕЕ ОДНОЙ ЯРКОЙ
Dialogue: 0,0:13:28.58,0:13:34.46,Caption,,0,0,0,,ФРАЗЫ ДЛЯ ЗАГОЛОВКА. ЕСЛИ РОССИЯ ДЕЙСТВИТЕЛЬНО СВЯЗАЛА ПРЕКРАЩЕНИЕ
Dialogue: 0,0:13:34.54,0:13:36.78,Caption,,0,0,0,,ДАВЛЕНИЯ С ПРИНЯТИЕМ ОПРЕДЕЛЁННЫХ УСЛОВИЙ,
Dialogue: 0,0:13:37.24,0:13:39.82,Caption,,0,0,0,,ТОГДА АТАКИ НА ИНФРАСТРУКТУРУ СТАНОВЯТСЯ НЕ
Dialogue: 0,0:13:39.82,0:13:41.98,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬЮ ОТДЕЛЬНЫХ ЭПИЗОДОВ,
Dialogue: 0,0:13:42.30,0:13:45.26,Caption,,0,0,0,,А ПОСТОЯННЫМ ИНСТРУМЕНТОМ ПЕРЕГОВОРОВ. ЭТО НЕ
Dialogue: 0,0:13:45.26,0:13:48.78,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ВЫБОР КАЖДОГО ОБЪЕКТА ПРОИСХОДИТ ЛИЧНО ЗА
Dialogue: 0,0:13:48.78,0:13:52.94,Caption,,0,0,0,,ОГРОМНЫМ СТОЛОМ В КРЕМЛЕ, ГДЕ КТО ТО ТОРЖЕСТВЕННО УКАЗЫВАЕТ ПАЛЬЦЕМ НА КАРТУ.
Dialogue: 0,0:13:53.22,0:13:56.62,Caption,,0,0,0,,МЕХАНИЗМ ПРОЩЕ. ЦЕНА СОХРАНЕНИЯ ПРЕЖНЕГО КУРСА ДЛЯ
Dialogue: 0,0:13:56.62,0:13:59.66,Caption,,0,0,0,,КИЕВА ДОЛЖНА ПОСТОЯННО УВЕЛИЧИВАТЬСЯ. ЧАСТО ПРИ
Dialogue: 0,0:13:59.66,0:14:02.38,Caption,,0,0,0,,ОБСУЖДЕНИИ УЛЬТИМАТУМОВ ЗАБЫВАЮТ ВАЖНУЮ ДЕТАЛЬ.
Dialogue: 0,0:14:02.78,0:14:05.26,Caption,,0,0,0,,УЛЬТИМАТУМ СТАНОВИТСЯ УБЕДИТЕЛЬНЫМ НЕ В МОМЕНТ
Dialogue: 0,0:14:05.26,0:14:08.14,Caption,,0,0,0,,ГРОМКОГО УДАРА КУЛАКОМ ПО СТОЛУ. ОН НАЧИНАЕТ
Dialogue: 0,0:14:08.22,0:14:12.06,Caption,,0,0,0,,РАБОТАТЬ ТОГДА, КОГДА АДРЕСАТ ПОНИМАЕТ АВТОР УГРОЗЫ ИМЕЕТ
Dialogue: 0,0:14:12.06,0:14:15.18,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ВЫПОЛНИТЬ ПРОДОЛЖЕНИЕ СВОЕЙ ФРАЗЫ. ВОТ
Dialogue: 0,0:14:15.18,0:14:18.14,Caption,,0,0,0,,ПОЧЕМУ СПУТНИКИ, ПОВРЕЖДЁННЫЕ ЭЛЕКТРОСТАНЦИИ,
Dialogue: 0,0:14:18.32,0:14:20.86,Caption,,0,0,0,,НЕХВАТКА ГЕНЕРАЦИИ И ПРОИЗВОДИТЕЛЬНОСТЬ ВОЕННОЙ
Dialogue: 0,0:14:20.86,0:14:23.50,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ НЕ ЯВЛЯЮТСЯ ВТОРОСТЕПЕННЫМИ
Dialogue: 0,0:14:23.50,0:14:26.06,Caption,,0,0,0,,ПОДРОБНОСТЯМИ. ВМЕСТЕ ОНИ ОБЪЯСНЯЮТ,
Dialogue: 0,0:14:26.38,0:14:30.22,Caption,,0,0,0,,ПОЧЕМУ ТОН МОСКВЫ МОГ НАСТОЛЬКО ИЗМЕНИТЬСЯ. РОССИЯ
Dialogue: 0,0:14:30.22,0:14:33.42,Caption,,0,0,0,,ОЦЕНИВАЕТ СОБСТВЕННЫЕ РЕСУРСЫ. УКРАИНА ОЦЕНИВАЕТ
Dialogue: 0,0:14:33.42,0:14:36.30,Caption,,0,0,0,,СВОИ ВОЗМОЖНОСТИ. КАЖДАЯ СТОРОНА УВЕРЕНА,
Dialogue: 0,0:14:36.51,0:14:38.94,Caption,,0,0,0,,ЧТО ПРОТИВНИК ПЕРВЫМ ПРОИЗНЕСЁТ ХВАТИТ,
Dialogue: 0,0:14:39.18,0:14:41.90,Caption,,0,0,0,,ДАЛЬШЕ СЛИШКОМ ДОРОГО. ПОКА СОБЫТИЯ ПОКАЗЫВАЮТ
Dialogue: 0,0:14:41.90,0:14:45.26,Caption,,0,0,0,,ОБРАТНОЕ. СИБИГА ОБЕЩАЕТ ПРОДОЛЖАТЬ ДАЛЬНИЕ АТАКИ.
Dialogue: 0,0:14:47.53,0:14:50.01,Caption,,0,0,0,,РОССИЯ НАРАЩИВАЕТ ДАВЛЕНИЕ НА ИНФРАСТРУКТУРУ.
Dialogue: 0,0:14:50.38,0:14:52.81,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ОБСУЖДАЮТ РАСШИРЕНИЕ ВОЕННОГО
Dialogue: 0,0:14:52.81,0:14:55.61,Caption,,0,0,0,,ПРОИЗВОДСТВА. РОССИЙСКАЯ ОРБИТАЛЬНАЯ ГРУППИРОВКА
Dialogue: 0,0:14:55.69,0:15:00.25,Caption,,0,0,0,,ПОЛУЧАЕТ НОВЫЕ АППАРАТЫ. УКРАИНСКИМ ГОРОДАМ ПРИХОДИТСЯ ГОТОВИТЬ ВСЁ БОЛЕЕ
Dialogue: 0,0:15:00.25,0:15:03.53,Caption,,0,0,0,,ТЯЖЁЛЫЕ СЦЕНАРИИ РЕЗЕРВНОГО СУЩЕСТВОВАНИЯ. НАПИШИТЕ
Dialogue: 0,0:15:03.53,0:15:06.49,Caption,,0,0,0,,В КОММЕНТАРИЯХ, ЧЕЙ РАСЧЁТ, ПО ВАШЕМУ МНЕНИЮ,
Dialogue: 0,0:15:06.73,0:15:09.69,Caption,,0,0,0,,ПЕРВЫМ СТОЛКНЁТСЯ С ПРЕДЕЛОМ ПРОЧНОСТИ. НО ЗДЕСЬ
Dialogue: 0,0:15:09.69,0:15:14.25,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ВЫВОД, КОТОРЫЙ ВАЖНЕЕ САМОЙ ИСТОРИИ С УЛЬТИМАТУМОМ. КОГДА
Dialogue: 0,0:15:14.25,0:15:16.25,Caption,,0,0,0,,СТОРОНЫ СОЗДАЮТ ВСЁ БОЛЬШЕ СРЕДСТВ,
Dialogue: 0,0:15:16.50,0:15:18.89,Caption,,0,0,0,,ПРЕДНАЗНАЧЕННЫХ ЗАСТАВИТЬ ПРОТИВНИКА УСТУПИТЬ,
Dialogue: 0,0:15:19.29,0:15:22.09,Caption,,0,0,0,,ПЕРЕГОВОРЫ ПОСТЕПЕННО СТАНОВЯТСЯ СОСТЯЗАНИЕМ ЭТИХ
Dialogue: 0,0:15:22.09,0:15:25.53,Caption,,0,0,0,,СРЕДСТВ. КТО РАНЬШЕ ОШИБЁТСЯ В РАСЧЁТЕ. У КОГО
Dialogue: 0,0:15:25.61,0:15:28.73,Caption,,0,0,0,,БЫСТРЕЕ ИССЯКНЕТ ЗАПАС УСТОЙЧИВОСТИ. КТО ПЕРВЫМ
Dialogue: 0,0:15:28.73,0:15:32.17,Caption,,0,0,0,,ПРИЗНАЕТ, ЧТО СЛЕДУЮЩИЙ ШАГ ОБОЙДЁТСЯ ДОРОЖЕ ВОЗМОЖНОГО
Dialogue: 0,0:15:32.17,0:15:36.97,Caption,,0,0,0,,СОГЛАШЕНИЯ. ПРОБЛЕМА В ТОМ, ЧТО НОВЫЙ ИНСТРУМЕНТ ДАВЛЕНИЯ РЕДКО ОСТАЁТСЯ
Dialogue: 0,0:15:36.97,0:15:39.93,Caption,,0,0,0,,СПОКОЙНО ЛЕЖАТЬ НА СКЛАДЕ. ЕСЛИ ЕГО СОЗДАЛИ,
Dialogue: 0,0:15:40.24,0:15:44.33,Caption,,0,0,0,,ЕГО НАЧИНАЮТ ПРИМЕНЯТЬ. У ДАЛЬНОБОЙНЫХ СРЕДСТВ ПОЯВЛЯЮТСЯ ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:15:44.41,0:15:47.45,Caption,,0,0,0,,ЦЕЛИ. НОВАЯ СПУТНИКОВАЯ СВЯЗЬ ПОВЫШАЕТ ИХ
Dialogue: 0,0:15:47.45,0:15:50.41,Caption,,0,0,0,,ВОЗМОЖНОСТИ. РАСШИРЕННАЯ ВОЕННАЯ ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:15:50.41,0:15:53.45,Caption,,0,0,0,,ПРОИЗВОДИТ ОЧЕРЕДНЫЕ ПАРТИИ ВООРУЖЕНИЙ. НОВЫЕ
Dialogue: 0,0:15:53.45,0:15:56.57,Caption,,0,0,0,,ПОВРЕЖДЕНИЯ ПОРОЖДАЮТ НОВЫЕ РЕМОНТЫ. А ПОЛИТИКИ
Dialogue: 0,0:15:56.65,0:16:00.81,Caption,,0,0,0,,СНОВА ОБЕЩАЮТ, ЧТО ИМЕННО СЛЕДУЮЩИЙ ШАГ ОБЯЗАТЕЛЬНО ЗАСТАВИТ
Dialogue: 0,0:16:00.81,0:16:03.45,Caption,,0,0,0,,ПРОТИВОПОЛОЖНУЮ СТОРОНУ ИЗМЕНИТЬ РЕШЕНИЕ.
Dialogue: 0,0:16:05.74,0:16:08.38,Caption,,0,0,0,,КОГДА ОБЕ СТОРОНЫ ОДНОВРЕМЕННО ПОВЫШАЮТ СТАВКИ,
Dialogue: 0,0:16:08.64,0:16:12.06,Caption,,0,0,0,,СЛОВА "НУЖНО ТОЛЬКО ЕЩЁ НЕМНОГО НАДАВИТЬ" ЗВУЧАТ
Dialogue: 0,0:16:12.14,0:16:14.86,Caption,,0,0,0,,ОСОБЕННО ОПАСНО. ПОТОМУ ЧТО В КАКОЙ ТО МОМЕНТ
Dialogue: 0,0:16:14.86,0:16:17.98,Caption,,0,0,0,,МОЖЕТ ОБНАРУЖИТЬСЯ, ЧТО ПЕРЕГОВОРЫ ЗАКОНЧИЛИСЬ УЖЕ ДАВНО.
Dialogue: 0,0:16:18.53,0:16:20.70,Caption,,0,0,0,,А СТАВКИ ПО ИНЕРЦИИ ПРОДОЛЖИЛИ РАСТИ.
