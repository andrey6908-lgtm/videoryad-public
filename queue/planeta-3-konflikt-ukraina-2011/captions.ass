Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ДИПЛОМАТЫ РЕШИЛИ ВЕСТИ ПЕРЕГОВОРЫ О
Dialogue: 0,0:00:02.68,0:00:05.88,Caption,,0,0,0,,ЗАВЕРШЕНИИ КОНФЛИКТА С РОССИЕЙ В ОБХОД САМОЙ РОССИИ.
Dialogue: 0,0:00:06.27,0:00:08.84,Caption,,0,0,0,,ВИДИМО, МОСКВА ДОЛЖНА ПОДОЖДАТЬ В КОРИДОРЕ,
Dialogue: 0,0:00:09.06,0:00:12.92,Caption,,0,0,0,,ПОКА ОСТАЛЬНЫЕ РЕШАТ, НА ЧТО ОНА СОГЛАСИЛАСЬ. ПОТОМ ЕЁ ПОЗОВУТ,
Dialogue: 0,0:00:13.24,0:00:16.52,Caption,,0,0,0,,ПОКАЖУТ ИТОГОВЫЙ ЛИСТ И ВЕЖЛИВО ПОПРОСЯТ НЕ ПОРТИТЬ
Dialogue: 0,0:00:16.52,0:00:19.96,Caption,,0,0,0,,ОБЩУЮ ФОТОГРАФИЮ. ИДЕЯ ЗВУЧАЛА БЫ КАК ПАРОДИЯ,
Dialogue: 0,0:00:20.20,0:00:23.00,Caption,,0,0,0,,ЕСЛИ БЫ ЕЁ НЕ ВЫСКАЗАЛ ВПОЛНЕ НАСТОЯЩИЙ ЕВРОПЕЙСКИЙ
Dialogue: 0,0:00:23.00,0:00:25.88,Caption,,0,0,0,,ПОЛИТИК. НО ВОКРУГ БУДУЩЕГО СОГЛАШЕНИЯ СЕЙЧАС
Dialogue: 0,0:00:25.96,0:00:30.20,Caption,,0,0,0,,СОБРАЛАСЬ ТАКАЯ КОМПАНИЯ, ЧТО ОТСУТСТВИЕ РОССИИ В РОССИЙСКОМ ВОПРОСЕ УЖЕ НЕ
Dialogue: 0,0:00:30.28,0:00:33.40,Caption,,0,0,0,,КАЖЕТСЯ САМЫМ СТРАННЫМ. ГОРАЗДО ИНТЕРЕСНЕЕ ДРУГОЕ.
Dialogue: 0,0:00:33.88,0:00:35.48,Caption,,0,0,0,,ОНИ ХОТЯ БЫ МЕЖДУ СОБОЙ РЕШИЛИ,
Dialogue: 0,0:00:35.80,0:00:40.04,Caption,,0,0,0,,КАКОЙ РЕЗУЛЬТАТ ИМ НУЖЕН? ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ БЕЗ ЦЕРЕМОНИАЛЬНЫХ
Dialogue: 0,0:00:40.04,0:00:42.92,Caption,,0,0,0,,ПОКЛОНОВ, ПОДПИСЫВАЙТЕСЬ. ПРЕДСЕДАТЕЛЬ КОМИТЕТА ПО
Dialogue: 0,0:00:42.92,0:00:45.40,Caption,,0,0,0,,МЕЖДУНАРОДНЫМ ДЕЛАМ ПАРЛАМЕНТА ЭСТОНИИ МАРКО
Dialogue: 0,0:00:45.40,0:00:48.12,Caption,,0,0,0,,МИКЕЛЬСОН СЧИТАЕТ, ЧТО СОЕДИНЁННЫМ ШТАТАМ,
Dialogue: 0,0:00:48.20,0:00:51.32,Caption,,0,0,0,,ЕВРОПЕ И УКРАИНЕ СЛЕДУЕТ ОПРЕДЕЛИТЬ УСЛОВИЯ МИРА
Dialogue: 0,0:00:51.32,0:00:53.56,Caption,,0,0,0,,СОВМЕСТНО. ПЕРЕГОВОРЫ НЕОБХОДИМЫ,
Dialogue: 0,0:00:53.74,0:00:57.96,Caption,,0,0,0,,КОНФЛИКТ НАДО ЗАВЕРШАТЬ, БУДУЩУЮ КОНСТРУКЦИЮ ПОРА ОБСУЖДАТЬ. ТОЛЬКО
Dialogue: 0,0:00:57.96,0:00:59.96,Caption,,0,0,0,,РОССИЙСКОЕ КРЕСЛО В ЭТОЙ КОНСТРУКЦИИ НЕ
Dialogue: 0,0:00:59.96,0:01:02.68,Caption,,0,0,0,,ПРЕДУСМОТРЕНО. УДОБНАЯ МОДЕЛЬ. ТРИ СТОРОНЫ
Dialogue: 0,0:01:02.68,0:01:04.92,Caption,,0,0,0,,СОСТАВЛЯЮТ ПЕРЕЧЕНЬ УСЛОВИЙ ДЛЯ ЧЕТВЁРТОЙ,
Dialogue: 0,0:01:05.19,0:01:07.32,Caption,,0,0,0,,ПОСЛЕ ЧЕГО ЧЕТВЁРТОЙ СТОРОНЕ СООБЩАЮТ,
Dialogue: 0,0:01:07.40,0:01:12.16,Caption,,0,0,0,,ЧТО ВСЁ УЖЕ СОГЛАСОВАНО. ОСТАЁТСЯ КИВНУТЬ,
Dialogue: 0,0:01:12.39,0:01:15.20,Caption,,0,0,0,,РАСПИСАТЬСЯ И ПОБЛАГОДАРИТЬ ЗА ВОЗМОЖНОСТЬ
Dialogue: 0,0:01:15.20,0:01:17.44,Caption,,0,0,0,,ПРИСУТСТВОВАТЬ НА СОБСТВЕННОМ УРЕГУЛИРОВАНИИ.
Dialogue: 0,0:01:18.00,0:01:22.08,Caption,,0,0,0,,ЕСЛИ МОСКВА ОТКАЖЕТСЯ, ВИНОВАТАЯ НАЙДЁТСЯ МОМЕНТАЛЬНО. ЗНАЧИТ,
Dialogue: 0,0:01:22.23,0:01:25.76,Caption,,0,0,0,,РОССИЯ НЕ ХОЧЕТ МИРА. А ТО, ЧТО ЕЁ НЕ СПРОСИЛИ,
Dialogue: 0,0:01:26.08,0:01:28.08,Caption,,0,0,0,,МОЖНО СЧИТАТЬ ДОСАДНОЙ ПОДРОБНОСТЬЮ,
Dialogue: 0,0:01:28.24,0:01:31.20,Caption,,0,0,0,,ВРОДЕ НЕПРАВИЛЬНО УКАЗАННОГО ОТЧЕСТВА В ПРИГЛАШЕНИИ.
Dialogue: 0,0:01:31.70,0:01:35.52,Caption,,0,0,0,,ПРОБЛЕМА В ТОМ, ЧТО РОССИЯ ЗДЕСЬ НЕ СТОРОННИЙ НАБЛЮДАТЕЛЬ. У НЕЁ
Dialogue: 0,0:01:35.60,0:01:38.08,Caption,,0,0,0,,ЕСТЬ ВООРУЖЁННЫЕ СИЛЫ, СВОИ ТРЕБОВАНИЯ,
Dialogue: 0,0:01:38.23,0:01:41.52,Caption,,0,0,0,,СВОЁ ПОНИМАНИЕ УГРОЗ И СПОСОБНОСТЬ НЕ ПРИНИМАТЬ
Dialogue: 0,0:01:41.52,0:01:45.60,Caption,,0,0,0,,ЧУЖОЙ ПРОЕКТ. ЕВРОПЕЙСКИМ ПОЛИТИКАМ ЭТИ ТРЕБОВАНИЯ МОГУТ КАЗАТЬСЯ
Dialogue: 0,0:01:45.60,0:01:49.04,Caption,,0,0,0,,ВОЗМУТИТЕЛЬНЫМИ, ЧРЕЗМЕРНЫМИ ИЛИ СОВЕРШЕННО НЕПРИЕМЛЕМЫМИ.
Dialogue: 0,0:01:49.60,0:01:51.92,Caption,,0,0,0,,ЭТО НИКАК НЕ ОТМЕНЯЕТ ПРОСТОГО ОБСТОЯТЕЛЬСТВА
Dialogue: 0,0:01:52.00,0:01:53.68,Caption,,0,0,0,,ЗАВЕРШАТЬ ВОЙНУ ПРИДЁТСЯ С ТЕМ,
Dialogue: 0,0:01:53.83,0:01:58.80,Caption,,0,0,0,,КТО ЕЁ ВЕДЁТ, А НЕ С ТЕМИ, КТО УДОБНЕЕ РАССАЖИВАЕТСЯ ЗА СТОЛОМ. ЭСТОНИЯ УЖЕ
Dialogue: 0,0:01:58.80,0:02:03.60,Caption,,0,0,0,,РАСПРЕДЕЛИЛА РОЛИ, СОСТАВ УЧАСТНИКОВ И ПРАВО РЕШАТЬ. ОСТАЛОСЬ УТОЧНИТЬ
Dialogue: 0,0:02:03.60,0:02:06.88,Caption,,0,0,0,,ПРАКТИЧЕСКУЮ ЧАСТЬ. ЧЕМ ИМЕННО МИКЕЛЬСОН СОБИРАЕТСЯ
Dialogue: 0,0:02:06.88,0:02:09.44,Caption,,0,0,0,,ЗАСТАВИТЬ РОССИЮ ПРИНЯТЬ ПОДГОТОВЛЕННЫЕ БЕЗ НЕЁ
Dialogue: 0,0:02:09.52,0:02:13.52,Caption,,0,0,0,,УСЛОВИЯ? НЕ АМЕРИКАНСКИМИ ВОЗМОЖНОСТЯМИ. НЕ СОВОКУПНОЙ МОЩЬЮ
Dialogue: 0,0:02:13.52,0:02:18.48,Caption,,0,0,0,,АЛЬЯНСА. ИМЕННО ЭСТОНСКИМИ. В МЕЖДУНАРОДНЫХ ДЕЛАХ ГРОМКОСТЬ ЗАЯВЛЕНИЯ НЕ
Dialogue: 0,0:02:18.56,0:02:21.76,Caption,,0,0,0,,ЗАМЕНЯЕТ РЫЧАГ. ЕСЛИ ЗА ТРЕБОВАНИЕМ НЕТ СИЛЫ,
Dialogue: 0,0:02:21.84,0:02:24.72,Caption,,0,0,0,,СДЕЛКИ ИЛИ ВЫГОДЫ, ОНО ОСТАЁТСЯ ПОЖЕЛАНИЕМ.
Dialogue: 0,0:02:27.01,0:02:28.77,Caption,,0,0,0,,ЕГО МОЖНО КРАСИВО РАСПЕЧАТАТЬ,
Dialogue: 0,0:02:29.00,0:02:31.49,Caption,,0,0,0,,ПОЛОЖИТЬ В ДОРОГУЮ ПАПКУ И ДАЖЕ ВЫНЕСТИ К
Dialogue: 0,0:02:31.49,0:02:34.45,Caption,,0,0,0,,ЖУРНАЛИСТАМ. ПРОТИВНИК ОТ ЭТОГО ПОСЛУШНЕЕ НЕ СТАНЕТ.
Dialogue: 0,0:02:35.47,0:02:37.97,Caption,,0,0,0,,КАЯ КАЛЛАС ПРЕДЛАГАЕТ СВОЮ ПОСЛЕДОВАТЕЛЬНОСТЬ.
Dialogue: 0,0:02:38.28,0:02:40.85,Caption,,0,0,0,,ОСНОВАНИЙ ЖДАТЬ СКОРОГО ЗАВЕРШЕНИЯ КОНФЛИКТА ОНА НЕ
Dialogue: 0,0:02:40.85,0:02:45.01,Caption,,0,0,0,,ВИДИТ. РОССИЯ СНАЧАЛА ДОЛЖНА ПРЕКРАТИТЬ ОГОНЬ И ПОЙТИ НА
Dialogue: 0,0:02:45.01,0:02:47.41,Caption,,0,0,0,,УСТУПКИ. ПОСЛЕ ЭТОГО, ВЕРОЯТНО,
Dialogue: 0,0:02:47.57,0:02:51.65,Caption,,0,0,0,,МОЖНО БУДЕТ ОБСУЖДАТЬ, ПОЯВИЛИСЬ ЛИ УСЛОВИЯ ДЛЯ СЕРЬЁЗНОГО РАЗГОВОРА.
Dialogue: 0,0:02:52.01,0:02:55.09,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ПРЕКРАСНЫЙ ПОРЯДОК ОБСЛУЖИВАНИЯ. СНАЧАЛА
Dialogue: 0,0:02:55.17,0:02:57.25,Caption,,0,0,0,,ВЫПОЛНИТЕ ЗАКАЗ ЕВРОПЕЙСКОЙ СТОРОНЫ,
Dialogue: 0,0:02:57.52,0:03:02.61,Caption,,0,0,0,,ПОТОМ ВАМ, ВОЗМОЖНО, ПРИНЕСУТ МЕНЮ ПЕРЕГОВОРОВ. МОСКВА ПРИ ЭТОМ ТОЖЕ
Dialogue: 0,0:03:02.61,0:03:05.49,Caption,,0,0,0,,СФОРМУЛИРОВАЛА СВОИ ТРЕБОВАНИЯ И НЕ СОБИРАЕТСЯ
Dialogue: 0,0:03:05.49,0:03:08.13,Caption,,0,0,0,,ПЕРЕПИСЫВАТЬ ИХ ПОД БРЮССЕЛЬСКУЮ ДИКТОВКУ. СЛОВО
Dialogue: 0,0:03:08.13,0:03:10.85,Caption,,0,0,0,,УСТУПКИ МОЖНО ПОВТОРИТЬ ХОТЬ СОТНЮ РАЗ. ОНО НЕ
Dialogue: 0,0:03:10.85,0:03:13.17,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ОБЯЗАТЕЛЬСТВО ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:03:13.35,0:03:15.81,Caption,,0,0,0,,ЧТО ЕГО ПРОИЗНЕСЛИ В ПРАВИЛЬНОМ ЗДАНИИ И С
Dialogue: 0,0:03:15.89,0:03:18.77,Caption,,0,0,0,,ОЧЕНЬ СТРОГИМ ЛИЦОМ. КАЛЛАС ТАКЖЕ ГОВОРИТ,
Dialogue: 0,0:03:19.00,0:03:21.73,Caption,,0,0,0,,ЧТО РОССИЙСКИЕ УДАРЫ ПО ЭНЕРГЕТИЧЕСКИМ ОБЪЕКТАМ,
Dialogue: 0,0:03:21.89,0:03:25.17,Caption,,0,0,0,,МОСТАМ И ЖЕЛЕЗНОДОРОЖНОЙ ИНФРАСТРУКТУРЕ ДАВЯТ НА
Dialogue: 0,0:03:25.17,0:03:27.65,Caption,,0,0,0,,НАСЕЛЕНИЕ УКРАИНЫ. ТОГДА ОТ ЕВРОПЕЙСКИХ
Dialogue: 0,0:03:27.65,0:03:30.29,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ ОСОБЕННО ХОЧЕТСЯ УСЛЫШАТЬ НЕ
Dialogue: 0,0:03:30.29,0:03:34.21,Caption,,0,0,0,,ВОЗМУЩЕНИЕ, А РАСЧЁТ. КАК ВЫГЛЯДИТ ИХ КОНЕЧНАЯ ТОЧКА?
Dialogue: 0,0:03:34.60,0:03:37.17,Caption,,0,0,0,,ЧТО ДОЛЖНО ИЗМЕНИТЬСЯ ПОСЛЕ ОЧЕРЕДНЫХ ОГРАНИЧЕНИЙ
Dialogue: 0,0:03:37.17,0:03:41.17,Caption,,0,0,0,,ПРОТИВ МОСКВЫ, НОВЫХ ПОСТАВОК КИЕВУ И СЛЕДУЮЩЕГО ТРЕБОВАНИЯ
Dialogue: 0,0:03:41.17,0:03:43.73,Caption,,0,0,0,,УСТУПИТЬ? КОНФЛИКТ ИДЁТ УЖЕ ПЯТЫЙ ГОД.
Dialogue: 0,0:03:46.00,0:03:49.28,Caption,,0,0,0,,НАСЕЛЕНИЕ НЕСЁТ ПОТЕРИ, ИНФРАСТРУКТУРА РАЗРУШАЕТСЯ,
Dialogue: 0,0:03:49.42,0:03:52.16,Caption,,0,0,0,,РАСХОДЫ РАСТУТ. А ЕВРОПЕЙСКИЙ РЕЦЕПТ ВСЁ ЕЩЁ
Dialogue: 0,0:03:52.24,0:03:57.04,Caption,,0,0,0,,НАПОМИНАЕТ СОВЕТ ЧЕЛОВЕКУ, КОТОРЫЙ ЗАБЛУДИЛСЯ ПРОДОЛЖАЙТЕ ИДТИ ТЕМ ЖЕ ПУТЁМ,
Dialogue: 0,0:03:57.36,0:04:00.32,Caption,,0,0,0,,ТОЛЬКО БЫСТРЕЕ И С БОЛЕЕ СУРОВЫМ ВЫРАЖЕНИЕМ ЛИЦА.
Dialogue: 0,0:04:01.16,0:04:03.84,Caption,,0,0,0,,ЕСЛИ ВЫБРАННАЯ СТРАТЕГИЯ ДОЛЖНА ПРИВЕСТИ К МИРУ,
Dialogue: 0,0:04:04.08,0:04:06.56,Caption,,0,0,0,,ГДЕ ЦЕПОЧКА МЕЖДУ ДЕЙСТВИЕМ И РЕЗУЛЬТАТОМ?
Dialogue: 0,0:04:07.11,0:04:10.72,Caption,,0,0,0,,ЕСЛИ ТАКОЙ ЦЕПОЧКИ НЕТ, ДАВЛЕНИЕ СТАНОВИТСЯ НЕ ИНСТРУМЕНТОМ,
Dialogue: 0,0:04:10.88,0:04:13.20,Caption,,0,0,0,,А ПРИВЫЧКОЙ. ЕГО ПРОДОЛЖАЮТ ПОТОМУ,
Dialogue: 0,0:04:13.44,0:04:15.92,Caption,,0,0,0,,ЧТО ОСТАНОВИТЬСЯ И СПРОСИТЬ О РЕЗУЛЬТАТЕ УЖЕ
Dialogue: 0,0:04:15.92,0:04:19.12,Caption,,0,0,0,,НЕЛОВКО. ТЕМ БОЛЕЕ ЧТО ОБЩЕГО ОТВЕТА У ЗАПАДНЫХ
Dialogue: 0,0:04:19.12,0:04:23.36,Caption,,0,0,0,,СОЮЗНИКОВ НЕ ВИДНО. МИКЕЛЬСОН ГОТОВ СОЧИНЯТЬ УСЛОВИЯ В ОТСУТСТВИЕ
Dialogue: 0,0:04:23.36,0:04:26.88,Caption,,0,0,0,,МОСКВЫ. КАЛЛАС СНАЧАЛА ТРЕБУЕТ РОССИЙСКИХ УСТУПОК.
Dialogue: 0,0:04:27.11,0:04:29.12,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПОСРЕДНИКИ, НАПРОТИВ,
Dialogue: 0,0:04:29.46,0:04:32.24,Caption,,0,0,0,,ПЫТАЮТСЯ УСКОРИТЬ ПРОЦЕСС. ПОЛУЧИЛСЯ ОРКЕСТР,
Dialogue: 0,0:04:32.48,0:04:34.96,Caption,,0,0,0,,В КОТОРОМ ОДИН МУЗЫКАНТ УЖЕ ИГРАЕТ ФИНАЛ,
Dialogue: 0,0:04:35.12,0:04:37.12,Caption,,0,0,0,,ВТОРОЙ ЕЩЁ НАСТРАИВАЕТ ИНСТРУМЕНТ,
Dialogue: 0,0:04:37.36,0:04:39.20,Caption,,0,0,0,,А ТРЕТИЙ ТРЕБУЕТ ВЫКЛЮЧИТЬ СВЕТ.
Dialogue: 0,0:04:39.81,0:04:42.40,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ДОБАВЛЯЕТ К ЭТОЙ КОМПОЗИЦИИ СОБСТВЕННЫЙ
Dialogue: 0,0:04:42.40,0:04:45.12,Caption,,0,0,0,,ПРИНЦИП. В ИНТЕРВЬЮ АМЕРИКАНСКОМУ ТЕЛЕВИДЕНИЮ ОН
Dialogue: 0,0:04:45.12,0:04:48.64,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО БОЛЬШИЕ ГОСУДАРСТВА НЕ ДОЛЖНЫ ОПРЕДЕЛЯТЬ БУДУЩЕЕ
Dialogue: 0,0:04:48.64,0:04:51.84,Caption,,0,0,0,,УКРАИНЫ БЕЗ УЧАСТИЯ КИЕВА. С ЭТИМ ТРУДНО СПОРИТЬ.
Dialogue: 0,0:04:52.05,0:04:57.12,Caption,,0,0,0,,ЕСЛИ РЕШАЕТСЯ СУДЬБА СТРАНЫ, ЕЁ ПРЕДСТАВИТЕЛИ ХОТЯТ УЧАСТВОВАТЬ. НО РЯДОМ ЛЕЖИТ
Dialogue: 0,0:04:57.12,0:04:59.92,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ПРЕДЛОЖЕНИЕ ИСКЛЮЧИТЬ РОССИЮ ИЗ
Dialogue: 0,0:05:00.00,0:05:02.40,Caption,,0,0,0,,ОБСУЖДЕНИЯ ЗАВЕРШЕНИЯ КОНФЛИКТА С РОССИЕЙ.
Dialogue: 0,0:05:04.68,0:05:07.40,Caption,,0,0,0,,И ПРИНЦИП ВНЕЗАПНО НАЧИНАЕТ РАБОТАТЬ ПО ПРОПУСКУ.
Dialogue: 0,0:05:07.96,0:05:10.36,Caption,,0,0,0,,БУДУЩЕЕ УКРАИНЫ БЕЗ УКРАИНЫ РЕШАТЬ НЕЛЬЗЯ.
Dialogue: 0,0:05:10.84,0:05:13.08,Caption,,0,0,0,,РОССИЙСКИЕ УСЛОВИЯ БЕЗ РОССИИ ОБСУЖДАТЬ,
Dialogue: 0,0:05:13.24,0:05:15.08,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, ВПОЛНЕ ДОПУСТИМО.
Dialogue: 0,0:05:15.64,0:05:18.20,Caption,,0,0,0,,СПРАВЕДЛИВОСТЬ ЗДЕСЬ НАПОМИНАЕТ ОХРАННИКА У ДОРОГОГО
Dialogue: 0,0:05:18.28,0:05:21.24,Caption,,0,0,0,,КЛУБА СВОИХ УЗНАЁТ СРАЗУ, ОСТАЛЬНЫМ СООБЩАЕТ,
Dialogue: 0,0:05:21.40,0:05:24.68,Caption,,0,0,0,,ЧТО СПИСОК ГОСТЕЙ УЖЕ ЗАКРЫТ. ТОЛЬКО БОЕВЫЕ ДЕЙСТВИЯ
Dialogue: 0,0:05:24.76,0:05:28.84,Caption,,0,0,0,,НЕ ПРЕКРАЩАЮТСЯ ОТ ТОГО, КОГО В БРЮССЕЛЕ НАЗНАЧИЛИ ДОСТОЙНЫМ УЧАСТНИКОМ.
Dialogue: 0,0:05:29.14,0:05:31.64,Caption,,0,0,0,,МОЖНО ВЫДАТЬ ОДНОЙ СТОРОНЕ НРАВСТВЕННУЮ ГРАМОТУ,
Dialogue: 0,0:05:31.84,0:05:34.76,Caption,,0,0,0,,А ДРУГОЙ ОСТАВИТЬ МЕСТО В ГАРДЕРОБЕ. СОГЛАШЕНИЕ ВСЁ
Dialogue: 0,0:05:34.84,0:05:37.24,Caption,,0,0,0,,РАВНО ПОТРЕБУЕТ ПОДПИСИ И ИСПОЛНЕНИЯ ОБЕИХ.
Dialogue: 0,0:05:37.40,0:05:40.52,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ДАЛЬШЕ ЕВРОПЕЙЦЫ НАЧИНАЮТ ОТБИВАТЬСЯ
Dialogue: 0,0:05:40.60,0:05:44.20,Caption,,0,0,0,,ОТ ТРЕБОВАНИЙ, КОТОРЫЕ ЕЩЁ НИКТО НЕ УСПЕЛ ПРЕДЪЯВИТЬ. ПРЕЗИДЕНТ
Dialogue: 0,0:05:44.20,0:05:46.20,Caption,,0,0,0,,ФИНЛЯНДИИ АЛЕКСАНДР СТУББ СООБЩИЛ,
Dialogue: 0,0:05:46.44,0:05:48.76,Caption,,0,0,0,,ЧТО ЕГО СТРАНА НЕ НАМЕРЕНА ПОКИДАТЬ НАТО.
Dialogue: 0,0:05:48.92,0:05:51.56,Caption,,0,0,0,,РЕШИТЕЛЬНОСТЬ ВНУШИТЕЛЬНАЯ. ЗАТЕМ ВЫЯСНИЛОСЬ,
Dialogue: 0,0:05:51.88,0:05:54.04,Caption,,0,0,0,,ЧТО РОССИЙСКИЕ ПРЕДСТАВИТЕЛИ НЕ ТРЕБОВАЛИ ОТ
Dialogue: 0,0:05:54.04,0:05:56.84,Caption,,0,0,0,,ФИНЛЯНДИИ ВЫХОДА ИЗ АЛЬЯНСА. САМ СТУББ ТАКОГО
Dialogue: 0,0:05:56.84,0:06:00.12,Caption,,0,0,0,,ТРЕБОВАНИЯ НЕ СЛЫШАЛ. КРЕМЛЬ ЕГО СУЩЕСТВОВАНИЕ ТОЖЕ
Dialogue: 0,0:06:00.12,0:06:03.48,Caption,,0,0,0,,ОТВЕРГ. НО ОТВЕТ УЖЕ ПРОЗВУЧАЛ. ПОЛУЧИЛАСЬ ПОБЕДА
Dialogue: 0,0:06:03.50,0:06:06.12,Caption,,0,0,0,,НАД ПУСТЫМ СТУЛОМ. УСЛОВИЕ НЕ ВЫДВИНУТО,
Dialogue: 0,0:06:06.36,0:06:11.80,Caption,,0,0,0,,ЗАТО ОНО ЗАРАНЕЕ ОТВЕРГНУТО, ОСУЖДЕНО И ПОЧТИ ВЫНЕСЕНО С ПОЛЯ ПОД АПЛОДИСМЕНТЫ.
Dialogue: 0,0:06:12.17,0:06:14.84,Caption,,0,0,0,,ДЛЯ ПОЛНОГО КОМПЛЕКТА НЕ ХВАТАЕТ ТОЛЬКО МЕДАЛИ ЗА
Dialogue: 0,0:06:14.84,0:06:17.56,Caption,,0,0,0,,СТОЙКОСТЬ ПЕРЕД ТРЕБОВАНИЕМ, КОТОРОГО НЕ БЫЛО.
Dialogue: 0,0:06:19.83,0:06:22.08,Caption,,0,0,0,,ПОДОБНАЯ СПЕШКА МОЖЕТ БЫТЬ НЕ ПРОСТО ЛЮБОВЬЮ К
Dialogue: 0,0:06:22.16,0:06:25.20,Caption,,0,0,0,,ГРОМКИМ ЗАГОЛОВКАМ. ЕСЛИ МОСКВЕ ЗАРАНЕЕ ПРИПИСАТЬ
Dialogue: 0,0:06:25.20,0:06:30.08,Caption,,0,0,0,,МАКСИМАЛИСТСКОЕ УСЛОВИЕ, ПОЯВЛЯЕТСЯ ГОТОВОЕ ОБЪЯСНЕНИЕ БУДУЩЕГО СРЫВА ЯКОБЫ
Dialogue: 0,0:06:30.16,0:06:34.88,Caption,,0,0,0,,ОНА ЗАХОТЕЛА НЕВОЗМОЖНОГО, ОТКАЗАЛАСЬ ОТ РАЗУМНОГО КОМПРОМИССА И В ИТОГЕ САМА
Dialogue: 0,0:06:34.88,0:06:37.76,Caption,,0,0,0,,РАЗРУШИЛА ПЕРЕГОВОРЫ. ОЧЕНЬ ПРАКТИЧНАЯ СТРАХОВКА.
Dialogue: 0,0:06:38.16,0:06:40.56,Caption,,0,0,0,,СНАЧАЛА ОППОНЕНТУ ВЫПИСЫВАЮТ ТРЕБОВАНИЕ ОТ ЕГО
Dialogue: 0,0:06:40.56,0:06:43.92,Caption,,0,0,0,,ИМЕНИ. ПОТОМ С ДОСТОИНСТВОМ ЕГО ОТВЕРГАЮТ. ЕСЛИ
Dialogue: 0,0:06:43.92,0:06:48.48,Caption,,0,0,0,,ДОГОВОРИТЬСЯ НЕ ПОЛУЧИТСЯ, ПУБЛИКЕ УЖЕ ПРЕДСТАВИЛИ ВИНОВНОГО. ДАЖЕ РАССЛЕДОВАТЬ
Dialogue: 0,0:06:48.48,0:06:51.28,Caption,,0,0,0,,НИЧЕГО НЕ НАДО, ТАБЛИЧКА НА НЕГО ПОВЕШЕНА ЗАРАНЕЕ.
Dialogue: 0,0:06:52.30,0:06:54.24,Caption,,0,0,0,,ЗАТЕМ ПОЯВИЛАСЬ ИНФОРМАЦИЯ BLOOMBERG,
Dialogue: 0,0:06:54.47,0:06:57.12,Caption,,0,0,0,,И ИСТОРИЯ О ФИНСКОМ ЧЛЕНСТВЕ ПРИОБРЕЛА СОВСЕМ ИНОЙ
Dialogue: 0,0:06:57.12,0:07:01.92,Caption,,0,0,0,,МАСШТАБ. СОГЛАСНО ПУБЛИКАЦИИ, РЕЧЬ МОЖЕТ ИДТИ НЕ О ВЫХОДЕ ФИНЛЯНДИИ ИЗ
Dialogue: 0,0:07:01.92,0:07:05.04,Caption,,0,0,0,,НАТО. ОБСУЖДАЕТСЯ ОГРАНИЧЕНИЕ ВОЕННОГО ПРИСУТСТВИЯ
Dialogue: 0,0:07:05.04,0:07:09.28,Caption,,0,0,0,,АЛЬЯНСА В ГОСУДАРСТВАХ, КОТОРЫЕ ПРИСОЕДИНИЛИСЬ К НЕМУ ПОСЛЕ ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:07:09.28,0:07:14.16,Caption,,0,0,0,,ДЕВЯНОСТО СЕДЬМОГО ГОДА. В ОТВЕТ РОССИЯ ЯКОБЫ ГОТОВА РАССМАТРИВАТЬ УМЕНЬШЕНИЕ
Dialogue: 0,0:07:14.16,0:07:16.72,Caption,,0,0,0,,СОБСТВЕННЫХ СИЛ В КАЛИНИНГРАДСКОЙ ОБЛАСТИ И
Dialogue: 0,0:07:16.72,0:07:19.84,Caption,,0,0,0,,БЕЛАРУСИ. ЭТО УЖЕ НЕ УЛЬТИМАТУМ В ДУХЕ СОБИРАЙТЕ
Dialogue: 0,0:07:19.84,0:07:23.04,Caption,,0,0,0,,ВЕЩИ И УХОДИТЕ ИЗ НАТО. ЗДЕСЬ ПРЕДЛАГАЕТСЯ ОБМЕН
Dialogue: 0,0:07:23.04,0:07:26.24,Caption,,0,0,0,,ОГРАНИЧЕНИЯМИ. НА ЭТОМ ФОНЕ РЕШИТЕЛЬНЫЙ ОТПОР СТУББА
Dialogue: 0,0:07:26.24,0:07:28.88,Caption,,0,0,0,,ВЫГЛЯДИТ КАК ПОЖАРНАЯ ТРЕВОГА ИЗ ЗА ЧАЙНИКА.
Dialogue: 0,0:07:31.15,0:07:33.95,Caption,,0,0,0,,ВСЕ БЕГУТ СПАСАТЬ ФИНЛЯНДИЮ ОТ ИСКЛЮЧЕНИЯ ИЗ НАТО,
Dialogue: 0,0:07:34.19,0:07:36.83,Caption,,0,0,0,,ПОКА В СОСЕДНЕЙ КОМНАТЕ ОБСУЖДАЮТ ЧИСЛЕННОСТЬ ВОЙСК
Dialogue: 0,0:07:37.07,0:07:40.03,Caption,,0,0,0,,И ВЗАИМНЫЕ СОКРАЩЕНИЯ. ИМЕННО ПОЭТОМУ ТЫСЯЧА
Dialogue: 0,0:07:40.11,0:07:42.35,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОЙ ГОД ПОЯВЛЯЕТСЯ НЕ
Dialogue: 0,0:07:42.35,0:07:45.47,Caption,,0,0,0,,СЛУЧАЙНО. ВОЗМОЖНАЯ НОВИЗНА ЗАКЛЮЧАЕТСЯ В ДРУГОМ.
Dialogue: 0,0:07:46.10,0:07:50.43,Caption,,0,0,0,,ПО ДАННЫМ BLOOMBERG, ОБСУЖДАТЬСЯ МОЖЕТ ВСТРЕЧНОЕ ДВИЖЕНИЕ. АЛЬЯНС
Dialogue: 0,0:07:50.51,0:07:53.31,Caption,,0,0,0,,УМЕНЬШАЕТ ПРИСУТСТВИЕ В ОДНИХ РАЙОНАХ. РОССИЯ
Dialogue: 0,0:07:53.38,0:07:56.43,Caption,,0,0,0,,СОКРАЩАЕТ СИЛЫ В ДРУГИХ. ЭТО УЖЕ ПРЕДМЕТ ТОРГА,
Dialogue: 0,0:07:56.66,0:07:59.07,Caption,,0,0,0,,ГДЕ ОБЕ СТОРОНЫ ЧТО ТО ОТДАЮТ И ЧТО
Dialogue: 0,0:07:59.15,0:08:01.71,Caption,,0,0,0,,ТО ПОЛУЧАЮТ. ОН НЕ СВОДИТСЯ К СПОРУ ВОКРУГ
Dialogue: 0,0:08:01.71,0:08:04.59,Caption,,0,0,0,,ОТДЕЛЬНОГО УЧАСТКА УКРАИНСКОЙ ТЕРРИТОРИИ. МАСШТАБ
Dialogue: 0,0:08:04.59,0:08:07.31,Caption,,0,0,0,,РАЗГОВОРА ОХВАТЫВАЕТ УСТРОЙСТВО БЕЗОПАСНОСТИ ПОЧТИ
Dialogue: 0,0:08:07.39,0:08:10.43,Caption,,0,0,0,,ВСЕЙ ЕВРОПЫ. И ЗДЕСЬ ЛОМАЕТСЯ УДОБНАЯ ВЕРСИЯ,
Dialogue: 0,0:08:10.67,0:08:13.39,Caption,,0,0,0,,БУДТО ДОСТАТОЧНО ОБСУДИТЬ ТОЛЬКО ГРАНИЦЫ УКРАИНЫ,
Dialogue: 0,0:08:13.55,0:08:16.67,Caption,,0,0,0,,ПОДПИСАТЬ БУМАГУ И РАЗОЙТИСЬ. РОССИЙСКАЯ ПОЗИЦИЯ
Dialogue: 0,0:08:16.67,0:08:19.71,Caption,,0,0,0,,ШИРЕ. МОСКВА РАССМАТРИВАЕТ ПРОИСХОДЯЩЕЕ КАК ЧАСТЬ
Dialogue: 0,0:08:19.79,0:08:22.59,Caption,,0,0,0,,СПОРА О ЕВРОПЕЙСКОЙ ВОЕННОЙ СИСТЕМЕ И ПРИБЛИЖЕНИИ
Dialogue: 0,0:08:22.67,0:08:26.19,Caption,,0,0,0,,НАТО. ЭТУ ПОСТАНОВКУ ВОПРОСА МОЖНО ПРИНИМАТЬ ИЛИ СЧИТАТЬ
Dialogue: 0,0:08:26.19,0:08:29.15,Caption,,0,0,0,,НЕПРИЕМЛЕМОЙ. НО ЕСЛИ ДЛЯ ОДНОЙ ИЗ СТОРОН ИМЕННО
Dialogue: 0,0:08:29.24,0:08:31.15,Caption,,0,0,0,,ОНА ЯВЛЯЕТСЯ ОСНОВОЙ КОНФЛИКТА,
Dialogue: 0,0:08:31.55,0:08:34.51,Caption,,0,0,0,,ВЫЧЕРКНУТЬ ЕЁ ИЗ ПЕРЕГОВОРОВ НЕ ПОЛУЧИТСЯ. ТЕМ БОЛЕЕ
Dialogue: 0,0:08:34.51,0:08:37.31,Caption,,0,0,0,,ЗАБАВНО ПЫТАТЬСЯ ВЫЧЕРКНУТЬ ВМЕСТЕ С ВОПРОСОМ ЕЩЁ И
Dialogue: 0,0:08:37.39,0:08:40.27,Caption,,0,0,0,,САМУ РОССИЮ. ПОКА В ЕВРОПЕ РАСПРЕДЕЛЯЮТ ПРИГЛАШЕНИЯ
Dialogue: 0,0:08:40.35,0:08:43.87,Caption,,0,0,0,,И ТРЕБУЮТ УСТУПОК, АМЕРИКАНСКИЕ ПОСРЕДНИКИ ЗАМЕТНО СПЕШАТ.
Dialogue: 0,0:08:46.13,0:08:48.31,Caption,,0,0,0,,ПО ИНФОРМАЦИИ THE KYIV INDEPENDENT,
Dialogue: 0,0:08:48.53,0:08:51.75,Caption,,0,0,0,,СТИВ УИТКОФФ И ДЖАРЕД КУШНЕР ХОТЯТ ПРОДВИНУТЬ
Dialogue: 0,0:08:51.75,0:08:54.63,Caption,,0,0,0,,ПЕРЕГОВОРЫ ДО ВОЗМОЖНОЙ ПЕРЕМЕНЫ СООТНОШЕНИЯ СИЛ В
Dialogue: 0,0:08:54.71,0:08:57.11,Caption,,0,0,0,,КОНГРЕССЕ СОЕДИНЁННЫХ ШТАТОВ. ИНАЧЕ ГОВОРЯ,
Dialogue: 0,0:08:57.38,0:08:59.83,Caption,,0,0,0,,ОКНО ДЛЯ СДЕЛКИ МОЖЕТ ЗАВИСЕТЬ ОТ АМЕРИКАНСКОЙ
Dialogue: 0,0:08:59.83,0:09:02.87,Caption,,0,0,0,,ВНУТРЕННЕЙ АРИФМЕТИКИ. СЕЙЧАС В КОНГРЕССЕ ХВАТАЕТ
Dialogue: 0,0:09:02.95,0:09:06.87,Caption,,0,0,0,,НУЖНЫХ ГОЛОСОВ, ПОСЛЕ ПЕРЕСТАНОВКИ ИХ МОЖЕТ СТАТЬ МЕНЬШЕ. СЕЙЧАС
Dialogue: 0,0:09:06.87,0:09:09.03,Caption,,0,0,0,,ПОСРЕДНИКИ ОБЕЩАЮТ ОДИН НАБОР УСЛОВИЙ,
Dialogue: 0,0:09:09.26,0:09:11.03,Caption,,0,0,0,,ПОСЛЕ ПЕРЕСТАНОВКИ ПОЯВИТСЯ ДРУГОЙ.
Dialogue: 0,0:09:11.59,0:09:14.07,Caption,,0,0,0,,МНОГОЛЕТНЮЮ БЕЗОПАСНОСТЬ ОГРОМНОГО КОНТИНЕНТА
Dialogue: 0,0:09:14.07,0:09:18.31,Caption,,0,0,0,,ПРЕДЛАГАЮТ ОФОРМИТЬ, ПОКА В ВАШИНГТОНЕ НЕ ПЕРЕДВИНУЛИ КРЕСЛА. ДЛЯ РОССИИ
Dialogue: 0,0:09:18.39,0:09:21.43,Caption,,0,0,0,,ЭТО ВЫГЛЯДИТ ОСОБЕННО УБЕДИТЕЛЬНО. ПРЕДПОЛОЖИМ,
Dialogue: 0,0:09:21.51,0:09:24.63,Caption,,0,0,0,,СОГЛАШЕНИЕ ДОСТИГНУТО. НО ЧТО ПРОИЗОЙДЁТ ПОСЛЕ
Dialogue: 0,0:09:24.63,0:09:28.15,Caption,,0,0,0,,СЛЕДУЮЩИХ ВЫБОРОВ? НОВЫЙ СОСТАВ КОНГРЕССА ПРИЗНАЕТ ПРЕЖНИЕ
Dialogue: 0,0:09:28.15,0:09:30.31,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ИЛИ ДОСТАНЕТ КРАСНУЮ РУЧКУ?
Dialogue: 0,0:09:30.68,0:09:33.11,Caption,,0,0,0,,ЧЕРЕЗ ОДИН ЦИКЛ ДОГОВОР ПРОДОЛЖИТ ДЕЙСТВОВАТЬ,
Dialogue: 0,0:09:33.35,0:09:37.27,Caption,,0,0,0,,А ЧЕРЕЗ ДВА? ИЛИ КАЖДАЯ СМЕНА БОЛЬШИНСТВА БУДЕТ ЗАПУСКАТЬ НОВЫЙ
Dialogue: 0,0:09:37.27,0:09:40.31,Caption,,0,0,0,,СЕЗОН ПЕРЕГОВОРОВ С ПРЕЖНИМИ ГЕРОЯМИ И ОБНОВЛЁННЫМИ
Dialogue: 0,0:09:40.31,0:09:43.59,Caption,,0,0,0,,ТРЕБОВАНИЯМИ? ВАШИНГТОН ПРЕДЛАГАЕТ ТОРОПИТЬСЯ,
Dialogue: 0,0:09:43.83,0:09:46.47,Caption,,0,0,0,,ПОТОМУ ЧТО САМ ВАШИНГТОН НЕ УВЕРЕН В УСТОЙЧИВОСТИ
Dialogue: 0,0:09:46.55,0:09:49.19,Caption,,0,0,0,,СОБСТВЕННОЙ ЛИНИИ. ДЛЯ СДЕЛКИ НА ДЕСЯТИЛЕТИЯ ЭТО
Dialogue: 0,0:09:49.19,0:09:52.07,Caption,,0,0,0,,ЗВУЧИТ ПРИМЕРНО КАК ПРОСЬБА КУПИТЬ ДОМ ПРЯМО СЕЙЧАС,
Dialogue: 0,0:09:52.38,0:09:54.79,Caption,,0,0,0,,ПОТОМУ ЧТО ПРОДАВЕЦ ВСКОРЕ МОЖЕТ ПЕРЕДУМАТЬ НАСЧЁТ
Dialogue: 0,0:09:54.79,0:09:57.03,Caption,,0,0,0,,ТОГО, ПРИНАДЛЕЖИТ ЛИ ЕМУ УЧАСТОК.
Dialogue: 0,0:09:59.22,0:10:02.04,Caption,,0,0,0,,ИНТЕРЕСЫ СОЕДИНЁННЫХ ШТАТОВ НЕ ОБЯЗАНЫ СОВПАДАТЬ С
Dialogue: 0,0:10:02.04,0:10:06.44,Caption,,0,0,0,,ОЖИДАНИЯМИ КИЕВА, ПОЗИЦИЕЙ КАЛЛАС ИЛИ ЗАМЫСЛОМ МИКЕЛЬСОНА ОСТАВИТЬ
Dialogue: 0,0:10:06.52,0:10:11.40,Caption,,0,0,0,,РОССИЮ ЗА ДВЕРЬЮ. БОЛЕЕ ТОГО, ВНУТРИ САМОЙ АМЕРИКАНСКОЙ СИСТЕМЫ ОДНОВРЕМЕННО
Dialogue: 0,0:10:11.40,0:10:14.44,Caption,,0,0,0,,СУЩЕСТВУЮТ НЕСКОЛЬКО РАЗНЫХ ЗАДАЧ. ЭТО ОСОБЕННО
Dialogue: 0,0:10:14.44,0:10:17.24,Caption,,0,0,0,,ЗАМЕТНО ПО СЛОВАМ ЗАМЕСТИТЕЛЯ ГЛАВЫ ПЕНТАГОНА ПО
Dialogue: 0,0:10:17.24,0:10:20.36,Caption,,0,0,0,,ПОЛИТИЧЕСКИМ ВОПРОСАМ ЭЛБРИДЖА КОЛБИ. ОН ПОСТАВИЛ
Dialogue: 0,0:10:20.44,0:10:22.76,Caption,,0,0,0,,ПОД СОМНЕНИЕ ЭФФЕКТИВНОСТЬ УКРАИНСКИХ УДАРОВ В
Dialogue: 0,0:10:22.76,0:10:25.48,Caption,,0,0,0,,ГЛУБИНЕ РОССИЙСКОЙ ТЕРРИТОРИИ. ЕГО ИНТЕРЕСОВАЛ НЕ
Dialogue: 0,0:10:25.48,0:10:28.28,Caption,,0,0,0,,ВНЕШНИЙ ЭФФЕКТ И НЕ КОЛИЧЕСТВО ГРОМКИХ КАДРОВ.
Dialogue: 0,0:10:28.68,0:10:31.56,Caption,,0,0,0,,ВОПРОС БЫЛ ПРЕДЕЛЬНО ЗЕМНЫМ ДАЛИ ЛИ ЭТИ УДАРЫ
Dialogue: 0,0:10:31.56,0:10:35.80,Caption,,0,0,0,,ВОЕННЫЙ РЕЗУЛЬТАТ? РОССИЙСКОЕ ПРОДВИЖЕНИЕ ОНИ НЕ ОСТАНОВИЛИ. К
Dialogue: 0,0:10:35.80,0:10:38.28,Caption,,0,0,0,,ЗАВЕРШЕНИЮ КОНФЛИКТА, ПО ОЦЕНКЕ КОЛБИ,
Dialogue: 0,0:10:38.46,0:10:40.84,Caption,,0,0,0,,ТОЖЕ НЕ ПРИБЛИЗИЛИ. ОСОБЕННО ВАЖНО,
Dialogue: 0,0:10:40.93,0:10:44.04,Caption,,0,0,0,,КТО ЗАДАЁТ ЭТОТ ВОПРОС. НЕ РОССИЙСКИЙ КОММЕНТАТОР.
Dialogue: 0,0:10:44.33,0:10:47.08,Caption,,0,0,0,,НЕ ЕВРОПЕЙСКИЙ СКЕПТИК. ПРЕДСТАВИТЕЛЬ АМЕРИКАНСКОГО
Dialogue: 0,0:10:47.08,0:10:50.36,Caption,,0,0,0,,ПЕНТАГОНА НА ВСТРЕЧЕ НАТО. А ЗАТЕМ КОЛБИ ПОКИНУЛ
Dialogue: 0,0:10:50.44,0:10:52.92,Caption,,0,0,0,,МЕРОПРИЯТИЕ ДО ВЫСТУПЛЕНИЯ УКРАИНСКОГО МИНИСТРА
Dialogue: 0,0:10:53.00,0:10:55.72,Caption,,0,0,0,,ОБОРОНЫ. АМЕРИКАНСКИЙ ЧИНОВНИК ПРИШЁЛ К СОЮЗНИКАМ,
Dialogue: 0,0:10:56.02,0:10:59.88,Caption,,0,0,0,,СООБЩИЛ, ЧТО ЗАМЕТНАЯ ЧАСТЬ УКРАИНСКОЙ ТАКТИКИ НЕ ПРИНОСИТ
Dialogue: 0,0:10:59.88,0:11:02.20,Caption,,0,0,0,,НУЖНОГО РЕЗУЛЬТАТА, И УШЁЛ РАНЬШЕ,
Dialogue: 0,0:11:02.36,0:11:05.08,Caption,,0,0,0,,ЧЕМ КИЕВ СМОГ ОТВЕТИТЬ. ЕДИНСТВО ПОЛУЧИЛОСЬ
Dialogue: 0,0:11:05.08,0:11:09.00,Caption,,0,0,0,,НАСТОЛЬКО ПОЛНЫМ, ЧТО ОДИН УЧАСТНИК РЕШИЛ НЕ ЖДАТЬ ВТОРОЙ ПОЛОВИНЫ
Dialogue: 0,0:11:09.08,0:11:14.15,Caption,,0,0,0,,РАЗГОВОРА. ЭТО ОСОБЕННО ВЫРАЗИТЕЛЬНО РЯДОМ С ЕВРОПЕЙСКИМИ
Dialogue: 0,0:11:14.15,0:11:17.83,Caption,,0,0,0,,ПРИЗЫВАМИ УСИЛИВАТЬ ДАВЛЕНИЕ. ЕВРОПА ТРЕБУЕТ БОЛЬШЕ
Dialogue: 0,0:11:17.83,0:11:20.23,Caption,,0,0,0,,ДЕЙСТВИЙ, А В ПЕНТАГОНЕ НАЧИНАЮТ СПРАШИВАТЬ,
Dialogue: 0,0:11:20.43,0:11:23.67,Caption,,0,0,0,,ЧТО ЭТИ ДЕЙСТВИЯ РЕАЛЬНО МЕНЯЮТ. ОДИН СОЮЗНИК
Dialogue: 0,0:11:23.67,0:11:27.43,Caption,,0,0,0,,НАЖИМАЕТ НА ПЕДАЛЬ, ДРУГОЙ ЗАГЛЯДЫВАЕТ ПОД КАПОТ И ИНТЕРЕСУЕТСЯ,
Dialogue: 0,0:11:27.66,0:11:32.55,Caption,,0,0,0,,ПОЧЕМУ МАШИНА ВСЁ ЕЩЁ СТОИТ. ТРАМП ТЕМ ВРЕМЕНЕМ БЕЗ ЛИШНЕЙ ТОРЖЕСТВЕННОСТИ
Dialogue: 0,0:11:32.55,0:11:35.67,Caption,,0,0,0,,ОБЪЯСНЯЕТ ФИНАНСОВУЮ СТОРОНУ. СОЕДИНЁННЫЕ ШТАТЫ
Dialogue: 0,0:11:35.67,0:11:38.23,Caption,,0,0,0,,ПОЛУЧАЮТ ХОРОШУЮ ПРИБЫЛЬ ОТ ВООРУЖЕНИЯ УКРАИНЫ,
Dialogue: 0,0:11:38.46,0:11:40.47,Caption,,0,0,0,,ПОТОМУ ЧТО АМЕРИКАНСКОЕ ОРУЖИЕ ОПЛАЧИВАЮТ
Dialogue: 0,0:11:40.47,0:11:43.43,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ГОСУДАРСТВА. СХЕМА ПРОЗРАЧНЕЕ НЕКУДА.
Dialogue: 0,0:11:43.75,0:11:46.63,Caption,,0,0,0,,ЕВРОПА ДОСТАЁТ КОШЕЛЁК. АМЕРИКАНСКИЕ ПРЕДПРИЯТИЯ
Dialogue: 0,0:11:46.63,0:11:49.51,Caption,,0,0,0,,ПОЛУЧАЮТ ЗАКАЗ. УКРАИНА ПРИНИМАЕТ ВООРУЖЕНИЕ.
Dialogue: 0,0:11:49.90,0:11:52.39,Caption,,0,0,0,,ПРИБЫЛЬ ОСТАЁТСЯ В СОЕДИНЁННЫХ ШТАТАХ. ТЕПЕРЬ
Dialogue: 0,0:11:52.47,0:11:55.35,Caption,,0,0,0,,СОБЕРЁМ АМЕРИКАНСКИЕ ДЕЙСТВИЯ ВМЕСТЕ. УИТКОФФ И
Dialogue: 0,0:11:55.43,0:11:57.75,Caption,,0,0,0,,КУШНЕР СТАРАЮТСЯ БЫСТРЕЕ ВЫВЕСТИ СТОРОНЫ К
Dialogue: 0,0:11:57.75,0:12:00.95,Caption,,0,0,0,,СОГЛАШЕНИЮ. КОЛБИ ТРЕБУЕТ ОБЪЯСНИТЬ СМЫСЛ УДАРОВ,
Dialogue: 0,0:12:01.27,0:12:04.47,Caption,,0,0,0,,КОТОРЫЕ НЕ МЕНЯЮТ ХОД ВОЙНЫ. ТРАМП ДОВОЛЕН ДОХОДАМИ
Dialogue: 0,0:12:04.55,0:12:07.59,Caption,,0,0,0,,ОТ ПРОДАЖИ ВООРУЖЕНИЙ ЕВРОПЕЙЦАМ. ПРОТИВОРЕЧИЕ ЗДЕСЬ
Dialogue: 0,0:12:07.59,0:12:12.71,Caption,,0,0,0,,ТОЛЬКО ДЛЯ ТЕХ, КТО СЧИТАЕТ, БУДТО У ГОСУДАРСТВА МОЖЕТ БЫТЬ ОДИН ИНТЕРЕС И
Dialogue: 0,0:12:12.79,0:12:15.59,Caption,,0,0,0,,ОДНА КНОПКА. ВАШИНГТОН СПОСОБЕН ОДНОВРЕМЕННО
Dialogue: 0,0:12:15.59,0:12:18.39,Caption,,0,0,0,,ДОБИВАТЬСЯ СДЕЛКИ, ЗАРАБАТЫВАТЬ НА ПОСТАВКАХ,
Dialogue: 0,0:12:18.76,0:12:21.91,Caption,,0,0,0,,ТРЕБОВАТЬ БОЛЬШЕЙ ВОЕННОЙ ОТДАЧИ И УКРЕПЛЯТЬ СВОЁ
Dialogue: 0,0:12:21.99,0:12:25.11,Caption,,0,0,0,,ВЛИЯНИЕ НА СОЮЗНИКОВ. ВСЕ ЭТИ ЗАДАЧИ ПРЕКРАСНО
Dialogue: 0,0:12:25.11,0:12:31.32,Caption,,0,0,0,,ПОМЕЩАЮТСЯ В ОДНОЙ КОМНАТЕ. КАЛЛАС ТАМ ПРОСТО НЕ ВЫДАВАЛИ ПРАВО ОПРЕДЕЛЯТЬ
Dialogue: 0,0:12:31.40,0:12:35.48,Caption,,0,0,0,,ИНТЕРЬЕР. ЕВРОПЕ ДОСТАЛАСЬ РОЛЬ КУДА МЕНЕЕ ЗАВИДНАЯ. ОНА
Dialogue: 0,0:12:35.48,0:12:39.00,Caption,,0,0,0,,ТРЕБУЕТ УСТУПОК ОТ МОСКВЫ, СПОРИТ О СОСТАВЕ ПЕРЕГОВОРОВ,
Dialogue: 0,0:12:39.22,0:12:42.36,Caption,,0,0,0,,ФИНАНСИРУЕТ АМЕРИКАНСКИЕ ЗАКАЗЫ И НЕСЁТ ВСЁ БОЛЬШУЮ
Dialogue: 0,0:12:42.44,0:12:46.52,Caption,,0,0,0,,ДОЛЮ РАСХОДОВ. ПРИ ЭТОМ КЛЮЧЕВОЙ ТЕМП ПРОЦЕССА УСТАНАВЛИВАЮТ В
Dialogue: 0,0:12:46.52,0:12:50.84,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТАХ, А НАДЁЖНОСТЬ БУДУЩИХ ДОГОВОРЁННОСТЕЙ СВЯЗЫВАЮТ С
Dialogue: 0,0:12:50.84,0:12:53.56,Caption,,0,0,0,,ОЧЕРЕДНОЙ РАССТАНОВКОЙ СИЛ В АМЕРИКАНСКОМ КОНГРЕССЕ.
Dialogue: 0,0:12:53.87,0:12:56.92,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАНЯТНАЯ НЕЗАВИСИМОСТЬ. ЕВРОПА ОПЛАЧИВАЕТ
Dialogue: 0,0:12:56.92,0:13:02.28,Caption,,0,0,0,,СТОЛ, СТУЛЬЯ И УЖИН, НО МЕНЮ УТВЕРЖДАЮТ ЗА ОКЕАНОМ. ПОТОМ ЕЙ РАЗРЕШАЮТ
Dialogue: 0,0:13:02.28,0:13:04.28,Caption,,0,0,0,,ГРОМКО ПОТРЕБОВАТЬ ОТ РОССИИ УСТУПОК,
Dialogue: 0,0:13:04.44,0:13:06.76,Caption,,0,0,0,,ЧТОБЫ НИКТО НЕ ЗАМЕТИЛ, У КОГО ЛЕЖИТ СЧЁТ.
Dialogue: 0,0:13:07.32,0:13:09.96,Caption,,0,0,0,,ПОЭТОМУ ГЛАВНЫЙ ЕВРОПЕЙСКИЙ ВОПРОС СОВСЕМ НЕ В ТОМ,
Dialogue: 0,0:13:10.13,0:13:13.56,Caption,,0,0,0,,КАКУЮ НОВУЮ ЖЁСТКУЮ ФОРМУЛИРОВКУ АДРЕСОВАТЬ МОСКВЕ И
Dialogue: 0,0:13:13.56,0:13:16.76,Caption,,0,0,0,,КОМУ ЕЩЁ ОТКАЗАТЬ ВО ВХОДЕ. ГОРАЗДО ВАЖНЕЕ ПОНЯТЬ,
Dialogue: 0,0:13:17.01,0:13:20.20,Caption,,0,0,0,,КТО ПРИНИМАЕТ ОКОНЧАТЕЛЬНОЕ РЕШЕНИЕ. ЕСЛИ УСТРОЙСТВО
Dialogue: 0,0:13:20.20,0:13:22.92,Caption,,0,0,0,,БЕЗОПАСНОСТИ ЕВРОПЫ МЕНЯЕТСЯ ВМЕСТЕ С НЕСКОЛЬКИМИ
Dialogue: 0,0:13:22.92,0:13:25.08,Caption,,0,0,0,,КРЕСЛАМИ В КОНГРЕССЕ СОЕДИНЁННЫХ ШТАТОВ,
Dialogue: 0,0:13:25.40,0:13:28.60,Caption,,0,0,0,,ПРОБЛЕМА УЖЕ ДАВНО ВЫШЛА ЗА РАМКИ УКРАИНЫ. КОНТИНЕНТ
Dialogue: 0,0:13:28.60,0:13:30.92,Caption,,0,0,0,,ЗАВИСИТ ОТ ЧУЖОГО ПОЛИТИЧЕСКОГО ЦИКЛА,
Dialogue: 0,0:13:31.16,0:13:34.12,Caption,,0,0,0,,ЧУЖИХ ОРУЖЕЙНЫХ КОНТРАКТОВ И ЧУЖОГО РАСПИСАНИЯ
Dialogue: 0,0:13:34.12,0:13:37.16,Caption,,0,0,0,,ПЕРЕГОВОРОВ, ПРОДОЛЖАЯ ИЗОБРАЖАТЬ ХОЗЯИНА ПРОЦЕССА.
Dialogue: 0,0:13:39.45,0:13:43.61,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, МОЖНО ЛИ СЧИТАТЬ ЕВРОПУ САМОСТОЯТЕЛЬНЫМ УЧАСТНИКОМ,
Dialogue: 0,0:13:43.93,0:13:46.81,Caption,,0,0,0,,ЕСЛИ ДАЖЕ СРОК ЕЁ БУДУЩЕГО СОГЛАШЕНИЯ ОПРЕДЕЛЯЮТ
Dialogue: 0,0:13:46.81,0:13:51.13,Caption,,0,0,0,,ВЫБОРЫ В ДРУГОЙ СТРАНЕ. РАНО ИЛИ ПОЗДНО ЕВРОПЕЙЦАМ ПРИДЁТСЯ ОБСУЖДАТЬ НЕ
Dialogue: 0,0:13:51.13,0:13:55.93,Caption,,0,0,0,,ТОЛЬКО ТРЕБОВАНИЯ К РОССИИ, НО И СОБСТВЕННУЮ ЗАВИСИМОСТЬ ОТ ВАШИНГТОНА. И ДЕЛАТЬ
Dialogue: 0,0:13:55.93,0:14:00.01,Caption,,0,0,0,,ЭТО ЛУЧШЕ НЕ В КОРИДОРЕ, ПОКА ЗА ЗАКРЫТОЙ ДВЕРЬЮ ДРУГИЕ РЕШАЮТ,
Dialogue: 0,0:14:00.24,0:14:03.29,Caption,,0,0,0,,КАКИМ БУДЕТ ИХ СЛЕДУЮЩИЙ ХОД. РАЗГОВОР ВСЁ РАВНО
Dialogue: 0,0:14:03.29,0:14:04.41,Caption,,0,0,0,,СОСТОИТСЯ ЗА СТОЛОМ.
