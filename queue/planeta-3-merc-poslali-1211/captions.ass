Dialogue: 0,0:00:00.12,0:00:03.16,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ЕДИНСТВО ФРИДРИХА МЕРЦА УПЁРЛОСЬ В ЧУЖОЙ
Dialogue: 0,0:00:03.16,0:00:07.24,Caption,,0,0,0,,КОШЕЛЁК РАНЬШЕ, ЧЕМ УСПЕЛО НАПУГАТЬ РОССИЮ. СЛОВАКИЯ ОТКАЗАЛАСЬ
Dialogue: 0,0:00:07.24,0:00:10.28,Caption,,0,0,0,,ПЛАТИТЬ, ЧЕХИЯ ПРИГРОЗИЛА ЗАБЛОКИРОВАТЬ БЮДЖЕТ,
Dialogue: 0,0:00:10.65,0:00:13.64,Caption,,0,0,0,,А НЕМЕЦКАЯ ПОЗИЦИЯ СИЛЫ ВНЕЗАПНО ПРЕВРАТИЛАСЬ В СПОР
Dialogue: 0,0:00:13.64,0:00:17.96,Caption,,0,0,0,,О ТОМ, КТО БУДЕТ ОПЛАЧИВАТЬ СЛЕДУЮЩИЙ СЧЁТ КИЕВА. САМ МЕРЦ
Dialogue: 0,0:00:17.96,0:00:20.68,Caption,,0,0,0,,ПРЕДЛАГАЛ СОВСЕМ ДРУГУЮ КАРТИНУ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:21.00,0:00:23.00,Caption,,0,0,0,,РОССИЯ ПОНИМАЕТ ТОЛЬКО ЯЗЫК СИЛЫ,
Dialogue: 0,0:00:23.21,0:00:25.56,Caption,,0,0,0,,ПОЭТОМУ ЕВРОПЕ СЛЕДУЕТ ДЕЙСТВОВАТЬ СООБЩА,
Dialogue: 0,0:00:25.86,0:00:28.28,Caption,,0,0,0,,ДАВИТЬ НА МОСКВУ, ВООРУЖАТЬ УКРАИНУ,
Dialogue: 0,0:00:28.52,0:00:31.00,Caption,,0,0,0,,ГОТОВИТЬСЯ К ПЕРЕГОВОРАМ. ОН ПРЕДСТАВЛЯЕТ
Dialogue: 0,0:00:31.00,0:00:34.20,Caption,,0,0,0,,НЕПРИМИРИМУЮ ГРУППУ НИ ШАГУ НАЗАД. ВНУШИТЕЛЬНО,
Dialogue: 0,0:00:34.44,0:00:37.24,Caption,,0,0,0,,А МИКРОФОН УЖЕ У ПАРТНЁРОВ. У ЭТОЙ УВЕРЕННОСТИ
Dialogue: 0,0:00:37.32,0:00:39.64,Caption,,0,0,0,,ЕСТЬ СЕМЕЙНАЯ ПОДРОБНОСТЬ. ФРИДРИХ,
Dialogue: 0,0:00:39.87,0:00:42.36,Caption,,0,0,0,,ТВОЙ ДЕД ПО МАТЕРИНСКОЙ ЛИНИИ ЭТУ ЭПОХУ ЗАСТАЛ,
Dialogue: 0,0:00:42.65,0:00:45.80,Caption,,0,0,0,,ОБЪЯСНЯЛ РОССИИ НАМЕРЕНИЯ СИЛОЙ И СОСТОЯЛ В НСДАП.
Dialogue: 0,0:00:46.28,0:00:49.80,Caption,,0,0,0,,ОН ЗНАЛ, ЧЕМ КОНЧИЛОСЬ. КОГДА ГЛАВА ПРАВИТЕЛЬСТВА ГЕРМАНИИ
Dialogue: 0,0:00:49.80,0:00:52.52,Caption,,0,0,0,,ПРЕДЛАГАЕТ СНОВА ВЫБРАТЬ ДЛЯ РАЗГОВОРА С РОССИЕЙ
Dialogue: 0,0:00:52.52,0:00:56.12,Caption,,0,0,0,,ЯЗЫК СИЛЫ, СЕМЕЙНЫЙ АЛЬБОМ СТАНОВИТСЯ НЕ ОБВИНЕНИЕМ,
Dialogue: 0,0:00:56.41,0:00:59.08,Caption,,0,0,0,,А ПРЕДУПРЕЖДЕНИЕМ О КАЧЕСТВЕ УЧЕБНОГО МАТЕРИАЛА.
Dialogue: 0,0:00:59.24,0:01:01.00,Caption,,0,0,0,,БЕРЛИН ЭТОТ КУРС УЖЕ ПРОХОДИЛ,
Dialogue: 0,0:01:01.14,0:01:03.48,Caption,,0,0,0,,ПРИЧЁМ ИТОГОВАЯ ОЦЕНКА БЫЛА ВЫСТАВЛЕНА НЕ
Dialogue: 0,0:01:03.48,0:01:06.52,Caption,,0,0,0,,КАРАНДАШОМ. У САМОЙ ГЕРМАНИИ ЕСТЬ ПРОШЛОЕ,
Dialogue: 0,0:01:06.74,0:01:09.72,Caption,,0,0,0,,КОТОРОЕ ДЕЛАЕТ ТАКИЕ ФОРМУЛИРОВКИ ОСОБЕННО ЗВОНКИМИ.
Dialogue: 0,0:01:10.12,0:01:13.80,Caption,,0,0,0,,МОЖНО СМЕНИТЬ КАНЦЛЕРА, КОАЛИЦИЮ И ОФОРМЛЕНИЕ ТРИБУНЫ.
Dialogue: 0,0:01:16.08,0:01:18.32,Caption,,0,0,0,,НЕЛЬЗЯ ОТМЕНИТЬ ОПЫТ СТРАНЫ ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:01:18.56,0:01:21.20,Caption,,0,0,0,,ЧТО ОН МЕШАЕТ УДАЧНОЙ ФРАЗЕ НА СЕГОДНЯШНЕЙ ПРЕСС
Dialogue: 0,0:01:21.20,0:01:25.92,Caption,,0,0,0,,КОНФЕРЕНЦИИ. РОБЕРТ ФИЦО УСЛЫШАЛ БЕРЛИН И ОТВЕТИЛ БЕЗ ПРИВЫЧНЫХ
Dialogue: 0,0:01:25.92,0:01:30.00,Caption,,0,0,0,,РЕВЕРАНСОВ. ТРЕБОВАНИЕ УЧАСТВОВАТЬ В НОВОМ КРЕДИТЕ УКРАИНЕ
Dialogue: 0,0:01:30.14,0:01:33.28,Caption,,0,0,0,,СЛОВАЦКИЙ ПРЕМЬЕР НАЗВАЛ ШАНТАЖОМ. СЛОВАКИЯ ПЛАТИТЬ
Dialogue: 0,0:01:33.36,0:01:37.04,Caption,,0,0,0,,НЕ СОБИРАЕТСЯ, А НЕМЕЦКОЕ НЕДОВОЛЬСТВО ЭТУ ПОЗИЦИЮ НЕ ОТМЕНЯЕТ.
Dialogue: 0,0:01:37.52,0:01:40.48,Caption,,0,0,0,,ФИЦО НАПОМНИЛ ЕЩЁ ОДНУ НЕУДОБНУЮ ПОДРОБНОСТЬ. У
Dialogue: 0,0:01:40.48,0:01:43.60,Caption,,0,0,0,,ГЕРМАНИИ ЕСТЬ ОДИН ГОЛОС, У СЛОВАКИИ ТОЖЕ ОДИН,
Dialogue: 0,0:01:43.97,0:01:46.72,Caption,,0,0,0,,А СЕМИЛЕТНИЙ БЮДЖЕТ ЕВРОСОЮЗА ТРЕБУЕТ СОГЛАСИЯ.
Dialogue: 0,0:01:47.28,0:01:49.76,Caption,,0,0,0,,КРУПНЕЙШАЯ ЭКОНОМИКА ЕВРОПЫ МОЖЕТ ДОЛГО СТУЧАТЬ
Dialogue: 0,0:01:49.76,0:01:53.84,Caption,,0,0,0,,КУЛАКОМ ПО СТОЛУ, НО ПОДПИСЬ БРАТИСЛАВЫ ОТ ЭТОГО САМА НЕ ПОЯВЛЯЕТСЯ.
Dialogue: 0,0:01:54.07,0:01:57.04,Caption,,0,0,0,,ХИТРЫЙ ПОЛУЧИЛСЯ РЫЧАГ. НАЖИМАЕШЬ НА ФИЦО,
Dialogue: 0,0:01:57.35,0:02:00.16,Caption,,0,0,0,,А ДВЕРЬ ЗАХЛОПЫВАЕТСЯ ПЕРЕД КИЕВОМ. ЕЩЁ НЕМНОГО
Dialogue: 0,0:02:00.16,0:02:04.16,Caption,,0,0,0,,ТАКОЙ ДИСЦИПЛИНЫ, И ЕВРОПЕЙСКИМ ЧИНОВНИКАМ ПРИДЁТСЯ СНАЧАЛА СПАСАТЬ
Dialogue: 0,0:02:04.16,0:02:06.48,Caption,,0,0,0,,УКРАИНУ ОТ ПОСЛЕДСТВИЙ СОБСТВЕННОГО СПАСЕНИЯ.
Dialogue: 0,0:02:07.10,0:02:09.44,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ РАЗБИРАТЬ ЗАЯВЛЕНИЯ ВМЕСТЕ С ИХ
Dialogue: 0,0:02:09.44,0:02:11.28,Caption,,0,0,0,,ПОСЛЕДСТВИЯМИ, ПОДПИСЫВАЙТЕСЬ.
Dialogue: 0,0:02:11.92,0:02:13.92,Caption,,0,0,0,,ФРАЗА МЕРЦА ЗАНИМАЕТ НЕСКОЛЬКО СЕКУНД,
Dialogue: 0,0:02:14.24,0:02:16.40,Caption,,0,0,0,,А ЕВРОПЕЙСКИЙ ОТВЕТ НА НЕЁ УЖЕ ТЯНЕТ НА
Dialogue: 0,0:02:16.40,0:02:18.88,Caption,,0,0,0,,ОТДЕЛЬНОЕ СЕМЕЙНОЕ СОБРАНИЕ С ВЫЯСНЕНИЕМ,
Dialogue: 0,0:02:19.09,0:02:22.08,Caption,,0,0,0,,КТО ОПЯТЬ НЕ СДАЛ ДЕНЬГИ. ТОЛЬКО ПОСЛЕ ОТКАЗОВ
Dialogue: 0,0:02:22.08,0:02:25.20,Caption,,0,0,0,,БРАТИСЛАВЫ И ПРАГИ НЕМЕЦКАЯ СХЕМА ВЫГЛЯДИТ ЦЕЛИКОМ.
Dialogue: 0,0:02:25.50,0:02:28.16,Caption,,0,0,0,,НА СЛЕДУЮЩИЙ ГОД У КИЕВА ОЖИДАЕТСЯ ОГРОМНАЯ
Dialogue: 0,0:02:28.16,0:02:34.11,Caption,,0,0,0,,ФИНАНСОВАЯ ДЫРА. БЕРЛИН ХОЧЕТ РАСПРЕДЕЛИТЬ ЕЁ МЕЖДУ ВСЕМИ ЧЛЕНАМИ
Dialogue: 0,0:02:34.11,0:02:37.87,Caption,,0,0,0,,ЕВРОСОЮЗА, ЧТОБЫ ПОМОЩЬ ПРОДОЛЖАЛАСЬ НЕЗАВИСИМО ОТ НАСТРОЕНИЯ
Dialogue: 0,0:02:37.87,0:02:40.51,Caption,,0,0,0,,ОТДЕЛЬНЫХ ПРАВИТЕЛЬСТВ. ПО НЕМЕЦКОЙ ЛОГИКЕ,
Dialogue: 0,0:02:40.82,0:02:44.99,Caption,,0,0,0,,УЧАСТИЕ ДОЛЖНО БЫТЬ ОБЩИМ, ПОТОМУ ЧТО И ОТВЕТСТВЕННОСТЬ ОБЪЯВЛЕНА ОБЩЕЙ.
Dialogue: 0,0:02:45.55,0:02:47.95,Caption,,0,0,0,,НА ПРАКТИКЕ ОБЩИЙ СЧЁТ ПРИШЁЛ ДВАДЦАТИ СЕМИ
Dialogue: 0,0:02:47.95,0:02:52.03,Caption,,0,0,0,,ГОСУДАРСТВАМ, А ЗАКАЗЫВАЛА ДАЛЕКО НЕ ВСЯ КОМПАНИЯ. ОФИЦИАНТ УЖЕ
Dialogue: 0,0:02:52.03,0:02:55.79,Caption,,0,0,0,,ПОЛОЖИЛ ПАПКУ НА СТОЛ, И ТЕПЕРЬ СОСЕДИ ИЗУЧАЮТ НЕ МЕНЮ,
Dialogue: 0,0:02:55.98,0:02:58.99,Caption,,0,0,0,,А ДРУГ ДРУГА. МЕРЦ ТРЕБУЕТ ЕДИНСТВА,
Dialogue: 0,0:02:59.16,0:03:01.15,Caption,,0,0,0,,ПРОДОЛЖЕНИЯ САНКЦИОННОГО ДАВЛЕНИЯ,
Dialogue: 0,0:03:01.31,0:03:04.91,Caption,,0,0,0,,ВОЕННОЙ ПОДДЕРЖКИ И ПОДГОТОВКИ К ПЕРЕГОВОРАМ. ФИЦО
Dialogue: 0,0:03:04.91,0:03:08.35,Caption,,0,0,0,,ТРЕБУЕТ НЕ КОМАНДОВАТЬ СЛОВАКИЕЙ ЧЕРЕЗ БЮДЖЕТ. БАБИШ
Dialogue: 0,0:03:08.35,0:03:12.03,Caption,,0,0,0,,ПОКАЗЫВАЕТ, ЧТО ОТВЕТНЫЙ УДАР ПО БЮДЖЕТУ ПЕРВЫМ ДЕЛОМ ЗАДЕНЕТ
Dialogue: 0,0:03:12.03,0:03:15.63,Caption,,0,0,0,,ПОЛУЧАТЕЛЯ НЕМЕЦКОЙ ПОМОЩИ. ТАК ПОЗИЦИЯ СИЛЫ ПРОШЛА
Dialogue: 0,0:03:15.63,0:03:18.67,Caption,,0,0,0,,ПЕРВОЕ ИСПЫТАНИЕ. ДО МОСКВЫ ОНА ЕЩЁ НЕ ДОБРАЛАСЬ,
Dialogue: 0,0:03:18.83,0:03:21.87,Caption,,0,0,0,,ЗАТО ВНУТРИ ЕВРОСОЮЗА УСПЕЛА НАЙТИ ДВЕ СТОЛИЦЫ,
Dialogue: 0,0:03:22.14,0:03:24.67,Caption,,0,0,0,,КОТОРЫЕ НЕ ЖЕЛАЮТ ВЫПОЛНЯТЬ БЕРЛИНСКУЮ КОМАНДУ.
Dialogue: 0,0:03:25.04,0:03:27.15,Caption,,0,0,0,,РОССИЯ ПОКА ДАЖЕ НЕ ВОШЛА В КОМНАТУ,
Dialogue: 0,0:03:27.46,0:03:29.71,Caption,,0,0,0,,А УЧАСТНИКИ УЖЕ ДЕЛЯТ КЛЮЧ ОТ КАССЫ.
Dialogue: 0,0:03:30.58,0:03:33.15,Caption,,0,0,0,,СЛЕДУЮЩИЙ УЧАСТОК ЭТОЙ ИСТОРИИ НАХОДИТСЯ ГОРАЗДО
Dialogue: 0,0:03:33.15,0:03:35.63,Caption,,0,0,0,,БЛИЖЕ К РОССИЙСКОЙ ТЕРРИТОРИИ. ТАМ ГРОМКИЕ
Dialogue: 0,0:03:35.63,0:03:38.43,Caption,,0,0,0,,ФОРМУЛИРОВКИ СОПРОВОЖДАЮТСЯ НЕ БЮДЖЕТНЫМИ ТАБЛИЦАМИ,
Dialogue: 0,0:03:38.59,0:03:41.47,Caption,,0,0,0,,А ТРЕНИРОВКАМИ ЭНЕРГЕТИКОВ, РАБОТОЙ СПЕЦСЛУЖБ,
Dialogue: 0,0:03:41.71,0:03:44.11,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРОЙ И НОВЫМИ РАКЕТАМИ.
Dialogue: 0,0:03:46.39,0:03:50.87,Caption,,0,0,0,,ЕВРОПА ТУТ УЖЕ НЕ ГОТОВИТСЯ, А ПЕРЕХОДИТ К СКРЫТЫМ ВОЕННЫМ ДЕЙСТВИЯМ ПОСЛЕ ЗВОНКА
Dialogue: 0,0:03:50.87,0:03:53.75,Caption,,0,0,0,,ПУТИНУ ФИНЛЯНДИЯ РЕШИЛА РАЗМЕСТИТЬ ЯДЕРНОЕ ОРУЖИЕ,
Dialogue: 0,0:03:53.90,0:03:58.23,Caption,,0,0,0,,ФРАНЦИЯ РЯДОМ. В ЛИТВЕ НАЧАЛИСЬ УЧЕНИЯ ПО ЭНЕРГОУСТОЙЧИВОСТИ. НА
Dialogue: 0,0:03:58.23,0:04:00.47,Caption,,0,0,0,,СЦЕНЕ ПОЛИТИКИ ПРОИЗНОСЯТ СЛОВО "СИЛА",
Dialogue: 0,0:04:00.79,0:04:02.87,Caption,,0,0,0,,А В СОСЕДНЕЙ КОМНАТЕ ИНЖЕНЕРЫ ВЫЯСНЯЮТ,
Dialogue: 0,0:04:03.03,0:04:06.23,Caption,,0,0,0,,КАКОЙ УЗЕЛ ОТКЛЮЧИТСЯ ПЕРВЫМ. У ИНЖЕНЕРОВ ВООБЩЕ
Dialogue: 0,0:04:06.23,0:04:08.95,Caption,,0,0,0,,ВРЕДНАЯ ПРИВЫЧКА. ОНИ ПЕРЕВОДЯТ КРАСИВУЮ РЕЧЬ В
Dialogue: 0,0:04:08.95,0:04:12.95,Caption,,0,0,0,,МЕГАВАТТЫ, РЕЗЕРВНЫЕ ЛИНИИ И КОЛИЧЕСТВО ЧАСОВ ДО ОСТАНОВКИ
Dialogue: 0,0:04:12.95,0:04:16.15,Caption,,0,0,0,,СИСТЕМЫ. САМИ УЧЕНИЯ НЕ ОБЪЯВЛЕНЫ ПОДГОТОВКОЙ К
Dialogue: 0,0:04:16.15,0:04:19.03,Caption,,0,0,0,,КОНКРЕТНОМУ КОНФЛИКТУ. НО ИХ СОДЕРЖАНИЕ ГОВОРИТ О
Dialogue: 0,0:04:19.11,0:04:22.31,Caption,,0,0,0,,ТОМ, КАКОЙ КРИЗИС УЧАСТНИКИ СЧИТАЮТ ДОСТОЙНЫМ
Dialogue: 0,0:04:22.31,0:04:27.67,Caption,,0,0,0,,ПРАКТИЧЕСКОЙ ПОДГОТОВКИ. ГАЗ, ЭЛЕКТРИЧЕСТВО И КРИТИЧЕСКИЕ ОБЪЕКТЫ ТРЕНИРУЮТ НЕ
Dialogue: 0,0:04:27.67,0:04:30.47,Caption,,0,0,0,,РАДИ ХОРОШЕЙ ФОТОГРАФИИ НА ПАМЯТЬ. ГЕОГРАФИЯ
Dialogue: 0,0:04:30.47,0:04:33.11,Caption,,0,0,0,,ДОБАВЛЯЕТ ЭТОЙ РАБОТЕ ВПОЛНЕ ОПРЕДЕЛЁННЫЙ АДРЕС.
Dialogue: 0,0:04:33.51,0:04:36.07,Caption,,0,0,0,,КАЛИНИНГРАДСКАЯ ОБЛАСТЬ НАХОДИТСЯ МЕЖДУ ПОЛЬШЕЙ И
Dialogue: 0,0:04:36.07,0:04:39.19,Caption,,0,0,0,,ЛИТВОЙ. ЛЮБОЕ СИЛОВОЕ ДВИЖЕНИЕ ВОКРУГ НЕЁ ВЫВОДИТ
Dialogue: 0,0:04:39.27,0:04:42.31,Caption,,0,0,0,,СПОР ЗА ПРЕДЕЛЫ УКРАИНЫ И СТАВИТ РЯДОМ РОССИЮ
Dialogue: 0,0:04:42.39,0:04:45.35,Caption,,0,0,0,,И ГОСУДАРСТВА НАТО УЖЕ БЕЗ УДОБНОГО ПОСРЕДНИКА.
Dialogue: 0,0:04:45.75,0:04:47.75,Caption,,0,0,0,,ПОЛЬША ПРИ ЭТОМ НЕ МОЖЕТ РАЗДЕЛИТЬСЯ НА ДВЕ
Dialogue: 0,0:04:47.75,0:04:51.11,Caption,,0,0,0,,РАЗНЫЕ СТРАНЫ. ОДНА ПОЛЬСКАЯ АРМИЯ ПОМОГАЕТ КИЕВУ НА
Dialogue: 0,0:04:51.11,0:04:55.43,Caption,,0,0,0,,УКРАИНСКОМ НАПРАВЛЕНИИ, УКРЕПЛЯЕТ СОБСТВЕННУЮ ИНФРАСТРУКТУРУ У КАЛИНИНГРАДА
Dialogue: 0,0:04:55.59,0:04:58.47,Caption,,0,0,0,,И УЧАСТВУЕТ В ПОДГОТОВКЕ СЕВЕРО ВОСТОЧНОГО ФЛАНГА.
Dialogue: 0,0:05:00.76,0:05:05.16,Caption,,0,0,0,,НАПРАВЛЕНИЯ РАЗНЫЕ, ГЕНЕРАЛЬНЫЙ ШТАБ ОДИН. ПАРАЛЛЕЛЬНО РОССИЙСКАЯ ФСБ
Dialogue: 0,0:05:05.16,0:05:08.52,Caption,,0,0,0,,СООБЩИЛА О ЗАДЕРЖАНИИ ДВУХ ЧЕЛОВЕК. ИХ ОБВИНЯЮТ В
Dialogue: 0,0:05:08.52,0:05:10.92,Caption,,0,0,0,,РАБОТЕ НА ПОЛЬСКУЮ РАЗВЕДКУ И СБОРЕ СВЕДЕНИЙ О
Dialogue: 0,0:05:11.00,0:05:14.12,Caption,,0,0,0,,ВОЕННЫХ ОБЪЕКТАХ КАЛИНИНГРАДСКОЙ ОБЛАСТИ. ВАРШАВА
Dialogue: 0,0:05:14.12,0:05:16.68,Caption,,0,0,0,,ОТВЕРГЛА ОБВИНЕНИЯ И НАЗВАЛА ЗАЯВЛЕНИЕ РОССИИ
Dialogue: 0,0:05:16.68,0:05:21.08,Caption,,0,0,0,,ПРОВОКАЦИЕЙ И ДЕЗИНФОРМАЦИЕЙ. РАЗГОВОР УЖЕ ИДЁТ НЕ О ТОМ,
Dialogue: 0,0:05:21.32,0:05:24.28,Caption,,0,0,0,,КТО КОГО НЕПРАВИЛЬНО ПОНЯЛ НА ПРЕСС КОНФЕРЕНЦИИ. ДВЕ
Dialogue: 0,0:05:24.36,0:05:27.16,Caption,,0,0,0,,СТОРОНЫ ПУБЛИЧНО СПОРЯТ О РАЗВЕДЫВАТЕЛЬНОЙ РАБОТЕ
Dialogue: 0,0:05:27.16,0:05:29.88,Caption,,0,0,0,,ВОЗЛЕ КОНКРЕТНЫХ ВОЕННЫХ ОБЪЕКТОВ. НА ЭТОМ ФОНЕ
Dialogue: 0,0:05:29.96,0:05:34.60,Caption,,0,0,0,,СЕРГЕЙ РЯБКОВ СООБЩИЛ, ЧТО МОСКВЕ ИЗВЕСТНЫ РАЗГОВОРЫ И ПРЕДПОЛАГАЕМЫЕ ПЛАНЫ
Dialogue: 0,0:05:34.60,0:05:37.16,Caption,,0,0,0,,О БЛОКАДЕ КАЛИНИНГРАДСКОЙ ОБЛАСТИ. ОТВЕТ ОН
Dialogue: 0,0:05:37.16,0:05:39.56,Caption,,0,0,0,,СФОРМУЛИРОВАЛ КОРОТКО ПОПЫТКА ВОПЛОТИТЬ ТАКОЙ
Dialogue: 0,0:05:39.56,0:05:42.60,Caption,,0,0,0,,СЦЕНАРИЙ СТАНЕТ ПРЯМЫМ ПУТЁМ К КАТАСТРОФЕ. ЭТО И
Dialogue: 0,0:05:42.68,0:05:46.68,Caption,,0,0,0,,ЕСТЬ МОМЕНТ, КОГДА ВЫРАЖЕНИЕ МЕРЦА СНИМАЕТ ДОРОГОЙ ПИДЖАК. В
Dialogue: 0,0:05:46.68,0:05:49.80,Caption,,0,0,0,,ОБЫЧНОЙ ЖИЗНИ ЯЗЫК СИЛЫ ВЫГЛЯДИТ КАК ПОДГОТОВЛЕННАЯ
Dialogue: 0,0:05:49.80,0:05:52.12,Caption,,0,0,0,,ЭНЕРГОСЕТЬ, ОБВИНЕНИЕ В ШПИОНАЖЕ,
Dialogue: 0,0:05:52.34,0:05:55.32,Caption,,0,0,0,,УКРЕПЛЁННАЯ ИНФРАСТРУКТУРА И ПРЕДУПРЕЖДЕНИЕ,
Dialogue: 0,0:05:55.56,0:05:57.88,Caption,,0,0,0,,В КОТОРОМ СЛОВО "КАТАСТРОФА" УЖЕ НЕ СЛУЖИТ
Dialogue: 0,0:05:57.88,0:06:02.04,Caption,,0,0,0,,УКРАШЕНИЕМ. КАЛИНИНГРАД НЕВОЗМОЖНО ПЕРЕДВИНУТЬ ПОДАЛЬШЕ ОТ
Dialogue: 0,0:06:02.04,0:06:06.20,Caption,,0,0,0,,ПОЛЬШИ И ЛИТВЫ, ЧТОБЫ ВСЕМ СТАЛО СПОКОЙНЕЕ. ОН ОСТАЁТСЯ РОССИЙСКОЙ
Dialogue: 0,0:06:06.20,0:06:09.40,Caption,,0,0,0,,ТЕРРИТОРИЕЙ МЕЖДУ ДВУМЯ ЧЛЕНАМИ НАТО. ЗНАЧИТ,
Dialogue: 0,0:06:09.72,0:06:12.76,Caption,,0,0,0,,ЛЮБАЯ ПРОВЕРКА СИЛЫ ЗДЕСЬ ПРОХОДИТ НА РАССТОЯНИИ,
Dialogue: 0,0:06:12.92,0:06:15.16,Caption,,0,0,0,,ГДЕ ОШИБКА НЕ УСПЕВАЕТ ОСТЫТЬ ПО ДОРОГЕ.
Dialogue: 0,0:06:17.43,0:06:19.59,Caption,,0,0,0,,ПОСЛЕДНИМ ДОВОДОМ В ЭТОМ БЛОКЕ СТАНОВЯТСЯ
Dialogue: 0,0:06:19.59,0:06:22.71,Caption,,0,0,0,,АМЕРИКАНСКИЕ РАКЕТЫ. РОССИЙСКАЯ СТОРОНА ЗАЯВИЛА О
Dialogue: 0,0:06:22.71,0:06:25.91,Caption,,0,0,0,,ПЕРВОМ ПЕРЕХВАТЕ ЧЕТЫРЁХ КРЫЛАТЫХ РАКЕТ АГМ СТО
Dialogue: 0,0:06:25.91,0:06:29.11,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ВОСЕМЬ ЭЙ "РАСТИ ДАГГЕР". ЭТИ РАКЕТЫ
Dialogue: 0,0:06:29.11,0:06:32.23,Caption,,0,0,0,,ОТНОСЯТСЯ К СЕМЕЙСТВУ ЭРАМ. АМЕРИКАНСКИЙ ЗАМЫСЕЛ
Dialogue: 0,0:06:32.23,0:06:34.71,Caption,,0,0,0,,СТРОИТСЯ НЕ ВОКРУГ ШТУЧНОГО ОРУЖИЯ С ЦЕННИКОМ
Dialogue: 0,0:06:34.71,0:06:38.47,Caption,,0,0,0,,НЕБОЛЬШОГО ДВОРЦА, А ВОКРУГ СРАВНИТЕЛЬНО ДЕШЁВОГО ИЗДЕЛИЯ,
Dialogue: 0,0:06:38.63,0:06:41.83,Caption,,0,0,0,,ПРИГОДНОГО ДЛЯ КРУПНОСЕРИЙНОГО ВЫПУСКА. РАСЧЁТ ПРОСТ
Dialogue: 0,0:06:41.93,0:06:44.87,Caption,,0,0,0,,И ПОТОМУ НЕПРИЯТЕН. ТЫСЯЧИ ДОСТУПНЫХ РАКЕТ ПОЗВОЛЯЮТ
Dialogue: 0,0:06:44.87,0:06:49.59,Caption,,0,0,0,,СОЗДАВАТЬ МНОЖЕСТВО ЦЕЛЕЙ, УВЕЛИЧИВАТЬ ЧИСЛО ПУСКОВ И ПОСТОЯННО НАГРУЖАТЬ
Dialogue: 0,0:06:49.59,0:06:52.71,Caption,,0,0,0,,ПРОТИВОВОЗДУШНУЮ ОБОРОНУ. ЦЕНА ОТДЕЛЬНОГО ИЗДЕЛИЯ
Dialogue: 0,0:06:52.71,0:06:56.79,Caption,,0,0,0,,СНИЖАЕТСЯ, А ЦЕНА ЗАЩИТЫ ОТ ВСЕЙ МАССЫ РАСТЁТ. РОССИЙСКИЕ
Dialogue: 0,0:06:56.79,0:07:01.27,Caption,,0,0,0,,ВОЕННЫЕ УТВЕРЖДАЮТ, ЧТО ПЕРВЫЕ ЧЕТЫРЕ РАКЕТЫ УЖЕ ПЕРЕХВАЧЕНЫ. ДЛЯ САМОЙ
Dialogue: 0,0:07:01.27,0:07:04.31,Caption,,0,0,0,,ЛОГИКИ ПРОТИВОСТОЯНИЯ ВАЖНЕЕ ДРУГОЕ. НОВОЕ
Dialogue: 0,0:07:04.31,0:07:06.55,Caption,,0,0,0,,ДАЛЬНОБОЙНОЕ ОРУЖИЕ ДОШЛО ДО ПРИМЕНЕНИЯ,
Dialogue: 0,0:07:06.78,0:07:09.27,Caption,,0,0,0,,А ОТВЕТОМ СТАЛО ЕГО УНИЧТОЖЕНИЕ В ВОЗДУХЕ.
Dialogue: 0,0:07:09.83,0:07:11.59,Caption,,0,0,0,,ТЕПЕРЬ ПЕРЕНЕСЁМСЯ В ЮЖНУЮ КОРЕЮ,
Dialogue: 0,0:07:11.99,0:07:14.79,Caption,,0,0,0,,ГДЕ НЕДАВНО ПЫТАЛИСЬ ПРОДАТЬ ПУБЛИКЕ СЛИШКОМ УДОБНУЮ
Dialogue: 0,0:07:14.79,0:07:18.55,Caption,,0,0,0,,СЕНСАЦИЮ. КОМПАНИЯ "НЬЮТАЙП ИНДАСТРИЗ" ЯКОБЫ
Dialogue: 0,0:07:18.55,0:07:21.51,Caption,,0,0,0,,ПРЕКРАТИЛА СОТРУДНИЧЕСТВО С УКРАИНОЙ И ОСТАНОВИЛА
Dialogue: 0,0:07:21.59,0:07:23.83,Caption,,0,0,0,,ИСПЫТАНИЯ СИСТЕМЫ ИСКУССТВЕННОГО ИНТЕЛЛЕКТА ДЛЯ
Dialogue: 0,0:07:23.83,0:07:26.95,Caption,,0,0,0,,АРТИЛЛЕРИИ ПОСЛЕ ДИПЛОМАТИЧЕСКОГО КОНФЛИКТА. ИСТОРИЯ
Dialogue: 0,0:07:26.95,0:07:31.11,Caption,,0,0,0,,ВЫГЛЯДЕЛА ТАК АККУРАТНО, БУДТО ЕЁ СРАЗУ ПИСАЛИ ДЛЯ ПОБЕДНОГО ЗАГОЛОВКА.
Dialogue: 0,0:07:33.40,0:07:37.40,Caption,,0,0,0,,ЮЖНОКОРЕЙЦЫ ОБИДЕЛИСЬ, УКРАИНА ПОТЕРЯЛА ТЕХНОЛОГИЧЕСКОГО ПАРТНЁРА,
Dialogue: 0,0:07:37.55,0:07:40.44,Caption,,0,0,0,,ЗАНАВЕС МОЖНО ОПУСКАТЬ. ПРАВДА ПРОДЕРЖАЛАСЬ ДОЛЬШЕ
Dialogue: 0,0:07:40.44,0:07:43.80,Caption,,0,0,0,,САМОЙ ПУБЛИКАЦИИ. ИЗДАНИЕ "ЗЕ ДИПЛОМАТ" ОТОЗВАЛО
Dialogue: 0,0:07:43.80,0:07:47.40,Caption,,0,0,0,,МАТЕРИАЛ И ПРИЗНАЛО, ЧТО ИНТЕРВЬЮ С РУКОВОДИТЕЛЕМ КОМПАНИИ БЫЛО
Dialogue: 0,0:07:47.40,0:07:50.12,Caption,,0,0,0,,СФАБРИКОВАНО. ПРЕДСТАВИТЕЛИ "НЬЮТАЙП ИНДАСТРИЗ"
Dialogue: 0,0:07:50.12,0:07:52.44,Caption,,0,0,0,,СООБЩИЛИ, ЧТО ТАКОГО РАЗГОВОРА НЕ БЫЛО,
Dialogue: 0,0:07:52.68,0:07:55.32,Caption,,0,0,0,,А ОПУБЛИКОВАННЫЕ ОТ ИХ ИМЕНИ ЦИТАТЫ ПРИДУМАНЫ.
Dialogue: 0,0:07:55.72,0:07:59.72,Caption,,0,0,0,,ЗНАЧИТ, ЭФФЕКТНОГО РАЗРЫВА С УКРАИНОЙ НЕ ПРОИЗОШЛО. ПОДДЕЛКА
Dialogue: 0,0:07:59.80,0:08:01.80,Caption,,0,0,0,,ЗДЕСЬ ПОЛЕЗНА ТОЛЬКО КАК ПРИМЕР ТОГО,
Dialogue: 0,0:08:02.02,0:08:04.68,Caption,,0,0,0,,НАСКОЛЬКО ОХОТНО ПУБЛИКА ПРИНИМАЕТ СЮЖЕТ,
Dialogue: 0,0:08:04.91,0:08:07.56,Caption,,0,0,0,,ЕСЛИ ОН УКЛАДЫВАЕТСЯ В ЗАРАНЕЕ ПРИГОТОВЛЕННЫЙ ВЫВОД.
Dialogue: 0,0:08:08.07,0:08:10.28,Caption,,0,0,0,,ФАЛЬШИВОМУ ИНТЕРВЬЮ ДАЖЕ НЕ ПРИШЛОСЬ ДОЛГО
Dialogue: 0,0:08:10.28,0:08:13.56,Caption,,0,0,0,,УГОВАРИВАТЬ ЧИТАТЕЛЯ. РЕАЛЬНОЕ ПОВЕДЕНИЕ СЕУЛА
Dialogue: 0,0:08:13.62,0:08:16.52,Caption,,0,0,0,,ИНТЕРЕСНЕЕ ЭТОЙ ДЕШЁВОЙ ПОСТАНОВКИ. ЮЖНАЯ КОРЕЯ
Dialogue: 0,0:08:16.52,0:08:18.68,Caption,,0,0,0,,СОХРАНЯЕТ СОЮЗ С СОЕДИНЁННЫМИ ШТАТАМИ,
Dialogue: 0,0:08:18.87,0:08:23.96,Caption,,0,0,0,,ПРОВОДИТ СОВМЕСТНЫЕ УЧЕНИЯ, РАБОТАЕТ С ЯПОНИЕЙ И ВНИМАТЕЛЬНО СЛЕДИТ ЗА ВОЕННЫМИ
Dialogue: 0,0:08:23.96,0:08:27.32,Caption,,0,0,0,,ВОЗМОЖНОСТЯМИ КНДР. ПРИЧИНА НАХОДИТСЯ БУКВАЛЬНО НАД
Dialogue: 0,0:08:27.32,0:08:30.36,Caption,,0,0,0,,НЕЙ НА КАРТЕ. У СЕВЕРНОЙ КОРЕИ ЕСТЬ ЯДЕРНОЕ
Dialogue: 0,0:08:30.36,0:08:33.16,Caption,,0,0,0,,ОРУЖИЕ, РАКЕТЫ И ОГРОМНАЯ АРМИЯ.
Dialogue: 0,0:08:33.78,0:08:36.04,Caption,,0,0,0,,ЗА ПОСЛЕДНИЕ ГОДЫ ПХЕНЬЯН РАСШИРИЛ ВОЕННОЕ
Dialogue: 0,0:08:36.04,0:08:41.00,Caption,,0,0,0,,СОТРУДНИЧЕСТВО С МОСКВОЙ, А ЕГО ВОЕННОСЛУЖАЩИЕ ПОЛУЧИЛИ БОЕВОЙ ОПЫТ. ДЛЯ СЕУЛА
Dialogue: 0,0:08:41.00,0:08:43.64,Caption,,0,0,0,,ВАЖЕН НЕ ТОЛЬКО САМ СОЮЗ РОССИИ И КНДР.
Dialogue: 0,0:08:45.91,0:08:48.47,Caption,,0,0,0,,ЮЖНОКОРЕЙСКОЕ РУКОВОДСТВО ВЫНУЖДЕНО ОЦЕНИВАТЬ,
Dialogue: 0,0:08:48.68,0:08:53.43,Caption,,0,0,0,,КАКИЕ ТЕХНОЛОГИИ, ЗНАНИЯ И ВОЗМОЖНОСТИ ПХЕНЬЯН МОЖЕТ ПОЛУЧИТЬ
Dialogue: 0,0:08:53.43,0:08:56.39,Caption,,0,0,0,,БЛАГОДАРЯ ЭТИМ ОТНОШЕНИЯМ. ТУТ ЛОЗУНГ ПРОВЕРЯЕТСЯ НЕ
Dialogue: 0,0:08:56.39,0:08:59.75,Caption,,0,0,0,,АПЛОДИСМЕНТАМИ, А РАССТОЯНИЕМ ДО СЕВЕРНОЙ ГРАНИЦЫ.
Dialogue: 0,0:09:00.31,0:09:03.19,Caption,,0,0,0,,МОЖНО ПРОВОДИТЬ УЧЕНИЯ С АМЕРИКАНЦАМИ И УКРЕПЛЯТЬ
Dialogue: 0,0:09:03.19,0:09:05.99,Caption,,0,0,0,,СВЯЗИ С ТОКИО. СЕВЕРНАЯ КОРЕЯ ОТ ЭТОГО НЕ
Dialogue: 0,0:09:05.99,0:09:09.35,Caption,,0,0,0,,ПЕРЕЕЗЖАЕТ. ОНА ОСТАЁТСЯ РЯДОМ СО СВОИМ АРСЕНАЛОМ,
Dialogue: 0,0:09:09.58,0:09:13.03,Caption,,0,0,0,,АРМИЕЙ И НОВЫМИ СВЯЗЯМИ С МОСКВОЙ. ВОТ ТАКАЯ
Dialogue: 0,0:09:13.03,0:09:17.67,Caption,,0,0,0,,СОСЕДСКАЯ НЕДВИЖИМОСТЬ, ОБМЕНУ И ВОЗВРАТУ НЕ ПОДЛЕЖИТ. КОНТЕЙНЕРОВОЗ
Dialogue: 0,0:09:17.67,0:09:20.63,Caption,,0,0,0,,"ПАНСТАР АКРО" ПРОШЁЛ ИЗ ПУСАНА В ЕВРОПУ ПО
Dialogue: 0,0:09:20.63,0:09:23.27,Caption,,0,0,0,,АРКТИЧЕСКОМУ МАРШРУТУ И ВЕРНУЛСЯ ПРИМЕРНО ЗА
Dialogue: 0,0:09:23.27,0:09:26.23,Caption,,0,0,0,,ПЯТЬДЕСЯТ ДНЕЙ. ТЕПЕРЬ СЕУЛ РАССЧИТЫВАЕТ РАЗВИВАТЬ
Dialogue: 0,0:09:26.31,0:09:29.11,Caption,,0,0,0,,ЭТО НАПРАВЛЕНИЕ И ПЕРЕЙТИ К РЕГУЛЯРНЫМ ПЕРЕВОЗКАМ
Dialogue: 0,0:09:29.11,0:09:31.43,Caption,,0,0,0,,ПРИБЛИЗИТЕЛЬНО К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ.
Dialogue: 0,0:09:31.85,0:09:34.07,Caption,,0,0,0,,ЮЖНОКОРЕЙСКИЙ ПРЕЗИДЕНТ ГОВОРИТ О СОБЛЮДЕНИИ
Dialogue: 0,0:09:34.07,0:09:37.11,Caption,,0,0,0,,МЕЖДУНАРОДНЫХ НОРМ И САНКЦИЙ. ОДНАКО ОТ САМОГО
Dialogue: 0,0:09:37.11,0:09:40.07,Caption,,0,0,0,,ПРОЕКТА СТРАНА НЕ ОТКАЗЫВАЕТСЯ. ФОРМУЛА ПОЛУЧИЛАСЬ
Dialogue: 0,0:09:40.10,0:09:42.07,Caption,,0,0,0,,ВЗРОСЛАЯ ОГРАНИЧЕНИЯ УЧИТЫВАЕМ,
Dialogue: 0,0:09:42.31,0:09:46.71,Caption,,0,0,0,,ВЫГОДУ СЧИТАЕМ, КАРТУ СО СТОЛА НЕ ВЫБРАСЫВАЕМ. ЧЕРЕЗ СУЭЦ ПУТЬ
Dialogue: 0,0:09:46.71,0:09:49.67,Caption,,0,0,0,,ДЛИННЕЕ. АРКТИЧЕСКИЙ МАРШРУТ ПРИ БЛАГОПРИЯТНЫХ
Dialogue: 0,0:09:49.75,0:09:52.79,Caption,,0,0,0,,УСЛОВИЯХ СОКРАЩАЕТ ВРЕМЯ. У ЮЖНОЙ КОРЕИ МОЩНАЯ
Dialogue: 0,0:09:52.79,0:09:54.39,Caption,,0,0,0,,СУДОСТРОИТЕЛЬНАЯ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:09:54.60,0:09:57.51,Caption,,0,0,0,,А ПУСАН ВХОДИТ В ЧИСЛО КРУПНЕЙШИХ ПОРТОВЫХ УЗЛОВ
Dialogue: 0,0:09:57.51,0:10:00.31,Caption,,0,0,0,,МИРА. ДЛЯ НЕЁ ЭТО НЕ ЭКСКУРСИЯ СРЕДИ ЛЬДОВ,
Dialogue: 0,0:10:00.55,0:10:02.63,Caption,,0,0,0,,А ВОЗМОЖНАЯ ЧАСТЬ БУДУЩЕЙ ТОРГОВЛИ.
Dialogue: 0,0:10:04.91,0:10:07.23,Caption,,0,0,0,,РОССИЯ В ТАКОМ РАСЧЁТЕ ОДНОВРЕМЕННО ЯВЛЯЕТСЯ
Dialogue: 0,0:10:07.23,0:10:12.11,Caption,,0,0,0,,ПАРТНЁРОМ СЕВЕРНОЙ КОРЕИ, СЛОЖНЫМ СОБЕСЕДНИКОМ ДЛЯ СЕУЛА И НЕОБХОДИМЫМ
Dialogue: 0,0:10:12.11,0:10:14.27,Caption,,0,0,0,,УЧАСТНИКОМ СЕВЕРНОГО МОРСКОГО КОРИДОРА.
Dialogue: 0,0:10:14.88,0:10:16.91,Caption,,0,0,0,,ТРИ ОБСТОЯТЕЛЬСТВА СУЩЕСТВУЮТ СРАЗУ,
Dialogue: 0,0:10:17.15,0:10:18.83,Caption,,0,0,0,,ПОЭТОМУ ХЛОПНУТЬ ДВЕРЬЮ МОЖНО,
Dialogue: 0,0:10:19.07,0:10:21.71,Caption,,0,0,0,,НО МАРШРУТ ОТ ЭТОГО КОРОЧЕ НЕ СТАНЕТ. ВОТ
Dialogue: 0,0:10:21.71,0:10:24.43,Caption,,0,0,0,,ЧЕМ ЮЖНОКОРЕЙСКИЙ ПОДХОД ОТЛИЧАЕТСЯ ОТ НЕМЕЦКОЙ
Dialogue: 0,0:10:24.43,0:10:26.67,Caption,,0,0,0,,РЕШИТЕЛЬНОСТИ. СЕУЛ НЕ ИЗОБРАЖАЕТ,
Dialogue: 0,0:10:26.79,0:10:29.39,Caption,,0,0,0,,БУДТО ОДНОГО ПРАВИЛЬНОГО ЗАЯВЛЕНИЯ ДОСТАТОЧНО ДЛЯ
Dialogue: 0,0:10:29.39,0:10:32.19,Caption,,0,0,0,,УСТРАНЕНИЯ ВСЕХ ПРОТИВОРЕЧИЙ. ТАМ ЗНАЮТ ЦЕНУ
Dialogue: 0,0:10:32.19,0:10:36.03,Caption,,0,0,0,,АМЕРИКАНСКОМУ СОЮЗУ, ОПАСНОСТИ С СЕВЕРА И РОССИЙСКОЙ АРКТИКЕ.
Dialogue: 0,0:10:36.68,0:10:40.99,Caption,,0,0,0,,ЕСЛИ ВАМ НУЖНЫ РАЗБОРЫ, В КОТОРЫХ ГРОМКУЮ ПОДДЕЛКУ ОТДЕЛЯЮТ ОТ НАСТОЯЩЕГО
Dialogue: 0,0:10:41.07,0:10:45.95,Caption,,0,0,0,,РАСЧЁТА, ПОДПИСЫВАЙТЕСЬ. СЕНСАЦИЯ ПРО "НЬЮТАЙП ИНДАСТРИЗ" ПРОЖИЛА НЕДОЛГО,
Dialogue: 0,0:10:46.27,0:10:49.47,Caption,,0,0,0,,А КОНТЕЙНЕРОВОЗ ПРОШЁЛ ВЕСЬ МАРШРУТ И ВЕРНУЛСЯ. У
Dialogue: 0,0:10:49.47,0:10:51.95,Caption,,0,0,0,,ФАКТОВ ИНОГДА ОТВРАТИТЕЛЬНАЯ ПРИВЫЧКА ПЕРЕЖИВАТЬ
Dialogue: 0,0:10:51.95,0:10:55.47,Caption,,0,0,0,,ЗАГОЛОВКИ. МЕРЦ ХОТЕЛ ПРЕДСТАВИТЬ СИЛУ КАК СРЕДСТВО,
Dialogue: 0,0:10:55.79,0:10:58.67,Caption,,0,0,0,,КОТОРОЕ ЗАСТАВИТ МОСКВУ УСТУПИТЬ. В ПЕРЕВОДЕ НА
Dialogue: 0,0:10:58.67,0:11:01.79,Caption,,0,0,0,,ОБЫЧНЫЙ ЯЗЫК ПОЛУЧИЛОСЬ СЛЕДУЮЩЕЕ. ФИЦО ОТКАЗЫВАЕТСЯ
Dialogue: 0,0:11:01.79,0:11:04.11,Caption,,0,0,0,,ПЛАТИТЬ, БАБИШ УГРОЖАЕТ БЮДЖЕТУ,
Dialogue: 0,0:11:04.35,0:11:06.19,Caption,,0,0,0,,ЭНЕРГЕТИКИ ГОТОВЯТСЯ К КРИЗИСУ,
Dialogue: 0,0:11:06.34,0:11:08.59,Caption,,0,0,0,,СПЕЦСЛУЖБЫ ОБМЕНИВАЮТСЯ ОБВИНЕНИЯМИ,
Dialogue: 0,0:11:08.83,0:11:11.47,Caption,,0,0,0,,А ВОЕННЫЕ ИСПЫТЫВАЮТ НОВЫЕ СРЕДСТВА НАПАДЕНИЯ И
Dialogue: 0,0:11:11.47,0:11:15.31,Caption,,0,0,0,,ЗАЩИТЫ. НА ОДНОМ КОНЦЕ ЕВРАЗИИ БЕРЛИН ТРЕБУЕТ ОБЩЕЙ
Dialogue: 0,0:11:15.31,0:11:18.43,Caption,,0,0,0,,ЛИНИИ И ПОЛУЧАЕТ СПОР О ФИНАНСИРОВАНИИ УКРАИНЫ.
Dialogue: 0,0:11:20.71,0:11:23.35,Caption,,0,0,0,,ВОЗЛЕ КАЛИНИНГРАДА ИНФРАСТРУКТУРУ ГОТОВЯТ К ТЯЖЁЛОМУ
Dialogue: 0,0:11:23.35,0:11:26.95,Caption,,0,0,0,,КРИЗИСУ, ПОЛЬША И РОССИЯ ОБВИНЯЮТ ДРУГ ДРУГА В ПРОВОКАЦИИ
Dialogue: 0,0:11:27.03,0:11:30.87,Caption,,0,0,0,,И РАЗВЕДКЕ, А МОСКВА ПРЕДУПРЕЖДАЕТ О КАТАСТРОФЕ. ЕВРОПЕЙСКИМ
Dialogue: 0,0:11:30.87,0:11:33.03,Caption,,0,0,0,,СТОЛИЦАМ ПРИХОДИТСЯ ДЕЛАТЬ ТО ЖЕ САМОЕ,
Dialogue: 0,0:11:33.22,0:11:35.67,Caption,,0,0,0,,КАК БЫ МЕРЦУ НИ ХОТЕЛОСЬ ПОЛУЧИТЬ СТРОЙНЫЙ ХОР.
Dialogue: 0,0:11:36.12,0:11:39.19,Caption,,0,0,0,,У СЛОВАКИИ ЕСТЬ ГОЛОС В ЕВРОСОЮЗЕ. У ЧЕХИИ
Dialogue: 0,0:11:39.19,0:11:42.23,Caption,,0,0,0,,ЕСТЬ ВОЗМОЖНОСТЬ ОСТАНОВИТЬ БЮДЖЕТ. У ПОЛЬШИ ЕСТЬ
Dialogue: 0,0:11:42.23,0:11:44.87,Caption,,0,0,0,,АРМИЯ ВОЗЛЕ РОССИЙСКОГО РЕГИОНА. У ЛИТВЫ ЕСТЬ
Dialogue: 0,0:11:44.87,0:11:48.63,Caption,,0,0,0,,ЭНЕРГОСЕТЬ, КОТОРУЮ ГОТОВЯТ К КРИЗИСУ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:11:48.92,0:11:52.07,Caption,,0,0,0,,КОГО МЕРЦ СОБИРАЕТСЯ УБЕЖДАТЬ СИЛОЙ ПЕРВЫМ МОСКВУ,
Dialogue: 0,0:11:52.16,0:11:55.91,Caption,,0,0,0,,ФИЦО ИЛИ БАБИША. ПОКА ДВА ПОСЛЕДНИХ УЖЕ ОТВЕТИЛИ,
Dialogue: 0,0:11:56.07,0:11:58.55,Caption,,0,0,0,,ПРИЧЁМ ОДИН НАЗВАЛ НЕМЕЦКИЙ ПОДХОД ШАНТАЖОМ,
Dialogue: 0,0:11:58.79,0:12:00.95,Caption,,0,0,0,,А ВТОРОЙ ПОЛОЖИЛ РУКУ НА ЕВРОПЕЙСКИЙ БЮДЖЕТ.
Dialogue: 0,0:12:01.65,0:12:04.63,Caption,,0,0,0,,ГРОМЧЕ ВСЕХ ЗДЕСЬ ПОКА ГОВОРИЛ МЕРЦ. ПРАКТИЧНЕЕ ВСЕХ
Dialogue: 0,0:12:04.63,0:12:07.67,Caption,,0,0,0,,ПОСТУПИЛ СЕУЛ. ЮЖНОКОРЕЙЦЫ ПОСМОТРЕЛИ НА СЕВЕР,
Dialogue: 0,0:12:07.83,0:12:10.39,Caption,,0,0,0,,ПРОВЕРИЛИ ПУТЬ ЧЕРЕЗ АРКТИКУ И ОСТАВИЛИ СЕБЕ
Dialogue: 0,0:12:10.39,0:12:13.59,Caption,,0,0,0,,ПРОСТРАНСТВО ДЛЯ МАНЁВРА. БЕРЛИН ПОСМОТРЕЛ НА ВОСТОК
Dialogue: 0,0:12:13.90,0:12:17.19,Caption,,0,0,0,,И ПОЛУЧИЛ ВОЗРАЖЕНИЯ С ЗАПАДА. ИСТОРИЧЕСКАЯ ПАМЯТЬ
Dialogue: 0,0:12:17.20,0:12:19.51,Caption,,0,0,0,,ТОЖЕ НИКУДА НЕ ДЕЛАСЬ. ОНА ПРОСТО ЖДЁТ,
Dialogue: 0,0:12:19.76,0:12:22.55,Caption,,0,0,0,,ПОКА ОЧЕРЕДНОЙ НЕМЕЦКИЙ РУКОВОДИТЕЛЬ ЗАГОВОРИТ О
Dialogue: 0,0:12:22.55,0:12:25.99,Caption,,0,0,0,,СИЛЕ ТАК, БУДТО ДО НЕГО ЭТУ ИДЕЮ НИКТО НЕ ПРОВЕРЯЛ.
Dialogue: 0,0:12:26.30,0:12:29.19,Caption,,0,0,0,,ПОТОМ ОТКРЫВАЕТ СТАРУЮ ПАПКУ И БЕЗ ЛИШНИХ СЛОВ
Dialogue: 0,0:12:29.19,0:12:32.31,Caption,,0,0,0,,КЛАДЁТ ЕЁ НА СТОЛ. МЕРЦ ПРЕДЛОЖИЛ РОССИИ НОВЫЙ
Dialogue: 0,0:12:32.31,0:12:35.91,Caption,,0,0,0,,ЯЗЫК, НО ПЕРВЫМ ПЕРЕВОДЧИКОМ ОКАЗАЛСЯ ЕВРОСОЮЗ.
Dialogue: 0,0:12:38.19,0:12:40.67,Caption,,0,0,0,,ПЕРЕВОД ПОЛУЧИЛСЯ ПРЕДЕЛЬНО ЯСНЫМ ДЕНЕГ ВМЕСТЕ
Dialogue: 0,0:12:40.75,0:12:43.63,Caption,,0,0,0,,СОБИРАТЬ НЕ ХОТЯТ, РИСКИ У ГРАНИЦ УЖЕ РАСТУТ,
Dialogue: 0,0:12:43.80,0:12:45.79,Caption,,0,0,0,,РАКЕТЫ СТАНОВЯТСЯ МНОГОЧИСЛЕННЕЕ,
Dialogue: 0,0:12:46.03,0:12:48.27,Caption,,0,0,0,,А КАЖДАЯ СТРАНА ВСЁ РАВНО СЧИТАЕТ СОБСТВЕННЫЕ
Dialogue: 0,0:12:48.27,0:12:51.47,Caption,,0,0,0,,ПОСЛЕДСТВИЯ. И СКОЛЬКО БЫ КАНЦЛЕР НИ МЕНЯЛ ТОН,
Dialogue: 0,0:12:51.70,0:12:54.35,Caption,,0,0,0,,КАРТА ОСТАНЕТСЯ ПРЕЖНЕЙ. КАЛИНИНГРАД БУДЕТ МЕЖДУ
Dialogue: 0,0:12:54.35,0:12:58.27,Caption,,0,0,0,,ПОЛЬШЕЙ И ЛИТВОЙ, КНДР БУДЕТ РЯДОМ С ЮЖНОЙ КОРЕЕЙ,
Dialogue: 0,0:12:58.43,0:13:01.23,Caption,,0,0,0,,РОССИЙСКАЯ АРКТИКА БУДЕТ СОКРАЩАТЬ МОРСКОЙ ПУТЬ,
Dialogue: 0,0:13:01.47,0:13:04.11,Caption,,0,0,0,,А ПРОШЛОЕ ГЕРМАНИИ БУДЕТ СТОЯТЬ ЗА СПИНОЙ ФРИДРИХА
Dialogue: 0,0:13:04.11,0:13:08.27,Caption,,0,0,0,,МЕРЦА. ПОЗИЦИЯ СИЛЫ ХОРОША НА ТРИБУНЕ. ГЕОГРАФИЯ И
Dialogue: 0,0:13:08.27,0:13:10.43,Caption,,0,0,0,,ИСТОРИЯ ОБЫЧНО ТРЕБУЮТ ОПЛАТИТЬ СЧЁТ.
