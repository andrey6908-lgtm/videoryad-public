Dialogue: 0,0:00:00.12,0:00:02.04,Caption,,0,0,0,,ПРЕДСТАВЬТЕ ПОЧТАЛЬОНА ПЕЧКИНА,
Dialogue: 0,0:00:02.12,0:00:06.52,Caption,,0,0,0,,КОТОРЫЙ ПОЛУЧИЛ ВАШУ ПОСЫЛКУ, ОТКРЫЛ ПУНКТ ВЫДАЧИ ПРЯМО У СЕБЯ ДОМА,
Dialogue: 0,0:00:06.76,0:00:08.99,Caption,,0,0,0,,ЗАЛОЖИЛ БУДУЩУЮ ВЫРУЧКУ БАНКУ И ТОЛЬКО
Dialogue: 0,0:00:08.99,0:00:12.22,Caption,,0,0,0,,ПОСЛЕ ЭТОГО СООБЩИЛ, ЧТО КОРОБКУ ВАМ НЕ ВЕРНЁТ. В
Dialogue: 0,0:00:12.22,0:00:14.52,Caption,,0,0,0,,ПРОСТОКВАШИНЕ ЗА ТАКОЕ ХОТЯ БЫ ПОКРАСНЕЛИ.
Dialogue: 0,0:00:15.20,0:00:16.93,Caption,,0,0,0,,В ЕВРОСОЮЗЕ ПОДОБНУЮ НАХОДЧИВОСТЬ
Dialogue: 0,0:00:16.93,0:00:19.51,Caption,,0,0,0,,ПРЕВРАТИЛИ В ФИНАНСОВУЮ СТРАТЕГИЮ НА ТРИДЦАТЬ ПЯТЬ
Dialogue: 0,0:00:19.51,0:00:23.48,Caption,,0,0,0,,ЛЕТ. САМОЕ ЗАНЯТНОЕ, ЧТО У ВЛАДЕЛЬЦЕВ ЭТОЙ СТРАТЕГИИ ДЕНЕГ
Dialogue: 0,0:00:23.48,0:00:26.30,Caption,,0,0,0,,УЖЕ НЕ ХВАТАЕТ. ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ ГРОМКАЯ
Dialogue: 0,0:00:26.30,0:00:28.68,Caption,,0,0,0,,НОВОСТЬ ЧАСТО ОКАЗЫВАЕТСЯ ЛИШЬ УПАКОВКОЙ,
Dialogue: 0,0:00:28.85,0:00:31.39,Caption,,0,0,0,,А САМОЕ ИНТЕРЕСНОЕ ЛЕЖИТ ПОД НЕЙ. В
Dialogue: 0,0:00:31.39,0:00:33.71,Caption,,0,0,0,,ЕВРОСОЮЗЕ ЗАБЛОКИРОВАНЫ РОССИЙСКИЕ АКТИВЫ
Dialogue: 0,0:00:33.71,0:00:37.15,Caption,,0,0,0,,ПРИМЕРНО НА ДВЕСТИ ДЕСЯТЬ МИЛЛИАРДОВ ЕВРО. ДОХОДЫ ОТ НИХ
Dialogue: 0,0:00:37.15,0:00:39.80,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ВЛАСТИ УЖЕ НАПРАВЛЯЮТ НА ПОГАШЕНИЕ
Dialogue: 0,0:00:39.80,0:00:42.92,Caption,,0,0,0,,КРЕДИТОВ УКРАИНЕ. САМИ ДЕНЬГИ ПРИНАДЛЕЖАТ РОССИИ,
Dialogue: 0,0:00:43.16,0:00:45.08,Caption,,0,0,0,,ПРИБЫЛЬ С НИХ ОБЕЩАНА КРЕДИТОРАМ,
Dialogue: 0,0:00:45.24,0:00:47.21,Caption,,0,0,0,,А ВОЗВРАЩЕНИЕ ВЛАДЕЛЬЦУ ОТКЛАДЫВАЕТСЯ
Dialogue: 0,0:00:47.21,0:00:49.83,Caption,,0,0,0,,НА НЕОПРЕДЕЛЁННОЕ БУДУЩЕЕ. ЧУЖОЙ КАПИТАЛ
Dialogue: 0,0:00:49.83,0:00:52.60,Caption,,0,0,0,,НЕ ПРОСТО УДЕРЖИВАЮТ. ЕГО ЗАСТАВИЛИ РАБОТАТЬ,
Dialogue: 0,0:00:52.84,0:00:55.16,Caption,,0,0,0,,ВЫДАЛИ ПОД БУДУЩУЮ ПРИБЫЛЬ ОБЯЗАТЕЛЬСТВА И ТЕПЕРЬ
Dialogue: 0,0:00:55.16,0:00:58.85,Caption,,0,0,0,,НАЗЫВАЮТ ЭТО ПОРЯДКОМ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ ГОДУ
Dialogue: 0,0:00:58.85,0:01:01.29,Caption,,0,0,0,,ЕВРОСОЮЗ И БОЛЬШАЯ СЕМЁРКА ЗАПУСТИЛИ КРЕДИТНУЮ
Dialogue: 0,0:01:01.29,0:01:03.65,Caption,,0,0,0,,ПРОГРАММУ НА СОРОК ПЯТЬ МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:01:03.65,0:01:07.21,Caption,,0,0,0,,РАССЧИТАТЬСЯ ПО НЕЙ ДОЛЖНЫ ДО ДВЕ ТЫСЯЧИ СОРОК ВТОРОГО
Dialogue: 0,0:01:07.21,0:01:11.86,Caption,,0,0,0,,ГОДА. ПРИ СТАВКЕ В ТРИ ПРОЦЕНТА ПРОЦЕНТЫ ЗА
Dialogue: 0,0:01:11.86,0:01:14.22,Caption,,0,0,0,,ВЕСЬ ПЕРИОД СОСТАВЯТ ОКОЛО ДВАДЦАТИ ПЯТИ
Dialogue: 0,0:01:14.22,0:01:17.78,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ВМЕСТЕ С ОСНОВНОЙ СУММОЙ КРЕДИТОРАМ
Dialogue: 0,0:01:17.78,0:01:20.40,Caption,,0,0,0,,НЕОБХОДИМО ВЕРНУТЬ ПРИБЛИЗИТЕЛЬНО СЕМЬДЕСЯТ
Dialogue: 0,0:01:20.40,0:01:23.76,Caption,,0,0,0,,МИЛЛИАРДОВ. НО АППЕТИТ УЖЕ ВЫРОС. ОБСУЖДАЮТСЯ НОВЫЕ
Dialogue: 0,0:01:23.76,0:01:26.48,Caption,,0,0,0,,ДЕСЯТКИ МИЛЛИАРДОВ, И ОБЩИЕ ОБЯЗАТЕЛЬСТВА,
Dialogue: 0,0:01:26.64,0:01:28.57,Caption,,0,0,0,,КОТОРЫЕ ХОТЯТ ЗАКРЫВАТЬ ДОХОДАМИ ОТ
Dialogue: 0,0:01:28.57,0:01:32.29,Caption,,0,0,0,,РОССИЙСКИХ АКТИВОВ, МОГУТ ДОЙТИ ДО СТА СОРОКА МИЛЛИАРДОВ
Dialogue: 0,0:01:32.29,0:01:35.52,Caption,,0,0,0,,ЕВРО. СЕЙЧАС ЭТИ АКТИВЫ ПРИНОСЯТ ПРИМЕРНО ТРИ ИЛИ
Dialogue: 0,0:01:35.52,0:01:37.44,Caption,,0,0,0,,ЧЕТЫРЕ МИЛЛИАРДА В ГОД. ЗНАЧИТ,
Dialogue: 0,0:01:37.81,0:01:39.80,Caption,,0,0,0,,ВСЯ КОНСТРУКЦИЯ ТРЕБУЕТ НЕ МЕНЬШЕ
Dialogue: 0,0:01:39.80,0:01:42.48,Caption,,0,0,0,,ТРИДЦАТИ ПЯТИ ЛЕТ. РЕБЁНОК УСПЕЕТ РОДИТЬСЯ,
Dialogue: 0,0:01:42.70,0:01:46.08,Caption,,0,0,0,,ЗАКОНЧИТЬ ШКОЛУ, ПОЛУЧИТЬ ПРОФЕССИЮ И САМ НАЧАТЬ
Dialogue: 0,0:01:46.08,0:01:49.51,Caption,,0,0,0,,ПЛАТИТЬ НАЛОГИ, А ЕВРОПЕЙСКИЕ БУХГАЛТЕРЫ ВСЁ ЕЩЁ БУДУТ
Dialogue: 0,0:01:49.51,0:01:53.25,Caption,,0,0,0,,ДЕЛИТЬ ПРИБЫЛЬ С ДЕНЕГ, КОТОРЫЕ ИМ НЕ ПРИНАДЛЕЖАТ. МЕХАНИКА
Dialogue: 0,0:01:53.25,0:01:56.29,Caption,,0,0,0,,ПОЛУЧИЛАСЬ ОБРАЗЦОВАЯ. СНАЧАЛА ВАШИ СРЕДСТВА
Dialogue: 0,0:01:56.29,0:01:59.50,Caption,,0,0,0,,БЛОКИРУЮТ. ЗАТЕМ БУДУЩИЙ ДОХОД С НИХ ОБЕЩАЮТ ТРЕТЬЕЙ
Dialogue: 0,0:01:59.50,0:02:01.44,Caption,,0,0,0,,СТОРОНЕ. ПОСЛЕ ЭТОГО ВАМ СООБЩАЮТ,
Dialogue: 0,0:02:01.67,0:02:05.19,Caption,,0,0,0,,ЧТО ВЕРНУТЬ КАПИТАЛ СЛОЖНО, ВЕДЬ ЕГО ПРИБЫЛЬ УЖЕ УЧТЕНА В ЧУЖИХ
Dialogue: 0,0:02:05.19,0:02:07.72,Caption,,0,0,0,,РАСЧЁТАХ. ПЕЧКИН РЯДОМ С ТАКИМИ МАСТЕРАМИ
Dialogue: 0,0:02:07.72,0:02:10.75,Caption,,0,0,0,,ВЫГЛЯДИТ СЕЛЬСКИМ ЛЮБИТЕЛЕМ. ОН ДЕРЖАЛ ПОСЫЛКУ ИЗ
Dialogue: 0,0:02:10.75,0:02:13.52,Caption,,0,0,0,,ПРИНЦИПА, А ЭТИ УСПЕЛИ ОТКРЫТЬ НА НЕЙ ДЕЛО,
Dialogue: 0,0:02:13.72,0:02:16.25,Caption,,0,0,0,,СОСТАВИТЬ ПЛАН ПРОДАЖ И НАЗНАЧИТЬ СЕБЕ
Dialogue: 0,0:02:16.25,0:02:19.00,Caption,,0,0,0,,ПРЕМИЮ. ШВЕЙЦАРИЯ ТОЖЕ ПОДВЕЛА РЕЗУЛЬТАТЫ
Dialogue: 0,0:02:19.00,0:02:20.64,Caption,,0,0,0,,РАБОТЫ С РОССИЙСКИМИ АКТИВАМИ.
Dialogue: 0,0:02:22.93,0:02:25.06,Caption,,0,0,0,,ИХ ОБЪЁМ ВЫРОС ДО ВОСЬМИ С ПОЛОВИНОЙ
Dialogue: 0,0:02:25.06,0:02:26.77,Caption,,0,0,0,,МИЛЛИАРДОВ ШВЕЙЦАРСКИХ ФРАНКОВ,
Dialogue: 0,0:02:27.01,0:02:29.14,Caption,,0,0,0,,ТО ЕСТЬ ПРЕВЫСИЛ ДЕСЯТЬ МИЛЛИАРДОВ
Dialogue: 0,0:02:29.14,0:02:31.28,Caption,,0,0,0,,ДОЛЛАРОВ. ПО СРАВНЕНИЮ С АПРЕЛЕМ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:02:31.28,0:02:34.10,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТОГО ГОДА ПРИБАВКА СОСТАВИЛА ПЯТНАДЦАТЬ
Dialogue: 0,0:02:34.10,0:02:37.16,Caption,,0,0,0,,ПРОЦЕНТОВ. ПРИ ЭТОМ ЗАБЛОКИРОВАННЫЕ РЕЗЕРВЫ РОССИЙСКОГО
Dialogue: 0,0:02:37.16,0:02:40.09,Caption,,0,0,0,,ЦЕНТРОБАНКА ЗА ВОСЕМНАДЦАТЬ МЕСЯЦЕВ УМЕНЬШИЛИСЬ НА
Dialogue: 0,0:02:40.09,0:02:43.74,Caption,,0,0,0,,ДЕВЯТЬ ПРОЦЕНТОВ И СОСТАВИЛИ ШЕСТЬ ЦЕЛЫХ ВОСЕМЬ ДЕСЯТЫХ
Dialogue: 0,0:02:43.74,0:02:46.30,Caption,,0,0,0,,МИЛЛИАРДА ФРАНКОВ. ПЕРЕНЕСИТЕ ЭТУ СХЕМУ ИЗ
Dialogue: 0,0:02:46.30,0:02:49.79,Caption,,0,0,0,,КАБИНЕТОВ В ОБЫЧНЫЙ БАНК. ВЫ ПРИНОСИТЕ ТУДА НАКОПЛЕНИЯ.
Dialogue: 0,0:02:49.79,0:02:53.02,Caption,,0,0,0,,ЧЕРЕЗ НЕКОТОРОЕ ВРЕМЯ БАНК ЗАПРЕЩАЕТ ВАМ СНИМАТЬ
Dialogue: 0,0:02:53.02,0:02:55.89,Caption,,0,0,0,,ДЕНЬГИ. ЕЩЁ ПОЗЖЕ МЕНЕДЖЕР РАДОСТНО ДОКЛАДЫВАЕТ,
Dialogue: 0,0:02:56.09,0:02:58.40,Caption,,0,0,0,,ЧТО ВКЛАД ПРИНОСИТ ПРЕКРАСНЫЙ ДОХОД.
Dialogue: 0,0:02:58.40,0:03:01.17,Caption,,0,0,0,,ПРАВДА, ПРИБЫЛЬ УЖЕ ОБЕЩАНА ДРУГИМ КЛИЕНТАМ,
Dialogue: 0,0:03:01.41,0:03:03.20,Caption,,0,0,0,,А ВОЗВРАЩЕНИЕ ОСНОВНОЙ СУММЫ В
Dialogue: 0,0:03:03.20,0:03:06.77,Caption,,0,0,0,,БЛИЖАЙШИЕ ДЕСЯТИЛЕТИЯ В ПЛАНЫ НЕ ВХОДИТ. ВАС ПРИ ЭТОМ,
Dialogue: 0,0:03:06.90,0:03:10.21,Caption,,0,0,0,,ВИДИМО, ПОПРОСЯТ ПРОЯВИТЬ ПОНИМАНИЕ. ВОЗМОЖНО,
Dialogue: 0,0:03:10.32,0:03:13.17,Caption,,0,0,0,,ДАЖЕ ПРЕДЛОЖАТ КОФЕ, ПОКА СПЕЦИАЛИСТ ОБЪЯСНЯЕТ,
Dialogue: 0,0:03:13.42,0:03:15.65,Caption,,0,0,0,,ПОЧЕМУ ВАШИ ДЕНЬГИ ТЕПЕРЬ НУЖНЫ ВСЕМ,
Dialogue: 0,0:03:15.80,0:03:18.19,Caption,,0,0,0,,КРОМЕ ВАС. ЭТО ШИКАРНЫЙ БИЗНЕС.
Dialogue: 0,0:03:18.19,0:03:21.62,Caption,,0,0,0,,ОХРЕНЕТЬ. ТУТ ДАЖЕ НЕ ТРЕБУЕТСЯ СПОРИТЬ О СИМПАТИЯХ К
Dialogue: 0,0:03:21.62,0:03:23.89,Caption,,0,0,0,,РОССИИ. УБЕРИТЕ ФАМИЛИИ РУКОВОДИТЕЛЕЙ,
Dialogue: 0,0:03:23.98,0:03:25.93,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ СИМВОЛЫ И ПРИВЫЧНЫЕ
Dialogue: 0,0:03:25.93,0:03:27.97,Caption,,0,0,0,,ЛОЗУНГИ. ОСТАНУТСЯ СОБСТВЕННИК,
Dialogue: 0,0:03:28.05,0:03:31.99,Caption,,0,0,0,,ЕГО КАПИТАЛ И ЛЮДИ, КОТОРЫЕ РАСПОРЯЖАЮТСЯ ЭТИМ КАПИТАЛОМ
Dialogue: 0,0:03:31.99,0:03:34.76,Caption,,0,0,0,,БЕЗ СОГЛАСИЯ СОБСТВЕННИКА. ПОСЛЕ ТАКОЙ УБОРКИ
Dialogue: 0,0:03:34.76,0:03:36.69,Caption,,0,0,0,,ДЕКОРАЦИЙ СМЫСЛ ВИДЕН БЕЗ ЛУПЫ.
Dialogue: 0,0:03:38.97,0:03:40.80,Caption,,0,0,0,,НА ЭТОМ ЕВРОПЕЙСКАЯ ИЗОБРЕТАТЕЛЬНОСТЬ
Dialogue: 0,0:03:40.80,0:03:43.29,Caption,,0,0,0,,НЕ ЗАКАНЧИВАЕТСЯ. ПОЯВИЛОСЬ УТВЕРЖДЕНИЕ,
Dialogue: 0,0:03:43.52,0:03:45.55,Caption,,0,0,0,,ЧТО ПОДОЗРЕНИЯ В ОТКРЫТОМ ИЛИ СКРЫТОМ
Dialogue: 0,0:03:45.55,0:03:48.09,Caption,,0,0,0,,РОССИЙСКОМ ВМЕШАТЕЛЬСТВЕ МОГУТ ИСПОЛЬЗОВАТЬ КАК
Dialogue: 0,0:03:48.09,0:03:51.54,Caption,,0,0,0,,ОСНОВАНИЕ ДЛЯ ПЕРЕНОСА ЛИБО ОТМЕНЫ ВЫБОРОВ В СТРАНАХ
Dialogue: 0,0:03:51.54,0:03:54.52,Caption,,0,0,0,,ЕВРОСОЮЗА. ГОСУДАРСТВУ ПРИ ЭТОМ ЯКОБЫ НЕ
Dialogue: 0,0:03:54.52,0:03:56.09,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО ПОДРОБНО РАСКРЫВАТЬ,
Dialogue: 0,0:03:56.41,0:03:58.49,Caption,,0,0,0,,КАКИЕ ИМЕННО ДЕЙСТВИЯ РОССИИ СТАЛИ
Dialogue: 0,0:03:58.49,0:04:02.28,Caption,,0,0,0,,ПРИЧИНОЙ РЕШЕНИЯ. САМ ЗАМЫСЕЛ УЖЕ ХОРОШ. ГОЛОСОВАНИЕ ЕЩЁ
Dialogue: 0,0:04:02.28,0:04:05.63,Caption,,0,0,0,,НЕ СОСТОЯЛОСЬ, ГРАЖДАНЕ ТОЛЬКО СОБИРАЮТСЯ ПРИЙТИ НА
Dialogue: 0,0:04:05.63,0:04:08.59,Caption,,0,0,0,,УЧАСТКИ, А РЯДОМ ЗАРАНЕЕ ЛЕЖИТ ИНСТРУМЕНТ ДЛЯ
Dialogue: 0,0:04:08.59,0:04:10.99,Caption,,0,0,0,,ОТМЕНЫ НЕУДОБНОГО РЕЗУЛЬТАТА. ОЧЕНЬ
Dialogue: 0,0:04:10.99,0:04:13.13,Caption,,0,0,0,,ПРАКТИЧНО. КАК ЗАПАСНОЙ ВЫХОД,
Dialogue: 0,0:04:13.37,0:04:15.43,Caption,,0,0,0,,ТОЛЬКО ПОКИНУТЬ ЧЕРЕЗ НЕГО МОГУТ НЕ
Dialogue: 0,0:04:15.43,0:04:18.41,Caption,,0,0,0,,ЧИНОВНИКИ, А ГОЛОСА ИЗБИРАТЕЛЕЙ. ПРЕДПОЛОЖИМ,
Dialogue: 0,0:04:18.73,0:04:22.52,Caption,,0,0,0,,ГРАЖДАНЕ ВЫБИРАЮТ ПАРТИЮ, КОТОРУЮ РУКОВОДСТВО ЕВРОСОЮЗА СЧИТАЕТ
Dialogue: 0,0:04:22.52,0:04:25.05,Caption,,0,0,0,,НЕПРАВИЛЬНОЙ. ЛЮДИ ПРИХОДЯТ НА УЧАСТКИ,
Dialogue: 0,0:04:25.21,0:04:28.87,Caption,,0,0,0,,СТАВЯТ ОТМЕТКИ, ПАРТИЯ ПОЛУЧАЕТ БОЛЬШИНСТВО. ПОСЛЕ
Dialogue: 0,0:04:28.87,0:04:31.45,Caption,,0,0,0,,ЭТОГО НАЧИНАЕТСЯ ОБСУЖДЕНИЕ ВМЕШАТЕЛЬСТВА,
Dialogue: 0,0:04:31.61,0:04:34.35,Caption,,0,0,0,,ДЕЗИНФОРМАЦИИ И ЗАЩИТЫ ЕВРОПЕЙСКОГО
Dialogue: 0,0:04:34.35,0:04:37.28,Caption,,0,0,0,,ВЫБОРА. ВОЗНИКАЕТ ОДИН НЕЛОВКИЙ ВОПРОС.
Dialogue: 0,0:04:37.28,0:04:40.09,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ВЫБОР ЗАЩИЩАЮТ ОТ ТЕХ ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:04:40.34,0:04:42.09,Caption,,0,0,0,,КОТОРЫЕ ТОЛЬКО ЧТО ЕГО СДЕЛАЛИ?
Dialogue: 0,0:04:42.60,0:04:45.19,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАНЯТНАЯ СИСТЕМА ПОДСЧЁТА.
Dialogue: 0,0:04:45.19,0:04:47.56,Caption,,0,0,0,,НУЖНЫЙ РЕЗУЛЬТАТ ПОДТВЕРЖДАЕТ ЗРЕЛОСТЬ
Dialogue: 0,0:04:47.56,0:04:50.33,Caption,,0,0,0,,ДЕМОКРАТИИ. НЕНУЖНЫЙ ТРЕБУЕТ СРОЧНО ВЫЯСНИТЬ,
Dialogue: 0,0:04:50.60,0:04:52.72,Caption,,0,0,0,,КТО ИСПОРТИЛ ГРАЖДАН И ПОЧЕМУ ОНИ
Dialogue: 0,0:04:52.72,0:04:54.89,Caption,,0,0,0,,ПОЗВОЛИЛИ СЕБЕ ТАКУЮ САМОДЕЯТЕЛЬНОСТЬ.
Dialogue: 0,0:04:57.18,0:04:58.92,Caption,,0,0,0,,ХОТЯ ОБЪЯСНЕНИЕ МОЖЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:04:58.92,0:05:01.68,Caption,,0,0,0,,ГОРАЗДО ПРОЗАИЧНЕЕ. ИЗБИРАТЕЛЬ ОТКРЫЛ СЧЁТ ЗА
Dialogue: 0,0:05:01.68,0:05:04.06,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО, ПОСМОТРЕЛ НА АРЕНДУ,
Dialogue: 0,0:05:04.14,0:05:07.49,Caption,,0,0,0,,НАЛОГИ, ЗАРПЛАТУ И СТОИМОСТЬ УХОДА ЗА ПОЖИЛЫМИ
Dialogue: 0,0:05:07.49,0:05:10.85,Caption,,0,0,0,,РОДИТЕЛЯМИ. ПОТОМ ПРИШЁЛ НА УЧАСТОК И ПРОГОЛОСОВАЛ
Dialogue: 0,0:05:10.85,0:05:13.82,Caption,,0,0,0,,ЗА ТЕХ, КТО ОБЕЩАЛ ДРУГОЙ КУРС. ДЛЯ ЭТОГО НЕ
Dialogue: 0,0:05:13.82,0:05:16.14,Caption,,0,0,0,,НУЖЕН ИНОСТРАННЫЙ АГЕНТ. ИНОГДА ДОСТАТОЧНО
Dialogue: 0,0:05:16.14,0:05:19.45,Caption,,0,0,0,,КАЛЬКУЛЯТОРА. ИМЕННО ЗДЕСЬ ОГРОМНЫЕ ГОСУДАРСТВЕННЫЕ
Dialogue: 0,0:05:19.45,0:05:21.80,Caption,,0,0,0,,СУММЫ СОПРИКАСАЮТСЯ С КОШЕЛЬКОМ КОНКРЕТНОГО
Dialogue: 0,0:05:21.80,0:05:25.19,Caption,,0,0,0,,ЧЕЛОВЕКА. ДВЕСТИ ДЕСЯТЬ МИЛЛИАРДОВ ЕВРО ЗВУЧАТ
Dialogue: 0,0:05:25.19,0:05:28.54,Caption,,0,0,0,,ПОЧТИ НЕРЕАЛЬНО. СОРОК ПЯТЬ МИЛЛИАРДОВ ТОЖЕ.
Dialogue: 0,0:05:28.54,0:05:31.22,Caption,,0,0,0,,СТО СОРОК МИЛЛИАРДОВ ОТЛИЧАЮТСЯ ОТ ДВУХСОТ
Dialogue: 0,0:05:31.22,0:05:34.39,Caption,,0,0,0,,ДЕСЯТИ ДЛЯ ОБЫЧНОГО СЛУШАТЕЛЯ ПРИМЕРНО КАК РАССТОЯНИЕ ДО
Dialogue: 0,0:05:34.39,0:05:37.53,Caption,,0,0,0,,ЛУНЫ ОТ РАССТОЯНИЯ ДО МАРСА. ОЧЕНЬ ДАЛЕКО И
Dialogue: 0,0:05:37.53,0:05:40.58,Caption,,0,0,0,,СОВЕРШЕННО НЕ ВИДНО ИЗ ОКНА. А ТРИ ТЫСЯЧИ ТРИСТА
Dialogue: 0,0:05:40.58,0:05:43.18,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ЧЕТЫРЕ ЕВРО В МЕСЯЦ ПОНИМАЕТ КАЖДЫЙ.
Dialogue: 0,0:05:43.74,0:05:45.66,Caption,,0,0,0,,ЭТА СУММА НЕ ЖИВЁТ В ОТЧЁТЕ НА СОТНЯХ
Dialogue: 0,0:05:45.66,0:05:48.24,Caption,,0,0,0,,СТРАНИЦ. ЕЁ НУЖНО НАЙТИ НА СОБСТВЕННОМ
Dialogue: 0,0:05:48.24,0:05:50.73,Caption,,0,0,0,,СЧЁТЕ. И ЕСЛИ ЧЕЛОВЕК ПОСЛЕ ЭТОГО ГОЛОСУЕТ НЕ
Dialogue: 0,0:05:50.73,0:05:52.30,Caption,,0,0,0,,ТАК, КАК РАССЧИТЫВАЛИ НАВЕРХУ,
Dialogue: 0,0:05:52.63,0:05:54.64,Caption,,0,0,0,,УДОБНЕЕ ОБЪЯВИТЬ ЕГО ЖЕРТВОЙ ЧУЖОГО
Dialogue: 0,0:05:54.64,0:05:57.66,Caption,,0,0,0,,ВЛИЯНИЯ. ПРИЗНАТЬ ВЛИЯНИЕ СОБСТВЕННОГО ЦЕННИКА
Dialogue: 0,0:05:57.66,0:06:00.42,Caption,,0,0,0,,ГОРАЗДО НЕПРИЯТНЕЕ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ.
Dialogue: 0,0:06:00.42,0:06:04.16,Caption,,0,0,0,,МЫ СМОТРИМ НЕ НА ТО, КАК УБЕДИТЕЛЬНО ЧИНОВНИК ПРОИЗНОСИТ
Dialogue: 0,0:06:04.16,0:06:07.86,Caption,,0,0,0,,РЕЧЬ, А НА ТО, КАКОЙ СЧЁТ ПОСЛЕ ЭТОЙ РЕЧИ ПОЛУЧАЕТ
Dialogue: 0,0:06:07.86,0:06:12.18,Caption,,0,0,0,,ГРАЖДАНИН. ПОКА ЕВРОПЕЙСКИЕ СТРУКТУРЫ
Dialogue: 0,0:06:12.18,0:06:15.39,Caption,,0,0,0,,РАСПРЕДЕЛЯЮТ ДОХОДЫ ОТ РОССИЙСКИХ МИЛЛИАРДОВ НА ДЕСЯТИЛЕТИЯ
Dialogue: 0,0:06:15.39,0:06:18.66,Caption,,0,0,0,,ВПЕРЁД, СОБСТВЕННЫЕ БЮДЖЕТЫ НАЧИНАЮТ ХРУСТЕТЬ.
Dialogue: 0,0:06:18.66,0:06:21.96,Caption,,0,0,0,,ФРИДРИХ МЕРЦ УЖЕ ГОВОРИТ, ЧТО РАСХОДЫ ПРИДЁТСЯ ВЫБИРАТЬ
Dialogue: 0,0:06:21.96,0:06:24.42,Caption,,0,0,0,,ОСТОРОЖНЕЕ. СРЕДСТВ НА ВСЕ ОБЕЩАНИЯ НЕТ,
Dialogue: 0,0:06:24.74,0:06:26.82,Caption,,0,0,0,,БЮДЖЕТНЫЕ ПЛАНЫ ТРЕБУЮТ ПЕРЕСМОТРА,
Dialogue: 0,0:06:27.06,0:06:30.18,Caption,,0,0,0,,ЗАТРАТЫ РАСТУТ, ГОСУДАРСТВЕННЫЕ ФИНАНСЫ НЕОБХОДИМО
Dialogue: 0,0:06:30.18,0:06:33.33,Caption,,0,0,0,,ПРИВОДИТЬ В ПОРЯДОК. КАРТИНА ВЫХОДИТ ВЫДАЮЩАЯСЯ.
Dialogue: 0,0:06:33.33,0:06:36.55,Caption,,0,0,0,,ЧУЖОЙ КАПИТАЛ НАДЁЖНО ЛЕЖИТ ПОД ЗАМКОМ. ЕГО БУДУЩАЯ
Dialogue: 0,0:06:36.55,0:06:39.57,Caption,,0,0,0,,ПРИБЫЛЬ УЖЕ РАСПИСАНА. КРЕДИТОРАМ ПОКАЗАЛИ ДЛИННЫЙ
Dialogue: 0,0:06:39.57,0:06:42.22,Caption,,0,0,0,,ГРАФИК ВЫПЛАТ. НО СВОИХ ДЕНЕГ ВСЁ РАВНО НЕ
Dialogue: 0,0:06:42.22,0:06:45.48,Caption,,0,0,0,,ХВАТАЕТ. РАЙ ЗАКОНЧИЛСЯ, РЕБЯТА. ПРИШЛО ВРЕМЯ ПЛАТИТЬ ПО
Dialogue: 0,0:06:45.48,0:06:48.02,Caption,,0,0,0,,СЧЕТАМ. КОГДА БЮДЖЕТ НАЧИНАЕТ ТЕЧЬ,
Dialogue: 0,0:06:48.12,0:06:50.08,Caption,,0,0,0,,ГОСУДАРСТВО РЕДКО СТУЧИТСЯ К САМОМУ
Dialogue: 0,0:06:50.08,0:06:53.02,Caption,,0,0,0,,ВЛИЯТЕЛЬНОМУ ЧЕЛОВЕКУ СТРАНЫ И ПРОСИТ ЕГО ПЕРВЫМ
Dialogue: 0,0:06:53.02,0:06:55.58,Caption,,0,0,0,,ОТКАЗАТЬСЯ ОТ ПРИВЫЧНОГО УРОВНЯ ЖИЗНИ. ОНО
Dialogue: 0,0:06:55.58,0:06:58.90,Caption,,0,0,0,,ВНИМАТЕЛЬНО ОСМАТРИВАЕТ ТЕХ, КОГО ПРОЩЕ УБЕДИТЬ,
Dialogue: 0,0:06:58.99,0:07:01.40,Caption,,0,0,0,,ОБЯЗАТЬ ИЛИ ПРОСТО ПОСТАВИТЬ ПЕРЕД
Dialogue: 0,0:07:01.40,0:07:04.42,Caption,,0,0,0,,ФАКТОМ. ТАК ПОСТУПАЮТ НЕ ТОЛЬКО В ГЕРМАНИИ. СТРАНЫ
Dialogue: 0,0:07:04.42,0:07:07.86,Caption,,0,0,0,,РАЗЛИЧАЮТСЯ ЗАКОНАМИ, ПАРТИЯМИ И УСТРОЙСТВОМ ВЛАСТИ,
Dialogue: 0,0:07:08.18,0:07:10.25,Caption,,0,0,0,,НО ПРИ НЕХВАТКЕ ДЕНЕГ РУКА ГОСУДАРСТВА
Dialogue: 0,0:07:10.25,0:07:13.08,Caption,,0,0,0,,УДИВИТЕЛЬНЫМ ОБРАЗОМ ТЯНЕТСЯ В ОДНУ СТОРОНУ. НЕ К
Dialogue: 0,0:07:13.08,0:07:16.50,Caption,,0,0,0,,ТОМУ, КТО ГРОМЧЕ ВЫСТУПАЕТ, А К ИСПРАВНОМУ ПЛАТЕЛЬЩИКУ,
Dialogue: 0,0:07:16.68,0:07:18.68,Caption,,0,0,0,,НЕСПОСОБНОМУ УВЕСТИ ДОХОД В ДРУГУЮ
Dialogue: 0,0:07:18.68,0:07:20.58,Caption,,0,0,0,,ЮРИСДИКЦИЮ ОДНИМ НАЖАТИЕМ КНОПКИ.
Dialogue: 0,0:07:21.30,0:07:23.24,Caption,,0,0,0,,НА РУСИ ПРО ЭТО ДАВНО СКАЗАЛИ ПРОЩЕ
Dialogue: 0,0:07:23.24,0:07:28.94,Caption,,0,0,0,,ЕДУТ НА ТОМ, КТО ВЕЗЁТ. ЕСЛИ ЧЕЛОВЕК ЕЩЁ СПОСОБЕН ТЯНУТЬ,
Dialogue: 0,0:07:29.03,0:07:31.08,Caption,,0,0,0,,ЕМУ ДОБАВЯТ ГРУЗ И НАЗОВУТ ЭТО
Dialogue: 0,0:07:31.08,0:07:33.93,Caption,,0,0,0,,СПРАВЕДЛИВЫМ РАСПРЕДЕЛЕНИЕМ ОТВЕТСТВЕННОСТИ. В
Dialogue: 0,0:07:33.93,0:07:36.60,Caption,,0,0,0,,ГЕРМАНИИ ТАКОЙ ГРУЗ УЖЕ ПОЛУЧИЛ ВПОЛНЕ КОНКРЕТНУЮ
Dialogue: 0,0:07:36.60,0:07:39.16,Caption,,0,0,0,,ЦЕНУ. В ПЕРВЫЙ ГОД ПРОЖИВАНИЯ В НЕМЕЦКОМ
Dialogue: 0,0:07:39.16,0:07:41.92,Caption,,0,0,0,,ДОМЕ ПРЕСТАРЕЛЫХ ЧЕЛОВЕК ПЛАТИТ ИЗ СОБСТВЕННОГО КАРМАНА
Dialogue: 0,0:07:41.92,0:07:44.98,Caption,,0,0,0,,В СРЕДНЕМ БОЛЬШЕ ТРЁХ ТЫСЯЧ ТРЁХСОТ ШЕСТИДЕСЯТИ
Dialogue: 0,0:07:44.98,0:07:48.86,Caption,,0,0,0,,ЧЕТЫРЁХ ЕВРО ЕЖЕМЕСЯЧНО. НЕ ЗА ГОД. ЗА ОДИН МЕСЯЦ.
Dialogue: 0,0:07:48.86,0:07:51.19,Caption,,0,0,0,,НА ФОНЕ СОТЕН МИЛЛИАРДОВ ЭТО КАЖЕТСЯ
Dialogue: 0,0:07:51.19,0:07:53.42,Caption,,0,0,0,,МЕЛОЧЬЮ. ДЛЯ ПЕНСИОНЕРА ЭТО НЕ МЕЛОЧЬ,
Dialogue: 0,0:07:53.58,0:07:56.54,Caption,,0,0,0,,А СУММА, КОТОРУЮ НУЖНО НАХОДИТЬ СНОВА И СНОВА.
Dialogue: 0,0:07:57.17,0:07:59.02,Caption,,0,0,0,,ДАЖЕ ХОРОШАЯ ПЕНСИЯ РЯДОМ С ТАКИМ
Dialogue: 0,0:07:59.02,0:08:01.46,Caption,,0,0,0,,СЧЁТОМ БЫСТРО НАЧИНАЕТ ВЫГЛЯДЕТЬ КАРМАННЫМИ
Dialogue: 0,0:08:01.46,0:08:04.58,Caption,,0,0,0,,ДЕНЬГАМИ. ПОЭТОМУ НЕКОТОРЫЕ НЕМЦЫ ИЩУТ ДОМА ПРЕСТАРЕЛЫХ
Dialogue: 0,0:08:04.58,0:08:07.11,Caption,,0,0,0,,ЗА ПРЕДЕЛАМИ СВОЕЙ СТРАНЫ. НЕ ИЗ ЛЮБВИ К
Dialogue: 0,0:08:07.11,0:08:10.45,Caption,,0,0,0,,ПУТЕШЕСТВИЯМ И НЕ РАДИ ПЕРЕМЕНЫ КЛИМАТА. СТАРЕТЬ ДОМА
Dialogue: 0,0:08:10.45,0:08:13.58,Caption,,0,0,0,,СТАЛО СЛИШКОМ ДОРОГО. ВСЯ МОЩЬ ОДНОЙ ИЗ БОГАТЕЙШИХ
Dialogue: 0,0:08:13.58,0:08:16.69,Caption,,0,0,0,,ЭКОНОМИК ЕВРОПЫ В ЭТОТ МОМЕНТ ПОМЕЩАЕТСЯ В ЧЕМОДАН.
Dialogue: 0,0:08:16.69,0:08:18.62,Caption,,0,0,0,,ЧЕЛОВЕК ДЕСЯТИЛЕТИЯМИ РАБОТАЛ,
Dialogue: 0,0:08:18.78,0:08:21.10,Caption,,0,0,0,,ПЕРЕЧИСЛЯЛ НАЛОГИ И СТРАХОВЫЕ ВЗНОСЫ,
Dialogue: 0,0:08:21.20,0:08:24.38,Caption,,0,0,0,,СОБЛЮДАЛ ПРАВИЛА. А КОГДА ЕМУ ПОНАДОБИЛСЯ ПОСТОЯННЫЙ
Dialogue: 0,0:08:24.38,0:08:28.16,Caption,,0,0,0,,УХОД, ВЫЯСНИЛОСЬ, ЧТО РОДНАЯ СТРАНА ГОТОВА ПРЕДОСТАВИТЬ
Dialogue: 0,0:08:28.16,0:08:31.26,Caption,,0,0,0,,ЕГО ПО ЦЕНЕ, ПОСЛЕ КОТОРОЙ ВЫГОДНЕЕ УЕХАТЬ. ФИНАЛ
Dialogue: 0,0:08:31.26,0:08:34.09,Caption,,0,0,0,,ТРУДОВОЙ БИОГРАФИИ ПОЛУЧИЛСЯ СУРОВЫЙ. СНАЧАЛА
Dialogue: 0,0:08:34.09,0:08:36.43,Caption,,0,0,0,,ТЫ ПОДДЕРЖИВАЕШЬ СИСТЕМУ. ПОТОМ СИСТЕМА
Dialogue: 0,0:08:36.43,0:08:39.10,Caption,,0,0,0,,ВЫДАЁТ ТЕБЕ ПРАЙС И ЖЕЛАЕТ СЧАСТЛИВОЙ ДОРОГИ.
Dialogue: 0,0:08:41.39,0:08:44.27,Caption,,0,0,0,,РЕЧЬ НЕ О ТОМ, ЧТО ГОСУДАРСТВО ДОЛЖНО ОПЛАЧИВАТЬ
Dialogue: 0,0:08:44.27,0:08:47.46,Caption,,0,0,0,,КАЖДОМУ ЛЮБУЮ УСЛУГУ. ВОПРОС В ОЧЕРЁДНОСТИ. КОГДА
Dialogue: 0,0:08:47.46,0:08:49.71,Caption,,0,0,0,,ВЛАСТИ ОБЪЯВЛЯЮТ О НЕХВАТКЕ СРЕДСТВ,
Dialogue: 0,0:08:50.03,0:08:53.27,Caption,,0,0,0,,ПОЛЕЗНО СМОТРЕТЬ, НА КАКОМ УЧАСТКЕ ЭКОНОМИЯ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:08:53.27,0:08:56.11,Caption,,0,0,0,,РАНЬШЕ ВСЕГО. НА ВОЕННЫЕ ПРОГРАММЫ СУММЫ
Dialogue: 0,0:08:56.11,0:08:59.10,Caption,,0,0,0,,УВЕЛИЧИВАЮТСЯ. ДЛЯ МЕЖДУНАРОДНЫХ ОБЯЗАТЕЛЬСТВ ДЕНЬГИ
Dialogue: 0,0:08:59.10,0:09:02.67,Caption,,0,0,0,,НАХОДЯТСЯ. КРЕДИТЫ ВЫДАЮТСЯ, СТАРЫЕ ДОЛГИ ОБСЛУЖИВАЮТСЯ,
Dialogue: 0,0:09:02.83,0:09:05.30,Caption,,0,0,0,,НОВЫЕ ПЛАНЫ ПРИНИМАЮТСЯ. ТАМ СЧЁТ ИДЁТ
Dialogue: 0,0:09:05.30,0:09:09.05,Caption,,0,0,0,,НА ДЕСЯТКИ МИЛЛИАРДОВ, И СЕРЬЁЗНЫЕ ЛИЦА УВЕРЕННО ОБЪЯСНЯЮТ
Dialogue: 0,0:09:09.05,0:09:13.48,Caption,,0,0,0,,НЕОБХОДИМОСТЬ КАЖДОЙ ТРАТЫ. ЗАТЕМ ПЕНСИОНЕР ПОЛУЧАЕТ ЕЖЕМЕСЯЧНЫЙ
Dialogue: 0,0:09:13.48,0:09:16.64,Caption,,0,0,0,,СЧЁТ ЗА УХОД. ЕГО ФИНАНСОВАЯ ПРОГРАММА СОСТОИТ ИЗ
Dialogue: 0,0:09:16.64,0:09:19.43,Caption,,0,0,0,,ОДНОГО ПУНКТА ИСКАТЬ СТРАНУ ПОДЕШЕВЛЕ. НИКАКОЙ
Dialogue: 0,0:09:19.43,0:09:22.94,Caption,,0,0,0,,ПРЕЗЕНТАЦИИ, НИКАКОГО ДЛИННОГО СОГЛАСОВАНИЯ. ТОЛЬКО
Dialogue: 0,0:09:22.94,0:09:25.88,Caption,,0,0,0,,ЧЕМОДАН И АДРЕС НОВОГО ДОМА. ТЕПЕРЬ ПЕРЕНЕСЁМСЯ
Dialogue: 0,0:09:25.88,0:09:28.20,Caption,,0,0,0,,ЧЕРЕЗ АТЛАНТИКУ. СОЕДИНЁННЫЕ ШТАТЫ СНОВА
Dialogue: 0,0:09:28.20,0:09:30.89,Caption,,0,0,0,,ДОБРАЛИСЬ ДО ПОТОЛКА ГОСУДАРСТВЕННОГО ДОЛГА.
Dialogue: 0,0:09:30.89,0:09:33.55,Caption,,0,0,0,,ДОНАЛЬД ТРАМП ПРЕДУПРЕЖДАЕТ ОБ УГРОЗЕ ДЕФОЛТА,
Dialogue: 0,0:09:33.79,0:09:35.77,Caption,,0,0,0,,ЕСЛИ РЕШЕНИЕ НЕ БУДЕТ ПРИНЯТО ДО
Dialogue: 0,0:09:35.77,0:09:38.73,Caption,,0,0,0,,ФЕВРАЛЯ. САМ ПОТОЛОК ОН ПРЕДЛАГАЕТ ОТМЕНИТЬ. ЛОГИКА
Dialogue: 0,0:09:38.73,0:09:41.36,Caption,,0,0,0,,РОСКОШНАЯ. ЕСЛИ ОГРАНИЧИТЕЛЬ МЕШАЕТ НАБИРАТЬ
Dialogue: 0,0:09:41.36,0:09:43.86,Caption,,0,0,0,,ДОЛГ, МОЖНО УБРАТЬ ОГРАНИЧИТЕЛЬ И ОБЪЯВИТЬ
Dialogue: 0,0:09:43.86,0:09:46.61,Caption,,0,0,0,,ВОПРОС ЗАКРЫТЫМ. ПРИМЕРНО КАК СНЯТЬ СТРЕЛКУ С
Dialogue: 0,0:09:46.61,0:09:49.10,Caption,,0,0,0,,ВЕСОВ, ЧТОБЫ БОЛЬШЕ НИКОГДА НЕ РАССТРАИВАТЬСЯ
Dialogue: 0,0:09:49.10,0:09:52.66,Caption,,0,0,0,,ИЗ ЗА ЛИШНИХ КИЛОГРАММОВ. ОБЫЧНОМУ ЧЕЛОВЕКУ БАНК ГОВОРИТ
Dialogue: 0,0:09:52.66,0:09:56.39,Caption,,0,0,0,,КОРОТКО. ДЕНЕГ НЕ ХВАТАЕТ,
Dialogue: 0,0:09:56.52,0:09:58.57,Caption,,0,0,0,,СОКРАЩАЙТЕ РАСХОДЫ. ГОСУДАРСТВО
Dialogue: 0,0:09:58.57,0:10:02.82,Caption,,0,0,0,,ДЕЙСТВУЕТ СОЛИДНЕЕ. ОНО ЗАНИМАЕТ. ЗАТЕМ ЗАНИМАЕТ ЕЩЁ.
Dialogue: 0,0:10:02.82,0:10:07.70,Caption,,0,0,0,,КОГДА ДОЛГ ДОСТИГАЕТ ПОТОЛКА, НАЧИНАЕТСЯ СПОР О ЕГО ПОВЫШЕНИИ. ПОСЛЕ
Dialogue: 0,0:10:07.70,0:10:09.91,Caption,,0,0,0,,ОЧЕРЕДНОГО ПОВЫШЕНИЯ ПРОХОДИТ ВРЕМЯ,
Dialogue: 0,0:10:10.23,0:10:14.53,Caption,,0,0,0,,ДОЛГ СНОВА ЕЁ ДОГОНЯЕТ, И ВИНОВАТЫМ ВНОВЬ ОКАЗЫВАЕТСЯ ПОТОЛОК.
Dialogue: 0,0:10:14.53,0:10:17.15,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ПРИ ЭТОМ ОСТАЮТСЯ КРУПНЕЙШИМ
Dialogue: 0,0:10:17.15,0:10:20.42,Caption,,0,0,0,,ЦЕНТРОМ МИРОВОЙ ФИНАНСОВОЙ СИСТЕМЫ. ДОЛЛАР ХРАНИТСЯ В
Dialogue: 0,0:10:20.42,0:10:22.63,Caption,,0,0,0,,РЕЗЕРВАХ МНОЖЕСТВА СТРАН. АМЕРИКАНСКИЕ
Dialogue: 0,0:10:22.63,0:10:25.67,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ ОБЛИГАЦИИ СЧИТАЮТСЯ ОДНИМ ИЗ ГЛАВНЫХ
Dialogue: 0,0:10:25.67,0:10:28.75,Caption,,0,0,0,,НАДЁЖНЫХ ИНСТРУМЕНТОВ. И ПРЕЗИДЕНТ ЭТОЙ СТРАНЫ
Dialogue: 0,0:10:28.75,0:10:30.47,Caption,,0,0,0,,ВСЛУХ ПРЕДУПРЕЖДАЕТ О ДЕФОЛТЕ.
Dialogue: 0,0:10:31.10,0:10:33.04,Caption,,0,0,0,,ОБЩАЯ КАРТИНА ПОЛУЧИЛАСЬ ПОЧТИ
Dialogue: 0,0:10:33.04,0:10:36.16,Caption,,0,0,0,,УЧЕБНОЙ. ЕВРОСОЮЗ РАССЧИТЫВАЕТ ДЕСЯТИЛЕТИЯМИ ПОЛУЧАТЬ
Dialogue: 0,0:10:36.16,0:10:39.10,Caption,,0,0,0,,ПРИБЫЛЬ С ЧУЖИХ ЗАБЛОКИРОВАННЫХ СРЕДСТВ. ГЕРМАНИЯ
Dialogue: 0,0:10:39.10,0:10:42.01,Caption,,0,0,0,,ГОТОВИТСЯ ЭКОНОМИТЬ И ПЕРЕСМАТРИВАТЬ РАСХОДЫ.
Dialogue: 0,0:10:42.01,0:10:44.36,Caption,,0,0,0,,НЕМЕЦКИЕ ПЕНСИОНЕРЫ ПРИСМАТРИВАЮТ УХОД ЗА
Dialogue: 0,0:10:44.36,0:10:47.23,Caption,,0,0,0,,ГРАНИЦЕЙ, ПОТОМУ ЧТО ДОМА ОН СЛИШКОМ ДОРОГ.
Dialogue: 0,0:10:47.23,0:10:50.29,Caption,,0,0,0,,ВАШИНГТОН СНОВА ТОРГУЕТСЯ С ОГРАНИЧЕНИЕМ СОБСТВЕННОГО
Dialogue: 0,0:10:50.29,0:10:52.93,Caption,,0,0,0,,ДОЛГА. ОДНОВРЕМЕННО ПРОДОЛЖАЮТСЯ КРУПНЫЕ
Dialogue: 0,0:10:52.93,0:10:55.19,Caption,,0,0,0,,ПРОГРАММЫ, РАСТУТ ВОЕННЫЕ РАСХОДЫ,
Dialogue: 0,0:10:55.43,0:10:57.67,Caption,,0,0,0,,ВЫДАЮТСЯ КРЕДИТЫ И ПРИНИМАЮТСЯ НОВЫЕ
Dialogue: 0,0:10:57.67,0:11:00.86,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА. НА ВЕРХНЕМ ЭТАЖЕ ДЕНЬГИ ДВИЖУТСЯ
Dialogue: 0,0:11:00.86,0:11:04.10,Caption,,0,0,0,,МИЛЛИАРДАМИ И ВЫГЛЯДЯТ ОТВЛЕЧЁННЫМИ ЧИСЛАМИ. ВНИЗУ
Dialogue: 0,0:11:04.10,0:11:06.47,Caption,,0,0,0,,ОНИ ПРЕВРАЩАЮТСЯ В НАЛОГОВУЮ КВИТАНЦИЮ,
Dialogue: 0,0:11:06.67,0:11:08.87,Caption,,0,0,0,,ПЕНСИОННЫЙ ВОЗРАСТ И СЧЁТ ЗА КОМНАТУ В
Dialogue: 0,0:11:08.87,0:11:14.22,Caption,,0,0,0,,ДОМЕ ПРЕСТАРЕЛЫХ. ТОЛЬКО В ЭТОТ МОМЕНТ ЧЕЛОВЕК ПОНИМАЕТ
Dialogue: 0,0:11:14.22,0:11:16.74,Caption,,0,0,0,,НАСТОЯЩУЮ ЦЕНУ ВСЕХ РЕШЕНИЙ. НЕ ТОГДА,
Dialogue: 0,0:11:16.98,0:11:19.50,Caption,,0,0,0,,КОГДА МИНИСТР НАЗЫВАЕТ СУММУ С ДЕВЯТЬЮ
Dialogue: 0,0:11:19.50,0:11:22.59,Caption,,0,0,0,,НУЛЯМИ. А ТОГДА, КОГДА ПОСЛЕ ОПЛАТЫ ОБЯЗАТЕЛЬНЫХ
Dialogue: 0,0:11:22.59,0:11:24.90,Caption,,0,0,0,,РАСХОДОВ НА ЕГО СЧЁТЕ ОСТАЁТСЯ МЕНЬШЕ,
Dialogue: 0,0:11:25.00,0:11:28.96,Caption,,0,0,0,,ЧЕМ МЕСЯЦ НАЗАД. В ТРУДНЫЕ ВРЕМЕНА ГОСУДАРСТВО БЫСТРО
Dialogue: 0,0:11:28.96,0:11:30.98,Caption,,0,0,0,,ВСПОМИНАЕТ ПРАВИЛО ЕДУТ НА ТОМ,
Dialogue: 0,0:11:31.06,0:11:35.38,Caption,,0,0,0,,КТО ВЕЗЁТ. РАБОТАЕШЬ, ЗНАЧИТ МОЖЕШЬ ЗАПЛАТИТЬ ЕЩЁ. НАКОПИЛ,
Dialogue: 0,0:11:35.60,0:11:37.71,Caption,,0,0,0,,ЗНАЧИТ НАЙДЁТСЯ ПРИЧИНА ВЗЯТЬ БОЛЬШЕ.
Dialogue: 0,0:11:37.71,0:11:40.67,Caption,,0,0,0,,ПОКА ВЫДЕРЖИВАЕШЬ, ТЕБЕ ДОБАВЯТ ОБЯЗАННОСТЕЙ. А ЕСЛИ
Dialogue: 0,0:11:40.67,0:11:42.26,Caption,,0,0,0,,ОДНАЖДЫ ПЕРЕСТАНЕШЬ СПРАВЛЯТЬСЯ,
Dialogue: 0,0:11:42.50,0:11:44.61,Caption,,0,0,0,,ТЕБЕ ПОКАЖУТ НЕДОРОГОЙ ДОМ ПРЕСТАРЕЛЫХ
Dialogue: 0,0:11:44.61,0:11:47.54,Caption,,0,0,0,,В ДРУГОЙ СТРАНЕ И НАЗОВУТ ЭТО СВОБОДОЙ ВЫБОРА.
Dialogue: 0,0:11:48.10,0:11:49.84,Caption,,0,0,0,,ПОСЛЕ ВСЕГО ЭТОГО ПЕЧКИН УЖЕ НЕ
Dialogue: 0,0:11:49.84,0:11:52.94,Caption,,0,0,0,,ВЫГЛЯДИТ ГЛАВНЫМ ЗЛОДЕЕМ. ОН ВСЕГО ЛИШЬ НЕ ОТДАВАЛ
Dialogue: 0,0:11:52.94,0:11:55.54,Caption,,0,0,0,,ПОСЫЛКУ. БИЗНЕС НА НЕЙ ОН ПОСТРОИТЬ НЕ ДОГАДАЛСЯ.
