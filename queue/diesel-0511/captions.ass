Dialogue: 0,0:00:00.10,0:00:02.60,Caption,,0,0,0,,ТРАМП ХОТЕЛ СДЕЛАТЬ КРАСИВЫЙ ЖЕСТ. ПОЛУЧИЛСЯ
Dialogue: 0,0:00:02.60,0:00:06.20,Caption,,0,0,0,,АМЕРИКАНСКИЙ АТТРАКЦИОН. ОДНИ ГОВОРЯТ ВЕЗИТЕ. ДРУГИЕ
Dialogue: 0,0:00:06.28,0:00:08.52,Caption,,0,0,0,,УЖЕ МАШУТ РУКАМИ С БЕРЕГА ТОЛЬКО ПОПРОБУЙТЕ
Dialogue: 0,0:00:08.60,0:00:12.12,Caption,,0,0,0,,РАЗГРУЗИТЬ. И ВОТ ТУТ ВЫРИСОВЫВАЕТСЯ ВОПРОС. ЕСЛИ
Dialogue: 0,0:00:12.12,0:00:14.92,Caption,,0,0,0,,ДАЖЕ МАЛЕНЬКУЮ СДЕЛКУ НЕ МОГУТ СПОКОЙНО ДОВЕСТИ ДО
Dialogue: 0,0:00:14.92,0:00:18.44,Caption,,0,0,0,,ПРИЧАЛА, ТО КАК СОБИРАЮТСЯ ДОГОВАРИВАТЬСЯ О ВЕЩАХ КУДА
Dialogue: 0,0:00:18.44,0:00:21.32,Caption,,0,0,0,,СЕРЬЕЗНЕЕ? НЕ СКАЖИТЕ? ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:00:21.52,0:00:23.24,Caption,,0,0,0,,КОГДА ЗА КРАСИВЫМИ СЛОВАМИ СМОТРЯТ,
Dialogue: 0,0:00:23.44,0:00:27.80,Caption,,0,0,0,,КТО РЕАЛЬНО ЧТО ДЕЛАЕТ, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:28.04,0:00:31.00,Caption,,0,0,0,,КОГДА ДЕЙСТВИЯ ГОРАЗДО ВЕСЕЛЕЕ ЗАЯВЛЕНИЙ. НАЧАЛОСЬ
Dialogue: 0,0:00:31.08,0:00:34.04,Caption,,0,0,0,,ВСЁ С ДИЗЕЛЯ. ДЕВЯТОГО ОКТЯБРЯ ТРАМП ОБЪЯВИЛ ПОСЛЕ
Dialogue: 0,0:00:34.04,0:00:38.20,Caption,,0,0,0,,РАЗГОВОРА С ПУТИНЫМ, ЧТО РОССИЯ СРАЗУ ВЫПУСТИТ НА АМЕРИКАНСКИЙ И МИРОВОЙ
Dialogue: 0,0:00:38.20,0:00:41.40,Caption,,0,0,0,,РЫНОК БОЛЬШЕ ТРЁХСОТ ТЫСЯЧ ТОНН ДИЗЕЛЬНОГО ТОПЛИВА,
Dialogue: 0,0:00:41.57,0:00:43.64,Caption,,0,0,0,,ПОТОМ ЕЩЁ ПОЛМИЛЛИОНА ТОНН В НОЯБРЕ,
Dialogue: 0,0:00:43.79,0:00:47.48,Caption,,0,0,0,,ПОТОМ ЕЩЁ МИЛЛИОН. ЗВУЧАЛО СОЛИДНО. ОСОБЕННО НА ФОНЕ
Dialogue: 0,0:00:47.48,0:00:50.20,Caption,,0,0,0,,АМЕРИКАНСКИХ ЦЕН НА ДИЗЕЛЬ И ВЫБОРОВ В КОНГРЕСС
Dialogue: 0,0:00:50.28,0:00:52.92,Caption,,0,0,0,,ТРЕТЬЕГО НОЯБРЯ. БЕЛОМУ ДОМУ НУЖНА БЫЛА ПРОСТАЯ
Dialogue: 0,0:00:52.92,0:00:54.76,Caption,,0,0,0,,КАРТИНКА ПРЕЗИДЕНТ ДОГОВОРИЛСЯ,
Dialogue: 0,0:00:54.95,0:00:59.88,Caption,,0,0,0,,ТОПЛИВО ИДЁТ, ЦЕНА ДОЛЖНА ВНИЗ. КРАСИВО. КОРОТКО. ПОНЯТНО ДАЖЕ
Dialogue: 0,0:00:59.88,0:01:02.92,Caption,,0,0,0,,ЧЕЛОВЕКУ, КОТОРЫЙ НЕФТЯНЫЕ КОТИРОВКИ ВИДЕЛ ПОСЛЕДНИЙ РАЗ
Dialogue: 0,0:01:03.00,0:01:05.64,Caption,,0,0,0,,СЛУЧАЙНО ПО ТЕЛЕВИЗОРУ. ТОЛЬКО ПЕРВАЯ ПАРТИЯ,
Dialogue: 0,0:01:05.84,0:01:07.64,Caption,,0,0,0,,ВОКРУГ КОТОРОЙ БЫЛО СТОЛЬКО ШУМА,
Dialogue: 0,0:01:07.88,0:01:10.52,Caption,,0,0,0,,ДЛЯ АМЕРИКАНСКОГО РЫНКА БЫЛА, МЯГКО ГОВОРЯ,
Dialogue: 0,0:01:10.68,0:01:15.59,Caption,,0,0,0,,НЕ МАННА НЕБЕСНАЯ. ТРИСТА ТЫСЯЧ ТОНН,
Dialogue: 0,0:01:15.67,0:01:19.67,Caption,,0,0,0,,ПО ОЦЕНКАМ, ЭТО ПРИМЕРНО ТРИ ЧЕТВЕРТИ ОДНОГО ДНЯ ПОТРЕБЛЕНИЯ
Dialogue: 0,0:01:19.67,0:01:22.07,Caption,,0,0,0,,ДИЗЕЛЯ В США. ТО ЕСТЬ СТРАНА РАЗМЕРОМ С
Dialogue: 0,0:01:22.07,0:01:25.03,Caption,,0,0,0,,КОНТИНЕНТ ПОЛУЧИЛА ПОЛИТИЧЕСКУЮ НОВОСТЬ РАЗМЕРОМ
Dialogue: 0,0:01:25.03,0:01:27.83,Caption,,0,0,0,,МЕНЬШЕ СУТОК. ДЛЯ РЫНКА КУРАМ НА СМЕХ,
Dialogue: 0,0:01:28.13,0:01:30.63,Caption,,0,0,0,,ДЛЯ ПРЕДВЫБОРНОЙ КАРТИНКИ ВПОЛНЕ ГОДИТСЯ. МОЖНО
Dialogue: 0,0:01:30.71,0:01:32.71,Caption,,0,0,0,,ВЫЙТИ И СКАЗАТЬ ВОТ, ДОГОВОРИЛИСЬ,
Dialogue: 0,0:01:32.92,0:01:35.59,Caption,,0,0,0,,ВОТ, ТОПЛИВО ПОШЛО, СЕЙЧАС ПОЛЕГЧАЕТ.
Dialogue: 0,0:01:36.15,0:01:38.55,Caption,,0,0,0,,РОССИЯ В ЭТУ ИСТОРИЮ ВОШЛА БЫСТРО. И ЗДЕСЬ
Dialogue: 0,0:01:38.55,0:01:41.43,Caption,,0,0,0,,РАСЧЁТ ТОЖЕ ПОНЯТЕН. ТРАМПУ НУЖЕН БЫЛ РЕЗУЛЬТАТ
Dialogue: 0,0:01:41.51,0:01:44.07,Caption,,0,0,0,,ПЕРЕД ВЫБОРАМИ, МОСКВЕ ВЫГОДНО ПОКАЗАТЬ,
Dialogue: 0,0:01:44.28,0:01:46.23,Caption,,0,0,0,,ЧТО С НЕЙ МОЖНО НЕ ТОЛЬКО РУГАТЬСЯ,
Dialogue: 0,0:01:46.31,0:01:49.59,Caption,,0,0,0,,НО И ТОРГОВАТЬ. ПОЛУЧАЕТСЯ МАЛЕНЬКИЙ ЖЕСТ НАВСТРЕЧУ.
Dialogue: 0,0:01:49.84,0:01:52.87,Caption,,0,0,0,,НЕ МИРНЫЙ ДОГОВОР, НЕ СНЯТИЕ ВСЕХ ОГРАНИЧЕНИЙ,
Dialogue: 0,0:01:53.07,0:01:55.59,Caption,,0,0,0,,НЕ РАЗВОРОТ ВСЕЙ АМЕРИКАНСКОЙ ПОЛИТИКИ. ПРОСТО
Dialogue: 0,0:01:55.59,0:01:58.07,Caption,,0,0,0,,КОНКРЕТНАЯ ПАРТИЯ ТОПЛИВА. ДЕРЖИТЕ,
Dialogue: 0,0:01:58.15,0:02:02.39,Caption,,0,0,0,,ДОНАЛЬД, ПОЛЬЗУЙТЕСЬ. И ДАЖЕ ЗДЕСЬ АМЕРИКА УМУДРИЛАСЬ УСТРОИТЬ ЦИРК С
Dialogue: 0,0:02:02.39,0:02:04.87,Caption,,0,0,0,,ДВУМЯ КАССАМИ. ФЕДЕРАЛЬНОЕ ПРАВИТЕЛЬСТВО ВЫДАЁТ
Dialogue: 0,0:02:04.87,0:02:08.71,Caption,,0,0,0,,ЛИЦЕНЗИЮ. А ГУБЕРНАТОР НЬЮ ДЖЕРСИ МИКИ ШЕРРИЛЛ ПИШЕТ
Dialogue: 0,0:02:08.71,0:02:11.35,Caption,,0,0,0,,ПОРТАМ И ТЕРМИНАЛАМ ПОПРОБУЙТЕ ТОЛЬКО ПРИНЯТЬ ЭТОТ
Dialogue: 0,0:02:11.35,0:02:14.23,Caption,,0,0,0,,ДИЗЕЛЬ. ОНА ПРЯМО ПРЕДУПРЕДИЛА ОПЕРАТОРОВ,
Dialogue: 0,0:02:14.39,0:02:17.51,Caption,,0,0,0,,ПОСРЕДНИКОВ И ПОКУПАТЕЛЕЙ О ГРАЖДАНСКОЙ И УГОЛОВНОЙ
Dialogue: 0,0:02:17.51,0:02:20.63,Caption,,0,0,0,,ОТВЕТСТВЕННОСТИ. БОЛЕЕ ТОГО, СОСЛАЛАСЬ НА НОРМУ,
Dialogue: 0,0:02:20.88,0:02:23.43,Caption,,0,0,0,,ПО КОТОРОЙ ШТРАФ МОЖЕТ БЫТЬ РАВЕН СТОИМОСТИ САМОГО
Dialogue: 0,0:02:23.43,0:02:28.39,Caption,,0,0,0,,ГРУЗА. И СРОК ТАМ ТАКОЙ, ЧТО ОТСИДЕТЬСЯ ПАРУ МЕСЯЦЕВ НЕ ПОЛУЧИТСЯ. ПЯТЬ ЛЕТ.
Dialogue: 0,0:02:30.66,0:02:33.70,Caption,,0,0,0,,ВОТ РАБОТА ВЛАДЕЛЬЦА ТЕРМИНАЛА. СВЕРХУ ТЕБЕ ГОВОРЯТ
Dialogue: 0,0:02:33.78,0:02:37.54,Caption,,0,0,0,,ВСЁ РАЗРЕШИЛИ, ПРИНИМАЙ. С БЕРЕГА ГУБЕРНАТОР МАШЕТ БУМАГОЙ
Dialogue: 0,0:02:37.54,0:02:39.54,Caption,,0,0,0,,РАЗГРУЗИШЬ, ПОТОМ БУДЕШЬ ОБЪЯСНЯТЬ,
Dialogue: 0,0:02:39.70,0:02:43.86,Caption,,0,0,0,,ПОЧЕМУ ТЫ РЕШИЛ, ЧТО ПРЕЗИДЕНТСКАЯ ЛИЦЕНЗИЯ СИЛЬНЕЕ ЗАКОНА КОНГРЕССА.
Dialogue: 0,0:02:44.30,0:02:47.54,Caption,,0,0,0,,ОЧЕНЬ БОДРИТ ПРЕДПРИНИМАТЕЛЬСКУЮ ИНИЦИАТИВУ. В ИТОГЕ
Dialogue: 0,0:02:47.62,0:02:50.66,Caption,,0,0,0,,ДВА ИЗ ПЕРВЫХ ТРЁХ ТАНКЕРОВ, ШЕДШИХ В СТОРОНУ США,
Dialogue: 0,0:02:50.90,0:02:53.70,Caption,,0,0,0,,ВЗЯЛИ И ПОМЕНЯЛИ ПЛАНЫ. ОДИН УШЁЛ В СРЕДИЗЕМНОЕ
Dialogue: 0,0:02:53.78,0:02:57.14,Caption,,0,0,0,,МОРЕ. ВТОРОЙ НАПРАВИЛСЯ К БРАЗИЛИИ. ТРЕТИЙ ПРОДОЛЖИЛ
Dialogue: 0,0:02:57.22,0:03:00.58,Caption,,0,0,0,,ПУТЬ К НЬЮ ЙОРКУ, НО И ТАМ С РАЗГРУЗКОЙ ЯСНОСТИ НЕ БЫЛО.
Dialogue: 0,0:03:00.74,0:03:03.70,Caption,,0,0,0,,ОТЛИЧНАЯ РЕКЛАМА СДЕЛКИ. ТОПЛИВО ЕЩЁ НЕ УСПЕЛО
Dialogue: 0,0:03:03.70,0:03:06.82,Caption,,0,0,0,,ДОЕХАТЬ, А УЖЕ ИЩЕТ СЕБЕ ДРУГУЮ ЖИЗНЬ. И ВОТ
Dialogue: 0,0:03:06.90,0:03:09.54,Caption,,0,0,0,,ЭТО ОСОБЕННО СМЕШНО НА ФОНЕ ПЕРВОНАЧАЛЬНОЙ ЗАДАЧИ.
Dialogue: 0,0:03:09.86,0:03:12.10,Caption,,0,0,0,,ВСЁ ЗАТЕВАЛОСЬ ПЕРЕД ВЫБОРАМИ КАК БЫСТРЫЙ
Dialogue: 0,0:03:12.10,0:03:14.82,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ЖЕСТ. АНАЛИТИКИ СРАЗУ ГОВОРИЛИ,
Dialogue: 0,0:03:15.06,0:03:19.78,Caption,,0,0,0,,ЧТО ОБЪЁМ СЛИШКОМ МАЛЕНЬКИЙ, ЧТОБЫ ВСЕРЬЁЗ РАЗВЕРНУТЬ АМЕРИКАНСКИЙ РЫНОК. ТО ЕСТЬ
Dialogue: 0,0:03:19.86,0:03:22.90,Caption,,0,0,0,,СТАВКА БЫЛА ПРЕЖДЕ ВСЕГО НА ЭФФЕКТ. НА КАРТИНКУ.
Dialogue: 0,0:03:23.25,0:03:26.26,Caption,,0,0,0,,НА ОЩУЩЕНИЕ, ЧТО ТРАМП СЕЙЧАС ПОЗВОНИТ ПУТИНУ,
Dialogue: 0,0:03:26.50,0:03:30.58,Caption,,0,0,0,,СКАЖЕТ ПАРУ СЛОВ, И У АМЕРИКАНСКОГО ДАЛЬНОБОЙЩИКА СРАЗУ СТАНЕТ ЛЕГЧЕ
Dialogue: 0,0:03:30.66,0:03:33.14,Caption,,0,0,0,,НА ДУШЕ И ДЕШЕВЛЕ НА ЗАПРАВКЕ. НЕ СТАЛО.
Dialogue: 0,0:03:33.40,0:03:37.38,Caption,,0,0,0,,БОЛЕЕ ТОГО, ПОСЛЕ ВЫБОРОВ ГУБЕРНАТОР НЬЮ ДЖЕРСИ ЕЩЁ И СВЯЗАЛА
Dialogue: 0,0:03:37.46,0:03:39.38,Caption,,0,0,0,,ЭТУ ИСТОРИЮ С ПОЛИТИЧЕСКИМ РЕЗУЛЬТАТОМ
Dialogue: 0,0:03:39.38,0:03:41.54,Caption,,0,0,0,,РЕСПУБЛИКАНЦЕВ. ПОЛУЧИЛОСЬ ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:03:43.83,0:03:48.63,Caption,,0,0,0,,РОССИЯ БЫСТРО ДАЛА ТРАМПУ ТО, ЧТО ОН МОГ ПОКАЗАТЬ ИЗБИРАТЕЛЮ КАК СДЕЛКУ. А
Dialogue: 0,0:03:48.63,0:03:50.55,Caption,,0,0,0,,ВНУТРИ САМОЙ АМЕРИКИ НАШЛИСЬ ЛЮДИ,
Dialogue: 0,0:03:50.84,0:03:53.51,Caption,,0,0,0,,КОТОРЫЕ ЭТУ СДЕЛКУ НАЧАЛИ ТОРМОЗИТЬ ЕЩЁ НА ПОДХОДЕ
Dialogue: 0,0:03:53.51,0:03:55.67,Caption,,0,0,0,,К БЕРЕГУ. ПОМОГЛИ, НАЗЫВАЕТСЯ.
Dialogue: 0,0:03:56.47,0:03:58.47,Caption,,0,0,0,,НО ДИЗЕЛЬ ЗДЕСЬ ИНТЕРЕСЕН НЕ САМ ПО СЕБЕ.
Dialogue: 0,0:03:58.94,0:04:01.67,Caption,,0,0,0,,ОН ПОКАЗЫВАЕТ ПРОСТУЮ ВЕЩЬ. ДОГОВОРИТЬСЯ ДВУМ
Dialogue: 0,0:04:01.67,0:04:04.63,Caption,,0,0,0,,ПРЕЗИДЕНТАМ МАЛО. ПОТОМ НАЧИНАЕТСЯ ГОСУДАРСТВО.
Dialogue: 0,0:04:04.94,0:04:07.67,Caption,,0,0,0,,ЗАКОНЫ, ГУБЕРНАТОРЫ, КОНГРЕСС,
Dialogue: 0,0:04:07.75,0:04:13.11,Caption,,0,0,0,,ПОРТЫ, КОМПАНИИ, СТРАХОВЩИКИ, БАНКИ. И КАЖДЫЙ МОЖЕТ СКАЗАТЬ СЕКУНДОЧКУ,
Dialogue: 0,0:04:13.32,0:04:15.51,Caption,,0,0,0,,А Я ПОД ЭТИМ НЕ ПОДПИСЫВАЛСЯ. А ТЕПЕРЬ
Dialogue: 0,0:04:15.51,0:04:18.63,Caption,,0,0,0,,УВЕЛИЧИВАЕМ МАСШТАБ. НЕ ТРИСТА ТЫСЯЧ ТОНН ДИЗЕЛЯ.
Dialogue: 0,0:04:19.08,0:04:21.91,Caption,,0,0,0,,ГАЗ ЧЕРЕЗ УКРАИНУ. АМЕРИКАНЦЫ ПРЕДЛОЖИЛИ
Dialogue: 0,0:04:21.91,0:04:24.79,Caption,,0,0,0,,ВОССТАНОВИТЬ ТРАНЗИТ РОССИЙСКОГО ГАЗА В ЕВРОПУ ЧЕРЕЗ
Dialogue: 0,0:04:24.79,0:04:27.59,Caption,,0,0,0,,УКРАИНСКУЮ ТЕРРИТОРИЮ. ЭКОНОМИЧЕСКИ ИДЕЯ ПОНЯТНАЯ.
Dialogue: 0,0:04:27.88,0:04:30.55,Caption,,0,0,0,,ЕВРОПА ПОЛУЧАЕТ ДОПОЛНИТЕЛЬНЫЙ РЕСУРС. УКРАИНА
Dialogue: 0,0:04:30.55,0:04:33.67,Caption,,0,0,0,,ПОЛУЧАЕТ ТРАНЗИТНЫЕ ДЕНЬГИ. РОССИЯ ПОЛУЧАЕТ РЫНОК.
Dialogue: 0,0:04:34.01,0:04:37.19,Caption,,0,0,0,,АМЕРИКАНЦЫ ПОЛУЧАЮТ ЕЩЁ ОДИН КУСОК БУДУЩЕЙ СДЕЛКИ,
Dialogue: 0,0:04:37.41,0:04:40.39,Caption,,0,0,0,,ГДЕ ОНИ СТОЯТ ПОСЕРЕДИНЕ И ВСЕМ ПОМОГАЮТ ЛЮБИТЬ
Dialogue: 0,0:04:40.39,0:04:42.15,Caption,,0,0,0,,ДРУГ ДРУГА ЗА РАЗУМНЫЙ ПРОЦЕНТ.
Dialogue: 0,0:04:42.75,0:04:44.71,Caption,,0,0,0,,ТОЛЬКО ПЕСКОВ НА ЭТО ОТВЕТИЛ ХОЛОДНО.
Dialogue: 0,0:04:45.30,0:04:47.91,Caption,,0,0,0,,НЫНЕШНЯЯ СИТУАЦИЯ НА ЗЕМЛЕ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:04:48.18,0:04:51.67,Caption,,0,0,0,,ПОКАЗЫВАЕТ НЕВОЗМОЖНОСТЬ РЕАЛИЗАЦИИ ТАКОГО ПЛАНА. И
Dialogue: 0,0:04:51.67,0:04:54.39,Caption,,0,0,0,,ЗДЕСЬ СПОРИТЬ С ГЕОГРАФИЕЙ ТРУДНО. ГАЗОПРОВОД
Dialogue: 0,0:04:54.39,0:04:56.95,Caption,,0,0,0,,ПРОХОДИТ НЕ ПО ПРЕЗЕНТАЦИИ КУШНЕРА И НЕ ПО
Dialogue: 0,0:04:56.95,0:04:58.95,Caption,,0,0,0,,КРАСИВОЙ КАРТЕ В ПЕРЕГОВОРНОЙ КОМНАТЕ.
Dialogue: 0,0:05:01.23,0:05:05.63,Caption,,0,0,0,,ОН ПРОХОДИТ ЧЕРЕЗ СТРАНУ, ГДЕ ИДЁТ ПЯТЫЙ ГОД БОЕВЫХ ДЕЙСТВИЙ. ТО ЕСТЬ
Dialogue: 0,0:05:05.63,0:05:08.51,Caption,,0,0,0,,АМЕРИКАНСКАЯ ЛОГИКА ОПЯТЬ УПИРАЕТСЯ В РЕАЛЬНОСТЬ. В
Dialogue: 0,0:05:08.51,0:05:11.39,Caption,,0,0,0,,ВАШИНГТОНЕ УЖЕ СЧИТАЮТ БУДУЩИЕ ЭКОНОМИЧЕСКИЕ СХЕМЫ,
Dialogue: 0,0:05:11.55,0:05:14.11,Caption,,0,0,0,,А МОСКВА ГОВОРИТ РЕБЯТА, ВЫ СНАЧАЛА ПОСМОТРИТЕ,
Dialogue: 0,0:05:14.27,0:05:16.99,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ СЕЙЧАС. ПОТОМ БУДЕМ ТРУБЫ ОТКРЫВАТЬ.
Dialogue: 0,0:05:17.55,0:05:23.07,Caption,,0,0,0,,И ЭТО, КСТАТИ, НЕ ОЗНАЧАЕТ, ЧТО САМА ИДЕЯ ТОРГОВЛИ УМЕРЛА. НАОБОРОТ. ОНА
Dialogue: 0,0:05:23.07,0:05:26.91,Caption,,0,0,0,,ПОКАЗЫВАЕТ, ЧТО ЭКОНОМИЧЕСКАЯ ЧАСТЬ БУДУЩЕГО УРЕГУЛИРОВАНИЯ УЖЕ
Dialogue: 0,0:05:26.91,0:05:29.95,Caption,,0,0,0,,ОБСУЖДАЕТСЯ. ГАЗ, НЕФТЬ, ДИЗЕЛЬ,
Dialogue: 0,0:05:30.03,0:05:34.75,Caption,,0,0,0,,ТРАНЗИТ, МАРШРУТЫ, ДЕНЬГИ. МИР ВООБЩЕ РЕДКО СТРОЯТ ТОЛЬКО НА КРАСИВЫХ
Dialogue: 0,0:05:34.83,0:05:37.55,Caption,,0,0,0,,СЛОВАХ. ОБЫЧНО РЯДОМ ОБЯЗАТЕЛЬНО СТОИТ КТО ТО С
Dialogue: 0,0:05:37.55,0:05:40.67,Caption,,0,0,0,,КАЛЬКУЛЯТОРОМ. ЕСЛИ ВАМ НУЖЕН ИМЕННО ТАКОЙ РАЗБОР,
Dialogue: 0,0:05:40.91,0:05:42.99,Caption,,0,0,0,,БЕЗ ДИПЛОМАТИЧЕСКОЙ КАШИ И С ВОПРОСОМ,
Dialogue: 0,0:05:43.15,0:05:48.19,Caption,,0,0,0,,КТО ЧТО ПОЛУЧАЕТ НА ПРАКТИКЕ, ПОДПИСЫВАЙТЕСЬ. ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ КРУПНОЕ.
Dialogue: 0,0:05:48.59,0:05:52.99,Caption,,0,0,0,,ДЖАРЕД КУШНЕР СКАЗАЛ, ЧТО США РАБОТАЮТ НЕ ТОЛЬКО НАД ЗАВЕРШЕНИЕМ НЫНЕШНЕГО
Dialogue: 0,0:05:52.99,0:05:56.75,Caption,,0,0,0,,КОНФЛИКТА, НО И НАД БОЛЕЕ ШИРОКОЙ АРХИТЕКТУРОЙ БЕЗОПАСНОСТИ В
Dialogue: 0,0:05:56.75,0:06:00.35,Caption,,0,0,0,,ЕВРОПЕ. И ВОТ ЗДЕСЬ ОН ГОВОРИТ ПРАВИЛЬНУЮ ВЕЩЬ. ПОТОМУ
Dialogue: 0,0:06:00.43,0:06:03.55,Caption,,0,0,0,,ЧТО ПРОСТО ОСТАНОВИТЬ СТРЕЛЬБУ МАЛО. МОЖНО ПОДПИСАТЬ
Dialogue: 0,0:06:03.55,0:06:06.35,Caption,,0,0,0,,БУМАГУ, СФОТОГРАФИРОВАТЬСЯ, ПОЖАТЬ РУКИ,
Dialogue: 0,0:06:06.52,0:06:09.15,Caption,,0,0,0,,РАЗЪЕХАТЬСЯ ПО ДОМАМ. А ЧЕРЕЗ ГОД ОБНАРУЖИТЬ,
Dialogue: 0,0:06:09.39,0:06:11.71,Caption,,0,0,0,,ЧТО ПРИЧИНЫ НИКУДА НЕ ДЕЛИСЬ И ВСЕ ОПЯТЬ
Dialogue: 0,0:06:11.71,0:06:14.27,Caption,,0,0,0,,СТОЯТ НА ТЕХ ЖЕ ПОЗИЦИЯХ, ТОЛЬКО УЖЕ ЗЛЕЕ.
Dialogue: 0,0:06:14.88,0:06:17.15,Caption,,0,0,0,,ХОРОШО, ЧТО В ВАШИНГТОНЕ ЭТО ПОНИМАЮТ.
Dialogue: 0,0:06:19.44,0:06:22.56,Caption,,0,0,0,,КУШНЕР ПРЯМО НАПИСАЛ, ЧТО ЗАДАЧА СОСТОИТ В ТОМ,
Dialogue: 0,0:06:22.80,0:06:25.04,Caption,,0,0,0,,ЧТОБЫ ПОСЛЕ ПРЕКРАЩЕНИЯ БОЁВ ОНИ БОЛЬШЕ НЕ
Dialogue: 0,0:06:25.04,0:06:28.88,Caption,,0,0,0,,ВОЗОБНОВИЛИСЬ. ВОТ ЭТО УЖЕ РАЗГОВОР НЕ ПРО КРАСИВУЮ ПАУЗУ,
Dialogue: 0,0:06:29.04,0:06:32.96,Caption,,0,0,0,,А ПРО КОНСТРУКЦИЮ, КОТОРАЯ ДОЛЖНА ПРОЖИТЬ ДОЛЬШЕ ОДНОГО ПОЛИТИЧЕСКОГО
Dialogue: 0,0:06:32.96,0:06:36.56,Caption,,0,0,0,,СЕЗОНА. ТОЛЬКО СТРОИТЬ ЭТУ КОНСТРУКЦИЮ ПРИДЁТСЯ НЕ НА ПУСТОМ
Dialogue: 0,0:06:36.56,0:06:39.76,Caption,,0,0,0,,МЕСТЕ. МОСКВА СВОИ ТРЕБОВАНИЯ НЕ СПРЯТАЛА В СЕЙФ
Dialogue: 0,0:06:39.92,0:06:42.56,Caption,,0,0,0,,И НЕ ПОТЕРЯЛА КЛЮЧ. ПУТИН СНОВА И СНОВА
Dialogue: 0,0:06:42.56,0:06:46.08,Caption,,0,0,0,,ПОВТОРЯЕТ, ЧТО ЦЕЛИ СПЕЦИАЛЬНОЙ ВОЕННОЙ ОПЕРАЦИИ БУДУТ
Dialogue: 0,0:06:46.08,0:06:48.96,Caption,,0,0,0,,ДОСТИГНУТЫ. ЛАВРОВ В КОНЦЕ ОКТЯБРЯ ЗАЯВИЛ,
Dialogue: 0,0:06:49.26,0:06:52.24,Caption,,0,0,0,,ЧТО РОССИЙСКАЯ ПОЗИЦИЯ С САМОГО НАЧАЛА НЕ ИЗМЕНИЛАСЬ
Dialogue: 0,0:06:52.24,0:06:55.36,Caption,,0,0,0,,И ЧТО УКРАИНА НЕ ДОЛЖНА ОСТАВАТЬСЯ ВОЕННОЙ УГРОЗОЙ
Dialogue: 0,0:06:55.36,0:06:58.40,Caption,,0,0,0,,ИНТЕРЕСАМ БЕЗОПАСНОСТИ РОССИИ. ПЕСКОВ ОТДЕЛЬНО
Dialogue: 0,0:06:58.40,0:07:02.40,Caption,,0,0,0,,ПОДЧЁРКИВАЛ, ЧТО ВОЗОБНОВЛЕНИЕ ПЕРЕГОВОРОВ НЕ ОЗНАЧАЕТ ОСТАНОВКУ
Dialogue: 0,0:07:02.40,0:07:05.44,Caption,,0,0,0,,ВОЕННЫХ ДЕЙСТВИЙ. ВОТ ЗДЕСЬ И НАЧИНАЕТСЯ НАСТОЯЩАЯ
Dialogue: 0,0:07:05.44,0:07:08.48,Caption,,0,0,0,,РАБОТА ДЛЯ КУШНЕРА. НЕ ПРИДУМАТЬ КРАСИВУЮ ФОРМУЛУ,
Dialogue: 0,0:07:08.72,0:07:11.60,Caption,,0,0,0,,КОТОРУЮ МОЖНО ПОКАЗАТЬ ЖУРНАЛИСТАМ. А СОБРАТЬ ТАКУЮ
Dialogue: 0,0:07:11.60,0:07:15.36,Caption,,0,0,0,,СИСТЕМУ, В КОТОРОЙ СТОРОНЫ РЕАЛЬНО СОГЛАСЯТСЯ ЖИТЬ. ПОТОМУ
Dialogue: 0,0:07:15.44,0:07:17.36,Caption,,0,0,0,,ЧТО РОССИЯ В ЭТОМ ВОПРОСЕ ВЕДЁТ СЕБЯ КАК
Dialogue: 0,0:07:17.36,0:07:21.52,Caption,,0,0,0,,СКАЛА. МОЖНО УСТРАИВАТЬ НОВЫЕ КОАЛИЦИИ ЖЕЛАЮЩИХ. МОЖНО
Dialogue: 0,0:07:21.52,0:07:24.64,Caption,,0,0,0,,ПРОВОДИТЬ МАНЁВРЫ. МОЖНО ОБСУЖДАТЬ НОВЫЕ ГАРАНТИИ,
Dialogue: 0,0:07:24.80,0:07:27.60,Caption,,0,0,0,,КОНТИНГЕНТЫ, БАЗЫ, МИССИИ,
Dialogue: 0,0:07:27.69,0:07:32.08,Caption,,0,0,0,,ПАТРУЛИ И ЕЩЁ ДВАДЦАТЬ СЛОВ, КОТОРЫЕ ПРЕКРАСНО СМОТРЯТСЯ В ПРЕСС РЕЛИЗЕ.
Dialogue: 0,0:07:34.36,0:07:36.92,Caption,,0,0,0,,НО МОСКВА КАЖДЫЙ РАЗ ВОЗВРАЩАЕТ РАЗГОВОР К ОДНОМУ
Dialogue: 0,0:07:37.00,0:07:39.88,Caption,,0,0,0,,И ТОМУ ЖЕ НАШИ БАЗОВЫЕ ТРЕБОВАНИЯ ПО БЕЗОПАСНОСТИ
Dialogue: 0,0:07:39.89,0:07:43.16,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗЛИ. МОЖНО РАЗДРАЖАТЬСЯ. МОЖНО
Dialogue: 0,0:07:43.16,0:07:46.28,Caption,,0,0,0,,СПОРИТЬ. МОЖНО СЧИТАТЬ ЭТИ ТРЕБОВАНИЯ ЗАВЫШЕННЫМИ.
Dialogue: 0,0:07:46.52,0:07:49.40,Caption,,0,0,0,,НО ДЛЯ ПЕРЕГОВОРЩИКА ЕСТЬ НЕПРИЯТНАЯ ВЕЩЬ ЕСЛИ ОДНА
Dialogue: 0,0:07:49.40,0:07:51.48,Caption,,0,0,0,,СТОРОНА ЧЕТЫРЕ С ЛИШНИМ ГОДА ПОВТОРЯЕТ,
Dialogue: 0,0:07:51.64,0:07:53.96,Caption,,0,0,0,,ЧТО ИМЕННО СЧИТАЕТ ПРИЧИНОЙ КОНФЛИКТА,
Dialogue: 0,0:07:54.32,0:07:56.68,Caption,,0,0,0,,НЕЛЬЗЯ ПОСТРОИТЬ ПОСЛЕВОЕННУЮ СИСТЕМУ ТАК,
Dialogue: 0,0:07:57.00,0:07:59.56,Caption,,0,0,0,,БУДТО ОНА ЭТОГО НИКОГДА НЕ ГОВОРИЛА. И ПОЭТОМУ
Dialogue: 0,0:07:59.64,0:08:01.96,Caption,,0,0,0,,РАЗГОВОР О ТЕРРИТОРИЯХ ЗДЕСЬ ТОЖЕ ВЫГЛЯДИТ НЕМНОГО
Dialogue: 0,0:08:01.96,0:08:05.64,Caption,,0,0,0,,ИНАЧЕ, ЧЕМ ЕГО ЧАСТО ПРОДАЮТ ПУБЛИКЕ. ТЕРРИТОРИЯ ВАЖНА.
Dialogue: 0,0:08:06.10,0:08:08.92,Caption,,0,0,0,,ЛЮДИ, ГОРОДА, ЛИНИИ КОНТРОЛЯ,
Dialogue: 0,0:08:09.02,0:08:12.84,Caption,,0,0,0,,ИНФРАСТРУКТУРА, ВСЁ ЭТО ВАЖНО. НО САМ СПОР О ТЕРРИТОРИИ
Dialogue: 0,0:08:12.84,0:08:14.84,Caption,,0,0,0,,ОДНОВРЕМЕННО ЯВЛЯЕТСЯ ВОПРОСОМ О ТОМ,
Dialogue: 0,0:08:15.08,0:08:17.88,Caption,,0,0,0,,ГДЕ ВООБЩЕ ДОЛЖНА ОСТАНОВИТЬСЯ РОССИЙСКАЯ АРМИЯ.
Dialogue: 0,0:08:18.24,0:08:20.92,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ФОРМУЛА "ОТДАСТ ИЛИ НЕ ОТДАСТ"
Dialogue: 0,0:08:20.97,0:08:24.12,Caption,,0,0,0,,СЛИШКОМ ПРИМИТИВНАЯ. ВОПРОС ГОРАЗДО ЖЁСТЧЕ НАСКОЛЬКО
Dialogue: 0,0:08:24.12,0:08:26.20,Caption,,0,0,0,,ДАЛЕКО РОССИЯ СОБИРАЕТСЯ ЗАЙТИ,
Dialogue: 0,0:08:26.46,0:08:29.32,Caption,,0,0,0,,ЕСЛИ ПОЛИТИЧЕСКОГО РЕШЕНИЯ ПО БЕЗОПАСНОСТИ НЕ БУДЕТ.
Dialogue: 0,0:08:29.72,0:08:32.84,Caption,,0,0,0,,ВОТ ГДЕ НАХОДИТСЯ НАСТОЯЩАЯ ЦЕНА ПЕРЕГОВОРОВ. НЕ
Dialogue: 0,0:08:32.92,0:08:36.28,Caption,,0,0,0,,ТОЛЬКО В ТОМ, КОМУ НА КАРТЕ ДОСТАНЕТСЯ ТОТ ИЛИ ИНОЙ КУСОК.
Dialogue: 0,0:08:36.60,0:08:38.92,Caption,,0,0,0,,А В ТОМ, ЧТО ДОЛЖНО ПРОИЗОЙТИ,
Dialogue: 0,0:08:39.09,0:08:41.96,Caption,,0,0,0,,ЧТОБЫ ПРОДВИЖЕНИЕ ОСТАНОВИЛОСЬ И БОЛЬШЕ НЕ НАЧАЛОСЬ
Dialogue: 0,0:08:42.04,0:08:44.76,Caption,,0,0,0,,СНОВА. В КОНКРЕТНЫХ ДЕТАЛЯХ МЕСТО ДЛЯ ТОРГА
Dialogue: 0,0:08:44.76,0:08:48.17,Caption,,0,0,0,,ОСТАЁТСЯ. В СРОКАХ,
Dialogue: 0,0:08:48.32,0:08:51.69,Caption,,0,0,0,,ФОРМЕ ДОГОВОРЁННОСТЕЙ, ПОСЛЕДОВАТЕЛЬНОСТИ ИСПОЛНЕНИЯ,
Dialogue: 0,0:08:51.80,0:08:56.01,Caption,,0,0,0,,КОНТРОЛЕ, ЭКОНОМИЧЕСКИХ ВОПРОСАХ. ДИПЛОМАТИЯ ВООБЩЕ СУЩЕСТВУЕТ
Dialogue: 0,0:08:56.01,0:08:59.85,Caption,,0,0,0,,ДЛЯ ТОГО, ЧТОБЫ ДВИГАТЬ ДЕТАЛИ. НО ЕСЛИ СМОТРЕТЬ НА ПУБЛИЧНУЮ
Dialogue: 0,0:08:59.85,0:09:01.37,Caption,,0,0,0,,ЛИНИЮ РОССИЙСКОГО РУКОВОДСТВА,
Dialogue: 0,0:09:01.69,0:09:04.73,Caption,,0,0,0,,БАЗОВАЯ РАМКА ОСТАЁТСЯ ЖЁСТКОЙ ЦЕЛИ НЕ ОТМЕНЕНЫ.
Dialogue: 0,0:09:05.02,0:09:07.77,Caption,,0,0,0,,ПОЭТОМУ ВСЯ ЭТА СУЕТА ВОКРУГ КОАЛИЦИЙ ЖЕЛАЮЩИХ
Dialogue: 0,0:09:07.77,0:09:10.81,Caption,,0,0,0,,ВЫГЛЯДИТ МЕСТАМИ КОМИЧНО. ЛЮДИ УЖЕ ОБСУЖДАЮТ,
Dialogue: 0,0:09:11.13,0:09:14.25,Caption,,0,0,0,,КАКИЕ СИЛЫ КУДА ПОЕДУТ, КТО КОГО БУДЕТ СТРАХОВАТЬ,
Dialogue: 0,0:09:14.53,0:09:16.97,Caption,,0,0,0,,КТО КОМУ ДАСТ ГАРАНТИИ. А МОСКВА В ЭТО
Dialogue: 0,0:09:17.05,0:09:19.85,Caption,,0,0,0,,ВРЕМЯ СПОКОЙНО ПОВТОРЯЕТ СНАЧАЛА ДОГОВОРИТЕСЬ С НАМИ
Dialogue: 0,0:09:19.93,0:09:22.57,Caption,,0,0,0,,О ТОМ, ЧТО МЫ СЧИТАЕМ СВОЕЙ БЕЗОПАСНОСТЬЮ.
Dialogue: 0,0:09:23.24,0:09:25.69,Caption,,0,0,0,,И ВОТ ЗДЕСЬ АМЕРИКАНЦАМ ПРИДЁТСЯ ВЫБИРАТЬ НЕ МЕЖДУ
Dialogue: 0,0:09:25.69,0:09:28.65,Caption,,0,0,0,,КРАСИВОЙ И НЕКРАСИВОЙ ФОРМУЛИРОВКОЙ. ИМ ПРИДЁТСЯ
Dialogue: 0,0:09:28.65,0:09:33.21,Caption,,0,0,0,,РАБОТАТЬ С ТЕМ, ЧТО ЕСТЬ. ПОТОМУ ЧТО НОВАЯ АРХИТЕКТУРА БЕЗОПАСНОСТИ
Dialogue: 0,0:09:33.31,0:09:36.73,Caption,,0,0,0,,НЕ СТРОИТСЯ ГОЛОСОВАНИЕМ В БРЮССЕЛЕ. НЕЛЬЗЯ СОБРАТЬ
Dialogue: 0,0:09:36.73,0:09:39.13,Caption,,0,0,0,,ДВАДЦАТЬ СТРАН, ПОДНЯТЬ РУКИ И ОБЪЯВИТЬ,
Dialogue: 0,0:09:39.29,0:09:42.09,Caption,,0,0,0,,ЧТО РОССИЯ ТЕПЕРЬ ЧУВСТВУЕТ СЕБЯ В БЕЗОПАСНОСТИ. ТАК
Dialogue: 0,0:09:42.17,0:09:44.65,Caption,,0,0,0,,ЭТО НЕ РАБОТАЕТ. ТЕМ БОЛЕЕ ЧТО КРУГ УЧАСТНИКОВ
Dialogue: 0,0:09:44.73,0:09:47.61,Caption,,0,0,0,,УЖЕ СТАНОВИТСЯ ШИРЕ ЕВРОПЫ. КИТАЙ ПОДТВЕРДИЛ
Dialogue: 0,0:09:47.61,0:09:50.17,Caption,,0,0,0,,КОНТАКТЫ С РОССИЕЙ И США ПО ПОВОДУ ПЕРВОЙ
Dialogue: 0,0:09:50.17,0:09:55.05,Caption,,0,0,0,,ТРЁХСТОРОННЕЙ ВСТРЕЧИ ПУТИНА, ТРАМПА И СИ ЦЗИНЬПИНА. ОБСУЖДЕНИЕ ИДЁТ ВОКРУГ
Dialogue: 0,0:09:55.05,0:09:58.17,Caption,,0,0,0,,САММИТА АТЭС В ШЭНЬЧЖЭНЕ. И САМ ФАКТ ТАКИХ
Dialogue: 0,0:09:58.25,0:10:00.33,Caption,,0,0,0,,КОНТАКТОВ ПОКАЗЫВАЕТ МАСШТАБ ЗАДАЧИ.
Dialogue: 0,0:10:02.61,0:10:04.37,Caption,,0,0,0,,ЕСЛИ БЫ ВОПРОС БЫЛ ТОЛЬКО В ТОМ,
Dialogue: 0,0:10:04.56,0:10:06.85,Caption,,0,0,0,,КТО ГДЕ ОСТАНОВИТСЯ НА УКРАИНСКОЙ КАРТЕ,
Dialogue: 0,0:10:07.09,0:10:09.33,Caption,,0,0,0,,ПРЕДСЕДАТЕЛЬ КИТАЯ ЗДЕСЬ ВООБЩЕ ВЫГЛЯДЕЛ БЫ КАК
Dialogue: 0,0:10:09.41,0:10:13.25,Caption,,0,0,0,,ЧЕЛОВЕК, СЛУЧАЙНО ЗАШЕДШИЙ НЕ В ТУ ПЕРЕГОВОРНУЮ КОМНАТУ. НО
Dialogue: 0,0:10:13.33,0:10:16.05,Caption,,0,0,0,,КИТАЙ ЗДЕСЬ НЕ СЛУЧАЙНЫЙ ГОСТЬ. ЭТО КРУПНЕЙШАЯ
Dialogue: 0,0:10:16.05,0:10:19.33,Caption,,0,0,0,,ЭКОНОМИКА, КРУПНЕЙШИЙ ПОКУПАТЕЛЬ РОССИЙСКИХ РЕСУРСОВ,
Dialogue: 0,0:10:19.65,0:10:22.61,Caption,,0,0,0,,ГЛАВНЫЙ СТРАТЕГИЧЕСКИЙ ПАРТНЁР МОСКВЫ В АЗИИ И
Dialogue: 0,0:10:22.61,0:10:26.05,Caption,,0,0,0,,ОДНОВРЕМЕННО ГЛАВНЫЙ КОНКУРЕНТ США. ПОЭТОМУ РАЗГОВОР
Dialogue: 0,0:10:26.13,0:10:28.85,Caption,,0,0,0,,УЖЕ ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ ОДНОЙ ЛИНИИ ФРОНТА.
Dialogue: 0,0:10:29.09,0:10:31.89,Caption,,0,0,0,,ЭНЕРГЕТИКА, САНКЦИИ, ТОРГОВЛЯ,
Dialogue: 0,0:10:32.04,0:10:35.33,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ, ОТНОШЕНИЯ РОССИИ С КИТАЕМ,
Dialogue: 0,0:10:35.41,0:10:38.21,Caption,,0,0,0,,ОТНОШЕНИЯ КИТАЯ С США. ВСЁ ЭТО ЛЕЖИТ НА
Dialogue: 0,0:10:38.29,0:10:41.97,Caption,,0,0,0,,ОДНОМ СТОЛЕ, ДАЖЕ ЕСЛИ КАЖДОМУ УЧАСТНИКУ ОЧЕНЬ ХОЧЕТСЯ СДЕЛАТЬ
Dialogue: 0,0:10:42.05,0:10:45.01,Caption,,0,0,0,,ВИД, ЧТО У НЕГО СВОЯ ОТДЕЛЬНАЯ ПАПОЧКА. И ТУТ
Dialogue: 0,0:10:45.01,0:10:47.49,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА МАЛЕНЬКАЯ НЕФТЯНАЯ ДЕТАЛЬ,
Dialogue: 0,0:10:47.81,0:10:51.57,Caption,,0,0,0,,КОТОРАЯ ХОРОШО ПОКАЗЫВАЕТ, КАК СЕГОДНЯ УСТРОЕНА БОЛЬШАЯ ПОЛИТИКА.
Dialogue: 0,0:10:52.36,0:10:55.33,Caption,,0,0,0,,КАЗАХСТАН ХОЧЕТ СНОВА ПОСТАВЛЯТЬ НЕФТЬ В ГЕРМАНИЮ ПО
Dialogue: 0,0:10:55.33,0:10:58.45,Caption,,0,0,0,,ТРУБОПРОВОДУ "ДРУЖБА". ПОСТАВКИ ОСТАНОВИЛИСЬ В МАЕ.
Dialogue: 0,0:10:58.93,0:11:01.49,Caption,,0,0,0,,КАЗАХСТАНСКИЙ МИНИСТР ЭНЕРГЕТИКИ ГОВОРИТ ТЕХНИЧЕСКАЯ
Dialogue: 0,0:11:01.49,0:11:04.61,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ЕСТЬ, ОФИЦИАЛЬНЫЙ ЗАПРОС РОССИИ ПЕРЕДАН,
Dialogue: 0,0:11:04.85,0:11:07.89,Caption,,0,0,0,,ЖДЁМ ОТВЕТА. ЗАМЕТЬТЕ КРАСОТУ КОНСТРУКЦИИ.
Dialogue: 0,0:11:08.44,0:11:11.73,Caption,,0,0,0,,КАЗАХСТАН ДОБЫВАЕТ НЕФТЬ. ГЕРМАНИЯ ХОЧЕТ НЕФТЬ.
Dialogue: 0,0:11:12.14,0:11:15.73,Caption,,0,0,0,,ТРУБА СУЩЕСТВУЕТ. ЗАВОД СУЩЕСТВУЕТ. ПОКУПАТЕЛЬ
Dialogue: 0,0:11:15.73,0:11:18.21,Caption,,0,0,0,,СУЩЕСТВУЕТ. ПРОДАВЕЦ СУЩЕСТВУЕТ.
Dialogue: 0,0:11:20.48,0:11:23.68,Caption,,0,0,0,,КАЗАЛОСЬ БЫ, ЧЕГО ЕЩЁ НАДО ВЗРОСЛЫМ ЛЮДЯМ ДЛЯ СЧАСТЬЯ?
Dialogue: 0,0:11:23.89,0:11:26.64,Caption,,0,0,0,,ОТВЕТ РОССИЯ. ПОТОМУ ЧТО МАРШРУТ ИДЁТ ЧЕРЕЗ
Dialogue: 0,0:11:26.64,0:11:29.84,Caption,,0,0,0,,РОССИЙСКУЮ СИСТЕМУ. И ПОКА МОСКВА НЕ СКАЖЕТ "ДА",
Dialogue: 0,0:11:30.21,0:11:32.96,Caption,,0,0,0,,ВСЯ ЭТА ПРЕКРАСНАЯ РЫНОЧНАЯ ЭКОНОМИКА СТОИТ ВОЗЛЕ
Dialogue: 0,0:11:32.96,0:11:35.44,Caption,,0,0,0,,ТРУБЫ И ЖДЁТ, КОГДА ЕЙ ОТКРОЮТ КРАН.
Dialogue: 0,0:11:36.11,0:11:38.80,Caption,,0,0,0,,ЗА ПЕРВЫЕ ЧЕТЫРЕ МЕСЯЦА ЭТОГО ГОДА КАЗАХСТАН УСПЕЛ
Dialogue: 0,0:11:38.80,0:11:41.44,Caption,,0,0,0,,ОТПРАВИТЬ ПО "ДРУЖБЕ" В ГЕРМАНИЮ БОЛЬШЕ МИЛЛИОНА
Dialogue: 0,0:11:41.44,0:11:43.92,Caption,,0,0,0,,ТОНН. ПЛАН НА ГОД БЫЛ ОКОЛО ТРЁХ МИЛЛИОНОВ.
Dialogue: 0,0:11:44.08,0:11:46.80,Caption,,0,0,0,,ПОТОМ ТРАНЗИТ ОСТАНОВИЛСЯ. ТЕПЕРЬ АСТАНА СНОВА
Dialogue: 0,0:11:46.88,0:11:49.36,Caption,,0,0,0,,СТУЧИТ В ДВЕРЬ. И ЭТО ОЧЕНЬ ХОРОШО ДОПОЛНЯЕТ
Dialogue: 0,0:11:49.44,0:11:52.40,Caption,,0,0,0,,ИСТОРИЮ С АМЕРИКАНСКИМ ГАЗОМ И ДИЗЕЛЕМ. РЕСУРСЫ
Dialogue: 0,0:11:52.48,0:11:56.24,Caption,,0,0,0,,ЕСТЬ. ПОКУПАТЕЛИ ЕСТЬ. ДЕНЬГИ ЕСТЬ. НО МАРШРУТЫ
Dialogue: 0,0:11:56.32,0:11:59.36,Caption,,0,0,0,,ПРОХОДЯТ ЧЕРЕЗ ПОЛИТИКУ. ПРИЧЁМ БУКВАЛЬНО. АМЕРИКА
Dialogue: 0,0:11:59.36,0:12:04.16,Caption,,0,0,0,,ХОЧЕТ РОССИЙСКИЙ ДИЗЕЛЬ, А АМЕРИКАНСКИЙ ГУБЕРНАТОР ГРОЗИТ ПОРТАМ. ЕВРОПА
Dialogue: 0,0:12:04.16,0:12:07.76,Caption,,0,0,0,,МНОГО ЛЕТ РАССКАЗЫВАЛА, КАК ОКОНЧАТЕЛЬНО УХОДИТ ОТ РОССИЙСКИХ
Dialogue: 0,0:12:07.76,0:12:11.20,Caption,,0,0,0,,ЭНЕРГОНОСИТЕЛЕЙ, А ТЕПЕРЬ РЯДОМ ОБСУЖДАЕТСЯ ВОССТАНОВЛЕНИЕ
Dialogue: 0,0:12:11.20,0:12:12.96,Caption,,0,0,0,,РОССИЙСКОГО ГАЗОВОГО ТРАНЗИТА.
Dialogue: 0,0:12:13.56,0:12:15.68,Caption,,0,0,0,,КАЗАХСТАН ХОЧЕТ КАЧАТЬ НЕФТЬ НЕМЦАМ,
Dialogue: 0,0:12:15.84,0:12:19.28,Caption,,0,0,0,,НО ЖДЁТ РЕШЕНИЯ РОССИИ. КИТАЙ ОБСУЖДАЕТ ВСТРЕЧУ ТРЁХ
Dialogue: 0,0:12:19.28,0:12:22.40,Caption,,0,0,0,,ЛИДЕРОВ. КУШНЕР ПЫТАЕТСЯ СОБРАТЬ НОВУЮ СИСТЕМУ
Dialogue: 0,0:12:22.40,0:12:25.36,Caption,,0,0,0,,БЕЗОПАСНОСТИ. И ВСЁ ЭТО НЕ ПЯТЬ РАЗНЫХ НОВОСТЕЙ.
Dialogue: 0,0:12:25.63,0:12:30.16,Caption,,0,0,0,,ЭТО ОДНА ИСТОРИЯ О ТОМ, ЧТО ЭКОНОМИКА УЖЕ ПЫТАЕТСЯ ПРОЛЕЗТЬ В ЩЕЛИ БУДУЩЕГО
Dialogue: 0,0:12:30.16,0:12:32.80,Caption,,0,0,0,,МИРА, ПОКА САМ МИР ЕЩЁ ДАЖЕ НЕ СОГЛАСОВАН.
Dialogue: 0,0:12:35.08,0:12:37.72,Caption,,0,0,0,,ВОТ ПОЧЕМУ ДИЗЕЛЬНЫЙ АТТРАКЦИОН В НАЧАЛЕ НАСТОЛЬКО
Dialogue: 0,0:12:37.72,0:12:41.64,Caption,,0,0,0,,ПОКАЗАТЕЛЕН. МАЛЕНЬКУЮ СДЕЛКУ МОЖНО ОБЪЯВИТЬ ЗА ОДИН ТЕЛЕФОННЫЙ
Dialogue: 0,0:12:41.64,0:12:45.08,Caption,,0,0,0,,РАЗГОВОР. А ПОТОМ ОНА УПИРАЕТСЯ В ГУБЕРНАТОРА,
Dialogue: 0,0:12:45.24,0:12:49.24,Caption,,0,0,0,,ЗАКОН, ТЕРМИНАЛ И ТАНКЕР, КОТОРЫЙ ВНЕЗАПНО РЕШИЛ,
Dialogue: 0,0:12:49.32,0:12:52.12,Caption,,0,0,0,,ЧТО БРАЗИЛИЯ СЕГОДНЯ КАК ТО СПОКОЙНЕЕ. С БОЛЬШОЙ
Dialogue: 0,0:12:52.12,0:12:55.56,Caption,,0,0,0,,БЕЗОПАСНОСТЬЮ БУДЕТ ЕЩЁ ВЕСЕЛЕЕ. ТАМ ВМЕСТО ОДНОГО
Dialogue: 0,0:12:55.56,0:12:58.28,Caption,,0,0,0,,ГУБЕРНАТОРА ЦЕЛЫЙ ЕВРОСОЮЗ, НАТО,
Dialogue: 0,0:12:58.38,0:13:02.76,Caption,,0,0,0,,УКРАИНА, РОССИЯ, США, КИТАЙ И КУЧА СТРАН,
Dialogue: 0,0:13:03.07,0:13:05.24,Caption,,0,0,0,,У КАЖДОЙ ИЗ КОТОРЫХ СВОЙ СПИСОК СТРАХОВ,
Dialogue: 0,0:13:05.39,0:13:08.36,Caption,,0,0,0,,ДЕНЕГ И КРАСНЫХ ЛИНИЙ. НО НАПРАВЛЕНИЕ,
Dialogue: 0,0:13:08.52,0:13:10.60,Caption,,0,0,0,,КОТОРОЕ ОБОЗНАЧИЛ КУШНЕР, ПРАВИЛЬНОЕ.
Dialogue: 0,0:13:11.16,0:13:14.20,Caption,,0,0,0,,РАБОТАТЬ НАДО ИМЕННО НАД ПРАВИЛАМИ ПОСЛЕ КОНФЛИКТА.
Dialogue: 0,0:13:14.58,0:13:16.92,Caption,,0,0,0,,НЕ НАД КРАСИВОЙ ПАУЗОЙ. НЕ НАД ТЕМ,
Dialogue: 0,0:13:17.09,0:13:20.12,Caption,,0,0,0,,КАК БЫСТРО СДЕЛАТЬ ФОТОГРАФИЮ ПОДПИСАНИЯ. А НАД
Dialogue: 0,0:13:20.12,0:13:23.48,Caption,,0,0,0,,СИСТЕМОЙ, В КОТОРОЙ СЛЕДУЮЩИЙ КРИЗИС НЕ НАЧИНАЕТСЯ ЧЕРЕЗ
Dialogue: 0,0:13:23.48,0:13:26.28,Caption,,0,0,0,,ПОЛГОДА ПОСЛЕ ПРЕДЫДУЩЕГО. ТОЛЬКО СТРОИТЬ ЕЁ
Dialogue: 0,0:13:26.36,0:13:29.64,Caption,,0,0,0,,ПРИДЁТСЯ ИСХОДЯ ИЗ РЕАЛЬНЫХ ПОЗИЦИЙ СТОРОН. РОССИЯ
Dialogue: 0,0:13:29.64,0:13:32.36,Caption,,0,0,0,,ПУБЛИЧНО СВОИХ ЦЕЛЕЙ НЕ МЕНЯЕТ. И ПОКА ЭТО
Dialogue: 0,0:13:32.44,0:13:37.72,Caption,,0,0,0,,ТАК, ЛЮБЫЕ БУДУЩИЕ ГАРАНТИИ, КОАЛИЦИИ И СХЕМЫ ПРИДЁТСЯ ПРОВЕРЯТЬ ОДНИМ ПРОСТЫМ
Dialogue: 0,0:13:37.80,0:13:42.44,Caption,,0,0,0,,ВОПРОСОМ УСТРАНЯЮТ ОНИ ТО, ЧТО МОСКВА СЧИТАЕТ УГРОЗОЙ СВОЕЙ БЕЗОПАСНОСТИ,
Dialogue: 0,0:13:42.84,0:13:45.72,Caption,,0,0,0,,ИЛИ ПРОСТО КРАСИВО ПЕРЕИМЕНОВЫВАЮТ СТАРУЮ ПРОБЛЕМУ.
Dialogue: 0,0:13:45.96,0:13:50.28,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ВТОРОЕ, НИКАКОЙ НОВОЙ АРХИТЕКТУРЫ НЕ ПОЛУЧИТСЯ. ПОЛУЧИТСЯ
Dialogue: 0,0:13:50.28,0:13:52.92,Caption,,0,0,0,,СВЕЖАЯ ШТУКАТУРКА НА СТАРОЙ ТРЕЩИНЕ. КРАСИВО ДО
Dialogue: 0,0:13:52.92,0:13:58.15,Caption,,0,0,0,,ПЕРВОЙ ЗИМЫ. А ТЕРРИТОРИЯ В ЭТОЙ КОНСТРУКЦИИ ОСТАЁТСЯ НЕ
Dialogue: 0,0:13:58.15,0:14:01.11,Caption,,0,0,0,,СУВЕНИРОМ ДЛЯ ПОБЕДИТЕЛЯ И НЕ ОТДЕЛЬНОЙ СТРОКОЙ
Dialogue: 0,0:14:01.11,0:14:04.31,Caption,,0,0,0,,ДОГОВОРА. ЭТО ЕЩЁ И СЧЁТЧИК ВРЕМЕНИ. ЧЕМ ДОЛЬШЕ
Dialogue: 0,0:14:04.31,0:14:06.55,Caption,,0,0,0,,СТОРОНЫ НЕ НАХОДЯТ ПОЛИТИЧЕСКУЮ ФОРМУЛУ,
Dialogue: 0,0:14:06.95,0:14:10.15,Caption,,0,0,0,,ТЕМ ДОЛЬШЕ НА ЗЕМЛЕ ПРОДОЛЖАЕТСЯ ДВИЖЕНИЕ. ПОЭТОМУ
Dialogue: 0,0:14:10.15,0:14:12.87,Caption,,0,0,0,,ВОПРОС О ТЕРРИТОРИИ НА ПЕРЕГОВОРАХ В КОНЕЧНОМ СЧЁТЕ
Dialogue: 0,0:14:12.95,0:14:17.59,Caption,,0,0,0,,И ЕСТЬ ВОПРОС О ТОМ, НАСКОЛЬКО ДАЛЕКО РОССИЯ СОБИРАЕТСЯ ЗАЙТИ ДО ТОГО
Dialogue: 0,0:14:17.59,0:14:20.71,Caption,,0,0,0,,МОМЕНТА, КОГДА БОЛЬШАЯ СДЕЛКА НАКОНЕЦ ПОЯВИТСЯ.
Dialogue: 0,0:14:21.53,0:14:24.31,Caption,,0,0,0,,КУШНЕР ЭТУ БОЛЬШУЮ ЗАДАЧУ УЖЕ НАЗВАЛ. ТЕПЕРЬ
Dialogue: 0,0:14:24.31,0:14:27.43,Caption,,0,0,0,,ОСТАЁТСЯ САМАЯ НЕПРИЯТНАЯ ЧАСТЬ. НЕ ПРИДУМАТЬ
Dialogue: 0,0:14:27.43,0:14:31.03,Caption,,0,0,0,,НАЗВАНИЕ НОВОЙ СИСТЕМЕ БЕЗОПАСНОСТИ. А СДЕЛАТЬ ТАК,
Dialogue: 0,0:14:31.27,0:14:35.91,Caption,,0,0,0,,ЧТОБЫ ПОД НЕЙ ПОДПИСАЛИСЬ ТЕ, КТО СЕГОДНЯ ДРУГ ДРУГУ ВООБЩЕ НЕ ДОВЕРЯЕТ. ВОТ
Dialogue: 0,0:14:35.91,0:14:38.63,Caption,,0,0,0,,ТОГДА И ТАНКЕРЫ, И ТРУБЫ,
Dialogue: 0,0:14:38.94,0:14:42.63,Caption,,0,0,0,,И "ДРУЖБА", И ВСЕ ЭТИ КРАСИВЫЕ ЭКОНОМИЧЕСКИЕ ПРОЕКТЫ ПЕРЕСТАНУТ
Dialogue: 0,0:14:42.63,0:14:45.51,Caption,,0,0,0,,РАЗВОРАЧИВАТЬСЯ НА ПОЛПУТИ. ПОТОМУ ЧТО НАСТОЯЩАЯ
Dialogue: 0,0:14:45.59,0:14:50.23,Caption,,0,0,0,,СДЕЛКА НАЧИНАЕТСЯ НЕ ТОГДА, КОГДА ЕЁ ОБЪЯВИЛИ. ОНА НАЧИНАЕТСЯ ТОГДА,
Dialogue: 0,0:14:50.48,0:14:53.51,Caption,,0,0,0,,КОГДА ЕЁ НИКТО НЕ ПЫТАЕТСЯ ОСТАНОВИТЬ НА СЛЕДУЮЩЕМ
Dialogue: 0,0:14:53.59,0:14:53.91,Caption,,0,0,0,,ПОВОРОТЕ.
