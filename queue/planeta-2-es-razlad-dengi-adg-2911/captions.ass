Dialogue: 0,0:00:00.12,0:00:01.81,Caption,,0,0,0,,В БРЮССЕЛЕ НАШЛИ СПОСОБ ЧИНИТЬ
Dialogue: 0,0:00:01.81,0:00:05.34,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ ЕДИНСТВО. ЕСЛИ НЕСКОЛЬКО СТРАН МЕШАЮТ ПРИНЯТЬ
Dialogue: 0,0:00:05.34,0:00:08.30,Caption,,0,0,0,,НУЖНОЕ РЕШЕНИЕ, ИХ МОЖНО ЗАПИСАТЬ В НЕДОСТАТОЧНО
Dialogue: 0,0:00:08.30,0:00:11.64,Caption,,0,0,0,,КВАЛИФИЦИРОВАННЫЕ И РЕШИТЬ БЕЗ НИХ. УДОБНАЯ СИСТЕМА.
Dialogue: 0,0:00:11.64,0:00:13.64,Caption,,0,0,0,,ОСТАЕТСЯ ОТКРЫТЬ УЧЕБНЫЙ ЦЕНТР,
Dialogue: 0,0:00:13.88,0:00:15.95,Caption,,0,0,0,,ВЫДАТЬ СТРАНАМ ЗАЧЁТНЫЕ КНИЖКИ И
Dialogue: 0,0:00:15.95,0:00:18.82,Caption,,0,0,0,,ОБЪЯСНИТЬ, КТО ЗДЕСЬ СДАЛ ЭКЗАМЕН НА ПРАВИЛЬНОЕ
Dialogue: 0,0:00:18.82,0:00:21.96,Caption,,0,0,0,,БОЛЬШИНСТВО. ЗВУЧИТ ЗАБАВНО, ПОКА НЕ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:00:22.12,0:00:24.50,Caption,,0,0,0,,ЧТО РЕЧЬ ИДЁТ О БЮДЖЕТНЫХ ДЕНЬГАХ И
Dialogue: 0,0:00:24.50,0:00:27.00,Caption,,0,0,0,,ПРАВЕ НЕСОГЛАСНЫХ ВООБЩЕ ЧТО ЛИБО РЕШАТЬ.
Dialogue: 0,0:00:27.56,0:00:29.63,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ТОРЖЕСТВЕННЫЕ
Dialogue: 0,0:00:29.63,0:00:32.44,Caption,,0,0,0,,ДЕКЛАРАЦИИ, А МЕХАНИЗМ ПОД КРАСИВОЙ УПАКОВКОЙ,
Dialogue: 0,0:00:32.59,0:00:35.12,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ЕВРОСОЮЗ СЕЙЧАС
Dialogue: 0,0:00:35.12,0:00:38.20,Caption,,0,0,0,,САМ ПОКАЗЫВАЕТ, НАСКОЛЬКО КРЕПКО ЕГО ЕДИНСТВО,
Dialogue: 0,0:00:38.44,0:00:40.86,Caption,,0,0,0,,КОГДА ВМЕСТО РЕЧЕЙ О ЦЕННОСТЯХ НА СТОЛ
Dialogue: 0,0:00:40.86,0:00:43.28,Caption,,0,0,0,,КЛАДУТ СУММУ К ОПЛАТЕ. СЕМЬ ГОСУДАРСТВ
Dialogue: 0,0:00:43.28,0:00:46.59,Caption,,0,0,0,,ДЕМОНСТРАТИВНО ВЫШЛИ ИЗ БЮДЖЕТНЫХ ПЕРЕГОВОРОВ НА САММИТЕ В
Dialogue: 0,0:00:46.59,0:00:49.64,Caption,,0,0,0,,БРЮССЕЛЕ. ПРЕМЬЕР ЛАТВИИ ОПИСАЛ ПРОИСХОДЯЩЕЕ
Dialogue: 0,0:00:49.64,0:00:51.97,Caption,,0,0,0,,ТОЧНЕЕ ЛЮБОГО АНАЛИТИКА КАЖДЫЙ РУКОВОДИТЕЛЬ
Dialogue: 0,0:00:51.97,0:00:54.92,Caption,,0,0,0,,НАХОДИЛСЯ НА СОБСТВЕННОЙ ПЛАНЕТЕ. КОМНАТА ОБЩАЯ,
Dialogue: 0,0:00:55.11,0:00:58.83,Caption,,0,0,0,,ТАБЛИЧКА ЕВРОСОЮЗА ОДНА, А ОРБИТЫ РАЗНЫЕ. ЧАСТЬ ЛИДЕРОВ
Dialogue: 0,0:00:58.83,0:01:02.45,Caption,,0,0,0,,ПЕРЕСТАЛА ХОДИТЬ НА ЗАСЕДАНИЯ РАБОЧИХ ГРУПП. АНТОНИУ КОШТА
Dialogue: 0,0:01:02.45,0:01:05.04,Caption,,0,0,0,,ПОПРОБОВАЛ РАССАДИТЬ УЧАСТНИКОВ НЕБОЛЬШИМИ
Dialogue: 0,0:01:05.04,0:01:07.79,Caption,,0,0,0,,КОМПАНИЯМИ И ПРОВЕСТИ ЗАКРЫТЫЕ КОНСУЛЬТАЦИИ.
Dialogue: 0,0:01:07.79,0:01:10.20,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ТУПИК ОТ ЭТОГО НИКУДА НЕ УШЁЛ.
Dialogue: 0,0:01:12.48,0:01:15.89,Caption,,0,0,0,,АНДРЕЙ БАБИШ РАССКАЗАЛ, ЧТО ФИНАЛ ВСТРЕЧИ СОПРОВОЖДАЛСЯ
Dialogue: 0,0:01:15.89,0:01:19.29,Caption,,0,0,0,,ГРОМКИМ ОБМЕНОМ МНЕНИЯМИ. УЧАСТНИКИ ДЕЛИЛИ ДЕНЬГИ.
Dialogue: 0,0:01:19.29,0:01:21.44,Caption,,0,0,0,,ОДНИ ТРЕБОВАЛИ УРЕЗАТЬ РАСХОДЫ,
Dialogue: 0,0:01:21.68,0:01:23.84,Caption,,0,0,0,,ДРУГИЕ ЗАЩИЩАЛИ СУБСИДИИ И ВЫПЛАТЫ
Dialogue: 0,0:01:23.84,0:01:26.90,Caption,,0,0,0,,СВОИМ РЕГИОНАМ. ОДНОВРЕМЕННО НУЖНЫ СРЕДСТВА НА
Dialogue: 0,0:01:26.90,0:01:30.24,Caption,,0,0,0,,ВООРУЖЕНИЕ, ТЕХНОЛОГИИ И УКРАИНУ. ЖЕЛАТЕЛЬНО,
Dialogue: 0,0:01:30.40,0:01:32.56,Caption,,0,0,0,,ЧТОБЫ ОБЩИЙ КОШЕЛЕК СТАНОВИЛСЯ ТОЛЩЕ,
Dialogue: 0,0:01:32.80,0:01:34.73,Caption,,0,0,0,,А НАЦИОНАЛЬНЫЙ ВЗНОС ОСТАВАЛСЯ
Dialogue: 0,0:01:34.73,0:01:37.57,Caption,,0,0,0,,ПРЕЖНИМ. ВЕНГРИЯ ВЫСТУПИЛА ПРОТИВ ВКЛЮЧЕНИЯ СТА
Dialogue: 0,0:01:37.57,0:01:41.09,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ДЛЯ УКРАИНЫ В ЕВРОПЕЙСКИЙ БЮДЖЕТ. ПРЕМЬЕР
Dialogue: 0,0:01:41.09,0:01:43.96,Caption,,0,0,0,,МАДЬЯР УКАЗАЛ НА СОСТОЯНИЕ СОБСТВЕННЫХ ФИНАНСОВ И
Dialogue: 0,0:01:43.96,0:01:46.42,Caption,,0,0,0,,ОТКАЗАЛСЯ УВЕЛИЧИВАТЬ ПОМОЩЬ ПО КОМАНДЕ ИЗ
Dialogue: 0,0:01:46.42,0:01:49.12,Caption,,0,0,0,,ЦЕНТРА. ПРЕЖДЕ ЧЕМ РАСПОРЯЖАТЬСЯ ЧУЖОЙ КАССОЙ,
Dialogue: 0,0:01:49.28,0:01:52.00,Caption,,0,0,0,,НЕПЛОХО БЫ ЗАГЛЯНУТЬ В НЕЁ. МНОГОЛЕТНИЙ БЮДЖЕТ
Dialogue: 0,0:01:52.00,0:01:54.09,Caption,,0,0,0,,ТРЕБУЕТ СОГЛАСИЯ ВСЕХ ГОСУДАРСТВ.
Dialogue: 0,0:01:54.09,0:01:56.60,Caption,,0,0,0,,ОБСУЖДЕНИЕ ПРОДОЛЖИТСЯ В ДЕКАБРЕ. ГЕРМАНИЯ
Dialogue: 0,0:01:56.60,0:01:58.56,Caption,,0,0,0,,ПРЕДЛАГАЕТ ИЗМЕНИТЬ ПОРЯДОК ТАК,
Dialogue: 0,0:01:58.79,0:02:00.98,Caption,,0,0,0,,ЧТОБЫ ВОЗРАЖЕНИЯ ОТДЕЛЬНЫХ УЧАСТНИКОВ
Dialogue: 0,0:02:00.98,0:02:03.04,Caption,,0,0,0,,ПЕРЕСТАЛИ ИМЕТЬ РЕШАЮЩЕЕ ЗНАЧЕНИЕ.
Dialogue: 0,0:02:03.72,0:02:05.44,Caption,,0,0,0,,ФРИДРИХ МЕРЦ ТРЕБУЕТ УКРЕПЛЯТЬ
Dialogue: 0,0:02:05.44,0:02:07.52,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ЭКОНОМИКУ И БЕЗОПАСНОСТЬ,
Dialogue: 0,0:02:07.82,0:02:09.49,Caption,,0,0,0,,СОЗДАВАТЬ ЗАПАС ДЛЯ ДЛИТЕЛЬНОГО
Dialogue: 0,0:02:09.49,0:02:12.77,Caption,,0,0,0,,ФИНАНСИРОВАНИЯ УКРАИНЫ И ПРИВЛЕКАТЬ К РАСХОДАМ ВСЕХ
Dialogue: 0,0:02:12.77,0:02:15.76,Caption,,0,0,0,,ЧЛЕНОВ СОЮЗА. РЕШЕНИЯ ОН ПРЕДЛАГАЕТ ПРИНИМАТЬ
Dialogue: 0,0:02:15.76,0:02:18.60,Caption,,0,0,0,,КВАЛИФИЦИРОВАННЫМ БОЛЬШИНСТВОМ. ОБЫЧНОГО БОЛЬШИНСТВА
Dialogue: 0,0:02:18.60,0:02:21.77,Caption,,0,0,0,,ЕВРОПЕ УЖЕ МАЛО, ЕМУ ПОНАДОБИЛСЯ РАЗРЯД КАЧЕСТВА.
Dialogue: 0,0:02:21.77,0:02:24.96,Caption,,0,0,0,,ИНТЕРЕСНО, КТО ПРИНИМАЕТ ЭКЗАМЕН И ОПРЕДЕЛЯЕТ НЕ
Dialogue: 0,0:02:24.96,0:02:30.72,Caption,,0,0,0,,ПРОШЕДШИХ АТТЕСТАЦИЮ. ЗА ЭТОЙ КОМЕДИЕЙ ПРЯЧЕТСЯ СЕРЬЁЗНАЯ
Dialogue: 0,0:02:30.72,0:02:33.56,Caption,,0,0,0,,УГРОЗА. ГЕРМАНИЯ ПРЕДЛАГАЕТ ОГРАНИЧИТЬ ВЕНГРИИ,
Dialogue: 0,0:02:33.64,0:02:37.01,Caption,,0,0,0,,СЛОВАКИИ, ЧЕХИИ И БОЛГАРИИ ДОСТУП К ЕВРОПЕЙСКИМ
Dialogue: 0,0:02:37.01,0:02:39.75,Caption,,0,0,0,,СРЕДСТВАМ, ПОСКОЛЬКУ ОНИ НЕ ХОТЯТ УЧАСТВОВАТЬ В
Dialogue: 0,0:02:39.75,0:02:43.27,Caption,,0,0,0,,ПОМОЩИ УКРАИНЕ. МЕРЦ ОДНОВРЕМЕННО ГРОЗИТ ЗАБЛОКИРОВАТЬ
Dialogue: 0,0:02:43.27,0:02:46.47,Caption,,0,0,0,,ВЕСЬ БЮДЖЕТ, ЕСЛИ ФИНАНСИРОВАНИЕ КИЕВА НЕ ПОДДЕРЖАТ
Dialogue: 0,0:02:46.47,0:02:50.43,Caption,,0,0,0,,ВСЕ ДВАДЦАТЬ СЕМЬ СТРАН. РОБЕРТ ФИЦО НАЗВАЛ ПРОИСХОДЯЩЕЕ
Dialogue: 0,0:02:50.43,0:02:53.53,Caption,,0,0,0,,КЛАССИЧЕСКИМ ШАНТАЖОМ. ГОСУДАРСТВО СВОБОДНО
Dialogue: 0,0:02:53.53,0:02:57.48,Caption,,0,0,0,,ВЫРАЖАЕТ ЛЮБУЮ ПОЗИЦИЮ, ПОКА ОНА СОВПАДАЕТ С ПОЗИЦИЕЙ ТЕХ,
Dialogue: 0,0:02:57.71,0:03:00.03,Caption,,0,0,0,,У КОГО РУКА ЛЕЖИТ НА БЮДЖЕТНОМ КРАНЕ.
Dialogue: 0,0:03:00.03,0:03:03.64,Caption,,0,0,0,,ЕСЛИ МНЕНИЕ ОТЛИЧАЕТСЯ, ДЕНЬГИ ПЕРВЫМИ ТЕРЯЮТ ТЕРПЕНИЕ.
Dialogue: 0,0:03:04.20,0:03:06.15,Caption,,0,0,0,,ОСОБЕННО ВЫРАЗИТЕЛЬНО ЭТО ВЫГЛЯДИТ НА
Dialogue: 0,0:03:06.15,0:03:09.13,Caption,,0,0,0,,ФОНЕ ЖАЛОБ САМОГО МЕРЦА. ГЕРМАНИЯ ВНОСИТ ПРИМЕРНО
Dialogue: 0,0:03:09.13,0:03:13.07,Caption,,0,0,0,,ЧЕТВЕРТЬ БЮДЖЕТА ЕВРОСОЮЗА, А ПОЛУЧАЕТ НАЗАД ОКОЛО ВОСЬМИ
Dialogue: 0,0:03:13.07,0:03:16.57,Caption,,0,0,0,,ПРОЦЕНТОВ. ДЛЯ БЕРЛИНА РАСЧЁТ ВКЛАДА И ОТДАЧИ СЧИТАЕТСЯ
Dialogue: 0,0:03:16.57,0:03:19.16,Caption,,0,0,0,,ВОПРОСОМ СПРАВЕДЛИВОСТИ. ДЛЯ БУДАПЕШТА,
Dialogue: 0,0:03:19.32,0:03:21.67,Caption,,0,0,0,,БРАТИСЛАВЫ ИЛИ ПРАГИ ОН ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:03:21.67,0:03:23.56,Caption,,0,0,0,,НЕДОСТАТОК ЕВРОПЕЙСКОЙ ОТВЕТСТВЕННОСТИ.
Dialogue: 0,0:03:24.12,0:03:26.37,Caption,,0,0,0,,НО МЕРЦ ПЫТАЕТСЯ СТРОИТЬ ВСЕХ ДВАДЦАТЬ
Dialogue: 0,0:03:26.37,0:03:28.20,Caption,,0,0,0,,СЕМЬ УЧАСТНИКОВ В ОДНУ КОЛОННУ,
Dialogue: 0,0:03:28.52,0:03:30.48,Caption,,0,0,0,,КОГДА ГЕРМАНСКИЕ ИЗБИРАТЕЛИ ВСЁ ЧАЩЕ
Dialogue: 0,0:03:30.48,0:03:33.55,Caption,,0,0,0,,СПРАШИВАЮТ, КУДА ОНА ИДЁТ И ПОЧЕМУ ПЛАТИТЬ ЗА
Dialogue: 0,0:03:33.55,0:03:36.34,Caption,,0,0,0,,ДОРОГУ ПРЕДЛАГАЮТ ИМ. ИССЛЕДОВАНИЕ ФОНДА
Dialogue: 0,0:03:36.34,0:03:39.08,Caption,,0,0,0,,КЕРБЕРА, ДАННЫЕ КОТОРОГО ПРИВОДИТ THE GUARDIAN,
Dialogue: 0,0:03:39.40,0:03:41.54,Caption,,0,0,0,,ПОКАЗЫВАЕТ НЕПРИЯТНУЮ ДЛЯ КАНЦЛЕРА
Dialogue: 0,0:03:41.54,0:03:45.92,Caption,,0,0,0,,КАРТИНУ. ПРОТИВ ВОЕННОЙ ПОМОЩИ УКРАИНЕ
Dialogue: 0,0:03:45.92,0:03:48.80,Caption,,0,0,0,,ВЫСТУПАЮТ ПЯТЬДЕСЯТ ТРИ ПРОЦЕНТА ОПРОШЕННЫХ НЕМЦЕВ.
Dialogue: 0,0:03:48.80,0:03:51.30,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ ПОДДЕРЖКИ ОДОБРЯЮТ СОРОК ШЕСТЬ
Dialogue: 0,0:03:51.30,0:03:54.19,Caption,,0,0,0,,ПРОЦЕНТОВ. ЕЩЁ ГОД НАЗАД СТОРОННИКОВ БЫЛО ПЯТЬДЕСЯТ
Dialogue: 0,0:03:54.19,0:03:58.01,Caption,,0,0,0,,ДЕВЯТЬ ПРОЦЕНТОВ. НА ВОСТОКЕ СТРАНЫ РАЗРЫВ ЗАМЕТНЕЕ.
Dialogue: 0,0:03:58.01,0:04:00.88,Caption,,0,0,0,,УКРАИНУ В ЦЕЛОМ ПОДДЕРЖИВАЕТ ТРИДЦАТЬ ОДИН ПРОЦЕНТ
Dialogue: 0,0:04:00.88,0:04:03.64,Caption,,0,0,0,,РЕСПОНДЕНТОВ. ВОЕННУЮ ПОМОЩЬ ОДОБРЯЮТ ТОЛЬКО
Dialogue: 0,0:04:03.64,0:04:06.48,Caption,,0,0,0,,ОДИННАДЦАТЬ ПРОЦЕНТОВ. НОРМАЛИЗОВАТЬ ОТНОШЕНИЯ С
Dialogue: 0,0:04:06.48,0:04:09.35,Caption,,0,0,0,,РОССИЕЙ ХОТЯТ СЕМЬДЕСЯТ ПЯТЬ ПРОЦЕНТОВ. ЭТО УЖЕ НЕ
Dialogue: 0,0:04:09.35,0:04:13.03,Caption,,0,0,0,,ЛЁГКОЕ НЕДОВОЛЬСТВО, А ТРЕБОВАНИЕ ИЗМЕНИТЬ КУРС. НА ТАКОМ
Dialogue: 0,0:04:13.03,0:04:16.50,Caption,,0,0,0,,ФОНЕ КАНЦЛЕР НАСТАИВАЕТ, ЧТО УЧАСТВОВАТЬ ОБЯЗАНЫ ВСЕ
Dialogue: 0,0:04:16.50,0:04:19.94,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ. ВОЗНИКАЕТ ВОПРОС КТО ИМЕННО ЗДЕСЬ
Dialogue: 0,0:04:19.94,0:04:22.17,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТ КВАЛИФИЦИРОВАННОЕ БОЛЬШИНСТВО?
Dialogue: 0,0:04:22.47,0:04:25.13,Caption,,0,0,0,,МОЖЕТ БЫТЬ, ПРЕЖДЕ ЧЕМ ЭКЗАМЕНОВАТЬ СОСЕДЕЙ,
Dialogue: 0,0:04:25.37,0:04:27.01,Caption,,0,0,0,,БЕРЛИНУ СТОИТ ПОКАЗАТЬ ЗАЧЁТКУ
Dialogue: 0,0:04:27.01,0:04:29.93,Caption,,0,0,0,,СОБСТВЕННЫМ ГРАЖДАНАМ. ПО ИНФОРМАЦИИ THE GUARDIAN,
Dialogue: 0,0:04:30.17,0:04:32.29,Caption,,0,0,0,,РАБОТУ МЕРЦА НЕ ОДОБРЯЮТ ВОСЕМЬДЕСЯТ
Dialogue: 0,0:04:32.29,0:04:37.00,Caption,,0,0,0,,ВОСЕМЬ ПРОЦЕНТОВ ОПРОШЕННЫХ. АДГ ТРЕБУЕТ ПРЕКРАТИТЬ ФИНАНСИРОВАНИЕ
Dialogue: 0,0:04:37.00,0:04:39.77,Caption,,0,0,0,,КИЕВА. В САКСОНИИ АНХАЛЬТ СОЮЗ BSW И АДГ
Dialogue: 0,0:04:39.77,0:04:43.00,Caption,,0,0,0,,ВЫСТУПИЛ ЗА ОСТАНОВКУ ПОСТАВОК ВООРУЖЕНИЯ И ОТМЕНУ
Dialogue: 0,0:04:43.00,0:04:45.77,Caption,,0,0,0,,САНКЦИЙ ПРОТИВ РОССИИ. ЭКОНОМИЧЕСКИЕ ПРОБЛЕМЫ
Dialogue: 0,0:04:45.77,0:04:48.87,Caption,,0,0,0,,СВОДЯТ ВЫСОКИЕ РАССУЖДЕНИЯ К ФОРМУЛЕ СКОЛЬКО ОТДАЛИ
Dialogue: 0,0:04:48.87,0:04:52.15,Caption,,0,0,0,,НАРУЖУ И ЧТО ОСТАЛОСЬ ДОМА. КАНЦЛЕР ОКАЗЫВАЕТСЯ ВСЁ
Dialogue: 0,0:04:52.15,0:04:55.44,Caption,,0,0,0,,БОЛЕЕ ИЗОЛИРОВАННЫМ, А АДГ ПОЛУЧАЕТ ГОТОВУЮ ТЕМУ ОТ
Dialogue: 0,0:04:55.44,0:05:00.44,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА. ЕСЛИ ВАМ НУЖЕН РАЗГОВОР О ПОЛИТИКЕ,
Dialogue: 0,0:05:00.59,0:05:02.67,Caption,,0,0,0,,В КОТОРОМ ЗА ГРОМКИМИ ФОРМУЛАМИ ВИДНЫ
Dialogue: 0,0:05:02.67,0:05:06.68,Caption,,0,0,0,,КОНКРЕТНЫЕ ИНТЕРЕСЫ, ПОДПИШИТЕСЬ. ДАЛЬШЕ НАЧИНАЕТСЯ ЧАСТЬ,
Dialogue: 0,0:05:07.00,0:05:09.32,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ У МЕРЦА И УРСУЛЫ ФОН ДЕР
Dialogue: 0,0:05:09.32,0:05:11.59,Caption,,0,0,0,,ЛЯЙЕН ТЕМПЕРАТУРА МОЖЕТ ПОДНЯТЬСЯ БЕЗ
Dialogue: 0,0:05:11.59,0:05:15.22,Caption,,0,0,0,,ВСЯКОЙ ПРОСТУДЫ. АЛИСА ВАЙДЕЛЬ УДАРИЛА ПО ОСНОВАМ
Dialogue: 0,0:05:15.22,0:05:17.96,Caption,,0,0,0,,ГЕРМАНСКОГО КУРСА ПОСЛЕДНИХ ЛЕТ. ДЛЯ НЫНЕШНЕГО
Dialogue: 0,0:05:17.96,0:05:20.74,Caption,,0,0,0,,РУКОВОДСТВА ЕЁ ЗАЯВЛЕНИЯ ДЕЙСТВУЮТ ПРИМЕРНО КАК
Dialogue: 0,0:05:20.74,0:05:23.56,Caption,,0,0,0,,ОТКРЫТОЕ ОКНО В ЯНВАРЕ. ВАЙДЕЛЬ УТВЕРЖДАЕТ,
Dialogue: 0,0:05:23.86,0:05:26.68,Caption,,0,0,0,,ЧТО ЕЩЁ ДО ПОЛНОМАСШТАБНОГО РОССИЙСКОГО ВТОРЖЕНИЯ
Dialogue: 0,0:05:26.98,0:05:29.40,Caption,,0,0,0,,УКРАИНА ОБСТРЕЛИВАЛА ЖИТЕЛЕЙ ДОНБАССА,
Dialogue: 0,0:05:29.57,0:05:31.93,Caption,,0,0,0,,А ПРОИСХОДИВШЕЕ НАПОМИНАЛО ГРАЖДАНСКУЮ
Dialogue: 0,0:05:31.93,0:05:35.42,Caption,,0,0,0,,ВОЙНУ. ПО ЕЁ СЛОВАМ, ГЕРМАНСКИЙ РАЗГОВОР ОБ ЭТОМ УСТРОЕН
Dialogue: 0,0:05:35.42,0:05:37.88,Caption,,0,0,0,,ПРОСТО ЕСЛИ НЕУДОБНЫЙ ФАКТ ДОЛГО НЕ ПРОИЗНОСИТЬ,
Dialogue: 0,0:05:38.19,0:05:41.52,Caption,,0,0,0,,ПУБЛИКА ДОЛЖНА РЕШИТЬ, ЧТО ЕГО НЕ СУЩЕСТВОВАЛО. ЗАТЕМ ОНА
Dialogue: 0,0:05:41.52,0:05:44.32,Caption,,0,0,0,,ПРЕДЛАГАЕТ ПОМЕНЯТЬ УЧАСТНИКОВ МЕСТАМИ. ДОПУСТИЛИ
Dialogue: 0,0:05:44.32,0:05:46.40,Caption,,0,0,0,,БЫ СОЕДИНЕННЫЕ ШТАТЫ РАЗМЕЩЕНИЕ РАКЕТ
Dialogue: 0,0:05:46.40,0:05:49.08,Caption,,0,0,0,,ГОСУДАРСТВАМИ ВАРШАВСКОГО ДОГОВОРА В МЕКСИКЕ ИЛИ
Dialogue: 0,0:05:49.08,0:05:51.66,Caption,,0,0,0,,КАНАДЕ? СПОКОЙНО НАБЛЮДАЛИ БЫ ЗА УЧЕНИЯМИ С
Dialogue: 0,0:05:51.66,0:05:53.96,Caption,,0,0,0,,ОТРАБОТКОЙ УДАРОВ ПО АМЕРИКАНСКОЙ ТЕРРИТОРИИ?
Dialogue: 0,0:05:54.80,0:05:56.58,Caption,,0,0,0,,ЭТИМ ПРИМЕРОМ ВАЙДЕЛЬ ОБЪЯСНЯЕТ
Dialogue: 0,0:05:56.58,0:05:59.76,Caption,,0,0,0,,ТРЕБОВАНИЯ РОССИИ УЧИТЫВАТЬ ЕЁ БЕЗОПАСНОСТЬ И СОЗДАТЬ
Dialogue: 0,0:05:59.76,0:06:03.04,Caption,,0,0,0,,ПРОСТРАНСТВО МЕЖДУ РОССИЙСКОЙ ГРАНИЦЕЙ И НАТО. ОНА
Dialogue: 0,0:06:03.04,0:06:05.89,Caption,,0,0,0,,НАПОМИНАЕТ, ЧТО ДОНАЛЬД ТРАМП ТОЖЕ ГОВОРИЛ О
Dialogue: 0,0:06:05.89,0:06:07.64,Caption,,0,0,0,,ПОНИМАНИИ РОССИЙСКИХ ОПАСЕНИЙ.
Dialogue: 0,0:06:09.91,0:06:12.08,Caption,,0,0,0,,ВЫВОД ВАЙДЕЛЬ ПРЯМОЙ ТАКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:06:12.08,0:06:15.72,Caption,,0,0,0,,ОБСУЖДАЮТ ЗА СТОЛОМ, А НЕ ОТКАЗЫВАЮТСЯ ПРИЗНАВАТЬ. ПО ЕЁ
Dialogue: 0,0:06:15.72,0:06:18.34,Caption,,0,0,0,,ВЕРСИИ, ПОЛОЖЕНИЯ СТАМБУЛЬСКОГО МЕМОРАНДУМА
Dialogue: 0,0:06:18.34,0:06:20.71,Caption,,0,0,0,,ДАВАЛИ УКРАИНЕ БОЛЕЕ ВЫГОДНЫЕ УСЛОВИЯ,
Dialogue: 0,0:06:20.86,0:06:24.36,Caption,,0,0,0,,ЧЕМ НЫНЕШНЯЯ СИТУАЦИЯ, ПОЭТОМУ БОЕВЫЕ ДЕЙСТВИЯ СЛЕДОВАЛО
Dialogue: 0,0:06:24.36,0:06:27.75,Caption,,0,0,0,,ЗАВЕРШИТЬ ТОГДА. ВОИНСТВЕННАЯ РИТОРИКА БЕРЛИНА,
Dialogue: 0,0:06:27.89,0:06:31.35,Caption,,0,0,0,,СЧИТАЕТ ВАЙДЕЛЬ, ПОЗВОЛИЛА МОСКВЕ ВОСПРИНИМАТЬ ГЕРМАНИЮ
Dialogue: 0,0:06:31.35,0:06:34.15,Caption,,0,0,0,,КАК УЧАСТНИКА КОНФЛИКТА. ЕСТЬ У НЕЁ И ВОПРОС,
Dialogue: 0,0:06:34.39,0:06:36.65,Caption,,0,0,0,,НА КОТОРЫЙ ВЛАСТИ ОТВЕЧАТЬ НЕ ЛЮБЯТ.
Dialogue: 0,0:06:36.65,0:06:39.00,Caption,,0,0,0,,ПОЧЕМУ ГЕРМАНСКИЕ ПРЕДСТАВИТЕЛИ РЕГУЛЯРНО
Dialogue: 0,0:06:39.00,0:06:41.19,Caption,,0,0,0,,ПРИЕЗЖАЮТ В КИЕВ, НО ОБХОДЯТ МОСКВУ?
Dialogue: 0,0:06:41.74,0:06:45.21,Caption,,0,0,0,,ВАЙДЕЛЬ ЗАЯВЛЯЕТ, ЧТО ОТПРАВИЛАСЬ БЫ К ПУТИНУ СРАЗУ. ДЛЯ
Dialogue: 0,0:06:45.21,0:06:47.59,Caption,,0,0,0,,НЕМЕЦКОГО РУКОВОДСТВА ОДНА ЭТА ФРАЗА ЗВУЧИТ
Dialogue: 0,0:06:47.59,0:06:50.63,Caption,,0,0,0,,ВЫЗЫВАЮЩЕ. ПОСЛЕ ПРЕКРАЩЕНИЯ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:06:50.71,0:06:53.74,Caption,,0,0,0,,ГОВОРИТ ВАЙДЕЛЬ, ОДИН МИЛЛИОН СТО ТЫСЯЧ УКРАИНЦЕВ
Dialogue: 0,0:06:53.74,0:06:56.79,Caption,,0,0,0,,ДОЛЖНЫ ВЕРНУТЬСЯ НА РОДИНУ. ОНА ТАКЖЕ ПОЛАГАЕТ,
Dialogue: 0,0:06:57.02,0:06:59.22,Caption,,0,0,0,,ЧТО РУССКОЯЗЫЧНЫЕ ТЕРРИТОРИИ ОКАЖУТСЯ
Dialogue: 0,0:06:59.22,0:07:02.07,Caption,,0,0,0,,В СОСТАВЕ РОССИИ И МОСКВА ОТ НИХ НЕ ОТКАЖЕТСЯ.
Dialogue: 0,0:07:02.79,0:07:05.11,Caption,,0,0,0,,ЗА ЭТИМИ СЛОВАМИ СТОЯТ НЕМЕЦКИЕ ОПРОСЫ
Dialogue: 0,0:07:05.11,0:07:07.57,Caption,,0,0,0,,И ИЗБИРАТЕЛЬ, КОТОРЫЙ ПЕРЕСЧИТЫВАЕТ СЕМЕЙНЫЕ
Dialogue: 0,0:07:07.57,0:07:09.87,Caption,,0,0,0,,РАСХОДЫ, ВИДИТ СОСТОЯНИЕ ЭКОНОМИКИ И
Dialogue: 0,0:07:09.87,0:07:13.04,Caption,,0,0,0,,СПРАШИВАЕТ, ПОЧЕМУ БЕРЛИН ТРЕБУЕТ ОТ ВСЕЙ ЕВРОПЫ
Dialogue: 0,0:07:13.04,0:07:16.54,Caption,,0,0,0,,ПРОДОЛЖАТЬ КУРС, КОТОРОМУ ДОМА ДОВЕРЯЮТ ВСЁ МЕНЬШЕ.
Dialogue: 0,0:07:16.54,0:07:19.03,Caption,,0,0,0,,ОДНАКО ЗАРАНЕЕ ОБЪЯВЛЯТЬ ВАЙДЕЛЬ ЧЕЛОВЕКОМ,
Dialogue: 0,0:07:19.19,0:07:21.01,Caption,,0,0,0,,КОТОРЫЙ ОДНИМ ДВИЖЕНИЕМ РАЗВЕРНЕТ
Dialogue: 0,0:07:21.01,0:07:26.35,Caption,,0,0,0,,ГОСУДАРСТВО, НЕ СТОИТ. ПАРТИИ ВЫИГРЫВАЮТ ВЫБОРЫ,
Dialogue: 0,0:07:26.51,0:07:29.39,Caption,,0,0,0,,А ГОСУДАРСТВЕННАЯ МАШИНА ПЕРЕРАБАТЫВАЕТ ОБЕЩАНИЯ.
Dialogue: 0,0:07:29.71,0:07:32.03,Caption,,0,0,0,,СНАЧАЛА АДГ ДОЛЖНА ПОЛУЧИТЬ ВЛАСТЬ.
Dialogue: 0,0:07:32.03,0:07:35.30,Caption,,0,0,0,,ПОТОМ СТАНЕТ ВИДНО, СКОЛЬКО ПРЕДВЫБОРНОЙ РЕШИТЕЛЬНОСТИ
Dialogue: 0,0:07:35.30,0:07:37.15,Caption,,0,0,0,,ВЫДЕРЖИТ ВСТРЕЧУ С МИНИСТЕРСТВАМИ,
Dialogue: 0,0:07:37.31,0:07:41.65,Caption,,0,0,0,,СОЮЗНИКАМИ И ОБЯЗАТЕЛЬСТВАМИ. В АВСТРИИ ТЕМ ВРЕМЕНЕМ РЕШИЛИ НЕ
Dialogue: 0,0:07:41.65,0:07:45.35,Caption,,0,0,0,,ОГРАНИЧИВАТЬСЯ РАЗГОВОРОМ О ПРЕКРАЩЕНИИ ПОМОЩИ. ЛИДЕР
Dialogue: 0,0:07:45.35,0:07:48.54,Caption,,0,0,0,,FPО ГЕРБЕРТ КИКЛЬ ПРЕДЛОЖИЛ ПОСЛЕ ВОЙНЫ ПЕРЕСЕЛЯТЬ
Dialogue: 0,0:07:48.54,0:07:50.51,Caption,,0,0,0,,НА УКРАИНУ СИРИЙЦЕВ И АФГАНЦЕВ,
Dialogue: 0,0:07:50.79,0:07:52.77,Caption,,0,0,0,,КОТОРЫХ ЕВРОПЕЙСКИЕ ГОСУДАРСТВА НЕ
Dialogue: 0,0:07:52.77,0:07:55.45,Caption,,0,0,0,,СПОСОБНЫ ОТПРАВИТЬ НА РОДИНУ. РАСЧЁТ У КИКЛЯ
Dialogue: 0,0:07:55.45,0:07:58.44,Caption,,0,0,0,,ПРОСТОЙ. ЕВРОСОЮЗ ВЛОЖИЛ В УКРАИНУ СОТНИ
Dialogue: 0,0:07:58.44,0:08:01.39,Caption,,0,0,0,,МИЛЛИАРДОВ. АВСТРИЙСКАЯ ДОЛЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:08:01.55,0:08:03.64,Caption,,0,0,0,,СОСТАВЛЯЕТ ТРИ МИЛЛИАРДА ШЕСТЬСОТ
Dialogue: 0,0:08:03.64,0:08:05.39,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО. СЛЕДОВАТЕЛЬНО,
Dialogue: 0,0:08:05.71,0:08:08.03,Caption,,0,0,0,,ПОСЛЕ ПРЕКРАЩЕНИЯ СТРЕЛЬБЫ ВЕНА МОЖЕТ
Dialogue: 0,0:08:08.03,0:08:11.37,Caption,,0,0,0,,ПОПРОСИТЬ КИЕВ ОБ ОТВЕТНОЙ УСЛУГЕ. ФОРМУЛИРОВКА КИКЛЯ
Dialogue: 0,0:08:11.37,0:08:14.29,Caption,,0,0,0,,ПРЕКРАСНА СВОЁЙ ОТКРОВЕННОСТЬЮ УКРАИНА НАМ КОЕ
Dialogue: 0,0:08:14.29,0:08:17.47,Caption,,0,0,0,,ЧЕМ ОБЯЗАНА. КИКЛЬ ПРЕДЛАГАЕТ НАПРАВЛЯТЬ НА УКРАИНУ
Dialogue: 0,0:08:17.47,0:08:20.05,Caption,,0,0,0,,ЛЮДЕЙ, КОТОРЫХ НЕ УДАЕТСЯ ВЕРНУТЬ В СИРИЮ И
Dialogue: 0,0:08:20.05,0:08:23.31,Caption,,0,0,0,,АФГАНИСТАН. ДО УКРАИНЫ БЛИЖЕ, ЧЕМ ДО РУАНДЫ,
Dialogue: 0,0:08:23.55,0:08:26.27,Caption,,0,0,0,,ПЕРЕВОЗКУ МОЖНО ОРГАНИЗОВАТЬ АВТОБУСАМИ И ПОЕЗДАМИ,
Dialogue: 0,0:08:26.44,0:08:28.45,Caption,,0,0,0,,А РАСХОДЫ БУДУТ НИЖЕ. ВОТ И ВСЯ
Dialogue: 0,0:08:28.45,0:08:31.32,Caption,,0,0,0,,ГУМАНИТАРНАЯ ФИЛОСОФИЯ БИЛЕТ В ОДИН КОНЕЦ И
Dialogue: 0,0:08:31.32,0:08:34.91,Caption,,0,0,0,,КАЛЬКУЛЯТОР. ЭТУ СХЕМУ ОН НАЗЫВАЕТ ВЫИГРЫШНОЙ ДЛЯ ВСЕХ.
Dialogue: 0,0:08:34.91,0:08:37.63,Caption,,0,0,0,,ПЕРЕСЕЛЕНЦЫ СМОГУТ УЧАСТВОВАТЬ В ВОССТАНОВЛЕНИИ
Dialogue: 0,0:08:37.63,0:08:42.16,Caption,,0,0,0,,СТРАНЫ. ЕВРОПЕ НЕКУДА ДЕТЬ МИГРАНТОВ,
Dialogue: 0,0:08:42.31,0:08:44.91,Caption,,0,0,0,,А УКРАИНЕ НУЖНЫ РАБОЧИЕ РУКИ. КИЕВ В
Dialogue: 0,0:08:44.91,0:08:47.12,Caption,,0,0,0,,ЭТОЙ КОНСТРУКЦИИ ПРЕВРАЩАЕТСЯ В МЕСТО,
Dialogue: 0,0:08:47.36,0:08:49.27,Caption,,0,0,0,,КУДА ЕВРОПА СОБИРАЕТСЯ УБРАТЬ ВСЁ
Dialogue: 0,0:08:49.27,0:08:51.36,Caption,,0,0,0,,НЕУДОБНОЕ. ЖУРНАЛИСТЫ СПРОСИЛИ,
Dialogue: 0,0:08:51.53,0:08:54.64,Caption,,0,0,0,,ЧТО ПРОИЗОЙДЕТ, ЕСЛИ ПЕРЕСЕЛЕННЫЕ ЛЮДИ НЕ ЗАХОТЯТ
Dialogue: 0,0:08:54.64,0:08:59.08,Caption,,0,0,0,,ОСТАВАТЬСЯ НА УКРАИНЕ. ОТВЕТ КИКЛЯ ОКАЗАЛСЯ ЕЩЁ ВЫРАЗИТЕЛЬНЕЕ
Dialogue: 0,0:08:59.08,0:09:01.28,Caption,,0,0,0,,ИДЕИ. УЕХАТЬ ОНИ СМОГУТ В ЛЮБОЕ ВРЕМЯ,
Dialogue: 0,0:09:01.52,0:09:04.08,Caption,,0,0,0,,ТОЛЬКО НЕ ОБРАТНО В АВСТРИЮ. ПРОИГРЫШ
Dialogue: 0,0:09:04.08,0:09:06.43,Caption,,0,0,0,,ЗАРАНЕЕ ВЫНОСЯТ ЗА АВСТРИЙСКУЮ ГРАНИЦУ.
Dialogue: 0,0:09:06.43,0:09:09.88,Caption,,0,0,0,,АВСТРИЙСКАЯ СОЦИАЛ ДЕМОКРАТИЧЕСКАЯ ПАРТИЯ ВОЗМУТИЛАСЬ. ЕЁ
Dialogue: 0,0:09:09.88,0:09:13.04,Caption,,0,0,0,,ГЕНЕРАЛЬНЫЙ СЕКРЕТАРЬ КЛАУС ЗЕЛЬТЕНХАЙМ ЗАЯВИЛ,
Dialogue: 0,0:09:13.20,0:09:16.64,Caption,,0,0,0,,ЧТО ЕВРОПЕ ДОЛЖНА РОССИЯ, ПОСКОЛЬКУ ПУТИН НАЧАЛ ВОЙНУ,
Dialogue: 0,0:09:16.88,0:09:18.82,Caption,,0,0,0,,А ПОДОРОЖАНИЕ ЭНЕРГИИ УДАРИЛО ПО
Dialogue: 0,0:09:18.82,0:09:21.52,Caption,,0,0,0,,КОШЕЛЬКАМ АВСТРИЙЦЕВ. ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:09:21.74,0:09:23.64,Caption,,0,0,0,,КИКЛЬ ВЫСТАВЛЯЕТ СЧЁТ ПОСТРАДАВШЕЙ
Dialogue: 0,0:09:23.64,0:09:25.60,Caption,,0,0,0,,СТОРОНЕ, ОСВОБОЖДАЯ ВИНОВНИКА,
Dialogue: 0,0:09:25.83,0:09:27.86,Caption,,0,0,0,,А ПОЛЬЗУ ПОЛУЧИТ ТОЛЬКО РОССИЙСКИЙ
Dialogue: 0,0:09:27.86,0:09:30.88,Caption,,0,0,0,,ПРЕЗИДЕНТ. НО ВАЖНЕЕ ПАРТИЙНОЙ ПЕРЕПАЛКИ САМ ФАКТ
Dialogue: 0,0:09:30.88,0:09:33.84,Caption,,0,0,0,,ПОЯВЛЕНИЯ ТАКОЙ ИДЕИ. ЕВРОПЕЙСКИЙ ЛИДЕР ОТКРЫТО
Dialogue: 0,0:09:33.84,0:09:36.82,Caption,,0,0,0,,РАССМАТРИВАЕТ ПОМОЩЬ КИЕВУ КАК ОСНОВАНИЕ БУДУЩИХ
Dialogue: 0,0:09:36.82,0:09:39.36,Caption,,0,0,0,,ТРЕБОВАНИЙ. АВТОБУСЫ МОГУТ НИКУДА НЕ ПОЕХАТЬ,
Dialogue: 0,0:09:39.59,0:09:42.24,Caption,,0,0,0,,ПРОЕКТ МОЖЕТ ИСЧЕЗНУТЬ ПОСЛЕ КОАЛИЦИОННОЙ ВСТРЕЧИ.
Dialogue: 0,0:09:42.45,0:09:44.56,Caption,,0,0,0,,ПРИНЦИП ОСТАНЕТСЯ МЫ ЗАПЛАТИЛИ,
Dialogue: 0,0:09:44.64,0:09:48.71,Caption,,0,0,0,,ТЕПЕРЬ ВЫ ДОЛЖНЫ. НА САММИТЕ ОБСУЖДАЛИ РАСХОДЫ ЕВРОСОЮЗА
Dialogue: 0,0:09:48.71,0:09:50.78,Caption,,0,0,0,,С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ ТЫСЯЧИ
Dialogue: 0,0:09:50.78,0:09:55.40,Caption,,0,0,0,,ТРИДЦАТЬ ЧЕТВЕРТЫЙ ГОД. POLITICO СООБЩАЕТ,
Dialogue: 0,0:09:55.64,0:09:57.72,Caption,,0,0,0,,ЧТО ЧЕТЫРЕ ГОСУДАРСТВА ИЗ СЕМИ,
Dialogue: 0,0:09:57.87,0:09:59.80,Caption,,0,0,0,,ДОБИВАВШИХСЯ СОКРАЩЕНИЯ БЮДЖЕТА,
Dialogue: 0,0:10:00.04,0:10:01.93,Caption,,0,0,0,,ОТКАЗАЛИСЬ ПРОДОЛЖАТЬ ОБСУЖДЕНИЕ В
Dialogue: 0,0:10:01.93,0:10:04.84,Caption,,0,0,0,,НЕБОЛЬШИХ ГРУППАХ. ФОРМАТ СДЕЛАЛИ КАМЕРНЕЕ,
Dialogue: 0,0:10:05.00,0:10:09.21,Caption,,0,0,0,,НО СОГЛАСИЯ НЕ ПРИБАВИЛОСЬ. ОТДЕЛЬНЫЙ КРЕДИТ УКРАИНЕ ПОДДЕРЖИВАЕТ
Dialogue: 0,0:10:09.21,0:10:12.38,Caption,,0,0,0,,БОЛЬШИНСТВО. ВЫДЕЛИТЬ ДОПОЛНИТЕЛЬНЫЕ СОРОК ПЯТЬ
Dialogue: 0,0:10:12.38,0:10:15.12,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД
Dialogue: 0,0:10:15.12,0:10:18.44,Caption,,0,0,0,,ГОТОВЫ ДВАДЦАТЬ ЧЕТЫРЕ ГОСУДАРСТВА ИЗ ДВАДЦАТИ СЕМИ.
Dialogue: 0,0:10:18.44,0:10:20.68,Caption,,0,0,0,,БОЛГАРИЯ СОГЛАСНА ФИНАНСИРОВАТЬ ТОЛЬКО
Dialogue: 0,0:10:20.68,0:10:23.59,Caption,,0,0,0,,ГРАЖДАНСКОЕ НАПРАВЛЕНИЕ. ДАЖЕ ПРИ ТАКОМ РАСКЛАДЕ
Dialogue: 0,0:10:23.59,0:10:27.64,Caption,,0,0,0,,РЕШЕНИЕ ПЕРЕНЕСЛИ НА ДЕКАБРЬ. БАБИШ ОБЪЯСНЯЕТ ЧЕШСКИМ ИЗБИРАТЕЛЯМ,
Dialogue: 0,0:10:27.86,0:10:30.60,Caption,,0,0,0,,ЧТО СТРАНЕ НУЖНЫ БОЛЬНИЦЫ И АВТОМАГИСТРАЛЬ ДО
Dialogue: 0,0:10:30.60,0:10:32.96,Caption,,0,0,0,,АВСТРИИ. ФРАНЦИЯ ДЕРЖИТСЯ ЗА ВЫПЛАТЫ
Dialogue: 0,0:10:32.96,0:10:35.32,Caption,,0,0,0,,ФЕРМЕРАМ. ЭММАНУЭЛЬ МАКРОН ПОНИМАЕТ,
Dialogue: 0,0:10:35.56,0:10:38.44,Caption,,0,0,0,,ЧТО ПОСЛЕ ДЕКАБРЯ ПРИБЛИЖЕНИЕ ПРЕЗИДЕНТСКОЙ КАМПАНИИ
Dialogue: 0,0:10:38.44,0:10:40.51,Caption,,0,0,0,,СОКРАТИТ ПРОСТРАНСТВО ДЛЯ УСТУПОК.
Dialogue: 0,0:10:40.51,0:10:43.16,Caption,,0,0,0,,ФРАНЦУЗСКОМУ КАНДИДАТУ ТРУДНО ОБЪЯСНИТЬ ФЕРМЕРУ,
Dialogue: 0,0:10:43.34,0:10:45.17,Caption,,0,0,0,,ПОЧЕМУ ОН ДОЛЖЕН ПОДОЖДАТЬ ИЗ ЗА
Dialogue: 0,0:10:45.17,0:10:48.39,Caption,,0,0,0,,ОЧЕРЕДНЫХ РАСХОДОВ БРЮССЕЛЯ. ОППОЗИЦИИ ДОСТАТОЧНО ЗАДАТЬ
Dialogue: 0,0:10:48.39,0:10:51.53,Caption,,0,0,0,,ПРАВИТЕЛЬСТВУ ДВА ВОПРОСА. СКОЛЬКО ВЫ ПООБЕЩАЛИ
Dialogue: 0,0:10:51.53,0:10:54.03,Caption,,0,0,0,,КИЕВУ? ЧТО ПОЛУЧИЛИ ВЗАМЕН СОБСТВЕННЫЕ
Dialogue: 0,0:10:54.03,0:10:56.58,Caption,,0,0,0,,ГРАЖДАНЕ? МИНИСТРЫ МОГУТ РАССКАЗЫВАТЬ О
Dialogue: 0,0:10:56.58,0:10:59.40,Caption,,0,0,0,,СТРАТЕГИИ, НО ИЗБИРАТЕЛЬ ПОСМОТРИТ НА ДОРОГУ,
Dialogue: 0,0:10:59.48,0:11:01.64,Caption,,0,0,0,,СЧЁТ ИЗ БОЛЬНИЦЫ И РАЗМЕР НАЛОГА.
Dialogue: 0,0:11:03.91,0:11:05.70,Caption,,0,0,0,,ПОЭТОМУ ТЕМА УКРАИНЫ ВХОДИТ ВО
Dialogue: 0,0:11:05.70,0:11:08.72,Caption,,0,0,0,,ВНУТРЕННЮЮ БОРЬБУ ЗАДОЛГО ДО ПРИХОДА К ВЛАСТИ АДГ,
Dialogue: 0,0:11:09.19,0:11:11.52,Caption,,0,0,0,,FPО ИЛИ ДРУГОЙ НЕУДОБНОЙ ПАРТИИ.
Dialogue: 0,0:11:12.16,0:11:15.79,Caption,,0,0,0,,ПРОБЛЕМЫ КИЕВА НАЧИНАЮТСЯ, КОГДА ДЕЙСТВУЮЩИЕ ПРАВИТЕЛЬСТВА
Dialogue: 0,0:11:15.79,0:11:18.75,Caption,,0,0,0,,ПОДСЧИТЫВАЮТ, КАКУЮ ВНЕШНЮЮ ТРАТУ ЕЩЁ ПРИМЕТ ИХ
Dialogue: 0,0:11:18.75,0:11:23.41,Caption,,0,0,0,,ИЗБИРАТЕЛЬ. POLITICO ПИШЕТ, ЧТО ПОЗИЦИИ ВАШИНГТОНА И ЕВРОПЫ ПО
Dialogue: 0,0:11:23.41,0:11:26.21,Caption,,0,0,0,,УКРАИНЕ РАСХОДЯТСЯ ВСЁ СИЛЬНЕЕ. ТРАМП ОБВИНЯЕТ
Dialogue: 0,0:11:26.21,0:11:27.92,Caption,,0,0,0,,ЕВРОПЕЙЦЕВ И ЗЕЛЕНСКОГО В ТОМ,
Dialogue: 0,0:11:28.22,0:11:32.19,Caption,,0,0,0,,ЧТО НА ВОЙНУ УШЛИ МИЛЛИАРДЫ, А ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ ОБСУЖДАЮТ
Dialogue: 0,0:11:32.19,0:11:35.13,Caption,,0,0,0,,ДЛЯ КИЕВА НОВЫЕ ДЕСЯТКИ МИЛЛИАРДОВ. ОДИН СЧИТАЕТ
Dialogue: 0,0:11:35.13,0:11:38.68,Caption,,0,0,0,,ПОТРАЧЕННОЕ, ДРУГИЕ ИЩУТ СЛЕДУЮЩУЮ СУММУ. СЕМЕЙНЫЙ
Dialogue: 0,0:11:38.68,0:11:41.21,Caption,,0,0,0,,БЮДЖЕТ ТАК ОБЫЧНО ОБСУЖДАЮТ ПЕРЕД ГРОМКИМ
Dialogue: 0,0:11:41.21,0:11:44.38,Caption,,0,0,0,,РАЗВОДОМ. ОСОБЕННО ПОКАЗАТЕЛЬНО ОБЪЯСНЕНИЕ ЕВРОПЕЙСКОГО
Dialogue: 0,0:11:44.38,0:11:47.68,Caption,,0,0,0,,ДИПЛОМАТА. ПО ЕГО СЛОВАМ, ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ТОГО,
Dialogue: 0,0:11:47.76,0:11:50.48,Caption,,0,0,0,,ЧЕГО ЕВРОПА ОПАСАЛАСЬ ПОСЛЕ ВОЗВРАЩЕНИЯ ТРАМПА,
Dialogue: 0,0:11:50.70,0:11:53.92,Caption,,0,0,0,,УЖЕ СЛУЧИЛАСЬ. СУЩЕСТВЕННОЙ АМЕРИКАНСКОЙ ПОДДЕРЖКИ
Dialogue: 0,0:11:53.92,0:11:56.39,Caption,,0,0,0,,УКРАИНЫ НЕТ. ЕВРОСОЮЗ СОГЛАСИЛСЯ НА
Dialogue: 0,0:11:56.39,0:11:59.80,Caption,,0,0,0,,ТОРГОВУЮ СДЕЛКУ, КОТОРУЮ МНОГИЕ ЕВРОПЕЙЦЫ СЧИТАЮТ
Dialogue: 0,0:11:59.80,0:12:02.88,Caption,,0,0,0,,НЕРАВНОЙ. ДАВЛЕНИЕ ВАШИНГТОНА СОХРАНИЛОСЬ. ОТСЮДА
Dialogue: 0,0:12:02.88,0:12:05.04,Caption,,0,0,0,,РОЖДАЕТСЯ ВОПРОС ЧТО НАМ ТЕПЕРЬ ТЕРЯТЬ?
Dialogue: 0,0:12:05.46,0:12:07.28,Caption,,0,0,0,,УКРАИНА СТАНОВИТСЯ ЧАСТЬЮ БОЛЕЕ
Dialogue: 0,0:12:07.28,0:12:10.50,Caption,,0,0,0,,КРУПНОГО ТОРГА. ЕВРОСОЮЗ ХОЧЕТ ВВОДИТЬ ЦИФРОВЫЕ
Dialogue: 0,0:12:10.50,0:12:12.90,Caption,,0,0,0,,НАЛОГИ, ПРОТИВ КОТОРЫХ ВЫСТУПАЮТ СОЕДИНЕННЫЕ
Dialogue: 0,0:12:12.90,0:12:15.47,Caption,,0,0,0,,ШТАТЫ. ЕВРОПЕЙЦЫ ТРЕБУЮТ ПРЕИМУЩЕСТВ ДЛЯ
Dialogue: 0,0:12:15.47,0:12:17.18,Caption,,0,0,0,,СВОИХ ПРОИЗВОДИТЕЛЕЙ ПРИ ЗАКУПКАХ
Dialogue: 0,0:12:17.18,0:12:22.18,Caption,,0,0,0,,ВООРУЖЕНИЯ. ВАШИНГТОН ДАВИТ В ТОРГОВЫХ ВОПРОСАХ.
Dialogue: 0,0:12:22.18,0:12:24.36,Caption,,0,0,0,,ЗА ОДНИМ СТОЛОМ ЛЕЖАТ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:12:24.44,0:12:27.72,Caption,,0,0,0,,НАЛОГИ, КОНТРАКТЫ И УКРАИНСКОЕ ФИНАНСИРОВАНИЕ.
Dialogue: 0,0:12:28.27,0:12:30.00,Caption,,0,0,0,,ЕВРОПА МЕНЬШЕ БОИТСЯ СПОРИТЬ С
Dialogue: 0,0:12:30.00,0:12:33.10,Caption,,0,0,0,,АМЕРИКОЙ, НО ОХОТНО РУГАЕТСЯ ВНУТРИ СОБСТВЕННОГО
Dialogue: 0,0:12:33.10,0:12:36.07,Caption,,0,0,0,,СОЮЗА. ГЕРМАНИЯ ТРЕБУЕТ ПЛАТЕЖЕЙ ОТ ВСЕХ.
Dialogue: 0,0:12:36.07,0:12:38.99,Caption,,0,0,0,,НЕСОГЛАСНЫМ ПОКАЗЫВАЮТ БЮДЖЕТНЫЙ РЫЧАГ. ЧЕХИЯ
Dialogue: 0,0:12:38.99,0:12:42.63,Caption,,0,0,0,,НАПОМИНАЕТ О БОЛЬНИЦАХ И ДОРОГАХ. ФРАНЦИЯ ЗАЩИЩАЕТ
Dialogue: 0,0:12:42.63,0:12:44.68,Caption,,0,0,0,,ФЕРМЕРОВ. В АВСТРИИ ПРИДУМЫВАЮТ,
Dialogue: 0,0:12:44.84,0:12:46.94,Caption,,0,0,0,,КАКИМИ УСЛУГАМИ КИЕВ МОГ БЫ ВЕРНУТЬ
Dialogue: 0,0:12:46.94,0:12:49.32,Caption,,0,0,0,,ВЛОЖЕНИЯ. НЕМЕЦКИЙ ИЗБИРАТЕЛЬ СПРАШИВАЕТ,
Dialogue: 0,0:12:49.53,0:12:52.11,Caption,,0,0,0,,ПОЧЕМУ ОПЛАЧИВАТЬ ЭТО ДОЛЖЕН ОН. СПОР
Dialogue: 0,0:12:52.11,0:12:54.14,Caption,,0,0,0,,ИДЁТ НЕ ТОЛЬКО О ЧИСЛЕ СТОРОННИКОВ И
Dialogue: 0,0:12:54.14,0:12:56.36,Caption,,0,0,0,,ПРОТИВНИКОВ УКРАИНЫ. РЕШАЕТСЯ,
Dialogue: 0,0:12:56.52,0:12:58.84,Caption,,0,0,0,,КТО СМОЖЕТ ГОВОРИТЬ ОТ ИМЕНИ НЕСОГЛАСНЫХ,
Dialogue: 0,0:12:59.08,0:13:00.96,Caption,,0,0,0,,ЛИШАТЬ ИХ ФИНАНСОВ И ОБЪЯВЛЯТЬ
Dialogue: 0,0:13:00.96,0:13:04.44,Caption,,0,0,0,,ПРАВИЛЬНЫМ РЕЗУЛЬТАТ, КОТОРОГО НЕ УДАЛОСЬ ДОБИТЬСЯ ОБЩИМ
Dialogue: 0,0:13:04.44,0:13:07.46,Caption,,0,0,0,,СОГЛАСИЕМ. ЕСЛИ ТРЕБОВАНИЯ К УКРАИНЕ НАЧАЛИ ВЫПИСЫВАТЬ
Dialogue: 0,0:13:07.46,0:13:10.94,Caption,,0,0,0,,ЕЩЁ ДО ЗАВЕРШЕНИЯ ВОЙНЫ, БУДУЩИЙ ПЕРЕЧЕНЬ ОБЕЩАЕТ БЫТЬ
Dialogue: 0,0:13:10.94,0:13:13.56,Caption,,0,0,0,,ВНУШИТЕЛЬНЫМ. ТАМ НАЙДЁТСЯ МЕСТО ДЕНЬГАМ,
Dialogue: 0,0:13:13.64,0:13:16.28,Caption,,0,0,0,,МИГРАНТАМ, ТОРГОВЫМ УСТУПКАМ И ВСЕМУ,
Dialogue: 0,0:13:16.51,0:13:18.10,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКИМ ПРАВИТЕЛЬСТВАМ
Dialogue: 0,0:13:18.10,0:13:21.40,Caption,,0,0,0,,ОКАЖЕТСЯ НЕУДОБНО ОСТАВЛЯТЬ У СЕБЯ. ТОГДА И ВЫЯСНИТСЯ,
Dialogue: 0,0:13:21.57,0:13:23.95,Caption,,0,0,0,,ЧТО ИМЕННО ЕВРОПА ОТПРАВЛЯЛА КИЕВУ ВСЕ
Dialogue: 0,0:13:23.95,0:13:26.60,Caption,,0,0,0,,ЭТИ ГОДЫ. ПОМОЩЬ БЕЗ УСЛОВИЙ ИЛИ СЧЁТ,
Dialogue: 0,0:13:26.81,0:13:28.69,Caption,,0,0,0,,НА КОТОРОМ ПРОСТО ПОКА НЕ НАПЕЧАТАЛИ
Dialogue: 0,0:13:28.69,0:13:29.64,Caption,,0,0,0,,СТРОКУ "К ОПЛАТЕ".
