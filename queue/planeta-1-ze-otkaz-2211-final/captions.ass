Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ПРЕДСТАВЬТЕ ПОКУПАТЕЛЯ, КОТОРОМУ ТРИЖДЫ СКАЗАЛИ,
Dialogue: 0,0:00:03.16,0:00:05.40,Caption,,0,0,0,,ЧТО ТОВАР НЕ ПРОДАЁТСЯ. ОН КИВАЕТ,
Dialogue: 0,0:00:05.55,0:00:08.76,Caption,,0,0,0,,ВЫХОДИТ, А ЧЕРЕЗ МИНУТУ ВОЗВРАЩАЕТСЯ И ПРОСИТ ТОТ ЖЕ
Dialogue: 0,0:00:08.84,0:00:11.32,Caption,,0,0,0,,ТОВАР С ДОСТАВКОЙ И ГАРАНТИЕЙ. ЭТО УЖЕ НЕ
Dialogue: 0,0:00:11.32,0:00:13.96,Caption,,0,0,0,,УПОРСТВО. ЛИБО ЧЕЛОВЕК НЕ СЛЫШИТ ОТВЕТ,
Dialogue: 0,0:00:14.20,0:00:17.24,Caption,,0,0,0,,ЛИБО ОТКАЗ ЕГО УСТРАИВАЕТ. В ПЕРЕГОВОРАХ ПРОИСХОДИТ
Dialogue: 0,0:00:17.32,0:00:20.44,Caption,,0,0,0,,ТО ЖЕ САМОЕ, ТОЛЬКО ВМЕСТО УПАКОВКИ ТРЕБУЮТ БАЗЫ,
Dialogue: 0,0:00:20.59,0:00:23.72,Caption,,0,0,0,,ВОЙСКА И ДЕСЯТКИ МИЛЛИАРДОВ. ЕСЛИ ВАМ НРАВЯТСЯ
Dialogue: 0,0:00:23.72,0:00:26.92,Caption,,0,0,0,,РАЗБОРЫ, ГДЕ ЗАЯВЛЕНИЯ СВЕРЯЮТ С ПРОИСХОДЯЩИМ НА ДЕЛЕ,
Dialogue: 0,0:00:27.16,0:00:31.96,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ВАШИНГТОН СПЕШИТ ЗАВЕРШИТЬ СОГЛАШЕНИЕ ДО ЯНВАРЯ.
Dialogue: 0,0:00:32.12,0:00:34.68,Caption,,0,0,0,,АДМИНИСТРАЦИИ ТРАМПА НУЖЕН РЕЗУЛЬТАТ ПРЕЖДЕ,
Dialogue: 0,0:00:34.92,0:00:37.64,Caption,,0,0,0,,ЧЕМ ОБНОВЛЁННЫЙ КОНГРЕСС ЗАРАБОТАЕТ В ПОЛНУЮ СИЛУ.
Dialogue: 0,0:00:38.12,0:00:39.96,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ТОЖЕ СМОТРИТ НА ЧАСЫ,
Dialogue: 0,0:00:40.12,0:00:42.28,Caption,,0,0,0,,НО ВИДИТ ДРУГОЕ ВРЕМЯ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:42.56,0:00:44.52,Caption,,0,0,0,,ПОСЛЕ ЗИМЫ ПРИДЁТ НЕ ТОЛЬКО ВЕСНА,
Dialogue: 0,0:00:44.60,0:00:47.32,Caption,,0,0,0,,НО И КОНГРЕСС. В ЭТОЙ РЕПЛИКЕ ВЕСЬ РАСЧЁТ
Dialogue: 0,0:00:47.40,0:00:49.96,Caption,,0,0,0,,КИЕВА. У ДЕМОКРАТОВ СТАНЕТ БОЛЬШЕ ВОЗМОЖНОСТЕЙ
Dialogue: 0,0:00:49.96,0:00:53.96,Caption,,0,0,0,,ДАВИТЬ НА БЕЛЫЙ ДОМ, ТРЕБОВАТЬ ОБЪЯСНЕНИЙ ПО ДОГОВОРЁННОСТЯМ С МОСКВОЙ,
Dialogue: 0,0:00:54.12,0:00:56.92,Caption,,0,0,0,,ПРОДВИГАТЬ ПОМОЩЬ УКРАИНЕ И МЕШАТЬ РЕШЕНИЯМ ТРАМПА.
Dialogue: 0,0:00:57.56,0:01:00.04,Caption,,0,0,0,,ПРЕЗИДЕНТ ХОЧЕТ УСПЕТЬ ДО ПЕРЕСТАНОВКИ СИЛ.
Dialogue: 0,0:01:00.40,0:01:03.24,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НАДЕЕТСЯ ЕЁ ДОЖДАТЬСЯ И ПОЛУЧИТЬ ЛУЧШИЕ
Dialogue: 0,0:01:03.32,0:01:06.20,Caption,,0,0,0,,УСЛОВИЯ. ЖДАТЬ МОЖНО. ТОЛЬКО СЧЁТ ЗА ОЖИДАНИЕ
Dialogue: 0,0:01:06.20,0:01:10.76,Caption,,0,0,0,,ВЫПИСЫВАЮТ НЕ ТОМУ, КТО РЕШИЛ ПОСИДЕТЬ ЕЩЁ НЕСКОЛЬКО МЕСЯЦЕВ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:01:10.76,0:01:12.68,Caption,,0,0,0,,САМ ПРЕДУПРЕЖДАЕТ О ТЯЖЁЛОЙ ЗИМЕ.
Dialogue: 0,0:01:14.96,0:01:17.68,Caption,,0,0,0,,УКРАИНСКАЯ ЭКОНОМИКА ДЕРЖИТСЯ НА ВНЕШНИХ ВЛИВАНИЯХ.
Dialogue: 0,0:01:17.84,0:01:22.48,Caption,,0,0,0,,УДАРЫ НЕ ПРЕКРАЩАЮТСЯ, ПОВРЕЖДЕНИЙ ИНФРАСТРУКТУРЫ ВСЁ БОЛЬШЕ. НО СТАВКА
Dialogue: 0,0:01:22.48,0:01:26.96,Caption,,0,0,0,,ДЕЛАЕТСЯ НА ВЕСНУ, КОГДА ПОЛОЖЕНИЕ ЯКОБЫ СТАНЕТ УДОБНЕЕ ДЛЯ КИЕВА. А
Dialogue: 0,0:01:26.96,0:01:29.92,Caption,,0,0,0,,ЕСЛИ НЕ СТАНЕТ? ФРАЗА О КОНГРЕССЕ ЗВУЧИТ БОДРО.
Dialogue: 0,0:01:30.48,0:01:32.40,Caption,,0,0,0,,ТОЛЬКО ЗИМУ ПЕРЕЖИВАЕТ НЕ ФРАЗА,
Dialogue: 0,0:01:32.71,0:01:36.00,Caption,,0,0,0,,И СЧЕТА ОПЛАЧИВАЕТ НЕ КАЛЕНДАРЬ. ТЕПЕРЬ О ГАРАНТИЯХ
Dialogue: 0,0:01:36.00,0:01:40.00,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ВОКРУГ КОТОРЫХ РАЗВЕРНУЛСЯ ТОРГ. ДЖАРЕД КУШНЕР
Dialogue: 0,0:01:40.00,0:01:42.80,Caption,,0,0,0,,СООБЩИЛ О ПРОДВИЖЕНИИ В ОБСУЖДЕНИИ КОНСТРУКЦИИ,
Dialogue: 0,0:01:42.90,0:01:45.68,Caption,,0,0,0,,БЛИЗКОЙ К ПЯТОЙ СТАТЬЕ НАТО. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:01:45.92,0:01:48.80,Caption,,0,0,0,,МОСКВА НАЧАЛА ВОСПРИНИМАТЬ ТАКУЮ МОДЕЛЬ С БОЛЬШИМ
Dialogue: 0,0:01:48.80,0:01:51.52,Caption,,0,0,0,,ПОНИМАНИЕМ. ОДНОВРЕМЕННО КУШНЕР ПОДЧЁРКИВАЕТ,
Dialogue: 0,0:01:51.76,0:01:55.20,Caption,,0,0,0,,ЧТО ДЛЯ США ЭТО ЧРЕЗВЫЧАЙНО СЕРЬЁЗНОЕ РЕШЕНИЕ. ОНО
Dialogue: 0,0:01:55.28,0:01:58.32,Caption,,0,0,0,,ДОЛЖНО ОТВЕЧАТЬ АМЕРИКАНСКИМ ИНТЕРЕСАМ И ВОЙТИ В
Dialogue: 0,0:01:58.40,0:02:01.36,Caption,,0,0,0,,ОБЩИЙ ПАКЕТ ДОГОВОРЁННОСТЕЙ. НА ПЕРВЫЙ ВЗГЛЯД КИЕВ
Dialogue: 0,0:02:01.36,0:02:05.04,Caption,,0,0,0,,ПОЛУЧИЛ ТО, ЧЕГО ТРЕБОВАЛ ГОДАМИ. УКРАИНСКОЕ РУКОВОДСТВО
Dialogue: 0,0:02:05.04,0:02:08.80,Caption,,0,0,0,,ПОСТОЯННО ПОВТОРЯЛО, ЧТО ЕМУ НУЖНЫ ОБЯЗАТЕЛЬСТВА УРОВНЯ НАТО,
Dialogue: 0,0:02:08.99,0:02:11.84,Caption,,0,0,0,,ЧТОБЫ НОВОЕ СТОЛКНОВЕНИЕ АВТОМАТИЧЕСКИ ВКЛЮЧАЛО
Dialogue: 0,0:02:11.84,0:02:14.64,Caption,,0,0,0,,ПОМОЩЬ СОЮЗНИКОВ. ТЕПЕРЬ АМЕРИКАНЦЫ ПРЕДЛАГАЮТ
Dialogue: 0,0:02:14.64,0:02:18.72,Caption,,0,0,0,,ВАРИАНТ, КОТОРЫЙ САМИ СЧИТАЮТ ВЕСЬМА СЕРЬЁЗНЫМ. КАЗАЛОСЬ БЫ,
Dialogue: 0,0:02:18.95,0:02:22.16,Caption,,0,0,0,,МОЖНО РАЗБИРАТЬ ДЕТАЛИ. НО ПРЕЖНЯЯ МЕЧТА УЖЕ
Dialogue: 0,0:02:22.24,0:02:27.79,Caption,,0,0,0,,МАЛОВАТА. В ПОНИМАНИИ ЗЕЛЕНСКОГО НАДЁЖНЫЕ ГАРАНТИИ ОЗНАЧАЮТ
Dialogue: 0,0:02:27.79,0:02:30.43,Caption,,0,0,0,,ПРИСУТСТВИЕ АМЕРИКАНСКИХ И ЕВРОПЕЙСКИХ ВОЕННЫХ НА
Dialogue: 0,0:02:30.43,0:02:35.71,Caption,,0,0,0,,УКРАИНЕ, ИНОСТРАННЫЕ БАЗЫ, ВООРУЖЕНИЕ И ОБЯЗАННОСТЬ ПАРТНЁРОВ ВСТУПИТЬ В
Dialogue: 0,0:02:35.79,0:02:38.83,Caption,,0,0,0,,КОНФЛИКТ НА СТОРОНЕ КИЕВА. НАЧАЛИ С АНАЛОГА ПЯТОЙ
Dialogue: 0,0:02:38.83,0:02:42.91,Caption,,0,0,0,,СТАТЬИ, А ЗАКОНЧИЛИ КВАРТАЛОМ ИНОСТРАННЫХ БАЗ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:02:43.23,0:02:45.23,Caption,,0,0,0,,И К ГАРАНТИЯМ ПРИЛОЖАТ КОМЕНДАНТА,
Dialogue: 0,0:02:45.44,0:02:48.51,Caption,,0,0,0,,ЛИЧНО ПРОВЕРЯЮЩЕГО ЗАМКИ ПЕРЕД СНОМ. ВОЗНИКАЕТ
Dialogue: 0,0:02:48.51,0:02:51.47,Caption,,0,0,0,,ВОПРОС. ЕСЛИ ОБЯЗАТЕЛЬСТВ УРОВНЯ ПЯТОЙ СТАТЬИ
Dialogue: 0,0:02:51.47,0:02:55.07,Caption,,0,0,0,,НЕДОСТАТОЧНО, ЗАЧЕМ СТОЛЬКО ЛЕТ ТРЕБОВАЛИ ВСТУПЛЕНИЯ В НАТО?
Dialogue: 0,0:02:55.48,0:02:59.87,Caption,,0,0,0,,ЧТО СЧИТАЛОСЬ ВЫСШЕЙ ЗАЩИТОЙ, ЕСЛИ ТЕПЕРЬ ЕЁ НУЖНО ДОПОЛНИТЬ ВОЙСКАМИ,
Dialogue: 0,0:03:00.03,0:03:02.51,Caption,,0,0,0,,БАЗАМИ И ПРЯМЫМ УЧАСТИЕМ СОЮЗНИКОВ?
Dialogue: 0,0:03:03.01,0:03:06.19,Caption,,0,0,0,,МОСКВА ОТВЕЧАЕТ БЕЗ ПОЯСНЕНИЙ НЕТ. СЕРГЕЙ РЯБКОВ
Dialogue: 0,0:03:06.19,0:03:09.63,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО ДЛЯ РОССИИ НЕПРИЕМЛЕМО ДАЖЕ КВАЗИЧЛЕНСТВО
Dialogue: 0,0:03:09.63,0:03:12.03,Caption,,0,0,0,,УКРАИНЫ В НАТО. ПРЕДЛАГАЕМАЯ МОДЕЛЬ,
Dialogue: 0,0:03:12.24,0:03:14.59,Caption,,0,0,0,,ПО ОЦЕНКЕ МОСКВЫ, ЗАХОДИТ ЗА ЛИНИЮ,
Dialogue: 0,0:03:14.86,0:03:18.11,Caption,,0,0,0,,ИЗ ЗА КОТОРОЙ СПОР ПРОДОЛЖАЕТСЯ СТОЛЬКО ЛЕТ. ОТВЕТ
Dialogue: 0,0:03:18.11,0:03:20.83,Caption,,0,0,0,,КОРОЧЕ НЕ СДЕЛАТЬ. МОЖНО НАПЕЧАТАТЬ КРУПНЕЕ,
Dialogue: 0,0:03:21.05,0:03:23.39,Caption,,0,0,0,,ХОТЯ И ЭТО, ПОХОЖЕ, НЕ ПОМОЖЕТ.
Dialogue: 0,0:03:24.39,0:03:26.99,Caption,,0,0,0,,У ТРЕБОВАНИЯ ОБ ИНОСТРАННЫХ БАЗАХ ЕСТЬ ЕЩЁ ОДНО
Dialogue: 0,0:03:26.99,0:03:29.23,Caption,,0,0,0,,ПРЕПЯТСТВИЕ, И ОНО НЕ В МОСКВЕ.
Dialogue: 0,0:03:29.86,0:03:33.23,Caption,,0,0,0,,СЕМНАДЦАТАЯ СТАТЬЯ УКРАИНСКОЙ КОНСТИТУЦИИ ЗАПРЕЩАЕТ
Dialogue: 0,0:03:33.23,0:03:36.67,Caption,,0,0,0,,РАЗМЕЩАТЬ В СТРАНЕ ИНОСТРАННЫЕ ВОЕННЫЕ БАЗЫ. СТО
Dialogue: 0,0:03:36.75,0:03:39.39,Caption,,0,0,0,,ПЯТЬДЕСЯТ СЕДЬМАЯ СТАТЬЯ НЕ ПОЗВОЛЯЕТ МЕНЯТЬ
Dialogue: 0,0:03:39.39,0:03:41.63,Caption,,0,0,0,,КОНСТИТУЦИЮ ВО ВРЕМЯ ВОЕННОГО ПОЛОЖЕНИЯ.
Dialogue: 0,0:03:43.91,0:03:47.83,Caption,,0,0,0,,КИЕВ ТРЕБУЕТ ОТ ПАРТНЁРОВ ТО, ДЛЯ ЧЕГО СНАЧАЛА ПРИДЁТСЯ ОТКРЫТЬ ДВЕРЬ,
Dialogue: 0,0:03:47.98,0:03:51.27,Caption,,0,0,0,,ЗАПЕРТУЮ СОБСТВЕННЫМ ОСНОВНЫМ ЗАКОНОМ. КЛЮЧА НЕТ,
Dialogue: 0,0:03:51.51,0:03:56.31,Caption,,0,0,0,,ЗАМОК ТРОГАТЬ НЕЛЬЗЯ, НО МЕБЕЛЬ ДЛЯ НОВЫХ ЖИЛЬЦОВ УЖЕ ВЫБИРАЮТ. НА
Dialogue: 0,0:03:56.39,0:03:58.95,Caption,,0,0,0,,ЭТОМ ФОНЕ ВЕРСИЯ О ПРОВЕРКЕ ГОТОВНОСТИ КИЕВА К
Dialogue: 0,0:03:58.95,0:04:02.23,Caption,,0,0,0,,КОМПРОМИССУ ВЫГЛЯДИТ ЛОГИЧНО. КУШНЕР МОГ ПРЕДЛОЖИТЬ
Dialogue: 0,0:04:02.23,0:04:03.99,Caption,,0,0,0,,СЕРЬЁЗНЫЙ ВАРИАНТ И ПОСМОТРЕТЬ,
Dialogue: 0,0:04:04.15,0:04:07.11,Caption,,0,0,0,,ПОСЛЕДУЕТ ЛИ ВСТРЕЧНЫЙ ШАГ. ВМЕСТО НЕГО НА СТОЛ
Dialogue: 0,0:04:07.11,0:04:10.23,Caption,,0,0,0,,ПОЛОЖИЛИ НОВЫЕ ТРЕБОВАНИЯ. ПЛАНКА ДВИГАЕТСЯ ВСЯКИЙ
Dialogue: 0,0:04:10.31,0:04:13.35,Caption,,0,0,0,,РАЗ, КОГДА ПЕРЕГОВОРЩИКИ К НЕЙ ПРИБЛИЖАЮТСЯ. ТОЛЬКО
Dialogue: 0,0:04:13.35,0:04:15.59,Caption,,0,0,0,,ДОГОВОРИЛИСЬ, ДО КАКОЙ ВЫСОТЫ ПРЫГАТЬ,
Dialogue: 0,0:04:15.81,0:04:18.71,Caption,,0,0,0,,КАК ЕЁ ПЕРЕСТАВЛЯЮТ ЕЩЁ НА ЭТАЖ ВЫШЕ. УЖЕ
Dialogue: 0,0:04:18.79,0:04:22.55,Caption,,0,0,0,,ЗВУЧАТ ПРЕДПОЛОЖЕНИЯ, ЧТО С НЫНЕШНИМ УКРАИНСКИМ РУКОВОДСТВОМ СОГЛАШЕНИЕ
Dialogue: 0,0:04:22.55,0:04:25.51,Caption,,0,0,0,,НЕВОЗМОЖНО. ТОГДА ПРОДОЛЖАТЬ ПРОЦЕСС ПРИДЁТСЯ С
Dialogue: 0,0:04:25.51,0:04:27.99,Caption,,0,0,0,,ДРУГИМ ПРЕДСТАВИТЕЛЕМ КИЕВА. КОГДА НА КАЖДОЕ
Dialogue: 0,0:04:27.99,0:04:30.15,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ОТВЕЧАЮТ НОВЫМ УСЛОВИЕМ,
Dialogue: 0,0:04:30.46,0:04:32.79,Caption,,0,0,0,,СОМНЕНИЯ КАСАЮТСЯ УЖЕ СПОСОБНОСТИ УЧАСТНИКА
Dialogue: 0,0:04:32.79,0:04:34.71,Caption,,0,0,0,,ПЕРЕГОВОРОВ ОДНАЖДЫ СКАЗАТЬ "СОГЛАСЕН".
Dialogue: 0,0:04:35.67,0:04:37.83,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ ЕВРОПА ЗАНИМАЕТСЯ ПРАКТИЧЕСКОЙ
Dialogue: 0,0:04:37.83,0:04:41.35,Caption,,0,0,0,,ПОДГОТОВКОЙ. В УЧЕНИЯХ МНОГОНАЦИОНАЛЬНЫХ СИЛ УЧАСТВОВАЛИ
Dialogue: 0,0:04:41.35,0:04:44.47,Caption,,0,0,0,,ОДИННАДЦАТЬ ГОСУДАРСТВ И ОКОЛО ДВУХ ТЫСЯЧ ВОСЬМИСОТ
Dialogue: 0,0:04:44.47,0:04:47.59,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. ФРАНЦИЯ НАПРАВИЛА ПРИМЕРНО ТЫСЯЧУ
Dialogue: 0,0:04:47.67,0:04:52.47,Caption,,0,0,0,,СТО ЧЕЛОВЕК, ВЕЛИКОБРИТАНИЯ, ОКОЛО ТРЁХСОТ. АМЕРИКАНСКИХ ПОДРАЗДЕЛЕНИЙ СРЕДИ
Dialogue: 0,0:04:52.47,0:04:59.08,Caption,,0,0,0,,УЧАСТНИКОВ НЕ БЫЛО. ИМЕННО США ЗЕЛЕНСКИЙ ХОЧЕТ ВИДЕТЬ ГЛАВНЫМИ ВОЕННЫМИ
Dialogue: 0,0:04:59.08,0:05:01.48,Caption,,0,0,0,,ГАРАНТАМИ С БАЗАМИ НА УКРАИНСКОЙ ТЕРРИТОРИИ.
Dialogue: 0,0:05:02.11,0:05:04.36,Caption,,0,0,0,,ЕВРОПЕЙЦЫ УЖЕ РЕПЕТИРУЮТ ДЕЙСТВИЯ БУДУЩЕГО
Dialogue: 0,0:05:04.36,0:05:08.52,Caption,,0,0,0,,КОНТИНГЕНТА, НО АМЕРИКАНСКАЯ АРМИЯ НЕ ПРИШЛА. ГЛАВНУЮ РОЛЬ ЕЙ
Dialogue: 0,0:05:08.52,0:05:12.68,Caption,,0,0,0,,ПРЕДЛАГАЮТ ЗАРАНЕЕ, А ИСПОЛНИТЕЛЬ НЕ ЗАГЛЯНУЛ ДАЖЕ НА ЧИТКУ СЦЕНАРИЯ.
Dialogue: 0,0:05:13.30,0:05:15.80,Caption,,0,0,0,,В ЕВРОПЕЙСКОМ ПЛАНЕ ВАШИНГТОН ДОЛЖЕН СЛЕДИТЬ ЗА
Dialogue: 0,0:05:15.88,0:05:18.76,Caption,,0,0,0,,СОБЛЮДЕНИЕМ ПЕРЕМИРИЯ. ЕВРОПЕЙСКИЕ СТРАНЫ ГОТОВЫ
Dialogue: 0,0:05:18.84,0:05:23.00,Caption,,0,0,0,,СОХРАНЯТЬ ВОЕННУЮ ПОДДЕРЖКУ, ФОРМИРОВАТЬ СИЛЫ ПОД СОБСТВЕННЫМ КОМАНДОВАНИЕМ,
Dialogue: 0,0:05:23.24,0:05:25.88,Caption,,0,0,0,,ОБЕЩАТЬ ОТВЕТНЫЕ МЕРЫ ПРИ НОВОМ СТОЛКНОВЕНИИ,
Dialogue: 0,0:05:26.12,0:05:30.36,Caption,,0,0,0,,ВЫДЕЛЯТЬ ДЕНЬГИ, УСИЛИВАТЬ САНКЦИИ И ДОГОВАРИВАТЬСЯ ПО ЭНЕРГЕТИКЕ.
Dialogue: 0,0:05:30.80,0:05:33.88,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЕ ОБЯЗАННОСТЕЙ ПОЧТИ ОБРАЗЦОВОЕ. США
Dialogue: 0,0:05:33.88,0:05:37.56,Caption,,0,0,0,,НАБЛЮДАЮТ. ЕВРОПА ПОСЫЛАЕТ ВОЕННЫХ. ОДНИ ОПЛАЧИВАЮТ
Dialogue: 0,0:05:37.56,0:05:41.64,Caption,,0,0,0,,РАСХОДЫ, ДРУГИЕ ПОСТАВЛЯЮТ ОРУЖИЕ. ЗАТЕМ КТО ТО ДОЛЖЕН
Dialogue: 0,0:05:41.72,0:05:45.96,Caption,,0,0,0,,УБЕДИТЬ МОСКВУ, ЧТО СХЕМА ОТВЕЧАЕТ ЕЁ ИНТЕРЕСАМ. ЕСЛИ ВАМ ПО
Dialogue: 0,0:05:45.96,0:05:48.76,Caption,,0,0,0,,ДУШЕ ТАКИЕ РАЗБОРЫ БЕЗ ТОРЖЕСТВЕННОГО ЧТЕНИЯ
Dialogue: 0,0:05:48.76,0:05:52.68,Caption,,0,0,0,,ЗАЯВЛЕНИЙ, ПОДПИШИТЕСЬ. ДАЛЬШЕ У КАЖДОЙ ИДЕИ ПОЯВЛЯЕТСЯ ЦЕННИК.
Dialogue: 0,0:05:53.24,0:05:55.56,Caption,,0,0,0,,НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД КИЕВ РАССЧИТЫВАЛ
Dialogue: 0,0:05:55.64,0:05:58.36,Caption,,0,0,0,,ПОЛУЧИТЬ ОКОЛО СОРОКА ПЯТИ МИЛЛИАРДОВ. ПОСЛЕ
Dialogue: 0,0:05:58.36,0:06:00.52,Caption,,0,0,0,,ОБСУЖДЕНИЯ С ВОЕННЫМ РУКОВОДСТВОМ ПОТРЕБНОСТЬ
Dialogue: 0,0:06:00.52,0:06:03.32,Caption,,0,0,0,,ВЫРОСЛА НА СЕМЬДЕСЯТ МИЛЛИАРДОВ. ОБЩАЯ СУММА
Dialogue: 0,0:06:03.32,0:06:06.52,Caption,,0,0,0,,ДОСТИГЛА СТА ПЯТНАДЦАТИ МИЛЛИАРДОВ. ОБЫЧНО ПОСЛЕ
Dialogue: 0,0:06:06.52,0:06:08.52,Caption,,0,0,0,,КОНСУЛЬТАЦИИ ИСПРАВЛЯЮТ ПАРУ СТРОК.
Dialogue: 0,0:06:10.80,0:06:13.76,Caption,,0,0,0,,ЗДЕСЬ К ПЕРВОНАЧАЛЬНОЙ СМЕТЕ ПРИСТРОИЛИ ЕЩЁ ПОЛТОРЫ
Dialogue: 0,0:06:13.76,0:06:17.76,Caption,,0,0,0,,И СДЕЛАЛИ ВИД, ЧТО ПОПРАВИЛИ ЗАПЯТУЮ. ЗЕЛЕНСКИЙ ДОПУСКАЕТ,
Dialogue: 0,0:06:18.06,0:06:20.64,Caption,,0,0,0,,ЧТО СОПОСТАВИМЫЙ ОБЪЁМ ПОНАДОБИТСЯ И В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:06:20.64,0:06:23.28,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ИЗ НЕОБХОДИМЫХ СРЕДСТВ
Dialogue: 0,0:06:23.60,0:06:26.48,Caption,,0,0,0,,ДЕВЯНОСТО МИЛЛИАРДОВ УЖЕ СОГЛАСОВАНЫ ЛИБО ПОЛУЧИЛИ
Dialogue: 0,0:06:26.48,0:06:29.52,Caption,,0,0,0,,ПОЛОЖИТЕЛЬНЫЕ СИГНАЛЫ. ОДНАКО ВСЯ СУММА ПОКА НЕ
Dialogue: 0,0:06:29.60,0:06:33.12,Caption,,0,0,0,,СОБРАНА. НА ЭТОМ АРИФМЕТИКА НЕ ЗАКАНЧИВАЕТСЯ. ЕСЛИ
Dialogue: 0,0:06:33.20,0:06:35.92,Caption,,0,0,0,,СОРОК ПЯТЬ МИЛЛИАРДОВ ПРЕВРАТИЛИСЬ В СТО ПЯТНАДЦАТЬ,
Dialogue: 0,0:06:36.16,0:06:38.88,Caption,,0,0,0,,КАКОЙ ЗАПРОС ПОЯВИТСЯ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ
Dialogue: 0,0:06:38.96,0:06:42.64,Caption,,0,0,0,,ГОД? ЧТО ПРИНЕСУТ ПАРТНЁРАМ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ДЕВЯТОМ
Dialogue: 0,0:06:42.92,0:06:45.28,Caption,,0,0,0,,И КАКИМ БУДЕТ СЧЁТ К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ?
Dialogue: 0,0:06:45.83,0:06:48.64,Caption,,0,0,0,,ЭТИ СРОКИ ВОЗНИКАЮТ НЕ РАДИ КРАСИВОГО ГОРИЗОНТА
Dialogue: 0,0:06:48.64,0:06:51.20,Caption,,0,0,0,,ПЛАНИРОВАНИЯ. ВОЕННАЯ ПРОГРАММА СТРОИТСЯ НА
Dialogue: 0,0:06:51.20,0:06:54.08,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ. НА БЕРЛИНСКОЙ ВСТРЕЧЕ КОАЛИЦИИ
Dialogue: 0,0:06:54.08,0:06:57.12,Caption,,0,0,0,,ЖЕЛАЮЩИХ ОБСУЖДАЮТСЯ НЕ ТОЛЬКО БЛИЖАЙШИЕ ПОСТАВКИ.
Dialogue: 0,0:06:57.64,0:07:02.40,Caption,,0,0,0,,ЗАКУПКИ ПЛАНИРУЮТ ТАК, ЧТОБЫ УКРАИНСКИЕ ВОЕННЫЕ ОСВОИЛИ НОВЫЕ СИСТЕМЫ И
Dialogue: 0,0:07:02.48,0:07:05.68,Caption,,0,0,0,,ТЕХНИКУ К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ. ЗАРАНЕЕ
Dialogue: 0,0:07:05.68,0:07:09.76,Caption,,0,0,0,,РЕШАЕТСЯ, КАКОЕ ВООРУЖЕНИЕ ПОЛУЧАТ БУДУЩИЕ УКРАИНСКИЕ GRIPEN,
Dialogue: 0,0:07:10.08,0:07:13.28,Caption,,0,0,0,,КАКИЕ СРЕДСТВА ПОРАЖЕНИЯ ЗАКУПЯТ И КАК СОЕДИНЯТ
Dialogue: 0,0:07:13.28,0:07:16.64,Caption,,0,0,0,,КОМПОНЕНТЫ В ОДНУ БОЕВУЮ СИСТЕМУ. ШВЕЦИЯ И
Dialogue: 0,0:07:16.64,0:07:19.52,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ ОБСУЖДАЮТ РАКЕТЫ METEOR ДЛЯ GRIPEN.
Dialogue: 0,0:07:20.00,0:07:22.56,Caption,,0,0,0,,ЦЕЛЬ КОНКРЕТНА ПОРАЖАТЬ РОССИЙСКИЕ СУ ТРИДЦАТЬ
Dialogue: 0,0:07:22.56,0:07:25.60,Caption,,0,0,0,,ЧЕТЫРЕ НА БОЛЬШОЙ ДАЛЬНОСТИ ДО ПРИМЕНЕНИЯ ИМИ
Dialogue: 0,0:07:25.60,0:07:31.80,Caption,,0,0,0,,ПЛАНИРУЮЩИХ АВИАБОМБ. ПЕРЕД НАМИ ТРИ РАСПИСАНИЯ. ВАШИНГТОН ХОЧЕТ
Dialogue: 0,0:07:31.80,0:07:34.60,Caption,,0,0,0,,СОГЛАШЕНИЯ ДО ЯНВАРЯ. ДЕНЬГИ ЗАПРАШИВАЮТ НА ДВЕ
Dialogue: 0,0:07:34.60,0:07:37.00,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:07:37.00,0:07:39.88,Caption,,0,0,0,,ВОСЬМОЙ ГОДЫ. ПОДГОТОВКУ ВООРУЖЕНИЙ ВЫСТРАИВАЮТ К
Dialogue: 0,0:07:39.96,0:07:42.36,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ. ВОТ И ДОКАЗАТЕЛЬСТВО
Dialogue: 0,0:07:42.36,0:07:44.60,Caption,,0,0,0,,КОНСТРУКЦИЮ СОБИРАЮТСЯ ТЯНУТЬ ДО ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:44.60,0:07:48.04,Caption,,0,0,0,,ТРИДЦАТОГО ГОДА. ЗАПРОС НА СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ
Dialogue: 0,0:07:48.34,0:07:51.48,Caption,,0,0,0,,ВЫГЛЯДИТ УЖЕ НЕ ВНЕЗАПНЫМ БЮДЖЕТНЫМ ПРИСТУПОМ. ЭТО
Dialogue: 0,0:07:51.48,0:07:53.48,Caption,,0,0,0,,СТОИМОСТЬ ОЧЕРЕДНОГО ГОДА СИСТЕМЫ,
Dialogue: 0,0:07:53.84,0:07:56.28,Caption,,0,0,0,,КОТОРУЮ РАСШИРЯЮТ И ОСНАЩАЮТ ДЛЯ ДОЛГОЙ РАБОТЫ.
Dialogue: 0,0:07:56.65,0:07:58.28,Caption,,0,0,0,,ПОЭТОМУ ГЛАВНЫЙ ВОПРОС НЕ В ТОМ,
Dialogue: 0,0:07:58.44,0:08:00.84,Caption,,0,0,0,,НАЙДУТ ЛИ ДЛЯ КИЕВА СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ.
Dialogue: 0,0:08:01.24,0:08:05.72,Caption,,0,0,0,,ИНТЕРЕСНЕЕ, СКОЛЬКО ПЕРЕСЧЁТОВ ПОЯВИТСЯ ДО ВЫДАЧИ ДЕНЕГ. СУДЯ ПО
Dialogue: 0,0:08:05.80,0:08:09.48,Caption,,0,0,0,,ПРЕДЫДУЩЕЙ ПОПРАВКЕ, КАЛЬКУЛЯТОР ТАМ ИСПОЛЬЗУЮТ ДЛЯ ДВИЖЕНИЯ ВВЕРХ.
Dialogue: 0,0:08:09.80,0:08:12.28,Caption,,0,0,0,,НАЧАЛИ С СОРОКА ПЯТИ МИЛЛИАРДОВ. ПРИШЛИ К СТА
Dialogue: 0,0:08:12.28,0:08:15.00,Caption,,0,0,0,,ПЯТНАДЦАТИ. НА СЛЕДУЮЩИЙ ГОД МОЖЕТ ПОНАДОБИТЬСЯ
Dialogue: 0,0:08:15.08,0:08:18.20,Caption,,0,0,0,,ПОЧТИ СТОЛЬКО ЖЕ. ЗАТЕМ НАСТУПЯТ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:18.20,0:08:20.44,Caption,,0,0,0,,ДЕВЯТЫЙ И ДВЕ ТЫСЯЧИ ТРИДЦАТЫЙ ГОДЫ,
Dialogue: 0,0:08:20.77,0:08:23.64,Caption,,0,0,0,,КОТОРЫЕ ТОЖЕ ВРЯД ЛИ ПРОЙДУТ БЕСПЛАТНО. УДОБНАЯ
Dialogue: 0,0:08:23.64,0:08:27.32,Caption,,0,0,0,,СИСТЕМА. СРОКИ ОТОДВИГАЮТСЯ, ПРОГРАММЫ РАЗРАСТАЮТСЯ,
Dialogue: 0,0:08:27.64,0:08:29.48,Caption,,0,0,0,,А ПАРТНЁРАМ ЕЖЕГОДНО СООБЩАЮТ,
Dialogue: 0,0:08:29.72,0:08:32.92,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ТРАНША ТОЧНО ХВАТИТ. ЕВРОПА В ЭТОЙ
Dialogue: 0,0:08:32.92,0:08:36.04,Caption,,0,0,0,,СИСТЕМЕ ОКАЗАЛАСЬ ОДНОВРЕМЕННО СПОНСОРОМ КИЕВА И
Dialogue: 0,0:08:36.04,0:08:41.67,Caption,,0,0,0,,ПОКУПАТЕЛЕМ У РОССИИ. С ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА ДО
Dialogue: 0,0:08:41.67,0:08:43.91,Caption,,0,0,0,,СЕРЕДИНЫ ОКТЯБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО
Dialogue: 0,0:08:44.15,0:08:46.95,Caption,,0,0,0,,ЕВРОСОЮЗ И ВХОДЯЩИЕ В НЕГО ГОСУДАРСТВА ПРЕДОСТАВИЛИ
Dialogue: 0,0:08:46.95,0:08:49.75,Caption,,0,0,0,,УКРАИНЕ ПРИМЕРНО ДВЕСТИ ТРИДЦАТЬ ОДИН С ПОЛОВИНОЙ
Dialogue: 0,0:08:49.83,0:08:54.39,Caption,,0,0,0,,МИЛЛИАРД ЕВРО ПОМОЩИ. ЗА ТОТ ЖЕ ПЕРИОД РОССИЯ ПОЛУЧИЛА ОТ ЕВРОСОЮЗА
Dialogue: 0,0:08:54.39,0:08:57.75,Caption,,0,0,0,,ОКОЛО ДВУХСОТ ТРИДЦАТИ ДВУХ МИЛЛИАРДОВ ЕВРО ЗА
Dialogue: 0,0:08:57.75,0:08:59.99,Caption,,0,0,0,,ИМПОРТ, ВКЛЮЧАЯ ЭНЕРГОРЕСУРСЫ.
Dialogue: 0,0:09:00.54,0:09:04.15,Caption,,0,0,0,,РАЗНИЦА МЕЖДУ ПОТОКАМИ ПОЧТИ ИСЧЕЗАЕТ. ОДНОЙ РУКОЙ
Dialogue: 0,0:09:04.15,0:09:09.27,Caption,,0,0,0,,ЕВРОПА ПОДДЕРЖИВАЕТ УКРАИНУ, ДРУГОЙ ОПЛАЧИВАЕТ РОССИЙСКИЕ ПОСТАВКИ. КАССОВЫЕ
Dialogue: 0,0:09:09.35,0:09:13.67,Caption,,0,0,0,,АППАРАТЫ СТОЯТ НАПРОТИВ, А ДЕНЬГИ БЕГАЮТ МЕЖДУ НИМИ БЫСТРЕЕ ЧИНОВНИКОВ.
Dialogue: 0,0:09:14.26,0:09:17.19,Caption,,0,0,0,,ОСОБЕННО ВЫРАЗИТЕЛЕН ФРАНЦУЗСКИЙ РЕЗУЛЬТАТ. ОКОЛО
Dialogue: 0,0:09:17.27,0:09:19.59,Caption,,0,0,0,,СОРОКА МИЛЛИАРДОВ ЕВРО УШЛО В РОССИЮ В ВИДЕ
Dialogue: 0,0:09:19.59,0:09:22.79,Caption,,0,0,0,,ПЛАТЕЖЕЙ, ТОГДА КАК ПОМОЩЬ УКРАИНЕ СОСТАВИЛА ПРИМЕРНО
Dialogue: 0,0:09:22.92,0:09:25.67,Caption,,0,0,0,,ШЕСТНАДЦАТЬ МИЛЛИАРДОВ. В ОТЧЁТЕ ЦИФРЫ МОЖНО
Dialogue: 0,0:09:25.67,0:09:28.23,Caption,,0,0,0,,РАЗМЕСТИТЬ НА РАЗНЫХ СТРАНИЦАХ. ЕСЛИ ПОСТАВИТЬ
Dialogue: 0,0:09:28.23,0:09:31.83,Caption,,0,0,0,,РЯДОМ, ПОЛУЧИТСЯ ПРОЩЕ РОССИИ ЗАПЛАТИЛИ ЗАМЕТНО БОЛЬШЕ,
Dialogue: 0,0:09:31.91,0:09:34.87,Caption,,0,0,0,,ЧЕМ ДАЛИ УКРАИНЕ. ТЕПЕРЬ К БУХГАЛТЕРИИ ДОБАВЛЯЕТСЯ
Dialogue: 0,0:09:34.87,0:09:37.67,Caption,,0,0,0,,ЗАПРОС НА СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ. ЗА НИМ УЖЕ
Dialogue: 0,0:09:37.67,0:09:40.31,Caption,,0,0,0,,ЖДЁТ СЛЕДУЮЩИЙ ГОД СО СВОЕЙ СМЕТОЙ И СЕРЬЁЗНЫМ
Dialogue: 0,0:09:40.39,0:09:42.95,Caption,,0,0,0,,ВЫРАЖЕНИЕМ ЛИЦА. ОДНИМИ ДЕНЬГАМИ СПИСОК НЕ
Dialogue: 0,0:09:42.95,0:09:46.31,Caption,,0,0,0,,ОГРАНИЧИВАЕТСЯ. КИЕВУ ТРЕБУЮТСЯ ИНОСТРАННЫЕ ВОЕННЫЕ,
Dialogue: 0,0:09:46.42,0:09:49.67,Caption,,0,0,0,,БАЗЫ, ДАЛЬНОБОЙНЫЕ РАКЕТЫ, НОВЫЕ САМОЛЁТЫ,
Dialogue: 0,0:09:49.83,0:09:54.39,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА США, ЕВРОПЕЙСКИЙ КОНТИНГЕНТ И УДОБНЫЙ СОСТАВ КОНГРЕССА.
Dialogue: 0,0:09:56.68,0:09:59.00,Caption,,0,0,0,,ВСЁ ЭТО ПРЕДЛАГАЕТСЯ УМЕСТИТЬ В СОГЛАШЕНИЕ,
Dialogue: 0,0:09:59.24,0:10:01.80,Caption,,0,0,0,,КОТОРОЕ АДМИНИСТРАЦИЯ ТРАМПА ХОЧЕТ ЗАКОНЧИТЬ ДО
Dialogue: 0,0:10:01.88,0:10:04.04,Caption,,0,0,0,,ЯНВАРЯ. ЧЕМ БЛИЖЕ ДОГОВОРЁННОСТЬ,
Dialogue: 0,0:10:04.44,0:10:09.56,Caption,,0,0,0,,ТЕМ ДЛИННЕЕ ПЕРЕЧЕНЬ ТОГО, БЕЗ ЧЕГО ЕЁ НЕЛЬЗЯ ЗАКЛЮЧИТЬ. ТРАМП СМОТРИТ НА
Dialogue: 0,0:10:09.64,0:10:13.32,Caption,,0,0,0,,ЯНВАРЬ. КИЕВ ЖДЁТ ПЕРЕМЕН В КОНГРЕССЕ. ЕВРОПЕЙСКИЕ
Dialogue: 0,0:10:13.40,0:10:16.20,Caption,,0,0,0,,ГОСУДАРСТВА ГОТОВЯТ ВОЕННЫХ И ОТКРЫВАЮТ КОШЕЛЬКИ.
Dialogue: 0,0:10:16.59,0:10:18.84,Caption,,0,0,0,,ПРОГРАММЫ ВООРУЖЕНИЙ ПРОТЯНУЛИСЬ К ДВЕ ТЫСЯЧИ
Dialogue: 0,0:10:18.84,0:10:21.80,Caption,,0,0,0,,ТРИДЦАТОМУ ГОДУ. И МЫ ВОЗВРАЩАЕМСЯ К ПЕРВОМУ
Dialogue: 0,0:10:21.80,0:10:24.20,Caption,,0,0,0,,ВОПРОСУ. СКОЛЬКО ОТКАЗОВ ТРЕБУЕТСЯ,
Dialogue: 0,0:10:24.44,0:10:26.76,Caption,,0,0,0,,ЧТОБЫ ПЕРЕСТАТЬ ПРИНОСИТЬ ТО ЖЕ ПРЕДЛОЖЕНИЕ В
Dialogue: 0,0:10:26.84,0:10:31.24,Caption,,0,0,0,,РАСШИРЕННОЙ КОМПЛЕКТАЦИИ? ЕСЛИ ПОСЛЕ КАЖДОГО "НЕТ" СПИСОК ТРЕБОВАНИЙ РАСТЁТ,
Dialogue: 0,0:10:31.56,0:10:34.60,Caption,,0,0,0,,ТРУДНОСТЬ УЖЕ НЕ В ПОИСКЕ КОМПРОМИССА. САМА ЗАДЕРЖКА
Dialogue: 0,0:10:34.60,0:10:37.64,Caption,,0,0,0,,СТАНОВИТСЯ ПРОЕКТОМ С МНОГОЛЕТНИМ ГРАФИКОМ И
Dialogue: 0,0:10:37.64,0:10:40.76,Caption,,0,0,0,,ЕЖЕГОДНО ДОРОЖАЮЩИМ БЮДЖЕТОМ. ПРИЧЁМ ЦЕНУ ПЛАТЯТ НЕ
Dialogue: 0,0:10:40.76,0:10:43.16,Caption,,0,0,0,,ТЕ, КТО ДОБАВЛЯЕТ ОЧЕРЕДНУЮ БАЗУ,
Dialogue: 0,0:10:43.27,0:10:46.28,Caption,,0,0,0,,РАКЕТУ ИЛИ МИЛЛИАРД. У СОСТАВИТЕЛЯ ТРЕБОВАНИЙ РУЧКА
Dialogue: 0,0:10:46.28,0:10:49.08,Caption,,0,0,0,,НЕ ЗАКОНЧИТСЯ. ЗАКОНЧИТЬСЯ МОЖЕТ СОВСЕМ ДРУГОЕ.
Dialogue: 0,0:10:49.54,0:10:53.56,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, ЗАЧЕМ ОДНОВРЕМЕННО ТРЕБОВАТЬ СРОЧНОГО МИРНОГО
Dialogue: 0,0:10:53.56,0:10:56.28,Caption,,0,0,0,,СОГЛАШЕНИЯ И ГОТОВИТЬ ВОЕННЫЕ ПРОГРАММЫ ДО ДВЕ
Dialogue: 0,0:10:56.28,0:10:59.32,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТОГО ГОДА. ТЕПЕРЬ ВАЖНЕЕ СПРАШИВАТЬ НЕ
Dialogue: 0,0:10:59.40,0:11:02.44,Caption,,0,0,0,,О ТОМ, КОГДА ПОЯВИТСЯ ПОДПИСЬ ПОД ДОГОВОРЁННОСТЬЮ.
Dialogue: 0,0:11:04.73,0:11:07.29,Caption,,0,0,0,,ВАЖНЕЕ ПОНЯТЬ, СКОЛЬКО ЕЩЁ ВОЙСК,
Dialogue: 0,0:11:07.41,0:11:10.01,Caption,,0,0,0,,УСЛОВИЙ И МИЛЛИАРДОВ УСПЕЮТ ПОТРЕБОВАТЬ,
Dialogue: 0,0:11:10.28,0:11:13.69,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ВЫЯСНИТСЯ, ЧТО МЕСТА ДЛЯ НОВЫХ ПУНКТОВ НЕТ,
Dialogue: 0,0:11:14.01,0:11:15.77,Caption,,0,0,0,,А СЧЁТ ПРОДОЛЖАЮТ НЕСТИ.
