Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,МОСКВА ПРЕДЛОЖИЛА СТРАНАМ НАТО ДОГОВАРИВАТЬСЯ О
Dialogue: 0,0:00:02.84,0:00:06.68,Caption,,0,0,0,,НЕНАПАДЕНИИ НЕ ВСЕЙ ТОЛПОЙ, А С КАЖДОЙ СТОЛИЦЕЙ ОТДЕЛЬНО.
Dialogue: 0,0:00:07.32,0:00:10.28,Caption,,0,0,0,,И ЗНАЕТЕ, ПОЧЕМУ ЭТА ИДЕЯ ВДРУГ ВЫГЛЯДИТ СОВСЕМ НЕ
Dialogue: 0,0:00:10.28,0:00:13.64,Caption,,0,0,0,,ФАНТАСТИКОЙ? ПОТОМУ ЧТО ЕВРОПА СОБРАЛАСЬ ОПРЕДЕЛЯТЬ ПРАВИЛА
Dialogue: 0,0:00:13.64,0:00:17.40,Caption,,0,0,0,,СОБСТВЕННОЙ БЕЗОПАСНОСТИ, НО ПОКА НЕ ОПРЕДЕЛИЛА ДАЖЕ ТОГО,
Dialogue: 0,0:00:17.60,0:00:20.60,Caption,,0,0,0,,КТО БУДЕТ ГОВОРИТЬ В МИКРОФОН. КАЛЛАС ТЯНЕТ ОДЕЯЛО
Dialogue: 0,0:00:20.60,0:00:25.32,Caption,,0,0,0,,К СЕБЕ, МЕРЦ УПИРАЕТСЯ, ФОН ДЕР ЛЯЙЕН ПРЕДЛАГАЕТ СВОЙ НАБОР УСЛОВИЙ,
Dialogue: 0,0:00:25.49,0:00:28.60,Caption,,0,0,0,,КОШТА СОБИРАЕТ ЕЩЁ ОДНУ КОМПАНИЮ. ЁЛЫ ПАЛЫ,
Dialogue: 0,0:00:28.82,0:00:33.40,Caption,,0,0,0,,У НИХ ПЕРЕГОВОРЫ УЖЕ ИДУТ, А ОНИ ВСЁ ЕЩЁ ВЫБИРАЮТ СТАРОСТУ КЛАССА. ЕСЛИ
Dialogue: 0,0:00:33.40,0:00:37.64,Caption,,0,0,0,,ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР, ГДЕ ЗАЯВЛЕНИЯ НЕ СКЛАДЫВАЮТ В АККУРАТНУЮ СТОПОЧКУ,
Dialogue: 0,0:00:37.88,0:00:40.20,Caption,,0,0,0,,А ПРОВЕРЯЮТ, ЧТО ЗА НИМИ РЕАЛЬНО ТОРЧИТ,
Dialogue: 0,0:00:40.36,0:00:43.08,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. СЕГОДНЯ НОВОСТИ ОСОБЕННО ХОРОШИ
Dialogue: 0,0:00:43.08,0:00:45.80,Caption,,0,0,0,,ВМЕСТЕ. ПО ОТДЕЛЬНОСТИ ОНИ ВЫГЛЯДЯТ КАК ОБЫЧНАЯ
Dialogue: 0,0:00:45.80,0:00:49.88,Caption,,0,0,0,,СУЕТА ЧИНОВНИКОВ, А В СВЯЗКЕ ПОЛУЧАЕТСЯ КОНСТРУКЦИЯ КУДА СЕРЬЁЗНЕЕ.
Dialogue: 0,0:00:50.47,0:00:53.08,Caption,,0,0,0,,РОССИЙСКОЕ ПРЕДЛОЖЕНИЕ УСТРОЕНО ПРЕДЕЛЬНО ПОНЯТНО.
Dialogue: 0,0:00:53.32,0:00:56.20,Caption,,0,0,0,,ВМЕСТО ОДНОГО СОГЛАШЕНИЯ СО ВСЕМ СЕВЕРОАТЛАНТИЧЕСКИМ
Dialogue: 0,0:00:56.20,0:00:59.24,Caption,,0,0,0,,АЛЬЯНСОМ МОЖНО ЗАКЛЮЧАТЬ ДВУСТОРОННИЕ ДОГОВОРЫ.
Dialogue: 0,0:00:59.58,0:01:02.04,Caption,,0,0,0,,МОСКВА ОТДЕЛЬНО ДОГОВАРИВАЕТСЯ С ГЕРМАНИЕЙ,
Dialogue: 0,0:01:02.18,0:01:06.12,Caption,,0,0,0,,ОТДЕЛЬНО С ИТАЛИЕЙ, ОТДЕЛЬНО С ФРАНЦИЕЙ И ДАЛЬШЕ ПО СПИСКУ.
Dialogue: 0,0:01:08.40,0:01:11.04,Caption,,0,0,0,,НЕ ТРЕБУЕТСЯ СНАЧАЛА УСАДИТЬ ЗА ОДИН СТОЛ БОЛЬШЕ
Dialogue: 0,0:01:11.12,0:01:14.72,Caption,,0,0,0,,ТРИДЦАТИ СТРАН, ПЕРЕЖИТЬ ТРИ ДЕСЯТКА НАЦИОНАЛЬНЫХ КАПРИЗОВ,
Dialogue: 0,0:01:15.00,0:01:18.24,Caption,,0,0,0,,СОГЛАСОВАТЬ КАЖДУЮ ФОРМУЛИРОВКУ И ПОТОМ ЕЩЁ ДО ВЕСНЫ
Dialogue: 0,0:01:18.24,0:01:22.32,Caption,,0,0,0,,ВЫЯСНЯТЬ, ГДЕ ДОЛЖНА СТОЯТЬ ЗАПЯТАЯ. ПРИ НЫНЕШНЕМ СОСТОЯНИИ
Dialogue: 0,0:01:22.32,0:01:25.36,Caption,,0,0,0,,ЕВРОПЫ В ЭТОМ ЕСТЬ ЖЕЛЕЗНАЯ ПРАКТИЧНОСТЬ. ОБЩЕГО
Dialogue: 0,0:01:25.36,0:01:28.56,Caption,,0,0,0,,ГОЛОСА У НЕЁ НЕТ. ОДНИ ТРЕБУЮТ НЕМЕДЛЕННО ПОПАСТЬ
Dialogue: 0,0:01:28.64,0:01:31.20,Caption,,0,0,0,,НА ПЕРЕГОВОРЫ, ДРУГИЕ СПОРЯТ О ПОВЕСТКЕ,
Dialogue: 0,0:01:31.44,0:01:34.08,Caption,,0,0,0,,ТРЕТЬИ ЗАРАНЕЕ ОТВЕРГАЮТ САМ ПРЕДМЕТ РАЗГОВОРА.
Dialogue: 0,0:01:34.55,0:01:37.92,Caption,,0,0,0,,ЖДАТЬ, ПОКА ВСЯ ЭТА КОМПАНИЯ ВЫРАБОТАЕТ ЕДИНУЮ ПОЗИЦИЮ,
Dialogue: 0,0:01:38.24,0:01:42.80,Caption,,0,0,0,,МОЖНО ДОЛГО. ВОЗМОЖНО, К ТОМУ ВРЕМЕНИ УСПЕЮТ ПОСТРОИТЬ ЕЩЁ ОДНО ЗДАНИЕ
Dialogue: 0,0:01:42.80,0:01:46.48,Caption,,0,0,0,,ЕВРОКОМИССИИ, ЧТОБЫ БЫЛО ГДЕ ПРОВОДИТЬ ДОПОЛНИТЕЛЬНЫЕ СОВЕЩАНИЯ.
Dialogue: 0,0:01:46.71,0:01:50.16,Caption,,0,0,0,,НИКТО НЕ ГОВОРИТ, ЧТО ЗАВТРА НА СТОЛЕ ПОЯВИТСЯ КИПА ДОГОВОРОВ,
Dialogue: 0,0:01:50.48,0:01:53.28,Caption,,0,0,0,,А НАТО К ВЕЧЕРУ РАЗБЕРУТ ПО ВИНТИКАМ. ИНТЕРЕСЕН
Dialogue: 0,0:01:53.36,0:01:56.56,Caption,,0,0,0,,САМ ПОДХОД. ДЛЯ ОБЩЕГО СОГЛАШЕНИЯ НУЖНА СТОРОНА,
Dialogue: 0,0:01:56.72,0:01:59.92,Caption,,0,0,0,,СПОСОБНАЯ ПРИНЯТЬ ОБЩЕЕ РЕШЕНИЕ. ЕВРОПА СЕЙЧАС
Dialogue: 0,0:01:59.92,0:02:02.96,Caption,,0,0,0,,ДЕМОНСТРИРУЕТ РОВНО ПРОТИВОПОЛОЖНОЕ. ОДИН ЛИДЕР
Dialogue: 0,0:02:03.12,0:02:06.40,Caption,,0,0,0,,ХОЧЕТ ОБСУЖДАТЬ БУДУЩИЕ ПРАВИЛА БЕЗОПАСНОСТИ. ДРУГОЙ
Dialogue: 0,0:02:06.48,0:02:09.84,Caption,,0,0,0,,СЧИТАЕТ ТАКУЮ БЕСЕДУ ЛИШНЕЙ. ТРЕТИЙ ТРЕБУЕТ ПРЕЖДЕ
Dialogue: 0,0:02:09.84,0:02:12.56,Caption,,0,0,0,,ОСТАНОВИТЬ ОГОНЬ. ЧЕТВЁРТЫЙ ЗАНЯТ ВОПРОСОМ,
Dialogue: 0,0:02:12.80,0:02:16.00,Caption,,0,0,0,,КОМУ ДОСТАНЕТСЯ МЕСТО ПОБЛИЖЕ К КАМЕРАМ. МОСКВА НА
Dialogue: 0,0:02:16.08,0:02:18.80,Caption,,0,0,0,,ЭТО СМОТРИТ И ПРЕДЛАГАЕТ ПРОСТУЮ ВЕЩЬ НЕ ПОЛУЧАЕТСЯ
Dialogue: 0,0:02:18.80,0:02:22.24,Caption,,0,0,0,,ХОРОМ, ОТВЕЧАЙТЕ ПО ОЧЕРЕДИ. ПРИЧЁМ РЕЧЬ ДАВНО ВЫШЛА ЗА
Dialogue: 0,0:02:22.32,0:02:28.36,Caption,,0,0,0,,ПРЕДЕЛЫ ГАЗЕТНЫХ ГАДАНИЙ. НА ПЕРЕГОВОРАХ В АБУ ДАБИ НАХОДИЛСЯ АМЕРИКАНСКИЙ
Dialogue: 0,0:02:28.36,0:02:32.84,Caption,,0,0,0,,ГЕНЕРАЛ АЛЕКСУС ГРИНКЕВИЧ, ГЛАВНОКОМАНДУЮЩИЙ ОБЪЕДИНЁННЫМИ СИЛАМИ НАТО В
Dialogue: 0,0:02:32.92,0:02:35.48,Caption,,0,0,0,,ЕВРОПЕ. СЕРГЕЙ РЯБКОВ ОТДЕЛЬНО ОТМЕТИЛ,
Dialogue: 0,0:02:35.72,0:02:38.60,Caption,,0,0,0,,ЧТО УЧАСТИЕ ТАКОГО ВОЕННОГО СДЕЛАЛО ОБСУЖДЕНИЕ
Dialogue: 0,0:02:38.68,0:02:41.32,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ БОЛЕЕ ПРОФЕССИОНАЛЬНЫМ.
Dialogue: 0,0:02:41.92,0:02:44.76,Caption,,0,0,0,,ВОТ ПОСЛЕ ЭТОГО РАЗГОВОР СТАНОВИТСЯ ЗАМЕТНО ТЯЖЕЛЕЕ.
Dialogue: 0,0:02:45.24,0:02:47.80,Caption,,0,0,0,,РЯБКОВ ЗАНИМАЕТСЯ ТЕМОЙ НЕ ПЕРВЫЙ ДЕНЬ И НЕ
Dialogue: 0,0:02:47.80,0:02:50.68,Caption,,0,0,0,,ПО СЛУЧАЙНО ВЫДАННОЙ ПАПКЕ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:02:50.68,0:02:53.40,Caption,,0,0,0,,ПЕРВОМ ГОДУ ИМЕННО ОН ПРЕДСТАВЛЯЛ РОССИЙСКИЕ
Dialogue: 0,0:02:53.40,0:02:56.44,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯ ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ. ТОГДА МОСКВА
Dialogue: 0,0:02:56.44,0:02:59.32,Caption,,0,0,0,,ПОСТАВИЛА ВОПРОСЫ О ДАЛЬНЕЙШЕМ РАСШИРЕНИИ НАТО,
Dialogue: 0,0:02:59.64,0:03:03.08,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЕ, РАЗМЕЩЕНИИ СИЛ И ПРАВИЛАХ,
Dialogue: 0,0:03:03.24,0:03:06.20,Caption,,0,0,0,,ПО КОТОРЫМ АЛЬЯНС НАМЕРЕН ДВИГАТЬСЯ ДАЛЬШЕ. СПУСТЯ
Dialogue: 0,0:03:06.28,0:03:08.28,Caption,,0,0,0,,ПЯТЬ ЛЕТ ТОТ ЖЕ ДИПЛОМАТ СООБЩАЕТ,
Dialogue: 0,0:03:08.52,0:03:11.32,Caption,,0,0,0,,ЧТО В АБУ ДАБИ ОБСУЖДАЛОСЬ БУДУЩЕЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:03:11.32,0:03:14.12,Caption,,0,0,0,,БЕЗОПАСНОСТИ. РЯДОМ СИДЕЛ НЕ ПЕРЕВОДЧИК,
Dialogue: 0,0:03:14.35,0:03:16.52,Caption,,0,0,0,,НЕ ПОМОЩНИК ПОМОЩНИКА И НЕ ЧИНОВНИК,
Dialogue: 0,0:03:16.71,0:03:19.56,Caption,,0,0,0,,КОТОРОМУ ПОРУЧИЛИ ЗАПИСАТЬ ПОЖЕЛАНИЯ. ЗА СТОЛОМ
Dialogue: 0,0:03:19.56,0:03:22.68,Caption,,0,0,0,,НАХОДИЛСЯ ГЛАВНЫЙ ВОЕННЫЙ КОМАНДУЮЩИЙ НАТО В ЕВРОПЕ.
Dialogue: 0,0:03:23.13,0:03:25.56,Caption,,0,0,0,,ТАКОЙ СОСТАВ НЕ СОБИРАЮТ РАДИ БЕСЕДЫ О ТОМ,
Dialogue: 0,0:03:25.80,0:03:28.68,Caption,,0,0,0,,КОМУ ПЕРЕДАТЬ СПИСОК НА ОБМЕН ПЛЕННЫМИ. ДЛЯ ЭТОГО
Dialogue: 0,0:03:28.68,0:03:31.40,Caption,,0,0,0,,ЧЕТЫРЁХЗВЁЗДОЧНОГО ГЕНЕРАЛА ЧЕРЕЗ ПОЛМИРА НЕ ВЕЗУТ.
Dialogue: 0,0:03:31.69,0:03:36.68,Caption,,0,0,0,,ЕГО ПРИСУТСТВИЕ ОЗНАЧАЕТ, ЧТО ВОПРОС ОТНОШЕНИЙ РОССИИ И НАТО ЯВЛЯЕТСЯ ЧАСТЬЮ
Dialogue: 0,0:03:36.68,0:03:40.44,Caption,,0,0,0,,ПЕРЕГОВОРОВ, А НЕ МЕЛКИМ ДОПОЛНЕНИЕМ ВНИЗУ ПОСЛЕДНЕЙ СТРАНИЦЫ.
Dialogue: 0,0:03:42.71,0:03:46.23,Caption,,0,0,0,,ОТСЮДА СЛЕДУЕТ ВАЖНЫЙ ВЫВОД. УКРАИНСКАЯ ЛИНИЯ УЖЕ НЕ
Dialogue: 0,0:03:46.23,0:03:48.39,Caption,,0,0,0,,ОГРАНИЧИВАЕТСЯ ПРЕКРАЩЕНИЕМ ОГНЯ,
Dialogue: 0,0:03:48.63,0:03:51.43,Caption,,0,0,0,,ПОЛОЖЕНИЕМ ВОЙСК И БУДУЩИМ ОТДЕЛЬНЫХ ТЕРРИТОРИЙ.
Dialogue: 0,0:03:51.91,0:03:54.71,Caption,,0,0,0,,МОСКВА ПОДНИМАЕТ СТАВКУ ДО РАЗГОВОРА О ПРАВИЛАХ
Dialogue: 0,0:03:54.79,0:03:57.91,Caption,,0,0,0,,МЕЖДУ РОССИЕЙ И СЕВЕРОАТЛАНТИЧЕСКИМ АЛЬЯНСОМ. И
Dialogue: 0,0:03:57.91,0:04:00.71,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ АЛЬЯНСА В ЭТОЙ БЕСЕДЕ УЖЕ УЧАСТВУЮТ.
Dialogue: 0,0:04:01.10,0:04:05.51,Caption,,0,0,0,,КАЯ КАЛЛАС УТВЕРЖДАЕТ, ЧТО ДЕЙСТВУЮЩАЯ ЕВРОПЕЙСКАЯ СИСТЕМА ВПОЛНЕ ГОДИТСЯ,
Dialogue: 0,0:04:05.83,0:04:07.99,Caption,,0,0,0,,А РОССИИ НИКАКИЕ ГАРАНТИИ НЕ ТРЕБУЮТСЯ,
Dialogue: 0,0:04:08.23,0:04:09.75,Caption,,0,0,0,,ПОСКОЛЬКУ НА НЕЁ НИКТО НЕ НАПАДАЛ.
Dialogue: 0,0:04:10.31,0:04:14.95,Caption,,0,0,0,,ЗАОДНО КАЛЛАС СООБЩАЕТ, ЧТО ГОСУДАРСТВА ЕВРОСОЮЗА ПРИЗНАЛИ ЕЁ ПОЛНОМОЧИЯ
Dialogue: 0,0:04:14.95,0:04:18.07,Caption,,0,0,0,,ПРЕДСТАВЛЯТЬ ЕВРОПУ ВО ВНЕШНЕЙ ПОЛИТИКЕ И ВОПРОСАХ
Dialogue: 0,0:04:18.07,0:04:21.51,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ЗВУЧИТ СОЛИДНО. ПОЧТИ КАК НАЗНАЧЕНИЕ.
Dialogue: 0,0:04:22.06,0:04:24.55,Caption,,0,0,0,,НО ЕДИНЫМ ПЕРЕГОВОРЩИКОМ КАЛЛАС ТАК И НЕ СТАЛА.
Dialogue: 0,0:04:24.95,0:04:27.59,Caption,,0,0,0,,АНТОНИУ КОШТА И УРСУЛА ФОН ДЕР ЛЯЙЕН НЕ
Dialogue: 0,0:04:27.59,0:04:31.83,Caption,,0,0,0,,ПОДДЕРЖАЛИ ВАРИАНТ, ПРИ КОТОРОМ ОНА ОДНА РУКОВОДИТ ЭТИМ НАПРАВЛЕНИЕМ.
Dialogue: 0,0:04:32.15,0:04:35.27,Caption,,0,0,0,,ВМЕСТО ОДНОГО ПРЕДСТАВИТЕЛЯ СОБРАЛИ ШИРОКУЮ ГРУППУ С
Dialogue: 0,0:04:35.27,0:04:38.55,Caption,,0,0,0,,ГЕРМАНИЕЙ, ФРАНЦИЕЙ, ВЕЛИКОБРИТАНИЕЙ,
Dialogue: 0,0:04:38.63,0:04:41.99,Caption,,0,0,0,,ИТАЛИЕЙ, ПОЛЬШЕЙ И ЕВРОПЕЙСКИМИ УЧРЕЖДЕНИЯМИ.
Dialogue: 0,0:04:42.60,0:04:45.51,Caption,,0,0,0,,ВЧЕРА ЕВРОПА ГОВОРИЛА УСТАМИ КАЛЛАС. СЕГОДНЯ
Dialogue: 0,0:04:45.51,0:04:49.19,Caption,,0,0,0,,ВЫЯСНИЛОСЬ, ЧТО УСТ БУДЕТ НЕСКОЛЬКО. ОСТАЛОСЬ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:04:49.51,0:04:51.59,Caption,,0,0,0,,ЧТОБЫ ОНИ ХОТЯ БЫ НЕ ПЕРЕБИВАЛИ ДРУГ ДРУГА.
Dialogue: 0,0:04:51.80,0:04:54.47,Caption,,0,0,0,,ТОГДА ЧТО ИМЕННО ОНИ СОБИРАЮТСЯ ДЕЛАТЬ ЗА СТОЛОМ?
Dialogue: 0,0:04:54.79,0:04:57.59,Caption,,0,0,0,,МОСКВА НАЗЫВАЕТ ДОЛГОСРОЧНУЮ БЕЗОПАСНОСТЬ ЕВРОПЫ
Dialogue: 0,0:04:57.83,0:05:00.15,Caption,,0,0,0,,ГЛАВНЫМ УСЛОВИЕМ УСТОЙЧИВОГО РЕШЕНИЯ.
Dialogue: 0,0:05:02.44,0:05:06.27,Caption,,0,0,0,,РЯБКОВ ПОДТВЕРЖДАЕТ, ЧТО ЭТА ТЕМА ОБСУЖДАЛАСЬ В АБУ ДАБИ. ТАМ
Dialogue: 0,0:05:06.27,0:05:09.40,Caption,,0,0,0,,ПРИСУТСТВОВАЛ ГЛАВКОМ НАТО. ВАШИНГТОН РАССМАТРИВАЕТ
Dialogue: 0,0:05:09.40,0:05:12.04,Caption,,0,0,0,,ЕВРОПЕЙСКОЕ УЧАСТИЕ. ЕВРОПЕЙЦЫ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:05:12.04,0:05:16.44,Caption,,0,0,0,,ПРИСЫЛАЮТ ГРУППУ, КОТОРОЙ ГЛАВНЫЙ ВОПРОС ТРОГАТЬ НЕЛЬЗЯ. ЗАТО ФАМИЛИИ
Dialogue: 0,0:05:16.44,0:05:20.36,Caption,,0,0,0,,УЧАСТНИКОВ СОГЛАСОВАНЫ. УЖЕ УСПЕХ. ОБЩЕЙ ПОЗИЦИИ У
Dialogue: 0,0:05:20.44,0:05:23.71,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТОЛИЦ ТОЖЕ НЕ НАБЛЮДАЕТСЯ. ФРИДРИХ МЕРЦ
Dialogue: 0,0:05:23.71,0:05:25.96,Caption,,0,0,0,,ТРЕБУЕТ ДОПУСТИТЬ ЕВРОПУ К ПРОЦЕССУ,
Dialogue: 0,0:05:26.20,0:05:29.08,Caption,,0,0,0,,НО ОБСУЖДАТЬ С РОССИЕЙ НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ НЕ
Dialogue: 0,0:05:29.08,0:05:32.92,Caption,,0,0,0,,ХОЧЕТ. КАЛЛАС ПРЕДЛАГАЕТ СНАЧАЛА ПРЕКРАЩЕНИЕ ОГНЯ И МИР,
Dialogue: 0,0:05:33.20,0:05:35.24,Caption,,0,0,0,,А ПРЕЖНИЙ ПОРЯДОК СЧИТАЕТ ДОСТАТОЧНЫМ.
Dialogue: 0,0:05:35.82,0:05:38.36,Caption,,0,0,0,,ФРАНЦУЗСКИЙ ПОСОЛ В МОСКВЕ ПРИЗНАЁТ ЗАКОННОСТЬ
Dialogue: 0,0:05:38.36,0:05:41.16,Caption,,0,0,0,,РОССИЙСКОГО ТРЕБОВАНИЯ ГАРАНТИЙ. ФОН ДЕР ЛЯЙЕН
Dialogue: 0,0:05:41.24,0:05:43.56,Caption,,0,0,0,,ДОПУСКАЕТ РАЗГОВОР О НОВОЙ КОНСТРУКЦИИ,
Dialogue: 0,0:05:43.80,0:05:46.36,Caption,,0,0,0,,ОДНОВРЕМЕННО НАСТАИВАЯ НА ПРОДОЛЖЕНИИ ПОМОЩИ
Dialogue: 0,0:05:46.36,0:05:49.32,Caption,,0,0,0,,УКРАИНЕ. ПРЕМЬЕР ЭСТОНИИ КРИСТЕН МИХАЛ ЧЕСТНО
Dialogue: 0,0:05:49.40,0:05:53.16,Caption,,0,0,0,,ГОВОРИТ, ЧТО НЕЙТРАЛЬНОГО ПОСРЕДНИКА ИЗ ЕВРОПЫ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:05:53.47,0:05:55.96,Caption,,0,0,0,,У КОШТЫ ОДИН ВАРИАНТ, У КАЛЛАС ВТОРОЙ,
Dialogue: 0,0:05:56.26,0:05:59.88,Caption,,0,0,0,,У МЕРЦА ТРЕТИЙ, У ФОН ДЕР ЛЯЙЕН ЧЕТВЁРТЫЙ. ЭТО НЕ ЕДИНАЯ
Dialogue: 0,0:05:59.88,0:06:03.32,Caption,,0,0,0,,ЛИНИЯ. ЭТО МЕНЮ, В КОТОРОМ КАЖДЫЙ ЗАКАЗАЛ СВОЁ,
Dialogue: 0,0:06:03.56,0:06:06.04,Caption,,0,0,0,,А СЧЁТ СОБИРАЮТСЯ ОТПРАВИТЬ СОСЕДНЕМУ СТОЛИКУ.
Dialogue: 0,0:06:06.32,0:06:08.92,Caption,,0,0,0,,ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС ЕВРОПЕЙСКИЙ СОЮЗ СЕЙЧАС
Dialogue: 0,0:06:09.00,0:06:11.96,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ВЫСТУПАЕТ КАК ОДИН ЦЕНТР СИЛЫ ИЛИ ЭТО
Dialogue: 0,0:06:11.96,0:06:14.20,Caption,,0,0,0,,НАБОР СТОЛИЦ С ОБЩИМ ЗНАЧКОМ НА ДВЕРИ?
Dialogue: 0,0:06:16.39,0:06:18.31,Caption,,0,0,0,,ДЛЯ ЖЁСТКОГО КУРСА НУЖНА ВЛАСТЬ,
Dialogue: 0,0:06:18.47,0:06:21.11,Caption,,0,0,0,,СПОСОБНАЯ ЗАСТАВИТЬ ОСТАЛЬНЫХ ЕМУ ПОДЧИНИТЬСЯ.
Dialogue: 0,0:06:21.55,0:06:23.99,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ИСТОРИЯ УЖЕ ПОКАЗЫВАЛА ПОДОБНЫЕ
Dialogue: 0,0:06:23.99,0:06:26.87,Caption,,0,0,0,,МЕХАНИЗМЫ. НАПОЛЕОН И ГИТЛЕР НЕ ПРОВОДИЛИ
Dialogue: 0,0:06:26.87,0:06:29.27,Caption,,0,0,0,,БЕСКОНЕЧНЫХ ГОЛОСОВАНИЙ, ВЫЯСНЯЯ,
Dialogue: 0,0:06:29.51,0:06:32.47,Caption,,0,0,0,,КОМУ КАКОЙ ПУНКТ НРАВИТСЯ. ОНИ СНАЧАЛА ЛОМАЛИ
Dialogue: 0,0:06:32.47,0:06:37.03,Caption,,0,0,0,,СОПРОТИВЛЕНИЕ ГОСУДАРСТВ, ПОТОМ НАПРАВЛЯЛИ ИХ ВОЗМОЖНОСТИ НА ДОСТИЖЕНИЕ
Dialogue: 0,0:06:37.03,0:06:40.23,Caption,,0,0,0,,СОБСТВЕННОЙ ЦЕЛИ. ФИНАЛ ОБОИХ ПОХОДОВ ИЗВЕСТЕН,
Dialogue: 0,0:06:40.55,0:06:43.27,Caption,,0,0,0,,НО УСТРОЙСТВО СИСТЕМЫ БЫЛО ОЧЕВИДНЫМ ПРИКАЗЫВАЕТ
Dialogue: 0,0:06:43.27,0:06:47.51,Caption,,0,0,0,,ОДИН, ОСТАЛЬНЫЕ ИСПОЛНЯЮТ. СЕГОДНЯ ТАКОГО ХОЗЯИНА В ЕВРОПЕ
Dialogue: 0,0:06:47.59,0:06:50.55,Caption,,0,0,0,,НЕТ. ПАРИЖ НЕ СТАНЕТ БЕСПРЕКОСЛОВНО МАРШИРОВАТЬ ПО
Dialogue: 0,0:06:50.63,0:06:53.27,Caption,,0,0,0,,КОМАНДЕ БЕРЛИНА. БЕРЛИН НЕ СОБИРАЕТСЯ ПРИНИМАТЬ
Dialogue: 0,0:06:53.27,0:06:56.63,Caption,,0,0,0,,РАСПОРЯЖЕНИЯ ВАРШАВЫ. РИМ НЕ НАНИМАЛСЯ ВЫПОЛНЯТЬ
Dialogue: 0,0:06:56.71,0:06:59.83,Caption,,0,0,0,,КАЖДОЕ ЖЕЛАНИЕ КАЛЛАС. ЛОНДОН ВООБЩЕ ПОКИНУЛ
Dialogue: 0,0:06:59.83,0:07:02.39,Caption,,0,0,0,,ЕВРОСОЮЗ, ОДНАКО УЧАСТВУЕТ В ГРУППЕ,
Dialogue: 0,0:07:02.63,0:07:04.55,Caption,,0,0,0,,КОТОРАЯ ДОЛЖНА ПРЕДСТАВЛЯТЬ ЕВРОПУ.
Dialogue: 0,0:07:05.15,0:07:07.43,Caption,,0,0,0,,ПОЛЬША СЧИТАЕТ СВОИ УГРОЗЫ ГЛАВНЫМИ,
Dialogue: 0,0:07:07.59,0:07:11.91,Caption,,0,0,0,,ПРИБАЛТИЙСКИЕ СТРАНЫ СВОИ, ВЕНГРИЯ ВООБЩЕ СМОТРИТ НА МНОГИЕ РЕШЕНИЯ ЭТОЙ
Dialogue: 0,0:07:11.91,0:07:16.63,Caption,,0,0,0,,КОМПАНИИ КАК СОСЕД НА РЕМОНТ, НАЧАТЫЙ В ВОСКРЕСЕНЬЕ УТРОМ. ИЗ ЭТОГО НАБОРА
Dialogue: 0,0:07:16.63,0:07:19.59,Caption,,0,0,0,,ИНТЕРЕСОВ ХОТЯТ ПОЛУЧИТЬ ОДНУ НЕПРИМИРИМУЮ ПОЗИЦИЮ
Dialogue: 0,0:07:19.67,0:07:21.83,Caption,,0,0,0,,ПО РОССИИ. ТОЛЬКО КАКИМ СПОСОБОМ?
Dialogue: 0,0:07:22.19,0:07:26.79,Caption,,0,0,0,,ЕСЛИ РЕШАТЬ ГОЛОСОВАНИЕМ, ОСТАНУТСЯ НЕДОВОЛЬНЫЕ. ЕСЛИ ИСКАТЬ КОМПРОМИСС,
Dialogue: 0,0:07:27.11,0:07:29.19,Caption,,0,0,0,,КАЖДОМУ ПРИДЁТСЯ ЧЕМ ТО ПОСТУПИТЬСЯ,
Dialogue: 0,0:07:29.50,0:07:31.91,Caption,,0,0,0,,И ПРЕЖНЯЯ СУРОВОСТЬ ЗАМЕТНО ПОЛИНЯЕТ.
Dialogue: 0,0:07:34.18,0:07:36.34,Caption,,0,0,0,,ЕСЛИ СОХРАНИТЬ ЗА ВСЕМИ ПРАВО ОТКАЗА,
Dialogue: 0,0:07:36.50,0:07:38.74,Caption,,0,0,0,,ПОЛУЧИТСЯ НЫНЕШНИЙ ОБМЕН ЗАЯВЛЕНИЯМИ,
Dialogue: 0,0:07:38.98,0:07:40.90,Caption,,0,0,0,,ГДЕ МЯЧ ЛЕТАЕТ МЕЖДУ СТОЛИЦАМИ,
Dialogue: 0,0:07:41.14,0:07:42.66,Caption,,0,0,0,,А ВОРОТА НИКТО ДАЖЕ НЕ ПОСТАВИЛ.
Dialogue: 0,0:07:43.46,0:07:45.94,Caption,,0,0,0,,ОСОБЕННО ЗАНЯТНАЯ СУЕТА РАЗВЕРНУЛАСЬ ВОКРУГ
Dialogue: 0,0:07:45.94,0:07:48.82,Caption,,0,0,0,,ФИНЛЯНДИИ И СТРАН БАЛТИИ. СНАЧАЛА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:07:48.82,0:07:52.98,Caption,,0,0,0,,СООБЩЕНИЕ, БУДТО РОССИЯ ТРЕБУЕТ ВЫВЕСТИ ФИНЛЯНДИЮ ИЗ НАТО И
Dialogue: 0,0:07:52.98,0:07:55.86,Caption,,0,0,0,,УБРАТЬ БАЗЫ ИЗ ПРИБАЛТИКИ. ЗАТЕМ ХЕЛЬСИНКИ
Dialogue: 0,0:07:55.86,0:07:59.06,Caption,,0,0,0,,ТОРЖЕСТВЕННО ОТВЕРГАЕТ ТРЕБОВАНИЕ. ПОТОМ НАЧИНАЕТСЯ
Dialogue: 0,0:07:59.06,0:08:02.82,Caption,,0,0,0,,СПОР, СУЩЕСТВОВАЛО ЛИ ОНО ВООБЩЕ. ОДНИ ЗАЯВЛЯЮТ,
Dialogue: 0,0:08:02.98,0:08:05.06,Caption,,0,0,0,,ЧТО ТРЕБОВАЛИ. ДРУГИЕ ОТВЕЧАЮТ,
Dialogue: 0,0:08:05.22,0:08:07.94,Caption,,0,0,0,,ЧТО НИЧЕГО ПОДОБНОГО НЕ ГОВОРИЛИ. ТРЕТЬИ УЖЕ
Dialogue: 0,0:08:07.94,0:08:09.70,Caption,,0,0,0,,ПРАЗДНУЮТ ПОБЕДУ НАД УСЛОВИЕМ,
Dialogue: 0,0:08:09.94,0:08:14.18,Caption,,0,0,0,,КОТОРОЕ, ВОЗМОЖНО, САМИ ЖЕ И СФОРМУЛИРОВАЛИ. ОДНОВРЕМЕННО ВЕРНУЛОСЬ
Dialogue: 0,0:08:14.18,0:08:17.38,Caption,,0,0,0,,РОССИЙСКОЕ ТРЕБОВАНИЕ О КОНФИГУРАЦИИ НАТО НА ТЫСЯЧА
Dialogue: 0,0:08:17.38,0:08:19.54,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОЙ ГОД. ЗНАЧИТ,
Dialogue: 0,0:08:19.78,0:08:22.66,Caption,,0,0,0,,РАЗГОВОР НЕ СВОДИТСЯ К ЧЛЕНСТВУ УКРАИНЫ. МОСКВА
Dialogue: 0,0:08:22.66,0:08:25.54,Caption,,0,0,0,,СТАВИТ ВОПРОС ШИРЕ ЧТО АЛЬЯНС РАЗМЕСТИЛ ПОСЛЕ
Dialogue: 0,0:08:25.62,0:08:29.78,Caption,,0,0,0,,ХОЛОДНОЙ ВОЙНЫ, ГДЕ ПОЯВИЛИСЬ ЕГО ОБЪЕКТЫ И НАСКОЛЬКО БЛИЗКО ЕГО
Dialogue: 0,0:08:29.78,0:08:32.02,Caption,,0,0,0,,ВОЕННАЯ СИСТЕМА МОЖЕТ ПОДХОДИТЬ К РОССИЙСКИМ
Dialogue: 0,0:08:32.10,0:08:36.50,Caption,,0,0,0,,ГРАНИЦАМ. ПОДПИСЫВАЙТЕСЬ, ЕСЛИ ЕЩЁ НЕ УСПЕЛИ. ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:08:36.50,0:08:39.46,Caption,,0,0,0,,ЛЮБОПЫТНОЕ. ОДИН УЧАСТНИК ПРЕДЛАГАЕТ ЗАНОВО
Dialogue: 0,0:08:39.46,0:08:41.70,Caption,,0,0,0,,ОПРЕДЕЛИТЬ ПРАВИЛА МЕЖДУ РОССИЕЙ И НАТО,
Dialogue: 0,0:08:42.18,0:08:45.06,Caption,,0,0,0,,А ДРУГОЙ ПРИЕЗЖАЕТ С ПЕРЕЧНЕМ УКРАИНСКИХ РАСХОДОВ И
Dialogue: 0,0:08:45.06,0:08:47.54,Caption,,0,0,0,,ДЕЛАЕТ ВИД, ЧТО ЭТО ОДНА И ТА ЖЕ ПОВЕСТКА.
Dialogue: 0,0:08:49.83,0:08:53.59,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ХОЧЕТ, ЧТОБЫ ЕВРОСОЮЗ КОНТРОЛИРОВАЛ ПЕРЕГОВОРЫ МОСКВЫ И
Dialogue: 0,0:08:53.59,0:08:57.11,Caption,,0,0,0,,ВАШИНГТОНА О БУДУЩЕЙ БЕЗОПАСНОСТИ ЕВРОПЫ. КИЕВ И
Dialogue: 0,0:08:57.19,0:09:01.35,Caption,,0,0,0,,БРЮССЕЛЬ ЖЕЛАЮТ ЗНАТЬ, КАКИЕ РЕШЕНИЯ ГОТОВЯТ ДВЕ КРУПНЕЙШИЕ ЯДЕРНЫЕ
Dialogue: 0,0:09:01.35,0:09:03.99,Caption,,0,0,0,,ДЕРЖАВЫ. ДЖАРЕД КУШНЕР ТОЖЕ ГОВОРИТ,
Dialogue: 0,0:09:04.23,0:09:06.71,Caption,,0,0,0,,ЧТО ЕВРОПА ДОЛЖНА УЧАСТВОВАТЬ В БУДУЩЕМ МИРНОМ
Dialogue: 0,0:09:06.71,0:09:10.87,Caption,,0,0,0,,СОГЛАШЕНИИ. САМИ ЕВРОПЕЙЦЫ ТРЕБУЮТ МЕСТА ЗА СТОЛОМ ВСЁ ГРОМЧЕ.
Dialogue: 0,0:09:11.18,0:09:13.91,Caption,,0,0,0,,НО МЕСТО ЕЩЁ НЕ ЗАМЕНЯЕТ ПОЗИЦИЮ. ФОН ДЕР
Dialogue: 0,0:09:13.99,0:09:16.95,Caption,,0,0,0,,ЛЯЙЕН НАЗЫВАЕТ ПРИОРИТЕТАМИ ПРЕКРАЩЕНИЕ ОГНЯ,
Dialogue: 0,0:09:17.18,0:09:19.67,Caption,,0,0,0,,ГАРАНТИИ УКРАИНЕ, ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:09:19.82,0:09:23.27,Caption,,0,0,0,,НОВЫЕ КОНТРАКТЫ И ФИНАНСИРОВАНИЕ КИЕВА В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:09:23.35,0:09:26.47,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОМ ГОДУ. РОССИЯ ГОВОРИТ О ШИРОКОМ
Dialogue: 0,0:09:26.55,0:09:29.43,Caption,,0,0,0,,МИРНОМ СОГЛАШЕНИИ И БУДУЩИХ ОТНОШЕНИЯХ С НАТО.
Dialogue: 0,0:09:29.99,0:09:32.95,Caption,,0,0,0,,МАСШТАБ У ЭТИХ СПИСКОВ РАЗНЫЙ. БРЮССЕЛЬ ПРИНОСИТ
Dialogue: 0,0:09:32.95,0:09:35.67,Caption,,0,0,0,,ПЕРЕЧЕНЬ БЛИЖАЙШИХ УКРАИНСКИХ ЗАДАЧ. МОСКВА
Dialogue: 0,0:09:35.67,0:09:39.35,Caption,,0,0,0,,ПРЕДЛАГАЕТ РЕШИТЬ, ПО КАКИМ ПРАВИЛАМ ДВЕ ВОЕННЫЕ СИСТЕМЫ БУДУТ
Dialogue: 0,0:09:39.35,0:09:42.23,Caption,,0,0,0,,СУЩЕСТВОВАТЬ ПОСЛЕ ОКОНЧАНИЯ КОНФЛИКТА. ПРИ ЭТОМ ИЗ
Dialogue: 0,0:09:42.31,0:09:45.27,Caption,,0,0,0,,КИЕВА ПРОЗВУЧАЛО ЗАЯВЛЕНИЕ О СНЯТИИ ОГРАНИЧЕНИЙ НА
Dialogue: 0,0:09:45.35,0:09:47.83,Caption,,0,0,0,,УДАРЫ ПО ОБЪЕКТАМ. А ПО СЕТИ УЖЕ ГУЛЯЕТ
Dialogue: 0,0:09:47.83,0:09:51.03,Caption,,0,0,0,,ИНФОРМАЦИЯ КУДА ЖЁСТЧЕ В КРЕМЛЕ СНЯЛИ ПРЕЖНЕЕ ТАБУ
Dialogue: 0,0:09:51.27,0:09:53.51,Caption,,0,0,0,,НА ЛИКВИДАЦИЮ НЕ ОБЪЕКТОВ, А ЛЮДЕЙ,
Dialogue: 0,0:09:53.67,0:09:56.79,Caption,,0,0,0,,ВКЛЮЧАЯ ВЫСШИХ ДОЛЖНОСТНЫХ ЛИЦ. ЕСЛИ ТАКОЙ СИГНАЛ
Dialogue: 0,0:09:56.79,0:09:58.55,Caption,,0,0,0,,ДОШЁЛ ДО УКРАИНСКОГО РУКОВОДСТВА,
Dialogue: 0,0:09:58.87,0:10:01.91,Caption,,0,0,0,,РАЗГОВОР О ГАРАНТИЯХ ПОЛУЧАЕТ СОВСЕМ ДРУГОЙ ВЕС. ТАМ
Dialogue: 0,0:10:01.99,0:10:04.71,Caption,,0,0,0,,УЖЕ НЕ ДО БОДРЫХ ФОРМУЛИРОВОК ДЛЯ ОЧЕРЕДНОЙ ПРЕСС
Dialogue: 0,0:10:04.71,0:10:10.50,Caption,,0,0,0,,КОНФЕРЕНЦИИ. САМИ СЛОВА О ГАРАНТИЯХ УКРАИНЕ ПОЧТИ НИЧЕГО НЕ
Dialogue: 0,0:10:10.50,0:10:14.18,Caption,,0,0,0,,РЕШАЮТ, ПОКА НЕТ ОТВЕТОВ НА КОНКРЕТНЫЕ ВОПРОСЫ. О КАКИХ
Dialogue: 0,0:10:14.18,0:10:17.14,Caption,,0,0,0,,ГРАНИЦАХ ИДЁТ РЕЧЬ? КАКОЙ БУДЕТ ЧИСЛЕННОСТЬ АРМИИ?
Dialogue: 0,0:10:17.45,0:10:21.62,Caption,,0,0,0,,СОХРАНИТСЯ ЛИ КУРС НА НАТО? ДОПУСТЯТ ЛИ ИНОСТРАННЫЕ БАЗЫ И ВОЕННУЮ
Dialogue: 0,0:10:21.62,0:10:25.94,Caption,,0,0,0,,ИНФРАСТРУКТУРУ? КТО ОКАЖЕТСЯ У ВЛАСТИ И КАКИЕ ОБЯЗАТЕЛЬСТВА ВОЗЬМЁТ
Dialogue: 0,0:10:26.02,0:10:30.02,Caption,,0,0,0,,НА СЕБЯ? ИМЕННО ПОЭТОМУ МОСКВА ВЫВОДИТ РАЗГОВОР НА СЛЕДУЮЩИЙ
Dialogue: 0,0:10:30.10,0:10:32.58,Caption,,0,0,0,,ЭТАЖ. ЕЁ ИНТЕРЕСУЕТ НЕ ТОЛЬКО УКРАИНА,
Dialogue: 0,0:10:32.71,0:10:35.78,Caption,,0,0,0,,ДОНБАСС ИЛИ ОСТАНОВКА БОЕВЫХ ДЕЙСТВИЙ. ОНА ХОЧЕТ
Dialogue: 0,0:10:35.78,0:10:38.42,Caption,,0,0,0,,ЗАКРЕПИТЬ УСЛОВИЯ СОСУЩЕСТВОВАНИЯ С НАТО ПОСЛЕ
Dialogue: 0,0:10:38.50,0:10:41.22,Caption,,0,0,0,,ВОЙНЫ. НА ЭТОМ ФОНЕ ДВУСТОРОННИЕ СОГЛАШЕНИЯ О
Dialogue: 0,0:10:41.22,0:10:43.94,Caption,,0,0,0,,НЕНАПАДЕНИИ УЖЕ НЕ ВЫГЛЯДЯТ КРАСИВЫМ ЖЕСТОМ ДЛЯ
Dialogue: 0,0:10:43.94,0:10:47.14,Caption,,0,0,0,,ЗАГОЛОВКОВ. ЭТО РАБОЧИЙ СПОСОБ ИМЕТЬ ДЕЛО С РЕАЛЬНОЙ
Dialogue: 0,0:10:47.14,0:10:49.30,Caption,,0,0,0,,ЕВРОПОЙ, ГДЕ МНОГО ГОСУДАРСТВ,
Dialogue: 0,0:10:49.46,0:10:52.42,Caption,,0,0,0,,МНОГО НАЧАЛЬНИКОВ, ЕЩЁ БОЛЬШЕ ОСОБЫХ ИНТЕРЕСОВ,
Dialogue: 0,0:10:52.82,0:10:55.38,Caption,,0,0,0,,А ЕДИНАЯ ВОЛЯ ПОЯВЛЯЕТСЯ ПРИМЕРНО ТАК ЖЕ ЧАСТО,
Dialogue: 0,0:10:55.62,0:10:58.02,Caption,,0,0,0,,КАК СВОБОДНОЕ МЕСТО У ЗДАНИЯ ЕВРОКОМИССИИ.
Dialogue: 0,0:10:58.74,0:11:01.30,Caption,,0,0,0,,ПРИ ТАКОМ ФОРМАТЕ УЖЕ ТРУДНЕЕ СПРЯТАТЬСЯ ЗА ФРАЗОЙ
Dialogue: 0,0:11:01.30,0:11:04.50,Caption,,0,0,0,,О РЕШЕНИИ ВСЕГО БЛОКА. КАЖДОЙ СТОЛИЦЕ ПРИДЁТСЯ ПРЯМО
Dialogue: 0,0:11:04.50,0:11:07.46,Caption,,0,0,0,,СКАЗАТЬ, КАКИХ ОТНОШЕНИЙ ОНА ХОЧЕТ С РОССИЕЙ,
Dialogue: 0,0:11:07.75,0:11:10.74,Caption,,0,0,0,,КАКИЕ ДЕЙСТВИЯ СЧИТАЕТ УГРОЗОЙ И ЧТО ГОТОВА
Dialogue: 0,0:11:10.74,0:11:15.38,Caption,,0,0,0,,ГАРАНТИРОВАТЬ САМА. ПРАВДА, БУМАГА МЕЖДУ ДВУМЯ ГОСУДАРСТВАМИ НЕ ВЫКЛЮЧАЕТ
Dialogue: 0,0:11:15.38,0:11:18.34,Caption,,0,0,0,,СОЮЗНЫЕ МЕХАНИЗМЫ. У НАТО ОСТАЮТСЯ ЕДИНОЕ
Dialogue: 0,0:11:18.34,0:11:20.42,Caption,,0,0,0,,КОМАНДОВАНИЕ, ОБОРОННЫЕ ПЛАНЫ,
Dialogue: 0,0:11:20.64,0:11:24.26,Caption,,0,0,0,,АМЕРИКАНСКИЕ ВОЙСКА, БАЗЫ И ОБЩАЯ ИНФРАСТРУКТУРА.
Dialogue: 0,0:11:26.54,0:11:28.86,Caption,,0,0,0,,ПОДПИСЬ ОДНОЙ СТОЛИЦЫ НЕ ОТПРАВИТ ВСЁ ЭТО В
Dialogue: 0,0:11:28.86,0:11:31.58,Caption,,0,0,0,,ОТПУСК. ПОЭТОМУ УЧАСТИЕ ГРИНКЕВИЧА В ПЕРЕГОВОРАХ
Dialogue: 0,0:11:31.58,0:11:33.26,Caption,,0,0,0,,ИМЕЕТ ПРИНЦИПИАЛЬНОЕ ЗНАЧЕНИЕ.
Dialogue: 0,0:11:33.90,0:11:36.22,Caption,,0,0,0,,НЕЛЬЗЯ ВСЕРЬЁЗ ОБСУЖДАТЬ ВОЕННОЕ УСТРОЙСТВО
Dialogue: 0,0:11:36.22,0:11:40.54,Caption,,0,0,0,,КОНТИНЕНТА И ДЕЛАТЬ ВИД, БУДТО СЕВЕРОАТЛАНТИЧЕСКИЙ АЛЬЯНС СЛУЧАЙНО ВЫШЕЛ ЗА
Dialogue: 0,0:11:40.62,0:11:44.14,Caption,,0,0,0,,КОФЕ. НА ВСТРЕЧУ ПРИБЫЛ НЕ СОТРУДНИК ПРОТОКОЛА И НЕ
Dialogue: 0,0:11:44.14,0:11:48.14,Caption,,0,0,0,,СОВЕТНИК С ПОРТФЕЛЕМ, КОТОРЫЙ ХОРОШО СМОТРИТСЯ ВОЗЛЕ ДВЕРИ. ЭТО
Dialogue: 0,0:11:48.14,0:11:50.46,Caption,,0,0,0,,АМЕРИКАНСКИЙ ГЕНЕРАЛ С ЧЕТЫРЬМЯ ЗВЁЗДАМИ,
Dialogue: 0,0:11:50.62,0:11:53.58,Caption,,0,0,0,,ЗАНИМАЮЩИЙ ВЕРШИНУ КОМАНДНОЙ СИСТЕМЫ НАТО В ЕВРОПЕ.
Dialogue: 0,0:11:54.04,0:11:56.14,Caption,,0,0,0,,ВЫШЕ НЕГО УЖЕ НАЧИНАЮТСЯ ПОЛИТИКИ,
Dialogue: 0,0:11:56.25,0:11:58.54,Caption,,0,0,0,,УТВЕРЖДАЮЩИЕ РЕШЕНИЯ. НУ И НЕБЕСА,
Dialogue: 0,0:11:58.86,0:12:01.98,Caption,,0,0,0,,НО ОТТУДА КОММЕНТАРИЕВ ПОКА НЕ ПОСТУПАЛО. КАЛЛАС
Dialogue: 0,0:12:01.98,0:12:05.90,Caption,,0,0,0,,УВЕРЯЕТ, ЧТО МЕНЯТЬ СУЩЕСТВУЮЩУЮ СИСТЕМУ НЕ ТРЕБУЕТСЯ. РЯБКОВ
Dialogue: 0,0:12:05.90,0:12:09.58,Caption,,0,0,0,,СООБЩАЕТ, ЧТО ЕЁ БУДУЩЕЕ СТАЛО ОДНОЙ ИЗ ЦЕНТРАЛЬНЫХ ТЕМ.
Dialogue: 0,0:12:09.87,0:12:12.46,Caption,,0,0,0,,МЕРЦ НЕ ВИДИТ НУЖДЫ ОБСУЖДАТЬ ЭТО С МОСКВОЙ,
Dialogue: 0,0:12:12.62,0:12:15.34,Caption,,0,0,0,,А АМЕРИКАНСКАЯ СТОРОНА УЖЕ УЧАСТВУЕТ В ТАКОМ
Dialogue: 0,0:12:15.34,0:12:19.50,Caption,,0,0,0,,ОБСУЖДЕНИИ. ЕВРОСОЮЗ ФОРМИРУЕТ МНОГОЧИСЛЕННУЮ ДЕЛЕГАЦИЮ БЕЗ
Dialogue: 0,0:12:19.58,0:12:21.34,Caption,,0,0,0,,ПОЛНОМОЧИЙ ПО ГЛАВНОМУ ВОПРОСУ,
Dialogue: 0,0:12:21.57,0:12:23.74,Caption,,0,0,0,,ПОКА РОССИЯ ПРЕДЛАГАЕТ ПЕРЕЙТИ К ОТДЕЛЬНЫМ
Dialogue: 0,0:12:23.74,0:12:26.94,Caption,,0,0,0,,СОГЛАШЕНИЯМ. ЕСЛИ СОБРАТЬ ФАКТЫ ВМЕСТЕ,
Dialogue: 0,0:12:27.10,0:12:30.14,Caption,,0,0,0,,ВЫВОД ВЫХОДИТ ДОВОЛЬНО КОЛЮЧИЙ. ЕВРОПА ТРЕБУЕТ
Dialogue: 0,0:12:30.14,0:12:32.30,Caption,,0,0,0,,УЧАСТВОВАТЬ В СОЗДАНИИ БУДУЩИХ ПРАВИЛ,
Dialogue: 0,0:12:32.62,0:12:35.74,Caption,,0,0,0,,ХОТЯ ВНУТРИ НЕЁ НЕТ ОБЩЕГО ПЕРЕЧНЯ ТРЕБОВАНИЙ.
Dialogue: 0,0:12:36.12,0:12:40.30,Caption,,0,0,0,,РОССИЯ ДОБИВАЕТСЯ СОГЛАШЕНИЙ, РАССЧИТАННЫХ НЕ НА БЛИЖАЙШИЙ МЕСЯЦ,
Dialogue: 0,0:12:40.54,0:12:46.74,Caption,,0,0,0,,А НА ГОДЫ ВПЕРЁД. СОЕДИНЁННЫЕ ШТАТЫ РАЗГОВОР НЕ ОСТАНАВЛИВАЮТ. НАТО
Dialogue: 0,0:12:46.74,0:12:49.30,Caption,,0,0,0,,ПРИСУТСТВУЕТ ЗА СТОЛОМ В ЛИЦЕ ВЫСШЕГО ВОЕННОГО
Dialogue: 0,0:12:49.30,0:12:52.74,Caption,,0,0,0,,КОМАНДОВАНИЯ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ВСЁ ЕЩЁ ВЫЯСНЯЮТ,
Dialogue: 0,0:12:52.85,0:12:56.58,Caption,,0,0,0,,КОМУ ДОВЕРИТЬ РЕЧЬ И КАКОЙ ИМЕННО ВОПРОС РАЗРЕШЕНО
Dialogue: 0,0:12:56.58,0:12:59.54,Caption,,0,0,0,,ОБСУЖДАТЬ. ПОЭТОМУ СЛЕДУЮЩИЙ РАУНД ВАЖЕН НЕ ТОЛЬКО
Dialogue: 0,0:12:59.62,0:13:02.10,Caption,,0,0,0,,СПИСКОМ ПРИГЛАШЁННЫХ. ГОРАЗДО ИНТЕРЕСНЕЕ,
Dialogue: 0,0:13:02.39,0:13:05.54,Caption,,0,0,0,,ПОЯВИТСЯ ЛИ У ЕВРОПЫ ЕДИНЫЙ ОТВЕТ. ЕСЛИ ЕГО
Dialogue: 0,0:13:05.62,0:13:08.98,Caption,,0,0,0,,СНОВА НЕ БУДЕТ, БУДУЩУЮ СИСТЕМУ ДЕЙСТВИТЕЛЬНО МОГУТ СОБИРАТЬ
Dialogue: 0,0:13:09.06,0:13:11.22,Caption,,0,0,0,,ЧАСТЯМИ. ОДИН ДОГОВОР С ОДНОЙ СТРАНОЙ,
Dialogue: 0,0:13:11.46,0:13:15.54,Caption,,0,0,0,,СЛЕДУЮЩИЙ С ДРУГОЙ, ОТДЕЛЬНЫЕ ОБЯЗАТЕЛЬСТВА С ТРЕТЬЕЙ. И ОДНАЖДЫ
Dialogue: 0,0:13:15.62,0:13:18.66,Caption,,0,0,0,,БРЮССЕЛЬ ОБНАРУЖИТ НЕПРИЯТНУЮ ВЕЩЬ ПОКА ТАМ МЕСЯЦАМИ
Dialogue: 0,0:13:18.66,0:13:23.06,Caption,,0,0,0,,ВЫБИРАЛИ ОБЩИЙ ГОЛОС, С КАЖДОЙ СТОЛИЦЕЙ УЖЕ ПОГОВОРИЛИ БЕЗ ПЕРЕВОДЧИКА ОТ
Dialogue: 0,0:13:23.14,0:13:25.06,Caption,,0,0,0,,ВСЕГО КОЛЛЕКТИВА. КАК ДУМАЕТЕ,
Dialogue: 0,0:13:25.17,0:13:27.70,Caption,,0,0,0,,ЕВРОПА СУМЕЕТ ДОГОВОРИТЬСЯ САМА С СОБОЙ ИЛИ
Dialogue: 0,0:13:27.70,0:13:30.42,Caption,,0,0,0,,ОТДЕЛЬНЫЕ СТОЛИЦЫ ПРЕДПОЧТУТ ОТВЕЧАТЬ ЗА СОБСТВЕННЫЕ
Dialogue: 0,0:13:30.50,0:13:33.78,Caption,,0,0,0,,РЕШЕНИЯ? ПИШИТЕ В КОММЕНТАРИЯХ. ПОТОМУ ЧТО СЕЙЧАС ГЛАВНЫЙ
Dialogue: 0,0:13:33.78,0:13:36.90,Caption,,0,0,0,,СПОР ИДЁТ УЖЕ НЕ О ТОМ, КОГО ПОСАДЯТ ЗА СТОЛ,
Dialogue: 0,0:13:37.17,0:13:40.98,Caption,,0,0,0,,А О ТОМ, ОСТАНЕТСЯ ЛИ К МОМЕНТУ ПОСАДКИ ХОТЬ ЧТО НИБУДЬ,
Dialogue: 0,0:13:41.19,0:13:42.66,Caption,,0,0,0,,ЧТО МОЖНО РЕШИТЬ ВСЕМ ВМЕСТЕ.
