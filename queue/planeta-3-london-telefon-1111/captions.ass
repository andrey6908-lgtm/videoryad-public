Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,ПЯТЬ КРУПНЫХ ЕВРОПЕЙСКИХ СТРАН ОБЪЯВИЛИ ПРОГРАММУ
Dialogue: 0,0:00:02.76,0:00:05.56,Caption,,0,0,0,,ДЕШЁВЫХ СИСТЕМ ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ. ЗВУЧИТ
Dialogue: 0,0:00:05.56,0:00:08.36,Caption,,0,0,0,,ВНУШИТЕЛЬНО, НО ПРОГРАММА ЕЩЁ НЕ ДАЛА РЕЗУЛЬТАТА,
Dialogue: 0,0:00:08.53,0:00:11.72,Caption,,0,0,0,,СПОСОБНОГО ЗАКРЫТЬ ОБРАЗОВАВШИЙСЯ РАЗРЫВ. ПО ДАННЫМ
Dialogue: 0,0:00:11.72,0:00:15.80,Caption,,0,0,0,,АГЕНТСТВА БЛУМБЕРГ, РОССИЯ ВЫПУСКАЕТ БАЛЛИСТИЧЕСКИЕ РАКЕТЫ БЫСТРЕЕ,
Dialogue: 0,0:00:15.99,0:00:18.68,Caption,,0,0,0,,ЧЕМ ВСЕ ПРОИЗВОДИТЕЛИ ПЕРЕХВАТЧИКОВ ДЛЯ КОМПЛЕКСОВ
Dialogue: 0,0:00:18.68,0:00:21.88,Caption,,0,0,0,,ПЭТРИОТ УСПЕВАЮТ ПРОИЗВОДИТЬ СВОИ РАКЕТЫ. ДОНАЛЬД
Dialogue: 0,0:00:21.88,0:00:24.20,Caption,,0,0,0,,ТРАМП ОБЕЩАЛ ВЫДАТЬ ЛИЦЕНЗИИ НА ИЗГОТОВЛЕНИЕ
Dialogue: 0,0:00:24.20,0:00:26.36,Caption,,0,0,0,,ПЕРЕХВАТЧИКОВ НЕПОСРЕДСТВЕННО НА УКРАИНЕ,
Dialogue: 0,0:00:26.68,0:00:29.48,Caption,,0,0,0,,НО ОБЕЩАНИЕ ПОКА НЕ ПРЕВРАТИЛОСЬ В РАБОТАЮЩИЕ ЛИНИИ.
Dialogue: 0,0:00:29.86,0:00:32.12,Caption,,0,0,0,,ПАРЛАМЕНТ МОЖЕТ ПРОГОЛОСОВАТЬ ЗА ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:00:32.12,0:00:35.08,Caption,,0,0,0,,МИЛЛИАРДЫ ЗА ОДИН ВЕЧЕР. ПРОИЗВОДСТВЕННЫЙ КОРПУС ОТ
Dialogue: 0,0:00:35.16,0:00:37.56,Caption,,0,0,0,,ЭТОГО К УТРУ НЕ ВЫРАСТЕТ. СТАНКИ НЕ ЧИТАЮТ
Dialogue: 0,0:00:37.56,0:00:41.24,Caption,,0,0,0,,РЕЗОЛЮЦИИ, А РАКЕТЫ НЕ РАЗМНОЖАЮТСЯ ОТ УВЕРЕННОГО ВЫРАЖЕНИЯ
Dialogue: 0,0:00:41.24,0:00:45.00,Caption,,0,0,0,,ЛИЦА. ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНЕЕ СМОТРЕТЬ НЕ НА ОТДЕЛЬНОЕ
Dialogue: 0,0:00:45.00,0:00:48.28,Caption,,0,0,0,,ЗАЯВЛЕНИЕ, А НА ВСЮ КОНСТРУКЦИЮ ЦЕЛИКОМ. ТАМ ОБЫЧНО И
Dialogue: 0,0:00:48.28,0:00:50.04,Caption,,0,0,0,,ОБНАРУЖИВАЕТСЯ САМОЕ ЗАНЯТНОЕ.
Dialogue: 0,0:00:50.68,0:00:55.32,Caption,,0,0,0,,ГАЗЕТА "МОНД" ПИШЕТ, ЧТО ЕВРОПА ВСЁ ОСТРЕЕ СТАЛКИВАЕТСЯ СО СТАРЫМ ВЫБОРОМ
Dialogue: 0,0:00:55.40,0:00:58.52,Caption,,0,0,0,,МЕЖДУ МАСЛОМ И ПУШКАМИ. ВОЕННЫЕ РАСХОДЫ РАСТУТ.
Dialogue: 0,0:00:58.87,0:01:01.96,Caption,,0,0,0,,ПОДДЕРЖКА УКРАИНЫ ТРЕБУЕТ НОВЫХ ДЕНЕГ. ИНФЛЯЦИЯ НЕ
Dialogue: 0,0:01:01.96,0:01:05.32,Caption,,0,0,0,,ИСЧЕЗЛА, А ПОКУПАТЕЛЬНАЯ СПОСОБНОСТЬ ЕВРОПЕЙЦЕВ НЕ СТАЛА
Dialogue: 0,0:01:05.32,0:01:08.28,Caption,,0,0,0,,КРЕПЧЕ ОТ ОЧЕРЕДНОГО ЗАЯВЛЕНИЯ О ЕДИНСТВЕ. ПУШКИ
Dialogue: 0,0:01:08.28,0:01:09.88,Caption,,0,0,0,,ХОРОШО ВЫГЛЯДЯТ В РЕЧИ МИНИСТРА.
Dialogue: 0,0:01:12.17,0:01:14.33,Caption,,0,0,0,,МАСЛО ЛЕЖИТ НА ПОЛКЕ ПЕРЕД ПОКУПАТЕЛЕМ,
Dialogue: 0,0:01:14.57,0:01:18.81,Caption,,0,0,0,,И НА ЦЕННИКЕ НЕТ НИ ГИМНА, НИ БАРАБАННОЙ ДРОБИ. ТАМ ПРОСТО СУММА,
Dialogue: 0,0:01:18.89,0:01:20.49,Caption,,0,0,0,,КОТОРУЮ НАДО ЗАПЛАТИТЬ СЕГОДНЯ.
Dialogue: 0,0:01:21.06,0:01:24.81,Caption,,0,0,0,,ПОВЫШАТЬ СТАВКИ УДОБНО, ПОКА РАСХОДЫ ЖИВУТ В ТАБЛИЦЕ У МИНИСТЕРСТВА
Dialogue: 0,0:01:24.81,0:01:27.53,Caption,,0,0,0,,ФИНАНСОВ. КОГДА ОНИ ПРИХОДЯТ К ЧЕЛОВЕКУ В ВИДЕ
Dialogue: 0,0:01:27.53,0:01:31.29,Caption,,0,0,0,,НАЛОГОВ, ДОРОГИХ ПРОДУКТОВ И СОКРАЩЁННЫХ СОЦИАЛЬНЫХ ПРОГРАММ,
Dialogue: 0,0:01:31.85,0:01:35.13,Caption,,0,0,0,,ГЕРОИЧЕСКИЙ ГОЛОС ПОЧЕМУ ТО СТАНОВИТСЯ ТИШЕ. ПРИЧЁМ
Dialogue: 0,0:01:35.19,0:01:37.77,Caption,,0,0,0,,ОДНОЙ ГОТОВНОСТИ ВЫДЕЛИТЬ ДЕНЬГИ УЖЕ НЕДОСТАТОЧНО.
Dialogue: 0,0:01:37.98,0:01:40.41,Caption,,0,0,0,,МОЖНО ВЫБРАТЬ ПУШКИ, УРЕЗАТЬ МАСЛО,
Dialogue: 0,0:01:40.72,0:01:43.61,Caption,,0,0,0,,ВЫСТАВИТЬ СЧЁТ НАСЕЛЕНИЮ И ВСЁ РАВНО ВЫЯСНИТЬ,
Dialogue: 0,0:01:43.83,0:01:46.57,Caption,,0,0,0,,ЧТО НУЖНОГО КОЛИЧЕСТВА ПЕРЕХВАТЧИКОВ КУПИТЬ НЕГДЕ.
Dialogue: 0,0:01:47.21,0:01:49.53,Caption,,0,0,0,,РАЗГОВОР О ВОЗМОЖНОСТЯХ ПОСТЕПЕННО ПРИВЁЛ
Dialogue: 0,0:01:49.53,0:01:52.81,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТОЛИЦЫ К ЕЩЁ ОДНОМУ НЕПРИЯТНОМУ ВЫВОДУ.
Dialogue: 0,0:01:53.17,0:01:56.73,Caption,,0,0,0,,НОРВЕЖСКИЙ ПРЕМЬЕР ЙОНАС ГАР СТЁРЕ ПРОИЗНЁС ТО,
Dialogue: 0,0:01:56.99,0:01:59.29,Caption,,0,0,0,,ЧТО СОВСЕМ НЕДАВНО ТАМ ПРЕДПОЧЛИ БЫ ДАЖЕ НЕ
Dialogue: 0,0:01:59.29,0:02:02.57,Caption,,0,0,0,,ОБСУЖДАТЬ. ИЗОЛИРОВАТЬ РОССИЮ НЕ УДАЛОСЬ. ПО СЛОВАМ
Dialogue: 0,0:02:02.57,0:02:06.17,Caption,,0,0,0,,СТЁРЕ, ОТКАЗ ЕВРОПЫ ОТ ПРЯМОГО РАЗГОВОРА С МОСКВОЙ ПРИВЁЛ
Dialogue: 0,0:02:06.17,0:02:08.41,Caption,,0,0,0,,К СОВЕРШЕННО ПРЕДСКАЗУЕМОМУ РЕЗУЛЬТАТУ.
Dialogue: 0,0:02:08.96,0:02:11.45,Caption,,0,0,0,,РОССИЙСКОЕ РУКОВОДСТВО ТЕПЕРЬ СЛЫШИТ ПРЕЖДЕ ВСЕГО
Dialogue: 0,0:02:11.45,0:02:15.69,Caption,,0,0,0,,ВАШИНГТОН. ЕВРОПЕЙЦЫ ГОДАМИ СОКРАЩАЛИ КОНТАКТЫ И ПРЕДСТАВЛЯЛИ
Dialogue: 0,0:02:15.69,0:02:18.81,Caption,,0,0,0,,ЛЮБОЙ ПРЯМОЙ РАЗГОВОР ПОЧТИ КАК НАРУШЕНИЕ ПРИЛИЧИЙ.
Dialogue: 0,0:02:19.03,0:02:21.69,Caption,,0,0,0,,ПОТОМ ПОСМОТРЕЛИ НА СТОЛ ПЕРЕГОВОРОВ И ОБНАРУЖИЛИ,
Dialogue: 0,0:02:21.93,0:02:24.09,Caption,,0,0,0,,ЧТО ГЛАВНЫЕ МЕСТА ТАМ ЗАНИМАЮТ ТЕ,
Dialogue: 0,0:02:24.36,0:02:27.05,Caption,,0,0,0,,КТО ПРОДОЛЖАЛ ЗВОНИТЬ. ТЕХНОЛОГИЯ ПОРАЗИТЕЛЬНАЯ.
Dialogue: 0,0:02:29.33,0:02:31.17,Caption,,0,0,0,,ЕСЛИ МОЛЧАТЬ В ТРУБКУ ПЯТЬ ЛЕТ,
Dialogue: 0,0:02:31.29,0:02:33.73,Caption,,0,0,0,,СОБЕСЕДНИК ПОЧЕМУ ТО НАЧИНАЕТ ОБСУЖДАТЬ ДЕЛА С
Dialogue: 0,0:02:33.73,0:02:38.13,Caption,,0,0,0,,ДРУГИМ ЧЕЛОВЕКОМ. ТЕПЕРЬ ВАШИНГТОН РАЗГОВАРИВАЕТ С МОСКВОЙ. ФРАНЦИЯ
Dialogue: 0,0:02:38.13,0:02:41.09,Caption,,0,0,0,,ПЫТАЕТСЯ ПОПАСТЬ В ПЕРЕГОВОРНЫЙ ФОРМАТ. НОРВЕЖСКИЙ
Dialogue: 0,0:02:41.09,0:02:44.13,Caption,,0,0,0,,ПРЕМЬЕР ПРИЗНАЁТ ПРОВАЛ ИЗОЛЯЦИИ. ВЕЛИКОБРИТАНИЯ
Dialogue: 0,0:02:44.13,0:02:47.17,Caption,,0,0,0,,ИЩЕТ ОТДЕЛЬНЫЙ КАНАЛ ДЛЯ ВОЕННЫХ. МИНИСТР ОБОРОНЫ
Dialogue: 0,0:02:47.17,0:02:49.17,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ УЭС СТРИТИНГ ГОВОРИТ,
Dialogue: 0,0:02:49.38,0:02:52.45,Caption,,0,0,0,,ЧТО ПОСОЛЬСТВА В МОСКВЕ УЖЕ НЕДОСТАТОЧНО. НУЖНЫ
Dialogue: 0,0:02:52.45,0:02:56.77,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ КАНАЛЫ СВЯЗИ, ОСОБЕННО МЕЖДУ ВОЕННЫМИ. ОБЪЯСНЕНИЕ ПРОСТОЕ
Dialogue: 0,0:02:56.77,0:02:59.65,Caption,,0,0,0,,НЕОБХОДИМО УМЕНЬШИТЬ РИСК ПРОСЧЁТА. КОРАБЛИ
Dialogue: 0,0:02:59.73,0:03:02.61,Caption,,0,0,0,,ДЕЙСТВУЮТ ВСЁ АКТИВНЕЕ. САМОЛЁТЫ ПРИБЛИЖАЮТСЯ ДРУГ К
Dialogue: 0,0:03:02.69,0:03:05.73,Caption,,0,0,0,,ДРУГУ. ПОИСК ПОДЛОДОК СТАНОВИТСЯ ПОСТОЯННОЙ РАБОТОЙ.
Dialogue: 0,0:03:06.02,0:03:08.61,Caption,,0,0,0,,КТО ТО МОЖЕТ НЕВЕРНО ПРОЧИТАТЬ СИГНАЛ ИЛИ СЛИШКОМ
Dialogue: 0,0:03:08.69,0:03:11.81,Caption,,0,0,0,,ПОЗДНО ПОНЯТЬ ЧУЖОЙ МАНЁВР. ПОЭТОМУ НУЖЕН НОМЕР,
Dialogue: 0,0:03:12.00,0:03:14.69,Caption,,0,0,0,,ПО КОТОРОМУ ВОЕННЫЕ БЫСТРО ОБЪЯСНЯТ ДРУГ ДРУГУ,
Dialogue: 0,0:03:14.77,0:03:18.37,Caption,,0,0,0,,ЧТО ИМЕННО ПРОИЗОШЛО. ИДЕЯ РАЗУМНАЯ. СТРАННО ЛИШЬ
Dialogue: 0,0:03:18.37,0:03:21.65,Caption,,0,0,0,,ТО, ЧТО ОНА ПОСЕТИЛА ЛОНДОН НА ПЯТОМ ГОДУ КОНФЛИКТА.
Dialogue: 0,0:03:22.13,0:03:24.53,Caption,,0,0,0,,ДО ЭТОГО ПРЯМОЙ ВОЕННЫЙ ТЕЛЕФОН ПОЧЕМУ ТО НЕ
Dialogue: 0,0:03:24.61,0:03:27.73,Caption,,0,0,0,,СЧИТАЛСЯ СРОЧНОЙ НЕОБХОДИМОСТЬЮ. ОРУЖИЕ ПОСТАВЛЯЛИ.
Dialogue: 0,0:03:28.13,0:03:32.29,Caption,,0,0,0,,ОГРАНИЧЕНИЯ СНИМАЛИ. ТО, ЧТО ВЧЕРА НАЗЫВАЛИ ОПАСНОЙ ЧЕРТОЙ,
Dialogue: 0,0:03:32.53,0:03:35.57,Caption,,0,0,0,,ЗАВТРА ПРЕВРАЩАЛИ В ДОПУСТИМЫЙ ШАГ. А ЕЩЁ ЧЕРЕЗ
Dialogue: 0,0:03:35.57,0:03:39.89,Caption,,0,0,0,,НЕДЕЛЮ УДИВЛЯЛИСЬ, ПОЧЕМУ КТО ТО ВООБЩЕ ПОМНИТ О ПРЕЖНЕМ ЗАПРЕТЕ.
Dialogue: 0,0:03:40.18,0:03:42.77,Caption,,0,0,0,,БРИТАНИЯ ВСЁ ЭТО ВРЕМЯ НАХОДИЛАСЬ НЕ В ЗРИТЕЛЬНОМ
Dialogue: 0,0:03:42.77,0:03:47.53,Caption,,0,0,0,,ЗАЛЕ. В АПРЕЛЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА БОРИС
Dialogue: 0,0:03:47.53,0:03:50.25,Caption,,0,0,0,,ДЖОНСОН ПРИЕХАЛ В КИЕВ И ОБЕЩАЛ НОВУЮ ВОЕННУЮ
Dialogue: 0,0:03:50.25,0:03:53.37,Caption,,0,0,0,,ПОМОЩЬ, БРОНЕТЕХНИКУ И ПРОТИВОКОРАБЕЛЬНЫЕ РАКЕТЫ.
Dialogue: 0,0:03:54.01,0:03:58.01,Caption,,0,0,0,,ПОЗЖЕ ДАВИД АРАХАМИЯ, ВОЗГЛАВЛЯВШИЙ УКРАИНСКУЮ ДЕЛЕГАЦИЮ НА ПЕРЕГОВОРАХ,
Dialogue: 0,0:03:58.34,0:04:00.81,Caption,,0,0,0,,РАССКАЗЫВАЛ О ПОЗИЦИИ ДЖОНСОНА ПОСЛЕ СТАМБУЛА
Dialogue: 0,0:04:00.81,0:04:03.93,Caption,,0,0,0,,ПРЕДЕЛЬНО ПРЯМО С РОССИЕЙ НИЧЕГО НЕ ПОДПИСЫВАТЬ И
Dialogue: 0,0:04:03.93,0:04:06.73,Caption,,0,0,0,,ПРОДОЛЖАТЬ ВОЕВАТЬ. ЛОНДОН С САМОГО НАЧАЛА
Dialogue: 0,0:04:06.73,0:04:09.69,Caption,,0,0,0,,ПОДДЕРЖИВАЛ ПРОДОЛЖЕНИЕ ВООРУЖЁННОГО СОПРОТИВЛЕНИЯ И
Dialogue: 0,0:04:09.69,0:04:13.05,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОЕ УВЕЛИЧЕНИЕ ВОЕННОЙ ПОМОЩИ. ПОЗИЦИЯ
Dialogue: 0,0:04:13.13,0:04:17.61,Caption,,0,0,0,,НЕ МЕНЯЛАСЬ КАЖДЫЙ РАЗ, КОГДА ВОЗРАСТАЛ РИСК. МЕНЯЛСЯ ТОЛЬКО УРОВЕНЬ ЭТОГО
Dialogue: 0,0:04:17.61,0:04:20.57,Caption,,0,0,0,,РИСКА. ТЕПЕРЬ ТА ЖЕ СТОЛИЦА ПРЕДЛАГАЕТ СРОЧНО
Dialogue: 0,0:04:20.57,0:04:23.85,Caption,,0,0,0,,ПРОВЕСТИ ОТДЕЛЬНУЮ ТЕЛЕФОННУЮ ЛИНИЮ. ЭТО НЕ РАЗВОРОТ
Dialogue: 0,0:04:23.99,0:04:26.89,Caption,,0,0,0,,И НЕ ОТКАЗ ОТ ПРЕЖНЕГО КУРСА. ПОСТАВКИ ОРУЖИЯ
Dialogue: 0,0:04:26.89,0:04:30.25,Caption,,0,0,0,,ПРОДОЛЖАЮТСЯ. МОРСКИЕ ОБЪЕДИНЕНИЯ РАСШИРЯЮТ РАБОТУ.
Dialogue: 0,0:04:30.54,0:04:33.21,Caption,,0,0,0,,ПРОТИВОЛОДОЧНЫЕ УЧЕНИЯ СТАНОВЯТСЯ ПОСТОЯННЫМИ.
Dialogue: 0,0:04:33.38,0:04:35.45,Caption,,0,0,0,,ОДНОВРЕМЕННО РЯДОМ КЛАДУТ ТЕЛЕФОН,
Dialogue: 0,0:04:35.56,0:04:37.45,Caption,,0,0,0,,КАК ГАРАНТИЙНЫЙ ТАЛОН К ПРИБОРУ,
Dialogue: 0,0:04:37.69,0:04:40.49,Caption,,0,0,0,,КОТОРЫЙ УЖЕ НАЧАЛ ПОДОЗРИТЕЛЬНО ПАХНУТЬ. У ЭТОГО
Dialogue: 0,0:04:40.49,0:04:43.93,Caption,,0,0,0,,ТЕЛЕФОНА ЕСТЬ ЕЩЁ ОДНА УДОБНАЯ ФУНКЦИЯ. ЕСЛИ ОТВЕТ
Dialogue: 0,0:04:43.93,0:04:46.41,Caption,,0,0,0,,ОДНАЖДЫ НАПРАВИТСЯ УЖЕ В СТОРОНУ ВЕЛИКОБРИТАНИИ,
Dialogue: 0,0:04:46.65,0:04:49.77,Caption,,0,0,0,,ЛОНДОН СМОЖЕТ БЫСТРО ОБЪЯСНИТЬ ОРУЖИЕ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:49.85,0:04:53.13,Caption,,0,0,0,,ДАЛИ МЫ, НО ЗАПУСКАЛИ УКРАИНЦЫ. СЛЕДОВАТЕЛЬНО,
Dialogue: 0,0:04:53.27,0:04:55.45,Caption,,0,0,0,,ПРЕТЕНЗИИ СЛЕДУЕТ ПРЕДЪЯВЛЯТЬ КИЕВУ,
Dialogue: 0,0:04:55.61,0:04:58.09,Caption,,0,0,0,,А БРИТАНЦЕВ ПРОСИМ СЧИТАТЬ ПОЧТИ ПОСТОРОННИМИ
Dialogue: 0,0:04:58.09,0:05:02.54,Caption,,0,0,0,,СВИДЕТЕЛЯМИ. СТАВКИ ПОДНИМАЕТ ОДИН,
Dialogue: 0,0:05:02.78,0:05:06.94,Caption,,0,0,0,,КНОПКУ НАЖИМАЕТ ДРУГОЙ, А ПЛАТИТЬ ЗА ПОСЛЕДСТВИЯ ЖЕЛАТЕЛЬНО ТРЕТЬЕМУ.
Dialogue: 0,0:05:07.20,0:05:10.86,Caption,,0,0,0,,НАСТОЯЩЕЕ МЕЖДУНАРОДНОЕ РАЗДЕЛЕНИЕ ТРУДА. ПЯТЬ ЛЕТ
Dialogue: 0,0:05:10.86,0:05:12.78,Caption,,0,0,0,,ЛОНДОН ОБХОДИЛСЯ БЕЗ ПРЯМОЙ СВЯЗИ,
Dialogue: 0,0:05:12.95,0:05:15.82,Caption,,0,0,0,,ПОКА ДВИГАЛ ГРАНИЦЫ ДОПУСТИМОГО. ТЕПЕРЬ ГРАНИЦЫ
Dialogue: 0,0:05:15.82,0:05:19.26,Caption,,0,0,0,,ПОДОШЛИ К МЕСТУ, ГДЕ ХОТЕЛОСЬ БЫ ИМЕТЬ ВОЗМОЖНОСТЬ НЕМЕДЛЕННО
Dialogue: 0,0:05:19.26,0:05:24.14,Caption,,0,0,0,,ПОЗВОНИТЬ И СООБЩИТЬ, ЧТО ВСЁ ПОНЯЛИ НЕПРАВИЛЬНО. РАЗРЫВ МЕЖДУ ЗАЯВЛЕНИЯМИ
Dialogue: 0,0:05:24.22,0:05:26.94,Caption,,0,0,0,,И РЕАЛЬНЫМИ ВОЗМОЖНОСТЯМИ ОСОБЕННО ХОРОШО ВИДЕН
Dialogue: 0,0:05:26.94,0:05:30.22,Caption,,0,0,0,,ВНУТРИ САМОЙ БРИТАНИИ. НАЧАЛЬНИК БРИТАНСКОГО ШТАБА
Dialogue: 0,0:05:30.22,0:05:32.14,Caption,,0,0,0,,ОБОРОНЫ РИЧАРД НАЙТОН ПРИЗНАЁТ,
Dialogue: 0,0:05:32.38,0:05:35.42,Caption,,0,0,0,,ЧТО ВЕЛИКОБРИТАНИЯ ОТСТАЁТ ОТ ЕВРОПЕЙСКИХ СОЮЗНИКОВ
Dialogue: 0,0:05:35.50,0:05:38.62,Caption,,0,0,0,,ПО ГОТОВНОСТИ К ПРОТИВОСТОЯНИЮ С РОССИЕЙ. ДЕНЕГ НА
Dialogue: 0,0:05:38.62,0:05:42.38,Caption,,0,0,0,,ОБОРОНУ НУЖНО БОЛЬШЕ, ВОЗМОЖНОСТИ АРМИИ ТРЕБУЕТСЯ РАСШИРЯТЬ,
Dialogue: 0,0:05:42.62,0:05:44.38,Caption,,0,0,0,,А ЗАПАС ПРОЧНОСТИ ПОКА НЕ ТОТ,
Dialogue: 0,0:05:44.62,0:05:46.78,Caption,,0,0,0,,КОТОРЫЙ ХОТЕЛОСЬ БЫ ПОКАЗЫВАТЬ ОКРУЖАЮЩИМ.
Dialogue: 0,0:05:47.00,0:05:49.74,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЛЮБОПЫТНЫЙ ПОРЯДОК ДЕЙСТВИЙ. СНАЧАЛА
Dialogue: 0,0:05:49.74,0:05:53.74,Caption,,0,0,0,,ЛОНДОН БЕРЁТСЯ РУКОВОДИТЬ, СОБИРАТЬ СОЮЗНИКОВ И ОБЪЯСНЯТЬ ЕВРОПЕ,
Dialogue: 0,0:05:53.99,0:05:57.10,Caption,,0,0,0,,КАК НАДО ДЕРЖАТЬ СТРОЙ. ПОТОМ СОБСТВЕННЫЙ ВОЕННЫЙ
Dialogue: 0,0:05:57.10,0:06:00.78,Caption,,0,0,0,,НАЧАЛЬНИК НАПОМИНАЕТ, ЧТО СТРОЙ НЕПЛОХО БЫЛО БЫ УКРЕПИТЬ И ДОМА.
Dialogue: 0,0:06:01.09,0:06:03.34,Caption,,0,0,0,,НА СЛУЧАЙ, ЕСЛИ УКРЕПЛЕНИЕ НЕ ПОМОЖЕТ,
Dialogue: 0,0:06:03.58,0:06:06.86,Caption,,0,0,0,,В БРИТАНИИ УЖЕ РАССЧИТАЛИ, СКОЛЬКО СТРАНА ДОЛЖНА ПРОЖИТЬ,
Dialogue: 0,0:06:07.02,0:06:09.98,Caption,,0,0,0,,ЕСЛИ ОДНАЖДЫ ПОГАСНЕТ СВЕТ. РАДИО ОБЯЗАНО
Dialogue: 0,0:06:09.98,0:06:14.82,Caption,,0,0,0,,ПРОДЕРЖАТЬСЯ ТРОЕ СУТОК. ЗАПАСОВ ВОДЫ,
Dialogue: 0,0:06:14.90,0:06:18.66,Caption,,0,0,0,,ЕДЫ И ЛЕКАРСТВ НАСЕЛЕНИЮ ТОЖЕ СОВЕТУЮТ ИМЕТЬ МИНИМУМ
Dialogue: 0,0:06:18.74,0:06:22.26,Caption,,0,0,0,,НА ТРИ ДНЯ. МОБИЛЬНУЮ СВЯЗЬ СОБИРАЮТСЯ СПАСАТЬ ЛЕТАЮЩИМИ
Dialogue: 0,0:06:22.26,0:06:26.10,Caption,,0,0,0,,ВЫШКАМИ, НА КОТОРЫЕ ВЫДЕЛЯЮТ СЕМЬДЕСЯТ МИЛЛИОНОВ ФУНТОВ. В
Dialogue: 0,0:06:26.10,0:06:29.22,Caption,,0,0,0,,НЕБЕ ОНИ ДОЛЖНЫ ВИСЕТЬ ДО НЕДЕЛИ. ПЛАН НАЗЫВАЕТСЯ
Dialogue: 0,0:06:29.34,0:06:31.78,Caption,,0,0,0,,"ЧЁРНОЕ НЕБО". НАЗВАНИЕ БОДРОЕ,
Dialogue: 0,0:06:31.94,0:06:34.58,Caption,,0,0,0,,ПОЧТИ ТУРИСТИЧЕСКОЕ. НЕ ХВАТАЕТ ТОЛЬКО СОВЕТА
Dialogue: 0,0:06:34.58,0:06:37.54,Caption,,0,0,0,,ЗАХВАТИТЬ ПЛЕД И ТЕРМОС. НО ЭТО НЕ СЦЕНАРИЙ
Dialogue: 0,0:06:37.54,0:06:40.50,Caption,,0,0,0,,ДЛЯ СЕРИАЛА. БРИТАНСКИЕ ВЛАСТИ ВСЕРЬЁЗ ГОТОВЯТСЯ К
Dialogue: 0,0:06:40.58,0:06:43.38,Caption,,0,0,0,,БОЛЬШОМУ ОТКЛЮЧЕНИЮ ЭЛЕКТРИЧЕСТВА И ЗАРАНЕЕ СЧИТАЮТ,
Dialogue: 0,0:06:43.56,0:06:46.10,Caption,,0,0,0,,СКОЛЬКО ЧАСОВ СТРАНА СМОЖЕТ СЛЫШАТЬ РАДИО,
Dialogue: 0,0:06:46.36,0:06:49.06,Caption,,0,0,0,,СКОЛЬКО ДНЕЙ ПРОТЯНЕТ СВЯЗЬ И КОГДА У ЛЮДЕЙ
Dialogue: 0,0:06:49.06,0:06:52.82,Caption,,0,0,0,,ЗАКОНЧИТСЯ ВОДА. СЛОВА О ГОТОВНОСТИ К ПРОТИВОСТОЯНИЮ ЗДЕСЬ
Dialogue: 0,0:06:52.82,0:06:55.46,Caption,,0,0,0,,ПЕРЕВОДЯТСЯ НА ЯЗЫК ВПОЛНЕ БЫТОВЫХ ВОЗМОЖНОСТЕЙ.
Dialogue: 0,0:06:55.68,0:06:58.34,Caption,,0,0,0,,ПОКА ГОСУДАРСТВО ОБЕЩАЕТ РАСШИРЯТЬ ВОЕННУЮ РОЛЬ,
Dialogue: 0,0:06:58.66,0:07:02.90,Caption,,0,0,0,,НАСЕЛЕНИЮ ОБЪЯСНЯЮТ, СКОЛЬКО ЕДЫ ХРАНИТЬ ДОМА И КАК ДОЛГО ЖДАТЬ
Dialogue: 0,0:07:02.90,0:07:07.30,Caption,,0,0,0,,ВОЗВРАЩЕНИЯ СВЕТА. ПОСЛЕ БРИТАНИИ ПОХОЖИЙ РАЗРЫВ ОБНАРУЖИВАЕТСЯ И В
Dialogue: 0,0:07:07.30,0:07:10.50,Caption,,0,0,0,,ДРУГИХ ЕВРОПЕЙСКИХ СТРАНАХ. НЕДОСТАЮЩИЕ ВОЗМОЖНОСТИ
Dialogue: 0,0:07:10.50,0:07:12.90,Caption,,0,0,0,,ТАМ ПЫТАЮТСЯ КОМПЕНСИРОВАТЬ АДМИНИСТРАТИВНЫМ
Dialogue: 0,0:07:12.90,0:07:15.78,Caption,,0,0,0,,УСЕРДИЕМ. ЛИТВА РЕШИЛА ЗАДЕРЖИВАТЬ РОССИЙСКОЕ И
Dialogue: 0,0:07:15.78,0:07:18.50,Caption,,0,0,0,,БЕЛОРУССКОЕ ЗЕРНО, ПРОХОДЯЩЕЕ ЧЕРЕЗ КЛАЙПЕДУ,
Dialogue: 0,0:07:18.75,0:07:21.30,Caption,,0,0,0,,ПОКА НЕ ЗАВЕРШИТСЯ ПРОВЕРКА ПРОИСХОЖДЕНИЯ ГРУЗА.
Dialogue: 0,0:07:21.73,0:07:24.10,Caption,,0,0,0,,ТАКАЯ ПРОВЕРКА МОЖЕТ ЗАНЯТЬ ДВА МЕСЯЦА И ДАЖЕ
Dialogue: 0,0:07:24.18,0:07:27.06,Caption,,0,0,0,,БОЛЬШЕ. СОБСТВЕННОЙ ЛАБОРАТОРИИ ДЛЯ АНАЛИЗА У ЛИТВЫ
Dialogue: 0,0:07:27.06,0:07:31.42,Caption,,0,0,0,,НЕТ. ОБРАЗЦЫ ОТПРАВЛЯЮТ ЗА ГРАНИЦУ,
Dialogue: 0,0:07:31.66,0:07:34.62,Caption,,0,0,0,,А ЗЕРНО ТЕМ ВРЕМЕНЕМ ЖДЁТ. ХРАНЕНИЕ ОПЛАЧИВАЕТ
Dialogue: 0,0:07:34.62,0:07:38.06,Caption,,0,0,0,,ЭКСПОРТЁР. ИССЛЕДОВАНИЕ ТОЖЕ ОПЛАЧИВАЕТ ОН. ЕСЛИ
Dialogue: 0,0:07:38.06,0:07:40.38,Caption,,0,0,0,,ПРОИСХОЖДЕНИЕ СОЧТУТ УКАЗАННЫМ НЕВЕРНО,
Dialogue: 0,0:07:40.70,0:07:43.74,Caption,,0,0,0,,ГРУЗ ПРИДЁТСЯ ВЕРНУТЬ ИЛИ УНИЧТОЖИТЬ. ОЧЕНЬ УДОБНЫЙ
Dialogue: 0,0:07:43.74,0:07:46.22,Caption,,0,0,0,,СПОСОБ ПЕРЕКРЫТЬ ДОРОГУ, ПРОДОЛЖАЯ УВЕРЯТЬ,
Dialogue: 0,0:07:46.46,0:07:48.38,Caption,,0,0,0,,ЧТО ШЛАГБАУМ ОТКРЫТ. ПРОЕЗЖАЙТЕ,
Dialogue: 0,0:07:48.50,0:07:50.78,Caption,,0,0,0,,ПОЖАЛУЙСТА. КАК ТОЛЬКО ДОЖДЁТЕСЬ РЕЗУЛЬТАТА,
Dialogue: 0,0:07:50.98,0:07:54.22,Caption,,0,0,0,,ОПЛАТИТЕ СКЛАД И ПЕРЕЖИВЁТЕ НЕСКОЛЬКО МЕСЯЦЕВ. В
Dialogue: 0,0:07:54.22,0:07:56.38,Caption,,0,0,0,,ЭСТОНИИ ЛИНИЯ ПРОТИВОСТОЯНИЯ ДОБРАЛАСЬ ДО
Dialogue: 0,0:07:56.38,0:08:00.46,Caption,,0,0,0,,ХОЛОДИЛЬНИКОВ. ГЛАВА МВД ИГОРЬ ТАРО ОБВИНИЛ РОССИЮ В
Dialogue: 0,0:08:00.46,0:08:03.10,Caption,,0,0,0,,ДИВЕРСИЯХ И ВСПОМНИЛ КИБЕРАТАКИ НА СУПЕРМАРКЕТЫ.
Dialogue: 0,0:08:03.58,0:08:06.06,Caption,,0,0,0,,ПОСЛЕ ЭТИХ АТАК В НЕСКОЛЬКИХ ЕВРОПЕЙСКИХ СТРАНАХ
Dialogue: 0,0:08:06.06,0:08:08.70,Caption,,0,0,0,,ХОЛОДИЛЬНЫЕ СИСТЕМЫ ПЕРЕСТАЛИ НОРМАЛЬНО РАБОТАТЬ.
Dialogue: 0,0:08:09.02,0:08:11.42,Caption,,0,0,0,,ПРИЧАСТНОСТЬ МОСКВЫ ИМЕННО К ЭТИМ ЭПИЗОДАМ НЕ
Dialogue: 0,0:08:11.42,0:08:15.34,Caption,,0,0,0,,ДОКАЗАНА. ОДНАКО ТЯЖЁЛЫЕ ВЫВОДЫ УЖЕ ГОТОВЫ. РОССИЯ
Dialogue: 0,0:08:15.34,0:08:17.50,Caption,,0,0,0,,НАЗВАНА ГЛАВНОЙ УГРОЗОЙ ЕВРОПЕ,
Dialogue: 0,0:08:17.82,0:08:20.62,Caption,,0,0,0,,ЗВУЧАТ ОБВИНЕНИЯ В ГОСУДАРСТВЕННОМ ТЕРРОРИЗМЕ И
Dialogue: 0,0:08:20.62,0:08:23.98,Caption,,0,0,0,,ПОСТОЯННЫХ АТАКАХ НА КРИТИЧЕСКУЮ ИНФРАСТРУКТУРУ НИЖЕ
Dialogue: 0,0:08:24.06,0:08:27.98,Caption,,0,0,0,,ПОРОГА ОТКРЫТОЙ ВОЙНЫ. ВО ФРАНЦИИ ПОХОЖАЯ СКОРОСТЬ НАБЛЮДАЕТСЯ НА
Dialogue: 0,0:08:27.98,0:08:31.66,Caption,,0,0,0,,ИНФОРМАЦИОННОМ НАПРАВЛЕНИИ. ВО ВНУТРЕННЕМ ДОКЛАДЕ ЕВРОСОЮЗА,
Dialogue: 0,0:08:31.90,0:08:33.58,Caption,,0,0,0,,КОТОРЫЙ ИЗУЧИЛО АГЕНТСТВО РЕЙТЕР,
Dialogue: 0,0:08:33.90,0:08:37.10,Caption,,0,0,0,,ОПИСАНА СЕТЬ "ОПЕРАЦИЯ ПЕРЕГРУЗКА". ЕЙ ПРИПИСЫВАЮТ
Dialogue: 0,0:08:37.10,0:08:39.82,Caption,,0,0,0,,РАСПРОСТРАНЕНИЕ ПОДДЕЛЬНЫХ РЕПОРТАЖЕЙ ЗАПАДНЫХ
Dialogue: 0,0:08:39.90,0:08:42.38,Caption,,0,0,0,,СРЕДСТВ МАССОВОЙ ИНФОРМАЦИИ ВО ВРЕМЯ ФРАНЦУЗСКИХ
Dialogue: 0,0:08:42.38,0:08:48.35,Caption,,0,0,0,,БЕСПОРЯДКОВ. ЧЕРЕЗ ЭТИ МАТЕРИАЛЫ РАЗГОНЯЛИ ИСТОРИИ О МИГРАНТАХ,
Dialogue: 0,0:08:48.51,0:08:52.11,Caption,,0,0,0,,НАСИЛИИ И ГОТОВЯЩИХСЯ НАПАДЕНИЯХ. НО ЦИФРЫ В САМОМ
Dialogue: 0,0:08:52.19,0:08:54.43,Caption,,0,0,0,,ДОКЛАДЕ ПОРТЯТ СЛИШКОМ УДОБНУЮ КАРТИНУ.
Dialogue: 0,0:08:54.99,0:08:57.95,Caption,,0,0,0,,ЗА НЕСКОЛЬКО ДНЕЙ ДЕСЯТЬ САМЫХ ПОПУЛЯРНЫХ ПУБЛИКАЦИЙ
Dialogue: 0,0:08:57.95,0:09:00.27,Caption,,0,0,0,,АККАУНТОВ, СВЯЗАННЫХ С ДВИЖЕНИЕМ МАГА,
Dialogue: 0,0:09:00.51,0:09:02.91,Caption,,0,0,0,,ПОЛУЧИЛИ СОРОК ДЕВЯТЬ МИЛЛИОНОВ ПРОСМОТРОВ.
Dialogue: 0,0:09:03.39,0:09:05.63,Caption,,0,0,0,,ИЗРАИЛЬСКИЕ АККАУНТЫ СОБРАЛИ ТРИДЦАТЬ ПЯТЬ
Dialogue: 0,0:09:05.63,0:09:08.43,Caption,,0,0,0,,МИЛЛИОНОВ. НА ПРОРОССИЙСКИЕ ПРИШЛОСЬ ДВА ЦЕЛЫХ
Dialogue: 0,0:09:08.43,0:09:11.07,Caption,,0,0,0,,ВОСЕМЬ ДЕСЯТЫХ МИЛЛИОНА. ЭКСПЕРТЫ ТАКЖЕ НЕ
Dialogue: 0,0:09:11.07,0:09:14.67,Caption,,0,0,0,,УСТАНОВИЛИ, ЧТО ИНОСТРАННЫЕ СИЛЫ ОРГАНИЗОВАЛИ ФРАНЦУЗСКИЕ
Dialogue: 0,0:09:14.67,0:09:17.63,Caption,,0,0,0,,ПРОТЕСТЫ ИЛИ ДОВЕЛИ ИХ ДО НЫНЕШНЕГО МАСШТАБА.
Dialogue: 0,0:09:17.98,0:09:20.27,Caption,,0,0,0,,ФРАНЦУЗАМ НЕ НУЖЕН ЗАРУБЕЖНЫЙ РЕЖИССЁР,
Dialogue: 0,0:09:20.43,0:09:23.15,Caption,,0,0,0,,ЧТОБЫ ВЫЙТИ НА УЛИЦУ. У НИХ ЕСТЬ ЦЕНЫ,
Dialogue: 0,0:09:23.23,0:09:27.47,Caption,,0,0,0,,ЗАРПЛАТЫ, ШКОЛЫ И СОБСТВЕННОЕ ПРАВИТЕЛЬСТВО. НАБОР ВПОЛНЕ
Dialogue: 0,0:09:27.47,0:09:32.19,Caption,,0,0,0,,ДОСТАТОЧНЫЙ, ДАЖЕ С ЗАПАСОМ. ТРИ СТРАНЫ ПОКАЗЫВАЮТ ТРИ СПОСОБА
Dialogue: 0,0:09:32.19,0:09:35.55,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ ОЩУЩЕНИЕ ОСАЖДЁННОЙ КРЕПОСТИ. ЛИТВА
Dialogue: 0,0:09:35.55,0:09:39.31,Caption,,0,0,0,,ЗАДЕРЖИВАЕТ ЗЕРНО, ЭСТОНИЯ СВЯЗЫВАЕТ НЕИСПРАВНЫЕ ХОЛОДИЛЬНИКИ С
Dialogue: 0,0:09:39.31,0:09:43.07,Caption,,0,0,0,,ДИВЕРСИЯМИ, ФРАНЦИЯ ИЩЕТ ИНОСТРАННУЮ СЕТЬ ЗА БЕСПОРЯДКАМИ.
Dialogue: 0,0:09:43.55,0:09:45.63,Caption,,0,0,0,,МАТЕРИАЛЬНЫЕ ДОКАЗАТЕЛЬСТВА ВЕЗДЕ РАЗНЫЕ,
Dialogue: 0,0:09:45.87,0:09:48.43,Caption,,0,0,0,,ЗАТО ПОЛИТИЧЕСКИЙ ВЫВОД ПОЯВЛЯЕТСЯ С ОДИНАКОВОЙ
Dialogue: 0,0:09:48.43,0:09:51.47,Caption,,0,0,0,,СКОРОСТЬЮ. ЕСЛИ ВАМ БЛИЗОК ТАКОЙ ВЗГЛЯД НА НОВОСТИ,
Dialogue: 0,0:09:51.59,0:09:54.99,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ОДНА ДЕТАЛЬ ЧАСТО КАЖЕТСЯ СЛУЧАЙНОСТЬЮ,
Dialogue: 0,0:09:55.15,0:09:57.79,Caption,,0,0,0,,ПОКА РЯДОМ НЕ ПОЯВЛЯЮТСЯ ЕЩЁ ДЕВЯТЬ ТАКИХ ЖЕ
Dialogue: 0,0:09:57.79,0:10:02.46,Caption,,0,0,0,,СЛУЧАЙНОСТЕЙ. И ВСЁ ЭТО ПРОИСХОДИТ В МОМЕНТ,
Dialogue: 0,0:10:02.76,0:10:05.58,Caption,,0,0,0,,КОГДА ПОДГОТОВКА К ПРОТИВОСТОЯНИЮ НЕ УМЕНЬШАЕТСЯ НИ
Dialogue: 0,0:10:05.66,0:10:08.06,Caption,,0,0,0,,НА ШАГ. ВОЕННЫЕ БЮДЖЕТЫ РАСТУТ,
Dialogue: 0,0:10:08.31,0:10:10.38,Caption,,0,0,0,,ПРОИЗВОДСТВО ПЕРЕХВАТЧИКОВ ОТСТАЁТ,
Dialogue: 0,0:10:10.70,0:10:13.34,Caption,,0,0,0,,А ЕВРОПЕЙСКИЙ ПОКУПАТЕЛЬ ВСЁ ВНИМАТЕЛЬНЕЕ СМОТРИТ НА
Dialogue: 0,0:10:13.34,0:10:16.70,Caption,,0,0,0,,СТОИМОСТЬ МАСЛА. ЕВРОПА САМА УБРАЛА СЕБЯ ИЗ ВАЖНОГО
Dialogue: 0,0:10:16.70,0:10:19.98,Caption,,0,0,0,,РАЗГОВОРА, А ТЕПЕРЬ ПЫТАЕТСЯ ВЕРНУТЬСЯ ТУДА ЧЕРЕЗ БОКОВЫЕ
Dialogue: 0,0:10:19.98,0:10:23.50,Caption,,0,0,0,,ДВЕРИ. У ФРАНЦИИ СВОЙ ВХОД. У НОРВЕГИИ НЕПРИЯТНОЕ
Dialogue: 0,0:10:23.50,0:10:27.26,Caption,,0,0,0,,ПРИЗНАНИЕ. У ЛОНДОНА ТЕЛЕФОН. ПРИ ЭТОМ ПРЕЖНЮЮ ЛИНИЮ
Dialogue: 0,0:10:27.26,0:10:30.54,Caption,,0,0,0,,НИКТО ОТМЕНЯТЬ НЕ СОБИРАЕТСЯ. УЧЕНИЯ ПРОВОДЯТ ЧАЩЕ,
Dialogue: 0,0:10:30.70,0:10:35.02,Caption,,0,0,0,,ЗАГРАЖДЕНИЯ УДЛИНЯЮТ, А ОБОРОННЫЕ РАСХОДЫ НАМЕРЕНЫ ПОДНИМАТЬ ДАЛЬШЕ.
Dialogue: 0,0:10:35.58,0:10:38.54,Caption,,0,0,0,,ЭТО НЕ ДВИЖЕНИЕ К СНИЖЕНИЮ НАПРЯЖЕНИЯ. ЭТО ПОПЫТКА
Dialogue: 0,0:10:38.54,0:10:40.78,Caption,,0,0,0,,НАУЧИТЬСЯ ЖИТЬ РЯДОМ С НАПРЯЖЕНИЕМ,
Dialogue: 0,0:10:40.94,0:10:43.90,Caption,,0,0,0,,КОТОРОЕ САМИ ЖЕ ПРОДОЛЖАЮТ УВЕЛИЧИВАТЬ. СНАЧАЛА В
Dialogue: 0,0:10:43.90,0:10:46.94,Caption,,0,0,0,,КОМНАТУ ПРИНОСЯТ ОРУЖИЕ, ЗАТЕМ ДОБАВЛЯЮТ ЛЮДЕЙ,
Dialogue: 0,0:10:47.17,0:10:50.30,Caption,,0,0,0,,ПОТОМ ЗАПИРАЮТ ОКНА И НАКОНЕЦ ВСПОМИНАЮТ,
Dialogue: 0,0:10:50.47,0:10:53.58,Caption,,0,0,0,,ЧТО НА СТЕНЕ ДОЛЖЕН ВИСЕТЬ НОМЕР АВАРИЙНОЙ СЛУЖБЫ.
Dialogue: 0,0:10:54.61,0:10:57.58,Caption,,0,0,0,,НА СУШЕ НАПРАВЛЕНИЕ ЭТОГО ДВИЖЕНИЯ ОСОБЕННО НАГЛЯДНО
Dialogue: 0,0:10:57.58,0:11:00.70,Caption,,0,0,0,,ПОКАЗЫВАЕТ ФИНЛЯНДИЯ. ФИНСКАЯ АРМИЯ ИЗУЧАЕТ
Dialogue: 0,0:11:00.70,0:11:03.66,Caption,,0,0,0,,УКРАИНСКИЙ ОПЫТ СТРОИТЕЛЬСТВА ПРОТИВОТАНКОВЫХ РВОВ И
Dialogue: 0,0:11:03.66,0:11:06.94,Caption,,0,0,0,,ПРЕПЯТСТВИЙ. КОМАНДУЮЩИЙ СУХОПУТНЫМИ ВОЙСКАМИ ПАССИ
Dialogue: 0,0:11:06.94,0:11:10.86,Caption,,0,0,0,,ВЯЛИМЯКИ ГОВОРИТ, ЧТО ЭТИ РЕШЕНИЯ ХОТЯТ ПРИСПОСОБИТЬ К СЕВЕРНОМУ
Dialogue: 0,0:11:10.94,0:11:13.90,Caption,,0,0,0,,КЛИМАТУ. У ФИНЛЯНДИИ ОКОЛО ОДНОЙ ТЫСЯЧИ ТРЁХСОТ
Dialogue: 0,0:11:13.90,0:11:15.90,Caption,,0,0,0,,СОРОКА КИЛОМЕТРОВ ГРАНИЦЫ С РОССИЕЙ.
Dialogue: 0,0:11:18.18,0:11:20.90,Caption,,0,0,0,,ПРИМЕРНО ДВЕСТИ КИЛОМЕТРОВ ПОГРАНИЧНОГО ЗАГРАЖДЕНИЯ
Dialogue: 0,0:11:20.90,0:11:23.94,Caption,,0,0,0,,УЖЕ ПОСТРОЕНО. СТОИМОСТЬ ПРОЕКТА СОСТАВЛЯЕТ ОКОЛО
Dialogue: 0,0:11:23.94,0:11:27.22,Caption,,0,0,0,,ТРЁХСОТ ШЕСТИДЕСЯТИ ПЯТИ МИЛЛИОНОВ ЕВРО. ТЕПЕРЬ РЕЧЬ
Dialogue: 0,0:11:27.22,0:11:30.42,Caption,,0,0,0,,ИДЁТ ОБ ИНЖЕНЕРНОЙ ОБОРОНЕ ДРУГОГО УРОВНЯ. ФИНСКИЕ
Dialogue: 0,0:11:30.42,0:11:33.62,Caption,,0,0,0,,СПЕЦИАЛИСТЫ СМОТРЯТ, КАК РАБОТАЮТ УКРАИНСКИЕ РВЫ,
Dialogue: 0,0:11:33.78,0:11:36.42,Caption,,0,0,0,,И РЕШАЮТ, ЧТО ИЗ ЭТОГО ВЫДЕРЖИТ СНЕГ,
Dialogue: 0,0:11:36.57,0:11:39.54,Caption,,0,0,0,,МОРОЗ И СЕВЕРНУЮ ПОЧВУ. ЭТО УЖЕ НЕ РАЗГОВОР
Dialogue: 0,0:11:39.54,0:11:42.82,Caption,,0,0,0,,О ТОМ, СЛУЧИТСЯ ЛИ ЧТО ТО ЗАВТРА УТРОМ. ЭТО НАПРАВЛЕНИЕ
Dialogue: 0,0:11:42.82,0:11:45.46,Caption,,0,0,0,,ДВИЖЕНИЯ. УКРЕПЛЕНИЯ НЕ РАЗБИРАЮТ,
Dialogue: 0,0:11:45.74,0:11:49.06,Caption,,0,0,0,,А ДОПОЛНЯЮТ. ВОЕННУЮ ИНФРАСТРУКТУРУ НЕ СВОРАЧИВАЮТ,
Dialogue: 0,0:11:49.30,0:11:51.30,Caption,,0,0,0,,А ГОТОВЯТ К БОЛЕЕ ТЯЖЁЛОМУ СЦЕНАРИЮ.
Dialogue: 0,0:11:51.94,0:11:54.26,Caption,,0,0,0,,НА МОРЕ ТОТ ЖЕ КУРС ПОЛУЧАЕТ МЕЖДУНАРОДНОЕ
Dialogue: 0,0:11:54.26,0:11:57.22,Caption,,0,0,0,,ОФОРМЛЕНИЕ. ВЕЛИКОБРИТАНИЯ ВМЕСТЕ С СОЮЗНИКАМИ
Dialogue: 0,0:11:57.38,0:11:59.94,Caption,,0,0,0,,РАЗРАБАТЫВАЕТ НОВОЕ СОГЛАШЕНИЕ ПО БОРЬБЕ С
Dialogue: 0,0:11:59.94,0:12:02.34,Caption,,0,0,0,,РОССИЙСКИМИ ПОДЛОДКАМИ В СЕВЕРНОЙ АТЛАНТИКЕ,
Dialogue: 0,0:12:02.57,0:12:05.70,Caption,,0,0,0,,АРКТИКЕ И БАЛТИЙСКОМ МОРЕ. РАБОТА ИДЁТ В РАМКАХ
Dialogue: 0,0:12:05.78,0:12:08.26,Caption,,0,0,0,,ОБЪЕДИНЁННЫХ ЭКСПЕДИЦИОННЫХ СИЛ ПОД РУКОВОДСТВОМ
Dialogue: 0,0:12:08.26,0:12:11.30,Caption,,0,0,0,,ЛОНДОНА. В ОБЪЕДИНЕНИЕ ВХОДЯТ ДЕСЯТЬ ГОСУДАРСТВ.
Dialogue: 0,0:12:11.54,0:12:14.58,Caption,,0,0,0,,ЦЕЛЬ СФОРМУЛИРОВАНА БЕЗ ЗАГАДОК. НУЖНО ЗАЩИЩАТЬ
Dialogue: 0,0:12:14.58,0:12:17.46,Caption,,0,0,0,,СУДОХОДСТВО И УСИЛИВАТЬ ПРОТИВОЛОДОЧНУЮ ДЕЯТЕЛЬНОСТЬ
Dialogue: 0,0:12:17.54,0:12:20.42,Caption,,0,0,0,,НА СЛУЧАЙ БОЛЬШОГО КОНФЛИКТА. СОГЛАШЕНИЕ СОБИРАЮТСЯ
Dialogue: 0,0:12:20.42,0:12:23.70,Caption,,0,0,0,,ПОДПИСАТЬ НА БОРТУ АВИАНОСЦА "ПРИНС ОФ УЭЙЛС". ТОГО
Dialogue: 0,0:12:23.70,0:12:26.82,Caption,,0,0,0,,САМОГО, КОТОРЫЙ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ ГОДУ СЛОМАЛСЯ
Dialogue: 0,0:12:26.90,0:12:29.62,Caption,,0,0,0,,ВСКОРЕ ПОСЛЕ ВЫХОДА В МОРЕ И НАДОЛГО ОТПРАВИЛСЯ
Dialogue: 0,0:12:29.62,0:12:32.50,Caption,,0,0,0,,РЕМОНТИРОВАТЬСЯ. ВЫБОР ПЛОЩАДКИ БЕЗУПРЕЧНЫЙ.
Dialogue: 0,0:12:34.77,0:12:37.41,Caption,,0,0,0,,ДОКУМЕНТ О ГОТОВНОСТИ К БОЛЬШОМУ КОНФЛИКТУ ПОДПИШУТ
Dialogue: 0,0:12:37.49,0:12:39.89,Caption,,0,0,0,,НА КОРАБЛЕ, КОТОРЫЙ УЖЕ ПРОДЕМОНСТРИРОВАЛ,
Dialogue: 0,0:12:40.05,0:12:42.85,Caption,,0,0,0,,НАСКОЛЬКО ВАЖНА ПРЕДВАРИТЕЛЬНАЯ ПРОВЕРКА ТЕХНИКИ.
Dialogue: 0,0:12:43.65,0:12:46.61,Caption,,0,0,0,,НАТО ТЕМ ВРЕМЕНЕМ ПРЕВРАЩАЕТ ПРОТИВОЛОДОЧНЫЕ УЧЕНИЯ
Dialogue: 0,0:12:46.61,0:12:50.29,Caption,,0,0,0,,"ДИНАМИК МЕРЛИН" В РЕГУЛЯРНУЮ РАБОТУ. РАНЬШЕ МОЖНО
Dialogue: 0,0:12:50.29,0:12:52.69,Caption,,0,0,0,,БЫЛО ПРИЕХАТЬ, ОТРАБОТАТЬ ПРОГРАММУ,
Dialogue: 0,0:12:52.90,0:12:55.81,Caption,,0,0,0,,СДЕЛАТЬ ФОТОГРАФИИ И РАЗЪЕХАТЬСЯ ДО СЛЕДУЮЩЕГО РАЗА.
Dialogue: 0,0:12:56.04,0:12:59.01,Caption,,0,0,0,,ТЕПЕРЬ ПОИСК ПОДЛОДОК ДОЛЖЕН ИДТИ ПОСТОЯННО. В
Dialogue: 0,0:12:59.01,0:13:02.29,Caption,,0,0,0,,БАЛТИЙСКОМ МОРЕ УЧАСТВУЮТ ВОСЕМЬ СТРАН. ШВЕЦИЯ
Dialogue: 0,0:13:02.29,0:13:06.61,Caption,,0,0,0,,ПРЕДОСТАВЛЯЕТ СУБМАРИНУ, ВЕРТОЛЁТЫ И КОРВЕТЫ. ВЕЛИКОБРИТАНИЯ,
Dialogue: 0,0:13:06.69,0:13:09.89,Caption,,0,0,0,,ГЕРМАНИЯ И ФРАНЦИЯ ПОДКЛЮЧАЮТ КОРАБЛИ И АВИАЦИЮ.
Dialogue: 0,0:13:10.20,0:13:13.33,Caption,,0,0,0,,БАЛТИКА ДЛЯ ТАКОЙ ЗАДАЧИ НЕУДОБНА. МЕЛКОВОДЬЕ И
Dialogue: 0,0:13:13.41,0:13:16.53,Caption,,0,0,0,,НЕРОВНЫЙ РЕЛЬЕФ ДНА ЗАТРУДНЯЮТ РАБОТУ ГИДРОАКУСТИКИ.
Dialogue: 0,0:13:16.87,0:13:19.57,Caption,,0,0,0,,ПОЭТОМУ ТАМ ТРЕНИРУЮТСЯ НЕ РАДИ КРАСИВОГО ПОСТРОЕНИЯ
Dialogue: 0,0:13:19.57,0:13:23.33,Caption,,0,0,0,,КОРАБЛЕЙ, А РАДИ ВПОЛНЕ КОНКРЕТНОЙ ОХОТЫ В СЛОЖНЫХ УСЛОВИЯХ.
Dialogue: 0,0:13:23.56,0:13:26.29,Caption,,0,0,0,,ЧЕМ ПЛОТНЕЕ ВОЕННАЯ ТЕХНИКА СОБИРАЕТСЯ В ТЕСНОМ
Dialogue: 0,0:13:26.37,0:13:30.13,Caption,,0,0,0,,МОРЕ, ТЕМ ВЫШЕ ВЕРОЯТНОСТЬ ОШИБКИ. САМОЛЁТ ПРИБЛИЗИЛСЯ
Dialogue: 0,0:13:30.13,0:13:34.69,Caption,,0,0,0,,СИЛЬНЕЕ, ЧЕМ ОЖИДАЛИ. КОРАБЛЬ НЕВЕРНО ПОНЯЛ МАНЁВР. ОДИН ШТАБ
Dialogue: 0,0:13:34.69,0:13:36.85,Caption,,0,0,0,,РЕШИЛ, ЧТО ПЕРЕД НИМ ДЕМОНСТРАЦИЯ,
Dialogue: 0,0:13:37.16,0:13:39.33,Caption,,0,0,0,,ДРУГОЙ УЖЕ УВИДЕЛ ПОДГОТОВКУ К АТАКЕ.
Dialogue: 0,0:13:39.99,0:13:42.69,Caption,,0,0,0,,ВОТ ЗДЕСЬ БРИТАНСКОЕ ЖЕЛАНИЕ РАЗГОВАРИВАТЬ С МОСКВОЙ
Dialogue: 0,0:13:42.69,0:13:45.65,Caption,,0,0,0,,НАПРЯМУЮ ПЕРЕСТАЁТ ВЫГЛЯДЕТЬ ВНЕЗАПНЫМ. ТЕЛЕФОН
Dialogue: 0,0:13:45.65,0:13:47.97,Caption,,0,0,0,,ПОНАДОБИЛСЯ НЕ ВМЕСТО КОРАБЛЕЙ И УЧЕНИЙ,
Dialogue: 0,0:13:48.12,0:13:54.00,Caption,,0,0,0,,А ВМЕСТЕ С НИМИ. К ПЯТОМУ ГОДУ КОНФЛИКТА В ЕВРОПЕЙСКИХ МОРЯХ СТАЛО
Dialogue: 0,0:13:54.08,0:13:58.24,Caption,,0,0,0,,БОЛЬШЕ ВОЕННЫХ КОРАБЛЕЙ, АВИАЦИИ И СРЕДСТВ ПОИСКА ПОДЛОДОК,
Dialogue: 0,0:13:58.48,0:14:01.36,Caption,,0,0,0,,ПОЭТОМУ ВЕРОЯТНОСТЬ ПРОСЧЁТА И ЦЕНА ТАКОЙ ОШИБКИ
Dialogue: 0,0:14:01.52,0:14:04.16,Caption,,0,0,0,,ВЫРОСЛИ ИМЕННО К МОМЕНТУ ПЕРЕХОДА УЧЕНИЙ В
Dialogue: 0,0:14:04.16,0:14:07.04,Caption,,0,0,0,,ПОСТОЯННЫЙ РЕЖИМ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:14:07.21,0:14:12.24,Caption,,0,0,0,,ЧТО, ПО ВАШЕМУ МНЕНИЮ, ОЗНАЧАЕТ БРИТАНСКАЯ ИНИЦИАТИВА НАЧАЛО ОТРЕЗВЛЕНИЯ
Dialogue: 0,0:14:12.56,0:14:14.96,Caption,,0,0,0,,ИЛИ ВСЕГО ЛИШЬ СТРАХОВКУ ДЛЯ ПРОДОЛЖЕНИЯ ПРЕЖНЕГО
Dialogue: 0,0:14:14.96,0:14:17.84,Caption,,0,0,0,,КУРСА. НОВЫЙ ТЕЛЕФОН ЛОНДОНА ВАЖНЕЕ ОЧЕРЕДНОГО
Dialogue: 0,0:14:17.84,0:14:21.04,Caption,,0,0,0,,ЗАЯВЛЕНИЯ О ЕВРОПЕЙСКОЙ СПЛОЧЁННОСТИ. СПЛОЧЁННОСТЬ
Dialogue: 0,0:14:21.04,0:14:23.68,Caption,,0,0,0,,МОЖНО ОБЪЯВИТЬ У МИКРОФОНА И ЗАБЫТЬ ДО СЛЕДУЮЩЕГО
Dialogue: 0,0:14:23.76,0:14:26.40,Caption,,0,0,0,,САММИТА. СРОЧНУЮ ЛИНИЮ ПРОВОДЯТ ТОГДА,
Dialogue: 0,0:14:26.68,0:14:31.04,Caption,,0,0,0,,КОГДА УЖЕ ДОПУСКАЮТ ЗВОНОК, ПОСЛЕ КОТОРОГО ОБЫЧНОГО ПОСОЛЬСКОГО НОМЕРА БУДЕТ
Dialogue: 0,0:14:31.12,0:14:31.76,Caption,,0,0,0,,НЕДОСТАТОЧНО.
