Dialogue: 0,0:00:00.12,0:00:04.16,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОПЯТЬ ОБЪЯСНИЛ, ПРИ КАКИХ УСЛОВИЯХ УКРАИНА ПРОИГРАЕТ.
Dialogue: 0,0:00:04.16,0:00:07.07,Caption,,0,0,0,,ТУТ ВРОДЕ БЫ ВСЁ ПОНЯТНО. А ВОТ ПРИ КАКИХ УСЛОВИЯХ
Dialogue: 0,0:00:07.07,0:00:09.96,Caption,,0,0,0,,ОНА ВЫИГРАЕТ? ВОЛОДЯ, ТЫ УЖ БУДЬ ДОБР,
Dialogue: 0,0:00:10.20,0:00:12.10,Caption,,0,0,0,,ОБЪЯСНИ ЛЮДЯМ И ВТОРУЮ ПОЛОВИНУ
Dialogue: 0,0:00:12.10,0:00:15.16,Caption,,0,0,0,,ЗАДАЧИ. А ТО ПЯТЫЙ ГОД ИДЁТ, И ДАЖЕ АМЕРИКАНЦЫ,
Dialogue: 0,0:00:15.26,0:00:17.00,Caption,,0,0,0,,СУДЯ ПО ИХ ПОСЛЕДНИМ ЗАЯВЛЕНИЯМ,
Dialogue: 0,0:00:17.17,0:00:19.33,Caption,,0,0,0,,НАЧИНАЮТ ПУТАТЬСЯ В УСЛОВИЯХ ЭТОЙ
Dialogue: 0,0:00:19.33,0:00:22.33,Caption,,0,0,0,,ЗАДАЧКИ. ЕСЛИ ВАМ ИНТЕРЕСЕН НЕ ПЕРЕСКАЗ ОЧЕРЕДНОГО
Dialogue: 0,0:00:22.33,0:00:25.97,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, А ТО, КАК ЭТИ ЗАЯВЛЕНИЯ СТЫКУЮТСЯ МЕЖДУ
Dialogue: 0,0:00:25.97,0:00:28.76,Caption,,0,0,0,,СОБОЙ, ПОДПИШИТЕСЬ. ТУТ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:29.00,0:00:30.92,Caption,,0,0,0,,КОГДА РЯДОМ ЛЕЖАТ НЕСКОЛЬКО НОВОСТЕЙ,
Dialogue: 0,0:00:31.16,0:00:33.40,Caption,,0,0,0,,А ВМЕСТЕ ОНИ ВЫГЛЯДЯТ ГОРАЗДО ИНТЕРЕСНЕЕ.
Dialogue: 0,0:00:34.00,0:00:35.88,Caption,,0,0,0,,КУШНЕР В РАЗГОВОРЕ С NEW YORK MAGAZINE
Dialogue: 0,0:00:35.88,0:00:38.77,Caption,,0,0,0,,СФОРМУЛИРОВАЛ ЦЕЛЬ ПЕРЕГОВОРОВ ДОВОЛЬНО НЕОЖИДАННО.
Dialogue: 0,0:00:38.77,0:00:41.69,Caption,,0,0,0,,ГЛАВНЫЙ ПРИЗ ДЛЯ НЕГО НЕ ПРОСТО ПРЕКРАЩЕНИЕ ОГНЯ.
Dialogue: 0,0:00:41.69,0:00:44.21,Caption,,0,0,0,,ОН ГОВОРИТ О ПЕРЕЗАГРУЗКЕ ОТНОШЕНИЙ РОССИИ И
Dialogue: 0,0:00:44.21,0:00:46.56,Caption,,0,0,0,,ЕВРОПЫ, ЧТОБЫ ПРЕКРАТИЛАСЬ ПОСТОЯННАЯ
Dialogue: 0,0:00:46.56,0:00:49.78,Caption,,0,0,0,,КОНФРОНТАЦИЯ, ЛЮДИ МОГЛИ СПОКОЙНО ЖИТЬ И СНОВА ВЕСТИ
Dialogue: 0,0:00:49.78,0:00:53.10,Caption,,0,0,0,,БИЗНЕС ДРУГ С ДРУГОМ. ЗЕЛЕНСКОМУ КУШНЕР ПРЕДЛАГАЕТ СОВСЕМ
Dialogue: 0,0:00:53.10,0:00:55.24,Caption,,0,0,0,,ДРУГУЮ РОЛЬ. ЗАКОНЧИТЬ КОНФЛИКТ,
Dialogue: 0,0:00:55.52,0:00:57.47,Caption,,0,0,0,,ПОЛУЧИТЬ ГАРАНТИИ БЕЗОПАСНОСТИ И
Dialogue: 0,0:00:57.47,0:01:00.25,Caption,,0,0,0,,ПЕРЕКЛЮЧИТЬСЯ НА ВОССТАНОВЛЕНИЕ ЭКОНОМИКИ. ТО ЕСТЬ
Dialogue: 0,0:01:00.25,0:01:02.68,Caption,,0,0,0,,СТАТЬ НЕ ЧЕЛОВЕКОМ БЕСКОНЕЧНОЙ МОБИЛИЗАЦИИ,
Dialogue: 0,0:01:02.92,0:01:05.16,Caption,,0,0,0,,А ЧЕЛОВЕКОМ ВОССТАНОВЛЕНИЯ СТРАНЫ. И
Dialogue: 0,0:01:05.16,0:01:10.55,Caption,,0,0,0,,ТУТ СРАЗУ ПЕРВАЯ ПРОБЛЕМА. АМЕРИКАНЦЫ ГОВОРЯТ О ВОССТАНОВЛЕНИИ
Dialogue: 0,0:01:10.55,0:01:14.05,Caption,,0,0,0,,ОТНОШЕНИЙ РОССИИ С ЕВРОПОЙ, А САМА ЕВРОПА ПРОДОЛЖАЕТ ГОТОВИТЬ
Dialogue: 0,0:01:14.05,0:01:17.17,Caption,,0,0,0,,НОВЫЕ САНКЦИИ И НАРАЩИВАТЬ ВОЕННУЮ ПОДДЕРЖКУ КИЕВА. ДА
Dialogue: 0,0:01:17.17,0:01:20.46,Caption,,0,0,0,,И ЗЕЛЕНСКИЙ УТВЕРЖДАЕТ, ЧТО РОССИЯ НЕ СТАНЕТ БЕЗОПАСНОЙ
Dialogue: 0,0:01:20.46,0:01:24.16,Caption,,0,0,0,,СТРАНОЙ НИ ЧЕРЕЗ ГОД, НИ ЧЕРЕЗ ПЯТЬ ЛЕТ. ТО ЕСТЬ КУШНЕР УЖЕ
Dialogue: 0,0:01:24.24,0:01:26.08,Caption,,0,0,0,,ИЩЕТ ДОРОГУ К НОРМАЛЬНЫМ ОТНОШЕНИЯМ,
Dialogue: 0,0:01:26.25,0:01:27.92,Caption,,0,0,0,,А ЗЕЛЕНСКИЙ ЗАРАНЕЕ ОБЪЯВЛЯЕТ,
Dialogue: 0,0:01:28.16,0:01:31.20,Caption,,0,0,0,,ЧТО ТАКОЙ ДОРОГИ НЕТ. КРАСИВО ПОЛУЧАЕТСЯ. ОДИН УЖЕ
Dialogue: 0,0:01:31.20,0:01:33.36,Caption,,0,0,0,,ЗАНОСИТ В КОМНАТУ СТОЛ ДЛЯ ПЕРЕГОВОРОВ,
Dialogue: 0,0:01:33.65,0:01:35.42,Caption,,0,0,0,,ВТОРОЙ В ЭТОТ МОМЕНТ ТАЩИТ ТУДА ЖЕ
Dialogue: 0,0:01:35.42,0:01:38.00,Caption,,0,0,0,,НОВЫЙ ШКАФ С САНКЦИЯМИ, ТРЕТИЙ ИЩЕТ,
Dialogue: 0,0:01:38.16,0:01:40.57,Caption,,0,0,0,,КУДА ПОСТАВИТЬ ЯЩИК С БОЕПРИПАСАМИ. И
Dialogue: 0,0:01:40.57,0:01:43.10,Caption,,0,0,0,,ВСЕ УВЕРЯЮТ, ЧТО РАБОТАЮТ НАД ОДНИМ И ТЕМ ЖЕ
Dialogue: 0,0:01:43.10,0:01:46.40,Caption,,0,0,0,,РЕЗУЛЬТАТОМ. ПРИЧЁМ КУШНЕР ОТДЕЛЬНО НЕДОВОЛЕН ТЕМ,
Dialogue: 0,0:01:46.56,0:01:48.31,Caption,,0,0,0,,КАК ЗЕЛЕНСКИЙ ВЕДЁТ ПЕРЕГОВОРЫ
Dialogue: 0,0:01:48.31,0:01:50.24,Caption,,0,0,0,,ПУБЛИЧНО. NEW YORK MAGAZINE ПИШЕТ,
Dialogue: 0,0:01:50.40,0:01:53.20,Caption,,0,0,0,,ЧТО ОН СЧИТАЕТ ТАКУЮ ТАКТИКУ КОНТРПРОДУКТИВНОЙ.
Dialogue: 0,0:01:53.41,0:01:55.52,Caption,,0,0,0,,ДЕТАЛИ ПЕРЕГОВОРОВ ВЫНОСЯТСЯ НАРУЖУ,
Dialogue: 0,0:01:55.60,0:01:57.44,Caption,,0,0,0,,НАЧИНАЕТСЯ ПУБЛИЧНОЕ ДАВЛЕНИЕ,
Dialogue: 0,0:01:57.52,0:02:01.76,Caption,,0,0,0,,ВОЗМУЩЕНИЕ, БОРЬБА ЗА ТО, КТО ВЫГЛЯДИТ ПРАВЫМ. А ПОТОМ ВСЕ
Dialogue: 0,0:02:01.76,0:02:05.12,Caption,,0,0,0,,УДИВЛЯЮТСЯ, ПОЧЕМУ ДОГОВОРИТЬСЯ ТРУДНО. В МАЙАМИ,
Dialogue: 0,0:02:05.25,0:02:08.56,Caption,,0,0,0,,ПО ДАННЫМ ЖУРНАЛА, КУШНЕР СООБЩИЛ УКРАИНСКОЙ ДЕЛЕГАЦИИ,
Dialogue: 0,0:02:08.72,0:02:11.44,Caption,,0,0,0,,ЧТО ТРАМП СОБИРАЕТСЯ ПРИНЯТЬ ПРЕДЛОЖЕНИЕ ПУТИНА О
Dialogue: 0,0:02:11.44,0:02:13.45,Caption,,0,0,0,,ПОСТАВКАХ РОССИЙСКОГО ДИЗЕЛЬНОГО
Dialogue: 0,0:02:13.45,0:02:16.87,Caption,,0,0,0,,ТОПЛИВА В США В ОБМЕН НА СМЯГЧЕНИЕ САНКЦИЙ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:02:16.87,0:02:20.00,Caption,,0,0,0,,СРАЗУ ВОЗМУТИЛСЯ, ЧТО С НИМ ПОСТУПАЮТ НЕСПРАВЕДЛИВО.
Dialogue: 0,0:02:22.28,0:02:24.52,Caption,,0,0,0,,ПРИ ЭТОМ КУШНЕР, КАК ПИШЕТ ИЗДАНИЕ,
Dialogue: 0,0:02:24.68,0:02:27.16,Caption,,0,0,0,,ЗЕЛЕНСКОМУ СОЧУВСТВУЕТ. НО СОЧУВСТВИЕ
Dialogue: 0,0:02:27.16,0:02:29.96,Caption,,0,0,0,,СОЧУВСТВИЕМ, А ПЕРЕГОВОРЫ, ПО ЕГО МНЕНИЮ,
Dialogue: 0,0:02:30.12,0:02:33.27,Caption,,0,0,0,,ТАК НЕ ВЕДУТ. И ВОТ ЗДЕСЬ АМЕРИКАНЦЫ УПЁРЛИСЬ ЕЩЁ В
Dialogue: 0,0:02:33.27,0:02:35.56,Caption,,0,0,0,,ОДНУ ВЕЩЬ. ОНИ ДОВОЛЬНО ДОЛГО ПЫТАЛИСЬ
Dialogue: 0,0:02:35.56,0:02:38.69,Caption,,0,0,0,,ЗАЙТИ К МОСКВЕ ЧЕРЕЗ ЭКОНОМИКУ. FINANCIAL TIMES
Dialogue: 0,0:02:38.69,0:02:41.38,Caption,,0,0,0,,СООБЩАЕТ, ЧТО ВАШИНГТОН ПРЕДЛАГАЛ ПРОЕКТЫ В
Dialogue: 0,0:02:41.38,0:02:44.85,Caption,,0,0,0,,ЭНЕРГЕТИКЕ И АВИАЦИИ, РАССЧИТЫВАЯ ЗАИНТЕРЕСОВАТЬ РОССИЮ
Dialogue: 0,0:02:44.85,0:02:47.58,Caption,,0,0,0,,ЭКОНОМИЧЕСКИМИ СТИМУЛАМИ. НЕ СРАБОТАЛО. ПОСЛЕ
Dialogue: 0,0:02:47.58,0:02:51.06,Caption,,0,0,0,,ПЕРЕГОВОРОВ В АБУ ДАБИ ВНИМАНИЕ СМЕСТИЛИ НА ТЕРРИТОРИИ И
Dialogue: 0,0:02:51.06,0:02:53.77,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ. ПРИ ЭТОМ ПОСЛЕВОЕННОЕ
Dialogue: 0,0:02:53.77,0:02:56.84,Caption,,0,0,0,,ЭКОНОМИЧЕСКОЕ СОТРУДНИЧЕСТВО С РОССИЕЙ ИЗ ПОВЕСТКИ
Dialogue: 0,0:02:56.84,0:02:59.96,Caption,,0,0,0,,НЕ ИСЧЕЗЛО. НУ ЧТО ТУТ СКАЗАТЬ. НЕ В ДЕНЬГАХ СЧАСТЬЕ,
Dialogue: 0,0:03:00.04,0:03:02.29,Caption,,0,0,0,,А В ИХ КОЛИЧЕСТВЕ. ШУТКА ХОРОШАЯ.
Dialogue: 0,0:03:02.29,0:03:04.92,Caption,,0,0,0,,ТОЛЬКО К БОЛЬШОЙ ПОЛИТИКЕ ОНА ПОДХОДИТ НЕ
Dialogue: 0,0:03:04.92,0:03:08.08,Caption,,0,0,0,,ВСЕГДА. ДА, ВСЕ СТАЛИ МЕРКАНТИЛЬНЕЕ. БЕЗ ДЕНЕГ
Dialogue: 0,0:03:08.08,0:03:11.41,Caption,,0,0,0,,НИКУДА. НО ДАЛЕКО НЕ ВСЁ ПОКУПАЕТСЯ ЗА ДЕНЬГИ. И СВОДИТЬ
Dialogue: 0,0:03:11.41,0:03:13.24,Caption,,0,0,0,,РУССКИЙ ВЗГЛЯД НА БЕЗОПАСНОСТЬ,
Dialogue: 0,0:03:13.35,0:03:16.25,Caption,,0,0,0,,ТЕРРИТОРИИ, ОТНОШЕНИЯ С СОСЕДЯМИ И СОБСТВЕННОЕ
Dialogue: 0,0:03:16.25,0:03:18.36,Caption,,0,0,0,,МЕСТО В МИРЕ ИСКЛЮЧИТЕЛЬНО К ВОПРОСУ,
Dialogue: 0,0:03:18.52,0:03:20.60,Caption,,0,0,0,,СКОЛЬКО ДАДУТ И ГДЕ ОТКРОЮТ РЫНОК,
Dialogue: 0,0:03:21.00,0:03:22.82,Caption,,0,0,0,,ЭТО ОЧЕНЬ АМЕРИКАНСКИЙ ПОДХОД. НО
Dialogue: 0,0:03:22.82,0:03:25.57,Caption,,0,0,0,,АБСОЛЮТНО НЕ РУССКИЙ МЕНТАЛИТЕТ. КАК ГОВОРИЛ ГЕРОЙ
Dialogue: 0,0:03:25.57,0:03:28.84,Caption,,0,0,0,,"БРАТА ДВА" "В ЧЁМ СИЛА? А, АМЕРИКАНЕЦ?
Dialogue: 0,0:03:29.12,0:03:31.13,Caption,,0,0,0,,ТЫ ДУМАЕШЬ В ДЕНЬГАХ?" АМЕРИКАНЕЦ В
Dialogue: 0,0:03:31.13,0:03:34.28,Caption,,0,0,0,,ЭТОЙ ИСТОРИИ, ПОХОЖЕ, ВСЁ ЕЩЁ ОТВЕЧАЕТ В ДЕНЬГАХ.
Dialogue: 0,0:03:36.47,0:03:39.19,Caption,,0,0,0,,А РУССКАЯ СТОРОНА СМОТРИТ НА ПРЕДЛОЖЕНИЕ И ОТВЕЧАЕТ
Dialogue: 0,0:03:39.19,0:03:41.31,Caption,,0,0,0,,СОВСЕМ ДРУГИМ НАБОРОМ ВОПРОСОВ. У НАС
Dialogue: 0,0:03:41.31,0:03:43.67,Caption,,0,0,0,,ВЕДЬ КАК. НЕ ТАК ВАЖНО ВМЕСТЕ ВЫПИТЬ,
Dialogue: 0,0:03:43.83,0:03:45.78,Caption,,0,0,0,,ВАЖНЕЕ ВМЕСТЕ ПРИ ЭТОМ ПОБОЛТАТЬ.
Dialogue: 0,0:03:45.78,0:03:48.23,Caption,,0,0,0,,ПОТОМУ ЧТО ЗА СТОЛОМ ИНОГДА РЕШАЕТСЯ ТО,
Dialogue: 0,0:03:48.39,0:03:50.83,Caption,,0,0,0,,ЧЕГО НЕ КУПИШЬ ЕЩЁ ОДНИМ КОНТРАКТОМ.
Dialogue: 0,0:03:50.83,0:03:53.51,Caption,,0,0,0,,ОТНОШЕНИЕ. ДОВЕРИЕ. ПОНИМАНИЕ,
Dialogue: 0,0:03:53.64,0:03:56.15,Caption,,0,0,0,,КТО ЧЕГО НА САМОМ ДЕЛЕ ХОЧЕТ. И ПОЧЕМУ
Dialogue: 0,0:03:56.15,0:03:59.60,Caption,,0,0,0,,ОН ЭТОГО ХОЧЕТ. А ТЕПЕРЬ ПОСМОТРИМ НА КИЕВ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:03:59.60,0:04:03.60,Caption,,0,0,0,,В ИНТЕРВЬЮ BLOOMBERG ГОВОРИТ, ЧТО ТРАМП ТОРОПИТ ЕГО С СОГЛАШЕНИЕМ.
Dialogue: 0,0:04:03.60,0:04:06.57,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО ЗАКОНЧИТЬ ВСЁ ДО ЯНВАРЯ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:04:06.57,0:04:10.79,Caption,,0,0,0,,ОТВЕЧАЕТ, ЧТО МИР НУЖЕН, НО НЕ ЗА СЧЁТ ОДНОЙ УКРАИНЫ. И ТУТ
Dialogue: 0,0:04:10.87,0:04:13.66,Caption,,0,0,0,,ЖЕ ГОВОРИТ, ЧТО АМЕРИКА СТАВИТ СЕБЯ В НЕУДОБНОЕ
Dialogue: 0,0:04:13.66,0:04:16.39,Caption,,0,0,0,,ПОЛОЖЕНИЕ, ПОТОМУ ЧТО ЕЁ ДЕЙСТВИЯ ВЫГЛЯДЯТ ТАК,
Dialogue: 0,0:04:16.55,0:04:18.63,Caption,,0,0,0,,БУДТО ВАШИНГТОН ИДЁТ ТЕМ ЖЕ КУРСОМ,
Dialogue: 0,0:04:18.79,0:04:21.94,Caption,,0,0,0,,ЧТО И ПУТИН, И ТОЛКАЕТ УКРАИНУ К КАПИТУЛЯЦИИ. ВОТ
Dialogue: 0,0:04:21.94,0:04:26.42,Caption,,0,0,0,,ЭТО УЖЕ ИНТЕРЕСНО. СТРАНА, КОТОРАЯ ГОДАМИ БЫЛА ГЛАВНЫМ ИСТОЧНИКОМ
Dialogue: 0,0:04:26.42,0:04:29.99,Caption,,0,0,0,,ДЕНЕГ, ОРУЖИЯ, РАЗВЕДДАННЫХ И ПОЛИТИЧЕСКОЙ ПОДДЕРЖКИ,
Dialogue: 0,0:04:30.38,0:04:32.79,Caption,,0,0,0,,ТЕПЕРЬ В РИТОРИКЕ ЗЕЛЕНСКОГО ОКАЗЫВАЕТСЯ РЯДОМ С
Dialogue: 0,0:04:32.79,0:04:36.42,Caption,,0,0,0,,РОССИЕЙ. НЕ ПОТОМУ, ЧТО ВАШИНГТОН ПЕРЕШЁЛ НА СТОРОНУ
Dialogue: 0,0:04:36.42,0:04:39.75,Caption,,0,0,0,,МОСКВЫ. А ПОТОМУ, ЧТО ВАШИНГТОН НАЧАЛ ТРЕБОВАТЬ ТО,
Dialogue: 0,0:04:39.91,0:04:42.43,Caption,,0,0,0,,ЧЕГО КИЕВ ПРИНИМАТЬ НЕ ХОЧЕТ. И КИЕВ
Dialogue: 0,0:04:42.43,0:04:45.45,Caption,,0,0,0,,ПРЯМО ОБЪЯСНЯЕТ, НА ЧТО РАССЧИТЫВАЕТ. ОБЕСПЕЧЬТЕ
Dialogue: 0,0:04:45.45,0:04:48.39,Caption,,0,0,0,,ПОТРЕБНОСТИ ХОТЯ БЫ НА ДЕКАБРЬ. А ТАМ ПРИДЁТ НОВЫЙ
Dialogue: 0,0:04:48.39,0:04:51.11,Caption,,0,0,0,,КОНГРЕСС, И С НИМ ПОПРОБУЕМ НАЙТИ НОВЫЙ ПОДХОД.
Dialogue: 0,0:04:53.40,0:04:55.30,Caption,,0,0,0,,ТО ЕСТЬ ЗАДАЧА ДОВОЛЬНО ПРОСТАЯ.
Dialogue: 0,0:04:55.30,0:04:58.25,Caption,,0,0,0,,ДОТЯНУТЬ ДО ИЗМЕНЕНИЯ ПОЛИТИЧЕСКОЙ КОНФИГУРАЦИИ В
Dialogue: 0,0:04:58.25,0:05:00.95,Caption,,0,0,0,,ВАШИНГТОНЕ И ПОПРОБОВАТЬ ПОЛУЧИТЬ ОТ НЕЁ НОВЫЙ
Dialogue: 0,0:05:00.95,0:05:04.07,Caption,,0,0,0,,ПАКЕТ ПОМОЩИ, НОВЫЕ САНКЦИИ И НОВОЕ ПРОДОЛЖЕНИЕ
Dialogue: 0,0:05:04.07,0:05:07.32,Caption,,0,0,0,,ПРЕЖНЕЙ ЛИНИИ. ТОЛЬКО КАЛЕНДАРЬ В ВАШИНГТОНЕ ОДИН,
Dialogue: 0,0:05:07.53,0:05:09.91,Caption,,0,0,0,,А ЗИМА НА УКРАИНЕ ДРУГАЯ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:05:09.91,0:05:12.76,Caption,,0,0,0,,ЖАЛУЕТСЯ, ЧТО ПИТ ХЕГСЕТ ДО СИХ ПОР НЕ ОДОБРИЛ
Dialogue: 0,0:05:12.84,0:05:14.78,Caption,,0,0,0,,ПЕРЕДАЧУ СОРОКА ВОСЬМИ РАКЕТ ДЛЯ
Dialogue: 0,0:05:14.78,0:05:17.64,Caption,,0,0,0,,PATRIOT. РАНЕЕ FINANCIAL TIMES И REUTERS ПИСАЛИ О
Dialogue: 0,0:05:17.64,0:05:20.09,Caption,,0,0,0,,ЗАВИСШИХ ШЕСТИДЕСЯТИ РАКЕТАХ. ДОСТУП К
Dialogue: 0,0:05:20.09,0:05:21.96,Caption,,0,0,0,,STARSHIELD, ПО СЛОВАМ ЗЕЛЕНСКОГО,
Dialogue: 0,0:05:22.18,0:05:24.49,Caption,,0,0,0,,ОСТАЁТСЯ ОГРАНИЧЕННЫМ. ПРИ ЭТОМ США
Dialogue: 0,0:05:24.49,0:05:28.18,Caption,,0,0,0,,УЖЕ СОГЛАСОВАЛИ ПРОДАЖУ КИЕВУ ПЯТИСОТ РАКЕТ PAC ТРИ.
Dialogue: 0,0:05:28.18,0:05:31.44,Caption,,0,0,0,,ОТЛИЧНАЯ НОВОСТЬ, ЕСЛИ НЕ СМОТРЕТЬ НА СРОК ПОСТАВКИ.
Dialogue: 0,0:05:31.44,0:05:34.70,Caption,,0,0,0,,НАЧАЛО ТРИДЦАТЫХ ГОДОВ. К ТОМУ ВРЕМЕНИ НЫНЕШНИЙ СПОР О
Dialogue: 0,0:05:34.70,0:05:36.45,Caption,,0,0,0,,ЯНВАРЕ МОЖНО БУДЕТ ВСПОМИНАТЬ КАК
Dialogue: 0,0:05:36.45,0:05:39.36,Caption,,0,0,0,,ИСТОРИЧЕСКУЮ РЕКОНСТРУКЦИЮ. И ЕЩЁ ОДНА ПРОСТАЯ
Dialogue: 0,0:05:39.36,0:05:42.20,Caption,,0,0,0,,ВЕЩЬ. НОВЫЙ КОНГРЕСС СПОСОБЕН ДАВИТЬ НА БЕЛЫЙ ДОМ,
Dialogue: 0,0:05:42.28,0:05:45.45,Caption,,0,0,0,,ГОЛОСОВАТЬ ДЕНЬГИ, СПОРИТЬ О САНКЦИЯХ. НО ВНЕШНЮЮ
Dialogue: 0,0:05:45.45,0:05:48.42,Caption,,0,0,0,,ПОЛИТИКУ ВМЕСТО ПРЕЗИДЕНТА ОН НЕ ВЕДЁТ. И ЛЮБОЕ
Dialogue: 0,0:05:48.42,0:05:51.26,Caption,,0,0,0,,СОГЛАШЕНИЕ ВСЁ РАВНО ДОЛЖНО УСТРАИВАТЬ НЕ ТОЛЬКО КИЕВ
Dialogue: 0,0:05:51.26,0:05:54.60,Caption,,0,0,0,,И ВАШИНГТОН, НО И МОСКВУ. ИНАЧЕ ЭТО НЕ СОГЛАШЕНИЕ,
Dialogue: 0,0:05:54.75,0:05:56.88,Caption,,0,0,0,,А СПИСОК ПОЖЕЛАНИЙ. ЕСЛИ ВЫ ЕЩЁ НЕ
Dialogue: 0,0:05:56.88,0:05:59.50,Caption,,0,0,0,,ПОДПИСАЛИСЬ, САМОЕ ВРЕМЯ. ПОТОМУ ЧТО ДАЛЬШЕ
Dialogue: 0,0:05:59.50,0:06:02.44,Caption,,0,0,0,,НАЧИНАЕТСЯ ВООБЩЕ ПРЕКРАСНАЯ ЛОГИЧЕСКАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:06:04.63,0:06:08.43,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ТЕПЕРЬ ОБЪЯСНЯЕТ, ЧТО ЧЛЕНСТВО УКРАИНЫ В НАТО ВЫГОДНО
Dialogue: 0,0:06:08.43,0:06:13.64,Caption,,0,0,0,,САМОЙ РОССИИ. ДАЖЕ БОЛЬШЕ, ЧЕМ УКРАИНЕ. ЛОГИКА ТАКАЯ. ЕСЛИ МОСКВА
Dialogue: 0,0:06:13.64,0:06:16.09,Caption,,0,0,0,,БОИТСЯ, ЧТО УКРАИНА КОГДА ЛИБО ПОПРОБУЕТ
Dialogue: 0,0:06:16.09,0:06:19.57,Caption,,0,0,0,,ВЕРНУТЬ ТЕРРИТОРИИ СИЛОЙ, ТО ЧЛЕНСТВО В НАТО ДОЛЖНО ЕЁ
Dialogue: 0,0:06:19.57,0:06:22.07,Caption,,0,0,0,,УСПОКОИТЬ. ПОТОМУ ЧТО УКРАИНА ВНУТРИ НАТО,
Dialogue: 0,0:06:22.23,0:06:25.43,Caption,,0,0,0,,ПО СЛОВАМ ЗЕЛЕНСКОГО, НЕ СМОЖЕТ НАЧАТЬ ВООРУЖЁННЫЙ РЕВАНШ,
Dialogue: 0,0:06:25.67,0:06:27.56,Caption,,0,0,0,,ИНАЧЕ ПОТЕРЯЕТ ВСЕХ ПАРТНЁРОВ. А
Dialogue: 0,0:06:27.56,0:06:29.91,Caption,,0,0,0,,РОССИЙСКОЕ СОПРОТИВЛЕНИЕ ВСТУПЛЕНИЮ УКРАИНЫ В
Dialogue: 0,0:06:29.91,0:06:32.66,Caption,,0,0,0,,НАТО ЗЕЛЕНСКИЙ ОБЪЯСНЯЕТ СОВСЕМ ДРУГИМ НАМЕРЕНИЕМ
Dialogue: 0,0:06:32.66,0:06:35.13,Caption,,0,0,0,,ПУТИНА НЕ ДОПУСТИТЬ ОКОНЧАТЕЛЬНОГО УХОДА УКРАИНЫ
Dialogue: 0,0:06:35.13,0:06:37.47,Caption,,0,0,0,,ИЗ ПОД РОССИЙСКОГО ВЛИЯНИЯ И ПРОДОЛЖИТЬ ЕЁ
Dialogue: 0,0:06:37.47,0:06:39.83,Caption,,0,0,0,,ОККУПАЦИЮ. ТО ЕСТЬ ПУТИН, ПОЛУЧАЕТСЯ,
Dialogue: 0,0:06:40.07,0:06:42.47,Caption,,0,0,0,,ВСЕ ЭТИ ГОДЫ ПРОСТО НЕ ПОНЯЛ СОБСТВЕННОГО СЧАСТЬЯ.
Dialogue: 0,0:06:42.79,0:06:44.91,Caption,,0,0,0,,ОН ГОВОРИТ НИКАКОГО НАТО. А ЗЕЛЕНСКИЙ
Dialogue: 0,0:06:44.91,0:06:46.63,Caption,,0,0,0,,ЕМУ ОТВЕЧАЕТ ВЛАДИМИР ВЛАДИМИРОВИЧ,
Dialogue: 0,0:06:46.95,0:06:48.47,Caption,,0,0,0,,ВЫ ПРОСТО НЕПРАВИЛЬНО СЧИТАЕТЕ,
Dialogue: 0,0:06:48.62,0:06:50.54,Caption,,0,0,0,,ВАМ ЖЕ ЭТО ВЫГОДНО. ОДНОВРЕМЕННО
Dialogue: 0,0:06:50.54,0:06:53.18,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОТВЕРГАЕТ РОССИЙСКУЮ ЛОГИКУ ПО ПОВОДУ
Dialogue: 0,0:06:53.18,0:06:56.89,Caption,,0,0,0,,ПРЕКРАЩЕНИЯ ОГНЯ НА ДВА ИЛИ ТРИ МЕСЯЦА. ПУТИН ГОВОРИТ О РИСКЕ
Dialogue: 0,0:06:56.89,0:06:59.39,Caption,,0,0,0,,РОТАЦИИ И ПЕРЕВООРУЖЕНИЯ УКРАИНСКОЙ АРМИИ.
Dialogue: 0,0:06:59.39,0:07:01.99,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НАЗЫВАЕТ ЭТО ЛОЖЬЮ И УТВЕРЖДАЕТ,
Dialogue: 0,0:07:02.17,0:07:04.57,Caption,,0,0,0,,ЧТО ЦЕЛЬ МОСКВЫ ДРУГАЯ СЛОМИТЬ УКРАИНУ
Dialogue: 0,0:07:04.57,0:07:07.11,Caption,,0,0,0,,ЗИМОЙ, ПРЕЖДЕ ВСЕГО КИЕВ, ДНЕПР,
Dialogue: 0,0:07:07.19,0:07:11.49,Caption,,0,0,0,,ОДЕССУ, ХАРЬКОВ И ЗАПОРОЖЬЕ, ЧТОБЫ ДОБИТЬСЯ УХОДА УКРАИНСКИХ ВОЙСК
Dialogue: 0,0:07:11.49,0:07:14.76,Caption,,0,0,0,,ИЗ ДОНБАССА. И ВОТ МЫ СНОВА ВОЗВРАЩАЕМСЯ К ГЛАВНОМУ
Dialogue: 0,0:07:14.76,0:07:18.42,Caption,,0,0,0,,ВОПРОСУ. ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:07:18.58,0:07:20.50,Caption,,0,0,0,,ЧТО ДОБРОВОЛЬНО УЙТИ ИЗ ДОНБАССА,
Dialogue: 0,0:07:20.66,0:07:22.58,Caption,,0,0,0,,В ТОМ ЧИСЛЕ ИЗ СЛАВЯНСКА И КРАМАТОРСКА,
Dialogue: 0,0:07:22.88,0:07:25.07,Caption,,0,0,0,,ЗНАЧИТ ПРОИГРАТЬ ВОЙНУ. НЕ ОТСТУПИТЬ
Dialogue: 0,0:07:25.07,0:07:26.82,Caption,,0,0,0,,ПОД ДАВЛЕНИЕМ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:07:27.06,0:07:29.07,Caption,,0,0,0,,А САМОМУ ПРИНЯТЬ РЕШЕНИЕ И ОСТАВИТЬ
Dialogue: 0,0:07:29.07,0:07:31.98,Caption,,0,0,0,,ТЕРРИТОРИЮ. ПРИЧЁМ ОН ОТДЕЛЬНО ПОДЧЁРКИВАЕТ ДЕЛО
Dialogue: 0,0:07:31.98,0:07:35.62,Caption,,0,0,0,,НЕ В ГЕКТАРАХ. ХОРОШО. С ТЕРМИНОМ "ПРОИГРАТЬ ВОЙНУ"
Dialogue: 0,0:07:35.62,0:07:38.34,Caption,,0,0,0,,ВСЁ ПОНЯТНО. А ЧТО ТОГДА БУДЕТ "ВЫИГРАТЬ ВОЙНУ"?
Dialogue: 0,0:07:38.69,0:07:40.71,Caption,,0,0,0,,КАКОЕ ПОНЯТИЕ И КАКОЙ КОНТЕКСТ ТУДА
Dialogue: 0,0:07:40.71,0:07:42.98,Caption,,0,0,0,,ВКЛАДЫВАЕТСЯ? ЧТО ДОЛЖНО ПРОИЗОЙТИ?
Dialogue: 0,0:07:43.24,0:07:45.43,Caption,,0,0,0,,ВОТ ЭТО УЖЕ НЕ ПРАЗДНЫЙ ВОПРОС. РАНЬШЕ
Dialogue: 0,0:07:45.43,0:07:47.92,Caption,,0,0,0,,ОТВЕТЫ ЗВУЧАЛИ НАМНОГО КОНКРЕТНЕЕ. ГРАНИЦЫ
Dialogue: 0,0:07:47.92,0:07:51.39,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО ПЕРВОГО ГОДА. КРЫМ. ТЕ САМЫЕ
Dialogue: 0,0:07:51.39,0:07:54.63,Caption,,0,0,0,,ОБЕЩАНИЯ ПРО КОФЕ. СЕЙЧАС ЭТА КОНКРЕТИКА ПОСТЕПЕННО
Dialogue: 0,0:07:54.63,0:07:57.51,Caption,,0,0,0,,ИСЧЕЗЛА. ОСТАЛАСЬ ФОРМУЛА ДОБРОВОЛЬНО ОТСТУПИТЬ
Dialogue: 0,0:07:57.51,0:08:00.11,Caption,,0,0,0,,ЗНАЧИТ ПРОИГРАТЬ. НО ЕСЛИ ДОБРОВОЛЬНЫЙ ОТХОД
Dialogue: 0,0:08:00.11,0:08:02.90,Caption,,0,0,0,,ЯВЛЯЕТСЯ ПОРАЖЕНИЕМ, ТОГДА ЧТО ЯВЛЯЕТСЯ ПОБЕДОЙ?
Dialogue: 0,0:08:03.21,0:08:06.56,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ ВСЕХ ТЕРРИТОРИЙ? ВЫХОД НА ГРАНИЦЫ ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:08:06.56,0:08:08.90,Caption,,0,0,0,,ДЕВЯНОСТО ПЕРВОГО ГОДА? ЧЛЕНСТВО В НАТО?
Dialogue: 0,0:08:08.98,0:08:12.45,Caption,,0,0,0,,СОХРАНЕНИЕ НЫНЕШНЕЙ ЛИНИИ? ПРОСТО ОТСУТСТВИЕ ПОДПИСИ ПОД
Dialogue: 0,0:08:12.45,0:08:15.06,Caption,,0,0,0,,ДОКУМЕНТОМ, КОТОРЫЙ МОЖНО НАЗВАТЬ КАПИТУЛЯЦИЕЙ?
Dialogue: 0,0:08:15.38,0:08:17.70,Caption,,0,0,0,,ПОТОМУ ЧТО НЕЛЬЗЯ БЕСКОНЕЧНО ПОЛЬЗОВАТЬСЯ СЛОВОМ
Dialogue: 0,0:08:17.70,0:08:22.15,Caption,,0,0,0,,"ПОБЕДА", НЕ ОБЪЯСНЯЯ, ГДЕ У НЕЁ ФИНИШНАЯ ЧЕРТА. ЗЕЛЕНСКИЙ
Dialogue: 0,0:08:22.15,0:08:28.03,Caption,,0,0,0,,ДОБАВЛЯЕТ ЕЩЁ ОДИН АРГУМЕНТ. ЕСЛИ ГОСУДАРСТВО ДОБРОВОЛЬНО ОТДАЁТ
Dialogue: 0,0:08:28.03,0:08:31.06,Caption,,0,0,0,,ЧАСТЬ ТЕРРИТОРИИ, НИКАКИЕ ГАРАНТИИ БЕЗОПАСНОСТИ НЕ
Dialogue: 0,0:08:31.06,0:08:34.02,Caption,,0,0,0,,ГАРАНТИРУЮТ, ЧТО ПОТОМ ОТ НЕГО НЕ ПОТРЕБУЮТ ЕЩЁ.
Dialogue: 0,0:08:34.02,0:08:36.65,Caption,,0,0,0,,ЛОГИКА ПОНЯТНАЯ. НО ТОГДА ПЕРЕГОВОРЫ ВООБЩЕ
Dialogue: 0,0:08:36.65,0:08:39.10,Caption,,0,0,0,,УПИРАЮТСЯ В ЖЕЛЕЗНУЮ ДВЕРЬ. МОСКВА ТРЕБУЕТ
Dialogue: 0,0:08:39.10,0:08:42.10,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫХ УСТУПОК. КИЕВ СЧИТАЕТ ДОБРОВОЛЬНУЮ
Dialogue: 0,0:08:42.10,0:08:45.34,Caption,,0,0,0,,УСТУПКУ ПОРАЖЕНИЕМ. ЗНАЧИТ, ОСТАЁТСЯ ТОЛЬКО ВАРИАНТ,
Dialogue: 0,0:08:45.67,0:08:47.69,Caption,,0,0,0,,ПРИ КОТОРОМ ОТСТУПЛЕНИЕ ПРОИСХОДИТ НЕ
Dialogue: 0,0:08:47.69,0:08:50.12,Caption,,0,0,0,,ДОБРОВОЛЬНО. И ВОТ ЭТО УЖЕ ОЧЕНЬ НЕПРИЯТНАЯ
Dialogue: 0,0:08:50.12,0:08:53.20,Caption,,0,0,0,,КОНСТРУКЦИЯ. ПОТОМУ ЧТО ОНА ОСТАВЛЯЕТ ВОЙНЕ СОБСТВЕННЫЙ
Dialogue: 0,0:08:53.20,0:08:55.58,Caption,,0,0,0,,МЕХАНИЗМ ПРИНЯТИЯ РЕШЕНИЙ ВМЕСТО ПОЛИТИКОВ.
Dialogue: 0,0:08:56.22,0:08:57.82,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ЛУКАШЕНКО ПРЕДЛАГАЕТ
Dialogue: 0,0:08:57.82,0:09:00.92,Caption,,0,0,0,,ВООБЩЕ МАКСИМАЛЬНО ПРОСТОЙ СПОСОБ. ГОТОВ ЛИЧНО ПОСАДИТЬ
Dialogue: 0,0:09:00.92,0:09:04.59,Caption,,0,0,0,,ЗЕЛЕНСКОГО В САМОЛЁТ, ПРИВЕЗТИ В МОСКВУ И ГАРАНТИРОВАТЬ ЕМУ
Dialogue: 0,0:09:04.59,0:09:07.18,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. ПО ЕГО СЛОВАМ, РОССИИ,
Dialogue: 0,0:09:07.26,0:09:09.15,Caption,,0,0,0,,УКРАИНЕ И БЕЛОРУССИИ БЫЛО БЫ ПРОЩЕ
Dialogue: 0,0:09:09.15,0:09:12.22,Caption,,0,0,0,,ДОГОВОРИТЬСЯ МЕЖДУ СОБОЙ, КАК ТРЁМ СЛАВЯНСКИМ НАРОДАМ,
Dialogue: 0,0:09:12.38,0:09:14.34,Caption,,0,0,0,,ЧЕМ БЕСКОНЕЧНО ТАСКАТЬ ЗА СТОЛ ВСЕХ
Dialogue: 0,0:09:14.34,0:09:17.86,Caption,,0,0,0,,ПОСРЕДНИКОВ. ЛУКАШЕНКО ПРИ ЭТОМ НЕ ОТРИЦАЕТ РОЛЬ
Dialogue: 0,0:09:17.86,0:09:20.26,Caption,,0,0,0,,ЕВРОПЫ И ОТДЕЛЬНО ГОВОРИТ О ЗНАЧЕНИИ ФРАНЦИИ
Dialogue: 0,0:09:20.26,0:09:22.81,Caption,,0,0,0,,ДЛЯ БУДУЩЕЙ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. НО ПО
Dialogue: 0,0:09:22.81,0:09:26.57,Caption,,0,0,0,,ВОПРОСУ БУДУЩЕГО РОССИИ, УКРАИНЫ И БЕЛОРУССИИ ОН СТАВИТ НА
Dialogue: 0,0:09:26.57,0:09:29.78,Caption,,0,0,0,,ПРЯМОЙ РАЗГОВОР ТРЁХ СТРАН. И ФОРМУЛИРУЕТ ЭТО В СВОЁМ
Dialogue: 0,0:09:29.78,0:09:31.98,Caption,,0,0,0,,СТИЛЕ. НЕ СОГЛАСИТСЯ ЗЕЛЕНСКИЙ,
Dialogue: 0,0:09:32.14,0:09:34.01,Caption,,0,0,0,,ТОГДА ПУСТЬ ИДЁТ НА ФРОНТ С АВТОМАТОМ
Dialogue: 0,0:09:34.01,0:09:36.49,Caption,,0,0,0,,И ВОЮЕТ САМ. ЗЕЛЕНСКИЙ ОТВЕЧАЕТ НЕ МЕНЕЕ
Dialogue: 0,0:09:36.49,0:09:40.77,Caption,,0,0,0,,БОДРО. ПУСТЬ ЛУКАШЕНКО ВОЗЬМЁТ ПУТИНА И
Dialogue: 0,0:09:40.77,0:09:44.07,Caption,,0,0,0,,ПРИЛЕТИТ В КИЕВ. БЕЗОПАСНОСТЬ ИМ ТОЖЕ ГАРАНТИРУЮТ. А
Dialogue: 0,0:09:44.07,0:09:46.45,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ЗАБРАТЬ ЕГО В МОСКВУ КОММЕНТИРУЕТ
Dialogue: 0,0:09:46.45,0:09:48.48,Caption,,0,0,0,,СОВСЕМ БЫТОВО "Я ЕМУ ЧТО, ЧЕМОДАН?"
Dialogue: 0,0:09:49.04,0:09:53.33,Caption,,0,0,0,,ВОТ, КСТАТИ, РЕДКИЙ СЛУЧАЙ, КОГДА ВСЁ УЖЕ СТАЛО ПОХОЖЕ НА РАЗГОВОР
Dialogue: 0,0:09:53.33,0:09:55.47,Caption,,0,0,0,,ЛЮДЕЙ ВОЗЛЕ СТОЙКИ РЕГИСТРАЦИИ. ОДИН
Dialogue: 0,0:09:55.47,0:09:59.04,Caption,,0,0,0,,ПРЕДЛАГАЕТ СВОЙ САМОЛЁТ, ВТОРОЙ ПРЕДЛАГАЕТ ВСТРЕЧНЫЙ МАРШРУТ,
Dialogue: 0,0:09:59.33,0:10:01.60,Caption,,0,0,0,,А ПЕРЕГОВОРЫ ТАК И СТОЯТ НА МЕСТЕ. ПРИ
Dialogue: 0,0:10:01.60,0:10:05.38,Caption,,0,0,0,,ЭТОМ ЛУКАШЕНКО ГОВОРИТ, ЧТО НЕ СОМНЕВАЕТСЯ В ВОЕННОЙ ПОБЕДЕ
Dialogue: 0,0:10:05.38,0:10:08.35,Caption,,0,0,0,,РОССИИ. И ЗДЕСЬ ВОЗНИКАЕТ ЕЩЁ ОДИН СЛОЙ. ЕСЛИ
Dialogue: 0,0:10:08.35,0:10:11.28,Caption,,0,0,0,,ОДНА СТОРОНА УВЕРЕНА, ЧТО ПОБЕДИТ ВОЕННЫМ ПУТЁМ,
Dialogue: 0,0:10:11.60,0:10:14.08,Caption,,0,0,0,,А ДРУГАЯ СЧИТАЕТ ДОБРОВОЛЬНЫЙ ТЕРРИТОРИАЛЬНЫЙ ОТХОД
Dialogue: 0,0:10:14.08,0:10:16.75,Caption,,0,0,0,,ПРОИГРЫШЕМ, ТО ГДЕ В ЭТОЙ КОНСТРУКЦИИ ВООБЩЕ
Dialogue: 0,0:10:16.75,0:10:20.44,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ МЕСТО ДЛЯ СДЕЛКИ? И ТУТ ОЧЕНЬ КСТАТИ ВЫХОДИТ МАТЕРИАЛ
Dialogue: 0,0:10:20.44,0:10:23.08,Caption,,0,0,0,,FOREIGN AFFAIRS С ЗАГОЛОВКОМ ПО СУТИ ПРОТИВОПОЛОЖНЫМ
Dialogue: 0,0:10:23.08,0:10:25.37,Caption,,0,0,0,,ВСЕЙ ЭТОЙ РИТОРИКЕ ПОРА ДОГОВАРИВАТЬСЯ С
Dialogue: 0,0:10:25.37,0:10:29.60,Caption,,0,0,0,,РОССИЕЙ. ТАМ ПРЯМО ГОВОРИТСЯ, ЧТО УКРАИНА ЭТУ ВОЙНУ НЕ ВЫИГРЫВАЕТ.
Dialogue: 0,0:10:29.60,0:10:32.64,Caption,,0,0,0,,АВТОР КРИТИКУЕТ ЗАПАДНУЮ ПОЛИТИКУ "КНУТА БЕЗ ПРЯНИКА",
Dialogue: 0,0:10:32.88,0:10:34.54,Caption,,0,0,0,,КОТОРАЯ ДЕЙСТВУЕТ ПРОТИВ РОССИИ С ДВЕ
Dialogue: 0,0:10:34.54,0:10:36.58,Caption,,0,0,0,,ТЫСЯЧИ ЧЕТЫРНАДЦАТОГО ГОДА И НЕ ДАЛА
Dialogue: 0,0:10:36.58,0:10:40.09,Caption,,0,0,0,,ОЖИДАЕМОГО РЕЗУЛЬТАТА. И ПРЕДЛАГАЕТ НАКОНЕЦ ПОЛОЖИТЬ НА СТОЛ
Dialogue: 0,0:10:40.09,0:10:43.32,Caption,,0,0,0,,НЕ ТОЛЬКО ДАВЛЕНИЕ, НО И СТИМУЛЫ. ПОЛУЧАЕТСЯ ПОЧТИ
Dialogue: 0,0:10:43.32,0:10:47.41,Caption,,0,0,0,,АНЕКДОТ. FINANCIAL TIMES ПИШЕТ,
Dialogue: 0,0:10:47.65,0:10:49.65,Caption,,0,0,0,,ЧТО АМЕРИКАНЦЫ ПОПРОБОВАЛИ СТИМУЛЫ,
Dialogue: 0,0:10:49.73,0:10:51.60,Caption,,0,0,0,,НЕ ДОБИЛИСЬ ИЗМЕНЕНИЯ РОССИЙСКОЙ
Dialogue: 0,0:10:51.60,0:10:53.82,Caption,,0,0,0,,ПОЗИЦИИ И ПЕРЕКЛЮЧИЛИСЬ НА ТЕРРИТОРИИ И
Dialogue: 0,0:10:53.82,0:10:56.61,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. А FOREIGN AFFAIRS ГОВОРИТ ВЫ СЛИШКОМ
Dialogue: 0,0:10:56.61,0:10:58.85,Caption,,0,0,0,,ДОЛГО ДАВИЛИ И ПОЧТИ НЕ ПРЕДЛАГАЛИ СТИМУЛОВ,
Dialogue: 0,0:10:59.08,0:11:02.05,Caption,,0,0,0,,ПОРА ЭТО МЕНЯТЬ. ОДНИ УЖЕ РАЗОЧАРОВАЛИСЬ В ПРЯНИКЕ.
Dialogue: 0,0:11:02.29,0:11:04.14,Caption,,0,0,0,,ДРУГИЕ ТОЛЬКО СЕЙЧАС ТРЕБУЮТ ДОСТАТЬ
Dialogue: 0,0:11:04.14,0:11:07.02,Caption,,0,0,0,,ПРЯНИК ИЗ ШКАФА. ТАМ ЖЕ ПОЯВЛЯЕТСЯ И ЕЩЁ ОДНА
Dialogue: 0,0:11:07.02,0:11:09.18,Caption,,0,0,0,,ПРИЧИНА СПЕШКИ. ТРАМП УЖЕ СМОТРИТ НА
Dialogue: 0,0:11:09.18,0:11:11.69,Caption,,0,0,0,,СОБСТВЕННОЕ ПОЛИТИЧЕСКОЕ НАСЛЕДИЕ. МИРНОЕ
Dialogue: 0,0:11:11.69,0:11:14.77,Caption,,0,0,0,,СОГЛАШЕНИЕ СТАЛО БЫ ДЛЯ НЕГО КРУПНЫМ РЕЗУЛЬТАТОМ. В
Dialogue: 0,0:11:14.77,0:11:17.36,Caption,,0,0,0,,МАТЕРИАЛЕ ДАЖЕ ВСПОМИНАЮТ ЕГО ДАВНЮЮ ТЯГУ К
Dialogue: 0,0:11:17.36,0:11:21.17,Caption,,0,0,0,,НОБЕЛЕВСКОЙ ПРЕМИИ. НО САМАЯ НЕПРИЯТНАЯ ЧАСТЬ СТАТЬИ КАСАЕТСЯ
Dialogue: 0,0:11:21.17,0:11:24.15,Caption,,0,0,0,,НЕ ПРЕМИЙ. FOREIGN AFFAIRS ПРИВОДИТ ИССЛЕДОВАНИЕ
Dialogue: 0,0:11:24.15,0:11:26.43,Caption,,0,0,0,,ВОЕННОГО СОЦИОЛОГА КОРОЛЕВСКОГО КОЛЛЕДЖА
Dialogue: 0,0:11:26.43,0:11:29.80,Caption,,0,0,0,,ЛОНДОНА АЛЕКСАНДРА ГРЕЙБЛА. АВТОР ИССЛЕДОВАНИЯ РАЗБИРАЕТ
Dialogue: 0,0:11:29.80,0:11:32.45,Caption,,0,0,0,,ПУБЛИЧНЫЕ ОЦЕНКИ ПОТЕРЬ И ПРИХОДИТ К ВЫВОДУ,
Dialogue: 0,0:11:32.69,0:11:35.07,Caption,,0,0,0,,ЧТО В АБСОЛЮТНЫХ ЦИФРАХ УКРАИНА ТЕРЯЕТ
Dialogue: 0,0:11:35.07,0:11:39.25,Caption,,0,0,0,,БОЛЬШЕ ЛЮДЕЙ, ЧЕМ РОССИЯ. ЕСЛИ ВЫВОДЫ ИССЛЕДОВАНИЯ ВЕРНЫ,
Dialogue: 0,0:11:39.49,0:11:41.48,Caption,,0,0,0,,ОНИ СТАВЯТ ПОД СОМНЕНИЕ ПРИВЫЧНУЮ
Dialogue: 0,0:11:41.48,0:11:43.92,Caption,,0,0,0,,КАРТИНУ, В КОТОРОЙ РОССИЯ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:11:43.92,0:11:47.29,Caption,,0,0,0,,БЕЗРАЗЛИЧНА К ПОТЕРЯМ СВОИХ ВОЕННОСЛУЖАЩИХ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:11:47.29,0:11:50.93,Caption,,0,0,0,,СНОВА ВОЗВРАЩАЕМСЯ В НАЧАЛО. ЗЕЛЕНСКИЙ ХОРОШО ОБЪЯСНИЛ,
Dialogue: 0,0:11:51.02,0:11:52.87,Caption,,0,0,0,,ЧТО ДЛЯ НЕГО БУДЕТ ПОРАЖЕНИЕМ.
Dialogue: 0,0:11:52.87,0:11:55.41,Caption,,0,0,0,,ДОБРОВОЛЬНО УЙТИ ИЗ ДОНБАССА. ХОРОШО.
Dialogue: 0,0:11:57.68,0:11:59.68,Caption,,0,0,0,,НО ЛЮДЯМ ВСЁ РАВНО ПРИДЁТСЯ КОГДА ЛИБО
Dialogue: 0,0:11:59.68,0:12:02.49,Caption,,0,0,0,,ОБЪЯСНИТЬ ВТОРУЮ ПОЛОВИНУ ЗАДАЧИ. ЧТО ИМЕННО
Dialogue: 0,0:12:02.49,0:12:05.10,Caption,,0,0,0,,БУДЕТ ПОБЕДОЙ И КАКОЙ ЦЕНОЙ ОНА ДОЛЖНА БЫТЬ
Dialogue: 0,0:12:05.10,0:12:08.33,Caption,,0,0,0,,ДОСТИГНУТА. ПОТОМУ ЧТО ВОЙНА НЕ ДОЛЖНА СУЩЕСТВОВАТЬ ТОЛЬКО
Dialogue: 0,0:12:08.33,0:12:11.19,Caption,,0,0,0,,РАДИ ТОГО, ЧТОБЫ НЕ НАЗВАТЬ РЕЗУЛЬТАТ ПОРАЖЕНИЕМ.
Dialogue: 0,0:12:11.19,0:12:13.68,Caption,,0,0,0,,У НЕЁ ЛИБО ЕСТЬ ДОСТИЖИМАЯ КОНЕЧНАЯ ТОЧКА,
Dialogue: 0,0:12:13.99,0:12:15.73,Caption,,0,0,0,,ЛИБО КАЖДЫЙ СЛЕДУЮЩИЙ МЕСЯЦ ПРОСТО
Dialogue: 0,0:12:15.73,0:12:18.35,Caption,,0,0,0,,СТАНОВИТСЯ СПОСОБОМ ОТЛОЖИТЬ НЕПРИЯТНЫЙ ОТВЕТ.
Dialogue: 0,0:12:18.35,0:12:20.40,Caption,,0,0,0,,АМЕРИКАНЦЫ УЖЕ ПРОБУЮТ ТО ДЕНЬГИ,
Dialogue: 0,0:12:20.50,0:12:23.70,Caption,,0,0,0,,ТО ГАРАНТИИ, ТО СРОКИ. ЛУКАШЕНКО ПРЕДЛАГАЕТ
Dialogue: 0,0:12:23.70,0:12:27.09,Caption,,0,0,0,,САМОЛЁТ. ЗЕЛЕНСКИЙ ЖДЁТ НОВЫЙ КОНГРЕСС. FOREIGN AFFAIRS
Dialogue: 0,0:12:27.09,0:12:29.34,Caption,,0,0,0,,ПРЕДЛАГАЕТ СНОВА ДОГОВАРИВАТЬСЯ. ЕВРОПА
Dialogue: 0,0:12:29.34,0:12:32.70,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОВОРИТ О БУДУЩЕМ ДИАЛОГЕ И ГОТОВИТ НОВЫЕ
Dialogue: 0,0:12:32.70,0:12:35.91,Caption,,0,0,0,,ОГРАНИЧЕНИЯ. А ПРОСТОЙ ВОПРОС ТАК НИКУДА И НЕ ДЕЛСЯ.
Dialogue: 0,0:12:35.91,0:12:37.68,Caption,,0,0,0,,ЕСЛИ ОТСТУПИТЬ ЗНАЧИТ ПРОИГРАТЬ,
Dialogue: 0,0:12:38.00,0:12:39.68,Caption,,0,0,0,,ТО ЧТО КОНКРЕТНО НАДО СДЕЛАТЬ,
Dialogue: 0,0:12:39.76,0:12:40.64,Caption,,0,0,0,,ЧТОБЫ ВЫИГРАТЬ?
