Dialogue: 0,0:00:00.12,0:00:02.36,Caption,,0,0,0,,О МИРЕ В ПОСЛЕДНИЕ ДНИ ГОВОРЯТ ВСЁ ГРОМЧЕ,
Dialogue: 0,0:00:02.56,0:00:05.00,Caption,,0,0,0,,ПРЯМО СО ВСЕХ УТЮГОВ. А КАРТА,
Dialogue: 0,0:00:05.27,0:00:08.68,Caption,,0,0,0,,ЗАРАЗА ТАКАЯ, НЕ СЛЫШИТ. НА НЕЙ ПО ПРЕЖНЕМУ ЧТО ТО
Dialogue: 0,0:00:08.68,0:00:13.08,Caption,,0,0,0,,ДВИГАЕТСЯ, РОЕТСЯ, УКРЕПЛЯЕТСЯ И ПЕРЕСТРАИВАЕТСЯ ТАК,
Dialogue: 0,0:00:13.40,0:00:15.72,Caption,,0,0,0,,БУДТО НИКТО НИЧЕГО ЗАКАНЧИВАТЬ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:00:16.27,0:00:18.60,Caption,,0,0,0,,ОТКРЫВАЕШЬ ЕЁ И ПОНИМАЕШЬ ТУТ ТОЧНО НЕ ПРО
Dialogue: 0,0:00:18.60,0:00:20.92,Caption,,0,0,0,,МИР. ТАМ ИДЁТ СОВСЕМ ДРУГАЯ ЖИЗНЬ.
Dialogue: 0,0:00:21.50,0:00:24.12,Caption,,0,0,0,,И ВЕДЬ САМОЕ ИНТЕРЕСНОЕ, ЧТО ЭТО НЕ ЗНАЧИТ,
Dialogue: 0,0:00:24.36,0:00:27.64,Caption,,0,0,0,,БУДТО ВСЕ РАЗГОВОРЫ О ПРЕКРАЩЕНИИ ОГНЯ ПУСТЫЕ. НЕТ.
Dialogue: 0,0:00:28.04,0:00:30.68,Caption,,0,0,0,,ИНОГДА ДОГОВАРИВАТЬСЯ ВСЁ ТАКИ ПОЛУЧАЕТСЯ. ВОТ
Dialogue: 0,0:00:30.68,0:00:33.24,Caption,,0,0,0,,АЛЁШКИ. ДОГОВОРИЛИСЬ НА ВРЕМЯ НЕ СТРЕЛЯТЬ,
Dialogue: 0,0:00:33.60,0:00:35.32,Caption,,0,0,0,,ПРОВЕЛИ ГУМАНИТАРНУЮ ОПЕРАЦИЮ,
Dialogue: 0,0:00:35.55,0:00:38.52,Caption,,0,0,0,,ВЫВЕЛИ ЛЮДЕЙ. ЖИЗНИ СПАСЕНЫ. УЖЕ ХОРОШО.
Dialogue: 0,0:00:39.14,0:00:41.40,Caption,,0,0,0,,УКРАИНСКАЯ СТОРОНА ПОСЛЕ ЭТОГО ДАЖЕ ЗАГОВОРИЛА О
Dialogue: 0,0:00:41.48,0:00:44.68,Caption,,0,0,0,,ТОМ, ЧТО ПОДОБНЫЙ ОПЫТ МОЖНО ПОПРОБОВАТЬ ИСПОЛЬЗОВАТЬ И
Dialogue: 0,0:00:44.68,0:00:47.72,Caption,,0,0,0,,НА ДРУГИХ УЧАСТКАХ ФРОНТА. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ
Dialogue: 0,0:00:47.72,0:00:50.36,Caption,,0,0,0,,РАЗБОРЫ, ПОДПИШИТЕСЬ. ПОЖАЛУЙСТА. ПОЧЕМУ НЕТ?
Dialogue: 0,0:00:50.65,0:00:53.32,Caption,,0,0,0,,ЕСЛИ МОЖНО ХОТЯ БЫ НА НЕСКОЛЬКО ЧАСОВ ПРЕКРАТИТЬ
Dialogue: 0,0:00:53.32,0:00:55.48,Caption,,0,0,0,,СТРЕЛЯТЬ И ВЫВЕСТИ МИРНЫХ ЖИТЕЛЕЙ,
Dialogue: 0,0:00:55.64,0:00:58.60,Caption,,0,0,0,,ЗНАЧИТ ЭТО НАДО ДЕЛАТЬ. А ДАЛЬШЕ НАЧАЛОСЬ ПРИВЫЧНОЕ.
Dialogue: 0,0:00:58.97,0:01:03.08,Caption,,0,0,0,,УКРАИНСКИЙ ГЕНШТАБ ЗАЯВИЛ, ЧТО РОССИЙСКИЕ ВОЕННЫЕ ИСПОЛЬЗОВАЛИ ПАУЗУ,
Dialogue: 0,0:01:03.16,0:01:05.32,Caption,,0,0,0,,ЧТОБЫ УКРЕПИТЬ ПОЗИЦИИ. ПЕСКОВ,
Dialogue: 0,0:01:05.48,0:01:10.12,Caption,,0,0,0,,В СВОЮ ОЧЕРЕДЬ, НЕ ИСКЛЮЧИЛ, ЧТО УКРАИНСКИЕ ПОДРАЗДЕЛЕНИЯ ТОЖЕ ИСПОЛЬЗОВАЛИ ЭТО
Dialogue: 0,0:01:10.12,0:01:16.16,Caption,,0,0,0,,ВРЕМЯ ДЛЯ ПЕРЕГРУППИРОВКИ. ПОТОМ УКРАИНСКИЙ ОМБУДСМЕН ЛУБИНЕЦ ЗАЯВИЛ,
Dialogue: 0,0:01:16.40,0:01:20.80,Caption,,0,0,0,,ЧТО ЧАСТЬ РОССИЙСКОЙ ТЕХНИКИ, КОТОРУЮ ПОКАЗЫВАЛИ КАК ДОКАЗАТЕЛЬСТВО НАРУШЕНИЙ,
Dialogue: 0,0:01:20.96,0:01:22.64,Caption,,0,0,0,,ВООБЩЕ ЗАНИМАЛАСЬ РАЗМИНИРОВАНИЕМ.
Dialogue: 0,0:01:23.30,0:01:26.00,Caption,,0,0,0,,И ЗНАЕТЕ, Я ЗДЕСЬ СОВЕРШЕННО НЕ ПОНИМАЮ,
Dialogue: 0,0:01:26.16,0:01:29.84,Caption,,0,0,0,,ЧЕМУ ВСЕ ТАК УДИВИЛИСЬ. А ЧТО ДОЛЖНЫ ДЕЛАТЬ СОЛДАТЫ,
Dialogue: 0,0:01:30.16,0:01:32.08,Caption,,0,0,0,,КОГДА ПО НИМ НЕСКОЛЬКО ЧАСОВ НЕ СТРЕЛЯЮТ?
Dialogue: 0,0:01:32.46,0:01:34.48,Caption,,0,0,0,,СИДЕТЬ НА ЯЩИКЕ С ПАТРОНАМИ И СМОТРЕТЬ НА
Dialogue: 0,0:01:34.56,0:01:38.32,Caption,,0,0,0,,ЧАСЫ? КОНЕЧНО, ОНИ БУДУТ ПОДВОЗИТЬ ЕДУ. КОНЕЧНО,
Dialogue: 0,0:01:38.47,0:01:41.52,Caption,,0,0,0,,ПАТРОНЫ. КОНЕЧНО, БУДУТ УКРЕПЛЯТЬ ПОЗИЦИИ,
Dialogue: 0,0:01:41.76,0:01:44.00,Caption,,0,0,0,,ЧИНИТЬ ТЕХНИКУ, ТАСКАТЬ МЕШКИ,
Dialogue: 0,0:01:44.08,0:01:48.40,Caption,,0,0,0,,КОПАТЬ ГЛУБЖЕ, ЕСЛИ ЕСТЬ ВОЗМОЖНОСТЬ. ПО ОБЕ СТОРОНЫ. ЭТО ВОЙНА.
Dialogue: 0,0:01:48.86,0:01:52.40,Caption,,0,0,0,,САМ ФАКТ, ЧТО НА ВРЕМЯ ОПЕРАЦИИ УДАЛОСЬ ПРЕКРАТИТЬ СТРЕЛЬБУ И
Dialogue: 0,0:01:52.48,0:01:54.88,Caption,,0,0,0,,ВЫВЕСТИ МИРНЫХ, ВАЖНЕЕ СПОРА О ТОМ,
Dialogue: 0,0:01:55.12,0:01:58.16,Caption,,0,0,0,,КТО КУДА ПРИВЁЗ ТУШЁНКУ. ХОТЯ ДАЛЬШЕ КАРТА КАК
Dialogue: 0,0:01:58.16,0:02:02.32,Caption,,0,0,0,,РАЗ И ПОКАЗЫВАЕТ, ПОЧЕМУ ОДИН ЛОКАЛЬНЫЙ ЭПИЗОД ЕЩЁ НИЧЕГО НЕ МЕНЯЕТ.
Dialogue: 0,0:02:02.52,0:02:05.04,Caption,,0,0,0,,ПОТОМУ ЧТО НА ДРУГИХ УЧАСТКАХ НИКТО НА ПАУЗУ
Dialogue: 0,0:02:05.12,0:02:07.92,Caption,,0,0,0,,НЕ НАЖИМАЛ. ПОД КУПЯНСКОМ ВОЙНА ВООБЩЕ ПОЛЕЗЛА ПОД
Dialogue: 0,0:02:07.92,0:02:11.44,Caption,,0,0,0,,ЗЕМЛЮ. ПО ДАННЫМ, КОТОРЫЕ ПРИВОДИТ THE NEW YORK TIMES,
Dialogue: 0,0:02:11.76,0:02:14.32,Caption,,0,0,0,,ПОДЗЕМНЫЕ ТРУБОПРОВОДЫ В РАЙОНЕ ГОРОДА ФАКТИЧЕСКИ
Dialogue: 0,0:02:14.32,0:02:17.04,Caption,,0,0,0,,ПРЕВРАТИЛИСЬ В ЧАСТЬ ОБОРОННОЙ ИНФРАСТРУКТУРЫ. ТО
Dialogue: 0,0:02:17.12,0:02:19.44,Caption,,0,0,0,,ЕСТЬ МАЛО НАМ БЫЛО ОКОПОВ, ПОДВАЛОВ,
Dialogue: 0,0:02:19.54,0:02:22.56,Caption,,0,0,0,,ПОСАДОК И РАЗВАЛИН. ТЕПЕРЬ ЕЩЁ И ТРУБЫ. КОГДА
Dialogue: 0,0:02:22.64,0:02:24.56,Caption,,0,0,0,,ТО ПО НИМ ДОЛЖЕН БЫЛ ИДТИ ГАЗ. ТЕПЕРЬ
Dialogue: 0,0:02:24.56,0:02:30.84,Caption,,0,0,0,,ТАМ МОГУТ ПЕРЕДВИГАТЬСЯ ЛЮДИ. ВОЙНА ВООБЩЕ ОЧЕНЬ БЫСТРО УЧИТ ИСПОЛЬЗОВАТЬ ЛЮБОЕ
Dialogue: 0,0:02:30.84,0:02:34.12,Caption,,0,0,0,,СООРУЖЕНИЕ СОВСЕМ НЕ ПО ИНСТРУКЦИИ. ДОМ СТАНОВИТСЯ
Dialogue: 0,0:02:34.12,0:02:37.65,Caption,,0,0,0,,ОГНЕВОЙ ТОЧКОЙ. ПОДВАЛ СТАНОВИТСЯ ШТАБОМ. ШАХТА
Dialogue: 0,0:02:37.65,0:02:41.08,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В УКРЫТИЕ. ТРУБА ПРЕВРАЩАЕТСЯ В ДОРОГУ.
Dialogue: 0,0:02:41.65,0:02:44.84,Caption,,0,0,0,,ПРОИЗВОДИТЕЛЬ, НАВЕРНОЕ, СИЛЬНО УДИВИЛСЯ БЫ,
Dialogue: 0,0:02:45.09,0:02:47.00,Caption,,0,0,0,,ЕСЛИ БЫ УВИДЕЛ СОВРЕМЕННУЮ ИНСТРУКЦИЮ ПО
Dialogue: 0,0:02:47.00,0:02:50.12,Caption,,0,0,0,,ЭКСПЛУАТАЦИИ. НО С ВОЕННОЙ ТОЧКИ ЗРЕНИЯ ВСЁ ПОНЯТНО.
Dialogue: 0,0:02:50.52,0:02:52.60,Caption,,0,0,0,,НАВЕРХУ ТЕБЯ ВИДЯТ БЕСПИЛОТНИКИ. ДОРОГИ
Dialogue: 0,0:02:52.60,0:02:55.56,Caption,,0,0,0,,ПРОСМАТРИВАЮТСЯ. ЛЮБОЕ ЗАМЕТНОЕ ДВИЖЕНИЕ МОЖЕТ
Dialogue: 0,0:02:55.56,0:02:58.68,Caption,,0,0,0,,ЗАКОНЧИТЬСЯ ПРИЛЁТОМ. А ПОД ЗЕМЛЁЙ СОВСЕМ ДРУГАЯ
Dialogue: 0,0:02:58.68,0:03:01.56,Caption,,0,0,0,,ИСТОРИЯ. ИМЕННО ПОЭТОМУ БОРЬБА ИДЁТ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:03:01.56,0:03:05.08,Caption,,0,0,0,,ЗА УЛИЦЫ, ВЫСОТЫ И ДОРОГИ. ОНА ИДЁТ ЗА ТО,
Dialogue: 0,0:03:05.16,0:03:09.96,Caption,,0,0,0,,ЧТО НАХОДИТСЯ ПОД НИМИ. ПОДЗЕМНЫЕ КОММУНИКАЦИИ СТАНОВЯТСЯ ЧАСТЬЮ ПОЛЯ БОЯ.
Dialogue: 0,0:03:10.41,0:03:13.32,Caption,,0,0,0,,ЭТО ОЧЕНЬ ПОКАЗАТЕЛЬНЫЙ МОМЕНТ. КОГДА ВОЙНА ДЛИТСЯ
Dialogue: 0,0:03:13.32,0:03:16.92,Caption,,0,0,0,,ДОЛГО, ОНА ПОСТЕПЕННО СЪЕДАЕТ ВСЮ ОБЫЧНУЮ ИНФРАСТРУКТУРУ
Dialogue: 0,0:03:17.00,0:03:19.56,Caption,,0,0,0,,ВОКРУГ СЕБЯ. ПРИЧЁМ НЕ ОБЯЗАТЕЛЬНО УНИЧТОЖАЕТ.
Dialogue: 0,0:03:19.88,0:03:23.00,Caption,,0,0,0,,ИНОГДА ПРОСТО ПРИСПОСАБЛИВАЕТ ПОД СЕБЯ. ТРУБА УЖЕ НЕ
Dialogue: 0,0:03:23.00,0:03:25.72,Caption,,0,0,0,,ТРУБА. ТЕПЕРЬ ЭТО МАРШРУТ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:03:25.88,0:03:28.20,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. А НАВЕРХУ,
Dialogue: 0,0:03:28.36,0:03:31.88,Caption,,0,0,0,,НА КАРТЕ, ДВИЖЕНИЕ ПРОДОЛЖАЕТСЯ. НА ДНЕПРОПЕТРОВСКОМ
Dialogue: 0,0:03:31.96,0:03:35.00,Caption,,0,0,0,,НАПРАВЛЕНИИ УКРАИНСКИЕ СИЛЫ ПЫТАЮТСЯ ЗАКРЕПЛЯТЬСЯ НА
Dialogue: 0,0:03:35.00,0:03:38.04,Caption,,0,0,0,,ПОДСТУПАХ К ВЕСЁЛОМУ И В САМОМ НАСЕЛЁННОМ ПУНКТЕ.
Dialogue: 0,0:03:38.17,0:03:40.60,Caption,,0,0,0,,НА ГУЛЯЙПОЛЬСКОМ НАПРАВЛЕНИИ РОССИЙСКИЕ ВОЙСКА
Dialogue: 0,0:03:40.60,0:03:42.68,Caption,,0,0,0,,ПРОДОЛЖАЮТ НАСТУПАТЕЛЬНЫЕ ДЕЙСТВИЯ.
Dialogue: 0,0:03:44.96,0:03:47.36,Caption,,0,0,0,,DEEPSTATE СООБЩАЕТ О ПРОДВИЖЕНИИ РОССИЙСКИХ
Dialogue: 0,0:03:47.36,0:03:50.24,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЙ В РАЙОНАХ ГУЛЯЙПОЛЬСКОГО И ГОРЬКОГО.
Dialogue: 0,0:03:50.53,0:03:52.72,Caption,,0,0,0,,ПРИЧЁМ ЗДЕСЬ ВАЖНО НЕ УСТРАИВАТЬ СОРЕВНОВАНИЕ
Dialogue: 0,0:03:52.72,0:03:55.92,Caption,,0,0,0,,СТРЕЛОЧЕК. НА ОДНОЙ КАРТЕ КАЖДЫЙ ДЕНЬ МОЖНО НАЙТИ
Dialogue: 0,0:03:55.92,0:03:58.32,Caption,,0,0,0,,УЧАСТОК, ГДЕ КТО ТО ПРОДВИНУЛСЯ,
Dialogue: 0,0:03:58.55,0:04:01.36,Caption,,0,0,0,,ГДЕ ТО ОТСТУПИЛ, ГДЕ ТО ЗАНЯЛ НЕСКОЛЬКО ДОМОВ,
Dialogue: 0,0:04:01.52,0:04:04.64,Caption,,0,0,0,,ГДЕ ТО ПОТЕРЯЛ ПОСАДКУ. ЕСЛИ СМОТРЕТЬ НА КАЖДУЮ
Dialogue: 0,0:04:04.72,0:04:08.48,Caption,,0,0,0,,ТАКУЮ ТОЧКУ ОТДЕЛЬНО, ДОВОЛЬНО БЫСТРО ПРЕВРАЩАЕШЬСЯ В ЧЕЛОВЕКА,
Dialogue: 0,0:04:08.68,0:04:12.00,Caption,,0,0,0,,КОТОРЫЙ С ЛУПОЙ СЧИТАЕТ САРАИ. СМЫСЛ В ДРУГОМ.
Dialogue: 0,0:04:12.40,0:04:14.80,Caption,,0,0,0,,РАЗГОВОРЫ О МИРЕ ИДУТ СЕЙЧАС НА ФОНЕ ТОГО,
Dialogue: 0,0:04:14.96,0:04:17.68,Caption,,0,0,0,,ЧТО САМИ АРМИИ ПРОДОЛЖАЮТ РЕШАТЬ СОВЕРШЕННО
Dialogue: 0,0:04:17.68,0:04:21.92,Caption,,0,0,0,,ПРАКТИЧЕСКИЕ ЗАДАЧИ. ЗАНЯТЬ. УДЕРЖАТЬ. ПОДВЕЗТИ.
Dialogue: 0,0:04:22.22,0:04:25.92,Caption,,0,0,0,,ЗАКРЕПИТЬСЯ. ВЫБИТЬ. НЕ ДАТЬ ЗАКРЕПИТЬСЯ. И НИКТО ИЗ
Dialogue: 0,0:04:25.92,0:04:28.08,Caption,,0,0,0,,СОЛДАТ В ОКОПЕ НЕ МОЖЕТ СКАЗАТЬ НУ РАЗ
Dialogue: 0,0:04:28.08,0:04:29.92,Caption,,0,0,0,,НАВЕРХУ СНОВА ЗАГОВОРИЛИ О МИРЕ,
Dialogue: 0,0:04:30.15,0:04:32.56,Caption,,0,0,0,,СЕГОДНЯ ДАВАЙТЕ ОСОБО НЕ СТАРАТЬСЯ. ПОТОМУ ЧТО
Dialogue: 0,0:04:32.56,0:04:35.28,Caption,,0,0,0,,ИМЕННО ПОЛОЖЕНИЕ НА ЗЕМЛЕ ПОТОМ ОЧЕНЬ ЧАСТО И
Dialogue: 0,0:04:35.28,0:04:38.64,Caption,,0,0,0,,ОПРЕДЕЛЯЕТ, С ЧЕМ СТОРОНЫ ПРИХОДЯТ К ЛЮБОМУ СЛЕДУЮЩЕМУ
Dialogue: 0,0:04:38.64,0:04:41.76,Caption,,0,0,0,,РАЗГОВОРУ. НО ЕСТЬ ЕЩЁ ОДНА ВЕЩЬ. МЕНЯЕТСЯ НЕ
Dialogue: 0,0:04:41.84,0:04:45.52,Caption,,0,0,0,,ТОЛЬКО САМА ЛИНИЯ ФРОНТА. МЕНЯЕТСЯ СПОСОБ ВОЙНЫ. В
Dialogue: 0,0:04:45.52,0:04:50.08,Caption,,0,0,0,,КИЕВЕ, НАПРИМЕР, РАЗВЕРНУЛИ НОВУЮ СИСТЕМУ ЗАЩИТЫ ОТ БЕСПИЛОТНИКОВ С
Dialogue: 0,0:04:50.08,0:04:52.96,Caption,,0,0,0,,ДИСТАНЦИОННЫМ УПРАВЛЕНИЕМ. ОБ ЭТОМ ЗАЯВИЛ СОВЕТНИК
Dialogue: 0,0:04:52.96,0:04:55.04,Caption,,0,0,0,,ПРЕЗИДЕНТА УКРАИНЫ СЕРГЕЙ БЕСКРЕСТНОВ.
Dialogue: 0,0:04:57.24,0:05:00.83,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, СИСТЕМА ДОЛЖНА ПОДАВЛЯТЬ КАНАЛЫ СВЯЗИ МЕЖДУ
Dialogue: 0,0:05:00.83,0:05:02.83,Caption,,0,0,0,,РОССИЙСКИМИ ОПЕРАТОРАМИ И ДРОНАМИ,
Dialogue: 0,0:05:03.02,0:05:05.96,Caption,,0,0,0,,КОТОРЫМИ ТЕ УПРАВЛЯЮТ ДИСТАНЦИОННО. БЕСКРЕСТНОВ
Dialogue: 0,0:05:05.96,0:05:09.56,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО ЭТА ЗАЩИТА УЖЕ ЗАСТАВИЛА РОССИЙСКИЕ СИЛЫ
Dialogue: 0,0:05:09.72,0:05:12.83,Caption,,0,0,0,,СОКРАТИТЬ ПРИМЕНЕНИЕ ПОДОБНЫХ АППАРАТОВ И ИСКАТЬ
Dialogue: 0,0:05:12.83,0:05:16.44,Caption,,0,0,0,,ДРУГИЕ СПОСОБЫ УПРАВЛЕНИЯ. И ВОТ ЭТО УЖЕ НАСТОЯЩЕЕ
Dialogue: 0,0:05:16.44,0:05:19.08,Caption,,0,0,0,,ТЕХНИЧЕСКОЕ СОРЕВНОВАНИЕ. БЕЗ КРАСИВЫХ СЛОВ.
Dialogue: 0,0:05:19.69,0:05:21.80,Caption,,0,0,0,,ОДНА СТОРОНА ПРИДУМЫВАЕТ СПОСОБ ПРОВЕСТИ
Dialogue: 0,0:05:21.80,0:05:23.88,Caption,,0,0,0,,БЕСПИЛОТНИК. ВТОРАЯ ПРИДУМЫВАЕТ,
Dialogue: 0,0:05:24.19,0:05:27.32,Caption,,0,0,0,,КАК ОБОРВАТЬ ЕМУ СВЯЗЬ. ПЕРВАЯ ИЩЕТ ДРУГОЙ КАНАЛ.
Dialogue: 0,0:05:27.56,0:05:32.04,Caption,,0,0,0,,ВТОРАЯ НАЧИНАЕТ ДУМАТЬ, КАК ЗАДАВИТЬ И ЕГО. ТАК И ЖИВЁМ. СНАЧАЛА
Dialogue: 0,0:05:32.04,0:05:35.00,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЗАМОК. ЧЕРЕЗ НЕДЕЛЮ КТО ТО УЖЕ ПРОДАЁТ
Dialogue: 0,0:05:35.08,0:05:38.44,Caption,,0,0,0,,НОВУЮ ОТМЫЧКУ. ПОТОМ ПОЯВЛЯЕТСЯ НОВЫЙ ЗАМОК. ПОТОМ
Dialogue: 0,0:05:38.44,0:05:41.96,Caption,,0,0,0,,НОВАЯ ОТМЫЧКА. ТОЛЬКО ЗДЕСЬ ЦЕНА ОШИБКИ КУДА ВЫШЕ,
Dialogue: 0,0:05:42.12,0:05:45.32,Caption,,0,0,0,,ЧЕМ СЛОМАННЫЙ ГАРАЖНЫЙ ЗАМОК. БЕСКРЕСТНОВ И РАНЬШЕ
Dialogue: 0,0:05:45.32,0:05:48.04,Caption,,0,0,0,,ПРЕДУПРЕЖДАЛ О РАЗВИТИИ РОССИЙСКИХ СИСТЕМ УПРАВЛЕНИЯ
Dialogue: 0,0:05:48.04,0:05:50.84,Caption,,0,0,0,,БЕСПИЛОТНИКАМИ И ГОВОРИЛ О ВОЗМОЖНОСТЯХ,
Dialogue: 0,0:05:51.08,0:05:53.48,Caption,,0,0,0,,КОТОРЫЕ МОГУТ ПОЯВИТЬСЯ ПРИ РАСШИРЕНИИ СПУТНИКОВОЙ
Dialogue: 0,0:05:53.48,0:05:56.60,Caption,,0,0,0,,СВЯЗИ. И ВОТ ПОЧЕМУ НОВЫЙ КИЕВСКИЙ КУПОЛ НЕ
Dialogue: 0,0:05:56.60,0:06:01.08,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ПРОБЛЕМА РЕШЕНА. НИКАКОГО ВОЛШЕБНОГО КУПОЛА НЕТ.
Dialogue: 0,0:06:01.36,0:06:03.96,Caption,,0,0,0,,КСТАТИ, ПОЭТОМУ МНЕ ВСЕГДА НЕМНОГО СМЕШНО,
Dialogue: 0,0:06:04.20,0:06:07.32,Caption,,0,0,0,,КОГДА ОЧЕРЕДНУЮ НОВУЮ ВОЕННУЮ СИСТЕМУ ПРЕДСТАВЛЯЮТ
Dialogue: 0,0:06:07.32,0:06:09.96,Caption,,0,0,0,,ЧУТЬ ЛИ НЕ КАК ОКОНЧАТЕЛЬНОЕ РЕШЕНИЕ ПРОБЛЕМЫ.
Dialogue: 0,0:06:10.44,0:06:12.68,Caption,,0,0,0,,ОКОНЧАТЕЛЬНЫХ РЕШЕНИЙ ЗДЕСЬ ПОЧТИ НЕ БЫВАЕТ.
Dialogue: 0,0:06:14.95,0:06:17.75,Caption,,0,0,0,,ЕСТЬ ВРЕМЕННОЕ ПРЕИМУЩЕСТВО. И ЕСТЬ ВРЕМЯ,
Dialogue: 0,0:06:17.97,0:06:21.11,Caption,,0,0,0,,ЗА КОТОРОЕ ПРОТИВНИК УСПЕЕТ ПРИДУМАТЬ ОТВЕТ. А ПОКА
Dialogue: 0,0:06:21.11,0:06:23.99,Caption,,0,0,0,,КИЕВ СТАВИТ НОВЫЕ СРЕДСТВА ЗАЩИТЫ ОТ БЕСПИЛОТНИКОВ,
Dialogue: 0,0:06:24.35,0:06:27.11,Caption,,0,0,0,,УКРАИНСКАЯ ЭНЕРГОСИСТЕМА РЕШАЕТ УЖЕ СОВСЕМ ДРУГУЮ
Dialogue: 0,0:06:27.11,0:06:30.55,Caption,,0,0,0,,ПРОБЛЕМУ. И ВОТ ЗДЕСЬ ЦИФРА ДЕЙСТВИТЕЛЬНО ЗАСТАВЛЯЕТ
Dialogue: 0,0:06:30.55,0:06:34.23,Caption,,0,0,0,,ОСТАНОВИТЬСЯ. ЭНЕРГЕТИЧЕСКИЙ ЭКСПЕРТ ЮРИЙ КОРОЛЬЧУК ЗАЯВИЛ,
Dialogue: 0,0:06:34.47,0:06:36.87,Caption,,0,0,0,,ЧТО В СТРАНЕ УНИЧТОЖЕНА УЖЕ ТРЕТЬЯ СХЕМА
Dialogue: 0,0:06:36.95,0:06:39.59,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЯ ЭЛЕКТРОЭНЕРГИИ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:06:39.76,0:06:42.23,Caption,,0,0,0,,СХЕМЫ ПЕРЕСТРАИВАЛИ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ
Dialogue: 0,0:06:42.31,0:06:44.63,Caption,,0,0,0,,ГОДУ, ПОТОМ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОМ,
Dialogue: 0,0:06:44.83,0:06:47.67,Caption,,0,0,0,,ПОТОМ СНОВА В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОМ. И
Dialogue: 0,0:06:47.67,0:06:50.07,Caption,,0,0,0,,СХЕМУ, КОТОРУЮ СОЗДАВАЛИ В ЭТОМ ГОДУ,
Dialogue: 0,0:06:50.35,0:06:53.83,Caption,,0,0,0,,УЖЕ ПРИШЛОСЬ МЕНЯТЬ. ВОТ ЭТО, НА МОЙ ВЗГЛЯД,
Dialogue: 0,0:06:53.99,0:06:57.19,Caption,,0,0,0,,ГОРАЗДО ВАЖНЕЕ ОЧЕРЕДНОГО СООБЩЕНИЯ В СТИЛЕ ГДЕ ТО
Dialogue: 0,0:06:57.19,0:06:59.91,Caption,,0,0,0,,ПОВРЕЖДЕНА ОЧЕРЕДНАЯ ПОДСТАНЦИЯ. ПОТОМУ ЧТО
Dialogue: 0,0:06:59.91,0:07:03.03,Caption,,0,0,0,,ОТДЕЛЬНЫЙ ПОВРЕЖДЁННЫЙ ОБЪЕКТ МОЖНО ОТРЕМОНТИРОВАТЬ.
Dialogue: 0,0:07:03.33,0:07:05.91,Caption,,0,0,0,,ТРАНСФОРМАТОР МОЖНО ЗАМЕНИТЬ. ЛИНИЮ МОЖНО
Dialogue: 0,0:07:05.91,0:07:08.47,Caption,,0,0,0,,ВОССТАНОВИТЬ. А ЗДЕСЬ РЕЧЬ ИДЁТ УЖЕ О ТОМ,
Dialogue: 0,0:07:08.79,0:07:10.71,Caption,,0,0,0,,ЧТО ПРИХОДИТСЯ ЗАНОВО ПРИДУМЫВАТЬ,
Dialogue: 0,0:07:11.09,0:07:14.55,Caption,,0,0,0,,КАК ВООБЩЕ ГОНЯТЬ ЭЛЕКТРИЧЕСТВО ПО СТРАНЕ. КОРОЛЬЧУК
Dialogue: 0,0:07:14.63,0:07:17.35,Caption,,0,0,0,,ОБРАЩАЕТ ВНИМАНИЕ НА ВАЖНУЮ ВЕЩЬ. УКРАИНСКАЯ
Dialogue: 0,0:07:17.35,0:07:20.07,Caption,,0,0,0,,ЭНЕРГОСИСТЕМА ЕДИНАЯ. ЭТО ЗНАЧИТ,
Dialogue: 0,0:07:20.35,0:07:23.27,Caption,,0,0,0,,ЧТО ЕСЛИ СЕРЬЁЗНЫЕ ПРОБЛЕМЫ ВОЗНИКАЮТ В КИЕВЕ,
Dialogue: 0,0:07:23.35,0:07:25.83,Caption,,0,0,0,,ХАРЬКОВЕ, ДНЕПРОПЕТРОВСКЕ ИЛИ ОДЕССЕ,
Dialogue: 0,0:07:26.17,0:07:27.75,Caption,,0,0,0,,НЕЛЬЗЯ ПРОСТО СКАЗАТЬ НУ ЛАДНО,
Dialogue: 0,0:07:27.91,0:07:30.39,Caption,,0,0,0,,ЗАПАД СТРАНЫ ЭТО НЕ КАСАЕТСЯ. КАСАЕТСЯ.
Dialogue: 0,0:07:32.66,0:07:35.14,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО НЕ ЗНАЕТ АДМИНИСТРАТИВНЫХ ГРАНИЦ
Dialogue: 0,0:07:35.22,0:07:38.18,Caption,,0,0,0,,ОБЛАСТЕЙ. У НЕГО ВООБЩЕ ПЛОХОЕ ЧУВСТВО ПАТРИОТИЗМА.
Dialogue: 0,0:07:38.48,0:07:40.82,Caption,,0,0,0,,ОНО ИДЁТ ТУДА, КУДА ПОЗВОЛЯЮТ СЕТИ.
Dialogue: 0,0:07:41.45,0:07:43.22,Caption,,0,0,0,,ЕСЛИ ВЫБИЛИ ОДИН КРУПНЫЙ УЗЕЛ,
Dialogue: 0,0:07:43.46,0:07:46.10,Caption,,0,0,0,,ПОТОКИ ПРИХОДИТСЯ ПЕРЕРАСПРЕДЕЛЯТЬ. ЕСЛИ ВЫБИЛИ
Dialogue: 0,0:07:46.10,0:07:49.78,Caption,,0,0,0,,ВТОРОЙ, СИСТЕМУ СНОВА ПЕРЕСТРАИВАЮТ. ЕСЛИ ПОТОМ НАЧИНАЮТ
Dialogue: 0,0:07:49.86,0:07:53.70,Caption,,0,0,0,,БИТЬ УЖЕ ПО ТОЙ СХЕМЕ, КОТОРУЮ ПОСТРОИЛИ ПОСЛЕ ПРЕДЫДУЩИХ УДАРОВ,
Dialogue: 0,0:07:53.86,0:07:56.34,Caption,,0,0,0,,ПРИХОДИТСЯ ПРИДУМЫВАТЬ ЕЩЁ ОДНУ. И ВОТ ЭТО УЖЕ
Dialogue: 0,0:07:56.42,0:07:59.06,Caption,,0,0,0,,НЕ ПРОСТО РЕМОНТ. ЭТО ПОСТОЯННОЕ ИЗМЕНЕНИЕ
Dialogue: 0,0:07:59.06,0:08:04.26,Caption,,0,0,0,,АРХИТЕКТУРЫ СИСТЕМЫ. ПО СУТИ, ЭНЕРГЕТИКИ КАЖДЫЙ РАЗ ПЫТАЮТСЯ СОБРАТЬ НОВУЮ ДОРОГУ
Dialogue: 0,0:08:04.26,0:08:08.42,Caption,,0,0,0,,ТАМ, ГДЕ СТАРУЮ УЖЕ ПЕРЕКОПАЛИ. СОБРАЛИ ОБХОД. УДАРИЛИ ПО
Dialogue: 0,0:08:08.50,0:08:11.46,Caption,,0,0,0,,ОБХОДУ. СОБРАЛИ ОБХОД ОБХОДА. А ПОТОМ КТО ТО
Dialogue: 0,0:08:11.46,0:08:14.74,Caption,,0,0,0,,СПРАШИВАЕТ, ПОЧЕМУ СВЕТ СКАЧЕТ. ДА ПОТОМУ ЧТО СИСТЕМА УЖЕ
Dialogue: 0,0:08:14.74,0:08:16.58,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ РАБОТАЕТ В РЕЖИМЕ,
Dialogue: 0,0:08:16.75,0:08:19.54,Caption,,0,0,0,,ДЛЯ КОТОРОГО ЕЁ ВООБЩЕ НИКТО НЕ ПРОЕКТИРОВАЛ. И
Dialogue: 0,0:08:19.62,0:08:22.10,Caption,,0,0,0,,ЗДЕСЬ СНОВА ВОЗВРАЩАЕМСЯ К КАРТЕ. ТОЛЬКО ТЕПЕРЬ НЕ
Dialogue: 0,0:08:22.18,0:08:25.38,Caption,,0,0,0,,ВОЕННОЙ. ЕСТЬ КАРТА ФРОНТА. ЕСТЬ КАРТА
Dialogue: 0,0:08:25.38,0:08:28.10,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИХ СЕТЕЙ. ЕСТЬ КАРТА МАРШРУТОВ
Dialogue: 0,0:08:28.10,0:08:31.06,Caption,,0,0,0,,БЕСПИЛОТНИКОВ. ЕСТЬ ПОДЗЕМНАЯ КАРТА ТРУБОПРОВОДОВ
Dialogue: 0,0:08:31.06,0:08:33.71,Caption,,0,0,0,,ПОД КУПЯНСКОМ. И ВСЕ ОНИ СЕЙЧАС МЕНЯЮТСЯ
Dialogue: 0,0:08:33.71,0:08:36.83,Caption,,0,0,0,,ОДНОВРЕМЕННО. ВОТ ЭТО И ЕСТЬ РЕАЛЬНАЯ КАРТИНА. НЕ
Dialogue: 0,0:08:36.83,0:08:40.10,Caption,,0,0,0,,ОДНА ЛИНИЯ ПЕРЕГОВОРОВ. НЕ ОДИН ГРОМКИЙ ЗАГОЛОВОК.
Dialogue: 0,0:08:40.42,0:08:43.30,Caption,,0,0,0,,НЕ ОДНО ЗАЯВЛЕНИЕ КАКОГО НИБУДЬ ОЧЕРЕДНОГО ЧЕЛОВЕКА
Dialogue: 0,0:08:43.38,0:08:47.51,Caption,,0,0,0,,В КОСТЮМЕ. А ОГРОМНАЯ СИСТЕМА,
Dialogue: 0,0:08:47.66,0:08:49.99,Caption,,0,0,0,,ГДЕ ВСЕ ПРОДОЛЖАЮТ ЧТО ТО ПЕРЕДВИГАТЬ,
Dialogue: 0,0:08:50.09,0:08:54.23,Caption,,0,0,0,,ПЕРЕСТРАИВАТЬ, УСИЛИВАТЬ И ЗАЩИЩАТЬ. ПРИЧЁМ ОБРАТИТЕ ВНИМАНИЕ НА
Dialogue: 0,0:08:54.23,0:08:56.87,Caption,,0,0,0,,ЕЩЁ ОДНУ ВЕЩЬ. ВО ВСЕХ ЭТИХ НОВОСТЯХ ЕСТЬ
Dialogue: 0,0:08:56.89,0:09:01.91,Caption,,0,0,0,,ОДНО ОБЩЕЕ СЛОВО, ХОТЯ ЕГО НИКТО НЕ ПРОИЗНОСИТ. ПРИСПОСОБЛЕНИЕ. ВСЕ
Dialogue: 0,0:09:01.91,0:09:05.27,Caption,,0,0,0,,ПРИСПОСАБЛИВАЮТСЯ. ВОЕННЫЕ ПРИСПОСАБЛИВАЮТ ПОДЗЕМНЫЕ
Dialogue: 0,0:09:05.35,0:09:08.47,Caption,,0,0,0,,ТРУБЫ. АРМИИ ПРИСПОСАБЛИВАЮТСЯ К ИЗМЕНЕНИЮ ЛИНИИ
Dialogue: 0,0:09:08.55,0:09:11.59,Caption,,0,0,0,,ФРОНТА. КИЕВ ПРИСПОСАБЛИВАЕТ РАДИОЭЛЕКТРОННУЮ БОРЬБУ
Dialogue: 0,0:09:11.67,0:09:14.87,Caption,,0,0,0,,К НОВЫМ ТИПАМ УПРАВЛЕНИЯ БЕСПИЛОТНИКАМИ. ЭНЕРГЕТИКИ
Dialogue: 0,0:09:14.87,0:09:17.99,Caption,,0,0,0,,ПРИСПОСАБЛИВАЮТ СЕТЬ К НОВЫМ ПОВРЕЖДЕНИЯМ. И ЭТО,
Dialogue: 0,0:09:18.15,0:09:22.07,Caption,,0,0,0,,ПОЖАЛУЙ, ЛУЧШЕ ВСЕГО ПОКАЗЫВАЕТ НЫНЕШНЕЕ СОСТОЯНИЕ КОНФЛИКТА.
Dialogue: 0,0:09:22.47,0:09:25.35,Caption,,0,0,0,,КАЖДАЯ СТОРОНА ПЫТАЕТСЯ НАЙТИ ЕЩЁ ОДИН СПОСОБ
Dialogue: 0,0:09:25.43,0:09:27.75,Caption,,0,0,0,,ПОЛУЧИТЬ ПРЕИМУЩЕСТВО ДО ТОГО МОМЕНТА,
Dialogue: 0,0:09:27.99,0:09:30.71,Caption,,0,0,0,,КОГДА ПРЕИМУЩЕСТВО УЖЕ БУДЕТ НЕ НУЖНО. ВОТ ТАКОЙ
Dialogue: 0,0:09:30.71,0:09:33.99,Caption,,0,0,0,,ПАРАДОКС. ВСЕ ВРОДЕ ХОТЯТ ОДНАЖДЫ ЗАКОНЧИТЬ. НО ПОКА
Dialogue: 0,0:09:34.07,0:09:37.19,Caption,,0,0,0,,НЕ ЗАКОНЧИЛИ, НИКТО НЕ ХОЧЕТ ОКАЗАТЬСЯ ТЕМ ИДИОТОМ,
Dialogue: 0,0:09:37.39,0:09:40.47,Caption,,0,0,0,,КОТОРЫЙ ПЕРВЫМ РЕШИЛ РАССЛАБИТЬСЯ. ИМЕННО ПОЭТОМУ
Dialogue: 0,0:09:40.55,0:09:43.59,Caption,,0,0,0,,КАРТА ПОКА ЖИВЁТ ОТДЕЛЬНО ОТ РАЗГОВОРОВ. НА СЛОВАХ
Dialogue: 0,0:09:43.59,0:09:46.47,Caption,,0,0,0,,МИР УЖЕ ПОЯВИЛСЯ. НА ЗЕМЛЕ ЕГО ПОКА ПРИХОДИТСЯ
Dialogue: 0,0:09:46.55,0:09:48.95,Caption,,0,0,0,,ИСКАТЬ С ЛУПОЙ. И ЕСЛИ ХОЧЕТСЯ ПОНЯТЬ,
Dialogue: 0,0:09:49.03,0:09:52.55,Caption,,0,0,0,,ЧТО БУДЕТ ДАЛЬШЕ, Я БЫ ПОКА СМОТРЕЛ НЕ НА КОЛИЧЕСТВО СЛОВА
Dialogue: 0,0:09:52.63,0:09:55.11,Caption,,0,0,0,,МИР В ЗАГОЛОВКАХ. Я БЫ СМОТРЕЛ НА КАРТУ.
Dialogue: 0,0:09:55.50,0:09:59.19,Caption,,0,0,0,,ПОТОМУ ЧТО ОНА, ЗАРАЗА ТАКАЯ, ПО ПРЕЖНЕМУ НЕ СЛЫШИТ.
