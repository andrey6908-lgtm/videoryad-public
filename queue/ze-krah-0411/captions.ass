Dialogue: 0,0:00:00.12,0:00:02.28,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРИЕХАЛ В БЕРЛИН УЧИТЬ ЕВРОПУ
Dialogue: 0,0:00:02.28,0:00:04.92,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТИ. АМЕРИКА, ГОВОРИТ,
Dialogue: 0,0:00:05.08,0:00:08.84,Caption,,0,0,0,,УЖЕ НЕ ТА, ТЕПЕРЬ ВСЁ САМИМ. НУ ХОРОШО. Я ТОЛЬКО ОДНОГО
Dialogue: 0,0:00:08.92,0:00:11.48,Caption,,0,0,0,,НЕ ПОНЯЛ. КОГДА У ТЕБЯ ДОМА КРЫША ТЕЧЁТ,
Dialogue: 0,0:00:11.56,0:00:13.40,Caption,,0,0,0,,САМОЕ ВРЕМЯ ОБЪЯСНЯТЬ СОСЕДЯМ,
Dialogue: 0,0:00:13.48,0:00:16.52,Caption,,0,0,0,,КАК ИМ ПЕРЕСТРАИВАТЬ ПОДЪЕЗД? ВЛАДИМИР АЛЕКСАНДРОВИЧ,
Dialogue: 0,0:00:16.84,0:00:20.44,Caption,,0,0,0,,А ДОМА ТО ВЫ ДАВНО БЫЛИ? ПОТОМУ ЧТО ТАМ СЕЙЧАС ТОЖЕ НАКОПИЛОСЬ НЕСКОЛЬКО
Dialogue: 0,0:00:20.44,0:00:22.76,Caption,,0,0,0,,ВОПРОСОВ. В БЕРЛИНЕ ЗЕЛЕНСКИЙ ВЫСТУПИЛ НА
Dialogue: 0,0:00:22.76,0:00:25.64,Caption,,0,0,0,,КОНФЕРЕНЦИИ ПО БЕЗОПАСНОСТИ И НАРИСОВАЛ ЕВРОПЕЙЦАМ
Dialogue: 0,0:00:25.64,0:00:28.44,Caption,,0,0,0,,ДОВОЛЬНО БОДРОЕ БУДУЩЕЕ. СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:00:28.60,0:00:31.32,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ВСЁ БОЛЬШЕ БУДУТ ЗАНИМАТЬСЯ СОБОЙ,
Dialogue: 0,0:00:31.56,0:00:33.40,Caption,,0,0,0,,ИХ РОЛЬ В МИРЕ МОЖЕТ СТАТЬ МЕНЬШЕ,
Dialogue: 0,0:00:33.69,0:00:36.28,Caption,,0,0,0,,А ЗНАЧИТ РОЛЬ ЕВРОПЫ ДОЛЖНА СТАТЬ БОЛЬШЕ. И
Dialogue: 0,0:00:36.36,0:00:38.28,Caption,,0,0,0,,БЕЗ ГЕРМАНИИ, ОБЪЯСНИЛ ЗЕЛЕНСКИЙ,
Dialogue: 0,0:00:38.36,0:00:41.56,Caption,,0,0,0,,НИКАК. ГЕРМАНИЯ ДОЛЖНА ОСТАВАТЬСЯ ОДНОЙ ИЗ ГЛАВНЫХ
Dialogue: 0,0:00:41.64,0:00:44.68,Caption,,0,0,0,,ОПОР ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ТО ЕСТЬ АМЕРИКАНСКИЙ
Dialogue: 0,0:00:44.68,0:00:47.08,Caption,,0,0,0,,ПАПА ПОСТЕПЕННО ОТХОДИТ ОТ СЕМЕЙНЫХ ДЕЛ,
Dialogue: 0,0:00:47.32,0:00:49.80,Caption,,0,0,0,,И ТЕПЕРЬ СТАРШЕМУ РЕБЁНКУ ПОРА ИСКАТЬ РАБОТУ.
Dialogue: 0,0:00:49.96,0:00:54.04,Caption,,0,0,0,,ПРИМЕРНО ТАК. КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗГОВОР БЕЗ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:00:54.04,0:00:56.84,Caption,,0,0,0,,ВАТЫ, ПОДПИШИТЕСЬ. ЗДЕСЬ МЫ НОВОСТИ НЕ ПРОСТО
Dialogue: 0,0:00:56.84,0:00:59.48,Caption,,0,0,0,,ПЕРЕСКАЗЫВАЕМ. МЫ ИНОГДА ЕЩЁ ПЫТАЕМСЯ ПОНЯТЬ,
Dialogue: 0,0:00:59.61,0:01:01.32,Caption,,0,0,0,,ПОЧЕМУ ОНИ ТАК СМЕШНО ВЫГЛЯДЯТ,
Dialogue: 0,0:01:01.56,0:01:04.68,Caption,,0,0,0,,ЕСЛИ ПОСТАВИТЬ ДВЕ СОСЕДНИЕ НОВОСТИ РЯДОМ. НЕМЦАМ,
Dialogue: 0,0:01:04.76,0:01:08.60,Caption,,0,0,0,,КОНЕЧНО, ПРИЯТНО. ЕЩЁ ВЧЕРА ОНИ ПЕРЕЖИВАЛИ ИЗ ЗА ЭКОНОМИКИ,
Dialogue: 0,0:01:08.69,0:01:12.60,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ, ЦЕН НА ЭНЕРГИЮ И СОБСТВЕННЫХ ОБОРОННЫХ РАСХОДОВ.
Dialogue: 0,0:01:14.88,0:01:18.56,Caption,,0,0,0,,А ТЕПЕРЬ ВЫЯСНИЛОСЬ, ЧТО У НИХ НОВАЯ ДОЛЖНОСТЬ. ОПОРА ЕВРОПЫ.
Dialogue: 0,0:01:18.78,0:01:20.88,Caption,,0,0,0,,ПОЗДРАВЛЯЕМ. ЗАРПЛАТУ, ПРАВДА,
Dialogue: 0,0:01:21.10,0:01:24.48,Caption,,0,0,0,,НИКТО НЕ ПОКАЗАЛ, ЗАТО СПИСОК ОБЯЗАННОСТЕЙ УЖЕ ПРИНЕСЛИ.
Dialogue: 0,0:01:25.04,0:01:26.96,Caption,,0,0,0,,НО ЗЕЛЕНСКИЙ ПРИЕХАЛ В БЕРЛИН НЕ ТОЛЬКО С
Dialogue: 0,0:01:26.96,0:01:29.84,Caption,,0,0,0,,ГЕОПОЛИТИЧЕСКИМИ СОВЕТАМИ. ГЕРМАНИЯ ПООБЕЩАЛА
Dialogue: 0,0:01:29.84,0:01:32.80,Caption,,0,0,0,,УКРАИНЕ НОВЫЙ ПАКЕТ ЗИМНЕЙ ПОМОЩИ. ОБСУЖДАЛИСЬ
Dialogue: 0,0:01:32.80,0:01:35.36,Caption,,0,0,0,,ЭНЕРГЕТИКА, ПРОТИВОВОЗДУШНАЯ ОБОРОНА,
Dialogue: 0,0:01:35.60,0:01:38.40,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ РАКЕТЫ ДЛЯ СИСТЕМ ПЭТРИОТ И АЙРИС ТИ,
Dialogue: 0,0:01:38.64,0:01:41.52,Caption,,0,0,0,,ПОМОЩЬ УКРАИНСКИМ САМОЛЁТАМ ЭФ ШЕСТНАДЦАТЬ. МЕРЦ
Dialogue: 0,0:01:41.60,0:01:45.76,Caption,,0,0,0,,ПРЯМО СКАЗАЛ, ЧТО ПЕРЕД ЗИМОЙ ОСОБЕННО ВАЖНЫ ДВЕ ВЕЩИ. ПВО
Dialogue: 0,0:01:45.89,0:01:48.80,Caption,,0,0,0,,И ЭНЕРГЕТИКА. ТО ЕСТЬ ПОЛУЧАЕТСЯ ДОВОЛЬНО ЗАНЯТНАЯ
Dialogue: 0,0:01:48.80,0:01:52.40,Caption,,0,0,0,,КАРТИНА. С ОДНОЙ СТОРОНЫ, ЗЕЛЕНСКИЙ РАССКАЗЫВАЕТ НЕМЦАМ,
Dialogue: 0,0:01:52.56,0:01:54.56,Caption,,0,0,0,,ЧТО ЕВРОПЕ ПОРА УЧИТЬСЯ ЖИТЬ В МИРЕ,
Dialogue: 0,0:01:54.73,0:01:56.80,Caption,,0,0,0,,ГДЕ АМЕРИКА УЖЕ НЕ РЕШАЕТ ЗА НЕЁ ВСЁ.
Dialogue: 0,0:01:57.20,0:01:59.76,Caption,,0,0,0,,С ДРУГОЙ СТОРОНЫ, САМ ТУТ ЖЕ ОБСУЖДАЕТ,
Dialogue: 0,0:01:59.92,0:02:02.80,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ГЕРМАНИЯ СМОЖЕТ ДАТЬ УКРАИНЕ РАКЕТ,
Dialogue: 0,0:02:02.89,0:02:06.32,Caption,,0,0,0,,ДЕНЕГ И ПОМОЩИ ДЛЯ ЭНЕРГОСИСТЕМЫ. САМОСТОЯТЕЛЬНОСТЬ
Dialogue: 0,0:02:06.40,0:02:08.80,Caption,,0,0,0,,ОНА ТАКАЯ. ЛУЧШЕ ВСЕГО О НЕЙ РАССУЖДАТЬ,
Dialogue: 0,0:02:08.88,0:02:10.80,Caption,,0,0,0,,КОГДА РЯДОМ СТОИТ ЧЕЛОВЕК С КОШЕЛЬКОМ.
Dialogue: 0,0:02:11.43,0:02:13.84,Caption,,0,0,0,,И ВОТ ПОСЛЕ РАЗГОВОРОВ О НОВОЙ ЕВРОПЕ ЗЕЛЕНСКИЙ
Dialogue: 0,0:02:13.92,0:02:16.80,Caption,,0,0,0,,ПЕРЕХОДИТ К СЛЕДУЮЩЕМУ БОЛЬШОМУ ВОПРОСУ. К ПУТИНУ.
Dialogue: 0,0:02:17.28,0:02:19.20,Caption,,0,0,0,,ТЕЛЕФОННЫЙ РАЗГОВОР ЕМУ ТЕПЕРЬ НЕ ОСОБЕННО
Dialogue: 0,0:02:19.20,0:02:23.76,Caption,,0,0,0,,ИНТЕРЕСЕН. ЗЕЛЕНСКИЙ ГОВОРИТ, ЧТО НЕ ХОЧЕТ СНОВА СЛУШАТЬ ПО ТЕЛЕФОНУ ИСТОРИЧЕСКИЕ
Dialogue: 0,0:02:23.76,0:02:28.93,Caption,,0,0,0,,ЛЕКЦИИ. НУЖНА ЛИЧНАЯ ВСТРЕЧА. НО В КИЕВ ПУТИН,
Dialogue: 0,0:02:29.06,0:02:33.97,Caption,,0,0,0,,ПО ЕГО МНЕНИЮ, НЕ ПРИЕДЕТ, А САМ ЗЕЛЕНСКИЙ В МОСКВУ НЕ ПОЕДЕТ. ПРИГЛАШЕНИЕ
Dialogue: 0,0:02:34.05,0:02:35.73,Caption,,0,0,0,,В МОСКВУ ОН НАЗВАЛ ВООБЩЕ ЧУТЬ ЛИ НЕ
Dialogue: 0,0:02:35.73,0:02:38.05,Caption,,0,0,0,,ПЛЕВКОМ В ЛИЦО МИРУ. НУ А КАК ИНАЧЕ.
Dialogue: 0,0:02:38.38,0:02:41.73,Caption,,0,0,0,,ВСТРЕЧАТЬСЯ НАДО ОБЯЗАТЕЛЬНО. НО ЗДЕСЬ НЕЛЬЗЯ. ТАМ
Dialogue: 0,0:02:41.73,0:02:44.61,Caption,,0,0,0,,НЕЛЬЗЯ. ПО ТЕЛЕФОНУ ТОЖЕ НЕИНТЕРЕСНО. КАК УЖ НА
Dialogue: 0,0:02:44.61,0:02:47.65,Caption,,0,0,0,,СКОВОРОДКЕ. ПРИЧЁМ САМА ИДЕЯ ЛИЧНОЙ ВСТРЕЧИ УЖЕ
Dialogue: 0,0:02:47.65,0:02:50.85,Caption,,0,0,0,,ДАВНО ГУЛЯЕТ ПО КРУГУ. ТО РАЗГОВОР НЕВОЗМОЖЕН. ТО
Dialogue: 0,0:02:50.85,0:02:53.89,Caption,,0,0,0,,ВСТРЕЧА НЕОБХОДИМА. ТО МОСКВА НЕ ПОДХОДИТ. ТО
Dialogue: 0,0:02:53.89,0:02:57.25,Caption,,0,0,0,,ПРЕДЛАГАЕТСЯ ДРУГАЯ ПЛОЩАДКА. ПОЛИТИЧЕСКАЯ ГЕОГРАФИЯ
Dialogue: 0,0:02:57.33,0:03:00.45,Caption,,0,0,0,,ПОСТЕПЕННО ПРЕВРАЩАЕТСЯ В BOOKING ТОЧКА COM. МЕСТО
Dialogue: 0,0:03:00.45,0:03:04.21,Caption,,0,0,0,,ВРОДЕ ИЩЕМ, ТОЛЬКО ЗАСЕЛИТЬСЯ НИКАК НЕ ПОЛУЧАЕТСЯ. НО В ДАННОМ
Dialogue: 0,0:03:04.29,0:03:07.17,Caption,,0,0,0,,СЛУЧАЕ ВАЖНЕЕ ДРУГОЕ. ДЕСЯТОГО И ОДИННАДЦАТОГО
Dialogue: 0,0:03:07.17,0:03:09.89,Caption,,0,0,0,,НОЯБРЯ В АБУ ДАБИ ДОЛЖНЫ ПРОЙТИ ТРЁХСТОРОННИЕ
Dialogue: 0,0:03:09.97,0:03:14.45,Caption,,0,0,0,,ПЕРЕГОВОРЫ РОССИИ, УКРАИНЫ И СОЕДИНЁННЫХ ШТАТОВ. АМЕРИКАНЦЫ ВЫСТУПАЮТ
Dialogue: 0,0:03:14.45,0:03:17.25,Caption,,0,0,0,,ПОСРЕДНИКАМИ. РОССИЙСКУЮ ДЕЛЕГАЦИЮ ВОЗГЛАВИТ
Dialogue: 0,0:03:17.25,0:03:19.81,Caption,,0,0,0,,ВЛАДИМИР МЕДИНСКИЙ. И СРЕДИ ВОПРОСОВ,
Dialogue: 0,0:03:19.91,0:03:24.45,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ ОБСУЖДАТЬСЯ, УЖЕ ПРЯМО НАЗЫВАЮТСЯ ПОСЛЕВОЕННАЯ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:03:24.60,0:03:28.05,Caption,,0,0,0,,ДЕЭСКАЛАЦИЯ И ГАРАНТИИ БЕЗОПАСНОСТИ. А ПЕСКОВ
Dialogue: 0,0:03:28.13,0:03:30.53,Caption,,0,0,0,,СФОРМУЛИРОВАЛ РОССИЙСКУЮ ПОЗИЦИЮ СОВСЕМ КОРОТКО.
Dialogue: 0,0:03:31.01,0:03:35.49,Caption,,0,0,0,,ГАРАНТИИ, ГОВОРИТ, МОГУТ БЫТЬ ТОЛЬКО ВЗАИМНЫМИ. НЕ ТОЛЬКО УКРАИНЕ.
Dialogue: 0,0:03:35.67,0:03:38.37,Caption,,0,0,0,,РОССИИ ТОЖЕ. И ВОТ ЗДЕСЬ ПЕРЕГОВОРЫ СТАНОВЯТСЯ
Dialogue: 0,0:03:38.37,0:03:41.25,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО ИНТЕРЕСНЕЕ ОБЫЧНОГО РАЗГОВОРА ПРО ЛИНИЮ
Dialogue: 0,0:03:41.33,0:03:46.97,Caption,,0,0,0,,НА КАРТЕ. ПОТОМУ ЧТО ДОНБАСС МОЖНО ОБСУЖДАТЬ ДОЛГО. МОЖНО
Dialogue: 0,0:03:46.97,0:03:49.37,Caption,,0,0,0,,ТОРГОВАТЬСЯ О ТЕРРИТОРИЯХ, ГРАНИЦАХ,
Dialogue: 0,0:03:49.45,0:03:52.73,Caption,,0,0,0,,ПРЕКРАЩЕНИИ ОГНЯ. НО ЕСЛИ ПОСЛЕ ЭТОГО ОДНА СТОРОНА
Dialogue: 0,0:03:52.73,0:03:56.33,Caption,,0,0,0,,СЧИТАЕТ, ЧТО ПРОТИВ НЕЁ ПРОДОЛЖАЕТ СТРОИТЬСЯ ТА ЖЕ САМАЯ
Dialogue: 0,0:03:56.33,0:03:59.45,Caption,,0,0,0,,ВОЕННАЯ КОНСТРУКЦИЯ, ПРОСТО УЖЕ ПОД НОВОЙ ВЫВЕСКОЙ,
Dialogue: 0,0:03:59.77,0:04:04.17,Caption,,0,0,0,,ТО ЧТО ИМЕННО ЗАКОНЧИЛОСЬ? ВОТ ЗДЕСЬ И КРОЕТСЯ ГЛАВНАЯ ПРОБЛЕМА. ТЕРРИТОРИЯ
Dialogue: 0,0:04:04.17,0:04:07.05,Caption,,0,0,0,,ЗДЕСЬ ТОЛЬКО ЧАСТЬ РАЗГОВОРА. БОЛЬШОЙ ВОПРОС ВООБЩЕ
Dialogue: 0,0:04:07.13,0:04:10.49,Caption,,0,0,0,,О ТОМ, КАКАЯ СИСТЕМА БЕЗОПАСНОСТИ ОСТАНЕТСЯ ПОСЛЕ ВОЙНЫ.
Dialogue: 0,0:04:10.81,0:04:14.09,Caption,,0,0,0,,ЧТО ПОЛУЧИТ УКРАИНА. ЧТО ПОЛУЧИТ РОССИЯ. КАКИЕ
Dialogue: 0,0:04:14.09,0:04:16.81,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ВОЗЬМЁТ ЕВРОПА. ЧТО ОСТАНЕТСЯ ОТ
Dialogue: 0,0:04:16.89,0:04:19.05,Caption,,0,0,0,,АМЕРИКАНСКОГО УЧАСТИЯ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:04:19.21,0:04:21.53,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ В
Dialogue: 0,0:04:21.61,0:04:24.33,Caption,,0,0,0,,ЭТОЙ ИСТОРИИ ВСЁ ЧАЩЕ БУДЕТ ПРОИСХОДИТЬ ИМЕННО ТАК.
Dialogue: 0,0:04:24.50,0:04:27.37,Caption,,0,0,0,,ПОЛИТИКИ БУДУТ ОБСУЖДАТЬ ВЕЩИ ОГРОМНОГО МАСШТАБА,
Dialogue: 0,0:04:27.69,0:04:30.01,Caption,,0,0,0,,А ПРОВЕРЯТЬ ЭТИ РЕШЕНИЯ В ИТОГЕ БУДЕТ ОБЫЧНЫЙ
Dialogue: 0,0:04:30.01,0:04:34.49,Caption,,0,0,0,,КРАН В ОБЫЧНОЙ КВАРТИРЕ. И ВОТ ТУТ ОСОБЕННО КРАСИВО ВОЗВРАЩАТЬСЯ К БЕРЛИНСКОЙ
Dialogue: 0,0:04:34.49,0:04:36.81,Caption,,0,0,0,,РЕЧИ ЗЕЛЕНСКОГО. ОН ГОВОРИТ ЕВРОПЕ,
Dialogue: 0,0:04:36.97,0:04:39.45,Caption,,0,0,0,,ЧТО АМЕРИКА ПОСТЕПЕННО БУДЕТ ЗАНИМАТЬСЯ СОБОЙ.
Dialogue: 0,0:04:39.80,0:04:41.93,Caption,,0,0,0,,ХОРОШО. ТОГДА КТО ДАЁТ ГАРАНТИИ?
Dialogue: 0,0:04:42.13,0:04:46.41,Caption,,0,0,0,,ЕВРОПА? ПРЕКРАСНО. ЧЕМ? ВОТ ЗДЕСЬ НАЧИНАЕТСЯ АРИФМЕТИКА,
Dialogue: 0,0:04:46.65,0:04:49.77,Caption,,0,0,0,,КОТОРУЮ ПОЛИТИЧЕСКИЕ РЕЧИ ОЧЕНЬ НЕ ЛЮБЯТ. У ГЕРМАНИИ
Dialogue: 0,0:04:49.77,0:04:51.53,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ОГРОМНЫЕ ВОЗМОЖНОСТИ.
Dialogue: 0,0:04:53.82,0:04:55.98,Caption,,0,0,0,,НО ДАЖЕ ЗЕЛЕНСКИЙ В ТОЙ ЖЕ САМОЙ БЕРЛИНСКОЙ
Dialogue: 0,0:04:56.06,0:04:58.54,Caption,,0,0,0,,РЕЧИ ГОВОРИТ О НЕХВАТКЕ СРЕДСТВ ПРОТИВОВОЗДУШНОЙ
Dialogue: 0,0:04:58.54,0:05:00.94,Caption,,0,0,0,,ОБОРОНЫ И ПРОСИТ ДОПОЛНИТЕЛЬНЫЕ РАКЕТЫ.
Dialogue: 0,0:05:01.50,0:05:03.98,Caption,,0,0,0,,ГЕРМАНИЯ ОБЕЩАЕТ ЗИМНЮЮ ПОДДЕРЖКУ УКРАИНСКОЙ
Dialogue: 0,0:05:03.98,0:05:08.21,Caption,,0,0,0,,ЭНЕРГЕТИКЕ. МЕРЦ ТРЕБУЕТ, ЧТОБЫ ЕВРОПЕЙСКИЕ ПАРТНЁРЫ ВЫПОЛНЯЛИ СВОИ
Dialogue: 0,0:05:08.21,0:05:11.10,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА. ТО ЕСТЬ БУДУЩУЮ СИСТЕМУ БЕЗОПАСНОСТИ
Dialogue: 0,0:05:11.10,0:05:14.46,Caption,,0,0,0,,ОБСУЖДАЮТ ЛЮДИ, КОТОРЫМ УЖЕ СЕЙЧАС ПРИХОДИТСЯ СЧИТАТЬ,
Dialogue: 0,0:05:14.66,0:05:17.26,Caption,,0,0,0,,КТО СКОЛЬКО РАКЕТ СМОЖЕТ НАСКРЕСТИ НА БЛИЖАЙШУЮ
Dialogue: 0,0:05:17.26,0:05:20.30,Caption,,0,0,0,,ЗИМУ. А ТЕПЕРЬ ДАВАЙТЕ ИЗ БЕРЛИНА ВЕРНЁМСЯ ДОМОЙ К
Dialogue: 0,0:05:20.30,0:05:22.70,Caption,,0,0,0,,ЗЕЛЕНСКОМУ. ПОТОМУ ЧТО ПОКА ТАМ ОБСУЖДАЮТ
Dialogue: 0,0:05:22.70,0:05:25.33,Caption,,0,0,0,,АРХИТЕКТУРУ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ НА БЛИЖАЙШИЕ
Dialogue: 0,0:05:25.33,0:05:29.10,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯ, В УКРАИНЕ ТРЕТЬЕГО НОЯБРЯ В ПОЛТАВСКОЙ И СУМСКОЙ
Dialogue: 0,0:05:29.10,0:05:31.90,Caption,,0,0,0,,ОБЛАСТЯХ ВВЕЛИ СПЕЦИАЛЬНЫЕ АВАРИЙНЫЕ ОТКЛЮЧЕНИЯ
Dialogue: 0,0:05:31.90,0:05:34.86,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА. НЕ ОБЫЧНЫЙ ГРАФИК. НЕ ТО,
Dialogue: 0,0:05:34.94,0:05:37.10,Caption,,0,0,0,,К ЧЕМУ УКРАИНЦЫ ЗА ПОСЛЕДНИЕ ГОДЫ УЖЕ,
Dialogue: 0,0:05:37.25,0:05:40.78,Caption,,0,0,0,,К СОЖАЛЕНИЮ, ПРИВЫКЛИ. СПЕЦИАЛЬНЫЙ АВАРИЙНЫЙ РЕЖИМ ВВОДИТСЯ
Dialogue: 0,0:05:40.86,0:05:45.10,Caption,,0,0,0,,КОМАНДОЙ ДИСПЕТЧЕРА, КОГДА НАГРУЗКУ НАДО СБРАСЫВАТЬ БЫСТРО. ЭНЕРГЕТИКИ
Dialogue: 0,0:05:45.10,0:05:47.90,Caption,,0,0,0,,ПРЯМО СООБЩИЛИ, ЧТО ЗАРАНЕЕ СКАЗАТЬ ЛЮДЯМ,
Dialogue: 0,0:05:48.06,0:05:49.98,Caption,,0,0,0,,СКОЛЬКО ПРОДЛИТСЯ ТАКОЕ ОТКЛЮЧЕНИЕ,
Dialogue: 0,0:05:50.13,0:05:54.54,Caption,,0,0,0,,НЕВОЗМОЖНО. ВОТ ЭТО УЖЕ НЕ БЕРЛИНСКАЯ КОНФЕРЕНЦИЯ. ЗДЕСЬ ВОПРОС
Dialogue: 0,0:05:54.62,0:05:56.78,Caption,,0,0,0,,НАМНОГО ПРОЩЕ. СВЕТ КОГДА БУДЕТ?
Dialogue: 0,0:05:57.00,0:05:59.90,Caption,,0,0,0,,НЕ ЗНАЕМ. СЕГОДНЯ? НЕ ЗНАЕМ. ЗАВТРА?
Dialogue: 0,0:06:00.15,0:06:03.02,Caption,,0,0,0,,ТОЖЕ НЕ ЗНАЕМ. ЗАТО ЧЕРЕЗ НЕДЕЛЮ БУДЕМ ОБСУЖДАТЬ
Dialogue: 0,0:06:03.02,0:06:05.18,Caption,,0,0,0,,АРХИТЕКТУРУ БЕЗОПАСНОСТИ. КРАСОТА.
Dialogue: 0,0:06:07.38,0:06:10.10,Caption,,0,0,0,,И ЭТО НЕ ОТДЕЛЬНАЯ ИСТОРИЯ ДВУХ ОБЛАСТЕЙ. В
Dialogue: 0,0:06:10.18,0:06:12.82,Caption,,0,0,0,,ТОТ ЖЕ ДЕНЬ АВАРИЙНЫЕ ОТКЛЮЧЕНИЯ ВВОДИЛИСЬ В КИЕВЕ
Dialogue: 0,0:06:12.90,0:06:14.98,Caption,,0,0,0,,И РЯДЕ ДРУГИХ РЕГИОНОВ ПОСЛЕ ПОВРЕЖДЕНИЯ
Dialogue: 0,0:06:14.98,0:06:17.54,Caption,,0,0,0,,ОБОРУДОВАНИЯ И ПАДЕНИЯ НАПРЯЖЕНИЯ В ВЫСОКОВОЛЬТНЫХ
Dialogue: 0,0:06:17.54,0:06:20.90,Caption,,0,0,0,,СЕТЯХ. БЫЛИ ПРОБЛЕМЫ И С ВОДОСНАБЖЕНИЕМ. ВОТ ЗДЕСЬ
Dialogue: 0,0:06:20.90,0:06:23.54,Caption,,0,0,0,,БОЛЬШАЯ ПОЛИТИКА НАКОНЕЦ ВСТРЕЧАЕТСЯ С ОБЫЧНЫМ
Dialogue: 0,0:06:23.54,0:06:26.26,Caption,,0,0,0,,ЧЕЛОВЕКОМ. ПОТОМУ ЧТО ДЛЯ ПОЛИТИКА ЭНЕРГЕТИЧЕСКАЯ
Dialogue: 0,0:06:26.34,0:06:29.54,Caption,,0,0,0,,СИСТЕМА ЭТО ИНФРАСТРУКТУРА, УСТОЙЧИВОСТЬ,
Dialogue: 0,0:06:29.70,0:06:33.78,Caption,,0,0,0,,МЕГАВАТТЫ, ГЕНЕРАЦИЯ И КРАСИВЫЕ ПРЕЗЕНТАЦИИ НА МЕЖДУНАРОДНОЙ
Dialogue: 0,0:06:33.78,0:06:37.06,Caption,,0,0,0,,КОНФЕРЕНЦИИ. ДЛЯ ЧЕЛОВЕКА ЭНЕРГОСИСТЕМА ЭТО КОГДА ОН
Dialogue: 0,0:06:37.06,0:06:39.94,Caption,,0,0,0,,УТРОМ НАЖАЛ ВЫКЛЮЧАТЕЛЬ. И СВЕТ ЛИБО ЗАГОРЕЛСЯ,
Dialogue: 0,0:06:40.02,0:06:42.82,Caption,,0,0,0,,ЛИБО НЕТ. ВСЁ. ВТОРОГО НОЯБРЯ УКРАИНСКИЙ
Dialogue: 0,0:06:42.82,0:06:45.30,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИЙ ЭКСПЕРТ ЮРИЙ КОРОЛЬЧУК ЗАЯВИЛ,
Dialogue: 0,0:06:45.54,0:06:48.26,Caption,,0,0,0,,ЧТО ВОССТАНОВИТЬ ЭНЕРГОСИСТЕМУ СТРАНЫ ДО ПРЕЖНЕЙ
Dialogue: 0,0:06:48.26,0:06:51.14,Caption,,0,0,0,,МОЩНОСТИ УЖЕ НЕ ПОЛУЧИТСЯ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:06:51.30,0:06:53.94,Caption,,0,0,0,,ЗА ПОСЛЕДНИЕ ГОДЫ СХЕМЫ РАСПРЕДЕЛЕНИЯ ПРИХОДИЛОСЬ
Dialogue: 0,0:06:53.94,0:06:56.34,Caption,,0,0,0,,ПЕРЕСТРАИВАТЬ НЕСКОЛЬКО РАЗ, А СХЕМА,
Dialogue: 0,0:06:56.42,0:06:58.02,Caption,,0,0,0,,РАЗРАБОТАННАЯ УЖЕ В ЭТОМ ГОДУ,
Dialogue: 0,0:06:58.17,0:07:01.38,Caption,,0,0,0,,СНОВА ПОТРЕБОВАЛА ИЗМЕНЕНИЙ. ОН ОБЪЯСНЯЕТ ЭТО ТЕМ,
Dialogue: 0,0:07:01.54,0:07:04.50,Caption,,0,0,0,,ЧТО УКРАИНСКАЯ ЭНЕРГОСИСТЕМА СВЯЗАНА В ОДНО ЦЕЛОЕ.
Dialogue: 0,0:07:04.90,0:07:07.54,Caption,,0,0,0,,ЕСЛИ ТЯЖЁЛЫЕ ПОВРЕЖДЕНИЯ ПРОИСХОДЯТ В КИЕВЕ,
Dialogue: 0,0:07:07.64,0:07:10.74,Caption,,0,0,0,,ХАРЬКОВЕ, ДНЕПРЕ ИЛИ ОДЕССЕ, ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:07:10.96,0:07:13.30,Caption,,0,0,0,,ЧТО ЗАПАД СТРАНЫ СПОКОЙНО ЖИВЁТ САМ ПО СЕБЕ.
Dialogue: 0,0:07:13.70,0:07:16.82,Caption,,0,0,0,,ЭЛЕКТРОЭНЕРГИЯ НЕ ЧИТАЕТ ОБЛАСТНЫЕ ГРАНИЦЫ. И ВОТ
Dialogue: 0,0:07:16.82,0:07:19.78,Caption,,0,0,0,,ЭТО ВАЖНЫЙ МОМЕНТ. МОЖНО ВОССТАНОВИТЬ ОТДЕЛЬНУЮ
Dialogue: 0,0:07:19.78,0:07:25.80,Caption,,0,0,0,,ПОДСТАНЦИЮ. МОЖНО ЗАМЕНИТЬ ТРАНСФОРМАТОР. МОЖНО ПРОТЯНУТЬ НОВУЮ
Dialogue: 0,0:07:25.80,0:07:28.68,Caption,,0,0,0,,ЛИНИЮ. МОЖНО ТОРЖЕСТВЕННО ОТКРЫТЬ ОТРЕМОНТИРОВАННЫЙ
Dialogue: 0,0:07:28.68,0:07:31.72,Caption,,0,0,0,,ОБЪЕКТ И СФОТОГРАФИРОВАТЬСЯ ВОЗЛЕ НЕГО. НО СЕТЬ
Dialogue: 0,0:07:31.80,0:07:34.52,Caption,,0,0,0,,РАБОТАЕТ НЕ КАК НАБОР ОТДЕЛЬНЫХ РОЗЕТОК. ОНА
Dialogue: 0,0:07:34.52,0:07:37.64,Caption,,0,0,0,,РАБОТАЕТ ЦЕЛИКОМ. ВЫБИЛИ ОДИН МАРШРУТ ПЕРЕДАЧИ.
Dialogue: 0,0:07:37.92,0:07:40.84,Caption,,0,0,0,,ЭНЕРГЕТИКИ ПЕРЕСТРОИЛИ ПОТОКИ. ВЫБИЛИ ВТОРОЙ.
Dialogue: 0,0:07:41.00,0:07:43.80,Caption,,0,0,0,,ПЕРЕСТРОИЛИ ЕЩЁ РАЗ. ПОТОМ ТРЕТИЙ. В КАКОЙ ТО
Dialogue: 0,0:07:43.80,0:07:46.52,Caption,,0,0,0,,МОМЕНТ РЕМОНТ ПРЕВРАЩАЕТСЯ УЖЕ НЕ В ВОЗВРАЩЕНИЕ
Dialogue: 0,0:07:46.52,0:07:50.76,Caption,,0,0,0,,СТАРОЙ СИСТЕМЫ, А В ПОСТОЯННОЕ ИЗОБРЕТЕНИЕ НОВОЙ НА ХОДУ. КАК
Dialogue: 0,0:07:50.84,0:07:53.72,Caption,,0,0,0,,ЕСЛИ ВАМ ТРИ РАЗА ПЕРЕКРЫЛИ ДОРОГУ ДОМОЙ. ПЕРВЫЙ
Dialogue: 0,0:07:53.80,0:07:56.76,Caption,,0,0,0,,РАЗ ПОЕХАЛИ ЧЕРЕЗ СОСЕДНЮЮ УЛИЦУ. ВТОРОЙ РАЗ ЧЕРЕЗ
Dialogue: 0,0:07:56.76,0:08:00.04,Caption,,0,0,0,,ДВОР. ТРЕТИЙ РАЗ УЖЕ ЧЕРЕЗ ОГОРОД. ФОРМАЛЬНО ДОМОЙ
Dialogue: 0,0:08:00.04,0:08:03.00,Caption,,0,0,0,,ДОЕХАЛИ. ТОЛЬКО ПОЧЕМУ ТО КАЖДЫЙ СЛЕДУЮЩИЙ МАРШРУТ
Dialogue: 0,0:08:03.00,0:08:05.80,Caption,,0,0,0,,ВСЁ ВЕСЕЛЕЕ. И ИМЕННО ПОЭТОМУ НЕ СТОИТ СМЕЯТЬСЯ
Dialogue: 0,0:08:05.80,0:08:08.44,Caption,,0,0,0,,НАД ЗАЯВЛЕНИЯМИ О ВОЗМОЖНЫХ ТЯЖЁЛЫХ СЦЕНАРИЯХ ЭТОЙ
Dialogue: 0,0:08:08.44,0:08:11.72,Caption,,0,0,0,,ЗИМЫ. НО И УСТРАИВАТЬ ПОХОРОНЫ УКРАИНЫ ЗАРАНЕЕ ТОЖЕ
Dialogue: 0,0:08:11.80,0:08:16.60,Caption,,0,0,0,,НЕ НАДО. МЫ УЖЕ ВИДЕЛИ, КАК РАБОТАЕТ ИНФОРМАЦИОННАЯ ИСТЕРИКА. ОДИН ЭКСПЕРТ
Dialogue: 0,0:08:16.68,0:08:20.44,Caption,,0,0,0,,СКАЗАЛ, ЧТО БУДУТ ПРОБЛЕМЫ. ЧЕРЕЗ ЧАС ЗАГОЛОВОК УЖЕ ТАКОЙ,
Dialogue: 0,0:08:20.61,0:08:22.92,Caption,,0,0,0,,БУДТО ЗАВТРА В КИЕВЕ ЛЮДИ БУДУТ ДОБЫВАТЬ ОГОНЬ
Dialogue: 0,0:08:22.92,0:08:28.44,Caption,,0,0,0,,ТРЕНИЕМ. НЕТ. СМОТРИМ НА ТО, ЧТО ЕСТЬ. ЕСТЬ СПЕЦИАЛЬНЫЕ АВАРИЙНЫЕ ОТКЛЮЧЕНИЯ.
Dialogue: 0,0:08:28.67,0:08:31.96,Caption,,0,0,0,,ЕСТЬ ПОВРЕЖДЁННЫЕ СЕТИ. ЕСТЬ НЕХВАТКА ПВО,
Dialogue: 0,0:08:32.04,0:08:34.21,Caption,,0,0,0,,О КОТОРОЙ САМ ЗЕЛЕНСКИЙ ГОВОРИЛ В БЕРЛИНЕ.
Dialogue: 0,0:08:36.48,0:08:39.12,Caption,,0,0,0,,ЕСТЬ НЕМЕЦКИЙ ЗИМНИЙ ПАКЕТ ПОМОЩИ ИМЕННО ДЛЯ
Dialogue: 0,0:08:39.12,0:08:43.92,Caption,,0,0,0,,ЭНЕРГЕТИКИ. ЕСТЬ ПРИЗНАНИЕ, ЧТО ЭНЕРГЕТИЧЕСКАЯ ТЕМА ДОЛЖНА ОБСУЖДАТЬСЯ ДАЖЕ НА
Dialogue: 0,0:08:43.92,0:08:46.56,Caption,,0,0,0,,МЕЖДУНАРОДНЫХ ПЕРЕГОВОРАХ. ВОТ ЭТО УЖЕ ФАКТЫ.
Dialogue: 0,0:08:47.17,0:08:49.92,Caption,,0,0,0,,А ДАЛЬШЕ ВОЗНИКАЕТ ВОДА. И ЗДЕСЬ ВСЁ СТАНОВИТСЯ
Dialogue: 0,0:08:49.92,0:08:53.04,Caption,,0,0,0,,ЕЩЁ МЕНЕЕ РОМАНТИЧНО. ГЛАВА СОЮЗА ПОТРЕБИТЕЛЕЙ
Dialogue: 0,0:08:53.04,0:08:55.44,Caption,,0,0,0,,КОММУНАЛЬНЫХ УСЛУГ ОЛЕГ ПОПЕНКО ПРЕДУПРЕДИЛ,
Dialogue: 0,0:08:55.76,0:08:58.00,Caption,,0,0,0,,ЧТО ПРИ ПРОДОЛЖЕНИИ УДАРОВ ПО ЭНЕРГОСИСТЕМЕ
Dialogue: 0,0:08:58.00,0:09:00.48,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ГОРОДА МОГУТ СТОЛКНУТЬСЯ УЖЕ НЕ ПРОСТО С
Dialogue: 0,0:09:00.48,0:09:04.32,Caption,,0,0,0,,ПОДАЧЕЙ ВОДЫ ПО ГРАФИКУ, А С НЕОБХОДИМОСТЬЮ ПОДВОЗИТЬ ПИТЬЕВУЮ ВОДУ
Dialogue: 0,0:09:04.32,0:09:07.28,Caption,,0,0,0,,ЦИСТЕРНАМИ. ОН НАПОМНИЛ О НЕДАВНИХ СЕРЬЁЗНЫХ
Dialogue: 0,0:09:07.28,0:09:11.04,Caption,,0,0,0,,ПЕРЕБОЯХ В ДНЕПРЕ, ГДЕ БЕЗ ВОДЫ ОСТАВАЛОСЬ БОЛЬШОЕ КОЛИЧЕСТВО ЛЮДЕЙ.
Dialogue: 0,0:09:11.52,0:09:14.40,Caption,,0,0,0,,ВОТ ВАМ И ВСЯ СЛОЖНАЯ НАУКА. НЕТ ЭЛЕКТРИЧЕСТВА.
Dialogue: 0,0:09:14.63,0:09:18.24,Caption,,0,0,0,,НЕ РАБОТАЮТ НАСОСЫ. НЕ КАЧАЕТСЯ ВОДА. В МНОГОЭТАЖКЕ
Dialogue: 0,0:09:18.24,0:09:20.64,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО ОТКРЫТЬ КРАН И СМОТРЕТЬ НА
Dialogue: 0,0:09:20.72,0:09:24.88,Caption,,0,0,0,,НЕГО С ПАТРИОТИЗМОМ, НО ВОДА ОТ ЭТОГО ВВЕРХ НЕ ПОЛЕЗЕТ. ФИЗИКА,
Dialogue: 0,0:09:24.96,0:09:28.56,Caption,,0,0,0,,ЗАРАЗА, СОВЕРШЕННО АПОЛИТИЧНАЯ. ЕЁ НЕ ИНТЕРЕСУЕТ,
Dialogue: 0,0:09:28.71,0:09:31.76,Caption,,0,0,0,,ЧТО СКАЗАЛ МЕРЦ. ОНА НЕ ЧИТАЕТ ЗАЯВЛЕНИЯ ЗЕЛЕНСКОГО.
Dialogue: 0,0:09:32.00,0:09:34.56,Caption,,0,0,0,,ОНА ДАЖЕ ПЕСКОВА НЕ СЛУШАЕТ. НАСОСУ НУЖНО
Dialogue: 0,0:09:34.56,0:09:37.52,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО. И ВСЁ. И ТЕПЕРЬ ВЕРНЁМСЯ К НАЧАЛУ.
Dialogue: 0,0:09:37.93,0:09:40.56,Caption,,0,0,0,,ЗЕЛЕНСКИЙ В БЕРЛИНЕ ГОВОРИЛ О БЕЗОПАСНОСТИ КАК О
Dialogue: 0,0:09:40.64,0:09:43.44,Caption,,0,0,0,,БАЗОВОМ РЕСУРСЕ. СРАВНИВАЛ ЕЁ С ВОЗДУХОМ,
Dialogue: 0,0:09:43.52,0:09:47.52,Caption,,0,0,0,,ВОДОЙ, ЕДОЙ И ЭНЕРГИЕЙ. ЗДЕСЬ С НИМ ТРУДНО СПОРИТЬ.
Dialogue: 0,0:09:49.73,0:09:52.77,Caption,,0,0,0,,БОЛЕЕ ТОГО, СРАВНЕНИЕ ПОЛУЧИЛОСЬ ДАЖЕ ТОЧНЕЕ,
Dialogue: 0,0:09:52.88,0:09:57.25,Caption,,0,0,0,,ЧЕМ ОН, НАВЕРНОЕ, РАССЧИТЫВАЛ. ПОТОМУ ЧТО УКРАИНА СЕГОДНЯ КАК РАЗ НА
Dialogue: 0,0:09:57.25,0:09:59.65,Caption,,0,0,0,,ПРАКТИКЕ ПОКАЗЫВАЕТ, ЧТО ПРОИСХОДИТ,
Dialogue: 0,0:09:59.92,0:10:02.61,Caption,,0,0,0,,КОГДА ПРОБЛЕМЫ С БЕЗОПАСНОСТЬЮ НАЧИНАЮТ ПРЕВРАЩАТЬСЯ
Dialogue: 0,0:10:02.69,0:10:04.29,Caption,,0,0,0,,В ПРОБЛЕМЫ С ВОДОЙ И ЭНЕРГИЕЙ.
Dialogue: 0,0:10:05.00,0:10:06.93,Caption,,0,0,0,,И ПОЭТОМУ МЕНЯ В ЭТОЙ ИСТОРИИ ИНТЕРЕСУЕТ НЕ
Dialogue: 0,0:10:06.93,0:10:10.45,Caption,,0,0,0,,ТО, ПРАВИЛЬНО ЛИ ЗЕЛЕНСКИЙ ГОВОРИТ О СНИЖЕНИИ РОЛИ США.
Dialogue: 0,0:10:10.68,0:10:12.85,Caption,,0,0,0,,ДОПУСТИМ, ПРАВИЛЬНО. ДОПУСТИМ,
Dialogue: 0,0:10:12.93,0:10:15.41,Caption,,0,0,0,,АМЕРИКА ДЕЙСТВИТЕЛЬНО ВСЁ БОЛЬШЕ ЗАНИМАЕТСЯ СОБОЙ.
Dialogue: 0,0:10:15.73,0:10:18.61,Caption,,0,0,0,,ТОГДА СЛЕДУЮЩИЙ ВОПРОС. ЕВРОПА ГОТОВА ЗАМЕНИТЬ ЕЁ
Dialogue: 0,0:10:18.69,0:10:23.09,Caption,,0,0,0,,ЧЕМ? НЕ ЗАЯВЛЕНИЯМИ. НЕ КОНФЕРЕНЦИЯМИ. НЕ КРАСИВОЙ ФРАЗОЙ
Dialogue: 0,0:10:23.17,0:10:25.81,Caption,,0,0,0,,О ЕВРОПЕЙСКОМ ЛИДЕРСТВЕ. А РАКЕТАМИ ПВО,
Dialogue: 0,0:10:25.89,0:10:28.37,Caption,,0,0,0,,ДЕНЬГАМИ, ЭНЕРГЕТИЧЕСКИМ ОБОРУДОВАНИЕМ,
Dialogue: 0,0:10:28.46,0:10:32.53,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬЮ, АРМИЕЙ И СПОСОБНОСТЬЮ ГОДАМИ ОПЛАЧИВАТЬ ВСЮ ЭТУ
Dialogue: 0,0:10:32.53,0:10:35.73,Caption,,0,0,0,,КОНСТРУКЦИЮ. ПОТОМУ ЧТО ГЕРМАНИЯ УЖЕ СЕЙЧАС ПОМОГАЕТ
Dialogue: 0,0:10:35.81,0:10:39.01,Caption,,0,0,0,,УКРАИНЕ ПРОЙТИ ОДНУ ЗИМУ. А ЗЕЛЕНСКИЙ ПРЕДЛАГАЕТ ЕЙ
Dialogue: 0,0:10:39.01,0:10:41.41,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОТОВИТЬСЯ ОТВЕЧАТЬ ЗА БЕЗОПАСНОСТЬ
Dialogue: 0,0:10:41.41,0:10:44.77,Caption,,0,0,0,,ЦЕЛОГО КОНТИНЕНТА. НОРМАЛЬНАЯ НАГРУЗКА. ОСОБЕННО ДЛЯ
Dialogue: 0,0:10:44.85,0:10:47.25,Caption,,0,0,0,,СТРАНЫ, КОТОРОЙ ЕЩЁ НЕДАВНО ОБЪЯСНЯЛИ,
Dialogue: 0,0:10:47.49,0:10:49.81,Caption,,0,0,0,,ЧТО ГЛАВНОЕ ЭКОНОМИЧЕСКОЕ ПРЕИМУЩЕСТВО ЕВРОПЫ
Dialogue: 0,0:10:49.81,0:10:51.57,Caption,,0,0,0,,ЗАКЛЮЧАЕТСЯ В ДЕШЁВОЙ ЭНЕРГИИ,
Dialogue: 0,0:10:51.73,0:10:54.05,Caption,,0,0,0,,ДОСТУПНЫХ РЫНКАХ И АМЕРИКАНСКОМ ЗОНТИКЕ
Dialogue: 0,0:10:54.05,0:10:57.81,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ЭНЕРГИЯ СТАЛА ДОРОЖЕ. РЫНКИ МЕНЯЮТСЯ.
Dialogue: 0,0:10:58.13,0:11:00.77,Caption,,0,0,0,,А ЗОНТИК, КАК ТЕПЕРЬ ОБЪЯСНЯЕТ САМ ЗЕЛЕНСКИЙ,
Dialogue: 0,0:11:01.02,0:11:06.41,Caption,,0,0,0,,ТОЖЕ УЖЕ НЕ ТАКОЙ НАДЁЖНЫЙ. И ВОТ НА ЭТОМ ФОНЕ В АБУ ДАБИ
Dialogue: 0,0:11:06.41,0:11:10.49,Caption,,0,0,0,,РОССИЯ, УКРАИНА И США СОБИРАЮТСЯ ОБСУЖДАТЬ ВЗАИМНЫЕ ГАРАНТИИ
Dialogue: 0,0:11:10.49,0:11:14.01,Caption,,0,0,0,,БЕЗОПАСНОСТИ. СЛОВО КРАСИВОЕ. ГАРАНТИИ. ТОЛЬКО
Dialogue: 0,0:11:14.01,0:11:16.73,Caption,,0,0,0,,НАСТОЯЩАЯ ГАРАНТИЯ ОТЛИЧАЕТСЯ ОТ ОБЕЩАНИЯ ОДНОЙ
Dialogue: 0,0:11:16.73,0:11:19.61,Caption,,0,0,0,,МАЛЕНЬКОЙ ДЕТАЛЬЮ. ЕЁ КТО ТО ДОЛЖЕН БЫТЬ СПОСОБЕН
Dialogue: 0,0:11:19.61,0:11:22.49,Caption,,0,0,0,,ВЫПОЛНИТЬ. ЕСЛИ УКРАИНА ПОЛУЧАЕТ ГАРАНТИИ,
Dialogue: 0,0:11:22.73,0:11:25.13,Caption,,0,0,0,,КТО КОНКРЕТНО ВОЮЕТ ЗА НЕЁ В СЛУЧАЕ НОВОГО
Dialogue: 0,0:11:25.13,0:11:27.77,Caption,,0,0,0,,КОНФЛИКТА? ЕСЛИ РОССИЯ ТРЕБУЕТ ГАРАНТИИ,
Dialogue: 0,0:11:28.09,0:11:30.89,Caption,,0,0,0,,КАКИЕ ОГРАНИЧЕНИЯ ГОТОВЫ ПРИНЯТЬ УКРАИНА И ЕВРОПА?
Dialogue: 0,0:11:31.28,0:11:32.97,Caption,,0,0,0,,ЕСЛИ АМЕРИКА ОТХОДИТ В СТОРОНУ,
Dialogue: 0,0:11:33.28,0:11:35.29,Caption,,0,0,0,,КТО ЗАКРЫВАЕТ ОСВОБОДИВШЕЕСЯ МЕСТО?
Dialogue: 0,0:11:35.52,0:11:40.17,Caption,,0,0,0,,И ГЛАВНОЕ, ЗА ЧЕЙ СЧЁТ? ВОТ ЭТО УЖЕ РАЗГОВОР. А ПОКА ПОЛУЧАЕТСЯ СТРАННАЯ
Dialogue: 0,0:11:40.17,0:11:42.33,Caption,,0,0,0,,КОНСТРУКЦИЯ. В БЕРЛИНЕ ОБСУЖДАЮТ,
Dialogue: 0,0:11:42.57,0:11:45.37,Caption,,0,0,0,,КАК ЕВРОПЕ ЖИТЬ ПОСЛЕ УМЕНЬШЕНИЯ АМЕРИКАНСКОЙ РОЛИ.
Dialogue: 0,0:11:45.69,0:11:48.49,Caption,,0,0,0,,В АБУ ДАБИ СОБИРАЮТСЯ ОБСУЖДАТЬ БЕЗОПАСНОСТЬ РОССИИ
Dialogue: 0,0:11:48.49,0:11:51.45,Caption,,0,0,0,,И УКРАИНЫ. А УКРАИНСКИЕ ЭНЕРГЕТИКИ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:11:51.45,0:11:54.73,Caption,,0,0,0,,ПОЛУЧАЮТ КОМАНДУ СРОЧНО ОТКЛЮЧАТЬ ЦЕЛЫЕ УЧАСТКИ СЕТИ
Dialogue: 0,0:11:55.08,0:11:57.93,Caption,,0,0,0,,И НЕ МОГУТ СКАЗАТЬ ЛЮДЯМ, КОГДА ВЕРНЁТСЯ ЭЛЕКТРИЧЕСТВО.
Dialogue: 0,0:11:58.48,0:12:00.81,Caption,,0,0,0,,И Я СНОВА ВОЗВРАЩАЮСЬ К ТОМУ САМОМУ ВОПРОСУ.
Dialogue: 0,0:12:01.12,0:12:05.05,Caption,,0,0,0,,А ГДЕ ЗДЕСЬ ЛЮДИ? ПОТОМУ ЧТО ПОЛИТИКИ ЛЮБЯТ ГОВОРИТЬ О ЦЕНЕ МИРА,
Dialogue: 0,0:12:05.29,0:12:07.61,Caption,,0,0,0,,ЦЕНЕ ВОЙНЫ, ЦЕНЕ БЕЗОПАСНОСТИ,
Dialogue: 0,0:12:07.71,0:12:10.89,Caption,,0,0,0,,ЦЕНЕ НЕЗАВИСИМОСТИ. НО ПЛАТЁЖКА ПОЧЕМУ ТО ПРИХОДИТ
Dialogue: 0,0:12:10.97,0:12:13.61,Caption,,0,0,0,,НЕ ИМ ОДНИМ. КОМУ ТО ПРИХОДИТ НАСТОЯЩИЙ СЧЁТ
Dialogue: 0,0:12:13.69,0:12:16.49,Caption,,0,0,0,,ЗА ЭЛЕКТРИЧЕСТВО. КОМУ ТО ПРИХОДИТСЯ ИСКАТЬ ВОДУ.
Dialogue: 0,0:12:16.81,0:12:23.01,Caption,,0,0,0,,КОМУ ТО СИДЕТЬ БЕЗ ОТОПЛЕНИЯ. КОМУ ТО СНОВА ЖДАТЬ ОЧЕРЕДНУЮ ЗИМУ И ГАДАТЬ,
Dialogue: 0,0:12:23.33,0:12:26.21,Caption,,0,0,0,,ВЫДЕРЖИТ ЛИ ЕГО ГОРОД СЛЕДУЮЩИЙ УДАР. И ВОТ
Dialogue: 0,0:12:26.29,0:12:28.61,Caption,,0,0,0,,ПОЭТОМУ РАЗГОВОР ЗЕЛЕНСКОГО В БЕРЛИНЕ ПОЛУЧИЛСЯ
Dialogue: 0,0:12:28.70,0:12:31.01,Caption,,0,0,0,,ОЧЕНЬ СВОЕВРЕМЕННЫМ. НЕ ПОТОМУ,
Dialogue: 0,0:12:31.17,0:12:34.05,Caption,,0,0,0,,ЧТО ОН ОБЪЯСНИЛ ЕВРОПЕ ЕЁ БУДУЩЕЕ. А ПОТОМУ,
Dialogue: 0,0:12:34.30,0:12:36.93,Caption,,0,0,0,,ЧТО УКРАИНА ПРЯМО СЕЙЧАС ПОКАЗЫВАЕТ ЕВРОПЕ,
Dialogue: 0,0:12:37.18,0:12:40.13,Caption,,0,0,0,,СКОЛЬКО ЭТО БУДУЩЕЕ МОЖЕТ СТОИТЬ. АМЕРИКА,
Dialogue: 0,0:12:40.22,0:12:42.05,Caption,,0,0,0,,ГОВОРИТЕ, БУДЕТ ЗАНИМАТЬСЯ СОБОЙ?
Dialogue: 0,0:12:42.26,0:12:45.09,Caption,,0,0,0,,ХОРОШО. ТОГДА ДОБРО ПОЖАЛОВАТЬ ВО ВЗРОСЛУЮ ЖИЗНЬ.
Dialogue: 0,0:12:45.33,0:12:47.57,Caption,,0,0,0,,ТОЛЬКО ПРЕЖДЕ ЧЕМ ДЕЛИТЬ ОТВЕТСТВЕННОСТЬ ЗА ВЕСЬ
Dialogue: 0,0:12:47.57,0:12:50.85,Caption,,0,0,0,,МИР, ВСЁ ТАКИ НЕПЛОХО ПРОВЕРИТЬ КРЫШУ ДОМА. ТАМ ОПЯТЬ
Dialogue: 0,0:12:50.85,0:12:51.33,Caption,,0,0,0,,КАПАЕТ.
